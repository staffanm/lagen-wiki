  "segments": [
    {
      "forarbete_id": "a7.1",
      "sentiment": 0.2,
      "quote": "FUB anser därför att begreppet behovsstyrd vård behöver ges en bredare innebörd där även patientens förutsättningar att faktiskt få tillgång till vården ingår.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2",
      "sentiment": 0.2,
      "quote": "En vårdgaranti som endast mäts i antal dagar riskerar att osynliggöra de patienter som behöver längre tid, anpassad kommunikation eller särskilda insatser för att vårdbehovet ska kunna bedömas korrekt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2.2",
      "sentiment": 0.5,
      "quote": "Informationen måste vara begriplig och anpassad.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2.1",
      "sentiment": 0.2,
      "quote": "FUB vill uppmärksamma risken för så kallad diagnostisk överskuggning där symtom felaktigt förklaras med personens funktionsnedsättning i stället för att utredas medicinskt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.5",
      "sentiment": 0.5,
      "quote": "För personer med IF är kontinuitet inte enbart en fråga om trygghet utan ofta en förutsättning för att vården ska kunna genomföras på ett säkert sätt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.8.5",
      "sentiment": 0.2,
      "quote": "Digitala system behöver vara utformade enligt principerna om universell utformning och kompletteras med alternativa kontaktvägar då många personer med IF befinner sig i ett digitalt utanförskap.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.4.2",
      "sentiment": -0.5,
      "quote": "FUB saknar en tydligare analys av vilken kompetens som krävs hos hälso- och sjukvårdens personal för att den föreslagna utvecklingen av vården ska komma personer med IF till del.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.1",
      "sentiment": 0.2,
      "quote": "FUB föreslår att det tydliggörs att vårdens arbetssätt ska möjliggöra att patienten får det stöd som behövs för att kunna: • förstå information, • uttrycka sin vilja, • delta i beslut, • följa behandlingsplaner.",
