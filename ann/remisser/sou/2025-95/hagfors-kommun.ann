  "segments": [
    {
      "forarbete_id": "a8",
      "sentiment": 0.5,
      "quote": "Ett tydligare försörjningskrav kan bidra till att säkerställa att den person som redan är bosatt i Sverige har förmåga att försörja sig själv och sina anhöriga utan att belasta socialförsäkringssystemen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.15",
      "sentiment": 0.5,
      "quote": "Genom att skapa incitament för arbete och egenförsörjning kan reglerna motivera den bosatta personen att snabbare etablera sig på arbetsmarknaden och i samhället, vilket på sikt kan underlätta en hållbar integration.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.3",
      "sentiment": -0.5,
      "quote": "Vissa delar i betänkandet kan riskera att stå i strid med Barnkonventionen, särskilt när det gäller barnets rätt till familjeliv och principen om barnets bästa.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.10",
      "sentiment": -0.5,
      "quote": "En sådan situation kan skapa oro, stress och psykisk ohälsa, vilket i sin tur kan försvåra personens möjligheter att fokusera på etablering och inträde på arbetsmarknaden.",
