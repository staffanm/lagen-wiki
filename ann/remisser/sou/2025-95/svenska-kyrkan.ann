  "segments": [
    {
      "forarbete_id": "sec9",
      "sentiment": -1.0,
      "quote": "Barn riskerar därmed att leva separerade från sin förälder under en avsevärd tid, med negativa konsekvenser för hälsa, utveckling och skolgång.",
