    },
    {
      "forarbete_id": "a12.2",
      "sentiment": -0.5,
      "quote": "Begränsningen kan leda till ökade hinder för lika rättigheter och möjligheter för personer med funktionsnedsättning, då de generellt sett kan ha svårare att klara sin egen försörjning än personer utan funktionsnedsättning.",
      "quote_type": "grund"
