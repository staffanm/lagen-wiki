  "segments": [
    {
      "forarbete_id": "a6.2.3",
      "sentiment": 0.5,
      "quote": "the stringent threshold for demonstrating exceptional circumstances would mean that, in practice, access to family reunification for siblings of unaccompanied children is likely to remain limited.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2.4",
      "sentiment": 1.0,
      "quote": "UNHCR further notes with appreciation that Section 6.2.4 of the Inquiry proposal seeks to remove the requirement of the current provisions under Chapter 5 Sections 3 and 3a of the Aliens Act that children must be unmarried to be able to act as sponsors or be granted a residence permit on family ties.",
      "quote_type": "grund"
    },
    {
