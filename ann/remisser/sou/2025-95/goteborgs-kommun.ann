  "segments": [
    {
      "forarbete_id": "sec9",
      "sentiment": -0.5,
      "quote": "Vissa barn kommer att påverkas av införandet av en väntetid innan familjeåterförening kan ske. Detta riskerar att skapa oro, stress och påfrestningar för både barn och föräldrar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.3",
      "sentiment": -0.2,
      "quote": "Förslaget om fortsatt tillämpning av försörjningskravet vid förlängningsärenden kan också leda till negativa konsekvenser, även om möjligheten till undantag finns.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec204",
      "sentiment": 0.5,
      "quote": "Göteborgs Stad anser att vissa delar av förslaget har positiva inslag, bland annat ökad tydlighet kring uppehållstillstånd för nära anhöriga utanför kärnfamiljen, vilket kan skapa trygghet för barn nära myndighetsåldern.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec191",
      "sentiment": 1.0,
      "quote": "Även borttagandet av kravet att ett barn ska vara ogift för familjeåterförening får anses positivt ur ett barnperspektiv.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec268",
      "sentiment": -0.5,
      "quote": "Förslaget skulle kunna innebära en risk för att fler personer kommer att stanna i destruktiva relationer av oro för att ett uppbrott kan påverka möjligheten att få stanna i Sverige.",
