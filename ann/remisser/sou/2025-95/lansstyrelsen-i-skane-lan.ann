  "overall": {
    "sentiment": 0.0,
    "quote": "Länsstyrelsen avstyrker förslaget om en tvåårig väntetid innan en ansökan om familjeåterförening kan lämnas in när anknytningspersonen inte omfattas av EU-rätten, samt förslaget om försörjningskrav vid ansökan om förlängning av uppehållstillstånd, då dessa förslag riskerar att skapa långvarig osäkerhet, försvåra integrationen och strida mot barnets bästa.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a6.2.3",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen tillstyrker förslaget att det kommer att bli möjligt för syskon till ensamkommande barn att ansöka om uppehållstillstånd på grund av anknytning till en förälder som i sin tur har beviljats uppehållstillstånd på grund av anknytning till det ensamkommande barnet.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.2.4",
      "sentiment": 1.0,
      "quote": "det, med hänsyn till rätten till familjeliv enligt Europakonventionen och till de krav som följer av barnkonventionen – särskilt principen om likabehandling – är nödvändigt att svensk rätt även fortsättningsvis möjliggör familjeåterförening för ensamkommande skyddsbehövande barn och deras föräldrar, oavsett barnets skyddsstatus.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec9",
      "sentiment": -1.0,
      "quote": "konsekvenserna på såväl individnivå som på samhällelig nivå inte är tillräckligt utredda.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2",
      "sentiment": -0.2,
      "quote": "innebär en försvagning ur ett rättighetsperspektiv för de grupper som berörs.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen tillstyrker utredningens förslag att kravet på att ett barn ska vara ogift för att omfattas av en rätt eller möjlighet till uppehållstillstånd på grund av anknytning till en förälder eller förälders make eller sambo tas bort.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec204",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen tillstyrker förslaget att det även fortsatt ska vara möjligt enligt utlänningslagen att bevilja uppehållstillstånd för nära anhöriga utanför kärnfamiljen och att regleringen anpassas för bättre tillämpning i förlängningsärenden, särskilt för unga vuxna som beviljats uppehållstillstånd som barn på grund av anknytning och som vid förlängningstillfället fyllt 18 år.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.7.3",
      "sentiment": -1.0,
      "quote": "Länsstyrelsen delar utredningens bedömning att förslaget kan få negativa konsekvenser, både för enskilda och för samhället i stort.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.1",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen ser vikten av att möjligheten att neka uppehållstillstånd bör gälla även om våldet eller kränkningen skett i en tidigare relation.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3",
      "sentiment": 1.0,
      "quote": "särskilt i beaktande av barnkonventionen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.15",
