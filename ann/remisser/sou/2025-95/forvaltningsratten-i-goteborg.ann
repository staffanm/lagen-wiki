  "overall": {
    "sentiment": -0.2,
    "quote": "Det kommer därför att behövas ny praxis på området, vilket ställer krav på vägledning i förarbetena.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a7.2.2",
      "sentiment": -0.2,
      "quote": "Det kan därför ifrågasättas om en situation där en förälder inte har möjlighet att få rättslig vårdnad om sitt barn kan omfattas av ventilbestämmelsen i 5 kap. 3 d § på det sätt som utredningen anger.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec43",
      "sentiment": -0.2,
      "quote": "Det framgår inte av utredningen hur den föreslagna regleringen förhåller sig till en sådan situation eller i vilka situationer som förslaget annars är tänkt att tillämpas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec45",
      "sentiment": -0.2,
      "quote": "Om avsikten med 5 kap. 3 c § andra stycket är att omfatta även andra fall än personer i samkönade relationer som inte har haft möjlighet att sammanbo i sina hemländer, bör fler exempel ges för att ge vägledning för rättstillämparen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3-4",
      "sentiment": -0.2,
      "quote": "För att underlätta för tillämpningen bör det i motiven ges exempel på vilka andra situationer som kan omfattas av bestämmelsen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7",
      "sentiment": -0.2,
      "quote": "Uttrycket \"mycket speciella omständigheter\" är inte ett vedertaget begrepp inom migrationsområdet och ger därför inte någon särskild vägledning för bedömningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.3.2",
      "sentiment": -0.2,
      "quote": "Förvaltningsrätten anser att uttalandet väcker frågor om vilken praxis det är som tillämparen fortsatt kan hämta vägledning från och att det vore lämpligt med ett förtydligande av detta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.1.2",
      "sentiment": -0.2,
      "quote": "Däremot ges ingen förklaring till vad exempelvis brottsligheten i så fall ska vägas mot.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.2.5",
      "sentiment": -0.2,
      "quote": "Det är oklart i vilken utsträckning tidigare uttalanden om särskilda skäl i andra sammanhang kan beaktas vid en bedömning enligt den nu föreslagna bestämmelsen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.2",
      "sentiment": 0.5,
      "quote": "Utöver de skäl som utredningen har presenterat kan en avsaknad av övergångsbestämmelser medföra att vissa befintliga mål vid migrationsdomstolarna kommer att återförvisas till Migrationsverket för ny handläggning.",
      "quote_type": "grund"
    }
  ]
}