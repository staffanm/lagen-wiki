    },
    {
      "forarbete_id": "a19.4",
      "sentiment": 0.0,
      "quote": "Naturvetarna ställer sig neutrala till utredningens förslag, men anser att där samverkan är möjlig kan skapa ett mer effektivt arbetssätt bör kontrollansvar kunna överföras mellan myndighetsgränser.",
      "quote_type": "grund"
