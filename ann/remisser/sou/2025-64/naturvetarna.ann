  },
  "overall": {
    "sentiment": 0.5,
    "quote": "Naturvetarna ser risker med att utredningens förslag inte tillräckligt väl adresserar hur en decentraliserad statlig kontroll ska se ut eller fungera, att tidsfristen är för kort, att utredningen inte beskriver hur övergången av anställningar ska upplevs som trygg av de anställda.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a16.2",
      "sentiment": 1.0,
      "quote": "kontrollen i livsmedelskedjan skiljer sig avsevärt mellan olika geografiska områden, där mindre kontrollmyndigheter är sårbara och framför allt brister i utförande på grund av kompetensbrist.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.3",
      "sentiment": 0.5,
      "quote": "Naturvetarna vill lyfta att lokal förankring till de verksamheter som kontrolleras är viktig för ett en effektiv och snabbfotad kontrollorganisation.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a17.1",
      "sentiment": 1.0,
      "quote": "Naturvetarna kan intyga om att det i dagsläget finns en stor kompetensbrist inom inspektörsyrket.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a17.3",
      "sentiment": 1.0,
      "quote": "Dels för att det fortfarande som utredningen beskriver fortfarande kommer finnas problematik i likvärdigheten gällande både kontrollavgifter och i utförandet av kontrolluppdraget.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a17.4.2",
      "sentiment": 1.0,
      "quote": "Med den rådande kompetensbristen på livsmedelsinspektörer så kan en centralisering av kontrollorganisationen leda till bättre fördelning av resurser, kompetensöverföringen förbättras och leda till möjlighet till specialisering.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a17.4.3",
      "sentiment": 1.0,
      "quote": "En stark fördel som utredningen själv beskriver är länsstyrelsernas utpräglade regionala organisation, befintliga lokaler samt finns en bevisad ökad likvärdighet, rättssäkerhet och träffsäkerhet när de tog över djurskyddskontrollen från kommunerna år 2009.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a17.4.4",
      "sentiment": 1.0,
      "quote": "då dagens revision brister och inte har någon systematisk kontroll av livsmedelskontrollen samtidigt som de centrala myndigheterna Livsmedelsverket och Jordbruksverket redan idag genomför de nuvarande revisionerna av myndigheterna och länsstyrelserna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a17.4.6",
      "sentiment": 0.0,
      "quote": "Utredningen berör en decentraliserad statlig kontroll och ger exempel på Arbetsmiljöverkets regionala inspektionsavdelningar fungerar, men ger ingen konkret förslag på hur decentraliseringen av en statlig kontroll ska utformas eller fungera.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a17.5",
      "sentiment": -0.2,
      "quote": "Naturvetarna anser dock att utredningens direktiv varit för snävt som begränsas till offentlig kontroll och annan offentlig verksamhet enligt kontrollförordningen inom områdena livsmedel, foder och ABP samt till de djurskyddskontroller som utförs i nära anslutning till, eller i samband med, kontrollerna inom de områdena.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a18.1",
      "sentiment": 0.2,
      "quote": "Tillförs inte ytterligare medel för att förbättra kompetensbristen och satsningar mot att göra yrket mer attraktivt kommer en centralisering troligtvis te sig verkningslös.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a18.4",
      "sentiment": -0.2,
      "quote": "Naturvetarna anser att utredningens direktiv har varit för snävt och menar att det behövs en utredning som tar ett helhetsgrepp om kontrollen i livsmedelskedjan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a18.5",
      "sentiment": 0.5,
      "quote": "med två centrala myndigheter som delar på ansvaret så behöver det bli möjligt för dem att kunna dela relevant information mellan myndigheterna på ett bättre sätt än idag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.1.1",
      "sentiment": 0.0,
      "quote": "Att kontrollen överförs till Livsmedelsverket ställer sig Naturvetarna dock neutrala till.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a19.1.6",
      "sentiment": -0.5,
      "quote": "Naturvetarna anser att utredningen inte tillräckligt väl beskriver hur övergången av anställningar ska gå till på ett sätt som upplevs trygg för de anställda.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.1.7",
      "sentiment": 1.0,
      "quote": "Naturvetarna anser att för en centralisering av kontrollen i livsmedelskedjan ska kunna fungera effektivt och träffsäkert, behöver en god lokal förankring finnas på plats.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.1.9",
      "sentiment": 1.0,
      "quote": "Det saknas idag ett heltäckande system för revision det har inneburit stora utmaningar för kommuner och länsstyrelser att uppfylla revisionen enligt kontrollförordningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.1.10",
      "sentiment": 1.0,
      "quote": "Som påpekades under punkt 19.1.7 så är möjlighet till distansarbete en god möjlighet för en centraliserad kontrollorganisation att kunna fortsätta ha en lokal förankring och gynnsamt för kompetensförsörjningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.2",
      "sentiment": 0.0,
      "quote": "Att kontrollen för foder och ABP överförs till Jordbruksverket ställer sig Naturvetarna dock neutrala till.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a19.2.4",
      "sentiment": 0.2,
      "quote": "Utifrån ett medarbetarperspektiv vill Naturvetarna återigen lyfta att det är viktigt för kompetensförsörjningen att det finns möjlighet för de som arbetar med kontroll av foder och ABP idag att bo kvar även om de får en ny arbetsgivare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.2.5",
      "sentiment": -0.5,
      "quote": "Naturvetarnas hänvisar till sitt svar under punkt 19.1.6.",
