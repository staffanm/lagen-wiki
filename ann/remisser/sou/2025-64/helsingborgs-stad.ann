  },
  "segments": [
    {
      "forarbete_id": "a17",
      "sentiment": -0.5,
      "quote": "Utan dessa jämförelser kan inte ett välavvägt beslut fattas och det finns risk för att onödigt omvälvande och kostsamma förändringar vidtas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.1.7",
      "sentiment": -0.5,
      "quote": "För att säkerställa kvaliteten på livsmedelskontrollen är det av vikt att tydligare ange att det krävs en betydligt tätare representation i landet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a22.1",
      "sentiment": 0.5,
      "quote": "Detta skulle underlätta för de som söker information eller kontakt och särskilt för företag som har verksamhet i olika kommuner.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.1.6",
      "sentiment": 0.5,
      "quote": "Genom möjligheterna till specialisering skulle sällan förekommande och väl avgränsade frågor kunna hanteras mer effektivt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a20.1",
      "sentiment": 0.5,
      "quote": "Förslaget kommer gynna en sund konkurrens och bidra till att bristande efterlevnad och fusk kan upptäckas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a18.6",
      "sentiment": 0.2,
      "quote": "Miljönämnden bedömer att en statlig kontrollmyndighet möjliggör ett mer effektivt ingripande mot regelmässiga fel, oavsett om de är avsiktliga eller inte, vilket skulle gynna den svenska marknaden i någon mån.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.6",
      "sentiment": -0.5,
      "quote": "Livsmedelsverket har varken vanan att hantera mängden eller typen av anläggningar, vilket innebär att förslaget är alltför offensivt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a25",
      "sentiment": -0.5,
      "quote": "Miljönämnden bedömer att utredningens tidsperspektiv är för snävt i förhållande till alla nödvändiga förberedelser som krävs för att ha en ny organisation på plats som kan ta över kontrollansvaret från dag ett.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.5",
      "sentiment": 0.5,
      "quote": "Miljönämnden ser positivt på att denna informationsinhämtning vid ett övertag sker grundligt för att skapa rätt förutsättningar för framtida kontrollverksamhet.",
      "quote_type": "grund"
    }
  ]
