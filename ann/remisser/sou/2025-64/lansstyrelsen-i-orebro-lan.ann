  "segments": [
    {
      "forarbete_id": "a19.1",
      "sentiment": -1.0,
      "quote": "Att centralisera livsmedelskontrollen till en statlig myndighet och bygga upp en ny struktur med regionala kontor riskerar att bli mycket kostsamt och ineffektivt.",
