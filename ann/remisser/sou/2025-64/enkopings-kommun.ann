    {
      "forarbete_id": "a10.1",
      "sentiment": -0.5,
      "quote": "Kommunen bedömer att det finns många fördelar med den finska modellen, särskilt sett till Sveriges stora yta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec41",
