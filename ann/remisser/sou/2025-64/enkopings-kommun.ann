  "segments": [
    {
      "forarbete_id": "a18",
      "sentiment": 0.5,
      "quote": "Detta bedömer kommunen att en centraliserad organisation skulle kunna anpassa sig till snabbare, samt att företagarna skulle börja kontrolleras enligt detta ungefär samtidigt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec619",
      "sentiment": 0.5,
      "quote": "Kommunen ser att centraliseringen skulle innebära tillgång till resurser med specialistkompetens som kan nyttjas inom hela landet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a26.11",
      "sentiment": -0.2,
      "quote": "För de som berörs av kommunens tillsyn inom alkohol, tobak och miljöbalken blir den administrativa bördan istället högre, eftersom kontakt ska ske med flera myndigheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a22.1",
      "sentiment": 0.0,
      "quote": "En centraliserad myndighet kan erbjuda mer enhetlig rådgivning och stöd till företag, vilket underlättar deras verksamhet och regeluppfyllelse.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec601",
      "sentiment": -0.5,
      "quote": "Kommunen tycker dock man tappat aspekten med restid, eftersom den totalt bli betydligt längre, speciellt för Enköpings kommun som har en aktiv landsbygd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec617",
      "sentiment": -0.5,
      "quote": "Om kommunerna förlorar ansvaret för den lokala livsmedelskontrollen innebär det mindre lokal närvaro och inblick.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a18.3.4",
      "sentiment": -0.5,
      "quote": "Enköpings kommun har ett nära samarbete med lokalpolisen i det brottsförebyggande arbetet, något som kommunen tror förloras vid centralisering.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec31",
      "sentiment": -0.5,
      "quote": "Detta samarbete skulle bli mycket svårare att upprätthålla vid en centralisering av kontrollen.",
