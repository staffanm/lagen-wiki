    },
    {
      "forarbete_id": "a19.1.7",
      "sentiment": 0.2,
      "quote": "Samtidigt ser vi att den lokala förankringen behöver finnas kvar för att myndighetskontakten skall fungera både ur kontroll och rådgivande aspekt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a23",
      "sentiment": 1.0,
      "quote": "Inom Livsmedelsbranschen i stort, men inte minst specifikt inom biodlingsnäringen, är företagen ofta små, s.k. mikroföretag, med bristande möjligheter och resurser att klara av att följa ett invecklat regelverk fullt ut.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec229",
      "sentiment": 1.0,
      "quote": "Som företagare skall det vara lätt att göra rätt utan invecklade regler och byråkrati. Förslaget om ”en väg in” till myndigheterna är ur den aspekten värdefull och viktig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a21",
      "sentiment": -0.5,
      "quote": "Finansieringen av livsmedelskontrollen bör till största delen vara anslagsfinansierad och den del som tas ut av företag skall vara relevant och efterhandsdebiterad utifrån den tidsåtgång som ärendet krävt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a22.3",
      "sentiment": 1.0,
      "quote": "Regelbunden dialog mellan myndigheter och branschföreträdare, för att underlätta både för myndighet och bransch, utveckla och förenkla regelverk, är av största vikt.",
      "quote_type": "grund"
