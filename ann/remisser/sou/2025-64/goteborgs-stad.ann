  "segments": [
    {
      "forarbete_id": "a17.5",
      "sentiment": -0.5,
      "quote": "Förvaltningen bedömer att utredningen inte tillräcklig omfattning har prövat andra alternativ till organisering, som skulle ge dessa fördelar, än att förstatliga kontrollen.",
