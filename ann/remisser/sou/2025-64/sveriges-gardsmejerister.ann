    },
    {
      "forarbete_id": "a19.1.6",
      "sentiment": 0.5,
      "quote": "SGM bedömer dock att Livsmedelsverket inte bör göra detta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.4",
      "sentiment": 1.0,
      "quote": "Att den myndighet som gör livsmedelskontrollen kan göra kontrollen på ABP samtidigt är viktigt för hantverksmejerier som har vassle som ABP.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a17.4.3",
      "sentiment": 0.8,
      "quote": "Lokal kännedom, samordningsmöjligheter med andra kontroller, samling av kompetens som ger synergieffekter och det kan ge färre företag som får fler tillsynsmyndigheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a15.2.6",
      "sentiment": 1.0,
      "quote": "SGM instämmer i tanken som framförts att beräkna alla avgifter enligt kontrollförordningens artikel 81 om obligatoriska avgifter.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a21.3.1",
      "sentiment": 1.0,
      "quote": "Detta är ett viktigt förslag, särskilt för de små säsongsverksamheter på landsbygden som totalt använder en mycket liten mängd dricksvatten och nu köper flaskvatten då nuvarande dricksvattenregler inte har några undantag för liten mängd, “bagatellgräns”, för kommersiella verksamheter.",
