    {
      "forarbete_id": "a19.1.4",
      "sentiment": 1.0,
      "quote": "SGM instämmer i bedömningen att Livsmedelsverket behöver genomföra ett förändringsarbete för att förbättra kulturen och bemötandet utifrån de olika branschernas behov.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a19.1.5",
      "sentiment": 1.0,
      "quote": "SGM instämmer i att regeringen bör se över behovet av att ändra bestämmelserna om Livsmedelsverkets ledning och förordar ombildning till styrelsemyndighet.",
