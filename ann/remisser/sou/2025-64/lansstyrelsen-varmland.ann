  "overall": {
    "sentiment": -0.3,
    "quote": "Länsstyrelsen är positiv till att ansvaret för den offentliga kontrollen avseende livsmedel och annan offentlig verksamhet i anslutning till denna övergår i statlig regi, men anser att det är en stor brist att utredningen ser livsmedelskontrollen som avgränsad helhet, och inte som en del i ett betydligt större sammanhang.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a12",
      "sentiment": -0.2,
      "quote": "Länsstyrelsen vill påpeka att flera av de brister i det befintliga kontrollsystemet som utredaren beskriver är effekter av underfinansiering.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13",
      "sentiment": -0.5,
      "quote": "Länsstyrelsen anser att kontrollen av förvaring av ABP på lantbruksföretag lämpligast hanteras på länsstyrelserna eftersom kontrollen enkelt och resurseffektivt kan samordnas med djurskyddskontroll och kontroll av läkemedel på gård då flera av kontrollpunkterna är likalydande inom de olika kontrollområdena.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.1.1",
      "sentiment": -1.0,
      "quote": "Förslaget innebär att parallella statliga kontrollorganisationer kommer att agera hos samma aktörer inom samma geografiska område.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.2",
      "sentiment": 0.2,
      "quote": "Det är rimligt att den kontrollen av ABP återförs till Jordbruksverket.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.2.4",
      "sentiment": 0.5,
      "quote": "Länsstyrelsen tillstyrker förslaget i det fall centralisering genomförs.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a19.3.1",
      "sentiment": 0.5,
      "quote": "Länsstyrelsen tillstyrker förslaget under förutsättning att ekonomiska resurser tillförs i den omfattning som krävs för att fullgöra uppdraget.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.3.4",
      "sentiment": 0.5,
      "quote": "Att Livsmedelsverket vid sin närvaro vid slakterierna även har kontrollansvaret för djurskydd och ABP är en rimlig lösning, men förutsätter att information om befarade eller konstaterade djurskyddsproblem når länsstyrelserna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.5",
      "sentiment": 0.5,
      "quote": "Om förflyttning av kontrollansvar till Livsmedelsverket genomförs är det rimligt att Livsmedelsverket tar över ansvaret för revision av kommunernas arbete.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a20.1.4",
      "sentiment": 1.0,
      "quote": "Redan i dag finns behovet av regleringar som möjliggör informationsdelning mellan myndigheterna på ett enklare sätt, så denna del av förslaget är välkommet oavsett om övriga delar genomförs eller inte.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a22.1.1",
      "sentiment": -0.5,
      "quote": "Länsstyrelsen bedömning är att de praktiska förutsättningarna för råd och stöd minskar vid centralisering då detta kräver god kännedom om regionala och lokala förutsättningar och ett bredare perspektiv på företagarnas villkor än vad en central myndighet kan förväntas ha.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a22.1.2",
      "sentiment": -0.2,
      "quote": "Länsstyrelsen delar inte utredarens bedömning, utan anser att det som beskrivs snarare är en resursfråga än en organisationsfråga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a22.1.3",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen instämmer helt i utredarens bedömning gällande arbete med bemötande.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a22.1.4",
      "sentiment": -0.2,
      "quote": "Med ett tydligare uppdrag till, och högre krav på, de centrala myndigheternas vägledande roll är det Länsstyrelsens bedömning att man inom befintlig statlig struktur kan uppnå det som eftersträvas till en lägre kostnad och med ett starkare företagar- och helhetsperspektiv.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a22.3",
      "sentiment": -1.0,
      "quote": "Bestämmelser kring hur dialog ska ske och krav på redovisning av vad de lett till riskerar att bli kontraproduktivt och innebär ökad administrativ belastning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a24",
      "sentiment": 0.0,
      "quote": "Merparten av de förslag på satsningar på små företag och förslag på förenklingar som föreslås kan genomföras vare sig flytt av kontrollansvar genomförs eller inte.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a25",
      "sentiment": -0.2,
      "quote": "Den föreslagna förändringen är än mer omfattande, inte minst personellt, men även när det gäller att inrätta en helt ny regional organisation med allt vad det innebär i form av lokaler, IT-system, utrustning och samordning.",
      "quote_type": "grund"
    }
  ]
}