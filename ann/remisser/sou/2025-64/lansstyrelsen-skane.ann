  "segments": [
    {
      "forarbete_id": "a4.1",
      "sentiment": -0.2,
      "quote": "Skapandet av en parallell regional statlig organisation i enlighet med utredningens förslag kan därför på lokal nivå försvåra samordningen av de regionala försvarsinsatserna, genom att länsstyrelserna under en samhällsstörning får svårare att skaffa sig samlad lägesbild, trots regional och lokal kännedom, och att de tillkommande samverkansbehoven därför riskerar att fördröja nödvändiga beslut.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.1",
      "sentiment": -0.5,
      "quote": "En förflyttning av kontroll av primärproduktionen riskerar därför att inverka menligt exempelvis på djurskyddskontrollen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.2",
      "sentiment": -0.2,
      "quote": "Länsstyrelsen ser därför en risk med att en redan etablerad samsyn inom området går förlorad samtidigt som den kompetensbas som byggts upp inte kan upprätthållas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.3",
      "sentiment": -0.2,
      "quote": "Utifrån förslaget anser Länsstyrelsen det otydligt vad förslagets lydelse ovan skulle kunna innebära i praktiken, vilket därför behöver utredas vidare.",
