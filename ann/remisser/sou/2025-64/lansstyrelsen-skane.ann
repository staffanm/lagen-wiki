    },
    {
      "forarbete_id": "a19.3.4",
      "sentiment": 0.5,
      "quote": "Livsmedelsverkets officiella veterinärer kontrollerar redan denna del men har inte tillräckliga mandat för att vidta nödvändiga åtgärder utan behöver då överlämna ärenden till Länsstyrelsen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a25",
      "sentiment": -0.2,
      "quote": "Förberedelserna på kommunal- och länsstyrelsenivå kommer vid ett genomförande att behöva vara omfattande och tidsmässigt krävande.",
