  "overall": {
    "sentiment": -0.4,
    "quote": "Länsstyrelsen i Norrbottens län föreslår därför att om kontrollområdena livsmedel, foder och animaliska biprodukter ska förflyttas och centraliseras ska de lämnas över till länsstyrelserna som samtidigt behåller sitt nuvarande ansvar för kontroller inom livsmedel, foder, djurskydd, smittskydd och läkemedelshantering.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a16",
      "sentiment": 0.8,
      "quote": "Länsstyrelsen delar utredningens bedömning att dagens kontrollorganisation inom livsmedelskedjan är för splittrad och att antalet kontrollmyndigheter behöver minska.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a17",
      "sentiment": -0.5,
      "quote": "Vikten av en närhet till aktörerna vid exempelvis utbrott av matförgiftning och snabbt behov av insatser skulle försvinna om förslaget med centralisering blir verklighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a18.3.3",
      "sentiment": 0.2,
      "quote": "Det faktum att länsstyrelserna redan har lång erfarenhet och kompetens inom området, god kunskap om de lokala och regionala aktörerna, transportflödena och de praktiska förhållanden som påverkar kontrollen talar för att kontrollen borde ligga kvar regionalt, hos länsstyrelserna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.1.9",
      "sentiment": 1.0,
      "quote": "Att kontrollen revideras i alla steg är viktigt ur alla de aspekter som präglar utredningen; likvärdighet, kompetens och effektivitet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.3",
      "sentiment": 1.0,
      "quote": "Det är även logiskt och ändamålsenligt att länsstyrelserna kan överlåta vissa delmoment i transportkontrollen, exempelvis avlastning av slaktdjur vid slakteriet, till Livsmedelverkets officiella veterinärer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a20.1",
      "sentiment": 1.0,
      "quote": "Det är av största vikt att de förbättringar om informationsutbyte som utredningen föreslår genomförs skyndsamt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a21",
      "sentiment": 0.5,
      "quote": "För ett län som Norrbotten med många mindre företag med produktion av lokala specialiteter får avgiftsuttaget inte bli för betungande, avstånden ska inte påverka kontrollen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a22",
      "sentiment": 0.5,
      "quote": "Att samordning och samverkan mellan myndigheter behövs är självklart oavsett antalet involverade myndigheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a24",
      "sentiment": 1.0,
      "quote": "Förenklingsarbetet behöver ske på flera nivåer och intensifieras gällande information, kortare handläggningstider och service men framför allt bör den totala regelbördan för livsmedels- och lantbruksföretag gås igenom tillsammans med branschens alla led.",
      "quote_type": "grund"
