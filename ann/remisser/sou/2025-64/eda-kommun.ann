  "segments": [
    {
      "forarbete_id": "a16",
      "sentiment": 0.5,
      "quote": "Strukturen med många små kommunala kontrollmyndigheter skapar problem med likvärdighet, kompetensförsörjning och långsiktig stabilitet.",
