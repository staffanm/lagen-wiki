  "segments": [
    {
      "forarbete_id": "a18",
      "sentiment": -0.5,
      "quote": "Länsstyrelsen i Dalarna anser att ett genomförande av utredningens förslag om en centralisering av ansvaret för kontrollerna inom livsmedelskedjan riskerar att försämra möjligheterna för att kontrollerna ska bli så verkningsfulla, effektiva och likvärdiga som möjligt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a21",
      "sentiment": -0.2,
      "quote": "Sett till företagens kostnader för kontroll finns en risk att de kan öka. Framför allt för företag som idag står under kommunal kontroll eftersom Livsmedelsverket är den kontrollmyndighet som i nuläget har högst timtaxor.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.1",
      "sentiment": -0.5,
      "quote": "Om ansvaret för kontroll av foder och livsmedel inom primärproduktionen försvinner från länsstyrelsens riskerar kompetensen att försvagas och arbetet med livsmedelsberedskap att urholkas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.3.4",
      "sentiment": 0.8,
      "quote": "Eftersom Livsmedelsverket redan idag utför kontroller på slakterier har myndigheten goda förutsättningar för att kunna ta ett helhetsgrepp kring både djurskydd och livsmedelssäkerhet på området.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.3.3",
      "sentiment": 0.5,
      "quote": "Däremot behöver administrationen kring överlämnande av transportkontrollen vid slakterierna vara tydlig och nationellt synkroniserad.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a22.1",
      "sentiment": 0.2,
      "quote": "Fokus på de regionala förutsättningar som finns inom olika delar av landet riskerar dock att gå förlorade om perspektiven endast är nationella.",
