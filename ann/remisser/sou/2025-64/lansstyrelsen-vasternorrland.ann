  "overall": {
    "sentiment": -0.5,
    "quote": "Länsstyrelsens roll som krisberedskapsmyndighet riskerar att försvagas om förslaget genomförs.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a16",
      "sentiment": 0.8,
      "quote": "Länsstyrelsen instämmer i bedömningen att antalet kontrollmyndigheter behöver minska för att öka likvärdighet, effektivitet och förutsägbarhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a17.4.3",
      "sentiment": 0.8,
      "quote": "Länsstyrelsen bedömer att risken för att tillräcklig likvärdighet inte uppnås är mycket liten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.1",
      "sentiment": -1.0,
      "quote": "Även om det kan vara lättare med samsyn och styrning i en central myndighet så skulle det problemet kunna lösas med en förbättrad och utökad vägledning till de myndigheter som utför kontrollen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.2",
      "sentiment": -0.8,
      "quote": "Förvaring av döda djur (och eventuellt andra animaliska biprodukter) på lantbruk är en fråga som kan ha koppling till både smittskydd och djurskydd och bör lämpligen utföras av länsstyrelsen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.3.1",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen bedömer att det är lämpligt att transportkontroller även fortsättningsvis genomförs av länsstyrelserna eftersom det vid kontroll på väg stoppas djurtransportfordon av alla slag, inte bara slakttransporter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.3.3",
      "sentiment": 1.0,
      "quote": "Det är därför rimligt ur resurssynpunkt att kontroll av transport vid avlastning överförs till Livsmedelsverket och att de ges mandat och möjlighet att kontrollera inte bara djuren utan även transportfordonet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.3.4",
      "sentiment": 1.0,
      "quote": "Eftersom Livsmedelsverket redan har personal på plats, och i och med EU-lagstiftningens krav, är det enda rimliga att Livsmedelsverket har uppdraget.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.4",
      "sentiment": 0.8,
      "quote": "Om förslaget genomförs är det både rimligt och lämpligt att den kontrollen överlåts till den myndighet som utför livsmedelskontrollen när det är till nytta för enskilda anläggningar och företag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.5",
      "sentiment": 0.5,
      "quote": "Eftersom ingen sådan lösning har presenterats är det bra att frågan tas om hand genom Livsmedelsverkets försorg.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a20.1.4",
      "sentiment": 1.0,
      "quote": "Det är orimligt att uppgifter som en myndighet behöver för sitt kontrollarbete inte kan överföras på grund av sekretess.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a21.3.3",
      "sentiment": 1.0,
      "quote": "regeringen uttalat att kontroll av livsmedel och foder i primärproduktionen ska anslagsfinansieras för att stärka det svenska jordbrukets konkurrenskraft.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a21.6.2",
      "sentiment": -0.2,
      "quote": "I och med det är det komplicerat för varje länsstyrelse att på ett rättvist och rimligt sätt ta ut en årlig avgift.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a22.1",
      "sentiment": 0.0,
      "quote": "Länsstyrelsen bedömer att ett arbete med att förbättra råd och stöd inte är avhängigt av en centralisering",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a22.3",
      "sentiment": 0.5,
      "quote": "Länsstyrelsen kan se behovet av ett mer formaliserat samverkansarbete med branscher och aktörer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a23",
      "sentiment": -0.2,
      "quote": "Länsstyrelsen bedömer att de förslag som tas upp i avsnitt 23.1 och 23.2 går att genomföra utan centralisering.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a24",
      "sentiment": 0.8,
      "quote": "Det behövs ett strukturerat långsiktigt arbete som ser till företagens intresse och bevakar proportionalitetsfrågan, inte minst när det gäller sanktioner som kan drabba mindre företag väldigt hårt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a26.11.20",
      "sentiment": -1.0,
      "quote": "Utredningens förslag innebär orimliga konsekvenser med två ytterligare kontrollmyndigheter.",
      "quote_type": "grund"
    }
  ]
