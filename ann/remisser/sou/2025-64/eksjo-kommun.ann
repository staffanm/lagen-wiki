  "segments": [
    {
      "forarbete_id": "a18",
      "sentiment": -1.0,
      "quote": "Detta innebär en tydlig inskränkning av det kommunala självstyret och riskerar att skapa ett glapp mellan kontrollmyndighet och de lokala verksamheter som omfattas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a21.4",
      "sentiment": 0.5,
      "quote": "Vi välkomnar ambitionen att minska avgiftsbördan för småföretag och skapa mer förutsägbara avgifter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a22.2",
      "sentiment": 0.2,
      "quote": "Men vi vill understryka att detta inte är en fråga om organisationsnivå, utan om strukturer, it-lösningar och arbetsformer.",
