    },
    {
      "forarbete_id": "a22.1",
      "sentiment": -0.5,
      "quote": "Rådgivning kräver förståelse för lokala förhållanden, branschvariationer och företagens praktiska villkor – något som är svårare att uppnå om arbetet sker över större geografiska områden.",
      "quote_type": "grund"
    },
    {
