  "segments": [
    {
      "forarbete_id": "a19.1",
      "sentiment": 0.8,
      "quote": "Svenskt Vatten bedömer att detta inte uppfylls med rådande kontrollorganisation och vi anser därför att utredningens förslag till en centraliserad kontroll kan råda bot på detta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.1.6",
      "sentiment": 0.8,
      "quote": "Då dricksvattenlagstiftningen som helhet är nationellt reglerad och skiljer sig avsevärt från övrig livsmedelslagstiftning krävs bred och djup kunskap i detta regelverk för att kunna genomföra en likriktad, rättssäker och effektiv kontroll.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.1.7",
      "sentiment": 0.8,
      "quote": "Det är också nödvändigt med lokal eller regional anknytning för att skapa närhet och förståelse mellan kontrollmyndigheten och dricksvattenleverantörerna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a21.1",
      "sentiment": 0.8,
      "quote": "Svenskt Vatten delar utredningens bild av att det finns anledning att inte ha avgifter för den offentliga dricksvattenkontrollen som belastar dricksvattenleverantörerna och kan påverka deras ekonomi negativt, där fokus i stället kan ligga på andra nödvändiga investeringar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a26.10.7",
      "sentiment": 0.8,
      "quote": "Svenskt Vatten ser därför positivt på de förslag som ges kring att införa bestämmelser om att kontrollmyndigheten ska föra dialog med branschföreträdare för att uppnå en ökad förståelse och förenkla kontrollen.",
      "quote_type": "grund"
    }
