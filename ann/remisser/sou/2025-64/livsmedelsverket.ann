  "overall": {
    "sentiment": 0.5,
    "quote": "Vi anser att en centralisering till Livsmedelsverket och Jordbruksverket skapar bättre möjligheter att uppnå en likvärdig, effektiv och ändamålsenlig kontroll än nuvarande kontrollorganisation med cirka 270 kontrollmyndigheter.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a1.1",
      "sentiment": -0.2,
      "quote": "Vi är i grunden mycket positiva till samordning och samverkan på en övergripande nivå, men är tveksamma till lämpligheten i att införa detaljerade krav för samordning och samverkan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.2",
      "sentiment": -0.2,
      "quote": "Som 19 b § utformats är det dock vår uppfattning att det ligger nära till hands att dra slutsatsen att kontrollmyndigheter åläggs en skyldighet vars fullgörande förutsätter att de besitter god kännedom om bestämmelser inom andra myndigheters ansvarsområden och därutöver gör bedömningar som det i grunden ankommer andra myndigheter att göra.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.3",
      "sentiment": 0.0,
      "quote": "Vi anser att det finns ett behov av att klargöra bland annat om det för beslut om överlåtelse förutsätts att beslutet är till nytta för samtliga berörda anläggningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.8",
      "sentiment": 0.0,
      "quote": "Enligt Livsmedelsverkets bedömning bör det vara tillräckligt att den myndighet som bemyndigas att meddela föreskrifter enligt 7 § kan fatta beslut enligt samma paragraf.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.11",
      "sentiment": -0.2,
      "quote": "Offentlig kontroll är dock en verksamhet som utförs av behöriga myndigheter, alternativt organ eller personer med delegerade uppgifter, varför syftet med rådgivningen och stödet samt dialogen bör omformuleras och förtydligas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16",
      "sentiment": 1.0,
      "quote": "En förändring måste ske för att uppnå en likvärdig och effektiv kontroll.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a17",
      "sentiment": 0.5,
      "quote": "Vi anser att samordningsproblematiken kommer att kvarstå så länge det finns mer än en kontrollmyndighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a18",
      "sentiment": 0.5,
      "quote": "Oavsett kontrollorganisation kommer det att finnas delar i Sverige där geografi och demografi kan vara utmanande för utförandet av kontrollen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19",
      "sentiment": 0.8,
      "quote": "Vi anser att en centralisering till Livsmedelsverket och Jordbruksverket skapar bättre möjligheter att uppnå en likvärdig, effektiv och ändamålsenlig kontroll än nuvarande kontrollorganisation med cirka 270 kontrollmyndigheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a20.1",
      "sentiment": -0.2,
      "quote": "Vi anser det dock inte lämpligt att, såsom föreslås i bland annat 19 b § förslag till lag om ändring i livsmedelslagen (2006:804), ålägga kontrollmyndigheter en skyldighet vars fullgörande förutsätter att de besitter expertkompetens inom andra myndigheters ansvarsområden och därtill måste göra bedömningar som i övrigt ankommer på andra myndigheter att göra.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a21",
      "sentiment": 0.2,
      "quote": "Det är på många plan svårt att säkerställa en anläggnings produktionsmängd, både för företaget och för kontrollmyndigheten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a22",
      "sentiment": -0.2,
      "quote": "Vi är tveksamma till att formerna för samordning och samverkan detaljregleras genom författning, den bör i stället ges möjlighet att utveckla då organisationsreformen är genomförd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a23",
      "sentiment": 0.2,
      "quote": "Vi är dock tveksamma till att det i vår instruktion skrivs in med sådan detaljnivå där typ av företag, det vill säga mikroföretag, nämns.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a24",
      "sentiment": 0.0,
      "quote": "Vi är därför tveksamma till att den fullt ut kan konsolideras på det sätt som beskrivs i betänkandet och även att målet “likvärdig tillämpning” bäst uppnås på aktuellt vis.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a25",
      "sentiment": 0.0,
      "quote": "Samtidigt är det svårt att tillstyrka den tänkta tidplanen då det hänger på när riksdagen kommer att ta beslut, samt när uppdrag och finansiering ges till berörda kontrollmyndigheter för att inleda förberedelser inför organisationsreformen",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a26",
      "sentiment": 0.0,
      "quote": "Vi anser dock att vissa viktiga konsekvenser uteblivit och vill tillägga följande",
      "quote_type": "grund"
    }
  ]
}