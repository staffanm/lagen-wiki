  "overall": {
    "sentiment": -0.5,
    "quote": "Närheten till företagen samt den lokala kännedomen och flexibiliteten kommer försämras avsevärt.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "sec518",
      "sentiment": 0.8,
      "quote": "Det finns flera fördelar med den modell som Statskontoret rekommenderar, dels förblir den lokala närvaron kvar dels får myndigheterna en resiliens vid oförutsedda händelser som sjukdom eller annan frånvaro.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec600",
      "sentiment": -0.5,
      "quote": "Risken är att inte alla kommer byta organisation, vilket gör att det kommer bli ett tapp av kompetens och erfarenhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a22.1.3",
      "sentiment": -0.5,
      "quote": "Mätningen 2024 för livsmedelskontrollen i Sverige, visar att livsmedelskontrollen har ett mycket högt värde inom serviceområdena, bemötande, kompetens, rättssäkerhet samt effektivitet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a23",
      "sentiment": 0.8,
      "quote": "Regellättnader är inte beroende av kontrollorganisationens struktur, utan kan göras oavsett strukturen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a25.3",
      "sentiment": 0.5,
      "quote": "Nämnden anser att ett heltäckande system för revision av kontrollorganisationen skulle få en positiv effekt på likvärdigheten, tillsammans med krav på att myndigheten ska bestå av minst tre årsarbetskrafter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a22.1",
      "sentiment": -0.8,
      "quote": "Nämnden anser att denna rådgivning kommer försämras med ett statlig övertagande, vilket skulle försämra situationen för många mikroföretag med diversifierad verksamhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a20.3",
      "sentiment": 0.8,
      "quote": "Det finns många fördelar både för kontrollmyndigheterna och för företagen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec601",
      "sentiment": -0.2,
      "quote": "Nämnden håller med om utmaningen som föreligger, men anser att den riskerar att förvärras med färre kontor än idag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.1",
      "sentiment": 0.8,
      "quote": "Det här tillsammans med iRASFF skulle ha en positiv effekt på att stoppa farliga livsmedel, samt försvåra för oseriösa och illegala verksamheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.2.2",
      "sentiment": -0.5,
      "quote": "Det här saknas helt och hållet från Jordbruksverkets sida, vilket också påverkar den kommunala ABP-kontrollen på ett negativt sätt.",
      "quote_type": "grund"
    }
  ]
}