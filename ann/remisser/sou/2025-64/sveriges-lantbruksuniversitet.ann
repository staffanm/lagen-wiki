  "segments": [
    {
      "forarbete_id": "a6.2.2",
      "sentiment": -0.5,
      "quote": "Enligt EU-bestämmelserna (kontrollförordningen EU 2017/625) ska rådgivningen vara åtskild från kontrollen.",
