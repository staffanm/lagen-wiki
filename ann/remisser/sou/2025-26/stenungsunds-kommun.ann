    },
    {
      "forarbete_id": "a7.4.1",
      "sentiment": -0.2,
      "quote": "ställer sig Stenungsunds kommun frågande till om regeländringarna kommer att ge förskollärare och lärare ökad kontroll över sina arbetsuppgifter och frigöra tid för undervisningsuppdraget.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.3",
      "sentiment": 1.0,
      "quote": "Stenungsunds kommun välkomnar utredningens förslag.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.5.1",
      "sentiment": 1.0,
      "quote": "Nuvarande reglering är svårtolkad och svårtillämpad och riskerar att leda till en rättsosäkerhet för både barn, elever, personal och rektorer.",
