  "overall": {
    "sentiment": 0.0,
    "quote": "SPSM kan se fördelar med att reglera förskollärare och lärares undervisningsuppdrag, men utifrån SPSM:S roll som huvudman för specialskolan anser myndigheten att detta med fördel görs inom ramen för överenskommelser mellan arbetsmarknadens parter, då det bedöms skapa bättre förutsättningar för anpassningar kopplat till lokala och verksamhetsspecifika behov.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a6.3.1",
      "sentiment": 0.2,
      "quote": "För elever med funktionsnedsättning och elever i behov av stöd kan en tätare kontakt mellan hem och skola vara nödvändig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.2",
      "sentiment": 1.0,
      "quote": "Det kan i sin tur stärka lärares möjlighet att styra över sin tid, så att fokus kan läggas på att forma en god undervisning för alla elever.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.3",
      "sentiment": 1.0,
      "quote": "SPSM tillstyrker förslaget.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.3.4",
      "sentiment": 0.2,
      "quote": "det är otydligt vad som avses i betänkandet med ”riktlinjer”.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.1",
      "sentiment": 0.5,
      "quote": "Ett år mellan samtal kan samtidigt vara en mycket lång tid om det finns särskilda behov eller svårigheter gällande elevens utveckling och lärande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.1",
      "sentiment": 1.0,
      "quote": "Det finns idag risk för att känslig information nedtecknas och att omdömen på ett olämpligt sätt kommenterar elevens egenskaper i delen om elevens utveckling i övrigt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7",
      "sentiment": 0.5,
      "quote": "Punkterna två och tre behöver även omfatta skolformer med statliga skolhuvudmän, vilket förbises i förslaget.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.1",
      "sentiment": 1.0,
      "quote": "Det är en del av att värna och förmedla skolans värdegrund, och bidrar samtidigt till att värna skolsituationen och trivsel för de elever som utsätts för kränkande behandling.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.3",
      "sentiment": -1.0,
      "quote": "Det är enligt SPSM svårt att separera det som händer mellan elever under deras tid i skolan och elevernas fritid på ett sådant sätt att skolans ansvar begränsas till enbart det som sker i verksamheten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.1",
      "sentiment": 0.0,
      "quote": "goda relationer mellan lärare och elever är en viktig förutsättning för lärande och inte bör betraktas som en verksamhet vid sidan om undervisningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.2",
      "sentiment": 0.0,
      "quote": "det finns nackdelar med att reglera denna typ av frågor på förordningsnivå, då det sannolikt blir svårare att fånga och ta hänsyn till lokala- och verksamhetsspecifika behov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.3",
      "sentiment": -1.0,
      "quote": "SPSM menar att utredningen inte tydligt visar att det är själva undervisningstiden som bör regleras, utan det som framkommer är framförallt, enligt SPSM, att lärare behöver ges bättre förutsättningar att bedriva för- och efterarbete inom undervisningsuppdraget.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.4",
      "sentiment": -1.0,
      "quote": "grundförhållandet 1:1 högt satt utifrån de skiftande behov och varierande organisering av verksamheten som kan finnas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.7",
      "sentiment": -0.2,
      "quote": "frågor med fördel bör lösas avtalsvägen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": 1.0,
      "quote": "Det är rimligt att det är rektor som ansvarar för detta utifrån rektors ansvar över skolans inre organisation.",
      "quote_type": "grund"
    },
    {
