  "overall": {
    "sentiment": -0.3,
    "quote": "Som förslagen i betänkandet är utformade skulle de hämma möjligheterna att organisera förskolan och skolan på det sätt som de lokala behoven och förutsättningarna kräver.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a6.3.1",
      "sentiment": -0.2,
      "quote": "Det finns dock en risk att formuleringen ”vid tillfällen som bestäms av förskolan/skolan” blir onödigt rigid och i stället tolkas som mer formaliserad, särskilt när det gäller de yngre barnen och eleverna samt elever i den anpassade grundskolan, där information till vårdnadshavare ofta sker informellt i samband med hämtning och lämning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.1",
      "sentiment": 0.5,
      "quote": "ser att det kan frigöra tid för lärares undervisningsuppdrag, men det är samtidigt viktigt att det inte medför negativa konsekvenser för elever.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.1",
      "sentiment": -0.5,
      "quote": "Det bör även i fortsättningen finnas en möjlighet för skolan att föra in omdömen om elevens utveckling i övrigt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7",
      "sentiment": 0.5,
      "quote": "För att minska det administrativa dubbelarbetet och i övrigt underlätta administrationen anser SKR att det behövs ett konkret och nationellt arbete kring ett samlat digitalt ekosystem för skolväsendet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.1",
      "sentiment": 0.5,
      "quote": "Förändringarna behöver dock jämkas med förslag på området i andra utredningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.1",
      "sentiment": -0.5,
      "quote": "Det kan vara olika medarbetare som får kännedom om kränkningar, och om till synes isolerade händelser inte dokumenteras eller förs vidare till rektor finns risken att upprepningar inte uppmärksammas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.3",
      "sentiment": 1.0,
      "quote": "Kravet på att utreda händelser i samband med verksamheten har medfört orimliga krav på skolor, som bland annat förväntas utreda vad som skett i sociala medier på elevers fritid.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5",
      "sentiment": 1.0,
      "quote": "regelverket om kränkande behandling som det är utformat idag är mycket dokumentationsdrivande och behöver ses över i sin helhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.1",
      "sentiment": -0.5,
      "quote": "den föreslagna definitionen då den kan leda till en alltför snäv begränsning av förskollärares och lärares uppdrag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.3",
      "sentiment": -1.0,
      "quote": "Rektor behöver ha möjligheter att omfördela arbetsuppgifter utifrån situationer som uppkommer i verksamheten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.2",
      "sentiment": -0.5,
      "quote": "när viktningen sätts i relation till detaljreglerade undervisningstak bidrar det på ett orimligt sätt till rektors arbetsbörda och gör det dessutom svårare att ta hänsyn till elevers och lärares faktiska behov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.4",
      "sentiment": -0.5,
      "quote": "Omfattningen av en enskild lärares tid för de olika delarna i läraruppdraget avgörs bäst mellan lärare och rektor.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.7",
      "sentiment": -0.5,
      "quote": "Idag avgörs mängden tid för planering och uppföljning genom lokala kollektivavtal, riktlinjer, och/eller i överenskommelser mellan medarbetare och chef.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.8",
      "sentiment": -0.5,
      "quote": "Det blir då inte barnens och verksamhetens behov som styr, utan tillgången till legitimerade.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": 1.0,
      "quote": "Att lärare ska ha förutsättningar för att genomföra sitt uppdrag ingår dock redan idag i rektorns ansvar för att besluta om skolans inre organisation samt genom arbetsmiljöansvaret.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5",
      "sentiment": -0.2,
      "quote": "Som tidigare framgått är SKR:s principiella uppfattning att det här är ett ansvar för parterna på svensk arbetsmarknad.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9",
      "sentiment": 0.5,
      "quote": "SKR anser att större reformer i de flesta fall bör införas som försöksverksamhet och utvärderas innan en övergång till permanent lagstiftning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10",
      "sentiment": -0.5,
      "quote": "Det uppstår ett omfattande behov av fler lärare och personal genom förslagen om att reglera såväl undervisningstid som tid för planering och uppföljning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11",
      "sentiment": -0.5,
      "quote": "utredningen har underskattat effekterna både vad gäller kostnader och behov av personal.",
      "quote_type": "grund"
    }
  ]
