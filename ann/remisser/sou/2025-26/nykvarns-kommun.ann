  "overall": {
    "sentiment": 0.5,
    "quote": "Vi bedömer att förslagen sammantaget är välmotiverade, men att genomförandet förutsätter att regeringen säkerställer finansiering, stödstrukturer och realistiska organisatoriska villkor, särskilt för mindre huvudmän.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a6.3.1",
      "sentiment": 0.5,
      "quote": "Det är positivt att skolan själv får besluta om tidpunkt för informationsgivning, då detta skapar bättre förutsättningar för skolpersonalen att fokusera på sina övriga arbetsuppgifter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.1",
      "sentiment": 0.2,
      "quote": "Vi instämmer i utredningens förslag att ändra bestämmelsen om personalens skyldighet från att aktivt motverka kränkande behandling till att uppmärksamma och agera, då minskad dokumentation kan ge förskollärare och lärare mer tid att fokusera på undervisningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.1",
      "sentiment": 0.5,
      "quote": "Förslaget minskar dokumentationsbördan och frigör tid för undervisning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.1",
      "sentiment": 0.5,
      "quote": "Vi bedömer att detta tydliggör att det är elevens kunskapsutveckling som ska stå i fokus.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.3",
      "sentiment": 0.2,
      "quote": "Vi anser dock att förslaget riskerar att skapa betydande bemanningsutmaningar, särskilt mot bakgrund av lärarbristen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.7",
      "sentiment": 0.5,
      "quote": "Det tydliggör att även fritidshemmet bedriver undervisning som kräver planering för att uppnå god kvalitet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.8",
      "sentiment": 0.5,
      "quote": "Förslaget möjliggör en avsevärd förbättring av kvaliteten i undervisningen och skapar bättre förutsättningar för samtal, anpassningar och dokumentation.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.1",
      "sentiment": 0.2,
      "quote": "Samtidigt ser vi en risk med att stödet till elever i behov av särskilt stöd kan komma att utföras av personal utan rätt utbildning, till exempel elevassistenter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.4",
      "sentiment": 0.2,
      "quote": "Vi instämmer i förslaget, dock vill vi betona att förslaget om en nationell styrning av lärares planering och undervisning minskar flexibiliteten för rektors inre organisation och anpassningar utifrån verksamhetens behov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.6",
      "sentiment": 1.0,
      "quote": "En tydligare reglering ger rektorn möjlighet att fokusera på det pedagogiska uppdraget, medan huvudman tar ett större ansvar för administrativa frågor.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.7.1",
      "sentiment": 0.5,
      "quote": "Förslaget medför dock ökade arbetsuppgifter på huvudmannanivå, vilket skapar behov av fler tjänster och nya yrkeskategorier, både inom central förvaltning och på skolorna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.7.3",
      "sentiment": -0.2,
      "quote": "Nykvarn ligger nära Stockholm, vilket gör det svårt att konkurrera med de högre lärarlönerna i regionen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.10.2",
      "sentiment": -0.5,
      "quote": "Vi anser att det inte är rimligt att den föreslagna ökningen av planerings- och uppföljningstid för förskollärare och lärare i fritidshem ska genomföras utan statlig finansiering.",
      "quote_type": "grund"
    }
  ]
