  "segments": [
    {
      "forarbete_id": "a6.3.1",
      "sentiment": 0.8,
      "quote": "Den föreslagna regleringen är en välavvägd kompromiss som skapar förutsättningar för skolan att själv bestämma hur och när information ska ges, samtidigt som det tydligt framgår att information faktiskt måste ges.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.2",
      "sentiment": 0.8,
      "quote": "Den föreslagna ändringen tydliggör fortsatt vikten av, och kravet på, att informera elever och vårdnadshavare, men skapar samtidigt bättre förutsättningar för skolorna att göra det mer samlat och strukturerat än idag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.4",
      "sentiment": 0.8,
      "quote": "Genom att ta fram samlade riktlinjer för vad som utgör ändamålsenlig undervisningsnära dokumentation skapas en gemensam bild och rekommendation om vad som är en rimlig nivå.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.1",
      "sentiment": -0.8,
      "quote": "Utvecklingssamtalet är en av få funktioner i skolan för att systematiskt följa upp och ge information om elevens situation till både vårdnadshavare och elev.",
