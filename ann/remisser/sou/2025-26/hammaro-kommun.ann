  "segments": [
    {
      "forarbete_id": "a6.3.1",
      "sentiment": 0.0,
      "quote": "Att inte använda begreppet fortlöpande ser vi inte kommer påverka tiden för undervisningsuppdraget nämnvärt, eftersom vårdnadshavare ska fortsatt informeras utifrån barnets utveckling och progression i lärandet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.1",
      "sentiment": 0.5,
      "quote": "Det finns då tid kvar att påverka utveckling och lärande resterande del av terminen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5",
      "sentiment": 1.0,
      "quote": "Om lärare noggrant vill följa en elevs sociala utveckling kan det göras inom ramen för stödinsatser eller insatser från elevhälsan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7",
      "sentiment": 1.0,
      "quote": "Det behövs mer likvärdiga system mellan huvudmän.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6",
      "sentiment": 1.0,
      "quote": "Vi välkomnar undervisningsnära dokumentation som är ändamålsenlig från Skolverket.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.6.1",
      "sentiment": -0.2,
      "quote": "Hur begreppet benämns är inte det viktiga utan vem som har mandatet att fatta beslut om stödet/extra anpassningarna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8",
      "sentiment": 1.0,
      "quote": "Det ska vara ett stöd för enhetens kvalitetsoch utvecklingsarbete med fokus barnens/elevernas lärande, utveckling och välbefinnande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.1",
      "sentiment": 1.0,
      "quote": "Vi instämmer i skrivningen kring de nya bestämmelserna mot kränkande behandling som innefattar att uppmärksamma och agera är bra förtydliganden.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.4.3",
      "sentiment": -0.2,
      "quote": "Det kommer vara svårt att skilja på kränkningar som sker i verksamhet och utanför verksamhet eftersom de påverkar varandra i hög grad oavsett vad som regleras i styrningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5.1",
      "sentiment": 1.0,
      "quote": "Det krävs ett medvetet och systematiskt främjande arbete.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.1",
      "sentiment": 1.0,
      "quote": "Vi instämmer att det är bra med en definition av undervisningsuppdraget i sin helhet i Skollagen där även planering och uppföljning ingår.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.2.5",
      "sentiment": 0.0,
      "quote": "Rektor ansvarar idag för sin inre organisation så i praktiken så vi ser inte tydligt hur detta förslag leder till att lärare generellt får mer tid för undervisningsuppdraget.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.3",
      "sentiment": 1.0,
      "quote": "Vi instämmer med att en högsta omfattning av lärares arbetstid är reglerad.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.2.4",
      "sentiment": -0.5,
      "quote": "Om detta inte ses över kommer det innebära stora kostnader för huvudmän då lärare i så fall kommer att undervisa mindre antal timmar för att få ut sin planering och uppföljningstid.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.6",
      "sentiment": 0.5,
      "quote": "Dock behövs ett tydligt stöd och vägledning för faktorer som ska ligga till grund för bedömningen i utformandet av tid.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": 0.2,
      "quote": "förslag om att förtydliga rektors ansvar för förskollärares och lärares undervisningsuppdrag inte får vara för detaljstyrt utan att det stöd som ska ges till huvudman och rektor i att skapa förutsättningar bör vara vägledande.",
