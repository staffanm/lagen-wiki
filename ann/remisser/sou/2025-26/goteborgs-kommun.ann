  "overall": {
    "sentiment": -0.4,
    "quote": "Göteborgs Stads övergripande bedömning är dock att det saknas en mer djupgående analys av förslagens konsekvenser för barn och elever, att förslagen inte i tillräcklig utsträckning har ett barn- och elevrättsperspektiv samt att det inte framgår tillräckligt tydligt hur flera av förslagen kommer gynna barn och elevers lärande och utveckling.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a6",
      "sentiment": 0.5,
      "quote": "Förslagen bedöms kunna ge professionen ett tydligare mandat, vilket är positivt, men det behöver vara tydligt att det är behoven hos det enskilda barnet eller eleven som är utgångspunkten för när och hur kommunikation sker samt hur ofta utvecklingssamtal ska äga rum.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.1",
      "sentiment": 0.2,
      "quote": "Dock är det viktigt att synliggöra att personalen också har ett ansvar i det förebyggande arbetet, vilket saknas i förslaget till ny formulering.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": -1.0,
      "quote": "Även om nuvarande reglering genererar en stor mängd dokumentation finns det risk för att förslaget kommer leda till subjektiva bedömningar om vad som är en allvarlig kränkning eller ej.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.3",
      "sentiment": -1.0,
      "quote": "Alla kränkningar som påverkar hur barn och elever mår i verksamheten behöver hanteras, oavsett var de sker.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8",
      "sentiment": -1.0,
      "quote": "Förslagen innebär en inskränkning av den kommunala självstyrelsen och är en principiell ändring av statens styrning av hur huvudmännen kan använda en av sina viktigaste resurser, förskollärare och lärare.",
      "quote_type": "grund"
