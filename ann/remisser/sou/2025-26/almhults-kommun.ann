    },
    {
      "forarbete_id": "a6.4.1",
      "sentiment": -0.2,
      "quote": "Om man samtidigt tar bort formuleringen om att information ska ges fortlöpande, se Älmhults kommun att pendeln kan slå för långt åt andra hållet och vårdnadshavarna får för lite information?",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.1",
      "sentiment": 0.5,
      "quote": "Älmhults kommun delar uppfattningen att IUP kan leda till en administrativ börda, då långt ifrån alla elever är i behov av en dylik då utbildningen fortlöper som kan förväntas.",
      "quote_type": "grund"
