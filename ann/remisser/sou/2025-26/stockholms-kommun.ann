  "segments": [
    {
      "forarbete_id": "a8.2",
      "sentiment": -0.5,
      "quote": "Kostnadsberäkningarna är bristfälliga, vilket innebär att det förslag som har lämnats är kraftigt underfinansierat.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.1",
      "sentiment": 0.2,
      "quote": "För att fånga in att det kan vara motiverat med en tätare kontakt bör förslaget kompletteras med en skrivning med innebörden att information också ska ges när läraren/skolan bedömer det som rimligt och är viktigt för elevens utveckling.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.1",
      "sentiment": -0.2,
      "quote": "Om regelbundna och planerade möten minskar kan det istället innebära att de ”spontana” kontakterna från vårdnadshavare ökar eftersom frågor som behöver redas ut sällan kan vänta flera månader.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": -0.5,
      "quote": "I förskolan bör all kränkande behandling ses som allvarlig, då det rör små barn, som ofta saknar ett eget utvecklat verbalt språk för att själva kunna berätta om händelsen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.3",
      "sentiment": -0.2,
      "quote": "Det är däremot tveksamt om förslaget kommer att frigöra tid för skolpersonalen, som kommer att behöva hantera och vidta åtgärder om följder av kränkande behandling som skett utanför verksamheten fortsätter in i verksamheten",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7",
      "sentiment": 1.0,
      "quote": "Förskoleförvaltningen ställer sig bakom utredningens förslag.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.8",
      "sentiment": 1.0,
      "quote": "Förskoleförvaltningen instämmer i utredningens bedömning att det krävs prioriteringar från alla nivåer i skolväsendet för att undvika att dokumentationskraven blir för högt ställda.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.8",
      "sentiment": 0.5,
      "quote": "Förvaltningen bedömer att vid ansträngda personalsituationer kommer tid för planering och uppföljning inte kunna prioriteras, i synnerhet om förslaget inte innebär ökade resurser för förskolan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": 1.0,
      "quote": "Rektor har ett stort och viktigt uppdrag och det är därför positivt med tydliggörande kring uppdraget.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.10",
      "sentiment": -1.0,
      "quote": "Att gå vidare med förslaget i sin nuvarande form med den finansiering som föreslås skulle innebära att finansieringsprincipen kraftigt åsidosätts och att kostnaderna i stället läggs på kommunerna.",
