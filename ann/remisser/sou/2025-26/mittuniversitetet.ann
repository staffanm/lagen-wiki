  "segments": [
    {
      "forarbete_id": "a6.4.1",
      "sentiment": 0.5,
      "quote": "Att minska antalet utvecklingssamtal till en gång per år, kompletterat med skriftliga kunskapsplaner och digital informationsöverföring frigör tid för undervisningsuppdraget.",
