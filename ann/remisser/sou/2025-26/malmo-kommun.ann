  "overall": {
    "sentiment": 0.5,
    "quote": "Generellt ställer sig kommunstyrelsen positiv till utredningens förslag om att tydligare reglera lärares undervisningstid och minska de administrativa arbetsuppgifterna.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a6.3.2",
      "sentiment": 0.5,
      "quote": "Kommunstyrelsen ställer sig positiv till förslaget då det stärker lärarnas professionella mandat och arbetsmiljö.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.4",
      "sentiment": 0.5,
      "quote": "Kommunstyrelsen instämmer till behovet av tydliga riktlinjer som kan minska osäkerhet och onödig dokumentation.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.1",
      "sentiment": 0.5,
      "quote": "Det är rimligt att endast ett tillfälle om läsåret erbjuds elever som inte uppvisar svårigheter i vare sig skolarbetet eller sin sociala situation.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.1",
      "sentiment": 0.5,
      "quote": "Detta tydliggör uppdraget och minskar dokumentationskrav.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7",
      "sentiment": 0.5,
      "quote": "För att uppnå likvärdiga arbetsförutsättningar och god arbetsmiljö över hela landet krävs ett tydligare nationellt ansvarstagande för att utveckla, samordna och tillhandahålla digitala stödverktyg som är anpassade efter skolans behov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8",
      "sentiment": 0.5,
      "quote": "det krävs prioriteringar med från alla nivåer i skolväsendet för att undvika att dokumentationskraven blir för högt ställda.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.3",
      "sentiment": -0.2,
      "quote": "Förvaltningen ställer sig tveksamma till en sådan ordning eftersom förslaget fortsatt utgår från att det är elevens subjektiva upplevelse av att vara kränkt som är avgörande i informations- och anmälningsskyldigheten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.1",
      "sentiment": 0.5,
      "quote": "Detta utifrån att förslaget syftar att samordna med övriga delar i regelverket i 6 kap i skollagen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.3",
      "sentiment": 0.5,
      "quote": "Avgränsningen till det som sker \"i verksamheten\" gör uppdraget mer hanterbart och bidrar till ökad tydlighet för personalen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5.1",
      "sentiment": 0.5,
      "quote": "en samordning av regelverk har potential att minska dubbelarbete, otydlig styrning och tolkningsutrymme.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.1",
      "sentiment": -0.2,
      "quote": "Kommunstyrelsen anser att om undervisningsuppdraget ska definieras i skollagen, är det av stor vikt att det tydliggörs om vad undervisningsuppdraget innehåller och inte enbart hänvisas till mellanrubriker i skollagen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.2",
      "sentiment": -0.2,
      "quote": "Kommunstyrelsen anser att förslaget kommer att innebära utmaningar för rektorer att bemanningsplanerna verksamheten om de införs.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.3",
      "sentiment": 0.2,
      "quote": "Kommunstyrelsen anser att förslaget ger tydlighet och möjliggör återhämtning, men förutsätter att elevgruppernas storlek inte samtidigt ökar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.4",
      "sentiment": 0.5,
      "quote": "Att säkra tillräcklig planeringstid är en grundförutsättning för kvalitet och en god arbetsmiljö.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.7",
      "sentiment": 0.5,
      "quote": "En tydlig reglering av minsta planeringstid för fritidspedagoger skapar jämlikhet och stärker yrkesrollen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": 0.2,
      "quote": "Kommunstyrelsen ställer sig positivt till detta, men vill belysa att det bedöms medföra behov av utökade resurser och riskerar i alla fall kortsiktigt att leda till brist på lärare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4",
      "sentiment": 0.5,
      "quote": "Att organisera för administrativa och sociala stödresurser är avgörande för att avlasta lärare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5",
      "sentiment": 0.5,
      "quote": "Kommunstyrelsen ställer sig positiv till detta förslag, men att det är viktigt att materialet är lättillgängligt och anpassat efter verksamhetens behov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.6",
      "sentiment": 0.5,
      "quote": "Kommunstyrelsen ställer positiv till utredningens bedömning att det finns behov av att tydliggöra huvudmannens ansvar för att skapa förutsättningar för rektors pedagogiska ledarskap och styrning av den inre organisationen men anledning av den reglering av lärares tid som föreslås.",
