    {
      "forarbete_id": "a8.2.1",
      "sentiment": -0.5,
      "quote": "däremot motsätter sig förvaltningen förslaget om att regeringen ska meddela föreskrifter om omfattningen av tiden för undervisningsuppdraget, då förutsättningar kan se så olika ut på olika enheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.2",
      "sentiment": 1.0,
      "quote": "Förvaltningen instämmer i förslaget.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.2.3",
      "sentiment": -1.0,
      "quote": "Fler lärare kan behöva rekryteras om undervisningstiden minskar. Detta kommer innebära en ökad risk för obehörig undervisning på grund av rådande lärarbrist, vilket kan bli extra märkbart för mindre kommuner som dessutom är beroende av att personal över tid är villig att pendla.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.4",
      "sentiment": -1.0,
      "quote": "Om en erfaren lärare bedöms kunna undervisa mer än en oerfaren, blir resultatet att den erfarne även har mer planeringstid än den oerfarne – trots att det rimligen borde krävas mindre planeringstid för en erfaren lärare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.7",
      "sentiment": 1.0,
      "quote": "Förvaltningen instämmer i förslaget.",
      "quote_type": "standpunkt"
    },
    {
