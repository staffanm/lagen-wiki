  "overall": {
    "sentiment": 0.0,
    "quote": "Sammanfattningsvis anser Söderköpings kommun att utredningens ansats är lovvärd men att de konkreta förslagen riskerar i huvudsak att • leda till kostnadsökningar utifrån att fler professioner/ funktioner kommer att krävas för att utföra skolans uppdrag • leda till ökad arbetsbörda för skolledare utifrån att en mängd nya tolkningsparametrar blir en effekt av att förslagen är något otydliga.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "sec9",
      "sentiment": 0.2,
      "quote": "Men att enbart ha utvecklingssamtal en gång per läsår istället för som nu en gång per termin kan riskera att elever och vårdnadshavare inte får tillräcklig information om kunskapsläget.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec13",
      "sentiment": -0.2,
      "quote": "Stor risk för att rektor blir den som ska avgöra, vilket riskerar att öka rektors arbetsbörda.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.2",
      "sentiment": -0.2,
      "quote": "Men faktorerna i sig är svårtolkade och riskerar att leda till just den olikvärdighet som är utredningens ansats att motverka.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.3",
      "sentiment": -0.5,
      "quote": "Förslagen om att införa ett tak på undervisning ser ut att i vissa skolformer (t.ex. grundskola) leda till att fler lärare behövs för att utföra uppdraget, vilket leder till kostnadsökningar för en huvudman.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.4",
      "sentiment": -0.5,
      "quote": "Det kommer att kräva fler professioner och funktioner i skolans värld för att utföra arbetsuppgifter som åligger skolan men som inte ska ligga på lärare.",
      "quote_type": "grund"
    }
  ]
