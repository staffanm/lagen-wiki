  "overall": {
    "sentiment": -0.2,
    "quote": "Myndigheten är i grunden positivt inställd till många av de föreslagna förändringarna men ser risker med snäva tidsplaner och mängden reformer, till exempel vad gäller kvaliteten i författningsändringarna och möjligheten att förankra dem hos målgrupperna.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a6.3.1",
      "sentiment": 0.5,
      "quote": "Om vårdnadshavarna får information alltför sällan kan det försvåra deras möjligheter att ta sin del av ansvaret för barnets eller elevens utveckling.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.2",
      "sentiment": 0.5,
      "quote": "hänvisar till resonemangen i avsnitt 6.3.1 om att det är viktigt att information lämnas med viss regelbundenhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.3",
      "sentiment": 1.0,
      "quote": "Skolverket tillstyrker förslaget.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.3.4",
      "sentiment": 0.5,
      "quote": "För att Skolverket ska kunna ta fram riktlinjer i enlighet med förslaget, ser myndigheten behov av förtydligande avseende innebörden av begreppet undervisningsnära dokumentation.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.1",
      "sentiment": 1.0,
      "quote": "Myndigheten anser att förslaget kommer att kunna gynna både elever och lärare eftersom lärare förväntas få mer tid till undervisning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.1",
      "sentiment": 0.5,
      "quote": "Detta för att skapa tydlighet för hela styrkedjan om vad lärare ska dokumentera och på så sätt undvika överdokumentation.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.1",
      "sentiment": 0.0,
      "quote": "Skolverket avstår från att yttra sig i denna del, eftersom regleringen är en fråga som är aktuell i andra utredningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7",
      "sentiment": 0.5,
      "quote": "Myndigheten anser att förslaget om att särskilt utreda användningen av digitala system och verktyg för information och dokumentation i skolväsendet, behöver beakta övriga förslag och Skolverkets synpunkter rörande krav på utvecklingssamtal, omdömen och systematiskt kvalitetsarbete.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8",
      "sentiment": 1.0,
      "quote": "Skolverket instämmer i bedömningen att arbetet med systematiskt kvalitetsarbete inte ska skapa onödig dokumentation eller dubbel- och överdokumentation.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.1",
      "sentiment": -1.0,
      "quote": "framgår det enligt myndigheten inte tydligt av den föreslagna bestämmelsen att personalens skyldigheter enligt 6 kap. 5 a § skollagen innefattar ett ansvar att förebygga kränkningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.3",
      "sentiment": -1.0,
      "quote": "Myndigheten anser dock inte att det är lika självklart att det omvända bör gälla, det vill säga att sådan kränkande behandling som inträffar på barnets eller elevens fritid per automatik bör falla utanför huvudmannens utredningsansvar och därmed också utanför personalens skyldighet att informera rektorn om sådana händelser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5.1",
      "sentiment": 0.0,
      "quote": "Ett ställningstagande till huruvida reglerna om kränkande behandling bör samordnas med reglerna om trygghet och studiero bör enligt Skolverket bero till dess att det står klart vilka av alla de förslag som nu är aktuella på dessa områden som går igenom och det är möjligt att överblicka konsekvenserna av dessa ändringar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.1",
      "sentiment": 0.2,
      "quote": "Det är enligt myndigheten dock svårt att fullt ut överblicka vilka följder ett införande av en definition av lärares och förskollärares undervisningsuppdrag kan komma att få.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.2",
      "sentiment": 0.5,
      "quote": "Skolverket anser inte att förslaget är helt adekvat utformat för kommunal vuxenutbildning, utifrån hur denna skolform organiseras och erbjuder undervisning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.3",
      "sentiment": 0.5,
      "quote": "Om stödundervisning införs enligt förslagen från läroplansutredningen och elevhälsoutredningen behöver antalet timmar för undervisning eventuellt anpassas till hur man skattar behovet av stödundervisning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.4",
      "sentiment": 0.5,
      "quote": "Här saknar Skolverket en diskussion om vad förslaget får för konsekvenser i ovan nämnda skolformsdelar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.7",
      "sentiment": 1.0,
      "quote": "Skolverket tillstyrker förslaget.",
