      "quote": "Skolverket tillstyrker förslaget.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": 0.5,
      "quote": "Enligt myndigheten är det viktigt att det som anges om rektorns ansvar i läroplanen inte uppfattas som uttömmande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5",
