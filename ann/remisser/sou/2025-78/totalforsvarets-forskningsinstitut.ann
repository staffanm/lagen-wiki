  "segments": [
    {
      "forarbete_id": "a5.3.2",
      "sentiment": 0.5,
      "quote": "Vi förordar att vår kompetens och långa erfarenhet inom rymdområdet tillvaratas och betonar vikten av samordning mellan FOI och den föreslagna nya civila utrikesunderrättelsetjänsten samt att våra behov av dataförsörjning tillgodoses.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.6",
      "sentiment": 1.0,
      "quote": "FOI instämmer med utredningens påpekande av behovet att ytterligare förstärka en mer sammanhållen och strategisk nationell förmåga inom teknisk underrättelsetjänst.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.7",
      "sentiment": 0.2,
      "quote": "FOI:s roll för att bygga forskningsbaserad kunskap för underrättelsesystemet behöver emellertid både förtydligas och förstärkas ytterligare för att myndigheten ska kunna fylla den roll som betänkandet ser framför sig",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.1",
      "sentiment": 1.0,
      "quote": "FOI instämmer med utredningens förslag att den svenska underrättelseverksamheten behöver reformeras för att möta den bredare behovsbilden och för att kunna dra nytta av de nya förutsättningar för inhämtning, bearbetning, analys och delgivning som skapats av tekniska landvinningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.1",
      "sentiment": 1.0,
      "quote": "Det förändrade omvärldsläget i kombination med den tekniska utvecklingen ställer allt högre krav på ett integrerat arbetssätt – något som bör understödjas av inriktningsprocessen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.1.1",
      "sentiment": 0.5,
      "quote": "FOI anser att formerna för detta bör utredas vidare, bland annat avseende huruvida det samlade säkerhetspolitiska analysarbetet avseende Ryssland ska genomföras på avdömningsbasis eller inom en permanent struktur.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.1.4",
      "sentiment": 1.0,
      "quote": "FOI bedömer att styrning och koordinering av aktiviteter som utvecklar datadrivna processer inom och mellan berörda myndigheter är centralt för att skapa efterfrågad effekt i den digitala transformation som utredningen eftersträvar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.1.5",
      "sentiment": 0.5,
      "quote": "FOI bör vara representerade i den eventuellt framtida organisationskommitté som ska bilda den nya myndigheten i syfte att kunna ge rätt ingångsvärden avseende försvarsforskningens möjligheter och förutsättningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.1.7",
      "sentiment": 0.2,
      "quote": "Upprättandet av den föreslagna nya civila utrikesunderrättelsetjänsten sker i en orolig tid med stor säkerhetspolitisk oförutsägbarhet och risk.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2",
      "sentiment": 1.0,
      "quote": "FOI instämmer i utredningens uppfattning att den snabba teknikutvecklingen medför att förutsättningarna att genomföra militära operationer förändras på korta tidsskalor.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.3",
      "sentiment": 1.0,
      "quote": "FOI instämmer i att en stärkt samverkan med näringslivet är önskvärt.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a10.5",
      "sentiment": -0.2,
      "quote": "Risken är annars överhängande att FOI:s värdefulla och unika kunskap inte kommer till nytta inom hela det reformerade underrättelsesystemet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.1.1",
      "sentiment": 0.5,
      "quote": "I utformandet av personalrörlighet mellan myndigheterna måste hänsyn tas till FOI:s finansieringsmodell.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.1.2",
      "sentiment": -0.5,
      "quote": "FOI vill därför påpeka att sammankopplingen som görs mellan FoT-projekt och utvecklandet av en utbildningsplattform till största delen inte stämmer såsom det presenteras på s. 208– 209 i betänkandet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.1",
      "sentiment": -0.5,
      "quote": "Skälet är detsamma som framförs i betänkandet, nämligen att vi som försvarsunderrättelsemyndighet inte kan uppfattas som oberoende.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.5",
      "sentiment": 1.0,
      "quote": "FOI instämmer i utredningens bedömning att de rättsliga förutsättningarna för att kunna dela data mellan myndigheter och säkerställa gemensamma arbetsytor behöver utredas vidare, och välkomnar en sådan utredning.",
      "quote_type": "grund"
    }
  ]
