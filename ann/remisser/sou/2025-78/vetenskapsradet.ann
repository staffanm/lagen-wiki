  "overall": {
    "sentiment": 0.5,
    "quote": "Vetenskapsrådet har granskat utredningens förslag utifrån sitt uppdrag att ge stöd till grundläggande forskning av högsta vetenskapliga kvalitet inom samtliga vetenskapsområden samt de särskilda uppgifter som myndigheten har i sin roll som forskningsfinansiär och forskningspolitisk rådgivare och som ansvarig för kommunikationssystemet Swedish University Computer Network.",
    "quote_type": "standpunkt"
  },
  "segments": [
    {
      "forarbete_id": "a9.1",
      "sentiment": 0.5,
      "quote": "I rådets arbete med ansvarsfull internationalisering har det konstaterats att det finns ett ökat behov av underrättelser, inte minst hos lärosäten, för att bättre kunna göra bedömningar av internationella forskningssamarbeten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.1.3",
      "sentiment": 0.5,
      "quote": "Vetenskapsrådet anser att det finns värdefulla erfarenheter från e-forskningsinfrastrukturer och digitala repositorier för forskningsdata som kan vara relevanta för uppbyggnaden av en central och skalbar förmåga med möjlighet att processa, lagra och bearbeta mycket stora mängder data.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.3",
      "sentiment": 0.5,
      "quote": "Ökat informationsflöde skulle underlätta delning av underrättelseinformation som kan vara till gagn för lärosätens, statliga forskningsfinansiärers och andra aktörer inom forskning- och innovations bedömning av internationella samarbeten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.5",
      "sentiment": 0.2,
      "quote": "Detta eftersom de statliga forskningsfinansiärerna har erfarenhet av att fördela forskningsmedel i konkurrens utifrån tydliga kriterier och principer och efter bedömning av sakkunniga med internationellt perspektiv i kvalitetsdrivande prioriteringsprocesser.",
      "quote_type": "grund"
    }
  ]
