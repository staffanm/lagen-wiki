    },
    {
      "forarbete_id": "a9.1.4",
      "sentiment": -1.0,
      "quote": "Det är viktigt att tempot med att få den nya myndigheten på plats inte går ut över befintlig myndighetssamverkan, säkerhetsskyddet eller arbetet med teknikutvecklingen hos de befintliga underrättelse- och säkerhetstjänsterna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.1.3",
      "sentiment": 1.0,
      "quote": "Det finns stora fördelar med en nationell OSINT-förmåga ur såväl kostnads- som effektivitetshänseende.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.1.1",
      "sentiment": -1.0,
      "quote": "Utifrån detta perspektiv avstyrker Säkerhetspolisen att chefen för den nya myndigheten ges titeln nationell underrättelsechef eftersom det, inte minst i internationella sammanhang, kan ge sken av att personen ifråga har ett annat beslutsmandat än vad som verkligen kommer vara fallet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.1.2",
      "sentiment": 1.0,
      "quote": "Säkerhetspolisen ser fördelar med en ordning där den nya myndigheten har en samordnande roll för underrättelse- och säkerhetstjänsternas utlandsnärvaro i form av ansvar för en administrativ basplatta.",
