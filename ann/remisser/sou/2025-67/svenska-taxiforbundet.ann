  "segments": [
    {
      "forarbete_id": "sec292",
      "sentiment": 1.0,
      "quote": "Att intensifiera kontrollerna av taxibolag och förare ses av Förbundet som en nödvändig åtgärd för att motverka att konkurrensen snedvrids och stärka resenärernas förtroende.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec295",
      "sentiment": 1.0,
      "quote": "Svenska Taxiförbundet delar utredningens bedömning att svarttaxi, oavsett definition, utgör ett problem vid Arlanda flygplats.",
