    },
    {
      "forarbete_id": "sec294",
      "sentiment": 1.0,
      "quote": "Svenska Taxiförbundet ser positivt på ett krav på alkolås och föreslår att kravet ska implementeras succesivt inom ramen för Swedavias avtalsvillkor.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec293",
      "sentiment": -1.0,
      "quote": "Det finns dock risk att ett sådant förslag gör det svårare och mindre förutsägbart för kunderna att avgöra vilken taxi som är mest lämplig ur kundens perspektiv.",
