  "segments": [
    {
      "forarbete_id": "sec313",
      "sentiment": 0.5,
      "quote": "En viktig förutsättning för att öka det hållbara resandet är att stationsavgifterna vid Arlanda C avskaffas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec198",
      "sentiment": 1.0,
      "quote": "En ombyggnad av stationen skulle inte bara bidra till ökad kapacitet på Ostkustbanan, utan även stärka utvecklingen av den regionala stadskärnan Arlanda–Märsta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec300",
      "sentiment": 0.5,
      "quote": "Om staten önskar ett snabbare införande av expressbusslinjer, eller att dessa ska trafikeras med bussar särskilt anpassade för flygresenärer, krävs en särskild överenskommelse med Region Stockholm.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec269",
      "sentiment": -0.2,
      "quote": "Det finns därför behov av att se över lokaliseringen av bussangöringspunkterna vid Arlanda flygplats så att mesta möjliga tillgänglighet erhålls.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec279",
      "sentiment": 0.2,
      "quote": "Det är viktigt för Region Stockholm att kollektivtrafiken ges utrymme inom de föreslagna åtgärderna på E4:an.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec308",
      "sentiment": 0.5,
      "quote": "Bristerna i dagens underhåll handlar dock inte enbart om att säkerställa tillräckliga budgetmedel, utan även om organisation, planering, kompetens hos infrastrukturförvaltarna Trafikverket och Arlandabanan Infrastructure AB samt samverkan med järnvägsföretagen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec282",
      "sentiment": 1.0,
      "quote": "Utredarens förslag om förbättrad cykelinfrastruktur och cykelparkering är i linje med Region Stockholms strategier och planer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec335",
      "sentiment": 0.5,
      "quote": "Region Stockholm konstaterar att intäkterna från nuvarande trängselskatter till stora delar redan är intecknade till år 2060, vilket innebär att ytterligare finansiering den vägen behöver vara väl avvägd.",
      "quote_type": "grund"
