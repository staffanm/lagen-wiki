    },
    {
      "forarbete_id": "sec264",
      "sentiment": 1.0,
      "quote": "Sammantaget bedömer vi att utvecklingsplanens inriktning för angöringsfunktioner medför bättre effektivitet och högre kundnytta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec254",
      "sentiment": 1.0,
      "quote": "Det är viktigt att flygplatsen är attraktiv för flygbolag, resenärer, anställda och andra aktörer.",
