    },
    {
      "forarbete_id": "sec292",
      "sentiment": 1.0,
      "quote": "det är en åtgärd som får effekt och som genomförs av aktörer med rätt befogenhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec301",
      "sentiment": -0.5,
      "quote": "De åtgärder som utredningen föreslår bedömer vi medför infrastrukturella och kapacitetsmässiga utmaningar.",
