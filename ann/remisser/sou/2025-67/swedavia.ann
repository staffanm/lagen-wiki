  "segments": [
    {
      "forarbete_id": "sec313",
      "sentiment": 1.0,
      "quote": "Ytterligare utveckling av järnvägstrafiken menar vi hämmas av avstigningsavgiften på Arlanda C.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec335",
      "sentiment": 1.0,
      "quote": "Samordnaren lämnar åtgärdsförslag inom infrastruktur som är positiva och som skulle föra med sig nyttor och stärkt konkurrenskraft för Arlanda.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec345",
      "sentiment": 1.0,
      "quote": "Roslagsbanans förlängning bedöms ge stora nyttor för delar av länet som idag har låg tillgänglighet till Arlanda.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec300",
      "sentiment": 0.2,
      "quote": "Dynamiska kollektivtrafikkörfält kan vara positivt för kapacitet i vägnätet och säkra framkomlighet för bland annat busstrafik.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec299",
      "sentiment": 1.0,
      "quote": "Kollektivtrafiken har stor betydelse för resenärer och för flygplatsområdets anställda.",
