  "segments": [
    {
      "forarbete_id": "sec322",
      "sentiment": 0.8,
      "quote": "Höga Kusten Airport bör inkluderas i detta arbete, eftersom alternativa resvägar till Stockholm är mycket begränsade.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec174",
      "sentiment": 0.5,
      "quote": "Vändslingan kommer att öka redundansen i järnvägsnätet vilket är särskilt viktigt vid planerade eller oplanerade avbrott på närliggande banor.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec320",
      "sentiment": 0.8,
      "quote": "I ett säkerhetspolitiskt läge där Sveriges territoriella integritet eller logistikkedjor utmanas är fungerande regionala flygplatser helt avgörande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec318",
      "sentiment": 0.5,
      "quote": "Men små regionala flygplatser måste ges förutsättningar att delta i omställningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec313",
      "sentiment": -0.5,
      "quote": "Att lösa ut ett avtal med stora ekonomiska konsekvenser innebär en betydande statsfinansiell belastning som borde kunna användas mer effektivt – till exempel för att stärka samhällskritiska regionala flygförbindelser och robusthet inom totalförsvaret.",
      "quote_type": "grund"
    }
  ]
