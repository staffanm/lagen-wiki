    },
    {
      "forarbete_id": "sec254",
      "sentiment": 0.8,
      "quote": "en Arlandaförhandling vore välkommen för att få till stånd nödvändiga åtgärder och resurser som krävs för upprustningen av Arlanda.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec308",
      "sentiment": 0.8,
      "quote": "Längst Ostkustbanan (och likaså vägsträckan E4) förekommer ökade risker för trafikstörningar vid extremväder, vilket styrker vikten av att se över åtgärdsbehoven.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec328",
      "sentiment": 0.8,
      "quote": "Arlanda och dess omringande infrastruktur är därutöver viktiga sträckor utifrån ett totalförsvarsperspektiv och bör därmed beaktas utifrån det.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2.3",
      "sentiment": 0.8,
      "quote": "En förutsättning för att hålla tempot uppe och säkerställa de kapacitetsökningar som behövs är just förmågan att vidga vyerna och inte låsa sig fast vid till exempelvis nationell plan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec313",
      "sentiment": 0.5,
      "quote": "Om ambitionen är att öka antal tåg och förstärka kollektivtrafiken är en sänkning, alternativt en avskaffning av stationsavgiften, en förutsättning för att detta ska möjliggöras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec304",
      "sentiment": 0.8,
      "quote": "Ökad kapacitet gällande godsflöden till och från Arlanda är viktiga för Sverige utifrån flertal aspekter, inte minst för tillväxt och försörjningsberedskap.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec307",
      "sentiment": 0.8,
      "quote": "Ett ökat kollektivt resande har stora fördelar, inte minst medför det ett bättre kapacitetsnyttjande av infrastrukturen.",
