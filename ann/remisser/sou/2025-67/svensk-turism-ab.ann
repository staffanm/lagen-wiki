  "overall": {
    "sentiment": 0.8,
    "quote": "Svensk Turism ser utredningen som ett viktigt steg mot ett konkurrenskraftigt Arlanda och betonar vikten av att arbetet nu drivs vidare skyndsamt och med bred politisk samsyn.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "sec269",
      "sentiment": 0.5,
      "quote": "Den nuvarande lösningen där busstrafiken inte får angöra terminal 5 skapar stora problem både med bussangöring som inte räcker till, för få hållplatslägen och för lång gångsträcka för resenärer från busshållplatsen till/från terminal 5.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec288",
      "sentiment": 0.8,
      "quote": "Alla smidiga övergångar mellan olika trafikslag är viktiga för helhetsupplevelsen av resan till, från och inom Sverige och då spelar flygplatsens utformning och placering av kundtjänst för hyrbil och av taxiyta i förhållande till terminalutgångarna stor roll.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec291",
      "sentiment": 0.8,
      "quote": "En väl fungerande taximarknad är central för flygplatsens tillgänglighet och för resenärernas förtroende.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec257",
      "sentiment": 0.8,
      "quote": "I detta arbete blir det viktigt att internationella besökares behov av information och tydlighet tillgodoses.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec266",
      "sentiment": 0.8,
      "quote": "Detta kan bidra till att flygplatsen upplevs som attraktiv både för passagerare och flygbolag vilket är viktigt i arbetet med att öka antalet internationella direktlinjer och Arlandas attraktivitet som transferflygplats.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec265",
      "sentiment": 0.8,
      "quote": "Sverige behöver inte bara utveckla en effektiv flygplats utan även en attraktiv helhetsupplevelse för resenärerna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec318",
      "sentiment": 1.0,
      "quote": "Turism bygger på förflyttning och klimatsmarta transporter är därför avgörande för en miljömässigt hållbar turism.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec311",
      "sentiment": 0.5,
      "quote": "Precis som utredningen konstaterar är det av största vikt att hitta och välja de metoder för genomförande av arbetet som ger så liten negativ påverkan som möjligt på resandet så att tillgängligheten till och från Arlanda inte försämras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec313",
      "sentiment": 0.8,
      "quote": "På så sätt främjas sund konkurrens, effektiv användning av skattemedel och infrastruktur samt attraktiva resealternativ.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec315",
      "sentiment": 0.8,
      "quote": "att få bort ett byte skulle avsevärt förbättra besökarnas upplevelse av en smidig och sammanhållen resa.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec304",
      "sentiment": 0.8,
      "quote": "Turism och besöksnäring handlar inte enbart om transport av besökare utan även om transport av varor till butiker, hotell, restauranger, caféer etc.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec273",
      "sentiment": 1.0,
      "quote": "Svensk Turism välkomnar utredningens förslag om vidmakthållande och kapacitetsförstärkningar i området kring Arlanda för att öka tillgängligheten till flygplatsen via väg.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec300",
      "sentiment": 0.8,
      "quote": "Busstrafiken är både flexibel och har en enkel skalbarhet vilket gör att den även på längre sikt kommer att vara en del av reseerbjudandet mellan centrala Stockholm och Arlanda, inte minst för redundansen i trafiksystemet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec335",
      "sentiment": 0.8,
      "quote": "Sveriges transportinfrastruktur är i behov av stora resurser för att Sverige ska få fungerande transporter i hela landet",
      "quote_type": "grund"
    }
  ]
}