  "segments": [
    {
      "forarbete_id": "sec311",
      "sentiment": 0.5,
      "quote": "Kopplat till en ökad kapacitet önskar Region Örebro län särskilt betona behovet av ökad kapacitet på Mälarbanan för att möjliggöra mer trafik på sträckan mellan Örebro – Stockholm, viket kräver fullt dubbelspår hela vägen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec313",
      "sentiment": 1.0,
      "quote": "A-Train AB:s möjligheter att neka andra trafikeringsrätt eller rätten att ta upp och släppa av passagerare Stockholm-Arlanda, och den stationsavgift som övriga operatörer tvingas ta ut av sina resenärer, som en konsekvens av statens avtal med A-Train AB, försvårar regionernas möjlighet att bedriva en konkurrenskraftig kollektivtrafik till Arlanda.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec269",
      "sentiment": 1.0,
      "quote": "Region Örebro län instämmer i uppmaningen till Swedavia att försöka tidigarelägga investeringar i en förbättrad angöring för bussar som kan möjliggöra kortare ledtider och öka attraktiviteten för kollektivtrafiken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec300",
      "sentiment": 1.0,
      "quote": "det också föreslås en utredning av nya expressbusslinjer i tvärförbindelser, vilket ytterligare kan bidra till att vägkapaciteten nyttjas mer effektivt.",
