  "segments": [
    {
      "forarbete_id": "sec17",
      "sentiment": 1.0,
      "quote": "En utveckling i Sverige där vi ser transportsystemet som helhet är viktigt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3.2",
      "sentiment": 1.0,
      "quote": "Bättre förutsättningar för kollektivtrafiken kräver också att angöringsfunktionen förbättras, inte minst för busstrafiken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec313",
      "sentiment": 1.0,
      "quote": "För att göra det enklare och billigare att ta sig till och från Arlanda flygplats med kollektivtrafik är det här en central fråga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.1",
      "sentiment": 1.0,
      "quote": "Visita välkomnar utredningens förslag om vidmakthållande och kapacitetsförstärkningar i området kring Arlanda för att öka tillgängligheten till flygplatsen via väg.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.5",
      "sentiment": 1.0,
      "quote": "En väl fungerande taximarknad är central för flygplatsens tillgänglighet och för resenärernas förtroende.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3.1",
      "sentiment": 1.0,
      "quote": "Att korta ledtider vid Arlanda är en viktig del i att stärka flygplatsens attraktivitet, och möta ett växande antal resenärer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2.4",
      "sentiment": 1.0,
      "quote": "Sveriges transportinfrastruktur är i behov av stora resurser för att Sverige ska få fungerande transporter i hela landet och nuvarande ram för transportinfrastrukturen behövs för att sörja för dessa infrastrukturbehov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.6",
      "sentiment": 1.0,
      "quote": "Det är viktigt att luftfartens omställning beaktas i utvecklingen av Arlanda, inte minst gällande försörjning av nya drivmedel, laddmöjligheter och nya förutsättningar som eventuellt medföljer omställningen till de mindre elflygen.",
      "quote_type": "grund"
    }
  ]
