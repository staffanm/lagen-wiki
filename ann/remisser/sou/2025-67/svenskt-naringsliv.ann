  "overall": {
    "sentiment": 0.5,
    "quote": "Det finns ett stort behov av att ta ett helhetsgrepp om Arlandas utveckling, för att rusta flygplatsen för framtiden och för näringslivets behov.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a8.2",
      "sentiment": 1.0,
      "quote": "Vi delar utredningens bild av att det finns ett behov av att kraftsamla kring Arlandas tillgänglighet, och att ett trafikslagsövergripande fokus är nödvändigt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3.2",
      "sentiment": 1.0,
      "quote": "Bättre förutsättningar för kollektivtrafiken kräver också att angöringsfunktionen förbättras, inte minst för busstrafiken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.1",
      "sentiment": 1.0,
      "quote": "Det är också välkommet att underhållsåtgärder och vidmakthållande tydligt lyfts fram som prioriterade, och att Trafikverket föreslås testa nya arbets- och upphandlingsmetoder för att minimera konsekvenserna av underhållsåtgärder på trafiken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec356",
      "sentiment": -1.0,
      "quote": "Det riskerar också påverka tillgängligheten till Arlanda negativt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec313",
      "sentiment": 0.2,
      "quote": "Eventuella efterföljande åtgärder behöver däremot bygga på avvägningar mellan kostnader och nytta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3.1",
      "sentiment": 1.0,
      "quote": "Införandet av en automatiserad gränskontroll skulle ge positiv effekt på resenärens upplevelse, punktlighet och flygplatsens flöden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.7",
      "sentiment": 1.0,
      "quote": "Flygplatsen utgör en central logistiknod för både passagerar- och godstrafik, och effektiva godsflöden är avgörande för såväl import som export, försörjningsberedskap och svenska företags konkurrenskraft.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.6",
      "sentiment": 1.0,
      "quote": "Det är viktigt att luftfartens omställning beaktas i utvecklingen av Arlanda, inte minst gällande försörjning av nya drivmedel, laddmöjligheter och nya förutsättningar som eventuellt medföljer omställningen till de mindre elflygen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7",
      "sentiment": 1.0,
      "quote": "Svenskt Näringsliv välkomnar att utredningen lyfter fram tillgängligheten till Arlanda ur ett totalförsvarsperspektiv, och delar bedömningen att föreslagna åtgärder för ökat vidmakthållande och kapacitetsförstärkningar även stärker totalförsvarets förmåga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec322",
