  },
  "segments": [
    {
      "forarbete_id": "a5.8.6",
      "sentiment": -0.2,
      "quote": "Plattformens uppfattning är att en sådan ändring skulle åstadkomma att brottet kom mer i samklang med övriga brottsbalksbrott; särlösningar i vad gäller uppsåt bör undvikas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.8.4",
      "sentiment": -0.2,
      "quote": "Plattformen menar att lokutionen ”ska avse” signalerar en icke önskvärd snävhet, utan förordar i stället en formulering ”kan avse” eller, i vart fall, ”avser”.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.8.4",
      "sentiment": -0.2,
      "quote": "Erfarenheten från rättspraxis visar att domstolarna kommit att lägga avgörande vikt vid formuleringar av detta slag från förarbetena och rentav tillerkänt dem ställning som extra rekvisit.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.8.4",
      "sentiment": -0.2,
      "quote": "För barn får samtycke aldrig tillmätas rättslig betydelse.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.9",
      "sentiment": 0.5,
      "quote": "Härigenom uppfyller Sverige, inte bara förpliktelserna enligt EU-direktivet men även Europarådets anti-traffickingkonvention.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.9.3",
      "sentiment": -0.5,
      "quote": "Som förslaget nu ser ut kan svåra avgränsningsproblem uppstå.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.9.3",
      "sentiment": -0.2,
      "quote": "här har motiveringen valt det olyckliga uttrycket ”styrkt” (sidan 482: ”Avgörande vid frågan om straffansvar för olaga tjänsteutnyttjande är i stället att det finns ett sådant stöd för grundbrottet att det anses styrkt på det sätt som det krävs i brott”) i stället för ”visat”, vilket bättre torde spegla motiveringens intentioner.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.3",
      "sentiment": 1.0,
      "quote": "I dagens läge har Jämställdhetsmyndigheten erfarenhet och kompetens.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.2",
      "sentiment": -0.5,
      "quote": "Det är en ordning som är främmande för svensk förvaltningsrätt där ju varje myndighet vid varje tillfälle själv avgör vilka åtgärder som ska vidtas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.2",
      "sentiment": -0.2,
      "quote": "Avsaknad av tydlig ansvarsfördelning riskerar att leda till att skydd, stöd och rättsliga garantier faller mellan olika myndigheters mandat.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.2",
      "sentiment": -0.2,
      "quote": "Internationella rekommendationer, bland annat från OSSE avseende NRMs, betonar vikten av att barn identifieras genom särskilda barnskyddsstrukturer, att barnrättsmyndigheter involveras tidigt samt att barn tillerkänns en självständig rättslig ställning inom mekanismen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.2",
      "sentiment": 1.0,
      "quote": "Det är tydligt att det behövs en samordning av kunskap och erfarenhet i vad gäller ordnat återvändande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.1",
      "sentiment": -0.2,
      "quote": "Den finansieringsmodell som växt fram framstår som säregen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.3",
      "sentiment": 1.0,
      "quote": "Plattformen välkomnar en kartläggning av tillgången till boendeinsatser (inklusive skyddat boende) för brottsoffer för människohandel målgruppen är tillräcklig, anpassad och ändamålsenlig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.4",
      "sentiment": -0.2,
      "quote": "Plattformen vill påpeka att såväl EU-direktivet som Europarådskonventionen uppmanar staterna att ge tillfälliga uppehållstillstånd inte bara till de offer för människohandel som väljer att samarbeta med brottsutredande myndigheter (utlänningslagen 5 kap 15 §) utan även till dem som behöver det för återhämtning eller av andra skäl.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.4",
      "sentiment": -0.5,
      "quote": "Skadan som sker när våldsutsatta personer frihetsberövas i stället för att bemötas som brottsoffer är däremot stor.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.3",
      "sentiment": -0.2,
      "quote": "Plattformen har dessvärre erfarenhet av ärenden där insatserna fallerat, på grund av bristande kunskap och erfarenhet hos enskilda handläggare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.1",
      "sentiment": 0.5,
      "quote": "Plattformen välkomnar förslaget om förstärkt stöd så som framgår av utredningen.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.4.3",
      "sentiment": 1.0,
      "quote": "Plattformen välkomnar inrättandet av en nationell, oberoende rapportör i enlighet med kraven i EU-direktivet och anti-traffickingkonventionen",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.4.3",
      "sentiment": 0.2,
      "quote": "vill samtidigt understryka den höga kvalitet som präglat polisens årliga rapporter",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.3",
      "sentiment": -0.2,
      "quote": "Risken är därför att institutets rapport – till skillnad från polisens – blir teoretisk och akademisk på ett sätt som inte är fördelaktigt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.3",
      "sentiment": -0.2,
      "quote": "Den nationella rapportören bör uttryckligen åläggas att systematiskt analysera situationen för barn som utsätts för människohandel samt att redovisa hur barnets bästa beaktas i rättstillämpning, stödinsatser och återvändandeprocesser.",
      "quote_type": "grund"
    }
