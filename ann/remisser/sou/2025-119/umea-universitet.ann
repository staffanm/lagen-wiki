  "segments": [
    {
      "forarbete_id": "a5.8.4",
      "sentiment": -0.5,
      "quote": "Den föreslagna ändringen riskerar att listan på exploateringssyften vid tillämpningen kan ses som uttömmande, och möjligheten att med tiden inkludera nya exploateringssyften i tillämpningen minskar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.9",
      "sentiment": 0.2,
      "quote": "Det bör dock framhållas att tillämpningen av det nya brottet kommer vara komplicerad, dels på grund av att få fall av de bakomliggande brotten människohandel och människoexploatering upptäcks och lagförs, dels med beaktande av att det krävs att gärningsperson ska ha haft vetskap om att offret utnyttjats.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6",
      "sentiment": 1.0,
      "quote": "Juridiska institutionen delar bedömningen att det finns behov av att höja kunskapen om människohandel generellt, men också särskilt i kommunerna, för att brottsoffer för människohandel ska få bättre tillgång till stöd och skydd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.3",
      "sentiment": 1.0,
      "quote": "Det får anses viktigt att en sådan kartläggning bör omfatta alla typer av boenden som tillhandahålls, och att det även bör utvärderas om dessa boenden är lämpliga för människohandelns offer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1.5",
      "sentiment": -0.5,
      "quote": "Det finns farhågor om att offer för människohandel hanteras för migrationsrättsliga överträdelser, utan att det uppmärksammas att de är eller kan vara utsatta för människohandelsbrott.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1.5",
      "sentiment": 0.5,
      "quote": "Juridiska institutionen vill också framhålla vikten av att ge tillfälliga uppehållstillstånd inte bara till de offer för människohandel som väljer att samarbeta med brottsutredande myndigheter, utan även till dem som behöver det för återhämtning eller av andra skäl i enighet med både EUdirektivet och Europarådets konvention.",
      "quote_type": "grund"
