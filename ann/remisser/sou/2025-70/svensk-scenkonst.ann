    },
    {
      "forarbete_id": "a9.3.7",
      "sentiment": 0.2,
      "quote": "Denna typ av lösningar kommer sannolikt bli allt viktigare för att undvika att antalet uppsägningar av personliga skäl ökar i verksamheter som inte kan anpassas fullt ut för att möta behoven hos äldre medarbetare.",
      "quote_type": "grund"
