    },
    {
      "forarbete_id": "a8.1",
      "sentiment": 1.0,
      "quote": "Svensk Scenkonst tillstyrker förslaget om ikraftträdande den 1 juli 2026 då nästa höjning av riktåldern bedöms ske först år 2034.",
