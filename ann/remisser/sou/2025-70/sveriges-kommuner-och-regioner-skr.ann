  "segments": [
    {
      "forarbete_id": "a5.1",
      "sentiment": 0.5,
      "quote": "SKR delar bedömningen att las-ålder redan är ett väletablerat begrepp och att man genom införandet av begreppet i lagtext har bättre möjligheter att nå ut med information, snarare än en lösning som enbart bygger på hänvisningar i lagtexten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.1",
      "sentiment": 1.0,
      "quote": "Genom att förändring av huvudregeln genomförs är det önskvärt att begreppet återges i samtliga bestämmelser kopplade till las-åldern för enhetlighet och tydlighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.3",
      "sentiment": 1.0,
      "quote": "En sådan reglering skulle riskera att göra las-åldern svårare att överblicka, eftersom den föreslagna huvudregeln då frångås.",
