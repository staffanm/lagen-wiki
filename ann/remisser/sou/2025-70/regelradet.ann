    },
    {
      "forarbete_id": "a9.2",
      "sentiment": -0.5,
      "quote": "En sådan beskrivning har Regelrådet inte kunnat utläsa, men det hade varit värdefull information.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.6",
      "sentiment": -0.5,
      "quote": "Avsaknaden av sådana exempelberäkningar medför därför att konsekvensutredningen är ofullständig i denna del.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.6",
      "sentiment": -0.5,
      "quote": "För det fall att någon sådan påverkan inte bedöms uppstå ska det anges och motiveras, informationen kan inte utelämnas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.6",
      "sentiment": -0.5,
      "quote": "En något utförligare beskrivning, i linje med ovan, och hur stor andel små företag som bedöms påverkas av reglerna och i olika branscher, hade varit värdefull information.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5",
      "sentiment": 1.0,
      "quote": "Regelrådet finner att beskrivningen av åtgärder som har vidtagits för att förslaget inte ska medföra mer långtgående kostnader eller begränsningar än vad som bedöms vara nödvändigt för att uppnå dess syfte, är godtagbar.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.1",
      "sentiment": 1.0,
      "quote": "Regelrådet finner att beskrivningen av om särskild hänsyn behöver tas till tidpunkten för ikraftträdande och om det finns behov av speciella informationsinsatser är godtagbar.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a9.7",
      "sentiment": -0.5,
      "quote": "Det framgår visserligen hur konsekvenserna kan utvärderas – däremot saknas det en beskrivning av när så kan ske, vilket är en brist i redovisningen.",
