  "overall": {
    "sentiment": -0.2,
    "quote": "I fakultetsnämndens mening finns det emellertid risk att lagförslaget kan komma att resultera i fler oklarheter och gränsdragningsproblem än vad som är motiverat för att uppnå de eftersträvade målen.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "sec123",
      "sentiment": -0.5,
      "quote": "Den citerade formuleringen riskerar i fakultetsnämndens mening att skapa oklarheter angående den föreslagna bestämmelsens relation till den allmänna avdragsbestämmelsen i 16 kap. 1 § IL om utgifter för att förvärva och bibehålla inkomster.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec75",
      "sentiment": -0.5,
      "quote": "I fakultetsnämndens mening bör sådana villkor uttryckligen framgå i lagtexten, inte bara i förarbeten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec74",
      "sentiment": -0.2,
      "quote": "Mot bakgrund av detta bör enligt fakultetsnämnden ett annat begrepp övervägas för att undvika risken att tolkningsproblem uppstår.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec129",
      "sentiment": -0.5,
      "quote": "Fakultetsnämnden ifrågasätter för det första om gränsdragningen bör ske på sådana formella grunder eftersom materiellt lika fall i sådana fall riskerar att få olika beskattning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec125",
      "sentiment": -0.2,
      "quote": "Andra exempel på gränsdragningsproblem som fakultetsnämnden menar motiverar en djupare analys är gränsdragningen till avdragsförbudet för gåvor för företag med en större ägarkrets, relationen till uttagsbeskattning i de fall de anseendestärkande utgifterna avser varor eller tjänster samt den rättspraxis som finns om bland annat dolda värdeöverföringar, särskilt i företag med mindre ägarkrets.",
      "quote_type": "grund"
    }
  ]
}