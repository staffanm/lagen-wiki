    },
    {
      "forarbete_id": "sec70",
      "sentiment": 0.5,
      "quote": "För att säkerställa att förslaget får avsedd effekt bör vissa delar förtydligas i den fortsatta beredningen",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec74",
      "sentiment": 0.2,
      "quote": "Eftersom syftet med förslaget är att utvidga avdragsrätten är det enligt NSD viktigt att det tydliggörs att den grundläggande och väl etablerade presumtionen om avdragsrätt för ett aktiebolags utgifter även gäller enligt den nya bestämmelsen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec121",
      "sentiment": 0.2,
      "quote": "Samtidigt måste det vara upp till varje företag att avgöra hur ett samarbete bäst förmedlas för att stärka anseendet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec122",
      "sentiment": 0.2,
      "quote": "Att en sponsringsåtgärd har koppling till ägarens eller företagsledarens intressen bör inte automatiskt innebära att utgiften faller utanför den föreslagna bestämmelsen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec125",
      "sentiment": -0.5,
      "quote": "Utredningen behandlar inte frågan om uttags- eller utdelningsbeskattning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec124",
      "sentiment": 1.0,
      "quote": "NSD har inget att erinra mot förslaget.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.5",
      "sentiment": 1.0,
      "quote": "Genom den föreslagna bestämmelsen försvinner den olikbehandling som tidigare funnits mellan olika sporter och utövare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.6",
      "sentiment": 0.5,
      "quote": "NSD vill dock återigen understryka vikten av att bedömningen av om en åtgärd syftar till att förbättra eller upprätthålla näringsverksamhetens anseende görs utifrån hur varumärkesstärkande arbete bedrivs i praktiken, snarare än att fastna i teoretiska och alltför snäva tolkningar.",
