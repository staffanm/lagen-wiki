  "segments": [
    {
      "forarbete_id": "a8.4",
      "sentiment": 0.5,
      "quote": "digital teknik aldrig kan ersätta den mänskliga omsorgen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.3",
      "sentiment": 1.0,
      "quote": "Regleringen bör därför vara generellt utformad och omfatta alla insatser enligt både SoL och LSS.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec213",
      "sentiment": 1.0,
      "quote": "Vi stödjer utredningens förslag att regleringen ska omfatta all digital teknik som används utanför den mänskliga kroppen.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a1.3",
      "sentiment": 1.0,
      "quote": "Särskilt känsliga tillämpningar av digital teknik, ur ett integritetsperspektiv, ska alltid omfattas av ett krav på samtycke.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.2",
      "sentiment": 1.0,
      "quote": "endast de personuppgifter som är nödvändiga för att uppnå syftet med tekniken får behandlas",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.7.3",
      "sentiment": 1.0,
      "quote": "personuppgifter för monitorering, sensorer eller positionering endast får behandlas om den som får insatsen samtycker",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec314",
      "sentiment": 1.0,
      "quote": "om behandlingen även omfattar en närstående som stadigvarande sammanbor med den enskilde, ska även den närstående samtycka",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.7.4",
      "sentiment": 1.0,
      "quote": "regeringen eller den myndighet regeringen utser bör ges befogenhet att meddela föreskrifter om uppgifts- och lagringsminimering för digital teknik med funktioner för monitorering, sensorer eller positionering.",
      "quote_type": "standpunkt"
    }
