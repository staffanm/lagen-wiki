  "overall": {
    "sentiment": 0.5,
    "quote": "Utredningen har gjort en gedigen genomgång av gällande reglering för användning av digital teknik vid insatser enligt SoL och LSS, till barn och personer med nedsatt beslutsförmåga.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a8.4.3",
      "sentiment": 1.0,
      "quote": "Det finns behov av att tydliggöra möjligheten att använda digitala insatser enligt SoL och LSS.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.6.3",
      "sentiment": 1.0,
      "quote": "Det är viktigt att användning av digital teknik varierar utifrån insatsernas karaktär och individuella behov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5",
      "sentiment": 1.0,
      "quote": "Regleringen ska inkludera alla former av digital teknik.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.6.1",
      "sentiment": 1.0,
      "quote": "Nuvarande reglering med krav på inflytande och kvalitet vid beslut enligt LSS och SoL är tillräcklig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.1",
      "sentiment": 1.0,
      "quote": "Lagen (2001:454) om behandling av personuppgifter inom socialtjänsten SoLPUL ska innehålla integritetsskyddande åtgärder vid användning av alla insatser med integritetskänslig teknik, oavsett individens ålder.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.3",
      "sentiment": 1.0,
      "quote": "Det ska finnas krav på samtycke för att behandla personuppgifter för monitorering, rensorering och positionering samt behov av en reglering med särskilda bestämmelser som värnar individernas integritetsintresse och principerna om självbestämmande och inflytande inte endast tillfälligt nedsatt beslutsförmåga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.8",
      "sentiment": 1.0,
      "quote": "Befintliga dokumentationskrav i SoL och LSS för samtycke till behandling av personuppgifter är tillräckliga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.6.6",
      "sentiment": 1.0,
      "quote": "Det är därtill positivt med tydliga krav på kontinuerlig uppföljning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.11",
      "sentiment": 1.0,
      "quote": "Det gäller även förslaget att utvidga möjligheterna att vid samtycke använda lagen om behandling av personuppgifter inom socialtjänsten, i stället för att tillämpa lagen (2022:484) om elektronisk kommunikation (LEK).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.4",
      "sentiment": 0.2,
      "quote": "Tillkommer gör resurser för förvaltning, samordning och upphandling av utrustning samt investeringar och anpassningar av tillförlitlig digital infrastruktur.",
      "quote_type": "grund"
    }
  ]
