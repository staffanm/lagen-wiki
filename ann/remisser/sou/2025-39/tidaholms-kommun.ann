  "segments": [
    {
      "forarbete_id": "a8.3",
      "sentiment": 0.8,
      "quote": "Användning av sådan teknik har visat flera positiva effekter för enskilda.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4",
      "sentiment": 0.8,
      "quote": "Det är angeläget att inte utestänga personer från möjligheten att uppleva de positiva effekter tekniken har fört med sig för enskilda, så som ökad trygghet, självständighet och delaktighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5",
      "sentiment": 0.5,
      "quote": "Tidaholms kommun tycker att det är en rimlig bedömning.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.6",
      "sentiment": -0.5,
      "quote": "I motsats till utredningen anser vi att det behövs särskild reglering vid användande av digital teknik, eftersom tillsyn har identifierat påtagliga brister vid hantering av digital teknik inom äldre- och funktionshinderomsorg, där bland annat rätten till individuell behovsbedömning, delaktighet, självbestämmande och samtycke har frångåtts.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.6.4",
      "sentiment": 0.8,
      "quote": "Vi instämmer i den bedömningen.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.6.6",
      "sentiment": 0.2,
      "quote": "Vi anser att det kan vara bra om kunskap om behov av och användning av digital teknik läggs till i de allmänna råden, för att förtydliga att också sådan kompetens kan vara en förutsättning för god kvalitet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.1",
      "sentiment": 0.8,
      "quote": "Vi instämmer i utredningens bedömning att regleringen behöver utvidgas till att gälla användning av sådan integritetskänslig teknik vid alla insatser enligt SoL och LSS.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a9.2.1",
      "sentiment": 0.5,
      "quote": "Vi instämmer generellt i den bedömningen utifrån att barnets bästa, rätt till information och att få komma till tals är väl reglerat i både SoL och LSS.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.1",
      "sentiment": 0.8,
      "quote": "Barn ska samtycka till behandlingen av personuppgifter om de har förmåga att förstå vad saken gäller.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.3",
      "sentiment": -0.5,
      "quote": "Till skillnad från utredningen anser vi att det behövs reglering kring användning av digital teknik för att säkerställa delaktighet, inflytande och självbestämmande för personer med nedsatt beslutsförmåga, inte bara för särskilt integritetskänslig teknik.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.5",
      "sentiment": -0.5,
      "quote": "För att klara av att göra en sådan svår bedömning menar vi att det inte är tillräckligt med de allmänt formulerade krav kring personals kompetens som finns i SoL och LSS.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.7",
      "sentiment": 0.8,
      "quote": "Vi instämmer i att en sådan bedömning är svår att reglera, eftersom enskildas funktionstillstånd, levnadsomständigheter och andra villkor ser olika ut och bedömningen ska vara situationsanpassad och bedömas individuellt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.8",
      "sentiment": -0.5,
      "quote": "användning av digital teknik för monitorering, sensorering eller positionering är så integritetskänsligt, behövs särskild reglering kring dokumentationen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.9",
      "sentiment": -0.5,
      "quote": "Utifrån att användande av tekniken är så integritetskänslig anser vi att det kan behövas förtydliganden kring uppföljningen.",
      "quote_type": "grund"
