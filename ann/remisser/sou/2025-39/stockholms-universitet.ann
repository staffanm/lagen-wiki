  "overall": {
    "sentiment": 0.2,
    "quote": "Institutionen för socialt arbete ställer sig i huvudsak positiv till utredningens ambition att skapa ett generellt lagstöd för digital teknik inom SoL och LSS, men vill framhålla att digitalisering i första hand inte ska användas som ett sätt att hantera brister i verksamheten.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a8.4",
      "sentiment": 0.5,
      "quote": "För särskilt intrångsgivande teknik, såsom monitorering, sensorering och positionering, krävs särskilda skyddsåtgärder, tydligare reglering och återkommande tredjepartsgranskning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": 0.5,
      "quote": "Det finns en risk att tekniken används för att tillgodose organisatoriska behov snarare än individens önskemål eller behov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7",
      "sentiment": -0.2,
      "quote": "Vår invändning är att utredningen inte tillräckligt problematiserar de stora integritetsintrång som digital teknik kan innebära.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.6",
      "sentiment": -0.5,
      "quote": "Vi ställer oss kritiska till utredningens slutsats att sådana bedömningar inte innebär myndighetsutövning och därför kan utföras av privata aktörer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.9",
      "sentiment": -0.5,
      "quote": "menar vi att det integritetsintrång som digital teknik innebär bör medföra högre krav på regelbundna omprövningar av samtycke, samt tydliga rutiner för hantering och dokumentation av återkallat samtycke.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.7",
      "sentiment": -0.5,
      "quote": "menar institutionen att det behövs tydliga riktlinjer för bedömning av beslutsförmåga och samtycke, liksom definierade kompetenskrav för de yrkesgrupper som ska utföra dessa bedömningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec121",
      "sentiment": -0.5,
      "quote": "Vi saknar därför en vetenskaplig översikt och problematisering av de konsekvenser digital teknik kan få för omsorgens kvalitet, samt för hjälptagare, personal och anhöriga.",
      "quote_type": "grund"
    }
  ]
