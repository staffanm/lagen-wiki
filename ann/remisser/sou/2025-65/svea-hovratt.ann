  "segments": [
    {
      "forarbete_id": "sec33",
      "sentiment": 0.2,
      "quote": "Hovrätten anser att detta bör framgå av själva lagtexten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec297",
      "sentiment": 0.2,
      "quote": "Mot bakgrund av frågornas nära samband bör det övervägas i den fortsatta beredningen om även beslut enligt 2 kap. 6 8 ska kunna överklagas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": 0.2,
      "quote": "För att den föreslagna regleringen ska vara konsekvent och med hänsyn till hur liknande bestämmelser är utformade rent språkligt bör det övervägas att ersätta begreppet ”1/20” med ”en tjugondel”",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.3.4",
      "sentiment": 1.0,
      "quote": "Hovrätten delar bedömningen bl.a. att lagen endast ska gälla när en fysisk person upplåter bostadslägenheter, att begränsningen av lagens tillämpningsområde till den första upplåtelsen tas bort och att det i första hand är parternas avtal som avgör vilket skick hyresgästen har rätt att kräva att lägenheten ska hålla (s. 110 ff.).",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a5.3.2",
      "sentiment": 0.2,
      "quote": "Hovrätten förutser att det eventuellt kan uppstå tillämpningsproblem avseende begreppet ”regelmässigt”.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.3.3",
      "sentiment": -0.2,
      "quote": "Hovrätten ser en risk i att det kan uppkomma svårigheter i att fastställa tidpunkten för när 12 kap. jordabalken börjar tillämpas på de tidigare hyresavtalen och anser att det är centralt att tillämpningen av den föreslagna ändringen är förutsebar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.5.2",
      "sentiment": -0.2,
      "quote": "ställer sig frågande till om den föreslagna ändringen kommer att lösa dessa tillämpningsproblem.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec151",
      "sentiment": -0.2,
      "quote": "Hovrätten bedömer att bestämmelsen kan vara svår att tillämpa i praktiken, bland annat eftersom den kräver en marknadsjämförelse med liknande objekt vid, såvitt hovrätten förstår, en viss given tidpunkt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec224",
      "sentiment": -0.5,
      "quote": "Hovrätten anser att regleringen kan bli svår att tillämpa med hänsyn till det flertalet olika aspekter som ska beaktas vid bedömningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.9.4",
      "sentiment": -0.5,
      "quote": "Hovrätten ser en risk för att förslaget kan leda till fler tvister om återbetalning av hyra.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5.2",
      "sentiment": 1.0,
      "quote": "Hovrätten anser att det är av vikt att begränsningen tar sikte på såväl nya omständigheter som bevis, med hänsyn till det som utredningen lyfter fram angående risken med att en part annars kan kringgå förbudet genom att åberopa ny bevisning (s. 227).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5",
      "sentiment": 0.2,
      "quote": "Hovrätten anser att det ur ett systematiskt perspektiv bör övervägas om bestämmelserna om prövningstillstånd i stället ska placeras i lagen om rättegången i vissa hyresmål i Svea hovrätt.",
      "quote_type": "grund"
