    },
    {
      "forarbete_id": "a8.7",
      "sentiment": 1.0,
      "quote": "Sveriges Allmännytta tillstyrker att hyresnämnden inte ska lämna tillstånd till blockhyra om särskilda skäl talar emot det.",
