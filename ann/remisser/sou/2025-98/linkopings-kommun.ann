  "overall": {
    "sentiment": -0.8,
    "quote": "Linköpings kommun ser att delar av utredningens förslag kan ge stor skada för samhällsbyggnadsprocessen.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "sec8",
      "sentiment": 0.8,
      "quote": "Detta är positivt då det idag är otydligt vilken roll Lantmäteriet ska ha som stödjande verksamhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.3",
      "sentiment": -0.7,
      "quote": "Om dessa ärenden istället ska hanteras av en statlig lantmäterimyndighet utan motsvarande lokalkännedom riskerar både kvalitet och effektivitet att försämras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a2-2",
      "sentiment": -0.9,
      "quote": "Att lägga fram ett förslag som innebär att många kommunlantmäterier kommer att behöva lägga ner när rapporter snarare påvisar att kommunlantmäterie fungerar mycket bra är svårt att förstå syftet med.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a2-3",
      "sentiment": -0.4,
      "quote": "Detta är en förändring som gör lagen otydligare än vad den är idag, då den senare ska tolkas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a2-4",
      "sentiment": 0.5,
      "quote": "Trots ovanstående så är det i grunden positivt med ett gemensamt ärendehanteringssystem, då det i grunden ger möjligheter till en mer likvärdig handläggning som Lantmäteriet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec13",
      "sentiment": -0.2,
      "quote": "Rimligtvis borde det vara omarronderingsförrättningar som kräver ett helt eget arbetssätt och organisation som är det som ska överlämnas, andra typer av jord- och skogsbruksförrättningar har kommunlantmäterier stor erfarenhet av i sina respektive kommuner.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.4",
      "sentiment": -0.5,
      "quote": "Varför detta ska ske är inte vidare motiverat i utredningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5.2",
      "sentiment": -0.9,
      "quote": "Att så kraftigt begränsa de kommunala lantmäterimyndigheterna så att de inte får medverka i annat än fastighetsbildning måste anses gå i strid mot själva meningen med att inrätta kommunala lantmäterimyndigheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.4.3",
      "sentiment": -0.6,
      "quote": "Förslaget ger inte förutsättningar för att alla ska behandlas lika, utan det riskerar att bli godtyckligt och utvecklas olika tolkningar för hur detta hanteras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec22",
      "sentiment": -0.4,
      "quote": "Eftersom behovet för kommunala lantmäterimyndigheter kvarstår att kunna samverka för att t.ex. ta sig an tillfälliga arbetstoppar och då olika aktörer har framställt önskemål om att flera kommuner ska kunna ha fastighetsbildningsverksamhet är det önskvärt att denna fråga tas upp igen.",
      "quote_type": "grund"
    }
  ]
