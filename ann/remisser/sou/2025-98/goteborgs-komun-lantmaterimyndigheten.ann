  "segments": [
    {
      "forarbete_id": "a9.3.3",
      "sentiment": -1.0,
      "quote": "Att särskilja hanteringen av statliga myndigheters och statliga bolags ärenden försvårar en sammanhållen samhällsbyggnadsprocess.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.4.3",
      "sentiment": -1.0,
      "quote": "En bättre lösning vore att helt ta bort paragrafen om att sakägare i vissa fall kan begära överlämning av ett ärende när kommunen är sakägare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3.2",
      "sentiment": -1.0,
      "quote": "Att begränsa KLM:s arbetsuppgifter i enlighet med punkt två till förrättningsverksamhet på det sätt som föreslås skulle kraftigt begränsa på vilket sätt som lantmäterikompetensen används i kommunala plan- och byggprocesser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3.3",
      "sentiment": 0.2,
      "quote": "de ekonomiska och juridiska konsekvenserna för KLM kan inte utläsas av nuvarande förslag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.4",
      "sentiment": -0.5,
      "quote": "Fastighetsbildningsfrågor i de avsedda ärendena har inte sällan samband med andra kommunala processer, t ex bygglov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5.2",
      "sentiment": -1.0,
      "quote": "Det är olämpligt att direkt i lagtexten begränsa vilka uppdrag som kan och får utföras av en KLM.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.3.1",
      "sentiment": 0.0,
      "quote": "KLM förespråkar att det skapas förutsättningar för tillsyn av samtliga lantmäterimyndigheter, det skulle ge bra förutsättningar för enhetlig rättstillämpning i lantmäteriförrättningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": 0.2,
      "quote": "Men det är inte tydligt vilka konsekvenserna blir för KLM till följd av Lantmäteriets ansvar enligt 5 a § första stycket förordningen (2009:946) med instruktion för Lantmäteriet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.6.1",
      "sentiment": -0.2,
      "quote": "Olika lantmäterimyndigheter har emellertid olika lokala förutsättningar, t ex avseende kostnader för lokaler och löner.",
