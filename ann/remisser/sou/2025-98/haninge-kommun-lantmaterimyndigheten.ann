  "segments": [
    {
      "forarbete_id": "a1.4",
      "sentiment": 0.5,
      "quote": "KLM Haninge ser positivt på att statens övergripande ansvar tydliggörs och att kommunala lantmäterimyndigheter garanteras tillgång till samma stöd och system som Lantmäteriet.",
