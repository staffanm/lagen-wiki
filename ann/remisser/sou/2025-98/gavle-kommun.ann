  "overall": {
    "sentiment": -0.8,
    "quote": "Gävle kommun bedömer att alla kommunala lantmäterimyndigheter på sikt kommer att behöva avvecklas i de fall utredarens förslag genomförs i sin helhet.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a7.3.1",
      "sentiment": 0.5,
      "quote": "Att statliga lantmäteriet ansvarar för att tillhandahålla utbildningar, handböcker, handledning, rutiner, riktlinjer och motsvarande övergripande stöd samt ett gemensamt ärendehanteringssystem och andra tekniska handläggningsstöd till all förrättningsverksamhet.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.3.4",
      "sentiment": 1.0,
      "quote": "• Att statliga lantmäteriets ansvar att följa upp och redovisa resultatet av alla lantmäterimyndigheters verksamhet förtydligas.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a11.3",
      "sentiment": -1.0,
      "quote": "Kommunen anser att det inte finns någon anledning att ställa högre krav på kommunala lantmäterimyndighets verksamhet vad gäller omfattning och oberoende.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a2",
      "sentiment": -1.0,
      "quote": "Den kommunala lantmäterimyndigheten syfte är att vara en aktiv roll i kommunens samhällsbyggnadsprocess och där service och fastighetsrättslig rådgivning till såväl kommunen som sakägare, kommuninvånare och företagare är en viktig del av verksamheten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5.2",
      "sentiment": -1.0,
      "quote": "Detta motverkar syftet med att ha en kommunal lantmäterimyndighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.2",
      "sentiment": -1.0,
      "quote": "Det är olämpligt att förrättningar handläggs av olika myndigheter beroende på vem sökande är.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.4.3",
      "sentiment": -1.0,
      "quote": "Kommunen tror inte att de nya förslagen leder till någon förbättring eller minskade handläggningstider och anser att möjligheten till överlämnande är obefogad och att den i första hand ska tas bort helt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.4",
      "sentiment": -1.0,
      "quote": "Vid ett eventuellt överlämnande sprids informationen mellan fler myndigheter och risken att obehörig får del av informationen ökar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.3.1",
      "sentiment": -1.0,
      "quote": "Kommunen anser att statliga lantmäteriet har uppenbara rollkonflikter som påverkar dess myndighetsutövning gentemot de kommunala lantmäterimyndigheterna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.2.2",
      "sentiment": -0.5,
      "quote": "Genom att statliga lantmäteriet får statliga medel för sin verksamhet blir det oproportionerligt att de kommunala lantmäterimyndigheterna ska uppfylla principen om full kostnadstäckning och inte ta emot kommunbidrag samtidigt som det föreslås att den kommunala lantmäterimyndigheten ska vara ekonomiskt oberoende.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.4.1",
      "sentiment": 1.0,
      "quote": "Kommunen är positiv till förslaget att en skälighetsbedömning ska göras innan slutlig debitering.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a16.4.3",
      "sentiment": -0.5,
      "quote": "Kommunen anser att förslaget gällande fast belopp på mindre tidskrävande förrättningar är otydlig och svår att tolka, men har svårt att förstå hur det skulle göra förrättningshandläggningen mer kostnadseffektiv och öka transparensen gällande kostnader.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.5.1",
      "sentiment": 1.0,
      "quote": "Kommunen är positiv till förslaget.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a16.6.1",
      "sentiment": -0.5,
      "quote": "Det går inte att uppfylla principen med full kostnadstäckning för alla lantmäterimyndigheter när de har så olika förutsättningar när det gäller kostnader, men samma taxa.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12",
      "sentiment": -0.5,
      "quote": "Det är även en stor brist att utredningen inte ger några förslag på samverkansmöjligheter inom fastighetsbildningsverksamheten, då även detta skulle ge en förbättring för hela samhällsbyggnadsprocessen.",
      "quote_type": "grund"
    }
