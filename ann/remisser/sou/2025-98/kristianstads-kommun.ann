    },
    {
      "forarbete_id": "a14.3",
      "sentiment": -0.8,
      "quote": "Kristianstads kommun anser att utredningen inte har lyckats motivera varför tillsynsansvaret ska ligga kvar hos statliga lantmäteriet som står i en uppenbar rollkonflikt mot de KLM som de utövar tillsynen mot.",
      "quote_type": "grund"
