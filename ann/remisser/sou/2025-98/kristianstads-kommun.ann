  "segments": [
    {
      "forarbete_id": "a7.3",
      "sentiment": 0.8,
      "quote": "Kristianstads kommun tillstyrker behovet av ett nationellt likvärdigt stöd, särskilt kring utbildningar, handläggningssystem och vägledningar.",
