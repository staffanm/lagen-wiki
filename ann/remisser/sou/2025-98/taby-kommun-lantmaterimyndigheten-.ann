  "segments": [
    {
      "forarbete_id": "a7.3.1",
      "sentiment": 0.5,
      "quote": "KLM Täby är positiva till att samtliga lantmäterimyndigheter ska använda samma handläggningsstöd samt att statens ansvar att tillhandahålla stödet tydliggörs, då detta bedöms kunna bidra till ökad rättssäkerhet och enhetlighet för fastighetsbildningen nationellt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": 0.2,
      "quote": "Dock bör kostnaderna för utbildningar, i enlighet med tidigare, fördelas efter utbildningsbehovet hos respektive KLM då behovet av utbildning varierar över tid beroende på medarbetarnas kunskaper och erfarenheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.2",
      "sentiment": -0.5,
      "quote": "Att det skulle vara mer rationellt att Lantmäteriet ska handlägga ärenden enbart för att staten eller ett statligt bolag är fastighetsägare är svårförståeligt då detta resulterar i ett ineffektivt nyttjande av resurser samt att KLM:s betydande kunskap om lokala förhållanden inte nyttjas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.4",
      "sentiment": -0.5,
      "quote": "Förslaget om överlämning av ärenden som antas omfattas av säkerhetsskyddslagen riskerar vidare att medföra en onödig spridning av säkerhetskänslig information när KLM ska lämna över ärenden till Lantmäteriet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3",
      "sentiment": -0.5,
      "quote": "Förslaget om överlämning leder sammantaget till en minskad mängd förrättningar hos KLM vilket försvårar upprätthållande av kompetens och förutsättningar för ekonomisk stabilitet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5.2",
      "sentiment": -0.5,
      "quote": "En detaljreglering riskerar alltså att begränsa KLM:s roll i samhällsbyggnadsprocessen och motverkar ett av de centrala syftena med KLM:s verksamhet – att stödja kommunens plan- och bygglovsverksamhet och möjliggöra en effektiv samordning inom kommunen mellan planläggning, byggande och fastighetsbildning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3.3",
      "sentiment": -0.5,
      "quote": "KLM Täby anser därför att det framstår som oproportionerligt att införa mer långtgående krav utan påvisade brister.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec296",
      "sentiment": -0.5,
      "quote": "KLM är idag organisatoriskt skilt från den förvaltning och nämnd som företräder kommunen som fastighetsägare och rättighetshavare, vilket har bedömts varit tillräckligt för att säkerställa myndighetens opartiskhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec296",
      "sentiment": -0.5,
      "quote": "Om KLM ska vara ekonomiskt oberoende av kommunen behöver finansieringen av de moment som ska utföras enligt lag utredas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec22",
      "sentiment": -0.5,
      "quote": "KLM Täby anser att det är en väsentlig brist att utredningen inte ger några förslag om samverkansmöjligheter.",
      "quote_type": "grund"
