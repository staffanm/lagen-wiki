  "segments": [
    {
      "forarbete_id": "a7.2",
      "sentiment": 0.5,
      "quote": "Lantmäterimyndigheten i Landskrona är i stort sett positiv till att statens övergripande ansvar för fastighetsbildningsverksamheten förtydligas då det är en förutsättning för en effektiv, enhetlig och rättssäker fastighetsbildningen i landet, vare sig den bedrivs som statlig eller kommunal myndighetsutövning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2.4",
      "sentiment": 0.2,
      "quote": "Men det är en stor brist i utredningen att kostnadsfrågan för detta inte är utredd, något som måste ske innan det är rimligt att kräva att KLM använder Lantmäteriets system.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.2",
      "sentiment": -1.0,
      "quote": "KLM är väl insatta i de lokala förhållandena och de projekt som bedrivs inom kommunen på ett sätt som den statliga lantmäterimyndigheten rimligtvis inte kan vara, vilket gör det ineffektivt om KLM skulle vara förhindrad att handlägga förrättningar av detta slag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5.2",
      "sentiment": -1.0,
      "quote": "Det skulle kraftigt begränsa KLMs möjlighet att medverka i stadens samhällsbyggnadsprocess med råd och stöd i detaljplanearbetet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3.3",
      "sentiment": -1.0,
      "quote": "Att tvinga KLM till ett sådant oberoende som utredningen förslår är inte ekonomiskt försvarbart, den ökade kostnaden kan rimligen inte belasta sakägarna i förrättningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3.6",
