  "overall": {
    "sentiment": -0.7,
    "quote": "Kommunen anser, att om dessa förslag genomförs, kommer förutsättningarna att upprätthålla en kommunal lantmäterimyndighet att försämras till den grad att verksamheten i praktiken omöjliggörs.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a7.3.1",
      "sentiment": 1.0,
      "quote": "Lantmäteriet har en mycket viktig roll som central förvaltningsmyndighet, och de beskrivna uppgifterna är viktiga för en effektiv, enhetlig och rättssäker fastighetsbildning i hela landet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a2-4",
      "sentiment": 0.2,
      "quote": "Däremot kan det samhällsekonomiskt vara mycket fördelaktigt att en offentlig verksamhet av samma art använder det stöd som utvecklats för verksamheten med offentliga medel.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.3.4",
      "sentiment": 0.5,
      "quote": "Uppföljningen av den samlade verksamheten är viktig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": -0.2,
      "quote": "Detta bör därför inte kopplas till förrättningsintäkterna på det sätt utredaren föreslår.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.2",
      "sentiment": -0.5,
      "quote": "När KLM är väl insatt i de lokala förhållandena, och i förekommande fall planprojekt och bygglovsbeslut inför exempelvis förrättningsåtgärder för en ny kriminalvårdsanstalt eller annan statlig byggnad, skulle det tvärtom bli mindre effektivt om KLM skulle vara förhindrad att handlägga sådana ärenden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.4",
      "sentiment": -0.5,
      "quote": "Formuleringen ”det kan antas att” ger också en alltför stor tolkningsmöjlighet och osäkerhet om vilken myndighet som ska handlägga ärendet, och bör strykas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.4",
      "sentiment": -0.2,
      "quote": "Kommunen ifrågasätter om något egentligt behov längre finns av möjligheten för sakägare att begära överlämnande till SLM.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.4.3",
      "sentiment": -0.5,
      "quote": "Kommunen anser att denna bestämmelse knappast kan komma att få någon funktion, då den kommer att bli svår att i praktiken tillämpa.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5.2",
      "sentiment": -0.5,
      "quote": "Kommunen anser inte att den kommunala lantmäterimyndighetens uppdragsverksamhet ska detaljregleras i lag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5.3",
      "sentiment": -0.5,
      "quote": "Kommunen anser att det är en kommunal angelägenhet vilka avgifter som ska tas ut utöver förrättningsverksamheten, och ifall dessa ska interndebiteras eller lösas på annat sätt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3",
      "sentiment": -1.0,
      "quote": "Kraven att inrätta och upprätthålla KLM skärps på ett orimligt sätt, som medför att möjligheterna att upprätthålla denna verksamhet i stort sett elimineras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3.6",
      "sentiment": -0.5,
      "quote": "Förslaget skulle leda till omotiverade nedläggningar av välfungerande KLM.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.3.1",
      "sentiment": -0.2,
      "quote": "Lantmäteriet föreslås fortsatt ha både tillsynsansvar och ensam avge yttranden över kommunernas ansökningar. Detta innebär en fortsatt risk för betydande rollkonflikter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.4.3",
      "sentiment": -0.2,
      "quote": "Det bör ytterligare övervägas om även någon typ av varning ska föregå en anmälan.",
