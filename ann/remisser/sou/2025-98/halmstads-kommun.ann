  "segments": [
    {
      "forarbete_id": "a1.4",
      "sentiment": 0.5,
      "quote": "Halmstads kommun är positiv till förslaget om att förtydliga Lantmäteriets övergripande ansvar, i en ny 5a § till förordningen med instruktion för Lantmäteriet.",
