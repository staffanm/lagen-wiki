  "segments": [
    {
      "forarbete_id": "a7.3",
      "sentiment": 0.5,
      "quote": "När det gäller kostnadsfördelning är det viktigt att det finns en korrelation mellan de ersättningar som kommunala lantmäterimyndigheter får betala till Lantmäteriet och myndighetens faktiska kostnader för stödet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3",
      "sentiment": -0.5,
      "quote": "Förslaget ger ytterst begränsad vinning i jämförelse med de konsekvenser det kan innebära för de kommunala lantmäterimyndigheterna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.4",
      "sentiment": 0.5,
      "quote": "Samtidigt är det fortsatt viktigt att möjligheten att begära överlämning tidsmässigt begränsas för att undvika onödigt dubbelarbete och extra kostnader.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5.2",
      "sentiment": -1.0,
      "quote": "Jönköpings kommun avstyrker förslaget om en begränsning av en kommunal lantmäterimyndighets möjlighet att utföra uppdragsverksamhet då bestämmelsen kraftigt begränsar myndighetens medverkan i samhällsbyggnadsprocessen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3.3",
      "sentiment": -1.0,
      "quote": "Förslaget är negativt för närheten till den kommunala samhällsbyggnadsprocessen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12",
      "sentiment": -0.5,
      "quote": "Jönköpings kommun anser att det är en brist att utredningen inte ger några förslag om samverkansmöjligheter mellan befintliga kommunala lantmäterimyndigheter eller mellan en kommun med en kommunal lantmäterimyndighet och en kommun som saknar en kommunal lantmäterimyndighet, då sådan samverkan skulle gynna både fastighetsbildningen och samhällsbyggnadsprocessen i övrigt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14",
      "sentiment": -0.2,
      "quote": "Jönköpings kommun anser inte att utredningens förslag gällande tillsyn är tillräckligt tydliga och förutsägbara, varken för den myndighet som granskar eller den som blir granskad.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16",
      "sentiment": 0.0,
      "quote": "För att alla myndigheter ska ha möjlighet att nå full kostnadstäckning krävs dock att taxan sätts och revideras med hänsyn till lokala förutsättningar.",
      "quote_type": "grund"
