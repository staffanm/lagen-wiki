  "segments": [
    {
      "forarbete_id": "sec8",
      "sentiment": -1.0,
      "quote": "Karlskoga kommun bedömer att en mer centraliserad modell riskerar att försämra helheten i samhällsbyggnadsprocessen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5",
      "sentiment": -1.0,
      "quote": "Karlskoga kommun bedömer att det är en stor nackdel om kommunal lantmäterikompetens inte kan bidra brett i samhällsbyggnadsprocessen, exempelvis genom: \n\n• tidiga fastighetsrättsliga analyser i planarbete • stöd i frågor om servitut, gemensamhetsanläggningar och ledningsrätter • fastighetsutredningar och fastighetsförteckningar • stöd kopplat till Geodata och digitala krav",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3.3",
      "sentiment": -1.0,
      "quote": "Utredningens förslag om egna lokaler, egen administration och tydlig fysisk avskiljning riskerar att: \n\n• försvåra vardaglig samverkan • ge högre kostnader • minska kunskapsutbyte • göra kommunen mindre flexibel i resursanvändning",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14",
      "sentiment": 0.5,
      "quote": "Men tillsyn och uppföljning bör vara riskbaserad och likvärdig och inte skapa onödig administration.",
