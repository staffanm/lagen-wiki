      "artifact:forarbete/sou/2025-98": "7c02dbd0c5a8375414c74c14e5dac5e3e59236005fee59904bccdffc372e935e"
    }
  },
  "overall": {
    "sentiment": -0.6,
    "quote": "KLM Umeå bedömer dock att konsekvenserna av utredningens förslag som presenterats, i sin helhet inte skulle medföra positiva konsekvenser för lantmäterimyndigheterna eller fastighetsbildningssverige i stort.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a11.3.2",
      "sentiment": -0.5,
      "quote": "Om förslagen genomförs begränsas lantmäterimyndigheternas möjligheter till att verka vid sidan av förrättningshandläggningen och kommunerna kommer inte att kunna dra nytta av att ha en kommunal lantmäterimyndighet på samma sätt som idag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.2.4",
      "sentiment": -0.5,
      "quote": "Förslaget i kombination med potentiellt ändrad regeringspraxis om antalet anställda och de krav som föreslås om att löpande kunna uppvisa att lagen efterlevs vid tillsyn skapar ett visst mått av godtycklighet och oförutsebarhet kring vilka krav som kan komma att ställas på lantmäterimyndigheten över tid.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.2",
      "sentiment": -0.5,
      "quote": "För lantmäterimyndigheter innebär det en lägre ärendeinströmning, att kompetens gällande vissa sorts förrättningar går förlorad och att kommunala lantmäterimyndigheter riskerar att bli mindre attraktiva arbetsgivare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.4",
      "sentiment": -0.5,
      "quote": "KLM Umeå likväl som kommunens olika stöttande funktioner har erfarenhet av säkerhetsskyddslagen, sekretessfrågor och informationssäkerhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.4.3",
      "sentiment": -0.2,
      "quote": "KLM Umeås inställning är därför att utredningen i större mån skulle ha beaktat hur möjligheten till överlämning av ärenden ska begränsas genom ny lagstiftning, eller att det införs en bestämmelse om hur sent in i förrättningen ett ärende faktiskt kan lämnas över till det statliga Lantmäteriet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec22",
      "sentiment": -0.5,
      "quote": "Genom att möjliggöra samverkan mellan kommunala lantmäterimyndigheter skulle ett effektivt nyttjande av befintliga resurser kunna fördelas vid uppkomna behov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.3.1",
      "sentiment": 0.5,
      "quote": "Detta skulle säkerställa och bidra till en enhetlighet inom fastighetsbildningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.4",
      "sentiment": 0.8,
      "quote": "Förslaget om att införa 5 a § i förordningen med instruktion för Lantmäteriet och ändring av 2 § 5 p. i förslag till lag om ändring i lagen (1995:1393) om kommunal lantmäterimyndighet är därför positivt och innebär bättre förutsättningar för mer enhetlighet, effektivitet och i förlängningen rättssäkerhet inom myndigheternas verksamhetsområde.",
      "quote_type": "grund"
    }
  ]
}