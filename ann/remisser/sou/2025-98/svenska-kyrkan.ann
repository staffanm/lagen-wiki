  "segments": [
    {
      "forarbete_id": "a14.3",
      "sentiment": 0.2,
      "quote": "Det behöver dock säkerställas att den statliga lantmäterimyndighetens utökade ansvar för tillsyn samt tillhandahållande av kunskapsmaterial och system inte leder till en betungande byråkrati.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3",
      "sentiment": 0.2,
      "quote": "Därför ser Svenska kyrkan positivt på förtydligande kring villkoren för de kommunala lantmäterimyndigheterna, men vill påtala att vad gäller fastighetsbildning på begravningsmark krävs specialistkunskap som kan vara svår att upprätthålla av kommunala lantmäterimyndigheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec13",
      "sentiment": 0.5,
      "quote": "Det gäller bland annat förrättningar som avser flera lantmäterimyndigheters verksamhetsområden, stora jord- och skogsbruksförrättningar som inte omfattar ny bebyggelse och andra förrättningar som av kompetens- och resursskäl inte bör handläggas hos myndigheten, till exempel större anläggningsförrättningar och äganderättsutredningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.4",
      "sentiment": 0.0,
      "quote": "I ett sådant scenario kan förrättningar och andra ärenden behöva överlämnas eller samordnas av den statliga lantmäterimyndigheten för att lösa ett ökat och/eller akut behov av begravningsmark.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16",
      "sentiment": 1.0,
      "quote": "Svenska kyrkan välkomnar de föreslagna ändringarna i avgiftsförordningen, som bör leda till ett mer kostnadseffektivt arbete och ökad förutsägbarhet.",
