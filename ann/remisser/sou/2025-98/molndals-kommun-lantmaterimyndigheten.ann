    },
    {
      "forarbete_id": "a9.5.2",
      "sentiment": -0.5,
      "quote": "Det är dock otillfredsställande att införa en uttömmande reglering i lagtext, eftersom behovet av uppdragsverksamhet kan förändras över tid.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.2",
      "sentiment": -0.5,
      "quote": "ansvaret för fastighetsbildningen i ett område skulle delas mellan två myndigheter på ett sätt som riskerar att skapa otydlighet.",
