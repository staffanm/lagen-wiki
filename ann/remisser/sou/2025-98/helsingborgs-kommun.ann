  "segments": [
    {
      "forarbete_id": "sec22",
      "sentiment": -0.5,
      "quote": "Staden ser positivt på att en rättslig reglering för samverkan mellan kommunala lantmäterimyndigheter behövs, även om detta inte föreslås i föreliggande reglering.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3",
      "sentiment": -0.5,
      "quote": "Vi menar att skälen för dessa förändringar är vaga och att skäl för varför dessa förändringar föreslås saknas i utredningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16",
      "sentiment": -0.5,
      "quote": "Vi menar att förslaget begränsar kvalitetshöjande arbete, utveckling och digitalisering, samt hämmar såväl innovation som effektivisering inom samhällsbyggnadsområdet, och att det långsiktigt undergräver en hållbar utveckling liksom finansiering av verksamheten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3.3",
      "sentiment": -0.5,
      "quote": "Vi menar att detta skulle leda till en situation där det är mycket svårt att bedriva en effektiv verksamhet och att uppnå kostnadstäckning, och att en allt för stor del av verksamhetens intäkter då behöver användas till annat än kärnuppdraget, och möjlighet till medverkan och utveckling av samhällsbyggnadsprocessen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.2",
      "sentiment": -0.2,
      "quote": "Bilden idag är att tillämpad praxis är hårdare än lagstiftningens mening.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.3",
      "sentiment": -0.2,
      "quote": "Är det rimligt att Statliga lantmäterimyndigheten bedriver tillsynen eller ska det vara annan part som gör detta?",
