  "overall": {
    "sentiment": -0.8,
    "quote": "KLM Örnsköldsvik avvisar i huvudsak utredningens förslag och efterfrågar i stället en ny utredning som fokuserar på att stärka och utveckla fastighetsbildningsverksamheten genom hela samhällsbyggnadsprocessen.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "sec8",
      "sentiment": 0.5,
      "quote": "Ett klargörande av ansvarsfördelningen är viktigt för en effektiv samhällsbyggnadsprocess och för att säkerställa en enhetlig rättstillämpning i hela landet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": -0.5,
      "quote": "Utredningen saknar en analys av vilka kostnader som kommer att uppstå när kommunala lantmäterimyndigheter ska använda Lantmäteriets stödfunktioner.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5",
      "sentiment": -0.7,
      "quote": "Detta skulle leda till att stöd och rådgivning i fastighetsrättsliga frågor kopplat till detaljplaner samt möjligheten att ta fram fastighetförteckningar i samband med detaljplanearbete riskerar att utebli.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3",
      "sentiment": -0.7,
      "quote": "Då kommunala lantmäterimyndigheter generellt är små organisationer skapar detta ojämlika förutsättningar jämfört med Lantmäteriet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.4",
      "sentiment": -0.8,
      "quote": "En förändring som innebär att förrättningar där staten är sökande ska överlämnas till Lantmäteriet skulle försämra flödet i samhällsbyggnadsprocessen avsevärt, särskilt i större projekt där helhetssyn och samordning är avgörande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14",
      "sentiment": -0.8,
      "quote": "Rollen är tvivelaktig eftersom Lantmäteriet samtidigt bedriver samma typ av verksamhet.",
