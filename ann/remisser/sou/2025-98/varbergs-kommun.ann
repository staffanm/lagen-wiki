  "overall": {
    "sentiment": -1.0,
    "quote": "Sammantaget leder utredningens förslag till kraftiga begränsningar av KLM:s verksamhet, nyttan med en KLM i den samlade samhällsbyggnadsprocessen försvinner, och förutsättningarna att bedriva en kommunal lantmäterimyndighet försämras så pass mycket att den kommer behöva upphöra och med den nyttorna som skapas.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a7.3",
      "sentiment": 0.2,
      "quote": "Det bör inte heller ställas krav på vad av stödet KLM är tvingade att använda såsom nu föreslås vad gäller tekniskt handläggningsstöd då det riskerar hämma digitalisering, innovation och effektivitet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3",
      "sentiment": -1.0,
      "quote": "Det förslaget kan inte tolkas på annat sätt än att KLM helt ska separeras och isoleras från hela övriga kommunen och inte längre enbart gentemot kommunens mark- och exploateringsverksamhet eller verksamhet av liknande karaktär.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3",
      "sentiment": -0.5,
      "quote": "Uteblivet stöd och råd i fastighetsrättsliga frågor i detaljplaner ger sämre kvalitet och försämrade förutsättningar för genomförbarheten vilket i sin tur drabbar medborgare och näringsliv.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.4",
      "sentiment": -0.5,
      "quote": "Att KLM inte skulle kunna hantera dessa ärenden riskerar att leda till försämrade flöden, sämre effektivitet, en sämre helhetssyn samt ge aktörerna i kommunen en sämre service.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.3",
      "sentiment": -0.5,
      "quote": "Utredningens förslag innebär att intressekonflikten består, eftersom det fortsatt är samma organisation, Lantmäteriet, som både utövar tillsyn över KLM och samtidigt tar över myndighetsverksamheten om ett tillstånd återkallas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12",
      "sentiment": -0.2,
      "quote": "Det är en brist att utredaren inte föreslår några möjligheter till samverkan mellan lantmäterimyndigheter.",
