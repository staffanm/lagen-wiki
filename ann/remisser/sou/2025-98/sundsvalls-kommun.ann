  },
  "overall": {
    "sentiment": -0.6,
    "quote": "De förslag som utredningen presenterar strider till stora delar mot utredningens uttalade syfte och riskerar att leda till motsatt effekt, med negativa konsekvenser för samhällsbyggnadsprocessen.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a9.3.3",
      "sentiment": -1.0,
      "quote": "För den kommunala lantmäterimyndigheten i Sundsvall skulle förslaget medföra ett bortfall av cirka 20 procent av myndighetens ärenden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.2",
      "sentiment": -0.5,
      "quote": "I många jordbruksförrättningar är syn på plats en förutsättning för att kunna bedöma lämpligheten av en jord- eller skogsbruksfastighet eller hur skyddsvärd en sådan fastighet är.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.4",
      "sentiment": -0.5,
      "quote": "Förslaget skulle i praktiken omfatta väldigt många ärenden som ska överföras till statliga Lantmäteriet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5.2",
      "sentiment": -0.5,
      "quote": "Dels föreslås att uppdragsverksamheten ”inte får medföra negativ inverkan på handläggningstiderna i förrättningsverksamheten”. Dels är listan över tillåtna uppdrag i 5 a § 2 st. snävare än de uppdrag som de kommunala lantmäterimyndigheterna i praktiken åtar sig i dag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a2-5",
      "sentiment": -0.5,
      "quote": "Om den kommunala lantmäterimyndigheten inte längre får ge råd och stöd i planprocessen , kan det medföra att framtagandet av nya detaljplaner blir svårare, eller än värre att detaljplaner inte går att genomföra när planerna väl är antagna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a2-2",
      "sentiment": -0.2,
      "quote": "Om nu refererade exempel ur praxis ska vara vägledande, befarar Sundsvalls kommun att flera kommunala lantmäterimyndigheter inte längre kommer bedömas vara av tillräcklig omfattning för att kunna bibehålla sina tillstånd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec296",
      "sentiment": -0.2,
      "quote": "Organisatorisk samlokalisering möjliggör parallella processer mellan planläggning, bygglovsprövningen och lantmäteriförrättningar, vilket bidrar till ökad effektivitet, kortare handläggningstider och ett mer sammanhållet genomförande av samhällsbyggnadsprocessen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec24",
      "sentiment": -0.5,
      "quote": "Sundsvalls kommun ser en fortsatt risk för rollkonflikter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.3.5",
      "sentiment": 0.8,
      "quote": "Det är viktigt att de kommunala lantmäterimyndigheterna erhåller stöd från statlig nivå för att upprätthålla likvärdighet och rättssäkerhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec31",
      "sentiment": 1.0,
      "quote": "Den kommunala lantmäterimyndigheten i Sundsvall erbjuder redan i dag sakägare möjlighet till fast pris efter ansökan till myndigheten.",
      "quote_type": "grund"
    }
  ]
}