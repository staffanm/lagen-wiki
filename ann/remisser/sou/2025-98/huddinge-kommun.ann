  "overall": {
    "sentiment": -0.7,
    "quote": "Huddinge kommun bedömer att utredningens förslag, i sin nuvarande form, inte uppfyller kommittédirektivets syfte om en effektiv, enhetlig och rättssäker fastighetsbildning i hela landet.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a7.3.1",
      "sentiment": 1.0,
      "quote": "Det är positivt att ansvaret tydliggörs, men innebär ingen förändring i sak.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.2",
      "sentiment": -0.5,
      "quote": "En kommunal lantmäterimyndighet är till sin natur en mindre organisation och har därför större behov av att kunna styra och planera sina utgifter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11",
      "sentiment": 0.5,
      "quote": "Detta kan underlätta samverkan, skapa enhetlighet i ärendehanteringen och förenkla överlämningar mellan myndigheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5.2",
      "sentiment": -0.5,
      "quote": "Att de olika myndigheterna, som är självständiga i alla andra bemärkelser, skulle ses som en enhet i just upphandlingshänseende är tveksamt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.4",
      "sentiment": -1.0,
      "quote": "Ett obligatoriskt överlämnande skulle varken innebära en säkrare handläggning eller någon effektivitetsvinst.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.2",
      "sentiment": -0.5,
      "quote": "Förslaget är bristfälligt underbyggt och saknar både inspel från exempelvis statliga fastighetsbolag, som i tidigare rapporter har haft en positiv inställning till att de kommunala lantmäterimyndigheterna handlägger deras ärenden, och en mer grundlig konsekvensbeskrivning för de kommunala lantmäterimyndigheterna, enskilda sakägare och Lantmäteriet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.4.3",
      "sentiment": 1.0,
      "quote": "Huddinge kommun instämmer med utredningens förslag om en ny bestämmelse i 4 kap. 7 a § fastighetsbildningslagen (1970:988), som reglerar möjligheten för den kommunala lantmäterimyndigheten att ta betalt av en specifik sakägare som genom att begära en överlämning i syfte att fördröja beslut orsakat extra förrättningskostnader.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a9.5.2",
      "sentiment": -1.0,
      "quote": "Förslaget är otydligt, saknar grund och riskerar att försämra effektiviteten och rättssäkerheten i samhällsbyggnadsprocessen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3.3",
      "sentiment": -1.0,
      "quote": "Att vara helt ekonomiskt oberoende, hyra egna lokaler och ha egna HR- och IT-funktioner är inte möjligt för de flesta kommunala lantmäterimyndigheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a2",
      "sentiment": -0.5,
      "quote": "Regeringen har enligt praxis ansett att sju årsarbetskrafter inte är tillräckligt, trots att propositionen anger minst fem årsarbetskrafter och att det inte ska finnas någon absolut bindning till antalet personer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3.6",
      "sentiment": -1.0,
      "quote": "En enkel beräkning visar att cirka 15–20 av dagens 40 kommunala lantmäterimyndigheter inte skulle uppfylla kravet på omfattning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12",
      "sentiment": -0.2,
      "quote": "Om de nya villkoren för omfattning införs kommer många kommunala lantmäterimyndigheter med mindre verksamhet att behöva samverka för att kunna finnas kvar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.4.2",
      "sentiment": -1.0,
      "quote": "Förslaget innebär en betydande skärpning som saknar tillräcklig motivering och riskerar att skapa osäkerhet och omfattande negativa konsekvenser för kommunala lantmäterimyndigheter och samhällsbyggnadsprocessen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.6.1",
      "sentiment": -1.0,
      "quote": "Förslaget att kommunala lantmäterimyndigheter ska tillämpa Lantmäteriets taxa innebär ett intrång i myndighetens självständighet och försvårar budgetstyrning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.4.3",
      "sentiment": -0.5,
      "quote": "Det är därför oklart vilket syfte bestämmelsen har och på vilket sätt bestämmelsen bidrar till transparens och förutsägbarhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.5.1",
      "sentiment": 0.2,
      "quote": "Det är rimligt att informera om möjligheten till fast pris, men förslaget har ingen större nytta.",
      "quote_type": "grund"
    }
  ]
}