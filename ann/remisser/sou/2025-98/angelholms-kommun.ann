  "segments": [
    {
      "forarbete_id": "sec22",
      "sentiment": -0.5,
      "quote": "För Ängelholms kommun vore ett samarbete med en eller flera grannkommuner för att bilda en gemensam kommunal lantmäterimyndighet ett ändamålsenligt och resurseffektivt alternativ.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.3.5",
      "sentiment": 0.2,
      "quote": "En strukturerad och långsiktig samverkan mellan stat och kommun är nödvändig för att säkerställa en effektiv fastighetsbildningsprocess och ett hållbart samhällsbyggande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11",
      "sentiment": 0.2,
      "quote": "SKR anser dock inte att delarna om ärendehandläggningssystem, är tillräckligt genomarbetade för att ligga till grund för lagstiftning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.2",
      "sentiment": -0.5,
      "quote": "Förslaget riskerar därför att skapa en uppluckring av en annars sammanhållen process, dessutom med inblandning av fler organisationer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5.2",
      "sentiment": -1.0,
      "quote": "Genom sin konstruktion skulle bestämmelsen kraftigt begränsa myndighetens medverkan i samhällsbyggnadsprocessen.",
      "quote_type": "grund"
    },
    {
