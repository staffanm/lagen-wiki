    },
    {
      "forarbete_id": "a11.3.2",
      "sentiment": 0.5,
      "quote": "Örebro kommun tillstyrker förslaget men vill att gränsdragningen mellan myndighetssamverkan och myndighetsservice å ena sidan och uppdragsverksamheten å andra sidan tydliggörs.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a2-2",
      "sentiment": -1.0,
      "quote": "Att därutöver reglera “lokalers och medarbetares oberoende” i lag riskerar att bli en överreglering och skapa gränsdragningsproblem vid tillämpning och tillsyn.",
