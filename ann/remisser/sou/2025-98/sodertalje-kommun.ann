  "overall": {
    "sentiment": -1.0,
    "quote": "Utredningen har inte i tillräcklig utsträckning analyserat de kommunala lantmäterimyndigheternas ansvarsområde och förutsättningar att bedriva verksamhet resurseffektivt och rättssäkert, med hänsyn till en effektivare samhällsbyggnadsprocess, i enlighet med direktivet.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a7.3",
      "sentiment": 0.5,
      "quote": "Förslagen bidrar till syftet med utredningen samtidigt som den kommunala lantmäterimyndighetens fördelar, som god lokalkännedom och närhet till samhällsbyggnadsprocessen, kan bibehållas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": -0.5,
      "quote": "Det framgår inte av utredningen hur Lantmäteriets gemensamma ärendehanteringssystem ska finansieras samtidigt som det föreslås att det ska vara ett krav för KLM att använda systemet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3",
      "sentiment": -0.5,
      "quote": "Förslaget om ändringar i 4 kap. 7 § FBL kommer få konsekvenser för KLMs möjlighet att leva upp till förslagen om de skärpta kraven att bedriva KLM.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.4",
      "sentiment": -0.5,
      "quote": "Lagförslagsändringen av 5 § p.4 lagen (1995:1393) om kommunal lantmäterimyndighet är otydlig vilket ökar risken för att det kommer göras olika bedömningar avseende när ärenden ska överlämnas till Lantmäteriet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5",
      "sentiment": -0.5,
      "quote": "Om KLM inte kan prioritera uppdragsverksamheten före fastighetsbildningsverksamheten finns risken att genomförandet, dvs fastighetsbildning, blir mer komplicerat och svårhanterat i fastighetsbildningsfasen senare, vilket medför att samhällsbyggnadsprocessen blir längre och mer kostsam.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3",
      "sentiment": -0.5,
      "quote": "Om KLM ska finansiera eget HR-stöd, kontaktcenter, lokaler etc, kommer det inte vara möjligt att bedriva verksamhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.4",
      "sentiment": -0.5,
      "quote": "Förtydligandet av 6 § lagen om kommunal lantmäterimyndighet och 5 § p. 11 § förordningen (2009:946) med instruktion för Lantmäteriet innebär en fortsatt rollkonflikt för Lantmäteriet som tillsynsmyndighet, när myndigheten utövar tillsyn över den verksamhet som man själv bedriver.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.4",
      "sentiment": 0.0,
      "quote": "Förslaget till ändringen av 4 § förordningen (1995:1459) om avgifter vid lantmäteriförrättningar är otydlig och svår att tolka.",
      "quote_type": "grund"
    }
  ]
}