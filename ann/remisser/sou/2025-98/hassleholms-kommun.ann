  "segments": [
    {
      "forarbete_id": "a9.5.2",
      "sentiment": -0.8,
      "quote": "Att ge råd och stöd i bygg- och planprocesserna är en förutsättning för en effektiv fastighetsbildningsverksamhet inom de kommuner där det byggs mest i landet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3.3",
      "sentiment": -0.6,
      "quote": "Konsekvensen av ett sådant krav blir isolering av fastighetsbildningsverksamheten, högre kostnader och minskad effektivitet i samhällsbyggnadsprocessen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.2",
      "sentiment": -0.8,
      "quote": "Förslaget leder också till en sämre helhetssyn över till exempel infrastrukturprojekt och stadsbyggnadsprojekt som statliga myndigheter/bolag är en del av.",
