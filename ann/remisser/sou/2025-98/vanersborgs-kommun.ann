    },
    {
      "forarbete_id": "a9.5.2",
      "sentiment": -1.0,
      "quote": "Förslagen innebär att den integrerade roll i samhällsbyggnadsprocessen som de kommunala lantmäterimyndigheterna har idag kommer tillintetgöras.",
