  "segments": [
    {
      "forarbete_id": "sec8",
      "sentiment": 0.5,
      "quote": "Om alla lantmäterimyndigheter har samma tillgång till stöd i förrättningshandläggningen, till exempel samma handböcker, handledningar, ärendehanteringssystem och andra tekniska handläggningssystem, främjar det en effektiv, enhetlig och rättssäker fastighetsbildning i hela landet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.1",
      "sentiment": -0.5,
      "quote": "Myndigheten ser en risk i att förslaget kommer medföra att förrättningar splittras upp i onödan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.4",
      "sentiment": -0.5,
      "quote": "”Antas” är en alltför vag formulering som medför stor tolkningsmöjlighet och osäkerhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5",
      "sentiment": -0.5,
      "quote": "En detaljerad lista tenderar även att vara alltför oflexibel vilket medför att verksamheten inte kan anpassas när behoven ändras till exempel vid förändring inom samhällsutvecklingen eller när nya lagkrav kommer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec296",
      "sentiment": -0.2,
      "quote": "Genomförs förslaget kommer det innebära ökade kostnader för den kommunala lantmäterimyndigheten men även att samarbetet till övriga delar i samhällsbyggnadsprocessen försvåras eller helt försvinner.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec22",
      "sentiment": -0.5,
      "quote": "Utredningens motiv till varför inga förslag till samverkan lämnas är bristfällig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.3.1",
      "sentiment": -0.5,
      "quote": "Tillsynsmyndigheten Lantmäteriet med sina olika roller (främst rollern som handläggande myndighet i kombination med tillsynsrollen) sitter idag i en rollkonflikt där deras opartiskhet kan ifrågasättas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.6.1",
      "sentiment": 0.2,
      "quote": "Men att som idag sätta en taxa som enbart baseras på Lantmäteriets arbetssätt och behov gör att inte alla lantmäterimyndigheters kostnadstäckning, behov och budgetprocesser beaktas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.4.3",
      "sentiment": -0.2,
      "quote": "Myndigheten vill poängtera att den lokalkännedom som den kommunala lantmäterimyndigheten besitter ofta gör att denna typ av förrättningar handläggs snabbt och effektivt.",
      "quote_type": "grund"
