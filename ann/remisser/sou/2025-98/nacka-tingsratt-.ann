    {
      "forarbete_id": "a16.4.1",
      "sentiment": 1.0,
      "quote": "Domstolen tillstyrker även förslaget om att det av 4 § samma förordning ska framgå att avgiften ska beräknas utifrån hur lång tid som skäligen behövs för handläggningen.",
      "quote_type": "standpunkt"
