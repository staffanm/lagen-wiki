    },
    {
      "forarbete_id": "a11",
      "sentiment": 0.2,
      "quote": "Otydliga krav bidrar till att prövningen varken blir transparent eller förutsägbar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12",
      "sentiment": 1.0,
      "quote": "Om fler kommuner ges tillstånd att inrätta en lantmäterimyndighet i samverkan med en eller flera andra kommuner ser vi också en risk för att den statliga förrättningsverksamheten på sikt utarmas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14",
      "sentiment": 0.5,
      "quote": "Men vi anser att myndighetens tillsyn avgränsas onödigt snävt till att kontrollera verksamheten utifrån villkoren för tillstånd.",
      "quote_type": "grund"
