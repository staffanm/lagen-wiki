  "segments": [
    {
      "forarbete_id": "a2-4",
      "sentiment": 0.5,
      "quote": "det är bra att det förtydligas att Lantmäteriet som centralmyndighet är ansvarig för att ta fram handböcker, handledningar, rutiner, utbildningar och riktlinjer.",
