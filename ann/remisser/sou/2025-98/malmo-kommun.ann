  "overall": {
    "sentiment": -0.7,
    "quote": "Malmö stad anser att det finns ett stort värde i den kommunala lantmäterimyndighetens befintliga verksamhet och motsätter sig merparten av förslagen och slutsatserna i utredningen.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a7.3.1",
      "sentiment": 0.2,
      "quote": "För att detta ska bli möjligt behöver Lantmäteriets roller som centralmyndighet och handläggande myndighet hållas isär.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.2",
      "sentiment": -0.5,
      "quote": "En uppdelning av förrättningar mellan den statliga lantmäterimyndigheten och de kommunala motsvarigheterna, leder till en sämre överblick över samhällsbyggnadsprocessen hos kommunerna, vilket i sin tur riskerar att bidra till längre handläggningstider.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.4",
      "sentiment": -0.5,
      "quote": "Om förslaget genomförs kommer säkerhetskänslig information både hanteras lokalt av kommunerna i vissa processer och nationellt av statliga lantmäterimyndigheten. Det innebär ett onödigt spridande av information.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.4.3",
      "sentiment": -0.5,
      "quote": "Malmö stad anser att förslaget om att i vissa fall lägga kostnader på den som begärt överlämnande när kommunen är sakägare, riskerar att skapa osäkerheter hos sakägarna och svåra bedömningsfrågor hos lantmäterimyndigheterna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5.2",
      "sentiment": -0.5,
      "quote": "Förslagen i utredningen skulle påverka samhällsbyggnadsprocessen negativt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3.3",
      "sentiment": -0.5,
      "quote": "Om den kommunala lantmäterimyndigheten ska befinna sig i egna lokaler utan möjlighet att dela på gemensamma resurser och system såsom HR, ekonomi, IT med mera, skulle det medföra väsentligt ökade kostnader för myndigheten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec22",
      "sentiment": -0.5,
      "quote": "Det är en stor brist att denna utredning inte ger förslag gällande samverkansmöjligheter mellan befintliga kommunala lantmäterimyndigheter eller för den delen mellan en kommun med en kommunal lantmäterimyndighet och en kommun som saknar en sådan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.3.1",
      "sentiment": -0.5,
      "quote": "Lantmäteriet har tre roller i förhållande till den kommunala lantmäterimyndigheten: Centralmyndighet (ansvar för stöd och nuvarande ärendehanteringssystem), handläggande myndighet och tillsynsmyndighet. Det skapar intressekonflikter, vilket även Statskontoret lyft fram i en rapport från 2017, ”Delat ansvar för fastighetsbildning” (2017:18).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.6.1",
      "sentiment": 0.5,
      "quote": "Malmö stad har inga invändningar mot förslaget om att avgifterna ska vara enhetliga i hela landet, under förutsättning att det inte leder till högre avgifter för sakägarna.",
      "quote_type": "grund"
    }
  ]
}