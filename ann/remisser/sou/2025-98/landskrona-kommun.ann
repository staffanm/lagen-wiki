    {
      "forarbete_id": "a9",
      "sentiment": -0.5,
      "quote": "Att statliga projekt ska lämnas över till Lantmäteriet innebär en sämre helhetssyn över till exempel infrastrukturprojekt och stadsbyggnadsprojekt som en statlig myndighet eller bolag är en del av.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3",
      "sentiment": -0.5,
      "quote": "Att separera KLM från kommunen (exempelvis att KLM måste ha egna lokaler och inte får dela på kommunens gemensamma resurser som HR, ekonomi, IT) skulle innebära ökade kostnader.",
      "quote_type": "grund"
