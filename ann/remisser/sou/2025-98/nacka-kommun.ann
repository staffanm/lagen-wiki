  "segments": [
    {
      "forarbete_id": "a7.3",
      "sentiment": 1.0,
      "quote": "Nacka kommun tror att förtydligande av detta ansvar för det statliga lantmäteriet bidrar till ökad rättssäkerhet och enhetlighet för fastighetsbildningen över hela landet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a2-4",
      "sentiment": -0.5,
      "quote": "Nacka kommun anser det olämpligt att reglera en sådan detaljerad och teknisk fråga i lag, främst med hänsyn till att framtida teknik- och samhällsutveckling riskerar att snabbt göra en sådan bestämmelse inaktuell.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": 0.5,
      "quote": "Nacka kommun instämmer i detta förslag utifrån principen om likabehandling.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": -0.2,
      "quote": "Nacka kommun anser dock att kostnaden för utbildning i stället bör debiteras respektive myndighet som deltar vid det aktuella utbildningstillfället, eftersom behovet av utbildning skiljer sig åt mellan de 41 lantmäterimyndigheterna och sannolikt varierar över tid.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": -0.5,
      "quote": "Främst mot bakgrund av de höga kostnader som det statliga lantmäteriet kommunicerat i samband med tidigare erbjudande till kommunen att teckna avtal om det nya handläggningssystem som det statliga lantmäteriet utvecklar i egen regi (erbjudande år 2022, togs sedan tillbaka).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3",
      "sentiment": -0.5,
      "quote": "Om den statliga lantmäterimyndigheten handlägger och beslutar i ett ökat antal ärenden inom KLM:s verksamhetsområde riskerar detta att få en motsatt, splittrande, effekt på handläggningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.4",
      "sentiment": -0.5,
      "quote": "Nacka kommun anser att i de fall sakägare ändå begär överlämning sent i handläggningsprocessen blir det i praktiken svårt för lantmäterimyndigheterna att avgöra skälet till begäran.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5",
      "sentiment": -1.0,
      "quote": "Nacka kommun anser att en detaljerad uppräkning av tillåtna uppdrag i lag är olämplig, inte minst eftersom en sådan reglering redan i dag riskerar att vara inaktuell och snabbt kan bli än mer föråldrad till följd av samhälls- och teknikutveckling.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5",
      "sentiment": -1.0,
      "quote": "Nacka kommun bedömer att utredningens förslag kan tolkas som att sådant kvalitetshöjande arbete antingen inte längre får utföras alls av KLM, eller att det begränsas till att endast utföras i den omfattning som finansieras genom statliga medel.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3",
      "sentiment": 1.0,
      "quote": "Nacka kommun instämmer i utredningens förslag att kommunen även över tid ska visa att den kommunala lantmäterimyndighet uppfyller villkoren för inrättande, och inte enbart vid tidpunkten när tillstånd att bilda KLM söks.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a11.3",
      "sentiment": -1.0,
      "quote": "Om myndigheten i stället skulle tvingas bygga upp egna stödfunktioner, system och lokaler bedömer Nacka kommun att det skulle vara mycket svårt att uppnå kostnadstäckning i verksamheten.",
