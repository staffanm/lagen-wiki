  "overall": {
    "sentiment": 0.2,
    "quote": "Genom att genomföra dessa åtgärder tillsammans med de prioriteringar vi lyfter – snabbare anslutning av batterier, rättvisare nätavgifter och större användning av flexibilitet – kan Sverige bygga ett elsystem som är både robust och kostnadseffektivt, och som stärker elektrifieringen och klimatomställningen.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a4.6.2",
      "sentiment": -1.0,
      "quote": "Stöd till särskilda kraftslag riskerar att bli dyrt och ineffektivt för elanvändarna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.5",
      "sentiment": 0.5,
      "quote": "En sådan lösning vore dyr, tungrodd och riskerar att försvaga marknadens funktionssätt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec440",
      "sentiment": -0.5,
      "quote": "Sverige bör ta en proaktiv position i att utveckla stödsystem för icke-fossil flexibilitet, som mer kostnadseffektivt kan tillgodose resurstillräckligheten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.6.3",
      "sentiment": -1.0,
      "quote": "Sådana stöd riskerar att bli onödigt kostsamma för elanvändarna och skattebetalarna eftersom de oundvikligen slår undan installation och livstidsförlängningar i den kraftproduktion som inte får stöd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec432",
      "sentiment": 1.0,
      "quote": "Nätavgifternas utformning är central för ett effektivt utnyttjande av elnäten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec644",
      "sentiment": 1.0,
      "quote": "Vi tillstyrker därför förslaget att regeringen ska ge Ei bemyndigande att utfärda föreskrifter som ålägger nätföretagen att rapportera uppgifter till Ei om sina avgifter och villkor för transport av el.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec469",
      "sentiment": 1.0,
      "quote": "Villkorade avtal, där kunden abonnerar på en fast (prima) effekt och en villkorad (sekunda) effekt, som tillfälligt kan nekas av nätbolaget, är ett viktigt verktyg för att möjliggöra snabbare anslutningar i nät med kapacitetsbrist samt möjliggöra ett framtida kostnadseffektivt elnät som inte är dimensionerat för att hantera de högsta topparna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7",
      "sentiment": -0.5,
      "quote": "Det är inte samhällsekonomiskt rimligt att dimensionera det fysiska elnätet för toppar som bara inträffar några gånger per år.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9",
      "sentiment": 1.0,
      "quote": "att arbetet med en centraliserad datahub för elmarknaden påbörjas, i etapper och utan att bromsa andra utvecklingsprojekt",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec629",
      "sentiment": 1.0,
      "quote": "att Energimarknadsinspektionen tilldelas mer resurser för att kunna genomföra sitt uppdrag effektivt",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.5.1",
      "sentiment": 1.0,
      "quote": "att ellagen förtydligas så att samarbete mellan elnätsföretag stärks, inte bara gentemot Svenska kraftnät utan även mellan olika nätbolag",
      "quote_type": "standpunkt"
    }
  ]
