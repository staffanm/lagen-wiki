  "segments": [
    {
      "forarbete_id": "a4.3.1",
      "sentiment": 1.0,
      "quote": "Precis som utredningen konstaterar behövs börshandeln för att marknaden ska fungera, i annat fall blir det väldigt svårt att sätta priser.",
