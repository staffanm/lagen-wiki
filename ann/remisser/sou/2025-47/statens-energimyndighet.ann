  "segments": [
    {
      "forarbete_id": "a9",
      "sentiment": 0.2,
      "quote": "Det är viktigt att inte underskatta omfattningen och komplexiteten i utformningen av ett dataverktyg av den typ som föreslås i utredningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec276",
      "sentiment": -0.5,
      "quote": "Myndighetens avstyrkan har sin grund i att de olika verktygen inriktar sig på olika delar av beredskapssystemet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec228",
      "sentiment": 0.5,
      "quote": "För att säkerställa att åtgärderna verkligen stärker investeringsförutsättningarna, snarare än att introducera nya marknadsrisker, krävs en noggrann utformning, en transparent och förutsebar process samt en tät och kontinuerlig samordning mellan berörda myndigheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.6.2",
      "sentiment": 0.2,
      "quote": "Om elpriserna blir lägre än förväntat kan de offentliga kostnaderna öka kraftigt och skattekollektivet kan behöva subventionera olönsamma projekt och andra energipolitiska satsningar trängs undan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec199",
      "sentiment": 1.0,
      "quote": "Om standardiseringen drivs för långt, utan tillräcklig hänsyn till aktörernas olika behov och riskprofiler, riskerar flexibiliteten och innovationskraften i marknaden att minska.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec21",
      "sentiment": 1.0,
      "quote": "Ersättningsnivåer i denna härad bör emellertid ha en marginell påverkan på befintliga anläggningars tillgänglighet och eventuella framtida investeringsbeslut, eftersom grossistmarknaden är och förblir den dominerande intäktskällan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8",
      "sentiment": 1.0,
      "quote": "Målet bör vara att tillgodose behovet av reaktiv effekt på ett kostnadseffektivt och teknikneutralt sätt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.4",
      "sentiment": 0.5,
      "quote": "Det är dock viktigt att poängtera att villkorade avtal ska ses som en sistahandslösning efter att andra marknadsbaserade verktyg har uttömts.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5",
      "sentiment": 0.5,
      "quote": "Att det finns en utsedd sistahandsleverantör utgör en viktig trygghetsmekanism, men för att förslaget ska få avsedd effekt krävs att det kombineras med riktade åtgärder som minskar informationsklyftor, förbättrar tillgången till rådgivning och säkerställer att samtliga hushåll – oavsett tekniska, språkliga eller ekonomiska förutsättningar – ges möjlighet att fatta informerade beslut.",
      "quote_type": "grund"
