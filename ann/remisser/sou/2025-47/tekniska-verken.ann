    {
      "forarbete_id": "a5.5.5",
      "sentiment": 1.0,
      "quote": "För att kunna möta behov av framtida, men ännu ej beställd elinfrastruktur är det viktigt att intäktsregleringen för elnätsföretag möjliggör investeringar på prognos.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec288",
      "sentiment": 1.0,
      "quote": "Det är en fördel om dessa begrepp harmoniseras med motsvarande EU-regelverk.",
