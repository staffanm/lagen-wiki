  "segments": [
    {
      "forarbete_id": "a4.6.2",
      "sentiment": 0.2,
      "quote": "Det finns emellertid en risk för avsevärd marknadspåverkan om stora mängder av enskilda kraftslag, exempelvis kärnkraft och havsbaserad vindkraft erhåller olika former av intäktsgarantier från staten där övriga producenter utelämnas.",
