    },
    {
      "forarbete_id": "sec69",
      "sentiment": 0.5,
      "quote": "Vid en revidering av europeisk lagstiftning, finns dock risk att artikelreferenserna blir felaktiga om artikelnumren i kommissionsförordningarna ändras.",
