  "overall": {
    "sentiment": 0.2,
    "quote": "E.ON stödjer i stort Energiföretagens remissvar, men vill genom detta svar fördjupa våra synpunkter i vissa delar av utredningen.",
    "quote_type": "standpunkt"
  },
  "segments": [
    {
      "forarbete_id": "a4.6.2",
      "sentiment": 0.5,
      "quote": "Det är positivt att utredningen lyfter de risker som finns med dubbelriktade differenskontrakt, och E.ON vill betona att stöd bör inriktas på förmågor istället för särskilda kraftslag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec581",
      "sentiment": 1.0,
      "quote": "Vi stödjer också förslagen som harmoniserar terminologin i svensk rätt med EUrätten.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec621",
      "sentiment": 0.5,
      "quote": "Det är dock viktigt att de utökade krav som följer av denna roll inte finansieras enbart av kunderna i dessa regionnätägares nät, då nyttan tillfaller en bredare grupp.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec413",
      "sentiment": 1.0,
      "quote": "Vi är positiva till att utredningen föreslår att ansvarsfördelningen mellan dessa nätföretag och Svenska kraftnät regleras i avtal och inte i lagstiftning, samt att det finns en eskalationsprincip där Energimarknadsinspektionen involveras om parterna inte skulle komma överens.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec339",
      "sentiment": 1.0,
      "quote": "Det är därför viktigt att regionnätsbolagen ingår i det Elförsörjningsråd som ska inrättas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec414",
      "sentiment": -1.0,
      "quote": "I slutändan är det kunden som ska stå för kostnaden, och det är inte säkert att det alltid är mest lämpligt att åtgärden görs på den nätnivå där bristen finns, vilket gör det svårt att hitta en lagstiftning som passar alla situationer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec432",
      "sentiment": -0.5,
      "quote": "Det finns en fundamental nytta i att produktion placeras nära förbrukningen då detta minskar behovet av elöverföring.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec466",
      "sentiment": -0.5,
      "quote": "Istället bör effektavgiften användas för att bidra till ett mer effektivt nätutnyttjande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.4",
      "sentiment": 1.0,
      "quote": "E.ON ser det som ett sätt att kunna ansluta kunder snabbare och också för kunder att få lägre kostnader.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5",
      "sentiment": 1.0,
      "quote": "E.ON stödjer målsättningen att elmarknaden fungerar bäst när kunderna är aktiva och själva väljer avtal på en transparent och konkurrensutsatt marknad.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5.3",
      "sentiment": 1.0,
      "quote": "Den föreslagna modellen bedöms som förhållandevis enkel och ändamålsenlig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2",
      "sentiment": 0.5,
      "quote": "Ett nytt system behöver dra lärdomar från arbetet med den tidigare Elmarknadshubben, vars omfattning blev för stor.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5",
