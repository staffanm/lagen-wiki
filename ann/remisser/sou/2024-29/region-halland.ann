  "overall": {
    "sentiment": 0.2,
    "quote": "Förslagen är i grunden väl avvägda, men vi ser behov av justeringar för att säkerställa regional fördelning samt att säkerställa inkludering av små och medelstora företag (SME).",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a7.4.3",
      "sentiment": -0.5,
      "quote": "Värt att poängtera är också att kommunen har ansvar att beakta fler aspekter, intressen och behöver göra avvägningar kring nybyggnation än den enskilda exploatören vilket inte ska förringas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.4",
      "sentiment": -0.2,
      "quote": "Regionernas bedömning är att länsstyrelsens roll inom regional utveckling inte behöver stärkas generellt, med däremot tydliggöras i vissa specifika steg och hur det förhåller sig till det huvudansvar som regionerna har i sitt regionala utvecklingsuppdrag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.6",
      "sentiment": -0.5,
      "quote": "Genom att som kommun även hantera gestaltningsfrågor kan en attraktivitet uppnås, behållas och utvecklas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.1",
      "sentiment": 0.5,
      "quote": "Det är därför viktigt att de samhällsekonomiska bedömningarna inte enbart räknar på en enskild investering eller åtgärd utan också räknar in de positiva och/eller negativa systemeffekter som en åtgärd innebär.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.2",
      "sentiment": -0.2,
      "quote": "Region Halland ställer sig frågande till hur föreslagen flytt av ansvar att sätta kalkylräntan för infrastrukturinvesteringar skulle komma att påverka infrastrukturinvesteringarna i sin helhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.3",
      "sentiment": 1.0,
      "quote": "Att prioritera underhåll är, utöver nya investeringar i transportinfrastrukturen, av stor vikt för den regionala utvecklingen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec411",
      "sentiment": -0.5,
      "quote": "Region Halland menar att uppföljning och utvärdering av dimensioneringsreformen behöver göras först för att se om implementerade förslag bidrar till avsedd effekt innan regeringen går vidare med ytterligare förändringar.",
      "quote_type": "grund"
    }
  ]
