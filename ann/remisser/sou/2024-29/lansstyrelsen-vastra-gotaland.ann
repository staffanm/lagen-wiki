    },
    {
      "forarbete_id": "a7",
      "sentiment": 0.0,
      "quote": "Länsstyrelsen delar bedömningen att regelmassan inom bostadsområdet och den fysiska planeringen är omfattande och komplex.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.1",
      "sentiment": 0.5,
      "quote": "Det samlade greppet bör enligt Länsstyrelsen ha bred politisk förankring, vara genomförbart och långsiktigt hållbart.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.4",
      "sentiment": 0.8,
      "quote": "Länsstyrelserna har vid åtskilliga tillfällen framfört till regeringen att de saknar resurser och verktyg för aktivt delta i det regionala utvecklingsarbetet och fullgöra sin roll som statlig samordnare och främjare av samarbete.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.6",
      "sentiment": -0.5,
      "quote": "Länsstyrelsen vill erinra om att en god gestaltning är ett medel för att nå flera nationella och internationella åtaganden, exempelvis Agenda 2030, FN:s New Urban Agenda och de för Sverige uppsatta målen för kultur- och miljöpolitiken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.7",
      "sentiment": -0.2,
      "quote": "Länsstyrelsen anser däremot att strikta tidsgränser inte är motiverade, då olika projekt är olika beroende av komplexa samband.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.8",
      "sentiment": -0.2,
      "quote": "Dock kan en begränsning av att begära ytterligare utredningar under processen leda till svåröverblickbara konsekvenser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8",
      "sentiment": 0.5,
      "quote": "Vi menar samtidigt att de modeller som Trafikverket använder för beräkning av samhällsekonomisk lönsamhet behöver utvecklas för att bli mer transparenta och tydligare styra mot uppsatta mål.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.2",
      "sentiment": -0.2,
      "quote": "En hög diskonteringsränta blir således oförenlig med långsiktigt hållbar utveckling (och tillväxt) om den leder till att åtgärder som är nödvändiga för att nå en sådan hållbarhet väljs bort.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.3",
      "sentiment": 1.0,
      "quote": "Att förvalta det vi har är ett effektivt sätt att använda våra resurser.",
