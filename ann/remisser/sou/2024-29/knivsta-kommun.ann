    {
      "forarbete_id": "a8.4.2",
      "sentiment": 0.2,
      "quote": "Ur ett lokalt perspektiv kan detta få en negativ påverkan för mindre företag som inte har kapacitet att lämna anbud digitalt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec262",
      "sentiment": -0.5,
      "quote": "en förändring av det kommunala vetot är ett stort ingrepp i det kommunala självstyret.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.13",
      "sentiment": 0.2,
      "quote": "Fri hyressättning kan leda till högre hyror och ökat behov av kommunala bostadssociala insatser vilket skulle vara negativt om så blir fallet.",
