    {
      "forarbete_id": "a13.5.7",
      "sentiment": 0.5,
      "quote": "Knivsta kommun anser att staten bör erbjuda kommunerna statsbidrag som är möjliga att ansöka för medverkan i forskningsprojekt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9",
      "sentiment": 0.2,
      "quote": "Det finns även en risk att en statlig styrning av dimensionering och utbud innebär att de lokala behoven kommer i kläm.",
