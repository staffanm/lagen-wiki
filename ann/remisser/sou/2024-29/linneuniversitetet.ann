  "segments": [
    {
      "forarbete_id": "a9.2.2",
      "sentiment": 1.0,
      "quote": "Linnéuniversitetet instämmer i utredningens bedömning att urholkningen av resurstilldelningen av högre utbildning har fått negativa konsekvenser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec405",
      "sentiment": 1.0,
      "quote": "Skälen för att Linnéuniversitetet tillstyrker förslaget grundar sig i en delad problembeskrivning om att det nuvarande betygsystemet leder till incitament hos lärare och skolledning inom grund- och gymnasieskolan att ge oskäligt höga betyg, vilket i förlängningen skapar en osund betygsinflation.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec408",
      "sentiment": -0.2,
      "quote": "Högskoleprovet har ingen kunskapsgrund på det sättet att det kan översättas till högskoleförordningens definition av särskild behörighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec412",
      "sentiment": 0.0,
      "quote": "En fundamental nackdel med ett system likt det danska, där större resurser tilldelas utbildningar vars nyexaminerade studenter i högre grad är i sysselsatta eller är registrerade för vidare studier, är att det är bakåtblickande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec420",
      "sentiment": 0.5,
      "quote": "Linnéuniversitetet är dock försiktigt positiv till förslaget då det bör öka förutsägbarheten i resurstilldelningen, vilket i förlängningen torde gynna kvaliteten i utbildningarna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec425",
      "sentiment": -0.2,
      "quote": "Linnéuniversitetet bedömer att det inte finns tillräckligt underlag för att tillstyrka det sammantagna förslaget, men välkomnar samtidigt en grundligare utredning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec415",
      "sentiment": -0.2,
      "quote": "är negativ till förslag som innebär att studenter får bära en större del av kostnaden för sin utbildning då det sannolikt skulle öka snedrekryteringen till högskolan.",
      "quote_type": "grund"
    }
  ]
