    {
      "forarbete_id": "a10",
      "sentiment": 0.5,
      "quote": "staten för varje nytt krav på kontroll eller rapportering måste se till att det åtföljs av både kompetensstöd och verktyg för att teorin ska fungera i praktiken och för att göra arbetet praktiskt genomförbart för kommunerna.",
      "quote_type": "grund"
