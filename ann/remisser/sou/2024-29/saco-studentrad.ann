  "segments": [
    {
      "forarbete_id": "sec412",
      "sentiment": 0.2,
      "quote": "Om exempelvis etableringsgrad premieras finns det risk att gårdagens arbetsmarknad utformar dimensioneringen, samtidigt som vissa utbildningar missgynnas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec413",
      "sentiment": 1.0,
      "quote": "Det skulle stärka lärosätenas finansiering, eftersom den skulle vara mindre beroende av studenters individuella Box 2206 prestationer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec414",
      "sentiment": -0.2,
      "quote": "Vissa mindre utbildningar, med få utbildningsplatser, skulle kunna få det svårt att gå ihop med minskade utbildningsplatser, även med högre ersättning per student.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec415",
      "sentiment": -0.5,
      "quote": "Vi motsätter oss försöksverksamheter där olika grupper av studenter ges olika studiemedelssystem, det är ett dåligt och ojämlikt sätt att testa reformförslag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec416",
      "sentiment": -0.5,
      "quote": "Saco studentråd förespråkar en generell förlängning av maxtiden från dagens 240 veckor till 280 veckor (motsvarande från 12 till 14 terminer).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec417",
      "sentiment": -0.5,
      "quote": "En höjning till exempelvis 80% skulle innebära en i praktiken höjning till 100% på många utbildningar, vilket skulle sätta orimligt stor press på de individuella studenterna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec418",
      "sentiment": 1.0,
      "quote": "För studenter som har dålig ekonomi men av olika skäl har utmaningar att arbeta extra (exempelvis pga föräldraskap eller tidskrävande utbildningar) kan utökade lån vara ett bra sätt att få högre inkomster under studietiden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec419",
      "sentiment": 1.0,
      "quote": "Alltför många studenter känner ett tvång att arbeta vid sidan av studierna för att få ekonomin att gå ihop.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec420",
      "sentiment": -0.5,
      "quote": "Den typen av åtgärder riskerar att drabba utsatta grupper som av olika skäl hamnar efter i studierna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec421",
      "sentiment": -0.5,
      "quote": "Om det exempelvis skulle vara högre lånedel på avancerad nivå riskerar det att avskräcka för vidare studier.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec422",
      "sentiment": -0.5,
      "quote": "Förslaget riskerar att få mycket dödviktskostnader, då det skulle bli en kostnad för ungefär 75 tusen studenter som tar examen varje år även utan examensbonus.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec423",
      "sentiment": -0.5,
      "quote": "Studiemedelssystemets roll har aldrig varit att få studenter att söka till utbildningar utifrån arbetsmarknadens behov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec424",
      "sentiment": -0.2,
      "quote": "Generellt sett är det också äldre studenter som har sämre ekonomi än yngre studenter, så att utforma ett system som premierar yngre studenter skulle inte vara ändamålsenligt för att utjämna ojämlikheter.",
      "quote_type": "grund"
    }
  ]
