  "segments": [
    {
      "forarbete_id": "a7.4.1",
      "sentiment": -0.5,
      "quote": "Det är MKB:s uppfattning att nya utredningar och reformerade regelverk inte är det som behövs för att lösa de knutar som utgör hinder för att bygga fler bostäder.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.2",
      "sentiment": 0.0,
      "quote": "MKB ser inte behov av en översyn av regelverk, utmaningarna finns i kommuners tillämpning av bestämmelserna, bland annat kopplat till gestaltning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.6",
      "sentiment": 0.8,
      "quote": "MKB delar bilden av att ökad förutsägbarhet vad gäller gestaltning och utseende i nyproduktion är avgörande för en mer effektiv byggprocess.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.7",
      "sentiment": 0.5,
      "quote": "Ledtider i planprocessen har direkt påverkan på kostnadsbilden vid nyproduktion och det är viktigt att kunna följa upp hur dessa utvecklas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.8",
      "sentiment": 0.8,
      "quote": "I linje med tidigare kommentarer är MKB positiva till förslag som syftar till att öka förutsägbarheten både vad gäller krav och kostnader.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.11",
      "sentiment": 0.8,
      "quote": "Förslagen kan skapa möjligheter till ändamålsenligt och kostnadseffektivt bostadsbyggande när dessa former är lämpliga att använda.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.13",
      "sentiment": -0.8,
      "quote": "Det är nödvändigt för att lyckas bygga bort bostadsbristen i verklig mening, och innebär samtidigt en minskad affärsrisk.",
      "quote_type": "grund"
    }
  ]
}