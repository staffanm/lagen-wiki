    },
    {
      "forarbete_id": "sec252",
      "sentiment": 1.0,
      "quote": "Dagens situation, där kommuner kan dröja med besked och ändra ställningstaganden sent i processen, skapar osäkerhet och driver upp kostnaderna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.2",
      "sentiment": 1.0,
      "quote": "Förslaget om att införa en ventil för att möjliggöra avvägningar är centralt för att modernisera regelverket och säkerställa att viktiga tillväxtfrågor inte automatiskt underordnas andra intressen utan en helhetsbedömning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec256",
      "sentiment": 1.0,
      "quote": "Takten för elnätsutbyggnaden är en flaskhals, därför är det avgörande att korta ledtider, genom att bland annat tillåta undantag från miljöbestämmelser",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec260",
      "sentiment": 1.0,
      "quote": "Överimplementering skapar onödiga regler och administrativa bördor i Sverige jämfört med andra EU-länder.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7",
      "sentiment": 1.0,
      "quote": "Kommissionen identifierar korrekt många av de grundläggande strukturella problem som håller produktiviteten i byggsektorn tillbaka och bidrar till en dysfunktionell bostadsmarknad.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.3",
      "sentiment": 1.0,
      "quote": "Dagens system, där lokala intressen ofta tillåts väga tyngre än regionala och nationella behov av tillväxt och rörlighet, riskerar att hämma ett effektivt bostadsbyggande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.4",
      "sentiment": 1.0,
      "quote": "Flytten av regionalt utvecklingsansvar har inneburit att kompetens inom ekonomisk hållbarhet och tillväxt försvunnit från länsstyrelserna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.5",
      "sentiment": 1.0,
      "quote": "Ökande ledtider i samhällsbyggandet, där överklaganden utgör en central del, skapar risk och osäkerhet för alla aktörer och driver kostnader.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.6",
      "sentiment": 0.2,
      "quote": "Förslaget bör bidra till en mer förutsägbar och tydlig process, samtidigt som kommunen även framgent har möjlighet att hantera gestaltningsfrågor i detaljplaneprocessen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.7",
      "sentiment": 1.0,
      "quote": "Byggföretagen ser positivt på ansatsen och anser att förslaget kan bidra till en nödvändig genomlysning av processer för att de ska kunna effektiviseras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.8",
      "sentiment": -0.5,
      "quote": "För att uppnå mer effektiva processer krävs mer än vägledningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.10",
      "sentiment": 1.0,
      "quote": "bedömer att kommissionens andra punkt, avseende ett uppdrag till Boverket att utvärdera regelverkets effekter på ledtider, kartlägga och rapportera ledtiderna samt analysera hinder för att korta dessa är av störst betydelse för mer effektiva processer och ökad effektivitet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.11",
      "sentiment": 1.0,
      "quote": "Byggföretagen instämmer i produktivitetskommissionens resonemang.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.4.12",
      "sentiment": 1.0,
      "quote": "Byggföretagen instämmer i det stora behovet av ett reformerat strandskydd.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.4.13",
      "sentiment": 1.0,
      "quote": "Dagens system med presumtionshyror har inte fullt ut skapat den förutsägbarhet som krävs för långsiktiga investeringar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8",
      "sentiment": 1.0,
      "quote": "De adresserar flera av de systemfel som idag begränsar anläggningsbranschens förmåga att effektivt bidra till Sveriges utveckling.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.1",
      "sentiment": 1.0,
      "quote": "Den nuvarande situationen, där samhällsekonomiskt olönsamma investeringsprojekt prioriteras framför lönsamma projekt, är skadlig för den nationella produktiviteten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.2",
      "sentiment": -0.2,
      "quote": "införa en riskkomponent och differentiering av kalkylräntan för varje enskilt projekt anser vi inte tillför något värde utan snarare riskerar ett godtycke och öppnar upp för oseriös påverkan",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.3",
      "sentiment": 1.0,
      "quote": "eftersatt underhåll är ett av de största problemen inom transportinfrastrukturen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.4",
      "sentiment": 1.0,
      "quote": "Byggföretagen ställer sig positiva till den ovannämnda utredningens förslag om att bilda ett statligt ägt bolag för genomförande av utvalda infrastrukturinvesteringar.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.7.5",
      "sentiment": 1.0,
      "quote": "Byggföretagen ställer sig bakom Produktivitetskommissionens förslag att de mål som sätts upp för verksamheten är konkreta och kvantifierbara och ligger inom myndighetens kontroll samt att anslagsändamålen görs mer övergripande.",
