  },
  "segments": [
    {
      "forarbete_id": "a5.6.4",
      "sentiment": 0.8,
      "quote": "Kommunen bedömer det som nödvändigt att få till ändrade arbetssätt och också frigöra resurser till kärnverksamheten som i många fall står inför stora demografiska utmaningar med tillhörande kompetensförsörjningsproblem.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.6.5",
      "sentiment": 0.2,
      "quote": "Malmö stads utgångspunkt är att det är positivt med uppföljning och utvärdering av regelverk men att detta behövas vägas mot behov av långsiktig stabilitet och förutsägbarhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.1",
      "sentiment": 0.8,
      "quote": "Genom att göra ändringstillstånd till huvudregel vid ändring av befintliga verksamheter skulle hanteringen av prövningarna både tydliggöras och förenklas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.2",
      "sentiment": -0.5,
      "quote": "En ventil i miljöbalken riskerar att medföra att miljöskyddet försvagas i betydande utsträckning genom att kortsiktiga ekonomiska eller politiska intressen kan prioriteras över långsiktiga miljöintressen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.1",
      "sentiment": -0.2,
      "quote": "Kommunen bedömer därför att det är viktigt att det finns ett helhetsperspektiv i en sådan reformering där de sociala aspekterna är lika viktiga som de marknadsmässiga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.2",
      "sentiment": -0.5,
      "quote": "Hänsynstagande till olika allmänna och enskilda intressen i planering och tillståndsprocesser ger förutsättningar för en långsiktigt hållbar planering.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.3",
      "sentiment": -1.0,
      "quote": "Genom det kommunala planmonopolet säkerställs att beslut fattas nära de människor och intressenter som berörs.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.5",
      "sentiment": -0.8,
      "quote": "Förslaget innebär att medborgarnas möjlighet att utöva inflytande över och känna delaktighet till sin närmiljö minskar, vilket ur demokratisk aspekt är allvarligt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.6",
      "sentiment": -0.5,
      "quote": "Det är en viktig förutsättning för den lokala demokratin att ha inflytande över stadsmiljöerna och att få möjlighet att arbeta med dessa för att de ska harmoniera med övrig planering och stadsutveckling.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.7",
      "sentiment": -0.2,
      "quote": "Malmö stad bedömer att förslaget att införa tidsgränser för olika skeden i planprocessen inte tar hänsyn till planeringens komplexitet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.8",
      "sentiment": -0.2,
      "quote": "Effekten kan bli att detaljplaneprocesser kan behöva avbrytas av kostnadsskäl och att detaljplaner upphävs vid överprövning på grund av bristfälligt underlag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.1",
      "sentiment": 0.5,
      "quote": "Malmö stad ser därför positivt på förslaget att Trafikverket får i uppdrag att i nationell plan ta fram rekommendationer om styrmedel, prissättning eller reglering för att tydliggöra alternativ till nyinvestering i linje med fyrstegsprincipen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.1",
      "sentiment": 0.8,
      "quote": "Malmö stad håller med produktivitetskommissionen om att utbildning och ett välfungerande skolsystem är en viktig del i ett framgångsrikt Sverige.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.2",
      "sentiment": 0.8,
      "quote": "Malmö stad håller med produktivitetskommissionen om att utbildning och ett välfungerande skolsystem är en viktig del i ett framgångsrikt Sverige.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.3",
      "sentiment": 0.8,
      "quote": "Det är en viktig demokratisk princip att allmänheten bör ha lika insyn och möjlighet att granska den verksamhet som finansieras av offentliga medel.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.4",
      "sentiment": 0.0,
      "quote": "Eftersom det är förslag med stor påverkan på verksamheten bedömer Malmö stad att det behövs fortsatt utredning kring förslagen för att kommunen ska kunna ta ställning och ge mer specifika kommentarer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.6",
      "sentiment": 0.8,
      "quote": "Det torde således finnas möjlighet till betydande effektivitets- och kvalitetsvinster vid en tillsyn som samlas hos Skolinspektionen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.3.1",
      "sentiment": 0.5,
      "quote": "En förutsättning är dock att rådet arbetar proaktivt och stödjande, att det inte medför en ökad administrativ börda för kommunerna och att finansieringsprincipen säkerställs.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.3.2",
      "sentiment": 0.8,
      "quote": "Malmö stad instämmer i kommissionens förslag till statsbidragsprincip och att regeringen bör redovisa huruvida nya föreslagna riktade statsbidrag lever upp till statsbidragsprincipen.",
