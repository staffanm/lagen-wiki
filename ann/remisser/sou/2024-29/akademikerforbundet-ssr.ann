  "segments": [
    {
      "forarbete_id": "sec514",
      "sentiment": -0.5,
      "quote": "Akademikerförbundet SSR är mycket kritisk mot denna statliga oförutsägbarhet gentemot medborgarna om välfärdens finansiering.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12",
      "sentiment": 0.5,
      "quote": "Akademikerförbundet SSR instämmer i att förvaltningarnas flitiga användande av bolagsformen minskar insynen i kommun- och regionsektorn och därmed möjligheterna till politisk påverkan och demokratiskt ansvarsutkrävande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10",
      "sentiment": 0.5,
      "quote": "Förbundet delar helt ambitionen att minska denna administration, men med tillägget att det är naivt att tro att detta kan göras utan att också minska antalet valfrihetssystem inom stat, region och kommun.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.2",
      "sentiment": 0.2,
      "quote": "Det är dock oklart hur långt ett sådant förslag kan gå inom ramen för nuvarande regelverk där nya leverantörer måste ges möjligheter att komma in på marknaden och där det inte är ovanligt att bolag nybildas för att slippa undan anmärkningar eller domar i tidigare bolag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.5",
      "sentiment": -1.0,
      "quote": "Resonemanget kring hur en bred skattesänkning, till en kostnad som överskuggar resten av utredningen, skulle leda till högre produktivitet liknar mest en studie i magiskt tänkande.",
      "quote_type": "grund"
    }
  ]
}