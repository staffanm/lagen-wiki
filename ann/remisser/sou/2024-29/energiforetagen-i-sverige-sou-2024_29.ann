  "segments": [
    {
      "forarbete_id": "sec245",
      "sentiment": 1.0,
      "quote": "Det ligger väl i linje med de synpunkter Energiföretagen har framfört i remissvar avseende Ds Ny myndighet för miljöprövning (Dnr KN2025/01878).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec407",
      "sentiment": -0.5,
      "quote": "Det riskerar att sänka statusen på dem samt leda till sämre kvalitet vilket kan skada näringslivets kompetensförsörjning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec412",
      "sentiment": 1.0,
      "quote": "Eftersom det är efterfrågade utbildningar av energibranschen, och etableringsgraden för både civil- och högskoleingenjörer över lag är väldigt god, hade energirelevanta ingenjörsutbildningar troligtvis stärkts av en arbetsmarknadskomponent i resurstilldelningssystemet och dimensioneringen av högre utbildning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec439",
      "sentiment": -0.5,
      "quote": "Även om det är positivt att utredningen lagt fram ett förslag om mer arbetsmarknadsanknytning i dimensionering och finansiering av högre utbildning (9.3.2) är det viktigt med ännu större koppling till arbetsmarknaden.",
      "quote_type": "grund"
    }
  ]
