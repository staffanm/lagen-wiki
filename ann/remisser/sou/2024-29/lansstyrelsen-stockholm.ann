  "segments": [
    {
      "forarbete_id": "a10",
      "sentiment": 1.0,
      "quote": "offentlig sektor ligger efter i användandet av digitalisering internationellt sett, stora krafttag behövs för att vända utvecklingen och det är sannolikt det område som skulle gynna offentlig sektors produktivitet mest",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.4",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen förväntas bidra strategiskt till regional utveckling, men saknar ett tydligt uppdrag och i viss mån även resurser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6",
      "sentiment": -0.5,
      "quote": "Förenklade regler och snabbare tillståndsprocesser kan göra det svårare för myndigheter att noggrant granska ägarförhållanden, finansiering samt om företag följer regler om skatt och arbetsvillkor.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7",
      "sentiment": -0.2,
      "quote": "Länsstyrelsen anser att det därför är viktigt att utvärdera de lagändringar som har genomförts inom plan- och bygglagstiftning, strandskyddslagstiftning och lag om kommunernas bostadsförsörjningsansvar innan det fattas beslut om ytterligare förändringar i nämnd lagstiftning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec80",
      "sentiment": 0.5,
      "quote": "För att kunna attrahera högkvalificerad arbetskraft som väljer att etablera sig behöver kommissionens förslag kompletteras med insatser som underlättar för närstående och barn.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9",
      "sentiment": 0.5,
      "quote": "Det är dock viktigt att anpassa arbetsmarknadsutbildningar och förberedande utbildningar än mer än vad som redan görs till de kunskapsnivåer som potentiella elever har och beakta målgruppens behov och förutsättningar.",
      "quote_type": "grund"
    }
  ]
