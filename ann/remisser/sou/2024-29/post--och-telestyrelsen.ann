  "segments": [
    {
      "forarbete_id": "a5.6.1",
      "sentiment": 1.0,
      "quote": "PTS delar bedömningen att regelgivningsprocessen behöver förbättras och vill särskilt trycka på behovet av bättre konsekvensutredningar ex ante och uppföljning ex post.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.6.2",
      "sentiment": -0.2,
      "quote": "ESV kan få ansvar för att ta fram metodstöd och ge stöd till myndigheter, men granskning och godkännande av konsekvensutredningar bör ligga hos en myndighet närmare de faktiska utmaningarna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.6.3",
      "sentiment": -0.5,
      "quote": "Hänvisningen till en proportionalitetsprincip är positiv, men inte tillräcklig och kan dessutom skapa otydlighet och osäkerhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.6.5",
      "sentiment": -0.5,
      "quote": "I den vidare handläggningen måste nyttan och konsekvenserna av att konsekvensutredningen inte godkänns av ESV utredas och förtydligas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.6.9",
      "sentiment": 1.0,
      "quote": "Det är viktigt att regelverken fortsätter att utformas efter att förordning eller direktiv är beslutat.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.2.2",
      "sentiment": 1.0,
      "quote": "Då PTS är av AI-utredningen föreslagen som myndighet med ansvar för den obligatoriska regulatoriska sandlådan i enlighet med AI-förordningen anser vi att PTS bör vara en av de myndigheter som ingår i ett sådant uppdrag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.4.2",
      "sentiment": -0.5,
      "quote": "En separat kommitté riskerar att skapa otydlighet i ansvar, överlapp och dubbelarbete.",
      "quote_type": "grund"
    }
