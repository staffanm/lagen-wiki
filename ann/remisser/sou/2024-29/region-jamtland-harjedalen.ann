  "overall": {
    "sentiment": 0.2,
    "quote": "Region Jämtland Härjedalen bedömer dock att dessa iakttagelser inte fullt ut tas om hand i den samlade analysen eller i utformningen av förslagen.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a3.1",
      "sentiment": -0.2,
      "quote": "Erfarenheter från genomförandet av regionala utvecklingspolitiken visar att platsbundna strukturella förutsättningar – såsom långa avstånd, liten arbetsmarknad och begränsad kritisk massa – i hög grad påverkar reformers genomslag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec77",
      "sentiment": -0.2,
      "quote": "Förankring i det regionala är avgörande för att synliggöra regionla systemskillnader, det gör att även glesa regioner kan vara med och bidra till nationell tillväxt och produktivitet på ett bra sätt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec79",
      "sentiment": -0.2,
      "quote": "Kompetensförsörjning och matchning i glesa regioner är i högre grad beroende av regional samordning, utbildningsnärvaro och samverkan mellan aktörer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.6.3",
      "sentiment": -0.2,
      "quote": "Erfarenheter visar på att samma regelverk ofta får mer långtgående effekter i glesa regioner, där företag, kommuner och offentliga aktörer har mindre administrativa resurser och färre alternativa lösningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec82",
      "sentiment": 0.2,
      "quote": "Brist på lokal banknärvaro kan försvåra kreditbedömningar, relationer mellan företag och finansiärer samt finansiering av företag, bostäder och kommersiella fastigheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.1",
      "sentiment": -0.2,
      "quote": "En alltför ensidig betoning på tidsförkortning riskerar att leda till ökade konflikter, överklaganden och i förlängningen längre processer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.1",
      "sentiment": -0.5,
      "quote": "Att i beräkningar utgå från antal invånare i regioner med transporttunga näringar såsom exempelvis besöksnäring och skogsnäring, ger en orättvis bild av behovet av investeringar i infrastrukturen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": -0.2,
      "quote": "Möjligheten till finansiering av bostäder och företagslokaler i glesa strukturer är mer begränsad än i täta strukturer och detta är ett hinder för så väl regional utveckling, tillväxt som produktivitet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": -1.0,
      "quote": "Bidragen används alltså framför allt för att kompensera för extrakostnader för personer i icke arbetsför ålder, inte för att arbetslösa ska stanna kvar i glesbygden.",
      "quote_type": "grund"
    }
  ]
