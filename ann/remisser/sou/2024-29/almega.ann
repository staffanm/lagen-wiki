  "segments": [
    {
      "forarbete_id": "a13.5.7",
      "sentiment": 1.0,
      "quote": "Även om riktade stöd till forskning och utveckling i särskilda branscher bör undvikas så gör ett generellt och förutsägbart skatteavdrag till forskning och utveckling stor nytta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec715",
      "sentiment": 1.0,
      "quote": "Bristande interoperabilitet gör det svårare att såväl utföra sjukvård som att bedriva forskning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.5.1",
      "sentiment": 1.0,
      "quote": "Almega instämmer i behovet av att sänka den statliga inkomstskatten för att göra arbete och utbildning lönsammare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec85",
      "sentiment": -0.2,
      "quote": "Förslaget innebär ett otydligt, långtgående och rättsosäkert verktyg som riskerar att hämma företags investeringsvilja.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec77",
      "sentiment": 1.0,
      "quote": "Staten ska inte försöka välja vilka teknologier eller branscher som har de bästa framtidsutsikterna och gynna dem med subventioner eller riktade offentliga upphandlingar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.2.5",
      "sentiment": -1.0,
      "quote": "Att föreslå åtgärder som backar bandet utan konsekvensanalys är häpnadsväckande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.5.4",
      "sentiment": 1.0,
      "quote": "Att sjukvården får en digital infrastruktur med interoperabilitet är centralt.",
      "quote_type": "grund"
    }
  ]
