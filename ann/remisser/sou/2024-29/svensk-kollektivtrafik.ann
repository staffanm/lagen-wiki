  "segments": [
    {
      "forarbete_id": "a8.7.1",
      "sentiment": -0.2,
      "quote": "Svensk Kollektivtrafik delar inte Produktivitetskommissionens starka tro på samhällsekonomiska beräkningar på bland annat transportområdet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.2",
      "sentiment": -0.5,
      "quote": "Förslagen att ansvaret för att sätta kalkylräntan för statens investeringar i infrastruktur bör flyttas från Trafikverket till Riksgäldskontoret och baseras på statens upplåningskostnad samt en riskkomponent inte har inte analyserat i betänkandet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.3",
      "sentiment": 0.2,
      "quote": "det kommer att leda till att underhållsåtgärder i ännu högre utsträckning än i dag kommer att anslås till väginfrastruktur och till järnvägsstråk med hög andel tjänsteresenärer",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.4",
      "sentiment": 0.5,
      "quote": "Riksrevisionen har under de senaste fem åren gjort flera granskningar där Trafikverkets arbete kritiserats.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.5",
      "sentiment": -0.2,
      "quote": "Detta skulle i praktiken innebära att statens viktigaste myndighet på trafikområdet, Trafikverket, skulle överge de transportpolitiska målen som styrande mål.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.6",
      "sentiment": 1.0,
      "quote": "Många diskussioner kring att höja produktiviteten i upphandling och verksamhet faller i dag på att det saknas tillförlitliga data för att dra tydliga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.7",
      "sentiment": 1.0,
      "quote": "Detta föreslogs redan 2015 i betänkandet Koll på anläggningen (SOU 2015:42), men tyvärr har detta inte kommit på plats ännu.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.8",
      "sentiment": 0.5,
      "quote": "saknas det en analys av vilka upphandlingskrav som kan anses vara rimliga i betänkandet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.5.9",
