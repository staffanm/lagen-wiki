  "segments": [
    {
      "forarbete_id": "a5.6.2",
      "sentiment": 1.0,
      "quote": "Huvudsaken är att det införs ett samlat ansvar för utveckling och stöd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.6.3",
      "sentiment": 0.0,
      "quote": "Att föreskrifter inte ska få beslutas förrän ESV har godkänt konsekvensutredningen innebär fördröjningar och ytterligare administration som inte tillför något i sak.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec188",
      "sentiment": 0.2,
      "quote": "Likt ovan menar Arbetsförmedlingen emellertid att ESV bör fokusera på att ge stöd till myndigheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec189",
      "sentiment": 0.5,
      "quote": "Det kan emellertid noteras att det i många sammanhang kan vara svårt att genomföra effektutvärderingar med kontrollgrupper skapade t.ex. genom regelutformningen eller randomisering, då det kan innebära avsteg från likabehandling.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.2",
      "sentiment": 0.7,
      "quote": "Förslaget kan bidra till förbättrad kompetensförsörjning.",
