    },
    {
      "forarbete_id": "a5.6.3",
      "sentiment": -1.0,
      "quote": "Den föreslagna ordningen skulle innebära en administrativ börda som inte är rimlig och inte skulle vara genomförbar i praktiken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.6.5",
      "sentiment": -0.5,
      "quote": "I de fall det saknas behov av uppdatering ser myndigheten inte anledning till att det skulle göras med automatik var tredje år.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.6.8",
      "sentiment": -0.5,
      "quote": "Ett för starkt fokus på företagens intressen i konsekvensutredningar kan ha en negativ inverkan på barn och elevers rättigheter och på kvaliteten i skolväsendet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec405",
      "sentiment": 0.5,
      "quote": "Skolverket vill poängtera att om beslut om införandet av reformen fattas innan samtliga modeller, och konsekvenser av dessa, är systematiskt utvärderade så innebär det risker för möjligheterna att framgångsrikt följa planen för införande och ikraftträdande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec406",
      "sentiment": 0.0,
      "quote": "Skolverket delar målsättningen men ser behov av ytterligare utredningsarbete innan myndigheten kan ta ställning till förslag om att införa ett skolval som är gemensamt för alla aktuella huvudmän för valet till förskoleklass, grundskola och anpassad grundskola.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec407",
      "sentiment": 1.0,
      "quote": "Skolverket delar bedömningen om att det ska bli enklare för elever som i dag är obehöriga att studera på nationella gymnasiala yrkesprogram och hänvisar till att myndigheten i tidigare yttrande har tillstyrkt att den skarpa gränsen för godkänt tas bort, vilket medför en ändring av meritvärderingen.",
