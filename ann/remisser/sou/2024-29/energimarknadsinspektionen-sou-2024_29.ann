    {
      "forarbete_id": "sec256",
      "sentiment": 0.2,
      "quote": "Avseende förstärkning av befintlig ledning menar dock Ei att undantag inte nödvändigtvis är bra att tillåta i och med att förstärkning skulle kunna kräva att ledningsgatorna breddas.",
      "quote_type": "grund"
