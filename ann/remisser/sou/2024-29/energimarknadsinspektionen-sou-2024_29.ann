    {
      "forarbete_id": "a6.3.1",
      "sentiment": 0.5,
      "quote": "För att förslaget ska kunna tas vidare ser Ei att dessa juridiska utmaningar behöver lösas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec248",
      "sentiment": -0.5,
      "quote": "Ei anser att bildandet av en central tillstånds- och tillsynsmyndighet behöver utredas ytterligare för att Ei ska kunna ta ställning till hur detta påverkar dels tillståndsprocesserna för nätkoncession dels vilka konsekvenser det har på nätutbyggnaden i stort.",
      "quote_type": "grund"
