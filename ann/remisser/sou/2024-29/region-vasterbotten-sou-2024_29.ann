  "overall": {
    "sentiment": 0.2,
    "quote": "Region Västerbotten betonar behovet av att förenkla regelverk för företag, särskilt små och mikroföretag, utan att sänka kvalitetskraven.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a5.6.3",
      "sentiment": 1.0,
      "quote": "Syftet med regelförändringen ska vara att lätta regelbördan utan att sänka kvalitetskraven.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.1",
      "sentiment": 0.5,
      "quote": "Ett högre tempo får dock inte ske på bekostnad av rättssäkerhet, miljöhänsyn eller lokala demokratiska processer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec252",
      "sentiment": -0.5,
      "quote": "Kravet på tidigt besked gör också att kommunen kan tvingas fatta bindande beslut på ofullständiga underlag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.3",
      "sentiment": -1.0,
      "quote": "Medborgare och lokalt förtroendevalda har ett gemensamt ansvar för platsen där vi bor och kan, med lokalkännedom, väga samman miljö, bostäder och samhällsservice på ett sätt som ingen statlig eller regional myndighet kan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.4",
      "sentiment": 0.5,
      "quote": "Det regionala utvecklingsansvaret har fört inflytande över utvecklingsfrågorna närmare medborgarna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2.2",
      "sentiment": -0.2,
      "quote": "Regionen anser att det ligger i farans riktning att det höga reformtempo som råder inom utbildningsområdet i dagsläget skapar både fokusträngsel för skolans huvudmän samt riskerar ofullständiga och kostsamma implementeringar i utbildningsverksamheterna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.1",
      "sentiment": 1.0,
      "quote": "Att stänga ute motiverade elever på grund av bristande betyg i teoretiska ämnen som saknar direkt koppling till yrkesutövningen är ett slöseri med mänskliga resurser och motverkar produktivitetstillväxten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec408",
      "sentiment": -0.5,
      "quote": "Högskoleprovet är ett urvalsinstrument som mäter generell studiefärdighet, men det är en trubbig garant för specifika ämneskunskaper.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec411",
      "sentiment": -0.5,
      "quote": "Regionerna måste först få chansen att arbeta med reformen fullt ut och skapa goda strukturer för dimensionering utan ökad statlig styrning i uppbyggnadsfasen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec415",
      "sentiment": -0.5,
      "quote": "Risken är stor att vi skapar en extremt byråkratisk process där den enskilde studenten får svårt att överblicka sina ekonomiska förutsättningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec431",
      "sentiment": 0.2,
      "quote": "Regionen anser att utredningens ensidiga fokus på kärnämnen i den tillkommande tiden är för snävt och missar en unik möjlighet att adressera strukturella problem i övergången mellan skola och arbetsliv.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.4",
      "sentiment": -0.5,
      "quote": "Fokus bör ligga på att underlätta rörligheten för kvalificerad personal, inte på att skapa särsvenska krav som försvårar för internationella skolor och spetsutbildningar i regionen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.2.1",
      "sentiment": 1.0,
      "quote": "Nationellt metodstöd för detta behövs, främst i trygghetsskapande syfte.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.2.2",
      "sentiment": 0.5,
      "quote": "Regionen instämmer i att en regulatorisk sandlåda ger möjlighet att testa nya produkter, tjänster och policys i en begränsad skala och att detta kan medföra positiva effekter som ökad innovation och ökad effektivitet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec502",
      "sentiment": 0.5,
      "quote": "Regionen instämmer i att det finns behov och potential att utveckla arbetet med jämförelser och lärande av varandra.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec507",
      "sentiment": 1.0,
      "quote": "Förslaget bedöms leda till högre effektivitet och ge bättre förutsättningar för kommuner och regioner att planera sin verksamhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec512",
      "sentiment": 1.0,
      "quote": "Att kontinuerligt utvärdera om värdet av insamlade uppgifter överstiger kostnaden att samla in dem skulle leda till ökad effektivitet.",
      "quote_type": "grund"
    }
  ]
