  "segments": [
    {
      "forarbete_id": "a5.6.1",
      "sentiment": 1.0,
      "quote": "CSN delar Produktivitetskommissionens bedömning att det är av stor vikt med en välfungerande regelgivningsprocess för att det svenska samhället ska vara konkurrenskraftigt och produktivt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.6.3",
      "sentiment": -1.0,
      "quote": "Sammantaget anser dock CSN att det saknas tungt vägande skäl för att utvidga den granskande funktionen till att omfatta samtliga konsekvensutredningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.6.5",
      "sentiment": -1.0,
      "quote": "Detta eftersom en del effekter av nya föreskrifter inte låter sig utvärderas inom den tidsgräns som utredningen bedömer vara lämplig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.8.1",
      "sentiment": 1.0,
      "quote": "CSN instämmer i Produktivitetskommissionens bedömning att de föreslagna kraven på regelgivningsprocessen leder till ökade kostnader för myndigheterna, vilket behöver finansieras med nya anslagsmedel genom tilldelning i den årliga statsbudgetprocessen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.2",
      "sentiment": -0.5,
      "quote": "Det står dock klart att åtgärderna skulle innebära behov av kostsamma anpassningar i CSN:s IT-system och i delar också resurskrävande manuell hantering.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.4",
      "sentiment": -0.2,
      "quote": "Om en termin däremot ska kunna förlängas in i juli månad uppstår kostnader för CSN för såväl systemutveckling som för ökad administration.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.4",
      "sentiment": -0.2,
      "quote": "CSN konstaterar att detta då även kommer leda till ökade kostnader för CSN i form av ökad administration och ett ökat utflöde av studiehjälp.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.5.1",
      "sentiment": -0.5,
      "quote": "Förslagen gällande att prioritera de personer som bedöms ha störst nytta av stödet medför krav på omfattande förändringar av det maskinella handläggningsstöd som CSN har ägnat de senaste åren åt att utveckla.",
      "quote_type": "grund"
    }
  ]
