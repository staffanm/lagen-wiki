  "overall": {
    "sentiment": -0.7,
    "quote": "Delbetänkandet SOU 2026:2 är helt baserat på särbehandling och därmed odemokratiskt, då enbart partier som uppnått 1% i tidigare val eller med 10.000 underskrifter, ska få erhålla partivalsedlar.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a7.3.1",
      "sentiment": 0.8,
      "quote": "likabehandlingsprincipen att samtliga partier ska ha möjlighet att få ut sina valsedlar till Sveriges ﬂer än 6.000 vallokaler - en omöjlighet för små/nya partier.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec193",
      "sentiment": -0.8,
      "quote": "de utgör ett rimligt sätt för ett parti att kunna få synas på liknande sätt som de partier som automatiskt får kandidatvalsedlar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec192",
      "sentiment": -1.0,
      "quote": "att på detta sätt särbehandla små partier som ännu inte kommit upp i 1% av rösterna i tidigare val, genom att tvinga dem att samla in 10.000 namnunderskrifter, är en sådan uppenbar särbehandling att det inte går att acceptera.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec199",
      "sentiment": 0.8,
      "quote": "det är en odemokratisk särbehandling att små/nya partier tvingas själva distribuera sina valsedlar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec202",
      "sentiment": 0.8,
      "quote": "det är rimligt att samtliga partier, oaktat regeln om 1%, får sina valsedlar tryckta på statens bekostnad.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec202",
      "sentiment": 0.8,
      "quote": "det är rimligt att ett parti har stringent kontroll på sina listor och möjligheterna till ändringar/återkallande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec205",
      "sentiment": 1.0,
      "quote": "Vi tillstyrker att ett parti som uppfyller kraven på kandidatvalsedlar och önskar beställa extra valsedlar utöver det som staten distribuerar till vallokaler, får göra så och att partiet betalar för de extra valsedlarna.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec209",
      "sentiment": -0.8,
      "quote": "för små och nya partier skulle ett borttagande av partivalsedlarna innebära ytterligare begränsade möjligheter att uppmärksamma väljarna på att partiet ﬁnns och är valbart.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec212",
      "sentiment": 0.8,
      "quote": "det skulle innebära att principen om likabehandling upprätthålls.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5.4",
      "sentiment": -1.0,
      "quote": "Vi menar att fokus har ﬂyttats från demokratiaspekten till miljöaspekten på ett sätt som missgynnar små och nya partier.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec229",
      "sentiment": -0.8,
      "quote": "Den minskade möjligheten för små/nya partier att synas i vallokaler och i kampanjarbete är odemokratisk då den sker genom särbehandling.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec235",
      "sentiment": 0.8,
      "quote": "detta är exempel på en åtgärd som skulle underlätta för såväl partierna som väljarna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec239",
      "sentiment": 0.8,
      "quote": "Ett system med stängda listor säkrar processen mot oönskade kandidater.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec243",
      "sentiment": 0.5,
      "quote": "god framförhållning kan vara bra för alla parter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec251",
      "sentiment": 0.8,
      "quote": "det är oerhört viktigt att en så pass omfattande ändring i valsystemet som föreslås, också utvärderas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec256",
      "sentiment": -1.0,
      "quote": "Kravet på 10.000 namnunderskrifter är olämpligt då det: • Lägger en enorm administrativ börda på små/nya partier, då antalet namnunderskrifter är så högt att det motsvarar medlemsantal för de minsta riksdagspartierna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec261",
      "sentiment": -0.8,
      "quote": "förslaget innebär en försämring och ökad administrativ börda – i synnerhet för små/nya partier.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec264",
      "sentiment": -0.8,
      "quote": "förslaget bygger på särbehandling som missgynnar små/nya partier, ifall de vid omval vill ställa upp med kandidatvalsedlar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec267",
      "sentiment": 0.8,
      "quote": "det skulle ge små/nya partier möjlighet att ställa upp med kandidatvalsedlar vid ett extra val.",
