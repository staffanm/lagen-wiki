    },
    {
      "forarbete_id": "sec286",
      "sentiment": -0.8,
      "quote": "vi har helt avstyrkt delutlåtandets förslag om insamling av stödförklaringar då vi anser det ogenomförbart och processen bör anses som åsiktsregistrering.",
      "quote_type": "grund"
