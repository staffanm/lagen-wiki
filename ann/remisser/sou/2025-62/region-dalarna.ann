  "segments": [
    {
      "forarbete_id": "a3.4.2",
      "sentiment": 0.5,
      "quote": "Exempelvis är specialistutbildning i rättspsykiatri idag beroende av en flera månader lång praktikperiod vid Rättsmedicinalverket. Detta ger utmaningar både vad gäller ekonomi och vikarieförsörjning när regionen hanterar detta idag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.4.3",
      "sentiment": 0.2,
      "quote": "Region Dalarna håller inte med om det, utan anser att regionernas samverkansmodell för läkemedel är ändamålsenlig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.4.4",
      "sentiment": 0.5,
      "quote": "För att uppnå en hög och jämn vaccinationstäckning är nationell samordning fördelaktigt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.4.5",
      "sentiment": 0.8,
      "quote": "Vi är eniga i att ett utökat statligt ansvar är förenat med flera utmaningar och att en utredning därför bör tillsättas med uppdrag att närmare utreda formerna för detta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.4.6",
      "sentiment": -0.2,
      "quote": "Samtidigt saknas överväganden om hur det föreslagna statliga ansvaret för styrning och finansiering ska förhålla sig till lokala förutsättningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.4.7",
      "sentiment": 0.8,
      "quote": "Därför är ett statligt ägarskap av både ambulanshelikopterverksamheten och andra luftburna transporter en fråga om nationell säkerhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a2.2.7",
      "sentiment": -0.5,
      "quote": "Vi saknar konkreta förslag på hur staten ska ta ett större ansvar för att förbättra förutsättningarna för klinisk forskning och innovation i hälso- och sjukvården.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.5",
      "sentiment": 0.8,
      "quote": "Region Dalarna anser att generella statsbidrag ger bättre förutsättningar för effektiv resursanvändning och lokal anpassning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.6",
      "sentiment": 0.5,
      "quote": "Region Dalarna är eniga i denna bedömning och understryker vikten av att proportionalitetsprincipen enligt 14 kap. 3 § regeringsformen tillämpas i alla avvägningar mellan statlig styrning och den kommunala självstyrelsens utrymme.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.6.2",
      "sentiment": -0.2,
      "quote": "En ökad statlig finansiering kan innebära ett stärkt nationellt ansvar, men riskerar samtidigt att begränsa regionernas politiska handlingsfrihet.",
      "quote_type": "grund"
    }
  ]
