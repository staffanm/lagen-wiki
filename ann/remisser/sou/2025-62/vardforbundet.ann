  "segments": [
    {
      "forarbete_id": "a3.1",
      "sentiment": 1.0,
      "quote": "Vårdförbundet delar kommitténs bedömning att ett helt statligt huvudmannaskap inte har tillräckligt stöd i de underlag som belysts i utredningen och att riskerna med ett sådant system är betydande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.4.2",
      "sentiment": 1.0,
      "quote": "Bristen på bland annat sjuksköterskor, barnmorskor, biomedicinska analytiker och röntgensjuksköterskor är akut och hotar hälso- och sjukvårdens kvalitet och säkerhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.4.3",
      "sentiment": 1.0,
      "quote": "För att utvecklingen ska ske på ett etiskt och likvärdigt sätt krävs att tillgången till läkemedel inte skiljer sig åt mellan olika regioner.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.4.4",
      "sentiment": 1.0,
      "quote": "Vårdförbundet bedömer att både när det gäller vaccinationer och screening bör utgångpunkten i normalfallet vara att tillgången inte ska bero på var i Sverige en person är bosatt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.4.5",
      "sentiment": 1.0,
      "quote": "Vårdförbundet bedömer att både när det gäller vaccinationer och screening bör utgångpunkten i normalfallet vara att tillgången inte ska bero på var i Sverige en person är bosatt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.4.6",
      "sentiment": 1.0,
      "quote": "Vi ser positivt på förslaget att staten som ett första steg tar över finansieringsansvaret genom att lämna ersättning till regionerna för patienter som vårdas inom rättspsykiatrin.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.4.7",
      "sentiment": 0.2,
      "quote": "Den nuvarande ordningen, där ansvaret i huvudsak vilar på enskilda regioner, är inte tillräcklig för att säkerställa en robust och jämlik tillgång till ambulans i alla delar av landet och i alla beredskapslägen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec119",
      "sentiment": 1.0,
      "quote": "Vårdförbundet håller med kommittén (och flera andra utredningar) som anser att generella statsbidrag bör utgöra grunden för statens finansiering av välfärden, då de ger regioner och kommuner större handlingsutrymme att möta lokala behov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec123",
      "sentiment": 1.0,
      "quote": "Vårdförbundet är därför positiv till att som utredningen föreslår arbeta med tydligare normering och färre styrformer.",
