  "segments": [
    {
      "forarbete_id": "a3.1",
      "sentiment": 0.8,
      "quote": "När kommittén konstaterar att sådana samband inte kan fastställas utifrån befintliga underlag, instämmer vi i bedömningen att ett helt statligt huvudmannaskap inte är motiverat.",
