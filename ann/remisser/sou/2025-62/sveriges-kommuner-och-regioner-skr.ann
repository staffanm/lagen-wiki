  "segments": [
    {
      "forarbete_id": "a3.1",
      "sentiment": 1.0,
      "quote": "En organisationsförändring kommer inte att leda till att vårdpersonalen blir fler, att vårdköer kortas eller att vården och hälsan blir mer jämlik mellan olika grupper och mellan olika delar av landet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.2",
      "sentiment": 1.0,
      "quote": "Om staten skulle bli huvudman för exempelvis den specialiserade hälso- och sjukvården eller primärvården skulle detta i praktiken innebära komplexa gränsdragningar gentemot andra delar av hälso- och sjukvården som regionerna är fortsatt huvudmän för.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.4.2",
      "sentiment": 0.8,
      "quote": "SKR välkomnar därför ett förstärkt samarbete för att skapa stabilitet och jämlikhet i tillgången till vårdens kompetenser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.4.3",
      "sentiment": -0.2,
      "quote": "SKR ser en fara i att staten skulle vidta åtgärder på kort sikt rörande vissa områden. Det skulle riskera felaktiga prioriteringar och inte ge de långsiktiga förutsättningar som behövs för förbundets medlemmar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.4.4",
      "sentiment": 0.5,
      "quote": "Staten skulle bland annat kunna ta ett större ansvar för hälsoekonomisk värdering, omfattning och finansiering för att underlätta ett ordnat och jämlikt införande av nya vaccinationer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.4.5",
      "sentiment": 0.8,
      "quote": "Screeningrådet blir här en viktig nod för att samordna screeningverksamhet.",
