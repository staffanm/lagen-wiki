    },
    {
      "forarbete_id": "a3.4.3",
      "sentiment": 1.0,
      "quote": "Det militära försvaret är i hög grad beroende av att det finns tillgång till och beredskap avseende anskaffandet av och tillgång till läkemedel.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.4.4",
      "sentiment": 1.0,
      "quote": "Att Försvarsmaktens personal har enhetligt vaccinationsskydd bedöms fördelaktigt både avseende arbetsmiljöansvar för anställd personal och i rekrytering av ny personal, i synnerhet i kris och krig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.4.5",
      "sentiment": 1.0,
      "quote": "Att Försvarsmaktens personal oavsett bostadsort ingår i samma screeningsprogram bedöms fördelaktigt för en övergripande bild av personalens aktuella hälsa, i synnerhet i kris och krig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.4.6",
      "sentiment": 0.0,
      "quote": "Försvarsmakten har inga synpunkter att lämna avseende Vårdansvarskommitténs betänkande.",
