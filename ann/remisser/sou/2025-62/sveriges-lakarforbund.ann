  "overall": {
    "sentiment": -0.5,
    "quote": "Sveriges Läkarförbund delar kommitténs majoritets bedömning att svensk sjukvård behöver förändras och förbättras, men att de förbättringar som eventuellt skulle kunna nås genom ett helt statligt huvudmannaskap är för små och för osäkra för att motivera de stora risker och kostnader som förändringen skulle innebära.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a1.4",
      "sentiment": 1.0,
      "quote": "De analytiska begreppen systemansvar, finansieringsansvar, tillhandahållaransvar och verksamhetsansvar har bidragit till att fördjupa diskussionen och möjliggjort mer välgrundade slutsatser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.5",
      "sentiment": 0.2,
      "quote": "Läkarförbundet önskar att kommittén haft ett bredare och mer förutsättningslöst uppdrag, som till exempel även omfattat kommunal hälso- och sjukvård och som alternativ till statligt huvudmannaskap också kunnat överväga en regionreform.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a2.2",
      "sentiment": 0.5,
      "quote": "Men den yttre effektiviteten, att göra rätt saker, är minst lika viktigt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.1",
      "sentiment": -1.0,
      "quote": "En huvudmannaskapsförändring skulle kräva all reformkraft på hälso- och sjukvårdsområdet under de närmaste två till tre mandatperioderna – utan att säkert leda till förbättringar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.2",
      "sentiment": -1.0,
      "quote": "Ett delvis statligt huvudmannaskap kombinerar svagheterna från dagens system och ett helt statligt ansvar, men utan att tillföra deras respektive styrkor.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.3",
      "sentiment": 0.0,
      "quote": "Hälso- och sjukvården är nästan tio gånger större än den statliga verksamhet som idag är störst, Polisen, och det handlar i stor utsträckning om andra professioner och personalgrupper än de som idag är statsanställda.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.4",
      "sentiment": 0.8,
      "quote": "Staten bör också ta ett utökat finansieringsansvar, för att nå större jämlikhet mellan regioner och för att staten har bättre förutsättningar än enskilda regioner att möta konjunktursvängningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.4.2",
      "sentiment": 0.5,
      "quote": "Ett system där 21 regioner, var för sig, ska säkra sin egen kompetensförsörjning fungerar uppenbart inte.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.4.3",
      "sentiment": 1.0,
      "quote": "Det finns goda skäl för att staten bör ta ett större ansvar för styrning och finansiering, inte minst av jämlikhetsskäl.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.5",
      "sentiment": 0.5,
      "quote": "Kommittén utvecklar dock inte hur styrningen ska bli mer långsiktig.",
      "quote_type": "grund"
    }
  ]
