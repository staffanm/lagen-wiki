    },
    {
      "forarbete_id": "a3.4.3",
      "sentiment": 0.5,
      "quote": "Storumans kommun ställer sig bakom förslaget att verka för ett utökat statligt ansvar bland annat gällande finansieringen av läkemedel, för att minska omotiverade geografiska skillnader i läkemedelstillgång.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.4.4",
      "sentiment": 0.2,
      "quote": "Därav är det viktigt att tydliggöra ansvaret med hänsyn till den kommunala hälso-och sjukvårdens utförande.",
