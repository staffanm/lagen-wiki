  "segments": [
    {
      "forarbete_id": "a3.1",
      "sentiment": 0.8,
      "quote": "Det kan bland annat leda till en centraliserad styrning som medför längre avstånd till de ansvariga politikerna både för vårdens medarbetare och den enskilda patienten.",
