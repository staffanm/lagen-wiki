    },
    {
      "forarbete_id": "a3.5",
      "sentiment": 0.8,
      "quote": "Dock har det även lett till det som kommittén pekar på, en splittrad vård utan statlig styrning med olika förutsättningar i olika regioner samtidigt som budgetmedlen inte ”byggts in” i organisationerna för att ge hållbara förändringar på sikt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.4.2",
      "sentiment": 0.8,
      "quote": "Det krävs för att bland annat stärka möjligheterna till forskning för alla professioner och för att utveckla den kompetens som behövs i en komplex vårdverklighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.4.3",
      "sentiment": 0.8,
      "quote": "Det är oacceptabelt att det finns stora variationer kring tillgång, kostnader och tillgänglighet av läkemedel.",
