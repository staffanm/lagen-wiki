    },
    {
      "forarbete_id": "a13.3.9",
      "sentiment": -0.4,
      "quote": "Skolverksamhet bygger på ett förtroendefullt samarbete med barn, elever och vårdnadshavare, något som den har typen av rapportering kan tänkas underminera.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.3.6",
      "sentiment": -0.5,
      "quote": "Troligen kommer detta innebära ökade kostnader för skolverksamheterna då it-leverantörerna vet att det finns lagkrav som driver fram behovet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.4.17",
      "sentiment": -0.6,
      "quote": "Dessvärre har vi dåliga erfarenheter av Skolverkets digitala förmåga gällande nationella prov och e-tjänsten för statsbidrag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.3.4",
      "sentiment": -0.5,
      "quote": "Förslaget ligger inte i linje med att den administrativa bördan i skolan ska minska utifrån vad som är beskrivet i ovanstående punkter.",
