  "segments": [
    {
      "forarbete_id": "a9.4.1",
      "sentiment": 0.8,
      "quote": "En fördel med införandet är att ovannämnda myndigheter skulle få en ökad kunskap avseende barn i förskolan, där det idag inte finns en skyldighet att rapportera orsaken till att ett barn avslutar sin förskoleplacering.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec462",
      "sentiment": 0.2,
      "quote": "Här ser nämnden att registret kan vara just en indikator, men att det krävs ett nära arbete med individen för att se frånvaroorsakerna och ge stöd efter behov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2.5",
      "sentiment": -0.5,
      "quote": "Det kommer inte att kunna skilja på giltig och ogiltig frånvaro. Detta försvårar möjligheten att dra tydliga slutsatser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.4.10",
      "sentiment": 0.8,
      "quote": "Förslagen på sökbegränsningar, åtskiljande av barnets eller elevens placering från övriga uppgifter, regelbundna kontroller samt årlig radering av uppgifterna är positiva.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.4.16",
      "sentiment": 0.8,
      "quote": "Även föreslagna förändringar i offentlighets- och sekretesslagen är viktiga.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a9.4.8",
      "sentiment": -0.2,
      "quote": "En riskfaktor är att flera olika system finns och att samtliga dessa måste kunna kommunicera med Skolverkets system för att en automatisk överföring ska kunna ske.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec642",
      "sentiment": -0.5,
      "quote": "Detta kan innebära såväl tekniska som administrativa förändringar, vilket kan leda till ökade kostnader.",
