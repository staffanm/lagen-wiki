    {
      "forarbete_id": "sec479",
      "sentiment": -0.5,
      "quote": "Utredningen saknar en beskrivning av hur utbildningsanordnare ska hantera korrigeringar av redan rapporterade uppgifter samt hur dessa förändringar ska hanteras i det nationella frånvaroregistret.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec424",
      "sentiment": -0.5,
      "quote": "Utredningen fokuserar uteslutande på elever som är inskrivna och har schema vid en skolenhet.",
      "quote_type": "grund"
