  "segments": [
    {
      "forarbete_id": "a13.3.8",
      "sentiment": -0.5,
      "quote": "Utredningens bedömning av de positiva konsekvenserna på lokal nivå bedöms vara överskattade, särskilt gällande effekter för enskilda barn och elever.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec640",
      "sentiment": -0.5,
      "quote": "Göteborgs Stad bedömer att införandet av ett nationellt frånvaroregister kan innebära ökade kostnader för kommunen i att utveckla system och rutiner för att rapportera in uppgifter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec633",
      "sentiment": -0.5,
      "quote": "Att minska medel avsedda för skolsociala team riskerar att motverka ett av utredningens syften, att öka närvaro i skolan, eftersom teamen är en central del i närvarofrämjande insatser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec480",
      "sentiment": -0.2,
      "quote": "För att kunna identifiera och bryta komplexa frånvaromönster krävs dock ett längre bevarande av uppgifterna än förslaget på ett år.",
