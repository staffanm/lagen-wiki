  "overall": {
    "sentiment": 1.0,
    "quote": "SPF Seniorerna stöder flera av utredningens förslag.",
    "quote_type": "standpunkt"
  },
  "segments": [
    {
      "forarbete_id": "a5.5.6",
      "sentiment": 1.0,
      "quote": "En förenkling av ansökningsprocessen för bostadstillägg skulle kunna minska risken för återkrav samt säkerställa att fler pensionärer både får rätt stöd och får det från första början.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.6",
      "sentiment": 1.0,
      "quote": "SPF Seniorerna stöder utredningens förslag att Försäkringskassan och Pensionsmyndigheten ska få behandla personuppgifter - om det är nödvändigt för att administrera socialförsäkringen och andra förmåner och ersättningar som enligt lag eller förordning ska administreras av myndigheterna samt - för dataanalys och urval i syfte att förebygga, motverka och upptäcka fel i den verksamheten.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.6.1",
      "sentiment": 1.0,
      "quote": "SPF Seniorerna stöder utredningens förslag att Försäkringskassans och Pensionsmyndighetens behandling av personuppgifter för att göra dataanalyser och urval i syfte att förebygga, förhindra och upptäcka fel inom sina verksamheter ska tydliggöras.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.7.2",
      "sentiment": 1.0,
      "quote": "SPF Seniorerna stöder utredningens förslag att det ska införas en bestämmelse om att Försäkringskassan och Pensionsmyndigheten får behandla personuppgifter om det är nödvändigt för att vidta förebyggande åtgärder för att kunna bedöma eller fastställa förmåner och ersättningar.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.9.1",
      "sentiment": 1.0,
      "quote": "SPF Seniorerna stöder utredningens förslag att det ska föreskrivas att Försäkringskassan och Pensionsmyndigheten vid dataanalys och urval får behandla personuppgifter som respektive myndighet förfogar över eller samlar in till följd av verksamheten samt uppgifter som lämnas till myndigheterna för att fullgöra uppgiftslämnande som sker enligt lag eller förordning.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.9.2",
      "sentiment": 1.0,
      "quote": "SPF Seniorerna stöder utredningens förslag att det ska införas bestämmelser om att Försäkringskassan och Pensionsmyndigheten vid personuppgiftsbehandling för att göra dataanalys och urval ska dokumentera avvägningen mellan det avsedda resultatet med åtgärden och intrånget i enskildas personliga integritet samt de metoder och sökbegrepp som används för att ta fram urval.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.10.4",
      "sentiment": 1.0,
      "quote": "SPF Seniorerna stöder utredningens förslag att det ska föreskrivas att sekretess gäller vid dataanalyser och urval hos Försäkringskassans och Pensionsmyndighetens verksamhet som avses i 114 kap. 8 § socialförsäkringsbalken, för uppgift om en enskilds personliga eller ekonomiska förhållanden.",
      "quote_type": "standpunkt"
    }
  ]
}