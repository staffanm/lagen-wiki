  "overall": {
    "sentiment": 0.2,
    "quote": "Pensionsmyndigheten lämnar följande synpunkter på de delar av förslagen som berör myndighetens verksamhet.",
    "quote_type": "standpunkt"
  },
  "segments": [
    {
      "forarbete_id": "a5.4.6",
      "sentiment": 0.5,
      "quote": "Tillgång till uppgifter via Mekanismen skulle innebära att fler ärenden blir rätt från början och att felaktiga utbetalningar därmed förhindras samt att myndighetens handläggning effektiviseras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.4.7",
      "sentiment": -0.5,
      "quote": "Pensionsmyndigheten anser att utredningens beskrivning av myndighetens arbetssätt inte är helt rättvisande och vill därför framföra följande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.5.4",
      "sentiment": -0.2,
      "quote": "Det är dock inte rättsligt klarlagt att en schabloniserad bostadskostnadsberäkning i sin helhet ryms inom myndighetens nuvarande bemyndigande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.5.6",
      "sentiment": 1.0,
      "quote": "En schabloniserad bostadskostnadsberäkning inom bostadstillägg kan minska felaktiga utbetalningar, möjliggöra en betydande effektivisering för myndigheten, samtidigt som det förenklar för den enskilde.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1.1",
      "sentiment": 0.0,
      "quote": "Upplysningsvis kan nämnas att Pensionsmyndigheten och Migrationsverket har inlett diskussioner om att Migrationsverket ska lämna impulser till Pensionsmyndigheten vid förändringar gällande enskildas uppehållstillstånd.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": -0.2,
      "quote": "Pensionsmyndigheten anser det tveksamt om den insamling som sker av sådana uppgifter ingår i 114 kap. 2 § tillämpningsområde i bestämmelsens nuvarande utformning",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.6",
      "sentiment": 1.0,
      "quote": "Genom att, i den mån det är möjligt, utforma myndigheternas respektive registerlagstiftning på ett enhetligt vis ökar förutsättningarna för användning av uppgifter såväl inom myndigheten som vid informationsutbyte mellan myndigheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7",
      "sentiment": -1.0,
      "quote": "Dock skulle inte myndigheten få samma flexibilitet och möjlighet att svara mot framtida uppdrag och förutsättningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.8",
      "sentiment": 0.5,
      "quote": "Förslaget svarar mot myndighetens behov av att kunna behandla personuppgifter som indirekt kan röja känsliga personuppgifter i myndighetens arbete med att förebygga och förhindra felaktiga utbetalningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.10",
      "sentiment": -0.2,
      "quote": "Det nuvarande sekretessregelverket är komplext och svårtillämpat vilket begränsar informationsutbytet mellan myndigheter.",
      "quote_type": "grund"
    }
  ]
