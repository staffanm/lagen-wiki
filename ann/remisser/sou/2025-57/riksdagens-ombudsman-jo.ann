  "overall": {
    "sentiment": 0.0,
    "quote": "Jag ser därför positivt på att ett förslag till en reglering tagits fram, som till stora delar är avsedd för detta.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a7.9.3",
      "sentiment": -0.2,
      "quote": "Militär medverkan i polisiär verksamhet, som kan innebära användning av våld och tvångsåtgärder mot enskilda, ska inte få förekomma annat än i särskilda undantagsfall som avviker från det normala.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.10.4",
      "sentiment": -0.5,
      "quote": "Det är viktigt att befogenheter till tvångsmedelsanvändning inte går längre än vad som motiveras av den aktuella situationen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.10.8",
      "sentiment": -0.5,
      "quote": "I betänkandet saknas en tydlig vägledning för när det kan vara fråga om en sådan brådskande situation.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec379",
      "sentiment": -0.5,
      "quote": "Enligt min mening framstår det som naturligt att det i lag anges en tidsgräns för stödet, inte minst som det är avsett att lämnas i situationer som är av undantagskaraktär.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.10.6",
      "sentiment": -0.2,
      "quote": "Det måste ställas höga krav på att den som får befogenhet att utöva våld och tvångsåtgärder mot enskilda har rätt kompetens för uppgiften.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.10",
      "sentiment": -1.0,
      "quote": "Maktutövning som innebär begränsningar i enskildas grundläggande fri- och rättigheter kräver stöd i lag (se 2 kap. 20 § regeringsformen).",
      "quote_type": "grund"
    }
  ]
