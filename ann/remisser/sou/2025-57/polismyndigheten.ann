  "segments": [
    {
      "forarbete_id": "a5.13",
      "sentiment": 0.8,
      "quote": "Fördelarna med att hela polisen är civil överväger även alternativet att en avgränsad del av polisen har kombattantstatus såväl som stridande uppgifter.",
