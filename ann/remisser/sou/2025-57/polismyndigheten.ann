    },
    {
      "forarbete_id": "a6.9.3",
      "sentiment": 1.0,
      "quote": "Polismyndigheten tillstyrker däremot utredningens förslag om att Säkerhetspolisen ska få besluta om att alternativa ledningsplatser tillfälligt ska vara skyddsobjekt.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.9.5",
      "sentiment": 0.8,
      "quote": "Det behöver göras en prioritering av skydds- och bevakningsuppgifter utifrån tillgängliga resurser inom polisen och bevakningsbranschen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.10",
      "sentiment": 1.0,
      "quote": "Myndigheten konstaterar att förslagen tillgodoser de behov som myndigheten framfört i hemställan till regeringen den 10 januari 2020.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.10.8",
      "sentiment": -0.5,
      "quote": "omständigheten att kostnaden vid enskilda insatser är för hög och att osäkerheten kring kostnaden är för stor kan påverka Polismyndighetens benägenhet att söka stöd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.11",
      "sentiment": 0.8,
      "quote": "Sammantaget bör förslagen medföra att Polismyndigheten ges en ökad möjlighet att erhålla stöd från Försvarsmakten inom fler områden på sätt som regelverket syftar till.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.12",
      "sentiment": 0.2,
      "quote": "Polismyndigheten anser dock att utredningen i sin analys i alltför stor utsträckning förbiser myndighetens behov av helikoptertransporter som ett integrerat led i brottsbekämpningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.12.4",
      "sentiment": -0.8,
      "quote": "Sammanfattningsvis anser Polismyndigheten att utredningens förslag om åtgärder på kort sikt avseende helikoptertransportförmågan varken adresserar eller omhändertar det egentliga problemet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.12.5",
      "sentiment": 0.8,
      "quote": "Myndigheten bedömer dock att synsättet att uppnå synergieffekter genom ett gemensamt införskaffande av system, underhåll och ev. sambaseringar inom ramen för den statliga civila helikopterverksamheten är positivt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.6",
      "sentiment": 0.5,
      "quote": "Polismyndigheten instämmer i bedömningen att en polisiär förstärkningsresurs kan vara ett ändamålsenligt sätt att stärka polisens beredskap vid höjd beredskap och krig, under förutsättning att den är bemannad med personer som har relevant kompetens.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.6.2",
      "sentiment": -0.5,
      "quote": "Utredningens förslag i denna del riskerar att allvarligt påverka tillväxten och därmed möjligheten att fullgöra uppdraget.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.6.3",
      "sentiment": 0.8,
      "quote": "En flexibel organisation är en av de mest grundläggande förutsättningarna för att polisverksamheten ska kunna bedrivas effektivt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.6.3",
      "sentiment": -0.2,
      "quote": "Ytterligare överväganden bör göras innan begreppet införs för att öka attraktionen och tydligheten i vad uppdraget innebär.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.10.1",
      "sentiment": 1.0,
      "quote": "Det är angeläget att nuvarande reglering moderniseras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.11.1",
      "sentiment": -0.2,
      "quote": "I en aktiv samverkansfas kan dock – enligt Polismyndighetens bedömning – kontroller med stöd av den gränsnära lagen utgöra ett viktigt verktyg för att upprätthålla Sveriges säkerhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.11.2",
      "sentiment": 0.8,
      "quote": "Polismyndigheten instämmer i att det finns ett stort behov av en reglering som på ett tydligare sätt än idag ger parterna bättre förutsättningar för att använda och planera Kustbevakningens resurser på ett ändamålsenligt sätt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.11.3",
      "sentiment": 0.2,
      "quote": "Vilket ansvar en sådan chef ska ha kan enligt Polismyndigheten med fördel förtydligas i den fortsatta lagstiftningsprocessen.",
