  },
  "overall": {
    "sentiment": 0.5,
    "quote": "Länsstyrelsen välkomnar möjligheten att lämna synpunkter på utredningens betänkande och har i sitt yttrande valt att fokusera på de förslag som tydligt berör det egna ansvarsområdet.",
    "quote_type": "standpunkt"
  },
  "segments": [
    {
      "forarbete_id": "a5.13",
      "sentiment": 1.0,
      "quote": "En civil folkrättslig status skulle underlätta för verksamhet vid höjd beredskap som förutsätter ett tätt samarbete mellan Polismyndigheten och andra civila myndigheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.4",
      "sentiment": 1.0,
      "quote": "Detta är fullt rimligt, eftersom länsstyrelsens mandat att meddela föreskrifter till ledning för Polismyndighetens verksamhet i länet (9 § i sagda kungörelse) länge har varit obsolet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.4",
      "sentiment": 0.0,
      "quote": "Frågan bör utredas vidare.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.9.3",
      "sentiment": 0.5,
      "quote": "Om Säkerhetspolisen får en sådan möjlighet skulle det kunna avlasta länsstyrelsen i det aktuella länet, som slipper en brådskande uppgift med särskilda hanteringskrav (framför allt kan säkerhetsskyddskänsliga uppgifter väntas förekomma).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.9.5",
      "sentiment": 1.0,
      "quote": "Som utredningen konstaterar är det viktigt att prioritering av bevakningsresurser sker utifrån tydliga grunder.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec377",
      "sentiment": -0.2,
      "quote": "Det bör övervägas om denna begränsning bör göras absolut och explicit i den föreslagna lagen om Försvarsmaktens stöd till polisiär verksamhet i särskilda fall.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.10",
      "sentiment": -0.2,
      "quote": "Om det regelmässigt får anses olämpligt att nyttja Försvarsmaktens stöd under pågående krig borde det därför gå att uttryckligen exkludera brotten i lagen (2014:406) om straff för vissa internationella brott från begreppet ”annan brottslig verksamhet” (2 § 2. i den föreslagna lagen om Försvarsmaktens stöd till polisiär verksamhet i särskilda fall).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.11.3",
      "sentiment": 1.0,
      "quote": "då en sådan förändring skulle innebära en organisering som i högre grad följer ansvars- och likhetsprincipen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.11.4",
      "sentiment": -0.2,
      "quote": "Länsstyrelsen ser därför att det, vid aktiv samverkan, bör finnas en rapporteringsskyldighet gentemot respektive länsstyrelse avseende sådant som rör det egna länet.",
      "quote_type": "grund"
    }
  ]
}