  "overall": {
    "sentiment": 0.0,
    "quote": "FOI:s synpunkter utgår från ansvarsprincipen och ett totalförsvarsperspektiv.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a1.4",
      "sentiment": 1.0,
      "quote": "Det är välkommet att utredningen föreslår en ordning som är folkrättsligt korrekt, följer ansvarsprincipen samt bidrar till både folkrättslig tydlighet och organisatorisk klarhet i totalförsvaret.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.1",
      "sentiment": -0.5,
      "quote": "Utifrån dessa erfarenheter och slutsatser framstår det för FOI som svårt att förstå varför lagkraven på utbildning och övningar tas bort, samtidigt som Försvarsmakten föreslås kunna bistå polisen i fler uppdrag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.9",
      "sentiment": 1.0,
      "quote": "FOI ansluter sig till utredningens slutsatser om helikoptertillgång och helikopteranvändning i staten.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a9.11.7",
      "sentiment": -0.5,
      "quote": "Med tanke på att åtgärden kan beröra ett stort antal personer som det inte finns någon brottsmisstanke mot bedömer vi att det inte är försvarbart att ta bort rättegångsbalkens krav på vittne samt att kroppsvisitationen/kroppsbesiktningen genomförs inomhus.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.11.7",
      "sentiment": -0.2,
      "quote": "Vi bedömer dock att formuleringen att beslut om särskild kontroll får fattas om det finns ”anledning att anta” att en eller flera personer har begått eller står i begrepp att begå ett brott behöver preciseras, eftersom formuleringen ”anledning att anta” sätter en alltför låg tröskel.",
      "quote_type": "grund"
    }
  ]
