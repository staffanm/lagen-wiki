  "overall": {
    "sentiment": 0.5,
    "quote": "Ett klargörande av rollerna och en revidering av befintliga ramverk är viktiga förutsättningar för en väl fungerande samverkan mellan myndigheter och andra aktörer är en viktig del för att möta ett förändrat säkerhetsläge.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a5.13",
      "sentiment": 1.0,
      "quote": "Mot bakgrund av folkrättens distinktionsprincip är nuvarande lösning problematisk då polisers kombattantstatus riskerar att försätta civila för en stor risk i de fall att polisen bistår under exempelvis en utrymning och inkvartering.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.4",
      "sentiment": 1.0,
      "quote": "Länsstyrelsens mandat att meddela föreskrifter till ledning för Polismyndighetens verksamhet i länet (9 § i sagda kungörelse) är inte längre ändamålsenligt då länsstyrelsen inte längre är högsta polismyndighet i länet och enligt den föreslagna lagen inte längre ska ansvara för operativ ledning av gränskontrollverksamheterna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.4",
      "sentiment": -0.2,
      "quote": "Med hänsyn till distinktionsprincipen anser länsstyrelsen att detta är problematiskt på samma sätt som att polisers kombattantstatus har ansetts vara problematisk.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.2",
      "sentiment": 0.5,
      "quote": "Övrig samverkan mellan gränsövervakningsansvariga myndigheter och länsstyrelserna får dock inte uteslutas bara för att den föreslagna lagen träder i kraft.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5",
      "sentiment": -0.5,
      "quote": "Avsaknaden av uppföljning medför att brister riskerar att förbli oupptäckta, exempelvis undermålig skyltning, ändrade ägar- eller nyttjanderättsförhållanden samt ombyggnationer som förändrar objektets gränser eller utformning i strid med skyddsobjektsbeslutet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5",
      "sentiment": 0.2,
      "quote": "Syftet är att säkerställa en likformig och effektiv samverkan mellan länsstyrelse och polis på länsnivå.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5",
      "sentiment": 0.2,
      "quote": "För att säkerställa enhetlighet i hela riket är länsstyrelsens förslag är att Polismyndigheten ges rätten att föreskriva om vad som ska gälla för skyddsobjektsförteckningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.9.3",
      "sentiment": 0.5,
      "quote": "Dock riskerar länsstyrelsen förlora överblicken över vilka skyddsobjekt som finns i länet om inte Säkerhetspolisen underrättar länsstyrelsen om nya beslut.",
      "quote_type": "grund"
    }
  ]
