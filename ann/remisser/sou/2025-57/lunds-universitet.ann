  "segments": [
    {
      "forarbete_id": "a5.3",
      "sentiment": -0.2,
      "quote": "den vidföljande diskussionen om att den humanitära rätten anses generellt, i egenskap av lex specialis, ha företräde framför regler om mänskliga rättigheter om regelverken är oförenliga, kan inte tas för given",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.13",
      "sentiment": 1.0,
      "quote": "Betänkandets slutsatser om att det inte är lämpligt att ha en ordning som innebär att polismän förväntas växla mellan uppgifter av civil och militär karaktär är därför välkomna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec36",
      "sentiment": -0.2,
      "quote": "Det måste antas att polisen kan klara så gott som alla polisiära frågor inom ett visst särskilt geografiskt område i landet men kanske inte kan antas kunna göra detsamma i hela riket samtidigt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec37",
      "sentiment": -0.2,
      "quote": "I sammanhanget kan det ifrågasättas om det finns erforderlig kompetens inom försvaret att axla polisiära uppdrag, 8 § till trots.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.5",
      "sentiment": 0.5,
      "quote": "Fakultetsstyrelsen har inga invändningar mot förslaget utöver vad som nämnts ovan angående kompetensen att axla polisiära uppdrag.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a1.8",
      "sentiment": -0.2,
      "quote": "oklarheter annars riskerar att minska den potentiella effektiviteten i insatsen på grund av kostnadsskäl.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.18",
      "sentiment": -0.2,
      "quote": "försvarets personal tillhör en mängd olika kategorier och riskbegreppet dessutom är diffust.",
      "quote_type": "grund"
    }
  ]
