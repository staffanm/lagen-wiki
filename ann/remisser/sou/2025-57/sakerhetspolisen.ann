    },
    {
      "forarbete_id": "a6.9.2",
      "sentiment": -0.5,
      "quote": "Att införa en möjlighet att besluta om skyddsobjekt i de aktuella fallen skulle ge en ökad flexibilitet när det gäller att snabbt öka skyddet runt en skyddspersons bostad eller annan plats där skyddspersonen vistas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.10",
      "sentiment": 0.5,
      "quote": "Säkerhetspolisen anser dock att rekvisitet ”allvarlig fara för Sveriges säkerhet” i 2 § 2 den föreslagna lagen är ett för högt ställt krav.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.11",
      "sentiment": 1.0,
      "quote": "Ändringen innebär att möjligheten att använda stödförordningen i polisiär verksamhet förbättras vilket höjer den polisiära beredskapen.",
