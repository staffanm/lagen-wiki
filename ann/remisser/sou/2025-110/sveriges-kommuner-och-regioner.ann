  "segments": [
    {
      "forarbete_id": "a9.7",
      "sentiment": 1.0,
      "quote": "Kommuner och regioner är självständiga organ som sköter sina egna förhandlingar och vid behov av rådgivning kan de vända sig till SKR.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.10",
      "sentiment": 1.0,
      "quote": "Här talar bl.a. det förhållandet att många vattentorn är skyddsobjekt men framförallt vattentornens betydelse för vattenförsörjningen och hela totalförsvaret emot en utvidgning",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.5",
      "sentiment": 1.0,
      "quote": "Om ett offentligt organ tvingas samla stora mängder information om sin infrastruktur för att kunna uppfylla sin informationsskyldighet ökar även risken att informationen kan missbrukas av antagonister.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.3.2",
      "sentiment": 1.0,
      "quote": "SKR delar utredningens bedömning att s.k. kommunala grävtillstånd och markavtal liksom andra typer av civilrättsliga medgivande och överenskommelser inte utgör tillstånd i GIAs mening.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a14.1",
      "sentiment": 1.0,
      "quote": "Ett införande av tyst godkännande på den typ av tillstånd som omfattas av GIA, skulle inte bara riskera att beröva berörda sakägare deras grundlagsskyddade rättigheter utan även ge upphov till stor rättsosäkerhet vad avser innebörden av själva tillståndet och de villkor på vilka det beviljats.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.2",
      "sentiment": 1.0,
      "quote": "PTS har sedan tidigare erfarenhet av att bygga upp och hantera liknande elektroniska tjänster, t.ex. Utbyggnadsportalen och Ledningskollen och bör kunna nyttja dessa erfarenheter för att skapa en säker men även kostnadseffektiv funktion.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.3",
      "sentiment": 1.0,
      "quote": "Det är av avgörande betydelse att all den information om offentligt och privat ägd infrastruktur som omfattas av informationsskyldigheten i GIA inte samlas i en databas utan att, som utredningen föreslår, begärd information lämnas bilateralt av infrastrukturens ägare till den begärande operatören.",
      "quote_type": "grund"
    },
    {
