  "segments": [
    {
      "forarbete_id": "sec255",
      "sentiment": -0.5,
      "quote": "När det gäller anmälningsförfaranden finns risker med att minska kraven på tillstånd, eftersom dessa är viktiga för att säkerställa säkerhet, framkomlighet och samordning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.6",
      "sentiment": -0.2,
      "quote": "Då flera aktörer är involverade finns en risk för otydlig ansvarsfördelning och förlängda handläggningstider om detta inte klargörs.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.8",
      "sentiment": 0.5,
      "quote": "Göteborgs Stad bedömer att utredningen svarat väl på de eventuella konflikter som kan uppstå inom säkerhetsområdet, och de förslag till undantag för statliga myndigheter och andra offentliga organ som föreslås ger möjligheter att begränsa åtkomst till information som kan påverka detta perspektiv.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a17.4",
      "sentiment": 0.5,
      "quote": "Göteborgs Stad bedömer att utredningen svarat väl på de eventuella konflikter som kan uppstå inom säkerhetsområdet, och de förslag till undantag för statliga myndigheter och andra offentliga organ som föreslås ger möjligheter att begränsa åtkomst till information som kan påverka detta perspektiv.",
