  "segments": [
    {
      "forarbete_id": "a9-2",
      "sentiment": 0.5,
      "quote": "Malmö stad vill framhålla att det samtidigt är viktigt att tillträdesreglerna utformas så att de inte skapar osäkerhet kring ansvarsförhållanden, driftsäkerhet eller förvaltningen av befintliga nät.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11",
      "sentiment": 0.5,
      "quote": "Malmö stad bedömer därför att det är viktigt att nätägare och ansvariga aktörer fortsatt har möjlighet att göra en rimlighetsbedömning i det enskilda fallet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16",
      "sentiment": 0.5,
      "quote": "I mer komplexa ärenden behöver det därför finnas utrymme för längre handläggningstid utan att rättssäkerheten påverkas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a17.1",
      "sentiment": -0.2,
      "quote": "Malmö stad anser att det finns en risk för att det tekniska egenskapskravet förbises när man bryter ut ett av kraven ur den uttömmande listan i Plan- och bygglagen (PBL) 8 § 4.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a18",
      "sentiment": 0.0,
      "quote": "Beroende på vilken information som verksamheterna kan komma att behöva dela med sig av vill Malmö stad framhålla att tillträde till den befintliga infrastrukturen kan komma att påverka kommunens kontroll av infrastrukturen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19",
      "sentiment": 0.5,
      "quote": "Samtidigt är det avgörande att systemet utformas med höga krav på informationssäkerhet och tydliga regler för åtkomst och behörighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a23-2",
      "sentiment": -0.2,
      "quote": "Malmö stad ställer sig frågande till varför författningsändringen i PBL föreslås träda i kraft redan 13 februari 2026 eftersom detta är innan remissens svarsdatum gått ut.",
      "quote_type": "grund"
    }
