  "overall": {
    "sentiment": 0.4,
    "quote": "Generellt anser Spillkråkan att utredningen har kommit med klara och väl genomarbetade förslag som minskar brukningsosäkerheterna för skogsägaren.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a4",
      "sentiment": -0.2,
      "quote": "Vi ser det som ett orimligt stort ansvar som läggs på skogen att den ska kompensera för alla utsläpp.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.1",
      "sentiment": 0.5,
      "quote": "Spillkråkan anser att förslagen tillsammans med förslagen i delbetänkandet innebär en rättvisare fördelning av kostnaderna för avsättningar och miljöhänsyn mellan skogsägare och stat.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec524",
      "sentiment": 0.5,
      "quote": "skulle klargöra den politiska avvägningen mellan naturvårdsavsättningar och virkesproduktionsmark som idag inte är uttalad, under förutsättning att en sådan målsättning också realiseras i form av medel via budgetprioriteringar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec526",
      "sentiment": 1.0,
      "quote": "Det synliggör de arealer som skogsägare avsätter och sköter, som en viktig del av sitt skogsbruk och en betydande andel av Sveriges totala naturvårdsavsättningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.2",
      "sentiment": 1.0,
      "quote": "För enskilda skogsägare som Föreningen Spillkråkans medlemmar, som kan vara både utförare och beställare av skogliga tjänster, är en robust och ändamålsenlig uppföljning nödvändig för att kunna utveckla skogsbruket och alla dess värden över tid.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.3",
      "sentiment": 1.0,
      "quote": "Föreningen Spillkråkan anser att de skulle fungera bättre i förhållande till den långsiktiga planering som skogsägare gör för sin fastighet genom skogsbruksplaner med mera.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6",
      "sentiment": 0.8,
      "quote": "Spillkråkan konstaterar att det skogsbruk med frihet under ansvar som vi arbetat med sedan 90-talet har resulterat i ökade frivilliga avsättningar samt en ökning av volymen död ved och antalet evighetsträd i våra skogar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": 0.5,
      "quote": "Om arealerna med alternativa mer oprövade brukningsmetoder ökar bör ett system för tillsyn införas för att säkerställa skogens långsiktiga produktion, återväxt samt hänsyn till natur- och kulturmiljövärden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7",
      "sentiment": 1.0,
      "quote": "Vi i Spillkråkan bygger gärna ökad kunskap och kompetens med bistånd från Skogsstyrelsen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.1",
      "sentiment": 1.0,
      "quote": "Ovanstående blir ett hjälpmedel för att skapa en stabil skogspolitik och därmed robusta skogar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.9",
      "sentiment": 1.0,
      "quote": "Både för att viltet skadar skogen och för att det orsakar många trafikolyckor.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.10",
      "sentiment": 1.0,
      "quote": "Spillkråkan håller även med om att det kan vara klokt att behålla regelverket om lägsta avverkningsålder",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.11",
      "sentiment": 1.0,
      "quote": "Ett väl fungerande skogsbilvägnät är till gagn för friluftslivet och skapar möjligheter att bekämpa och begränsa skogsbränder.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10",
      "sentiment": 1.0,
      "quote": "Beslut som gäller skogen måste baseras på tillförlitliga och objektiva beslutsunderlag som ger legitimitet hos skogsägare m.fl. aktörer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11",
      "sentiment": 0.8,
      "quote": "innebär åtgärder för att mer framgångsrikt driva de frågor som är viktiga för Sverige samt att anpassa lagstiftningen till nationella förutsättningar.",
