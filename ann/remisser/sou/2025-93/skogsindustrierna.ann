  },
  "segments": [
    {
      "forarbete_id": "a4.3.1",
      "sentiment": 1.0,
      "quote": "Standarden ger en helhetsbild av skogens klimatnytta som ofta tappas bort med dagens systemavgränsningar i klimatrapporteringen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.1.3",
      "sentiment": 1.0,
      "quote": "Med en arealmässig avvägning underlättas långsiktiga investeringsplaner inom svensk skogsindustri och satsningar på innovation.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.2.3",
      "sentiment": 1.0,
      "quote": "En utveckling mot att prioritera de mest skyddsvärda lämningarna skulle, förutom ökat fokus på dessa, leda till en ökad acceptans för behovet att bevara kulturhistoriska lämningar i allmänhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.3.3",
      "sentiment": 0.5,
      "quote": "Skogsindustrierna vill dessutom med hänvisning till den ändring som gjorts i den svenska översättningen av Fågeldirektivet påpeka att ändringar behövs även i 4§ 4b till “anpassa populationen” i stället för dagens återupprätta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.4.3",
      "sentiment": 1.0,
      "quote": "Att avveckla ett skydd för ett område som förlorat sina ursprungligt skyddade naturvärden kan frigöra resurser och möjliggöra skydd av andra områden med högre naturvärden, alltså en mer resurseffektiv och flexibel naturvårdspolitik.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.5.3",
      "sentiment": 0.5,
      "quote": "Dagens system är dessutom olyckligt då beskattningen av ersättning för nekat avverkningstillstånd sker i inkomstslaget näringsverksamhet medan ersättning för formellt skydd sker till betydligt lägre skattenivåer i inkomstslaget kapital.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7",
      "sentiment": 1.0,
      "quote": "Rådgivning är ett viktigt styrmedel för att uppnå de skogspolitiska målen och myndigheten behöver resursförstärkning för att återuppbygga rådgivningsfunktionen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.1.3",
      "sentiment": 1.0,
      "quote": "Ett system för uppföljning och utvärdering av det skogspolitiska produktionsmålet på ett motsvarande sätt som miljömålssystemet skulle skapa en tydligare balans mellan de två jämställda målen och sätta produktionsfrågorna mer i fokus hos såväl myndigheterna som i skogsnäringen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.1",
      "sentiment": 1.0,
      "quote": "Tillgång till frö och plantmaterial för skogsodling som är anpassat till ett klimat i snabb förändring är helt avgörande för vitalitet och resiliens i framtidens skogar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.2",
      "sentiment": 1.0,
      "quote": "Behovet av detta grundar sig i att för skogsplantskolorna är användningen av bekämpningsmedel så liten i omfattning att producenterna som sätter produkten på marknaden inte har några ekonomiska incitament att ta fram de studier och underlag som kan ligga till grund för ett produktgodkännande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3.3",
      "sentiment": 1.0,
      "quote": "Skogsindustrierna delar bedömningen att om Sverige även framöver ska kunna upprätthålla ett skogsbruk med hög tillväxt, klimatanpassning, effektiv hantering av skogsskador och stärkt försörjningstrygghet, krävs en anpassning till de förändrade förutsättningar som klimatförändringarna medför.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.3",
      "sentiment": 1.0,
      "quote": "Föryngringar med rätt trädslag, till rätt täthet och vid rätt tidpunkt är grunden för en bra produktion på den del av skogsmarken vi ska använda för virkesproduktion.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5.3",
      "sentiment": 1.0,
      "quote": "Skogsindustrierna tillstyrker förslagen att SLU ska göra en särskild ungskogsinventering samt att Skogsstyrelsen utvecklar en löpande ungskogsuppföljning.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.6.3",
      "sentiment": 1.0,
      "quote": "Skogsindustrierna anser att gödsling av skog, utförd på rätt sätt och anpassad till den aktuella platsen, är ett av de mest effektiva sätten att öka tillväxten i skogen och därmed öka både koldioxidinbindningen och tillgången till råvara från skogen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.8.3",
      "sentiment": 1.0,
      "quote": "Ett proaktivt arbete och resurser för övervakning, förebyggande åtgärder och forskning är grundläggande för att minska risker för skogsskador.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.9.3",
      "sentiment": 1.0,
      "quote": "Skadorna inverkar negativt på skogens tillväxt och ekonomiska värde, begränsar möjligheten att öka kolsänkan i skogen och försämrar förutsättningarna för biologisk mångfald.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.10.3",
      "sentiment": 1.0,
      "quote": "Skogsindustrierna tillstyrker förslaget att Skogsstyrelsen ska revidera föreskrifterna om lägsta ålder för föryngringsavverkning för att ta bort de ogrundade skillnaderna mellan landsdelar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.11.3",
      "sentiment": 1.0,
      "quote": "Skogsindustrierna tillstyrker alla utredningens förslag kring robusta vägar så som en standard för byggande av skogsbilvägar, förenklad förrättning, ajourhållning samt översyn av regelverket för husbehovstäkter.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a9",
      "sentiment": 1.0,
      "quote": "Skogsbruket står inför stora utmaningar kopplat till ett förändrat klimat samtidigt som en fortsatt god tillväxt i skogen är mycket viktig för att kunna bryta beroendet av fossil råvara i samhället samtidigt som skogen ska kunna leverera andra nyttor som biologisk mångfald, sociala värden och agera kollager.",
