  "segments": [
    {
      "forarbete_id": "a4.3",
      "sentiment": -0.5,
      "quote": "SLU bedömer att sådana mått och redovisningssystem bör vara vetenskapligt grundade och följa internationellt vedertagen praxis.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.1.3",
      "sentiment": 0.0,
      "quote": "bedömer att ett sådant mål skulle vara svårt att hantera inom ramen för EU-samarbetet, där bindande EUlagstiftning påverkar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.3.3",
      "sentiment": -0.2,
      "quote": "SLU bedömer att en sådan lista skulle ha begränsad nytta, eftersom bedömningen sker på så kallad biogeografisk nivå, vilket betyder att den inte ger information om den lokala fågelpopulationen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.4.3",
      "sentiment": 0.0,
      "quote": "bedömer att ett nytt regelverk för att avveckla naturreservat och biotopskydd skulle ha marginell effekt i termer av ökad tillväxt i landets skogar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6",
      "sentiment": 0.5,
      "quote": "SLU delar bedömningen att forskning om mer variationsrikt skogsbruk bör ökas, eftersom variationen i brukningsmetoder är fortfarande liten i jämförelse med andra europeiska länder, där bland annat hyggesfria system tillämpas i större omfattning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": 0.5,
      "quote": "SLU bedömer att Skogsstyrelsen bör återställa kapaciteten för personlig rådgivning lokalt på distrikten, eftersom sammanställningar och förmedling av information via hemsidor samt digitala verktyg inte helt kan ersätta personliga möten med rådgivare som har bred skoglig och biologisk kompetens.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.1.3",
      "sentiment": 0.0,
      "quote": "SLU bedömer dock att jämförelsen med miljökvalitetsmålen inte är helt ändamålsenligt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.1",
      "sentiment": 0.2,
      "quote": "SLU instämmer i bedömningen att reglerna för förflyttning av plantmaterial bör ses över på grund av klimatförändringens konsekvenser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.2",
      "sentiment": 0.5,
      "quote": "SLU bedömer att de föreslagna verksamheterna ligger nära de befintliga målen för Skogsskadecentrums verksamhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3.3",
      "sentiment": 0.5,
      "quote": "SLU bedömer dock att detta bör kombineras med en utökad miljöövervakning för att kunna utvärdera konsekvenserna på ekosystem- och landskapsnivå, samt att trädarter som bedöms som (potentiellt) invasiva ska undvikas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.3",
      "sentiment": 0.2,
      "quote": "SLU tillstyrker förslaget om översyn av föryngringsföreskrifter, eftersom föryngringarnas kvalitet försämrats på senare år.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5.3",
      "sentiment": 0.2,
      "quote": "anser att det skulle innebära onödigt dubbelarbete om Skogsstyrelsen genomför stickprovsbaserad ungskogsinventering parallellt med SLU Riksskogstaxeringen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.6.3",
      "sentiment": 0.2,
      "quote": "SLU bedömer att de befintliga allmänna råden och rekommendationerna har fel utgångspunkt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.4",
      "sentiment": 0.5,
      "quote": "Det bör dock inkludera åtgärder för att inte påverka rennäringen negativt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.8.3",
      "sentiment": 0.8,
      "quote": "SLU ställer sig bakom utredningens bedömning att SLU Skogsskadecentrum även fortsatt ska vara ett kunskapsnav för hela skogssektorn, vilket ligger helt i linje med nuvarande prioriteringar inom SLU.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.9.3",
      "sentiment": 0.8,
      "quote": "Förslaget innebär inte enbart att skogsproduktionen av barrträd skulle kunna öka, utan även att återväxten av lövträd som asp, rönn, sälg och ek i högre grad skulle kunna bli trädbildande, särskilt i södra Sverige, vilket vore gynnsamt för den biologiska mångfalden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.10.3",
      "sentiment": 0.5,
      "quote": "SLU bedömer att de skäl som anförs för en revidering är välgrundade.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3",
      "sentiment": 0.5,
      "quote": "Mot bakgrund av utredningens olika förslag om behovet av fördjupad kunskap om bland annat trädslag, skogsproduktion och skötselmetoder är det viktigt att medel för sådan forskning finns tillgänglig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.7",
      "sentiment": 0.0,
      "quote": "Långsiktigt stabila finansieringslösningar skulle behöva etableras för både Riksskogstaxeringen och Markinventeringen, särskilt när EU:s markdirektiv troligen kommer att öka kraven på markövervakning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.2.2",
      "sentiment": -0.8,
      "quote": "eftersom SLU bedömer att ändringen riskerar att göra rapporteringen mindre vetenskaplig och mindre förutsägbar, samt strider mot annan lagstiftning, exempelvis klimatrapporteringsförordningen.",
