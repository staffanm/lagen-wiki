  "segments": [
    {
      "forarbete_id": "sec14",
      "sentiment": 1.0,
      "quote": "Detta är av stor vikt för att få bukt med all desinformation och osakliga påståenden om skogens klimatnytta som cirkulerar i samhälle och media.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec15",
      "sentiment": 0.5,
      "quote": "Denna uppföljning är påkallad och viktig, inte minst för att belysa den natur- och kulturvårdshänsyn hundratusentals skogsägare tar vid skogsbruksåtgärder utan att erhålla ekonomisk kompensation för denna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec18",
      "sentiment": 0.5,
      "quote": "Förbundet delar utredningens syn på att fågeldirektivet tillämpas på ett sätt som är mer långtgående och ingripande för markägare än vad som är nödvändigt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec19",
      "sentiment": 1.0,
      "quote": "Om de naturvärden man en gång önskade skydda, av olika anledningar försvunnit, så finns ingen anledning att fortsätta använda skattemedel för att finansiera frånvarande naturvärden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec20",
      "sentiment": 0.5,
      "quote": "Så länge ersättningsnivån är marknadsmässig, rättssäker och skyndsam så är förbundet för ett införande av rätten att kräva att ett skogsmarksskyddsområde på berörd del av fastigheten när en ansökan om tillstånd till avverkning i fjällnära skog nekas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec21",
      "sentiment": 1.0,
      "quote": "Detta har olyckligtvis skett parallellt med införande av EU-förordningar och nationella skogspolitiska ambitioner, vilket skapat en mycket osäker och otydlig tillvaro för landets skogsägare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec22",
      "sentiment": 0.0,
      "quote": "En piska i form av detaljreglering är fel väg att gå.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec30",
      "sentiment": 1.0,
      "quote": "Ett aktivt skogsbruk är det bästa skyddet mot skogsskador.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec31",
      "sentiment": 1.0,
      "quote": "Det behövs ett tydligare mål för betesskador på skog och att driva på viltförvaltningarna mot mer balanserade populationer av hjortdjur.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec32",
      "sentiment": 0.2,
      "quote": "Om sänkt slutavverkningsålder leder till att andra skogar i regionen avverkas tidigare riskerar våra medlemmar att bli stående med än mer förhållandevis äldre skogar vilket skulle kunna leda till problem vid skogsbruksåtgärder, eftersom ju äldre skogen är, desto större sannolikhet är det att den härbärgerar fler naturvärden än sina yngre motsvarigheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec33",
      "sentiment": 0.0,
      "quote": "Detta är en förutsättning för effektivt skogsbruk, samt inte minst minskar risken för skador och ökar framkomligheten för räddningstjänsten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec34",
      "sentiment": 1.0,
      "quote": "Sverige behöver stärka skogsforskningen och vi tillstyrker därför även förslaget om ett forskningsprogram med inriktning mot skogsskötsel.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec35",
      "sentiment": 1.0,
      "quote": "Detta förslag är mycket viktigt i en tid av desinformation och känslobaserade åsikter kring skog och skogsbruk.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec36",
      "sentiment": 1.0,
      "quote": "Svenska politiker måste höras och arbeta hårdare för skogsnäringen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec37",
      "sentiment": 0.5,
      "quote": "En fråga förbundet drev inom ”Gröna steg” var att man bör mäta indikatorers derivata, alltså att se om vi rör oss i en positiv riktning med avseende på miljömålen, i stället för att ha statiska mål som orimligen kan nås om en hållbar utveckling inom skogsbruk och skogsindustri inte skall äventyras.",
      "quote_type": "grund"
    }
  ]
}