  "segments": [
    {
      "forarbete_id": "a4.3",
      "sentiment": 1.0,
      "quote": "Ett nytt och heltäckande mått är nödvändigt för att synliggöra skogens verkliga klimatnytta och för att klimatpolitiken ska baseras på korrekta och vetenskapliga underlag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec524",
      "sentiment": 1.0,
      "quote": "Ett mål för produktiv skogsmark är avgörande för att Sverige ska kunna möta samhällets framtida behov av skogsråvara och för att skogspolitiken ska bli långsiktigt hållbar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec549",
      "sentiment": 1.0,
      "quote": "Vi delar utredningens bedömning att kulturmiljöarbetet behöver bli mer strategiskt och prioriterat, så att de mest värdefulla lämningarna skyddas samtidigt som hanteringen av andra lämningar kan anpassas efter platsens förutsättningar och ett aktivt skogsbruk.",
