      "artifact:remisser/sou/2025:93/region-vasternorrland": "954f933f8a305b18c7d1a928e4286df5b5f4dcb865c1b1d12d395f48f613ed8d",
      "artifact:forarbete/sou/2025-93": "201aa2c9468bea44887a18a07b9556294fb64c34f2aea6d2f31ad09b58f302f0"
    }
  },
  "overall": {
    "sentiment": 0.8,
    "quote": "Region Västernorrland välkomnar således utredningen syfte att utveckla en framtida ändamålsenlig skogspolitik som främjar ett långsiktigt hållbart konkurrenskraftigt skogsbruk, ökad skoglig tillväxt och en långsiktigt ökad tillgång till hållbar skoglig biomassa för att fullt ut kunna bidra till klimatomställningen samt jobb och tillväxt i hela landet.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a4.3.1",
      "sentiment": 0.8,
      "quote": "den nya ISO 13391-1:2025 Wood and wood-based products — Greenhouse gas dynamics bör ligga till grund för nya beräkningar av substitutionseffektens klimateffekter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.1.3",
      "sentiment": 0.8,
      "quote": "Det skulle ge en välkommen tydlighet gällande hur Sverige avser att bidra till EU:s gemensamma och internationella åtaganden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.1.3",
      "sentiment": -0.2,
      "quote": "Vi anser att hur skog ska användas i första hand bör styras av markägarens val och avvägningar gällande tillväxt, lönsamhet på kort och lång sikt, miljövärden samt sociala och kulturella värden och inte av ett styrande areal-mål.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec549",
      "sentiment": 0.8,
      "quote": "I likhet med utredaren anser vi att behövs en samlad strategi för hur de mest skyddsvärda lämningarna ska hanteras långsiktigt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.3.3",
      "sentiment": 0.8,
      "quote": "Genom en förteckning kan resurser riktas till arter med störst behov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.7",
      "sentiment": 0.8,
      "quote": "För att bättre harmonisera den nationella regleringen med fågeldirektivets krav avseende vad som utgör en förbjuden störning ser vi även positivt på att 4 § artskyddsförordningen (2007:845) ändras för att mer likna andra länders formuleringar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": 0.8,
      "quote": "Rådgivning och ökad kunskap förbättrar förutsättningarna för att nå både miljömål och produktionsmål.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.1.3",
      "sentiment": 0.5,
      "quote": "Samtidigt är det centralt att uppföljningen också tar hänsyn till ekologiska trösklar, så att ökad produktion inte sker på bekostnad av långsiktig bärkraft.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.11.3",
      "sentiment": 0.5,
      "quote": "Vi anser det särskilt viktigt att förslaget bygger på frivillighet och inte leder till tvingande regelverk som medför ökade kostnader.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3",
      "sentiment": 1.0,
      "quote": "Forskning och innovation är essentiella i en situation med ökad konkurrens om skogsråvara och klimatrelaterade förändringar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.1.2",
      "sentiment": 0.8,
      "quote": "Därför ser vi förslaget om ett stärkt strategiskt arbete i EU-frågor och svensk närvaro i Bryssel som särskilt angeläget.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.7",
      "sentiment": 0.8,
      "quote": "På så sätt skapas en helhet där ekologisk, ekonomisk och social hållbarhet ses som ömsesidigt förstärkande.",
      "quote_type": "grund"
    }
  ]
}