  "segments": [
    {
      "forarbete_id": "a5.4",
      "sentiment": -1.0,
      "quote": "Ytterligare grunder för upphävande eller dispens bör inte införas då de skulle motverka biologisk mångfald.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": -0.5,
      "quote": "Det finns flera negativa aspekter att beakta med ett sådant förslag – däribland risk för invasivitet särskilt i ett föränderligt klimat.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.4",
      "sentiment": -0.5,
      "quote": "Skyddsdikning kan bidra med negativa effekter på bottenlevande organismer då grumling kan uppstå (sid 620, SOU 2025:93:2).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a2.1.5",
      "sentiment": 1.0,
      "quote": "Bra att skapa underlag för identifiering skyddsvärda skogar och arter mer strategiskt och inte i samband med att åtgärden ska genomföras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.7",
      "sentiment": -0.5,
      "quote": "Dessa ändringar/tillägg kommer antagligen att medföra ytterligare svårigheter att kravställa förbud om att inte avsiktligt störa fåglar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec1087",
      "sentiment": -0.5,
      "quote": "Det finns en risk att man inte klarar av att uppnå EU:s mål för biologiska mångfald och hållbara livsmiljöer i skog med föreslagen skogspolitik.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec526",
      "sentiment": -0.2,
      "quote": "Ett eventuellt val av mindre starka skyddsformer kan ifrågasättas särskilt då skog kräver ett mer långsiktigt tänk för att erhålla och bidra med livsmiljöer för biologisk mångfald.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.4.3",
      "sentiment": -0.5,
      "quote": "Vi når inte miljömålet för ett rikt växt- och djurliv, det finns hotade arter i skogen och trenden går åt fel håll - så det behövs mer naturhänsyn, inte mindre.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec517",
      "sentiment": -0.5,
      "quote": "Det finns en stor osäkerhet kring tillräcklig budgetering för hantering av skyddsvärd skog, vilket syns tydligt utifrån påtalade brister av Skogsstyrelsens tillsyn på avverkningsanmälningar idag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.1.3",
      "sentiment": -0.5,
      "quote": "Behov för arter och dess livsmiljöer att leva och reproducera sig på sikt behöver vara vetenskapligt belagt, och vid osäkerhet bör inga lägsta referensnivåer användas vilket kan riskera populationers och arters överlevnad för framtiden.",
      "quote_type": "grund"
    }
  ]
