  "overall": {
    "sentiment": 0.2,
    "quote": "Samtidigt bedömer vi att utredningen i sin nuvarande form inte fullt ut säkerställer den balans mellan produktions- och miljömål som riksdagen fastställt, och att flera delar behöver utvecklas för att ge en mer heltäckande och långsiktigt hållbar inriktning.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a4",
      "sentiment": 1.0,
      "quote": "Skogen spelar en strategisk roll i klimatomställningen, men det syns inte tillräckligt i LULUCF- systemet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.1.3",
      "sentiment": 0.2,
      "quote": "Det finns en risk att man, för att uppnå de satta målen, skyddar skog som kanske inte är så skyddsvärd, eller det motsatta, att man avstår från att skydda skog med stort skyddsvärde eftersom man redan nått målen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.7",
      "sentiment": -0.5,
      "quote": "Utredningens föreslagna tillägg i 4 § artskyddsförordningen – att tillåta bedömningar som beaktar ekonomiska och rekreationsmässiga krav – riskerar att försvaga skyddet av vissa fågelpopulationer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6",
      "sentiment": -0.2,
      "quote": "Utredningen konstaterar att alternativa skogsbruksmetoder finns men skjuter samtidigt fram förslag om hur dessa ska hanteras, stödjas och utvecklas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.1",
      "sentiment": 1.0,
      "quote": "Utredningen ger förslag om att införa ett system för uppföljning av produktionsmål för att skapa balans i uppföljning och utvärdering mellan produktionsmål och miljömål.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": -0.5,
      "quote": "Förslaget att helt ta bort begränsningen av främmande trädslag bedöms som osäkert och bör inte genomföras utan solid evidens och riskanalys.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.2.3",
      "sentiment": -0.5,
      "quote": "Förslaget att ta bort anmälningsplikten vid skyddsdikning innebär risk för felaktigt utförda åtgärder och påverkan på närliggande fastigheter och vattenmiljöer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.8.3",
      "sentiment": -0.5,
      "quote": "Ur ett klimatanpassningsperspektiv saknas en fördjupad diskussion om – och förslag på – hur skogsbruket (dess praktiker, metoder och produktionsmål) påverkar omgivande territorium och samhällsviktig infrastruktur, framför allt med hänseende till avverkningsytors bidrag till ökad risk för ras, skred och slamströmmar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1",
      "sentiment": -0.5,
      "quote": "Utredningen nämner biodiversitetskrediter endast i Del 1 (Kap. 3.3.2, sid 380) och saknar därmed förslag som är viktiga för både kommuner, markägare och nationell styrning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.1.2",
      "sentiment": 1.0,
      "quote": "Därför ser vi förslaget om en stärkt svensk närvaro i Bryssel som särskilt angeläget och ser fram emot ett fruktbart samarbete.",
      "quote_type": "grund"
