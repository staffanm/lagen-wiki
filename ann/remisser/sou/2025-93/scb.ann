    },
    {
      "forarbete_id": "a5.2.3",
      "sentiment": 1.0,
      "quote": "En brist idag är att informationen saknar tillräckliga geodata för att bryta ned uppgifterna på detaljerad regional nivå, beräkna överlapp gentemot andra former av skogsmark (bland annat frivilliga avsättningar), samt att följa varaktigheten över tid.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.7.5",
      "sentiment": 1.0,
      "quote": "En brist idag är att informationen saknar tillräckliga geodata för att bryta ned uppgifterna på detaljerad regional nivå, beräkna överlapp gentemot andra former av skogsmark (bland annat frivilliga avsättningar), samt att följa varaktigheten över tid.",
