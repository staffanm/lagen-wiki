  "segments": [
    {
      "forarbete_id": "a5",
      "sentiment": 0.0,
      "quote": "SCB tar inte ställning till förslagen, men noterar att i framtida uppföljningar kan SCB:s officiella statistik inom området Markanvändning användas för att följa effekterna av förslagen.",
