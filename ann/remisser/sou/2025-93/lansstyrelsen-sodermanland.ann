  "overall": {
    "sentiment": -0.4,
    "quote": "Länsstyrelsen bedömer att utredningens förslag, i och med att de till stor del är kortsiktiga och i vissa fall kan skapa osäkerhet, inte är till fördel för skogsnäringens långsiktiga utveckling.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a1.1",
      "sentiment": 0.5,
      "quote": "det behöver säkerställas att ersättning enligt denna regel har en budget som regleras efter behov och omhändertas löpande i efterföljande budgetår för att markägare inte ska bli lidande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.2",
      "sentiment": 1.0,
      "quote": "ändring i jaktlagen 4 § (avsnitt 1.2).",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a1.3",
      "sentiment": -0.5,
      "quote": "Ändringen i miljöbalken 7 kap, 7 § (avsnitt 1.3) är olämplig, då det är oklart när den kan tillämpas samt att negativa konsekvenser för naturmiljön riskeras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.7",
      "sentiment": -1.0,
      "quote": "Förslaget om ändring av artskyddsförordningen (avsnitt 1.7) strider mot gällande EU-rätt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.10",
      "sentiment": 0.0,
      "quote": "Länsstyrelsen föreslår att ändringen i 5 § punkten 9 förordningen (2017:868) med länsstyrelseinstruktion (avsnitt 1.10) ska ha följande lydelse: 9. medverka till att begränsa och förebygga skador av vilt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.5",
      "sentiment": -1.0,
      "quote": "De behov som finns kan mötas med utveckling av befintliga skyddsformer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4",
      "sentiment": -1.0,
      "quote": "De globala modellerna bör behållas för kontinuitet och säkerställa att beräkningar görs likartat mellan länderna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.3",
      "sentiment": 0.8,
      "quote": "Länsstyrelsen ställer sig positiv till att regeringen på lämpligt sätt upprättar en nationell förteckning över fågelarter vars populationer inte befinner sig på en tillfredsställande nivå (avsnitt 5.3).",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a5.4",
      "sentiment": -1.0,
      "quote": "Formellt skydd av skog gör mest nytta när man skyddar värdekärnor samlat i värdetrakter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.5",
      "sentiment": 0.5,
      "quote": "Det bör kompletteras med medel för ersättning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6",
      "sentiment": 0.2,
      "quote": "Den kräver dock ytterligare utredning innan det går att påbörja en intensivare skogsbruksmodell enligt utredningens förslag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": 0.8,
      "quote": "Länsstyrelsen bedömer att mer statlig rådgivning efterfrågas av skogsbrukets aktörer och kan göra reell skillnad i skogen för att nå skogsvårdslagens båda mål.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": -1.0,
      "quote": "Riskerna med att föra in nya trädslag i stor skala är oöverskådliga och kommer förändra de skogliga ekosystemen i grunden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen tillstyrker förslaget att Skogsstyrelsen får i uppdrag att se över sina föreskrifter om föryngringsåtgärder, i syfte att förbättra möjligheterna för en tillsyn som är relevant för att gott föryngringsresultat (avsnitt 8.4).",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.5",
      "sentiment": 0.8,
      "quote": "Länsstyrelsen anser att det är angeläget att Skogsstyrelsen inkluderar ungskogar i sin rådgivningsverksamhet (avsnitt 8.5).",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.6",
      "sentiment": -1.0,
      "quote": "Tillförande av gödning förändrar skogens ekosystem i grunden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7",
      "sentiment": 0.8,
      "quote": "Askåterföringen behöver styras till rätt områden ur försurningssynpunkt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.8",
      "sentiment": -1.0,
      "quote": "Det finns i dagsläget inget som hindrar myndigheterna att göra en översyn av reservatsföreskrifterna när det anses nödvändigt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.9",
      "sentiment": 0.8,
      "quote": "Länsstyrelsen menar att detta skulle öka tydligheten och ge ett större mandat för myndigheter och andra aktörer att arbeta mer aktivt med frågan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9",
      "sentiment": 1.0,
      "quote": "Med ökad efterfrågan på skogsråvara, klimatförändringar, nya regelverk och nya förväntningar på hur skogen ska brukas behövs ett forskningsprogram med fokus på skogsskötsel.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec430",
      "sentiment": 0.8,
      "quote": "Därför behöver näringen inkluderas i samhällets breda beredskapsplanering.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec1044",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen stödjer förslaget om ett stående forum för samhällsgemensam omvärldsbevakning när det gäller skogsfrågorna.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a12.6",
      "sentiment": 1.0,
      "quote": "Detta ligger också i Miljömålsberedningens grunduppdrag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.7",
      "sentiment": 0.0,
      "quote": "Länsstyrelsen anser att miljömålen redan bygger på en vetenskaplig grund. och att nuvarande ansvar för uppföljningen är fungerande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13",
      "sentiment": -0.2,
      "quote": "Analysen (avsnitt 13) skulle behöva fördjupas, särskilt vad gäller klimateffekter, liksom även känslighetsanalyser för olika omvärldspåverkan",
      "quote_type": "grund"
    }
  ]
