  "overall": {
    "sentiment": 0.8,
    "quote": "Förslagen skapar i sin helhet en bättre balans mellan de jämställda skogspolitiska målen, ger framtidstro och ökar viljan att investera i såväl produktion som naturvård.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a4.3",
      "sentiment": 1.0,
      "quote": "Vi delar utredarens bedömning att dagens systemavgränsningar ger en otillräcklig bild av skogens bidrag till klimatarbetet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.1.3",
      "sentiment": 0.5,
      "quote": "Med en arealmässig avvägning underlättas långsiktiga investeringsplaner inom svensk skogsindustri och satsningar på innovation.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.2.3",
      "sentiment": 1.0,
      "quote": "En objektiv, allmänt accepterad och väl fungerande metod är till gagn för att säkerställa ett gott kunskapsläge om den faktiskt tagna miljöhänsynen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.3.3",
      "sentiment": 0.5,
      "quote": "En sådan förteckning bör göras med bas i biogeografiska regioner (det vill säga utan beaktande av lokala förändringar men med beaktande av den nationella statusen) och sedan användas för att på ett strukturerat sätt återskapa miljöer för dessa fågelarter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.4.3",
      "sentiment": 1.0,
      "quote": "Att avveckla ett skydd för ett område som förlorat sina ursprungligt skyddade naturvärden kan frigöra resurser och möjliggöra skydd av andra områden med högre naturvärden, alltså en mer resurseffektiv och flexibel naturvårdspolitik.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": 1.0,
      "quote": "Rådgivning utgör ett viktigt instrument för genomförande av skogspolitikens jämställda mål.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.1.3",
      "sentiment": 1.0,
      "quote": "Att införa produktionsmål för skogsbruket skulle verka för att jämställa skogspolitikens båda mål, produktion och miljö, i praktiken och skulle skapa en bra grund för att stärka Skogsstyrelsens arbete med produktionsrådgivning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2",
      "sentiment": 1.0,
      "quote": "En användning som är avgörande för skogsbruket men inte är en tillräckligt stor marknad och därmed ointressant att innefatta vid ansökan om användningsområde av tillverkare på grund av höga kostnader kopplat till dagens regelverk.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3.3",
      "sentiment": 1.0,
      "quote": "Främmande trädarter är en möjlighet att öka skogens resiliens.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.3",
      "sentiment": 1.0,
      "quote": "Föryngringar med rätt trädslag, till rätt täthet och vid rätt tidpunkt är grunden för en bra produktion på den del av skogsmarken vi ska använda för virkesproduktion.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5.3",
      "sentiment": 1.0,
      "quote": "Södra stöder utredningens förslag om ökat fokus på inventering och analys av tillståndet i ungskogsfasen.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.6.3",
      "sentiment": 1.0,
      "quote": "Dagens regionala indelning baserad på ekonomisk lönsamhet kan slopas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.8.3",
      "sentiment": 1.0,
      "quote": "Södra stöder utredningens förslag för att begränsa skogsskador.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.9.3",
      "sentiment": 1.0,
      "quote": "Ett medskick är att det skulle skapa en tydlighet kring hur förvaltningen av klövviltet ska komma att utformas, vilket saknas i dag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.10.3",
      "sentiment": 1.0,
      "quote": "Södra tillstyrker utredningens förslag.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.11.3",
      "sentiment": 1.0,
      "quote": "Södra tillstyrker förslag som innebär att Skogsstyrelsen återupptar rådgivning vid vägbyggnation för bättre samordning och båtnad.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3",
      "sentiment": 1.0,
      "quote": "Att satsa mer forskningskapacitet på skogens skötsel och produktion är därför av största vikt och skapar nytta för samhället och alla skogens värden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.7",
      "sentiment": 1.0,
      "quote": "Generellt kan kvaliteten i beslut om skogen förbättras mycket genom att öka objektivitet och minska subjektivitet i det underlag som besluten baseras på.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.1.2",
      "sentiment": 1.0,
      "quote": "Det som beskrivs om Sveriges arbetssätt i betänkandet utifrån både tidigare analyser och det intervjumaterial som redovisas anser vi visar tydligt på ett behov av att göra justeringar i arbetssättet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.6",
      "sentiment": 0.5,
      "quote": "Det går inte att bortse från riskfaktorn att uppnådda mål kan leda till en diskussion om lägre anslag till myndigheterna.",
      "quote_type": "grund"
    }
  ]
