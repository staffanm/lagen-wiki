    {
      "forarbete_id": "a1.3",
      "sentiment": -0.5,
      "quote": "Det är en olämplig förändring då det är oklart när den kan tillämpas samt att negativa konsekvenser för naturmiljön riskeras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.4",
      "sentiment": -0.5,
      "quote": "Förslaget om främmande trädarter innebär ohanterliga risker för skogsbruk och biologisk mångfald.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.3",
      "sentiment": -0.5,
      "quote": "De globala modellerna bör behållas för kontinuitet och säkerställa att beräkningar görs likartat mellan länderna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.1.3",
      "sentiment": -0.5,
      "quote": "Om en fast del av arealen reserveras för naturvård finns en risk att återstående skogsmark brukas mer intensivt, vilket innebär att naturvärden som i dag finns i brukade skogar gradvis försvagas eller förloras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.2.3",
      "sentiment": -0.5,
      "quote": "Att dela upp sektorsansvaret för lämningar skulle kräva dubbla regleringssystem och register och också leda till att lämningar skulle behandlas i olika system, beroende på om det gäller skogsbruksrelaterade ärenden eller exploateringsärenden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.3.3",
      "sentiment": 0.5,
      "quote": "Det är angeläget att en nationell förteckning revideras med jämna och relativt korta intervall, förslagsvis var femte år.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.4.3",
      "sentiment": -0.5,
      "quote": "Länsstyrelsen ser en stor risk att utredningens förslag enbart skapar större osäkerhet hos markägare och mindre förutsägbarhet om vad som gäller vid ett områdesskydd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen bedömer att mer statlig rådgivning efterfrågas av skogsbrukets aktörer och kan göra reell skillnad i skogen för att nå skogsvårdslagens båda mål.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3.3",
      "sentiment": -0.5,
      "quote": "Riskerna med att föra in nya trädslag i stor skala är oöverskådliga och kommer förändra de skogliga ekosystemen i grunden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.3",
      "sentiment": 0.0,
      "quote": "Länsstyrelsen anser att detta skulle kunna innebära negativa konsekvenser för de eventuella okända fornlämningar som kan finnas eftersom Skogsstyrelsen och Länsstyrelsen inte kommer att underrättas och kan reagera.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5.3",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen anser att det är angeläget.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.6.3",
      "sentiment": -0.5,
      "quote": "Tillförande av gödning förändrar skogens ekosystem i grunden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.8.3",
      "sentiment": -0.5,
      "quote": "Länsstyrelsen bedömer, liksom Skogforsk att det endast är aktuellt i lokala fall, varför ett generellt uppdrag inte är påkallat.",
