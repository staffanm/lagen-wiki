    }
  },
  "overall": {
    "sentiment": -0.5,
    "quote": "Vi bedömer att utredningens förslag, i och med att de till stor del är kortsiktiga och i vissa fall kan skapa osäkerhet, inte är till fördel för skogsnäringens långsiktiga utveckling.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a1.1",
      "sentiment": 0.5,
      "quote": "det behöver säkerställas att ersättning enligt denna regel har en budget som regleras efter behov och omhändertas löpande i efterföljande budgetår för att markägare inte ska bli lidande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.2",
      "sentiment": -0.8,
      "quote": "Det föreslagna tillägget, som betonar att begränsa skador orsakade av vilt, är inte i linje med denna rättsliga prioriteringsordning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.3",
      "sentiment": -0.8,
      "quote": "Ändringen i miljöbalken 7 kap, 7§ är olämplig, då det är oklart när den kan tillämpas samt att negativa konsekvenser för naturmiljön riskeras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.4",
      "sentiment": -1.0,
      "quote": "Länsstyrelsen motsätter sig förslagen om främmande trädslag.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a1.7",
      "sentiment": -1.0,
      "quote": "Förslaget om ändring av artskyddsförordningen (1.7) strider mot gällande EU-rätt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.10",
      "sentiment": -0.5,
      "quote": "Vi anser att ändringen som föreslogs i remissen om en ny viltförvaltningsmyndighet (SOU 2025:50), där formuleringen av § 3 var ”Länsstyrelsen har uppgifter i fråga om 10. viltförvaltning, där bevarande av viltarter, brukande av viltet som resurs samt begränsning av skador och olägenheter av vilt ska beaktas.” är mer heltäckande eftersom den speglar länsstyrelsernas breda uppdrag inom viltförvaltning – där bevarande, brukande och skador behöver vägas mot varandra (se även beskrivning om vikten av balans under våra synpunkter på avsnitt 1.2).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4",
      "sentiment": -0.8,
      "quote": "Att ta fram ett nytt mått för redovisning av skogens klimatnytta anser Länsstyrelsen vore negativt för klimatarbetet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.1",
      "sentiment": 0.2,
      "quote": "enbart under förutsättning att det specificeras hur skogarna ska undantas från skogsbruk, vad det innebär och att målen är vetenskapligt förankrade.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.2",
      "sentiment": -0.5,
      "quote": "Länsstyrelsen anser att den generella hänsyn som markägare uppmanas ta är inte tillräckliga för att skydda alla arter, särskilt EUskyddade arter och känsliga fågelarter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.3",
      "sentiment": 0.2,
      "quote": "Det finns inget formellt hinder för att ta fram en lista över fågelarter vars populationer inte befinner sig på en tillfredsställande nivå.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.3",
      "sentiment": -0.8,
      "quote": "Länsstyrelsen anser att det samlade förslaget om hur utredaren anser att tolkningen och tillämpningen av störningsförbudet i 4 § p. 4 artskyddsförordningen ska ändras inte överensstämmer med gällande EU-rätt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.4",
      "sentiment": -0.8,
      "quote": "Behovet av att kunna upphäva ett naturreservat redan är uppfyllt i miljöbalken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.5",
      "sentiment": 0.8,
      "quote": "Förslaget om ersättning vid förbud mot avverkning tillstyrks.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a5.5",
      "sentiment": -0.8,
      "quote": "Behovet av skydd kan uppfyllas av de befintliga skyddsformerna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6",
      "sentiment": 0.5,
      "quote": "Det anser länsstyrelsen är ett intressant förslag att arbeta vidare kring.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7",
      "sentiment": 0.8,
      "quote": "Skogsbruket behöver både operativ tillsyn, för att kontrollera att den lagstiftning som finns faktiskt följs, och förebyggande tillsyn, vilket inkluderar rådgivning från tillsynsmyndigheten om vad lagkraven egentligen betyder i det enskilda fallet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": -1.0,
      "quote": "Riskerna med att föra in nya trädslag i stor skala är oöverskådliga och kommer förändra de skogliga ekosystemen i grunden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4",
      "sentiment": 0.8,
      "quote": "Länsstyrelsen instämmer med utredningen om förslaget att Skogsstyrelsen får i uppdrag att se över sina föreskrifter om föryngringsåtgärder",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.5",
      "sentiment": 0.8,
      "quote": "Länsstyrelsen anser att det är angeläget att Skogsstyrelsen inkluderar ungskogar i sin rådgivningsverksamhet",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.6",
      "sentiment": -1.0,
      "quote": "Tillförande av gödning förändrar skogens ekosystem i grunden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7",
      "sentiment": -1.0,
      "quote": "Av samma skäl som för gödsling, motsätter sig Länsstyrelsen förslaget om askåterföring",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.8",
      "sentiment": -0.5,
      "quote": "Det finns i dagsläget inget som hindrar myndigheterna att göra en översyn av reservatsföreskrifterna när det anses nödvändigt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.10",
      "sentiment": -0.8,
      "quote": "Rennäring är beroende av gammal skog för hänglavsrika skogar och lavrika betesmarker.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9",
      "sentiment": 0.8,
      "quote": "Länsstyrelsen delar utredningens slutsats att det behövs en förstärkt skogsforskning.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a10",
      "sentiment": 0.5,
      "quote": "Länsstyrelsen ser inget negativt i att förtydliga att Skogsstyrelsen och Naturvårdsverket i sina uppdrag ska utgå från vetenskap och beprövad erfarenhet.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a11",
      "sentiment": -0.5,
      "quote": "Länsstyrelsen anser att de europeiska och internationella rapporteringar som rör skogen i Sverige ska handla om att förmedla så bra kunskapsunderlag som möjligt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.1.2",
      "sentiment": -0.8,
      "quote": "Detta är felaktigt. Bedömningen enligt FU23 är att Frisk luft är nära att nås och att Bara naturlig försurning inte kommer att nås.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.3",
      "sentiment": -0.5,
      "quote": "Länsstyrelsen anser att den grundytevägda beståndsåldern är ett irrelevant mått i naturskogar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.5",
      "sentiment": 0.5,
      "quote": "Länsstyrelsen instämmer i att det finns svårigheter med att följa upp miljökvalitetsmålen och anser att det sedan den nya målstrukturen beslutades år 2010 blivit svårare att följa upp dem",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.6",
      "sentiment": -0.5,
      "quote": "I de föreslagna definitionerna är de grundytevägda beståndsåldrarna extremt högt satta, vilket leder till att de flesta av våra gamla skogar som inte är skyddade troligen kommer att avverkas om de här definitionerna börjar användas",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.6",
      "sentiment": -0.8,
      "quote": "Länsstyrelsen motsätter sig utredningens förslag att miljömålssystemet bör ses (avsnitt 12.6) över då det kommer att fördröja miljömålsarbetet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.7",
      "sentiment": -0.5,
      "quote": "Länsstyrelsen anser att miljömålen redan bygger på en vetenskaplig grund och att nuvarande ansvar för uppföljningen är fungerande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.7",
      "sentiment": -0.5,
      "quote": "Målets nuvarande formulering bör behållas för att bibehålla dess funktion som beskrivning av önskat miljötillstånd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.7",
      "sentiment": -0.5,
      "quote": "I stället för att tas bort bör preciseringen förtydligas och kopplas till fler mätbara indikatorer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.7",
      "sentiment": -0.5,
      "quote": "Åtgärdsprogrammen innehåller enbart ett urval av arter där insatser är särskilt angelägna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.7",
      "sentiment": -0.8,
      "quote": "Främmande arter kan ha stor negativ effekt på ekosystemen och den biologiska mångfalden även om de inte uppvisar ett invasivt beteende.",
      "quote_type": "grund"
    }
  ]
}