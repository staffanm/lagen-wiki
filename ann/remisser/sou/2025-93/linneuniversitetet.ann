  "overall": {
    "sentiment": 0.5,
    "quote": "Linnéuniversitetet (LNU) anser att det är en mycket gedigen genomlysning av svensk skogspolitik och skogsbruk samt möjliga vägar framöver.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a7",
      "sentiment": 0.2,
      "quote": "Universitetet anser att resurser för dessa insatser bör allokeras till aktörer som redan är etablerade och opartiska inom området.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9",
      "sentiment": 1.0,
      "quote": "Det finns ett stort behov av ökad kunskap om trädslagsval, ståndortsanpassning och olika skogsskötselmetoder för att möta klimatförändringarna och för att tillgodose skogsägares och samhällets behov av olika nyttor från skogen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8-2",
      "sentiment": 0.5,
      "quote": "LNU ser positivt på en ökad tillväxt i skogsbruket, eftersom detta går hand i hand med ökad klimatnytta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": 0.2,
      "quote": "det även behövs mer forskning om dessa arter och deras varianter. Detta för att framöver vid praktisk användning ha bättre kunskap om arternas effekter på produktion och miljövärden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.3",
      "sentiment": -0.2,
      "quote": "Ansvarsfördelningen när det gäller fågelskydd, fridlysta arter m.m. mellan staten och privata skogsägare är viktig att belysa, eftersom skogsägare i dag har ett mycket stort ansvar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.6",
      "sentiment": 0.2,
      "quote": "LNU ser dock förslaget i SOU 2025:93 som intressant, då det kan öppna upp nya möjligheter att öka tillväxten och klimatnyttan på ett hållbart sätt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1",
      "sentiment": 0.5,
      "quote": "Universitetets bedömning är att detta kommer att kräva att kompetens inom området tillförs Skogsstyrelsen i högre grad än i dag, för att säkerställa skyddet av lämningar, tillgänglighet för skogsägare samt kvalitet i rådgivning och myndighetsutövning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec545",
      "sentiment": -0.2,
      "quote": "Det saknas dessutom en utvecklad strategi för hur stor andel av kulturmiljöerna som behöver bevaras och på vilket sätt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec547",
      "sentiment": -0.5,
      "quote": "En utredning om alla enskilda lämningars status blir omfattande och kommer att kräva åtskilligt med kompetent personal för att kunna göras med säkerhet vilket kommer att medföra kostnader.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec549",
      "sentiment": 0.5,
      "quote": "det bör understrykas att det är viktigt att en sådan omdaning genomförs med hög kompetens och tydlighet i roller och ansvar och att kompetens hos myndighet och aktörer säkerställs.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec553",
      "sentiment": -0.5,
      "quote": "Bedömningen är att förslaget för kulturmiljöer underskattar omfattningen och kostnaderna för att säkerställa rättssäkra bedömningar och en korrekt tillämpning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec554",
      "sentiment": -0.2,
      "quote": "Utan en tydlig process ökar risken för skador eller förstörande av lämningar, vilket i sin tur hotar kulturarvet och dess upplevelseoch kunskapsvärden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.3.4",
      "sentiment": 0.0,
      "quote": "Här kan även i sammanhanget tas upp hänsyn till kulturmiljöer som utmaning vid drivning och, för att utveckla förarlösa maskiner.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a2.1.4",
      "sentiment": 0.0,
      "quote": "Forskning bör även omfatta framtidens skogsskötsel i skogar där kulturmiljöer förekommer, för att utveckla brukningsmetoder som minimerar skador på kulturmiljöer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a2.2",
      "sentiment": 0.0,
      "quote": "I meningen som nämner ”miljövärden och sociala värden” bör även begreppet ”kulturmiljövärden” läggas till.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec834",
      "sentiment": 1.0,
      "quote": "Sidan 677 i del 2 så pratar man om aska förädlat med bioslam, vilket är ett bra sätt att förädla askan med bland annat kväve och fosfor.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4",
      "sentiment": 1.0,
      "quote": "LNU håller med utredaren om detta och pekar även på vikten av att använda mer av det som finns i skogen som GROT etc, att använda sidoströmmar i den skogsindustriella produktionskedjan mer optimalt, minska skogsskadorna, recirkulering (+bättre återväxt, skogsskötsel och ökad tillväxt).",
      "quote_type": "grund"
