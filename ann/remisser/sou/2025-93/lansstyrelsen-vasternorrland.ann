    },
    {
      "forarbete_id": "a4.3",
      "sentiment": -1.0,
      "quote": "Inblandning av substitutionsberäkningar är exempel på osäkra och inte verifierbara klimatnyttor.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.1.3",
      "sentiment": 0.5,
      "quote": "Det behövs för att kunna analysera status gentemot att uppfylla de nationella miljömålen liksom internationella åtaganden Sverige skrivit under.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.3.3",
      "sentiment": 0.5,
      "quote": "Ett krav på avsiktlighet kan bidra till ökad förutsebarhet, men tillämpningen måste fortsatt vara förenlig med EU-rätten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.4",
      "sentiment": -1.0,
      "quote": "Utredarens förslag om att försvaga skyddsinstrumentet genom att förenkla upphävande av naturreservat, exempelvis för att kostnaderna för skötseln av naturvärdena bedöms för höga eller att marken skulle kunna behövas för andra samhällsintressen, går således stick i stäv med lagstiftarens intentioner.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": 0.5,
      "quote": "Det behöver dock säkerställas att rådgivningen inkluderar skogens miljövärden på ett rättvisande sätt, inklusive ökad kunskap rörande hänsyn till vatten .",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.1",
      "sentiment": 0.2,
      "quote": "För att det ska vara meningsfullt bör det kopplas till åtgärdsmöjligheter och en mottagare, vilket dock inte riktigt beskrivs i utredningen förutom att skogsprogrammet nämns som möjlig arena för hanteringen av resultatet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.3",
      "sentiment": 1.0,
      "quote": "i syfte att förbättra möjligheterna för en tillsyn som är relevant för gott föryngringsresultat.",
