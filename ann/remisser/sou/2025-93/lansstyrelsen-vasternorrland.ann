    },
    {
      "forarbete_id": "a8.4.3",
      "sentiment": -1.0,
      "quote": "blir det kontraproduktivt att samtidigt avreglera en verksamhet som verkar i motsatt riktning utan analys och konsekvensberäkningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5.3",
      "sentiment": 1.0,
      "quote": "röjning är en viktig åtgärd i produktionsskogar för att skapa kvalitet och tillväxt på huvudstammar samt ge bättre ekonomi för gallringar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.8.3",
      "sentiment": 1.0,
      "quote": "Här finns möjligheter att exempelvis utveckla appar och olika digitala lösningar med platstjänster för att höja medvetandenivån hos allmänheten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.8.3",
      "sentiment": -1.0,
      "quote": "Länsstyrelsen bedömer, liksom Skogforsk att risker för insektsangrepp i eller i anslutning till skyddade områden endast är aktuellt i lokala fall, varför ett generellt uppdrag inte är påkallat.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.8.3",
      "sentiment": -0.5,
      "quote": "Länsstyrelsen föreslår i stället att MSB och länsstyrelserna får i uppdrag att fortsätta utveckla den vägledning som tagits fram kring eldningsförbud för att underlätta beslutsfattandet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.9.3",
      "sentiment": 1.0,
      "quote": "om ett tydligt mål att förebygga och begränsa skador orsakade av vilt författningsregleras",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.11.3",
      "sentiment": 0.5,
      "quote": "Detta kommer skapa en större robusthet i vägsystemet och göra det enklare att använda skogsbilvägar vid transporter eller vid exempelvis släckning av skogsbränder.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3",
      "sentiment": 1.0,
      "quote": "Med ökad efterfrågan på skogsråvara, klimatförändringar, nya regelverk och nya förväntningar på hur skogen ska brukas behövs ett forskningsprogram med fokus på skogsskötsel.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.1.2",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen stödjer förslaget 11.1.2 om ett stående forum för samhällsgemensam omvärldsbevakning när det gäller skogsfrågorna.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a11.2.2",
      "sentiment": -1.0,
      "quote": "Det är av yttersta vikt att både metoder och resultat tas fram evidensbaserat och inte styrs politiskt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.6",
      "sentiment": 1.0,
      "quote": "Detta ligger också i Miljömålsberedningens grunduppdrag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.7.9",
      "sentiment": 1.0,
      "quote": "Vi bedömer att flera men inte alla av de naturvärden som i dag ligger under preciseringen Bevarande av natur- och kulturmiljövärden redan täcks av andra preciseringar",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.8",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen anser att förslaget är bra då vi uppfattar att syftet är att tidigare kunna se trender som kommer ge utslag längre fram i tiden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.7",
      "sentiment": -1.0,
      "quote": "Miljömålet ska utgå från vad som krävs för att bevara biologisk mångfald och ekosystemens funktion, inte anpassas efter vad som för stunden bedöms möjligt att nå eller justeras efter andra mål.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.7.2",
      "sentiment": -1.0,
      "quote": "Länsstyrelsen anser att om det byggs in avvägningar direkt i definitionen av Levande skogar riskerar det att försvaga miljömålet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.7.3",
      "sentiment": -1.0,
      "quote": "Den fördjupade utvärderingen av ”Levande skogar” från 2023 visar att flera av ekosystemtjänsterna har en otillräcklig status (bland annat biologisk mångfald) och pekar ut detta som en av de viktigaste orsakerna till att målet inte nås.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.7.4",
      "sentiment": -1.0,
      "quote": "Rödlistan är idag den mest heltäckande indikatorn för arters bevarandestatus och fångar förändringar i många artgrupper.",
