    },
    {
      "forarbete_id": "a12.7.8",
      "sentiment": -1.0,
      "quote": "Om preciseringen begränsas till invasiva arter finns en tydlig risk att det förebyggande arbetet tappas bort för främmande arter som med dagens kunskap ännu inte klassats som invasiva.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": -1.0,
      "quote": "Riskerna med att föra in nya trädslag i stor skala är oöverskådliga och kommer förändra de skogliga ekosystemen i grunden.",
