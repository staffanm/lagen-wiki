  },
  "overall": {
    "sentiment": -0.3,
    "quote": "Länsstyrelsen anser att förslagen skulle behöva vägas tydligare mot den skada som kan uppstå, det vill säga hur stor nytta har åtgärden för produktionsmålet och hur stora konsekvenser kan uppstå för miljömålet.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a1.1",
      "sentiment": 0.5,
      "quote": "Länsstyrelsen anser att det är positivt om möjligheten till ersättning förenklas vid långtgående begränsningar till följd av fridlysningsbestämmelserna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.2",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen tillstyrker vidare tillägg i 4 § jaktlagen (1.2) om att förebygga och begränsa skador orsakade av vilt.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a1.3",
      "sentiment": -0.5,
      "quote": "Länsstyrelsen anser att ändringen i 7 kap. 7 § miljöbalken (1.3) är olämplig, då det är oklart när den kan tillämpas samt att negativa konsekvenser för naturmiljön riskeras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.7",
      "sentiment": -0.2,
      "quote": "Länsstyrelsens bedömning är att det redan i dagsläget finns en tröskel för när förbudet i 4 § 4 aktualiseras och ser inte att den föreslagna ändringen i sig innebär något förtydligande om hur denna tröskel ska bedömas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.10",
      "sentiment": 0.0,
      "quote": "det är inte tydligt hur länsstyrelsen ska arbeta med detta utöver vårt nuvarande uppdrag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.1",
      "sentiment": -0.2,
      "quote": "Ett sådant mål behöver kunna sträcka sig över tid och vara stabilt oavsett politisk majoritet, samtidigt behöver det finnas en flexibilitet för att möta förändringar i omvärlden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec549",
      "sentiment": -1.0,
      "quote": "Fornlämningar och kulturlämningar är en ändlig resurs och lättnader i lagstiftningen som innebär att de får förstöras behöver vägas mot deras värde.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.3",
      "sentiment": 0.5,
      "quote": "Det innebär en tydlighet för både myndigheter och markanvändare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.4",
      "sentiment": -1.0,
      "quote": "Länsstyrelsen anser att det inte är tydligt hur förslaget skulle bidra till produktionsmålet eller förenklingar för den enskilde markanvändaren, samtidigt som kostnaderna för staten kan bli höga och konsekvenserna för bevarandet av den biologiska mångfalden riskerar att bli betydande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen bedömer att mer statlig rådgivning efterfrågas av skogsbrukets aktörer och att det kan göra reell skillnad i skogen för att nå skogsvårdslagens båda mål.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.1",
      "sentiment": 0.2,
      "quote": "Detta är ett smalt mål som inte säger något om tillväxten inom sektorn i stort.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": -1.0,
      "quote": "Länsstyrelsen motsätter sig att underlätta etablering av främmande trädslag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4",
      "sentiment": 0.5,
      "quote": "I utformningen av föreskrifterna måste hänsyn tas till skogens varierande tillväxttakt i landet för att inte orsaka negativ påverkan på skogens kolinbindningspotential eller bundet kolförråd i marken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen anser att det är angeläget att Skogsstyrelsen inkluderar ungskogar i sin rådgivningsverksamhet (8.5).",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.6",
      "sentiment": -0.5,
      "quote": "Utredningen tar inte tillräcklig hänsyn till befintlig kunskap om gödslingens negativa påverkan på den biologiska mångfalden när markkemin ändras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.8",
      "sentiment": -1.0,
      "quote": "Länsstyrelsen bedömer, liksom Skogforsk , att det endast är aktuellt i lokala fall, varför ett generellt uppdrag inte är påkallat.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.9",
      "sentiment": 0.5,
      "quote": "Ett sådant mål kan öka tydligheten och ge ett större mandat för myndigheter och andra aktörer att arbeta mer aktivt med frågan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.6",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen tillstyrker förslaget att regeringen återkommande ger Miljömålsberedningen i uppdrag att föreslå etappmål för att tydligare styra miljömålsarbetet mot de uppsatta politiska målen (12.6).",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a12.7",
      "sentiment": -0.5,
      "quote": "Det är inte tydligt hur dessa förändringar skulle förbättra för vare sig produktions- eller miljömålet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.8",
      "sentiment": 0.5,
      "quote": "Detta ligger i linje med den europeiska klimatpolitiken och bör integreras i nationell uppföljning.",
      "quote_type": "grund"
    }
  ]
