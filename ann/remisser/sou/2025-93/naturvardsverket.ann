    },
    {
      "forarbete_id": "a8.4.3",
      "sentiment": -1.0,
      "quote": "Skyddsdikning är en åtgärd som kan ha negativa konsekvenser för miljö och klimat och behöver fortsatt kunna övervakas och följas upp.",
