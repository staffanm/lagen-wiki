  "segments": [
    {
      "forarbete_id": "sec477",
      "sentiment": -0.2,
      "quote": "Samtidigt ligger vissa delar av viltförvaltningen (läs Äbin) under Skogsstyrelsen och JRF ser risk för otydlighet avseende ansvar inom förvaltningen kring vem som äger frågan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec523",
      "sentiment": 0.5,
      "quote": "Förutsägbara spelregler är en viktig förutsättning för de flesta verksamheter, inte minst skogen med dess långa omloppstider.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.3",
      "sentiment": 0.2,
      "quote": "Framför allt ställer sig JRF bakom att det tydligt framgår att de ekonomiska konsekvenserna ska beaktas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.4",
      "sentiment": 1.0,
      "quote": "Om dessa skäl och syften inte längre föreligger finns det inte hellre något skäl att området eller biotopen är fortsatt skyddat.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7",
      "sentiment": 1.0,
      "quote": "Med rådande urbanisering av skogsägarkåren, kan en ökad rådgivning ge ökad skogstillväxt vilket sannolikt skulle öka mängden foder för viltet och på sätt även minska skadorna av vilt i skogslandskapet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.1",
      "sentiment": 1.0,
      "quote": "Med utgångspunkt i att de förnybara naturresurserna ska brukas, ställer sig JRF positiva till att det finns tydliga produktionsmål för skogen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": -0.2,
      "quote": "Angående främmande trädslag så bör det även utvärderas utifrån hur de påverkar viltet direkt, samt de eventuella sidoeffekterna på viltets bete av till exempel bärris, som en större andel främmande trädslag kan innebära.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4",
      "sentiment": 1.0,
      "quote": "Risken minskar även för skador av viltbete om tillfredsställande föryngringsresultat uppnås så tidigt som möjligt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec765",
      "sentiment": 1.0,
      "quote": "JRF ställer sig även bakom det slopade underrättlsekravet i skogsvårdslagstiftningen kring skyddsdiknig.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.6",
      "sentiment": -0.5,
      "quote": "JRF ställer sig tveksamt till detta då gödsling potentiellt minskar mängden bärris vilket är en viktig föda för viltet, vilket i sin tur kan leda till ökade skador av vilt både i skogen samt i odlingslandskapet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7",
      "sentiment": 1.0,
      "quote": "Ett möjligt scenario är att med ökad kvalitet och kvantitet på fodret minskar betningen på produktionsstammarna och därmed minskade beteskador.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec860",
      "sentiment": 0.5,
      "quote": "Vi ser i många fall att jakt inte tillåts i reservaten av slentrian. Detta blir då en fristad för viltet med ökad risk för skador inom själva reservatet, men även på omkringliggande fastigheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.2",
      "sentiment": -1.0,
      "quote": "Om skogsutredningen har som ambition att införa nationella mål i lagtext för vilka skador markägare ska tvingas acceptera innebär det enligt JRF en oacceptabel inskränkning av äganderätten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.11",
      "sentiment": 1.0,
      "quote": "ett bra skogsbilvägnät underlättar den praktiska förvaltningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.1",
      "sentiment": 1.0,
      "quote": "JRF ställer sig bakom detta arbetssätt och ser även gärna att det kan appliceras inom det internationella arbetet kring viltförvaltning i allmänhet, och rovdjursförvaltningen i synnerhet",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec1039",
      "sentiment": 1.0,
      "quote": "JRF ställer sig bakom detta.",
