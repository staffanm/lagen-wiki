  "overall": {
    "sentiment": -0.4,
    "quote": "Vi bedömer att utredningens förslag, i och med att de till stor del är kortsiktiga och i vissa fall kan skapa osäkerhet, inte är till fördel för skogsnäringens långsiktiga utveckling.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a1.1",
      "sentiment": 1.0,
      "quote": "det behöver säkerställas att ersättning enligt denna regel har en budget som regleras efter behov och omhändertas löpande i efterföljande budgetår för att markägare inte ska bli lidande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.10",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen tillstyrker förslag om Förslag till förordning om ändring i förordningen (2017:868) med länsstyrelseinstruktion (1.10)",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": -1.0,
      "quote": "Länsstyrelsen anser att det är förknippat med flera risker att introducera nya trädarter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.2",
      "sentiment": -0.5,
      "quote": "Förslaget kring förtydligandet i Jaktlagens 4 § (1.2) anser länsstyrelsen är onödigt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.3",
      "sentiment": -1.0,
      "quote": "Ändringen i miljöbalken 7 kap, 7§ (1.3) är olämplig, då det är oklart när den kan tillämpas samt att negativa konsekvenser för naturmiljön riskeras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.7",
      "sentiment": 0.0,
      "quote": "Om förslaget om ändring av artskyddsförordningen (1.7) är kompatibelt med gällande EU-rätt är svårt att bedöma innan EU-kommissionens vägledning för fågeldirektivet är på plats.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.5",
      "sentiment": -1.0,
      "quote": "De behov som finns kan mötas med utveckling av befintliga skyddsformer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.3",
      "sentiment": -1.0,
      "quote": "Nuvarande modeller bör behållas för kontinuitet och för att säkerställa att beräkningar görs likartat mellan länder.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.1",
      "sentiment": 1.0,
      "quote": "För att undvika osäkerheter och för att få långsiktiga stabila förutsättningar för såväl investeringsviljan som naturvårdsarbetet i skogen är en bred politisk överenskommelse nödvändig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.2",
      "sentiment": -0.5,
      "quote": "Det är omöjligt att i förväg veta vilka lämningar som är mest skyddsvärda.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.2",
      "sentiment": 0.5,
      "quote": "det är viktigt att metodiken innefattar en uppföljning av hänsynstagandets långsiktiga ekologiska funktion och effekt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.3",
      "sentiment": 0.2,
      "quote": "Regionala och lokala förteckningar av fågelarter ger en överblick som idag saknas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.4",
      "sentiment": 0.5,
      "quote": "Det är rimligtvis väldigt sällsynt att något av syftena inte längre skulle vara rimliga att uppnå.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.4",
      "sentiment": -1.0,
      "quote": "Den låga kravnivån ”skäl” innebär i princip att ingen avvägning görs mellan det allmännas och den enskildes intresse avseende upphävandet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7",
      "sentiment": 1.0,
      "quote": "Länsstyrelserna bedömer att mer statlig rådgivning efterfrågas av skogsbrukets aktörer och kan göra reell skillnad i skogen för att nå skogsvårdslagens båda mål.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.1",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen tillstyrker förslagen i de två strecksatserna.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.4",
      "sentiment": 0.5,
      "quote": "förutsatt att dagens anmälningskrav enligt samrådsbestämmelserna i miljöbalken kvarstår",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4",
      "sentiment": 1.0,
      "quote": "Länsstyrelserna tillstyrker förslaget att Skogsstyrelsen får i uppdrag att se över sina föreskrifter om föryngringsåtgärder, i syfte att förbättra möjligheterna för en tillsyn som är relevant för att gott föryngringsresultat",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5",
      "sentiment": 1.0,
      "quote": "Länsstyrelserna anser att det är angeläget att Skogsstyrelsen inkluderar ungskogar i sin rådgivningsverksamhet",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.6",
      "sentiment": -1.0,
      "quote": "De negativa konsekvenserna kommer att orsaka negativ påverkan på bland annat biologisk mångfald och med oklara konsekvenser för markens långsiktiga produktivitet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7",
      "sentiment": 1.0,
      "quote": "Askåterföringen behöver styras till rätt områden ur försurningssynpunkt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.8",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen anser att det behövs en flexiblare syn på att åtgärda skador från främst granbarkborre i naturreservat än tidigare och därmed också begränsa eventuell spridning av granbarkborre från naturreservaten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.9",
      "sentiment": -1.0,
      "quote": "Den föreslagna ändringen gör att nuvarande utgångspunkt för viltförvaltningen att balansera olika intressen, ändras till att tillgodose i första hand ett intresse (begränsa skador).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9",
      "sentiment": 1.0,
      "quote": "Med ökad efterfrågan på skogsråvara, klimatförändringar, nya regelverk och nya förväntningar på hur skogen ska brukas behövs ett forskningsprogram med fokus på skogsskötsel.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.7",
      "sentiment": -1.0,
      "quote": "Länsstyrelsen bedömer att både Skogsstyrelsen och Naturvårdsverket redan idag utgår från vetenskap och beprövad erfarenhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.2",
      "sentiment": -1.0,
      "quote": "För att inte tappa kompetens och för att vidmakthålla evidenskraven bör de nationella expertmyndigheterna involveras även fortsättningsvis.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.6",
      "sentiment": 1.0,
      "quote": "Detta ligger också i Miljömålsberedningens grunduppdrag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.7",
      "sentiment": -1.0,
      "quote": "Definitionen i förnybarhetsdirektivet tar inte hänsyn till brukningshistorien i Sverige där mycket få hela skogsområden har en snittålder över 180 år.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.7",
      "sentiment": -1.0,
      "quote": "Samtliga miljökvalitetsmål om naturtyper har preciseringar om ekosystemtjänster och utredningen förklarar inte varför just Levande skogar inte bör ha det.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.7",
      "sentiment": -1.0,
      "quote": "Det är mycket få arter som har ett åtgärdsprogram jämfört med samtliga rödlistade arter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.8",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen tillstyrker förslaget om att till miljökvalitetsmålet begränsad klimatpåverkan (12.8) tillföra uppdrag till Naturvårdsverket avseende förslag på indikatorer för att följa LULUCF samt uppdraget till Miljömålsutredningen att ta fram förslag på åtgärder för att beskoga lämpliga markområden.",
      "quote_type": "standpunkt"
