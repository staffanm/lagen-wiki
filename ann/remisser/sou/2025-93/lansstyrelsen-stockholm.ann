    },
    {
      "forarbete_id": "a5.3",
      "sentiment": 0.0,
      "quote": "Mot bakgrund av EU-domstolens nyligen meddelade avgörande den 1 augusti 2025 i mål C 784/23, OÜ Voore Mets m.fl. bedöms ändringen få en begränsad praktisk betydelse i ärenden gällande skogsbruket.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.4.3",
      "sentiment": -1.0,
      "quote": "Detta skulle försvaga naturreservatinstrumentets funktion att långsiktigt bevara biologisk mångfald, vårda och bevara värdefulla naturmiljöer eller tillgodose behov av områden för friluftslivet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": 1.0,
      "quote": "Myndighetssamverkan mellan Skogsstyrelsen, Riksantikvarieämbetet och länsstyrelserna kan skapa tydlighet och bygga upp kunskapen hos skogsägare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": -0.5,
      "quote": "Konsekvenserna med att införa nya trädslag är oöverskådliga och kan förändra de skogliga ekosystemen i grunden, med risker inte bara för miljö utan också för produktion.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.6",
      "sentiment": -1.0,
      "quote": "Tillförande av gödning förändrar skogens ekosystem i grunden och motverkar miljökvalitetsmålet ”Ingen övergödning”.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7",
      "sentiment": 1.0,
      "quote": "Askåterföring innebär en återföring av baskatjoner och fosfor som förs bort vid avverkningen.",
