    },
    {
      "forarbete_id": "a5.2.2",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen instämmer i utredarens problembeskrivning att det finns brister i uppföljning av hänsyn och brister vad gäller hänsyn vid vattendrag och kulturmiljöer.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a5.2.3",
      "sentiment": -0.5,
      "quote": "Förslagen bör kompletteras med en riktad satsning på en bättre uppföljning av hänsyn.",
