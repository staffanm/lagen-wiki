  "segments": [
    {
      "forarbete_id": "a3.2.3",
      "sentiment": -0.5,
      "quote": "Att grunda analysen på scenarier från Skogsstyrelsens rapport från 2022 blir för snävt med tanke på frågans komplexitet och de betydande osäkerheter som finns.",
