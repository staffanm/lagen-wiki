  "segments": [
    {
      "forarbete_id": "a8.1",
      "sentiment": 0.8,
      "quote": "Detta tycker Högsby kommun är en viktig aspekt, att dessa båda gränsdragningar klargörs mellan målen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2",
      "sentiment": 0.5,
      "quote": "Högsby kommun anser att skogen som resurs är viktig och att balansen mellan de olika skogstyperna; gran- tall- och ädellövskog behöver harmonieras för att kunna nå ovanstående krav.",
