      "artifact:remisser/sou/2025:93/skogforsk": "a0228ce2f34e481ebc134df58478f34921aa7411f8a33082139bd61f33027a31",
      "artifact:forarbete/sou/2025-93": "201aa2c9468bea44887a18a07b9556294fb64c34f2aea6d2f31ad09b58f302f0"
    }
  },
  "overall": {
    "sentiment": 0.8,
    "quote": "Skogforsk anser att utredningen gjort ett omfattande och mycket gediget arbete som väl svarar mot utredningsdirektivet.",
    "quote_type": "standpunkt"
  },
  "segments": [
    {
      "forarbete_id": "a4.3",
      "sentiment": 0.8,
      "quote": "Skogforsk delar bedömningen att ISO 13391 är ett användbart verktyg att öka tydligheten och att det är högsta prioritet på att fasa ut fossila energibärare och material så snabbt och långt som möjligt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.1.3",
      "sentiment": 1.0,
      "quote": "Ett sådant ställningstagande bedöms vara viktigt för att skapa ökad tydlighet i den nationella skogspolitiken och stärka en långsiktig investeringsvilja i skogen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.2.3",
      "sentiment": 1.0,
      "quote": "En utvecklad och stabil uppföljningsmetod är central för att skapa transparens, möjliggöra likvärdig tillämpning över hela landet och ge ett bättre underlag för både tillsyn, rådgivning och fortsatt utveckling av skogspolitiken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": 1.0,
      "quote": "Det evidensbaserade arbetssättet som föreslås i Kap. 10 utgör en mycket viktig grund också för rådgivningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.1",
      "sentiment": 0.8,
      "quote": "Klimatförändringarna ställer allt större krav på förädlingen: materialet ska klimatanpassas, nya egenskaper blir viktiga såsom torktolerans och tolerans mot skadegörare, och det finns också behov av att förädla fler arter inklusive främmande trädslag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.2",
      "sentiment": 1.0,
      "quote": "Odling av plantor på plantskolor står inför stora utmaningar, inte minst på grund av ökande problem med skadegörare, och vi är därför positiva till förslagen i avsnitt 8.2.2 för att förbättra den situationen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3.3",
      "sentiment": 0.2,
      "quote": "det är en komplex fråga där inte bara lagar och regleringar begränsar utan även certifieringsregler.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.3",
      "sentiment": 1.0,
      "quote": "Forskningen behöver fånga förändrade klimataspekter, blandskogsetablering och skötsel samt etablering och skötsel av lövdominerade bestånd såväl som främmande trädslag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5.3",
      "sentiment": 1.0,
      "quote": "Vi delar utredarens bedömning om behovet av att utveckla en strukturerad och kontinuerlig uppföljning av ungskogen i Sverige för att kunna analysera var forskning och utveckling behöver sättas in för att utveckla skötseln under denna kritiska period av skogens omloppstid.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.6.3",
      "sentiment": 0.4,
      "quote": "I det sammanhanget påtalas den osäkerhet som finns rörande tillväxteffekten av kvävegödsling på de mest bördiga markerna i Sverige.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.4",
      "sentiment": -0.2,
      "quote": "Här vill vi påtala att försöksunderlaget för tillväxteffekter av asktillförsel på fastmark är begränsat, både i Sverige och internationellt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.8.3",
      "sentiment": 0.8,
      "quote": "Vi vill dock peka på att det fortfarande finns SLU-regelverk som försvårar bredare samarbeten utanför SLU, något som är viktigt för att få stor tillämpbar utdelning på satsningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.11.3",
      "sentiment": 1.0,
      "quote": "Flera av utredarens lösningsförslag ligger i linje med den strategi som Skogforsk, tillsammans med skogsbranschen, har varit delaktig i att utforma.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3",
      "sentiment": 1.0,
      "quote": "Detta är mycket angeläget att, vid sidan av mer grundläggande forskning som bygger förståelse för olika mekanismer, ha tillgång till en lång och bred serie av långtidsförsök i fält.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.7",
      "sentiment": 1.0,
      "quote": "Sättet på vilket verksamheten bör bedrivas på ett forskningsinstitut ansluter mycket väl till strukturen som beskrivs för (idealbilden av) den evidensbaserade beslutsprocessen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.1.2",
      "sentiment": 0.5,
      "quote": "Utredningens förslag om en samordnande funktion skulle troligen underlätta kommunikation och tydlighet i linjen mellan policy och forskning, vilket i förlängningen kan komma till uttryck genom forskningsutlysningar som är bättre anpassade även till nationella behov och prioriteringar.",
      "quote_type": "grund"
    }
  ]
}