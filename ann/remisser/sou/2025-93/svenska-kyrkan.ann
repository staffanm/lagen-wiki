  "segments": [
    {
      "forarbete_id": "a3.4.2",
      "sentiment": 0.2,
      "quote": "Med anledning av att utredaren bedömer att hänsyn till rennäringen inte omfattas av sektorsansvaret vill Svenska kyrkan understryka att det är mycket angeläget att detta arbete ändå stärks och prioriteras av sektorn.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.3.2",
      "sentiment": 1.0,
      "quote": "Att väga in denna faktor underlättar förståelsen av skogsbrukets klimaterbjudande om ett på sikt klimatneutralt system som bidrar till att vi kan bryta fossilberoendet samtidigt som förnybara nyttigheter levereras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec16",
      "sentiment": 1.0,
      "quote": "Det är angeläget att komma ifrån nuvarande, mer händelsestyrda situationer där myndigheternas resurser till stor del läggs på artskyddsärenden som uppkommer i samband med avverkningsanmälningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.1.5",
      "sentiment": 1.0,
      "quote": "Svenska kyrkan bedömer, liksom utredningen, att naturvårdande skötsel av befintliga skyddade områden är en åtgärd med stor potential, inte minst eftersom flera värden, till exempel rekreationsvärden och biologisk mångfald, kan gynnas samtidigt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec549",
      "sentiment": 1.0,
      "quote": "Svenska kyrkan bedömer att en sådan förändring är en framkomlig väg för att hitta en rimlig balans mellan hållbar produktion och kulturmiljöhänsyn samt ger en inriktning för de bedömningar och prioriteringar som måste ske.",
      "quote_type": "grund"
