      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec1335",
      "sentiment": -1.0,
      "quote": "Att så som föreslås i utredningen korta ned denna anmälningstid till tio dagar skulle innebära en ohållbar situation för ansvariga tillsynsmyndigheter att utöva tillsyn.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.7",
      "sentiment": -1.0,
      "quote": "Skydda Skogen anser att det för Sveriges trovärdighet mot EU-systemet när det gäller artskyddsfrågorna är viktigt att beslutanderätten i frågor på skogsmark inte ligger helt hos Skogsstyrelsen, den myndighet som har som en av sina viktigaste uppgifter att främja skogsbruket.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.1",
      "sentiment": -1.0,
      "quote": "Det bör alltid råda anmälningsskyldighet för skogsbilvägar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.1",
      "sentiment": 1.0,
      "quote": "Allmänheten måste ha rätt till insyn och att få lagar och myndighetsbeslut prövade.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.3",
      "sentiment": -1.0,
      "quote": "Markägaren bör kunna ta en större del av kostnaden och ansvar för utredning och undersökningar för att motverka skada på arter och naturvärden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.5",
      "sentiment": -1.0,
      "quote": "Den föreslagna skyddsformen stör helt logiken i 7 kap 11 § miljöbalken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.3",
      "sentiment": -1.0,
      "quote": "Det framstår som mycket märkligt att anmälningsskyldigheten för till exempel kalavverkning ska bedömas olika beroende på vem som är fastighetsägare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.4",
      "sentiment": -1.0,
      "quote": "I huvudförslaget anser föreningen att texten bör ändras så att byggande av skogsbilväg och traktorväg alltid är anmälningspliktig.",
      "quote_type": "grund"
    }
  ]
