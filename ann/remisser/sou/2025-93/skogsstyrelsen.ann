  },
  "segments": [
    {
      "forarbete_id": "a4.3",
      "sentiment": -1.0,
      "quote": "förslaget avstyrks eftersom det befintliga systemet redan inkluderar skogsbiomassans bidrag till minskade utsläpp, genom rapportering i andra sektorer än LULUCF-sektorn.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.1.3",
      "sentiment": 0.5,
      "quote": "Med förslaget finns potential att lösa eller minska en av de tidsmässigt längsta och största målkonflikterna i skogen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.2.3",
      "sentiment": 0.5,
      "quote": "förslaget ligger nära hur berörda myndigheter redan arbetar idag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.3.3",
      "sentiment": -1.0,
      "quote": "Skogsstyrelsen avstyrker förslaget mot bakgrund av den EU dom som tillkommit på området.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.4.3",
      "sentiment": -1.0,
      "quote": "bedömer att nuvarande lagstiftning redan innefattar den möjligheten och avstyrker därför förslagen i detta avsnitt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.5.3",
      "sentiment": -1.0,
      "quote": "utredningens förslag inte var tillräckligt utrett, saknade önskad tydlighet och inte bedömdes vara tillräckligt rättssäker.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": 0.0,
      "quote": "ett sådant medelstillskott bör ske via anslaget 1:1 eftersom en sådan styrning ökar flexibiliteten för myndigheten i att genomföra riskdagens och regeringens skogspolitik.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.1.3",
      "sentiment": 0.2,
      "quote": "Risken är att mål sätts utifrån politiska prioriteringar, inte utifrån alla enskilda företags- och markägares målsättning som divergerar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.1",
      "sentiment": -1.0,
      "quote": "en eventuell uppdatering av föreskrifterna, i enlighet med samma rapport, bör grundas på erfarenheter från ett införande av vegetativt förökat material genom adaptiv förvaltning vilket ännu inte föreligger.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3.3",
      "sentiment": 0.0,
      "quote": "Ytterligare utredning behövs för att avgöra hur en reglering kring begränsningen av främmande trädarter bör se ut.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.3",
      "sentiment": -1.0,
      "quote": "Myndigheten gör bedömningen att en översyn av föreskrifter (och allmänna råd) inte lämpligen görs inom ramen för regeringsuppdrag utan i stället inom ramen för myndighetens sedvanliga uppföljning och arbete med gällande föreskrifter och allmänna råd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5.3",
      "sentiment": 0.5,
      "quote": "ett välfungerande och samordnat statistiksystem är en förutsättning för en robust och kunskapsbaserad skogspolitik.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.8.3",
      "sentiment": -1.0,
      "quote": "Myndigheten gör bedömningen att en översyn av föreskrifter (och allmänna råd) inte lämpligen görs inom ramen för regeringsuppdrag utan i stället inom ramen för myndighetens sedvanliga uppföljning och arbete med gällande föreskrifter och allmänna råd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.9.3",
      "sentiment": 1.0,
      "quote": "tillstyrker förslaget om ett tydligare mål att förebygga och begränsa skador orsakade av vilt författningsregleras samt att ett tillägg görs i Skogsstyrelsens instruktion om att myndigheten ska medverka till att begränsa och förebygga skador av vilt i skogen.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.11.3",
      "sentiment": 1.0,
      "quote": "Utredningens förslag ligger i huvudsak i linje med den nationella strategin för enskilda vägar som tagits fram av skogsnäringen, jordbruket, åkerinäringen och enskilda väghållare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.7",
      "sentiment": 0.0,
      "quote": "Skogsstyrelsens bedömning är att myndigheten redan idag utgår från detta.",
