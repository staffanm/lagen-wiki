    },
    {
      "forarbete_id": "a11.1.2",
      "sentiment": 0.5,
      "quote": "kostnadsaspekten som en begränsande faktor i nuvarande system.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.2.2",
      "sentiment": -0.5,
      "quote": "En sådan ordning skulle enligt Skogsstyrelsen riskera att stå i strid med den grundläggande principen i lagen (2001:99) om den officiella statistiken, som anger att statistiken ska vara objektiv och självständig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.6",
