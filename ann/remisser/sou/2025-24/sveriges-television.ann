  "segments": [
    {
      "forarbete_id": "a11.1",
      "sentiment": 1.0,
      "quote": "SVT har inga invändningar mot förslaget om tydligare nationella filmpolitiska mål.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a11.2",
      "sentiment": 1.0,
      "quote": "SVT instämmer i förslagen om ett oberoende och framtidsinriktat filminstitut med tydliga ramar för statsbidraget och där fokus ligger på film.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a11.3",
      "sentiment": 0.5,
      "quote": "Av det skälet anser SVT att det bör skapas garantier för att filmfonden också i fortsättningen har medel som avsätts för publikrelaterat stöd, produktionsincitament, stöd till större filmproduktioner och branschgemensamma insatser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.5",
      "sentiment": 0.5,
      "quote": "SVT anser att det är rimligt att alla aktörer som är verksamma i Sverige för en svensk publik, och vars verksamhet genererar intäkter på den svenska marknaden, är med och bidrar till svenskt innehåll, genom faktiska investeringar och samproduktioner, eller på annat sätt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.6",
      "sentiment": 0.2,
      "quote": "Med den föreslagna urvalsprincipen finns samtidigt en risk att ett fåtal produktioner konsumerar upp hela budgeten för produktionsincitamentet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.8",
      "sentiment": 0.5,
      "quote": "SVT delar utredningens bedömning att uppgiften att bevara det svenska filmarvet är en av statens kulturpolitiska kärnuppgifter och att bevarandet av det analoga materialet kan komma att kräva omfattande insatser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.1",
      "sentiment": -0.2,
      "quote": "För att undvika otydlighet föreslår SVT att ett annat begrepp än det föreslagna används.",
      "quote_type": "grund"
