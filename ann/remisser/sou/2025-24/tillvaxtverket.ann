  "overall": {
    "sentiment": 0.2,
    "quote": "Tillväxtverket är positiv till att utredningen följer idén med en nationell strategi för kulturella och kreativa branscher genom att öppna upp för politiska samarbeten och ge möjligheten för flera finansieringskällor att bidra till en filmfond.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a11.6",
      "sentiment": 1.0,
      "quote": "Nuvarande förordning, 2022:1386 om statligt stöd till produktion av audiovisuella verk, har en tydlig näringspolitisk inriktning genom att i §1 tydliggöra att ”syftet med stödet är att öka antalet audiovisuella verk som produceras i Sverige”. Men utmaningen är att stödet inte är utformat för att i praktiken kunna bidra till näringspolitiska effekter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.6",
      "sentiment": -0.2,
      "quote": "Tillväxtverket anser att det behöver tydliggöras då styrningen är avgörande för hur stödet kan organiseras och vilka direkta resultat och långsiktiga effekter man kan förvänta sig att ett produktionsincitament ska åstadkomma.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.6",
      "sentiment": -0.2,
      "quote": "det finns en problematik med förskjutning mellan årsvisa beslut och utbetalningar vilket utredningen även noterar i sin beskrivning av stödet att ”beslut och faktiskt utbetalade medel är två olika saker”.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.6",
      "sentiment": 0.5,
      "quote": "Om en ny konstruktion av produktionsincitamentet ska ”attrahera näringspolitiska medel” är det rimligt att utgå ifrån att dessa också ska riktas mot att leda till näringsmässig utveckling.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.6",
      "sentiment": -0.5,
      "quote": "Tillväxtverket ser risker med i att 8 § ta bort eller sänka kravet på säkrad finansiering för mycket utan att säkerställa produktionens faktiska genomförbarhet i ansökansstadiet",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.6",
      "sentiment": -0.2,
      "quote": "Det är otydligt om 10 § avser när hela produktionen startar i Sverige eller om det även avser när den del av produktionen som ansökan avser startar i Sverige, exempelvis efterproduktion och/eller VFX.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.6",
      "sentiment": -0.2,
      "quote": "I linje med utredningens förslag så finns det fog för att fokusera på nationella mål med produktionsincitament men det är en markant skillnad mot nuvarande förordning och ändrar inriktning för produktionsincitamentets målgrupp.",
      "quote_type": "grund"
    }
