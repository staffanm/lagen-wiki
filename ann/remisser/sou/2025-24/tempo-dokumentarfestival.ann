  "overall": {
    "sentiment": 0.2,
    "quote": "Betänkandet innehåller flera välgrundade förslag, men vi ser också behov av förtydliganden och kompletteringar för att åstadkomma en verkligt hållbar och inkluderande filmpolitik.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a5.2.6",
      "sentiment": -0.2,
      "quote": "I dagsläget används termen med olika betydelser i både utredningen och det filmpolitiska ramverket, vilket riskerar att skapa osäkerhet kring vilka format och uttryck som omfattas av stöd och reglering.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec14",
      "sentiment": 1.0,
      "quote": "Det är en nödvändig åtgärd för att likställa biografen med andra kulturformer och förbättra tillgängligheten för publiken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec11",
      "sentiment": 0.5,
      "quote": "Det är avgörande att filmpolitiken vilar på kunskap, transparens och en långsiktig helhetssyn.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.2.7",
      "sentiment": -0.5,
      "quote": "Vi saknar en fördjupad diskussion om de potentiellt genomgripande konsekvenserna av den snabba utvecklingen inom artificiell intelligens – särskilt för verk med sanningsanspråk, såsom dokumentärfilm.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.2",
      "sentiment": -0.5,
      "quote": "Särskilt de mindre aktörer som aktivt arbetar för att sprida film till alla delar av landet – ofta med begränsade resurser – får begränsat utrymme i betänkandet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec39",
      "sentiment": -0.2,
      "quote": "Ett filmpolitiskt ekosystem där dessa aktörer trängs undan riskerar att kraftigt begränsa filmens konstnärliga och geografiska bredd, och därmed minska både publikt genomslag och samhällelig relevans på sikt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.2.6",
      "sentiment": -0.5,
      "quote": "Risken med att frågan främst hänvisas till regional och kommunal nivå är att satsningar blir ojämna och kortsiktiga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.2.5",
      "sentiment": -0.5,
      "quote": "Om ambitionen är att film ska visas i hela landet och att ett brett utbud av svensk och internationell kvalitetsfilm ska nå publiken, krävs att förutsättningarna för visningsmångfald också analyseras ur ett marknadsrättsligt och konkurrenspolitiskt perspektiv.",
      "quote_type": "grund"
    }
  ]
}