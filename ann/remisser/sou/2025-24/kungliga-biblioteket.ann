  "segments": [
    {
      "forarbete_id": "a9.2",
      "sentiment": 1.0,
      "quote": "Det föreligger ett nationellt behov av ändamålsenliga magasin för analog film där institutioner med filmsamlingar, med utgångspunkt i deras respektive uppdrag, kan magasinera filmsamlingar på ett kostnadseffektivt sätt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2.1",
      "sentiment": 1.0,
      "quote": "KB ser därför att det kan finnas skäl för att nationellt samla såväl kompetens som teknik, vilket ligger i linje med utredarens förslag om att utreda förutsättningarna för inrättandet av ett nationellt filmarvscentrum.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.1",
      "sentiment": 1.0,
      "quote": "Fokus ligger på forskningens behov av tillgång till filmarvet, vilket kräver att materialet är tillgängligt i digital form.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.4.1",
      "sentiment": -0.5,
      "quote": "Eftersom film idag publiceras i många olika typer av visningsfönster och att filmbegreppet i sig blir alltmer svårfångat är det en stor fördel om en och samma institution ansvarar för pliktinsamling av film oavsett var den publicerats eller av vem.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5",
      "sentiment": 1.0,
      "quote": "Det kan till exempel handla om att förtydliga nuvarande uppdrag och ansvarsfördelning mellan KB, Filminstitutet och SVT.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.8",
      "sentiment": 1.0,
      "quote": "KB stödjer förslaget om en utredning av ett kostnadsberäknat Filmarvscentrum för bevarande och digitisering av analogt filmmaterial, liksom att KB ska medverka i denna utredning.",
      "quote_type": "standpunkt"
    }
