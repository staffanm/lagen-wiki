  "segments": [
    {
      "forarbete_id": "a11.1",
      "sentiment": 0.5,
      "quote": "Men vi saknar ett uttalat filmpolitiskt mål avseende film för barn och unga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.4",
      "sentiment": 1.0,
      "quote": "Att även biobiljetter ska ha en kulturmoms, likt teater och konserter, anser vi vara en självklarhet och något vi jobbat för länge.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.2",
      "sentiment": 0.5,
      "quote": "Vi anser att Svenska Filminstitutets huvudfokus ska vara långfilm för bio.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": 1.0,
      "quote": "Det är bra med ett förtydligande av vilka stödformer som ska finnas och hur de ska användas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3",
      "sentiment": 1.0,
      "quote": "Vi anser att det är självklart att de som direkt eller indirekt är med och finansierar svensk film och Filmfonden ska vara dem som styr fonden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.5",
      "sentiment": 0.5,
      "quote": "Det bör vara en tydlig uppdelning av stöden och tydliga direktiv av vilka stöd som ska gå till vad.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.6",
      "sentiment": -0.5,
      "quote": "Detta för att det kommer att ge produktioner av TV-serier (som oftast har en större budget än en långfilm) större chans till stöd genom produktionsincitamentet och risken är påtaglig att pengarna enbart räcker till TV-serier.",
      "quote_type": "grund"
