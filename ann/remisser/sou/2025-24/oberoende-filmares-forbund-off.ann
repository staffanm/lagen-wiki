    },
    {
      "forarbete_id": "sec229",
      "sentiment": -0.5,
      "quote": "Detta är problematiskt, då det innebär att staten styr konstnärliga uttryck genom reglering, snarare än att främja mångfald och konstnärlig frihet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec227",
      "sentiment": -0.5,
      "quote": "Utan nationellt stöd förstärks denna osäkerhet, vilket i sin tur försvårar för nya röster att ta plats.",
