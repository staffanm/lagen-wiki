  "segments": [
    {
      "forarbete_id": "a11.4",
      "sentiment": 1.0,
      "quote": "Med dessa föreslagna förändringar tror vi likt utredarna att intresset för bio kommer att öka, fler kommer att kunna prioritera biografbesök, i synnerhet i delar av landet där inkomsten är lägre och i familjer där man måste prioritera vilka kulturella aktiviteter man kan delta på.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec239",
      "sentiment": 1.0,
      "quote": "Den föreslagna undantagsregeln för biografer med 6 föreställningar eller mindre per vecka kommer dessutom att hjälpa biografer i små orter och garantera fortlevnad för biografer i hela landet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.5",
      "sentiment": 1.0,
      "quote": "Som helhet ser vi att staten kommer att gå plus ekonomiskt om det föreslagna förslaget nu genomförs.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec134",
      "sentiment": 1.0,
      "quote": "Vi ser positivt på att Filmfonden möjliggör mer incitamentsliknande stöd, publikrelaterat stöd och stöd till större filmproduktioner då dessa typer av stöd är nödvändiga för att kunna finansiera produktionen av film som folk vill se på bio.",
