    }
  },
  "overall": {
    "sentiment": 0.2,
    "quote": "Mot denna bakgrund anser Dramatikerförbundet att en förstärkning av resurserna till svensk film är helt nödvändig, och vi ställer oss därför bakom Filmutredningens förslag om en höjd finansieringsnivå.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "sec134",
      "sentiment": -0.2,
      "quote": "I dagsläget får inte manusförfattare ta del av detta stöd trots att deras bidrag till filmverket är en av faktorerna som avgör filmens framgång och därmed direkt påverkar om filmen kommer kvalificera för stödet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.2.7",
      "sentiment": 0.5,
      "quote": "Det är därför en nödvändig förutsättning för en hållbar filmbransch att AI-modeller endast tränar på upphovsrättsskyddat material om materialet har licensierats.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.1",
      "sentiment": -0.2,
      "quote": "De nya målen är mer generella och riskerar att styra mot kvantitativa resultat snarare än att värna om viktiga kulturpolitiska kvaliteter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3",
      "sentiment": -0.5,
      "quote": "Det finns en uppenbar risk att denna struktur leder till en snedvridning av maktbalansen, där de ekonomiska intressena hos biografägare och strömningstjänster prioriteras framför upphovspersonernas kreativa frihet och rättigheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.4",
      "sentiment": 0.2,
      "quote": "Men avsaknad av mekanismer som säkerställer att momssänkningen vidareförs till publiken, finns en tydlig risk att stödet inte får avsedd effekt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.5",
      "sentiment": 0.5,
      "quote": "Då flertalet andra länder inom EES-området har infört avgifter genom en implementering av artikel 13(2) i AVMS-direktivet riskerar utformningen av ordalydelsen i § 6 att leda till att strömningstjänsterna inte behöver betala någon avgift i Sverige.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.6",
      "sentiment": -0.5,
      "quote": "Problematiken med denna skrivning är att det innebär att definitionen av en producent kräver att producenten förvärvar rättigheter och definitionen av ett förvärv kan tolkas som ett övertagande av äganderätten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.8",
      "sentiment": -0.2,
      "quote": "Vi välkomnar att utredningen lyfter filmens kulturarv, men anser att de föreslagna åtgärderna är för övergripande och saknar tydlighet kring ansvar och finansiering.",
      "quote_type": "grund"
    }
  ]
}