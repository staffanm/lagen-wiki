    },
    {
      "forarbete_id": "a11.1",
      "sentiment": -0.5,
      "quote": "Vi ser en stor risk att den nationella filmpolitiken ytterligare kommer att osynliggöra en målgrupp som de facto är framtidens biopublik och filmskapare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.1",
      "sentiment": -0.5,
      "quote": "Detta mål är direkt kopplat till regionernas talangutvecklingsverksamhet, regional filmproduktion och är angeläget för att nationellt nå till ett starkare filmland.",
