    {
      "forarbete_id": "sec222",
      "sentiment": 0.2,
      "quote": "det bör också vara ett mål att film ska kunna skapas och produceras i hela landet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec223",
      "sentiment": -0.2,
      "quote": "Vi anser att utredningen har fått för stort fokus på publikens kvantitet, och för lite fokus på kvalitet, variation av bredd och spets och på dem som skapar film.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec224",
      "sentiment": 0.5,
      "quote": "Här är det dock viktigt att upphovsrätten till filmerna respekteras och att avtal träffas för den aktuella användningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.2",
      "sentiment": -0.5,
      "quote": "Vi är kritiska till att det regionala ansvaret för film utökas utan motsvarande finansiering eller kapacitet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec234",
      "sentiment": 0.5,
      "quote": "20 % kompenserar i princip bara för de senaste årens uteblivna kostnadsuppräkningar, och innebär inte någon offensiv filmsatsning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec235",
      "sentiment": 0.2,
      "quote": "Vi anser dock att Filmfonden har ett lite för stort fokus på stora och dyra produktioner.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec239",
      "sentiment": 0.5,
      "quote": "Detta bör dock kompletteras med mekanismer som säkerställer att momssänkningen kommer publiken till del.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec242",
      "sentiment": 0.8,
      "quote": "Det är både nödvändigt och rimligt att strömningstjänster är med och bidrar ekonomiskt till nya svenska AV-produktioner och till att säkra en långsiktig återväxt av filmskapare i Sverige.",
