  "segments": [
    {
      "forarbete_id": "a11.1",
      "sentiment": -0.5,
      "quote": "Region Norrbotten anser att nuvarande filmpolitiska mål innefattar flera viktiga incitament som förslaget saknar, bland annat vad gäller att utveckling och produktion av svensk film sker i hela landet, att barn och unga har goda kunskaper om film och rörlig bild och ges möjligheter till eget skapande samt att jämställdhet och mångfald bör prägla filmområdet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.2",
      "sentiment": -0.5,
      "quote": "Region Norrbotten anser att Filminstutet bör ha i uppdrag att stödja verksamhet som bidrar till att utveckla filmområdet i hela landet och motsätter sig förslaget vad gäller de filmkulturella delarna.",
      "quote_type": "grund"
