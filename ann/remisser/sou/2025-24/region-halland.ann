  "segments": [
    {
      "forarbete_id": "a10.3",
      "sentiment": 0.2,
      "quote": "Det är dock anmärkningsvärt att barns och ungas kunskap om film som konstform lyfts fram som centralt, utan att det följs av konkreta förslag om insatser, infrastruktur eller resurser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.1",
      "sentiment": 0.2,
      "quote": "Barn och unga är en prioriterad målgrupp i kulturpolitiken på alla nivåer, vilket också tydligt framgår i Hallands kulturstrategi, där kultur av, med och för barn och unga prioriteras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.2",
      "sentiment": 0.5,
      "quote": "För att detta ska fungera krävs dock att resurser omfördelas från Filminstitutet till kultursamverkansmodellen, enligt finansieringsprincipen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3",
      "sentiment": 0.5,
      "quote": "Det är viktigt att tydligt skilja mellan Filminstitutets stöd till filmen som konstform och filmfondens stöd till större produktioner.",
