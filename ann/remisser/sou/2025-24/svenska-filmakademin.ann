  },
  "segments": [
    {
      "forarbete_id": "a11.1",
      "sentiment": 0.2,
      "quote": "Filmakademin menar att detta tvärtemot utredarens avsikt, skapar en minskad tydlighet eftersom den som tar del av filmpolitiken då behöver söka sig till en annan källa för att uppfatta vad som gäller.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.2",
      "sentiment": 1.0,
      "quote": "I skälen till förslaget betonas den konstnärliga friheten, något som Filmakademin ser som mycket angeläget.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec39",
      "sentiment": -0.2,
      "quote": "Utan en sådan möjlighet till undantag skapas en olycklig inlåsning till de redan etablerade aktörerna och nya kompetenta aktörer stängs ute, något som hindrar förnyelse och konkurrens i sektorn.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec46",
      "sentiment": 0.5,
      "quote": "För att tydliggöra filmpolitikens fokus på film och biografupplevelsen bör förslaget om stöd till projekt av nationellt intresse i bidragsförordningens 27§ i sista meningen kompletteras så att det framgår att det som särskilt ska beaktas är projektets betydelse för spridning och visning av film på bio i hela landet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec232",
      "sentiment": 1.0,
      "quote": "Ett bredare utrednings- och analysuppdrag och huvudansvar för filmstatistiken är en viktig förutsättning för att berörda ska kunna föra faktabaserade samtal om den pågående utvecklingen och om Filminstitutets prioriteringar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2",
      "sentiment": -0.2,
      "quote": "Den har stagnerat och det innebär att möjligheterna att den vägen bidra till exempelvis regionalt baserad produktion och till talangutveckling är begränsade.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3",
      "sentiment": 0.5,
      "quote": "Filmakademin ser det dock som något oklart hur detta ska genomföras konkret och vad det får för konsekvenser för de olika stöden som ska finansieras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.4",
      "sentiment": 1.0,
      "quote": "Svenska Filmakademin välkomnar en sänkning av momsen på biobiljetter och att en biografavgift med avdragsrätt införs för att bibehålla och helst höja finansieringsnivån till Filminstitutets verksamhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec239",
      "sentiment": -0.2,
      "quote": "Skälet till det är att mindre biografer i många fall har en påtaglig säsongsvariation i antalet föreställningar per vecka och ibland även anordnar mindre festivaler där man har fler föreställningar under en viss enstaka vecka.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.5",
      "sentiment": 0.5,
      "quote": "om filmpolitikens fokus på svensk film inte ska urholkas, så bör investering i serieproduktion inte kunna avräknas mot streamingavgiften.",
