  "segments": [
    {
      "forarbete_id": "a3",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen i Gotlands län ser positivt på att en ny viltförvaltningslag och en ny viltförvaltningsförordning föreslås med tydligare struktur och modernare bestämmelser som ska ersätta nuvarande jaktlag och jaktförordning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.2.3",
      "sentiment": 1.0,
      "quote": "Denna möjlighet till proaktiv smittbekämpning är så viktig ur ett folkhälsoperspektiv att den bör lyftas tydligare i syftet med lagen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5",
      "sentiment": -0.2,
      "quote": "Avsaknaden av ett förtydligande riskerar att skapa osäkerhet både för enskilda och för handläggande myndigheter.",
