    },
    {
      "forarbete_id": "a5.12",
      "sentiment": -0.5,
      "quote": "Förslaget skulle omöjliggöra bekämpning av vissa arter i områden som på Gotland där exempelvis vildsvin aldrig varit naturligt etablerade, eller rådjur som introducerats efter år 1800 genom mänsklig aktivitet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.12.4",
      "sentiment": -0.2,
      "quote": "Länsstyrelsen i Gotlands län anser att begreppet ”unionsrättsligt skyddade arter” kan vara svårt att fullt ut förstå utan närmare kännedom om den bakomliggande EU-rätten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.8.4",
      "sentiment": 0.0,
      "quote": "Samtidigt finns det en risk att begreppet leder till oklarheter i tillämpningen, särskilt i förhållande till annan lagstiftning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6",
      "sentiment": -0.2,
      "quote": "avsaknaden av nationell vägledning riskerar att leda till osäkerhet i tillämpningen.",
