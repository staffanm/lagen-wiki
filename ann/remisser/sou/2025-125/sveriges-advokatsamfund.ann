    },
    {
      "forarbete_id": "sec134",
      "sentiment": -1.0,
      "quote": "Mot denna bakgrund riskerar den föreslagna ordningen, utan motsvarande anpassning av viltskadeförordningen, att skapa bristande samordning i regelverket och ökad rättsosäkerhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.7.2",
      "sentiment": -1.0,
      "quote": "Regleringen av transport av skjutvapen med motordrivet fordon i terräng är inte anpassad till de särskilda förutsättningar som gäller vid bedrivandet av renskötsel, vilket skapar oklarhet i tillämpningen och praktiska svårigheter för den berörda minoriteten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.4",
      "sentiment": -0.2,
      "quote": "Advokatsamfundet konstaterar att utredningen endast i begränsad utsträckning redovisar övergripande principer för hur fördelningen mellan lag, förordning och myndighetsföreskrifter ska ske.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4",
      "sentiment": -0.2,
      "quote": "De brister som finns i nuvarande lagstiftning har i allt väsentligt förts vidare till den nya jaktlagstiftningen, utan att närmare ha analyserats eller åtgärdats genom erforderliga förslag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec434",
      "sentiment": -0.2,
      "quote": "Det framgår inte varför ett sådant förbud behöver anges särskilt, trots att det redan följer av den generella fredningen.",
