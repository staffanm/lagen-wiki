    },
    {
      "forarbete_id": "a4.2",
      "sentiment": 0.2,
      "quote": "I detta sammanhang är det centralt att även tydliggöra hur det säkerställs att brukandet sker på ett långsiktigt hållbart sätt, så att flera samtidiga förenklingar inte sammantaget riskerar att leda till ett ohållbart brukande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6",
      "sentiment": -1.0,
      "quote": "Däremot menar vi att förslaget sänker tröskeln för skyddsjakt till en nivå där den riskerar att bli en förstahandslösning, snarare än ett undantag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.3",
      "sentiment": -0.2,
      "quote": "Analys av resultat från forskningsjakt utgör ett viktigt kunskapsunderlag och bör därför ha en naturlig koppling till viltförvaltningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.12.3",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen instämmer i att definitionen av främmande viltart inte ska omfatta myskoxe och ser positivt på att bedömningen görs utifrån ett helhetsperspektiv.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.12.4",
      "sentiment": 0.5,
      "quote": "Samtidigt vill vi förtydliga att myskoxe inte enbart omfattas av en nationell bedömning, utan även av internationella åtaganden enligt Bernkonventionen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": -1.0,
      "quote": "Ett krav på syfte är en grundläggande utgångspunkt i viltförvaltningen och bidrar till att säkerställa att jakt bedrivs utifrån förvaltningsmässiga behov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2.1",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen instämmer i bedömningen att eventuella förändringar av regelverket för skyddsjakt på varg bör föregås av en mer omfattande analys av såväl ekologiska som juridiska förutsättningar.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": 1.0,
      "quote": "Vi instämmer i förslagen.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": 0.5,
      "quote": "Länsstyrelsen instämmer med utredningens bedömning under förutsättning att viltförvaltningslagstiftningen tillser att det finns krav på att eftersök av skadat vilt ska, och kan, genomföras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5",
      "sentiment": 0.2,
      "quote": "För tydlighetens skull vill vi dock framhålla att det är en fördel om bestämmelser som rör samma art hålls samlade, så att regelverket blir mer överskådligt och lätt att tillämpa.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.1",
      "sentiment": 0.2,
      "quote": "Det finns därför en risk att bestämmelsen skapar förväntningar på åtgärder som länsstyrelsen i praktiken har begränsade möjligheter att genomföra.",
