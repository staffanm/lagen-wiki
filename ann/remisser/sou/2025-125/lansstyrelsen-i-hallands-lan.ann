    },
    {
      "forarbete_id": "a8.4",
      "sentiment": -0.2,
      "quote": "Formuleringen att vilt som ”riskerar att orsaka skada” omfattas är alltför vid och kan leda till att i princip allt vilt uppfyller kriterierna för skyddsjakt.",
      "quote_type": "grund"
