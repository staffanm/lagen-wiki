    },
    {
      "forarbete_id": "a8.1",
      "sentiment": 0.0,
      "quote": "Länsstyrelsen lämnar inga synpunkter på bilaga 1-4 i betänkandet som avser arter och jakttider.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.3",
      "sentiment": -0.5,
      "quote": "Skada på egendom utgör ingen grund för beslut om skyddsjakt enligt Fågeldirektivet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.14",
      "sentiment": -0.2,
      "quote": "framstår det som mindre ändamålsenligt att en regional myndighet i varje enskilt beslut självständigt ska behöva sammanställa uppgifter om artens nationella förekomst och utbredning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": 0.5,
      "quote": "behovet av samordning och säkerhet inte är beroende av jaktform eller viltart.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.14.1",
      "sentiment": -0.2,
      "quote": "Den närmare utvecklingen av begreppet på s. 230 är svår att följa, vilket medför att även dess innebörd i lagtexten framstår som otydlig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.1.1",
      "sentiment": -0.5,
      "quote": "Bedömningen av att få använda snöförhållanden för att underlätta jakten kan omöjligen ligga till grund för jakttider.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.2",
      "sentiment": -0.2,
      "quote": "Länsstyrelsen anser att den som påskjuter ett rovdjur så att det får skador av betydelse utan att dö, och där orsaken till detta är ett otillåtet eller olämpligt jaktmedel eller en felaktig jaktmetod har använts, ska anses ha handlat i strid med gällande bestämmelser i 2 kap 4 § även om skyddsjakt sker på eget initiativ.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.12",
      "sentiment": -0.5,
      "quote": "finansieringsmodellen bör omarbetas så att den blir tydlig, flexibel, heltäckande och långsiktigt hållbar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7",
      "sentiment": -0.5,
      "quote": "Mot denna bakgrund anser länsstyrelsen att det är nödvändigt att ett obligatoriskt, nationellt och heltäckande system för insamling och rapportering av dessa uppgifter införs.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.12",
      "sentiment": -0.2,
      "quote": "myndigheten inte har tillgång till uppgifter om vem som är jakträttshavare i de fall markägaren har upplåtit jakträtten till annan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen är positiv till betänkandets förslag.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a9.2.2",
      "sentiment": -0.2,
      "quote": "Detta innebär att en mycket stor del av landets yta – uppskattningsvis omkring 84 procent – endast i begränsad omfattning omfattas av faktisk tillsyn.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3",
      "sentiment": -0.2,
      "quote": "en allmän förvaltningsdomstol ofta saknar den biologiska sakkunskap som krävs för att fullt ut förstå de avvägningar som ligger till grund för beslut om tillstånd eller avslag till jakt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.4",
      "sentiment": -0.5,
      "quote": "Erfarenheten visar att denna process inte fungerar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5",
      "sentiment": -0.2,
      "quote": "Jakt kan även utföras av en person som är passiv.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.1",
      "sentiment": -0.2,
      "quote": "Båda paragraferna är hämtade ur den äldre jaktlagen utan att ha moderniserats, vilket skulle vara avsikten med detta förslag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2",
      "sentiment": -0.2,
      "quote": "Detta är särskilt viktigt om administrationen förenklas och även möjliggör deltagande för fler jägare utan lokalkännedom eller större erfarenheter av förekommande viltarter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.6",
      "sentiment": -0.2,
      "quote": "Om begreppet tolkas tidsmässigt kan det innebära att jakt även bedrivs på andra jakträttsinnehavares marker under en del av tiden, vilket i praktiken skulle kunna innebära att andras jaktmarker tas i anspråk.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.9",
      "sentiment": -0.2,
      "quote": "Den som med stöd av denna bestämmelse avlivar en art som annars är fredad ska anmäla detta till den myndighet regeringen beslutar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.13",
      "sentiment": -0.2,
      "quote": "finns en risk att EU- och EES-medborgare som inte är bosatta i Sverige saknar tillräcklig kunskap om svenska förhållanden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11",
      "sentiment": -0.2,
      "quote": "Myndigheter kan sakna information om jakträttsinnehavare om denne inte är markägaren.",
