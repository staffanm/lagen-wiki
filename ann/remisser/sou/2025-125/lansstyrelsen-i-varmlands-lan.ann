  "segments": [
    {
      "forarbete_id": "a13.1",
      "sentiment": -0.5,
      "quote": "Inför ikraftträdandet behöver föreskrifter, nya uppdragsanvisningar och uppdaterade rapporteringssystem m.m. vara på plats.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.2",
      "sentiment": -0.2,
      "quote": "Hur stora skador ska kunna tillåtas samtidigt som vi ska bevara och hållbart nyttja viltet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec32",
      "sentiment": -0.2,
      "quote": "Annars är risken att all utfodring kan tolkas som olovlig för att vilt rör sig över stora områden och kan lockas en lång sträcka till en utfodring.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec37",
      "sentiment": 0.2,
      "quote": "Länsstyrelsen anser att det vore bra att förtydliga att skyddsjakten genomförs av den som bor på platsen eller på uppdrag av jakträttshavaren.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec39",
      "sentiment": -0.2,
      "quote": "Ordet skapar en viss osäkerhet i fråga om vad uppgiften egentligen innebär.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec47",
      "sentiment": -0.5,
      "quote": "Länsstyrelsens erfarenhet är att 40 § c i jaktförordningen inte överutnyttjats tidigare utan tröskeln har snarare varit för hög.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec87",
      "sentiment": -0.5,
      "quote": "Det framgår alltså inte vilket problem jakten ska lösa, vilket riskerar att leda till att bestämmelsen blir svårtillämpad.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec92",
      "sentiment": -0.5,
      "quote": "Om kravet på allvarlig skada tas bort och ersätts med endast skada, riskerar bedömningsutrymmet att bli än mer otydligt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec101",
      "sentiment": -0.2,
      "quote": "Om det finns misstanke om brott bör det vara Polisens sak att utreda.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec123",
      "sentiment": 0.0,
      "quote": "Polisen har bättre förutsättningar för avlivning av djur i tätorter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec134",
      "sentiment": 0.2,
      "quote": "I dagsläget undersöker Länsstyrelsen alltså inte populationsstorleken för nämnda arter i egentlig mening.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.9.2",
      "sentiment": -0.5,
      "quote": "Eftersom att fånga räknas som jakt i förslaget blir det generellt olagligt att fånga in djur vid sådana situationer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7",
      "sentiment": -0.2,
      "quote": "Av ovan nämnda anledning blir det opraktiskt och försvårande om jaktledaren skulle vara ansvarig för anmälan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.12",
      "sentiment": -0.2,
      "quote": "Här blir hanteringen opraktisk om Länsstyrelsen ska fatta ett beslut innan omhändertagandet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.14",
      "sentiment": 0.2,
      "quote": "Länsstyrelsen anser att det ska finnas krav på att Naturvårdsverket även upprättar en nationell förvaltningsplan för älg.",
