  "overall": {
    "sentiment": 0.5,
    "quote": "Länsstyrelsen i Västra Götalands län ställer sig över lag positiv till en moderniserad jaktlagstiftning med syfte att förenkla efterlevnaden och förtydliga regelverket för samtliga berörda aktörer.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a12.1",
      "sentiment": -0.5,
      "quote": "Om det vid varje enskilt tillfälle krävs en sekretessprövning för att lämna ut dessa uppgifter kommer kommunikation och ärendehandläggning försvåras avsevärt, vilket i sin tur drabbar både myndigheten och enskilda.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec124",
      "sentiment": 0.5,
      "quote": "Detta förslag ger bättre förutsättningar för kommunerna att samla in och hantera oljeskadat vilt vid en olycka.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3.2",
      "sentiment": -0.5,
      "quote": "Århuskonventionen (artikel 9.3) avser rätten att få handlingar som strider mot den nationella miljölagstiftningen prövade av domstol.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.4",
      "sentiment": -0.2,
      "quote": "nuvarande handelsbegränsningar begränsar möjligheten att fullt ut ta tillvara fällt vilt",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.1",
      "sentiment": -0.5,
      "quote": "Detta skapar en särskild centralisering av sälförvaltningen som avviker från lagförslagets bredare ambition om en mer regionaliserad, adaptiv och ändamålsenlig viltförvaltning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.2",
      "sentiment": -0.5,
      "quote": "Genom att enbart använda benämningen ”skada” blir det svårt för Länsstyrelsen att avgöra om omfattningen av skadan är större än vad som kan förväntas skäligt att tåla.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.2",
      "sentiment": -0.2,
      "quote": "Förutsättningarna för att bevilja skyddsjakt på unionsrättsligt skyddade viltarter skiljer sig mellan fåglar och däggdjur beroende på olikheter mellan Art- och habitatdirektivet och Fågeldirektivet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.2",
      "sentiment": -0.5,
      "quote": "Föreslagen definition omfattar därmed många arter, som av tradition hålls för sällskap och hobby, exempelvis papegojor, undulater, påfåglar, vaktlar, kaniner, chinchillor och hamstrar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.8.6",
      "sentiment": -0.2,
      "quote": "Det kan handla om vilt som behöver eftersökas för att minimera spridning av smittor (fågelinfluensa) eller giftiga ämnen (ex olja).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.12.1",
      "sentiment": 1.0,
      "quote": "kan underlätta åtgärdsarbetet med invasiva främmande viltarter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": 0.5,
      "quote": "Länsstyrelsen anser att Naturvårdsverket är den myndighet som har förutsättningar att göra bedömningar av vargpopulationen nationellt och bör därför fortsatt ha ansvaret för bedömningen om den populationsreglerade jakten har påverkan på vargens gynnsamma bevarandestatus.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen anser att Naturvårdsverket, som nationell myndighet, ges ett tydligare ansvar och mandat att slutligt fastställa miniminivåer när samverkansråden inte kommer överens, för att motverka utdragna processer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.1",
      "sentiment": -0.5,
      "quote": "En länsstyrelse har ett geografiskt ansvar som är begränsat till det egna länet, och har varken förutsättningar eller till uppdrag att göra bedömningar ur ett nationellt perspektiv för de stora rovdjuren.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5",
      "sentiment": 0.2,
      "quote": "Det bör särskilt tydliggöras vid vilken utvecklingsfas ett lagt ägg övergår till att omfattas av skyddet för levande unge, samt vilka jaktmedel och metoder som är tillåtna under olika utvecklingsstadier.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.14",
      "sentiment": 0.5,
      "quote": "Förslaget kommer att underlätta tillståndsprövningen och ger en tydlig och bra definition på när vilt anses hållna av människan och bör omfattas av djurskyddslagstiftningen eller inte.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.12",
      "sentiment": 1.0,
      "quote": "Det är angeläget att jaktlagstiftningen i högre grad erkänner jakt som ett legitimt och praktiskt verktyg inom modern naturvård, särskilt i situationer där aktiva åtgärder krävs för att skydda biologisk mångfald, återställa ekologisk balans eller stärka känsliga bestånd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.9",
      "sentiment": -0.2,
      "quote": "Eftersom vilt i hägn får jagas på andra tider än vad som gäller för frilevande vilt ser Länsstyrelsen ett värde i att reglerna om hundanvändningen förtydligas även i viltförvaltningsförordningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec528",
      "sentiment": 0.5,
      "quote": "Länsstyrelsen ser mycket positivt på den möjligheten och har efterfrågat den i tidigare remiss men ser gärna att punkten förtydligas med att djurskyddsskäl nämns.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec528",
      "sentiment": -0.5,
      "quote": "Länsstyrelsen ser en risk att det kan inkomma en mängd triviala ärenden om skadade djur om den nu föreslagna skrivningen, som omfattar samtliga viltarter, beslutas.",
      "quote_type": "grund"
    },
    {
