  "segments": [
    {
      "forarbete_id": "sec24",
      "sentiment": -0.2,
      "quote": "Länsstyrelsen har uppfattningen att begreppet markinnehavare är vidare än begreppet fastighetsägare och även innefattar andra som genom nyttjanderättsavtal förfogar över marken, till exempel jordbruksarrendatorer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec67",
      "sentiment": -0.5,
      "quote": "Länsstyrelsen anser att det saknas rättsligt stöd att begränsa rätten till enbart unionsrättsligt skyddade arter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec28",
      "sentiment": -0.5,
      "quote": "Det blandar begreppets innebörd med dess tillämpningsområde och låser artvalet på ett sätt som begränsar det till synes flexibla bemyndigandet i 4 kap. 11 §",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec37",
      "sentiment": -0.2,
      "quote": "Det kan ifrågasättas om det är nödvändigt att i lag räkna upp platser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec93",
      "sentiment": -0.2,
      "quote": "Eftersom skadorna och miljön är desamma för dessa arter vore det mer ändamålsenligt om länsstyrelsen med sin regionala kunskap får besluta om skyddsjakt även efter säl.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec191",
      "sentiment": 0.2,
      "quote": "Eftersom vilt i hägn får jagas på andra tider än vad som gäller för frilevande vilt ser Länsstyrelsen ett värde i att reglerna om hundanvändningen förtydligas även i viltförvaltningsförordningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec130",
      "sentiment": 0.5,
      "quote": "Länsstyrelsen ser mycket positivt på den möjligheten och har efterfrågat den i tidigare remiss men ser gärna att punkten förtydligas med att djurskyddsskäl nämns.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6",
      "sentiment": -0.5,
      "quote": "Länsstyrelsen anser att detta inte fullt ut uppnås i den föreslagna lagstiftningen.",
