  "segments": [
    {
      "forarbete_id": "sec20",
      "sentiment": -0.2,
      "quote": "samhällets intressen kring frågor inom miljö och hälsa, livsmedelsförsörjning och beredskap inte tillvaratas helt genom definitionerna i 2 §",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec26",
      "sentiment": 1.0,
      "quote": "Bra att en enhetlig definition av begreppet påskjutning framgår på lagnivå.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec27",
      "sentiment": 0.5,
      "quote": "För att öka tydligheten är det önskvärt med hänvisning till lagrummet i de paragrafer i den föreslagna viltförvaltningsförordningen som behandlar unionsrättsligt skyddade viltarter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec30",
      "sentiment": -0.2,
      "quote": "Vi anser att skrivningen om att det enbart är fastighetsägaren som får genomföra lämpliga åtgärder i syfte att motverka skador av vilt är begränsande och att bestämmelsen även bör omfatta andra nyttjanderättshavare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec31",
      "sentiment": 1.0,
      "quote": "Tillägget ” Åtgärderna ska genomföras även om viltet tagit sig in på någon annans jaktområde.” tydliggör att eftersökskyldigheten kvarstår och eftersök får genomföras på någon annans jaktområde om jakträttshavaren på den berörda marken inte själv vill vidta åtgärder för att fullgöra eftersöksskyldigheten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec23",
      "sentiment": 1.0,
      "quote": "Bra att de olika ändamålen för jakten definieras i lagen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": 1.0,
      "quote": "Bra att det framgår på lagnivå att jaktledare krävs vid viss populationsreglerande jakt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec39",
      "sentiment": 1.0,
      "quote": "Det ger en ökad tydlighet att regleringen av älgförvaltningsområden lyfts till lagnivå.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec40",
      "sentiment": 1.0,
      "quote": "Det ger en ökad tydlighet att populationsreglerande jakt på älg endast får genomföras efter ett särskilt beslut av länsstyrelsen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec40",
      "sentiment": 0.5,
      "quote": "Motivet är att ett älgskötselområde bör vara huvudsakligen sammanhängande för att kunna förvalta den älgstam som ska omfattas av områdets älgskötselplan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec40",
      "sentiment": 0.2,
      "quote": "Det kan dock skapa en viss osäkerhet kring rättsläget kring att det särskilda beslutet om populationsreglerande jakt inte får överskridas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5",
      "sentiment": -0.2,
      "quote": "Registrering av områden som omfattas av populationsreglerande jakt medför i stort sett samma administration oavsett om det gäller älg eller kronhjort.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.9",
      "sentiment": -0.2,
      "quote": "Skälet är att drevet associerar till jakt med drivande hundar som förföljer viltet med skallgivning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec47",
      "sentiment": -0.5,
      "quote": "Det kan ge jakträttshavare stöd i bedömning och genomförande och tillfällena där jakträttshavare genomför sådan jakt på eget initiativ på felaktiga grunder kan troligtvis minskas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec50",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen tillstyrker att älgvårdsfonden bör avskaffas då det inte är ändamålsenligt att förvaltningen ska finansieras utifrån antalet fällda djur och dessutom behövs ett bredare artperspektiv än älg.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec92",
      "sentiment": -0.5,
      "quote": "Skälet är att det inte behöver ha uppstått någon skada innan länsstyrelsen får besluta om skyddsjakt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2.1",
      "sentiment": -0.2,
      "quote": "Efter att vägledningen använts av länsstyrelserna har det förekommit rättsliga avgöranden som visar på att vägledningen inte är juridiskt förankrad.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.1",
      "sentiment": 0.5,
      "quote": "förutsätter dock att Naturvårdsverket fortsatt har den nationella överblicken och tydligt vägleder länsstyrelserna i deras beslut om skyddsjakt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6",
      "sentiment": -0.2,
      "quote": "Syftet med förslagen att årsunge av rödräv och grävling får jagas för att förhindra skada på vilda djur är otydlig och kan ge en allt för vid tolkning om när det finns skäl för jakten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.3.2",
      "sentiment": -0.5,
      "quote": "Befintliga medel för förvaltning av annat än stora rovdjur är mycket begränsade varför implementeringen av den nya lagstiftningen kommer att ske på en låg ambitionsnivå om inte resurser skjuts till.",
      "quote_type": "grund"
    }
  ]
