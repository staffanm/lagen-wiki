    },
    {
      "forarbete_id": "a8.4.1",
      "sentiment": -0.5,
      "quote": "Ingripanden kan dock, enligt förvaltningsrättens uppfattning, i vart fall förväntas ta längre tid när Naturvårdsverket först ska anmäla sina observationer till regeringen i stället för att direkt kunna agera på egen hand.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3.2",
      "sentiment": 0.5,
      "quote": "Eftersom Sverige bl.a. delar den skandinaviska vargpopulationen och gränsrevir med Norge finns exempel på att en norsk ideell organisation tidigare har tillerkänts talerätt i mål om jakt på stora rovdjur i Sverige.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3.3",
      "sentiment": -0.5,
      "quote": "En sådan ändring skulle kunna resultera i att det efter jakten finns färre vargar kvar än vad som var avsikten vid den ursprungligen beslutade jakten för att reglera populationen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.4",
      "sentiment": -0.5,
      "quote": "Att beslutsmyndigheten hanterar sina ärenden och fattar beslut skyndsamt är ofta en förutsättning för att domstolen i sin tur ska kunna fatta beslut i rimlig tid.",
