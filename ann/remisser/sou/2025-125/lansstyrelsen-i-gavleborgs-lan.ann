    },
    {
      "forarbete_id": "sec431",
      "sentiment": -0.2,
      "quote": "Länsstyrelsen konstaterar att det i rådande förslag till lag och förordning fortsatt saknas mandat att förvalta kronhjortsskötselområden över länsgränserna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec498",
      "sentiment": -0.5,
      "quote": "Att sätta rapporteringsskyldigheten till varje enskild jaktledare skulle innebära betydligt större administration och krav på hållande av uppgifter för samtliga jaktområdens jaktledare, något som i dagsläget fattas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec445",
      "sentiment": -0.2,
      "quote": "Det saknas vägledning i hur länsstyrelserna ska arbeta med detta då lagstödet saknas trots att länsstyrelsen förväntas arbeta förebyggande när det kommer till jaktbrott.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10",
      "sentiment": 0.5,
      "quote": "Utan förstärkt tillsyns- och handläggningskapacitet finns risk att systemet blir tandlöst och därmed inte får avsedd effekt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12",
      "sentiment": -0.5,
      "quote": "Om utlämnande av dessa uppgifter i varje enskilt fall skulle föregås av en sekretessprövning skulle detta medföra avsevärd ökad administration samt försvåring av kommunikation för myndigheten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec500",
      "sentiment": 0.2,
      "quote": "Länsstyrelsen är positiva till förslaget men önskar att det förtydligas att uppgifterna ska rapporteras till Naturvårdsverket ”på begäran”.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec516",
      "sentiment": 0.2,
      "quote": "Länsstyrelsen anser att kravet i sig är rimligt, men att det krävs närmare vägledning för hur prövningen ska göras i praktiken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec516",
      "sentiment": -0.2,
      "quote": "Länsstyrelsen anser att det är ett skäl att återkalla tillståndet om viltet far illa eller inte sköts på rätt sätt, även om hägnet i sig sköts på rätt sätt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec517",
      "sentiment": -0.2,
      "quote": "Länsstyrelsen har tidigare uppmärksammats på oklarheter kring om medlemmar i viltvårdsområde (VVO) får jaga i vilthägn utan uttryckligt medgivande från hägnets tillståndshavare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec528",
      "sentiment": -0.2,
      "quote": "Länsstyrelsen bedömer att den nu föreslagna utvidgningen, som omfattar samtliga viltarter, riskerar att leda till ett ökat inflöde av ansökningar till myndigheten rörande skadade individer av mer allmänt förekommande arter",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec528",
      "sentiment": 0.2,
      "quote": "Länsstyrelsen bedömer därför att regelverket behöver förtydligas, antingen i förordning eller genom föreskrifter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec538",
      "sentiment": -0.5,
      "quote": "Länsstyrelsen konstaterar att det saknas beskrivning om hur älgförvaltningssystemet ska finansieras i samband med att älgvårdsfonden och fällavgiften avskaffas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec536",
      "sentiment": 0.2,
      "quote": "Länsstyrelsen ställer sig däremot frågande kring varför denna lydelse inte skulle kunna vara del av bemyndigandena att utställa en sanktionsavgift i stället för att särskilt ligga under kapitel 13 i förordningen.",
      "quote_type": "grund"
