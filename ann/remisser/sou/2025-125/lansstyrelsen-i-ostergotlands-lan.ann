  "overall": {
    "sentiment": 0.5,
    "quote": "Länsstyrelsen Östergötland anser att förslaget medför en modernare och mer lättöverskådlig lagstiftning inom viltförvaltningsområdet, där viltförvaltningslag och -förordning täcker in större delar av lagstiftningen än vad tidigare jaktlagstiftning gjorde.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a6.2",
      "sentiment": 0.2,
      "quote": "populationsreglerande jakt på varg fortsatt fordrar en strikt tillämpning baserat på vetenskaplig grund, och att länsstyrelserna är beroende av en tydlig nationell vägledning för att säkerställa att jakten är förenlig med att upprätthålla artens gynnsamma bevarandestatus.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5",
      "sentiment": 0.2,
      "quote": "För att kunna bevara den lokala samverkan som är grunden för älgförvaltningen, även inom områden med låga tätheter av älg, föreslår Länsstyrelsen ett tillägg till 6 § 2 kap i viltförvaltningsförordningen där länsstyrelsen ges möjlighet att besluta om undantag vid särskilda fall.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.14",
      "sentiment": 0.2,
      "quote": "Det är avgörande för en uppföljning och kontroll av smittskyddsskäl.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4",
      "sentiment": -0.5,
      "quote": "Länsstyrelsen framför att förslaget bedöms innebära stora negativa konsekvenser gällande bland annat populationsreglerande jakt under allmän jakttid, uppföljning av jaktresultat och incitamenten för samverkan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.2",
      "sentiment": 0.2,
      "quote": "De specificerade tamdjuren och dess användning eller placering vid ett pågående angrepp ska inte spela någon roll för någon annans möjlighet att agera.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.8",
      "sentiment": 0.2,
      "quote": "Länsstyrelsen ser behov av utökade möjligheter att kräva in dessa uppgifter som ligger till grund för Sveriges vidare rapporteringskrav enligt naturvårdsdirektiven (Habidesrapportering)",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.9",
      "sentiment": 0.2,
      "quote": "Länsstyrelsen anser att det inte är rimligt att sådant krav ställs på en som agerar utifrån en nödsituation som inte går att förutspå eller planera.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.12",
      "sentiment": 0.2,
      "quote": "Länsstyrelsen anser att skälen (punkt 1–2) i bestämmelsen inte tydligt speglar de exempel på tillfällen där jakt av naturvårdsskäl kan beslutas enligt övervägandena",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.6.1",
      "sentiment": 1.0,
      "quote": "Det kommer bland annat bli enklare för den enskildes möjligheter att få insikt i vad som är straffbelagt, och det blir också enklare för länsstyrelsen att härleda vad som är straffbelagt och inte.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.5.5",
      "sentiment": 1.0,
      "quote": "Detta eftersom det är fråga om enskilda personer som oftast är jakttillsynsmän.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3.3",
      "sentiment": 0.2,
      "quote": "Dock anges inga förutsättningar för i vilka fall ändring får ske enligt bestämmelsen, till exempel om det framkommit nya omständigheter eller någon annan anledning.",
      "quote_type": "grund"
    }
  ]
}