  "overall": {
    "sentiment": 0.2,
    "quote": "Det är positivt att viltförvaltningslagstiftningen moderniseras, men utredningen hanterar inte i tillräcklig utsträckning de omfattande viltskadorna i jord- och skogsbruket eller hur viltförvaltningens olika intressen ska vägas mot varandra.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "sec20",
      "sentiment": -0.5,
      "quote": "Konsekvensen blir att gränsen mellan viltvård och generell natur- och miljövård suddas ut, utan att lagstiftaren tydligt har reglerat hur dessa intressen ska vägas mot varandra inom ramen för viltförvaltningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.2.2",
      "sentiment": -0.2,
      "quote": "Det är därför inte lämpligt att beskriva hållbart brukande med utgångspunkt i ett ”överskott” av jaktbart vilt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.8.3",
      "sentiment": -1.0,
      "quote": "Den föreslagna utformningen av bestämmelsens tredje punkt, särskilt i ljuset av de som framgår i delbetänkandet, riskerar dock att leda till att bestämmelsen får en i praktiken svårförutsebar tillämpning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": 1.0,
      "quote": "Det är positivt att reglerna som föreslås utgår från att vargens skyddsstatus numera är sådan att den kan bli föremål för förvaltningsåtgärder och att förslaget innebär en förenkling.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.7",
      "sentiment": -0.2,
      "quote": "LRF anser därför att denna oklarhet behöver undanröjas, antingen genom ett förtydligande i övervägandena i en kommande proposition eller genom att det införas ett undantag i 7 kap 1 § viltförvaltningsförordningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12",
      "sentiment": 0.5,
      "quote": "LRF tillstyrker utredningens förslag till ändring i offentlighets- och sekretesslagen, men anser att sekretessbestämmelsen bör kompletteras med ett uttryckligt undantag för fastighetsägare vars fastighet är belägen inom ett område som har registrerats för jakt på älg eller kronhjort.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10",
      "sentiment": 1.0,
      "quote": "En sådan ordning framstår som mer proportionerlig än att varje enskild överskjutning behöver hanteras inom ramen för ett straffrättsligt förfarande om jaktbrott.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec32",
      "sentiment": -0.5,
      "quote": "LRF anser dock att reglerna om utfodring måste ses över eftersom nuvarande lagstiftning inte fungerar ändamålsenligt för att förebygga de omfattande skador som vilt orsakar i jordbruket.",
      "quote_type": "grund"
    }
  ]
