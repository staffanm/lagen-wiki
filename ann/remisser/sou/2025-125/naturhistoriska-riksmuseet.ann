  "overall": {
    "sentiment": 0.1,
    "quote": "Naturhistoriska riksmuseet välkomnar flera av förslagen som rör statens vilt, särskilt tydligare regler om när vilt ska tillfalla staten och en mer enhetlig hantering mellan myndigheter.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "sec124",
      "sentiment": 1.0,
      "quote": "Den föreslagna språkliga utformningen är modernare och bestämmelsen tydliggör att miljö- och viltövervakning utgör legitima skäl.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec522",
      "sentiment": 1.0,
      "quote": "Bestämmelsen tydliggör att djur av de uppräknade arterna tillfaller staten om de avlivas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec522",
      "sentiment": 1.0,
      "quote": "I dag gör olika myndigheter olika bedömningar av om detta är möjligt enligt nuvarande reglering, vilket medför merarbete och osäkerhet kring vilket vilt museet har rätt att ta emot.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec525",
      "sentiment": -0.2,
      "quote": "Om djuret exempelvis saknar vetenskapligt värde eller är i för dåligt skick, behöver museet förbehålla sig rätten att, likt i vår övriga verksamhet, gallra och prioritera.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec525",
      "sentiment": -0.2,
      "quote": "För NRM är det dock oklart i vilken utsträckning dessa befogenheter kan utövas, eftersom museilagstiftningen innehåller egna och i vissa fall mer långtgående krav för motsvarande åtgärder.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec434",
      "sentiment": 0.0,
      "quote": "Nuvarande formulering kan ge intryck av att förbudet enbart avser jakt från svenskt fartyg eller luftfartyg utanför Sveriges ekonomiska zon.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec438",
      "sentiment": -1.0,
      "quote": "Det är vidare svårt att fastställa om en sälunge är moderlös utan längre tids observation.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec440",
      "sentiment": 0.0,
      "quote": "När det gäller utbrott av djursjukdomar hos marina däggdjur, såsom sälar, är det enligt NRM:s mening viktigt att beslut fattas av ansvariga nationella myndigheter som innehar relevant expertis.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec498",
      "sentiment": 1.0,
      "quote": "Den föreslagna tidsramen för anmälan bedöms bidra till en förbättrad uppföljning av jaktuttag och möjliggör en mer effektiv kontroll av fastställda kvoter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec480",
      "sentiment": 0.0,
      "quote": "Avsaknaden av en tydlig definition kan försvåra tillämpningen av bestämmelsen, särskilt vid bedömningar av arters bevarandestatus och förvaltningsåtgärder.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec487",
      "sentiment": -0.2,
      "quote": "Museet framhåller att olika former av selektiv jakt kan få betydande effekter på populationers struktur och reproduktionsförmåga, vilket i sin tur kan påverka möjligheten att upprätthålla gynnsam bevarandestatus.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec498",
      "sentiment": 0.0,
      "quote": "Sådana uppgifter utgör centrala indikatorer för övervakning av populationernas hälsotillstånd och är av stor betydelse för den vetenskapliga uppföljningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec527",
      "sentiment": -0.5,
      "quote": "förslaget till viltförvaltningslag en skärpning av underrättelseskyldigheten samt införandet av termen ”forskningsjakt”, vilket riskerar att ge en missvisande bild av verksamhetens karaktär.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec527",
      "sentiment": 0.0,
      "quote": "Denna formulering balanserar tydligt behovet av information till jakträttshavaren med ringmärkningsverksamhetens praktiska förutsättningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec444",
