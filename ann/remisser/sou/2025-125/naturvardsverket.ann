    "inputs": {
      "artifact:remisser/sou/2025:125/naturvardsverket": "77733e4d63b5d00f04ec441c75ab200f8b075690e6297703f51e96434800393e",
      "artifact:forarbete/sou/2025-125": "8fbe18bc2acd39c5bc37f0d668576018901c84abb912d974543ac98521ecb8c8"
    }
  },
  "overall": {
    "sentiment": 0.5,
    "quote": "Naturvårdsverket ställer sig i huvudsak positivt till utredningens förslag och bedömer att betänkandet utgör ett viktigt steg mot ett mer sammanhållet och ändamålsenligt regelverk för viltförvaltningen.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a1.1",
      "sentiment": 0.5,
      "quote": "Naturvårdsverket tillstyrker förslaget men bedömer att 2 kap. 6 § viltförvaltningslagen bör kompletteras med en möjlighet för länsstyrelserna att besluta om förbud mot, eller villkor för, utfodring av vilt som inte hålls i hägn när det behövs för att förebygga eller minska skador på biologisk mångfald.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.6",
      "sentiment": 0.5,
      "quote": "Formuleringen ”jakt på viltarter som lever i hav eller vatten enligt denna förordning” bedöms vara alltför vag, då den kan omfatta exempelvis bäver, utter och sjöfåglar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.5",
      "sentiment": 0.2,
      "quote": "Eftersom avlivning, som enligt utredningen avser att döda vilt i vissa specifika situationer, inte ska räknas som jakt, medför detta att blyhagelförbudet blir tillämpligt även i dessa fall.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.8.1",
      "sentiment": 0.5,
      "quote": "Naturvårdsverket tillstyrker förslaget med tillägget att även geografiskt område behöver vara/bör vara ett kriterium som behöver beaktas vid genomförande av allmän jakt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.8.2",
      "sentiment": -0.5,
      "quote": "Naturvårdsverket avstyrker förslaget eftersom begreppet populationsreglerande jakt är för snävt begrepp i sammanhanget och inte ändamålsenligt för alla de typer av jakt som kan avses.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.12.2",
      "sentiment": 0.5,
      "quote": "Skälet till detta är att såväl fågeldirektivet som artskyddsförordningen anger att bestämmelserna avser vilda fåglar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.12.3",
      "sentiment": 0.5,
      "quote": "Ett krav på att utreda skaderisker kommer att innebära en tidsfördröjning som kan bli betydande om det inte finns information om hur arten kan påverka sin miljö, särskilt om det rör arter som kommer från andra ekosystem.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.12.4",
      "sentiment": -0.5,
      "quote": "Naturvårdsverket avstyrker förslaget eftersom den föreslagna indelningen av arter framstår som otydlig och svår att motivera ur ett unionsrättsligt perspektiv.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.13",
      "sentiment": 0.2,
      "quote": "Naturvårdsverket tillstyrker förslaget, men noterar att eftersom arter anges på lagnivå kommer det krävas lagändringar om systemet med miniminivåer i framtiden ska användas för andra än de uppräknade arterna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.14",
      "sentiment": 0.2,
      "quote": "Samtidigt vill Naturvårdsverket uppmärksamma att begreppet gynnsam bevarandestatus inte används för fåglar i EU:s fågeldirektiv eller i artskyddsförordningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": -0.5,
      "quote": "Hänvisningen till de nationella målen är dock oprecis.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": 0.0,
      "quote": "Dock ser vi svårigheter med att jaktledaren inte har något formellt mandat och att det inte kan ställas krav på att de övriga jaktdeltagarna följer dennes anvisningar",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5",
      "sentiment": 0.5,
      "quote": "Naturvårdsverket tillstyrker förslaget och vill framhålla vikten av att det är möjligt för länsstyrelsen att registrera kronhjortsskötselområden över länsgränser på samma sätt som för älgskötselområden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.6",
      "sentiment": 0.5,
      "quote": "Mot bakgrund av detta bedömer vi att det finns anledning att låta anmälningsskyldigheten även omfatta den som använder eller tillverkar redskapet i Sverige, om det inte redan har anmälts.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.1",
      "sentiment": 0.0,
      "quote": "Länsstyrelserna är den myndighet som har störst kunskap om de regionala förutsättningarna avseende säl och skador på fiske.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7",
      "sentiment": 0.5,
      "quote": "För jägare som saknar dessa möjligheter kvarstår möjligheten att anmäla jaktresultat till Naturvårdsverkets kundtjänst vilken endast är öppen under vardagar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.9",
      "sentiment": 0.2,
      "quote": "Vid viss skyddsjakt kan det vara obehövligt eller vanskligt att medföra hund.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.11",
      "sentiment": 0.5,
      "quote": "Naturvårdsverket bedömer att jakt i rent utbildningssyfte behöver finnas kvar exempelvis för att genomföra utbildning för jakt och provtagning av säl.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.12",
      "sentiment": 0.5,
      "quote": "Vi ser inga övertygande skäl för att det ska vara möjligt för annan att ansöka om sådan jakt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.13",
      "sentiment": 0.5,
      "quote": "Verket anser att sådana beslut även bör kunna fattas på myndighetens eget initiativ.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10",
      "sentiment": 0.5,
      "quote": "Naturvårdsverket anser mot denna bakgrund att den föreslagna bestämmelsen i viltförvaltningslagen om verkställighet är överflödig (9 kap. 6 §).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12",
      "sentiment": 0.2,
      "quote": "Naturvårdsverket anser dock att förslagen inte i tillräcklig mån tillgodoser behovet av utökat sekretesskydd för uppgifter som kan leda till att vapen, ammunition etc. kommer till brottslig användning, bland annat för att författningsförslaget utgörs av en uttömmande katalog av register.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.1",
      "sentiment": -0.5,
      "quote": "Om lagstiftningen träder i kraft innan Naturvårdsverket har hunnit anpassa föreskrifterna kan förändringar i bemyndigandena innebära att Naturvårdsverket saknar möjlighet att ändra eller upphäva föreskrifter eftersom myndigheten kan komma att sakna bemyndigande.",
      "quote_type": "grund"
    }
  ]
}