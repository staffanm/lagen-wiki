  "segments": [
    {
      "forarbete_id": "a3.3.1",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen ser positivt på att nuvarande lagstiftning ersätts av ett nytt samlat regelverk, som genom utredningens arbete ges ett mer ändamålsenligt innehåll och tydligare struktur.",
