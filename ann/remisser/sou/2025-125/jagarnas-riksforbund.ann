    "inputs": {
      "artifact:remisser/sou/2025:125/jagarnas-riksforbund": "af1692242a9451ade9f181ee776d337b191f00542f932fd0c42b1ee11b3cadbf",
      "artifact:forarbete/sou/2025-125": "8fbe18bc2acd39c5bc37f0d668576018901c84abb912d974543ac98521ecb8c8"
    }
  },
  "overall": {
    "sentiment": -0.2,
    "quote": "Jägarnas Riksförbund (JRF) har tagit del av slutbetänkandet av Jaktlagstiftningsutredningen ”En ny viltförvaltningslagstiftning” och lämnar följande kommentarer.",
    "quote_type": "standpunkt"
  },
  "segments": [
    {
      "forarbete_id": "a5.3",
      "sentiment": -0.2,
      "quote": "Risken om ett begrepp definieras tydligt är också att sådant som faller utanför den laggivna definitionen men som av olika anledningar behöver omfattas av definitionen inte på ett enkelt sätt kan tillföras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.4",
      "sentiment": -0.5,
      "quote": "det är också sådana brott som inte inryms i den normala definitionen av jakt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.5",
      "sentiment": -0.2,
      "quote": "Det blir en oklar situation och JRF anser inte att definitionerna i 6 och 7 §§ kompletterar varandra på ett relevant vis.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.8",
      "sentiment": -0.5,
      "quote": "JRF ser inte behov av att tydliggöra att det finns olika former av jakt utan ser att befintligt regelverk på ett tydligare sätt talar om vilka arter som får jagas och under vilka förutsättningar sådan jakt får ske.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.8.1",
      "sentiment": -0.2,
      "quote": "JRF anser inte att det finns behov av definition av allmän jakt som företeelse utan att behovet uppfylls på ett tillräckligt vis genom dagens jakttidsreglering.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.8.2",
      "sentiment": -0.5,
      "quote": "Genom att införa ett syfte till jakten riskerar själva syftet att behöva prövas i förhållande till EU-rätten och det riskerar att skapa en ohållbar situation.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.8.6",
      "sentiment": -0.2,
      "quote": "Det innebär att en definition av ”eftersök”, för att bli korrekt, även måste ta hänsyn till att ett vilt kan vara oskadat när ett eftersök genomförs.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.9",
      "sentiment": -0.5,
      "quote": "Den definition som uttrycks riskerar att medföra att till exempel kikarsikten eller benstöd kan betraktas som jaktmedel, vilket inte bör vara syftet med skrivningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.10",
      "sentiment": -1.0,
      "quote": "Att införa denna tveksamma definition av ordet skapar förutsättningar för att senare införa begränsningar eller restriktioner där olika jaktmetoder tillåts under olika förutsättningar vilket, tillsammans med den otydliga definitionen, riskerar att skapa osäkra rättssituationer för jägarna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.12.5",
      "sentiment": -0.2,
      "quote": "Dessutom är det svårt att skilja arterna åt vid pressade och snabba nödliknande situationer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.14",
      "sentiment": -0.2,
      "quote": "Det är tydligt att förutsättningarna för att gynnsam bevarandestatus ska föreligga är att det inte krävs allt för långt gående åtgärder från mänskligt håll för att åstadkomma detta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2",
      "sentiment": -0.2,
      "quote": "JRF anser att denna bestämmelse behöver kompletteras så att även örn är sådana arter där regeringen får meddela föreskrifter om att jakt får genomföras på någon annans jaktområde.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": 1.0,
      "quote": "Det har saknats en tydlighet i tidigare lagstiftning vilket lett till att jaktledare ofta utsetts och tillskrivits ansvar på ett sådant sätt som inte varit förenligt med föreskrifternas intentioner.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5",
      "sentiment": -0.2,
      "quote": "I det fall de intilliggande kronhjortsskötselområdena vägrar ansluta marken leder det alltså till att en fastighetsägare inte ges möjlighet att bedriva jakt efter vuxen kronhjort över huvud taget.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec42",
      "sentiment": -0.2,
      "quote": "JRF anser att det inte bör finnas någon begränsning för vilka arter som får jagas i Sveriges ekonomiska zon.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5",
      "sentiment": -0.2,
      "quote": "För JRF är det tydligt att ett nytt system krävs för förvaltningen av älg och att det systemet ska vara allmän jakttid eftersom inget system skapar större frihet och bättre förutsättningar för jägare och markägare att förvalta en viltstam och dessutom minskar byråkratin och kostnaderna kring jakten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.2",
      "sentiment": -1.0,
      "quote": "Enligt förslaget, där det först i efterhand går att avgöra om en jakt har bedrivits i enlighet med lagstiftningen eller inte, kommer jägarna ofrånkomligen att hamna i stora rättsosäkra situationer under jakten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.6",
      "sentiment": -0.5,
      "quote": "Det här späder ytterligare på JRF:s kritik mot de tveksamma definitionerna av jaktmetoder som återkommer senare i författningarna och det riskerar att skapa väldigt osäkra situationer för jägarna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.9.2",
      "sentiment": 1.0,
      "quote": "JRF anser att detta styrker djurskyddet och skapar ett tydligare regelverk samtidigt som det inte inkräktar på vare sig jaktens säkerhet eller jakträtten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.10",
      "sentiment": -0.5,
      "quote": "Att en myndighet får ett fritt mandat att besluta om skyddsjakt på dessa djur riskerar att drabba personer som inte bidragit till varken rymningen eller ett illegalt utsättande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec50",
      "sentiment": -0.2,
      "quote": "JRF finner inte att det är rimligt att till exempel en make eller maka till en jägare, som vid något enstaka tillfälle är med och går i en drevkedja, ska behöva lösa statligt jaktkort för detta tillfälle.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3",
      "sentiment": -0.2,
      "quote": "JRF anser det vara av yttersta vikt att begränsande internationella konventioner och direktiv som Sverige förbundit sig att följa ska implementeras minimalt och därmed leda till så få restriktioner och begränsningar som möjligt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3.2",
      "sentiment": -1.0,
      "quote": "JRF har noterat det systemhotande arbete som utförs av flera av dessa ideella föreningar i samband med beslut om jakt efter stora rovdjur och anser att sådant beteende, som innebär att demokratiskt fattade beslut fördröjs och försenas och skapar oerhörda kostnader för samhället, inte ska legitimeras i svensk lag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.4",
      "sentiment": 1.0,
      "quote": "Dagens regelverk, där skyndsamheten endast gäller Förvaltningsrätten, är inte tillräcklig och JRF ser positivt på att detta utökas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.5",
      "sentiment": 1.0,
      "quote": "JRF tillstyrker att beslut enligt lagen ska gälla omedelbart, även om de överklagas.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a12.1",
      "sentiment": 1.0,
      "quote": "sekretessen bör likna den som finns för vapenägare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec78",
      "sentiment": -0.2,
      "quote": "JRF anser att förvaltningen ska vara så lokal och obyråkratisk som möjligt och för att uppnå det måste regelverket i det här sammanhanget lättas upp.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec87",
      "sentiment": 0.2,
      "quote": "Därför uppmanar JRF regeringen att säkerställa att det i 8 § föreslagna regelverket är just en minimiimplementering av de internationella regelverk som Sverige är bundna att följa.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec88",
      "sentiment": -0.2,
      "quote": "JRF anser att jakt efter lodjur behöver få utföras under en längre period för att möjliggöra jakt då förhållandena är som bäst, vilket kan infalla under korta perioder vid flera tillfällen under ett jaktår.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec90",
      "sentiment": -0.2,
      "quote": "JRF anser att jakten efter säl bör genomföras som ”kvotbegränsad jakt” eller ”kvotjakt” utifrån samma resonemang som förbundet framfört vid flera tillfällen ovan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec92",
      "sentiment": 0.5,
      "quote": "om detta systematiseras på det föreslagna viset kommer det på sikt kunna leda till bättre anpassat regel- och ramverk för jaktens utförande och därigenom mindre behov av skyddsjakt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec92",
      "sentiment": -0.2,
      "quote": "Det förekommer flera gånger varje år att även örnar angriper både boskap och jakthundar, men i dagsläget är den som äger tamdjuren inte berättigad att skydda dem.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec92",
      "sentiment": -0.2,
      "quote": "Det ska inte spela någon roll om en varg har tagit sig på insidan av stängslet eller befinner sig precis utanför för att det ska finnas möjlighet att fälla vargen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.9",
      "sentiment": -0.5,
      "quote": "Dels är begreppet ”jaktlag” i sig odefinierat och det förekommer i Sverige i dag många olika definitioner av jaktlag och många olika sätt att bedriva jakt i grupp och dels är det orimligt att det endast är vid dessa fall som någon annan får skydda jakthunden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec94",
      "sentiment": -0.5,
      "quote": "JRF ser att det finns en överhängande risk för att detta inkräktar på äganderättsliga grundprinciper och att det inte är lämpligt att länsstyrelserna får så långt gående rättigheter att verka på andras fastigheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec96",
      "sentiment": -0.2,
      "quote": "JRF är tveksamma till att Naturvårdsverket ges ett väldigt fritt utrymme att utforma föreskrifter kring skyddsjakt på stora rovdjur utan att det närmare definieras vad dessa föreskrifter får innehålla eller i vilken riktning de ska meddelas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec100",
      "sentiment": -0.2,
      "quote": "Att införa detta krav för jaktledaren, som normalt inte är den som står för den praktiska rapporteringen, skapar en osäker rättssituation.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec101",
      "sentiment": -0.5,
      "quote": "Jakt efter dessa djur bedrivs ofta i otillgängliga områden och det kan vara bekymmersamt, i synnerhet vid en påskjutning där jägaren kanske inte kan lämna skogen, att fullgöra rapporteringsplikten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec109",
      "sentiment": -0.2,
      "quote": "Det är orimligt och kan lösas genom att ett särskilt undantag skrivs in i syfte att även rådjur kan hämtas med motordrivet fordon i terräng, antingen genom en ändring i terrängkörningsförordningen eller ett särskilt undantag i viltförvaltningsförordningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec191",
      "sentiment": -0.5,
      "quote": "Att göra ett tillägg om jaktprov skapar endast begreppsförvirring och bidrar inte till tydligheten i lagstiftningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec191",
      "sentiment": -0.2,
      "quote": "Den träning som utförs med till exempel apporterande hundar som apporterar redan dött vilt eller träningsapporter (dummys) kan dock utföras utan att vilt ofredas genom att platsen för träningen väljs med omsorg.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec131",
      "sentiment": -1.0,
      "quote": "JRF anser att varg inte bör sättas ut eller flyttas, men om så sker är det av yttersta vikt att det inte är vargar som är uppfödda i djurpark som sätts ut.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec135",
      "sentiment": -0.5,
      "quote": "Det ter sig för JRF svårförståeligt att en delegation, som av sin natur och till sin funktion ska verka i frågor som rör viltförvaltning, har en lägre representation från jakt- och viltförvaltningsintresset än för det bredare och mer diffusa naturvårdsintresset.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec138",
      "sentiment": -0.5,
      "quote": "JRF anser inte att viltförvaltningsavgiften bör höjas från nuvarande belopp om 400 kr.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec138",
      "sentiment": -0.2,
      "quote": "Att dessa behöver betala viltförvaltningsavgift tycker JRF är felaktigt och därför behöver ytterligare undantag föras in ibland de som inte behöver betala viltförvaltningsavgiften.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec150",
      "sentiment": 0.5,
      "quote": "JRF ser att det kan förenkla och snabba på processer om överklagande och beslut om jakt på ett sätt som är av yttersta vikt när dessa beslut fattas och olika organisationer medvetet förhalar och obstruerar besluten genom överklagandeprocesser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec154",
      "sentiment": -0.5,
      "quote": "JRF anser att de två definitionerna bör strykas helt och att det bör vara upp till rättstillämpningen att definiera jaktformerna om behov uppstår.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec189",
      "sentiment": -0.5,
      "quote": "Det skapar en onödig gränsdragningsproblematik om jägaren tvingas belägga vilken fart denna har haft när skottet lossats och riskerar att sätta jägare i oerhört svåra juridiska situationer.",
      "quote_type": "grund"
    }
  ]
}