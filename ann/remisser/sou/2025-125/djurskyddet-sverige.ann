  "segments": [
    {
      "forarbete_id": "a6.6",
      "sentiment": -0.5,
      "quote": "Sökanden ska redogöra för vilka förebyggande åtgärder och skrämselåtgärder som företagits.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": -0.5,
      "quote": "Vi menar att konflikter och klyftor mellan människor med olika åsikter i vargfrågan kommer att öka med en sådan förenkling av lagstiftningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.9.1",
      "sentiment": 0.2,
      "quote": "Däremot anser vi att årsungar av säl även i fortsättningen ska kunna fångas in, för att rehabiliteras av godkänd viltvårdare och anläggning, i syfte att åter släppas ut.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.2",
      "sentiment": -0.2,
      "quote": "Formuleringen “får genomföra de åtgärder som behövs för att döda det stora rovdjuret “anser vi ger alltför mycket utrymme för tolkning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5",
      "sentiment": -0.5,
      "quote": "Att göra ingrepp i djurs bon är inte etiskt försvarbart och grytjakt med hund anser vi inte ska tillåtas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7",
      "sentiment": 0.2,
      "quote": "Vi anser att det vid anmälan om dödade eller påskjutna stora rovdjur vid skyddsjakt på enskilds initiativ även ska anges vilka åtgärder som först vidtogs för att skrämma bort viltet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.9",
      "sentiment": -0.2,
      "quote": "Vilt ska heller inte stressas och drivas under de tider då de har ungar eller under den tid de behöver återhämtning inför vinterhalvåret.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.13",
      "sentiment": -0.5,
      "quote": "Utsättning av fiskar och fåglar i jaktsyfte är problematiskt ur ett välfärdsperspektiv och det skulle behövas en översyn av denna typ av verksamheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2.2",
      "sentiment": 0.5,
      "quote": "Djurskyddet Sverige menar att detta är allvarligt eftersom det finns en omfattande lagstiftning som reglerar jakten och det samtidigt måste kontrolleras om den följs.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3.3",
      "sentiment": -1.0,
      "quote": "Det finns enligt oss en risk att myndigheterna känner sig tvingade att fatta beslut utifrån fakta som finns i överklagandena, för att underlätta genomförandet av jakten.",
