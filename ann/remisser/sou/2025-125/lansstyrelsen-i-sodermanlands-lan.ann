  "overall": {
    "sentiment": 0.5,
    "quote": "Länsstyrelsen Södermanland välkomnar regeringens ambitioner om en moderniserad och lättöverskådlig lagstiftning inom viltförvaltningsområdet som syftar till att förenkla efterlevnaden av och förtydliga regelverket för samtliga berörda aktörer.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a6.2",
      "sentiment": 0.5,
      "quote": "Länsstyrelsen tillstyrker förslaget men vill betona att populationsreglerande jakt på varg fortsatt fordrar en strikt tillämpning baserat på vetenskaplig grund, och att länsstyrelserna är beroende av en tydlig nationell vägledning för att säkerställa att jakten är förenligt med att upprätthålla artens gynnsamma bevarandestatus.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5",
      "sentiment": 0.5,
      "quote": "För att älgskötselområdena inte ska bli för stora i områden med låg älgtäthet och därmed försvåra den lokala och frivilliga samverkan som är grunden för älgförvaltningen, ser länsstyrelsen behov av att det i särskilda fall ska vara möjligt att bilda älgskötselområden som inte styrs av antalet älgar som årligen kan fällas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4",
      "sentiment": -0.5,
      "quote": "Enligt länsstyrelsen är formuleringen allt för generös och riskerar att både leda till ökad skyddsjakt på berörda arter samt till en ökad resursåtgång för myndigheten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.2",
      "sentiment": 0.2,
      "quote": "De möjligheter för skyddsjakt på eget initiativ som föreslås genom 4 kap. 8 § viltförvaltningsförordningen är enligt länsstyrelsen allt för begränsade då ett agerande från en uppdragstagare kräver att tamdjuret eller viltet vid ett pågående angrepp har en viss användning eller placering.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.8",
      "sentiment": 0.5,
      "quote": "Länsstyrelsen ser dock ett behov av att myndigheten får utökade möjligheter att kräva in uppgifter om jaktresultat för att kunna fullgöra myndighetens skyldigheter att rapportera uppgifterna vidare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.9",
      "sentiment": 0.2,
      "quote": "Då skyddsjakt på enskilds initiativ varken kan förutspås eller planeras är möjligheterna att ha en särskilt tränad hund på plats inom två timmar från påskjutningen begränsade.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.12",
      "sentiment": 0.5,
      "quote": "Enligt länsstyrelsen är det inte självklart att jakt av djurskyddsskäl ryms inom den föreslagna lydelsen av bestämmelsen.",
