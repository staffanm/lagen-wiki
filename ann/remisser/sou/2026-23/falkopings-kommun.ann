    {
      "forarbete_id": "sec7",
      "sentiment": 0.2,
      "quote": "Förvaltningen har inga synpunkter på förslaget om tolkavgift då det anses påverka den kommunala organisationen minimalt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec26",
      "sentiment": 1.0,
      "quote": "Att barn ska behöva hamna i situationer som kräver att de ska tolka känsliga uppgifter för närstående innebär ohållbara situationer som barn inte ska sättas i.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec31",
      "sentiment": 1.0,
      "quote": "Att förslaget ändå innehåller undantag för akuta ärenden ses också som positivt, då det fortfarande kan behövas i akuta och livräddande situationer.",
      "quote_type": "grund"
