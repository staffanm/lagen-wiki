  "segments": [
    {
      "forarbete_id": "a1.4",
      "sentiment": -0.5,
      "quote": "Den föreslagna informationsskyldigheten avser däremot en avgift som kan uppkomma även vid framtida kontakter med myndigheter och andra aktörer som inte omfattas av skollagens tillämpningsområde.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.5",
      "sentiment": -0.2,
      "quote": "Det kan skapa osäkerhet för både enskilda och beslutande myndigheter och riskera skillnader i tillämpningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.13",
      "sentiment": -0.5,
      "quote": "Folkbildningsrådet ser en risk för att tolkavgiften därmed i praktiken drabbar just de personer som har svårast att påskynda sin språkinlärning, snarare än att fungera som det incitament utredningen avser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.1",
      "sentiment": 1.0,
      "quote": "Folkbildningsrådet delar mot denna bakgrund utredningens bedömning att personer som på grund av bestående funktionsnedsättning saknar reella möjligheter att uppnå tillräckliga kunskaper i svenska ska kunna undantas från tolkavgiften.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.7",
      "sentiment": 1.0,
      "quote": "Att ge ett barn sådant ansvar kan vara olämpligt både med hänsyn till barnets egen situation, till verksamheten och till behovet av korrekt och rättssäker kommunikation.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a22.2.4",
      "sentiment": -0.2,
      "quote": "Folkbildningsrådets erfarenhet är kvinnor överrepresenterade bland de deltagare som har en längre startsträcka för att lära sig svenska, till exempel till följd av kortare formell skolbakgrund eller till följd av att studier i sfi avbryts eller förlängs på grund av omsorgsansvar.",
      "quote_type": "grund"
    }
  ]
