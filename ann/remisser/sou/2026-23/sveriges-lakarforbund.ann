  "overall": {
    "sentiment": 0.5,
    "quote": "Läkarförbundet tillstyrker förslaget att undanta hälso- och sjukvården och socialtjänsten från den föreslagna tolkavgiften. Förbundet tillstyrker även förslaget om förbud mot att använda barn som tolk.",
    "quote_type": "standpunkt"
  },
  "segments": [
    {
      "forarbete_id": "a12.4",
      "sentiment": 1.0,
      "quote": "Införande av tolkavgift inom hälso- och sjukvården skulle, enligt Läkarförbundets uppfattning, strida mot grundläggande hälso- och sjukvårdsjuridiska och etiska principer och riskera att försämra åtkomsten till vård för personer med annat språk än svenska.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.5",
      "sentiment": 1.0,
      "quote": "En tolkavgift skulle strida mot kravet på att socialtjänsten ska vara lätt tillgänglig och riskera att motverka socialtjänstens förebyggande arbete.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec7",
      "sentiment": -0.2,
      "quote": "Läkarförbundet vill även ifrågasätta om den, såvitt förbundet kan bedöma, relativt begränsade ekonomiska besparingen av att införa tolkavgift enligt utredningens förslag verkligen väger upp för den ökade administration som avgiften medför.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.2",
      "sentiment": 1.0,
      "quote": "Barn ska inte behöva bära ansvar för att förmedla viktig information eller tolka i samtal som kan vara känslomässigt svåra eller få stor betydelse för den enskilde.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.7.6",
      "sentiment": 1.0,
      "quote": "De undantag från förbudet som föreslås – nödsituationer och uppgifter av administrativ karaktär – framstår som rimliga.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a20.2.3",
      "sentiment": 0.0,
      "quote": "Anhöriga kan, medvetet eller omedvetet, utelämna eller förändra information, inte minst när det finns konflikter eller beroendeförhållanden inom familjen/närståendekretsen.",
      "quote_type": "grund"
    }
  ]
}