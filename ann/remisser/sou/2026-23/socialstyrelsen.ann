  "segments": [
    {
      "forarbete_id": "a9",
      "sentiment": 1.0,
      "quote": "Att ha tillgång till tolk vid myndighetskontakter är ofta avgörande för att den enskilde ska kunna ta tillvara sina rättigheter.",
