  "segments": [
    {
      "forarbete_id": "sec405",
      "sentiment": 0.2,
      "quote": "Det går dock inte att utesluta att enskilda hos vissa myndigheter och i vissa ärendetyper kommer att behöva betala många tolkavgifter till följd av att den enskilde har flera parallella eller återkommande ärenden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.3",
      "sentiment": 0.5,
      "quote": "Förslaget är därmed otydligt i denna del, vilket riskerar att leda till varierande tillämpning mellan myndigheter och därmed minska förutsebarheten för enskilda.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.8.3",
      "sentiment": 0.5,
      "quote": "Mot denna bakgrund vore det rimligt att en tolkavgift som uppkommer vid kontakter med andra myndigheter bör kunna betraktas som en sådan kostnad för livsföringen i övrigt som ekonomiskt bistånd kan lämnas för.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec76",
      "sentiment": -0.5,
      "quote": "Att i stället reglera detta i lag skulle ha flera fördelar, främst genom att göra det tydligare för såväl rättstillämpare som enskilda om vad som gäller.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.8",
      "sentiment": -0.5,
      "quote": "Fakultetsnämnden föreslår därför att även ärenden som rör LSS undantas på motsvarande sätt som ärenden som rör socialtjänst.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.2",
      "sentiment": 0.5,
      "quote": "Juridiska fakultetsnämnden tillstyrker förslaget om lag om förbud mot att använda barn som tolk som sammanfattningsvis är ett angeläget steg i genomförandet av barns rättigheter enligt barnkonventionen.",
      "quote_type": "grund"
