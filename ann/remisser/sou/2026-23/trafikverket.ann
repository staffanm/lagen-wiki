  "overall": {
    "sentiment": 0.5,
    "quote": "Trafikverket är i huvudsak positivt till utredningens förslag om tolkavgift och ger nedan sina synpunkter",
    "quote_type": "standpunkt"
  },
  "segments": [
    {
      "forarbete_id": "sec18",
      "sentiment": 0.2,
      "quote": "Trafikverket anser att det behöver tydliggöras vad som definierar ett ärende och när ärenden anses vara parallella, liksom hur uttag av tolkavgift ska hanteras när flera myndigheter handlägger olika delar i ett sammanhängande ärende eller när en myndighet utför uppdrag åt en annan myndighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec378",
      "sentiment": 0.5,
      "quote": "Samtidigt bör det tydliggöras att införandet förutsätter att uppgiften kan hämtas och användas utan omfattande systemanpassningar hos de mottagande myndigheterna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec76",
      "sentiment": 0.5,
      "quote": "Förtydliganden krävs emellertid: • att det krävs att individen lyfter åberopande om undantag tidigt i ärendeprocessen, för att eliminera risken att individen reagerar först efter att debitering skett.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.3",
      "sentiment": 0.0,
      "quote": "Utredningens slutsats att ingen tolkavgift ska tas ut i ärenden som direkt rör barn, uppfattar Trafikverket som att t ex ett bilstödsärende som är föranlett av ett barns funktionsnedsättning inte ska debiteras någon tolkavgift.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a19.5",
      "sentiment": 1.0,
      "quote": "Avseende utredningens förslag om förbud mot barntolkning har Trafikverket inga synpunkter.",
      "quote_type": "standpunkt"
    }
  ]
}