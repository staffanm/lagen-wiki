  "overall": {
    "sentiment": 0.0,
    "quote": "Bodens kommun tillstyrker förslaget om förbud mot barntolk i sin helhet. Bodens kommun avstyrker däremot införandet av tolkavgift i dess nuvarande utformning.",
    "quote_type": "standpunkt"
  },
  "segments": [
    {
      "forarbete_id": "a19.5",
      "sentiment": 1.0,
      "quote": "Bodens kommun delar utredningens bedömning att barn inte ska bära ansvar för kommunikation mellan vuxna och myndigheter och att barns rätt till trygghet, integritet och en egen barndom ska värnas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec7",
      "sentiment": -1.0,
      "quote": "Bodens kommun bedömer att förslaget riskerar att motverka flera samhällspolitiska mål som samtidigt eftersträvas av staten, däribland ökad jämställdhet, förbättrad integration, stärkt myndighetssamverkan, ökad tillgänglighet för personer med funktionsnedsättning samt en effektiv och förebyggande välfärd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10",
      "sentiment": -0.5,
      "quote": "Bodens kommun ser en risk att myndigheter och kommuner behöver lägga betydande resurser på att bedöma om ett ärende omfattas av avgiftsplikt eller undantag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.11",
      "sentiment": -0.2,
      "quote": "Om LSS inte uttryckligen omfattas av undantaget finns en risk för olika tolkningar mellan huvudmän och myndigheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a22.2.4",
      "sentiment": -0.5,
      "quote": "För vissa kvinnor kan även social isolering eller hedersrelaterade normer begränsa möjligheterna att delta i utbildning, arbetsliv och samhällsliv.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec427",
      "sentiment": -0.2,
      "quote": "Om de vanligaste kontaktytorna samtidigt undantas från avgift framstår det som osäkert om reformen i praktiken kommer att utgöra ett tillräckligt starkt incitament för ökad språkinlärning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a22.2.7",
      "sentiment": -0.5,
      "quote": "Om vissa verksamheter omfattas av avgift medan andra omfattas av undantag uppstår risk för oklarheter kring ansvar, kostnader och hantering av tolkinsatser.",
      "quote_type": "grund"
    }
  ]
