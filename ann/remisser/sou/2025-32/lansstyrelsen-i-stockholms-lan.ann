  "segments": [
    {
      "forarbete_id": "a4.2.3",
      "sentiment": -1.0,
      "quote": "Det finns därmed en reell risk att ansvarsfördelningen förskjuts från markägare till myndighet och att skyddsjakt genom Länsstyrelsens beslut etableras som ett rutinmässigt verktyg i viltförvaltningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.3.2",
      "sentiment": 1.0,
      "quote": "Genom att justera rubrikerna och tydligt avgränsa vilka arter som omfattas av förbuden mot vissa jaktmedel och jaktmetoder, stärks rättssäkerheten och tillämpningen underlättas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.4.2",
      "sentiment": 1.0,
      "quote": "Det är angeläget för bland annat genetisk förstärkning, skadeförebyggande arbete och individbaserad förvaltning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.5.2",
      "sentiment": 0.2,
      "quote": "Länsstyrelsen är dock tveksam till utredningens slutsats att såväl avlivning som möjligheten att söka efter, spåra och förfölja vilt för avlivning av djurskyddsskäl kan anses omfattas av undantaget i artikel 16.1a i art- och habitatdirektivet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.6.2",
      "sentiment": 0.5,
      "quote": "För att åstadkomma en fungerande rapportering kommer det att krävas omfattande informationsinsatser, vägledning och användarvänliga digitala lösningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.7.3",
      "sentiment": 1.0,
      "quote": "Förslaget kan också minska onödig administration för både myndigheter, jägare och markägare, särskilt vid omhändertagande av döda djur som saknar förvaltningsmässig eller rättslig betydelse.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5",
      "sentiment": 0.5,
      "quote": "En sådan vägledning måste dock inte bara ge kunskapsstöd, utan också tydliggöra länsstyrelsernas mandat och ansvar i genomförandet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6",
      "sentiment": -0.5,
      "quote": "Det är därför inte rimligt att förutsätta att detta arbete kan ske inom befintliga ramar utan någon form av förstärkt finansiering.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7",
      "sentiment": 1.0,
      "quote": "Det är viktigt att det klargörs vem som får besluta om jakt och skyddsjakt i dessa områden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.7",
      "sentiment": 0.2,
      "quote": "Att sekretesskyddet enbart föreslås för ärenden som rör varg framstår därför som en otillräcklig och potentiellt godtycklig avgränsning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11",
      "sentiment": -0.5,
      "quote": "Samtidigt görs bedömningen att detta sammantaget kan hanteras inom befintliga anslag, utan att detta grundas i någon konkret resursbedömning.",
