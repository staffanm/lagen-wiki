    },
    {
      "forarbete_id": "a5",
      "sentiment": 0.5,
      "quote": "Länsstyrelsen bedömer att behovet av att komma igång med en aktiv flerartsförvaltning är stort och tillstyrker därför att en försöksverksamhet startas upp.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6",
      "sentiment": 0.2,
      "quote": "Länsstyrelsen tillstyrker att en ökad viltvårdsavgift är lämpligare än ett införande av en områdesavgift eller ett system uppbyggt av fällavgifter (på fler arter än älg).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen tillstyrker att jakt på sådant allmänt vatten och sådana klippor och öar som avses i 12 § andra stycket jaktlagen ska tillåtas efter anmälan till jaktkortsregistret.",
