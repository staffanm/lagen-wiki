    {
      "forarbete_id": "a4.3",
      "sentiment": 0.2,
      "quote": "Länsstyrelsen tillstyrker att bilagan är kvar och att rubrikerna förtydligas, men efterlyser vidare förtydligande om vad som gäller vid nyttjande av fordon för att jaga vilt identifierade på viltkamera.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.4.2",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen tillstyrker att förvaltningsmärkning av varg ska tillåtas för att myndigheter ska kunna vidta åtgärder för att förbättra den genetiska statusen för den skandinaviska vargpopulationen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.5",
      "sentiment": 0.5,
      "quote": "Länsstyrelsen bedömer ändå att nyttan med att minska vilda djurs lidande är större.",
