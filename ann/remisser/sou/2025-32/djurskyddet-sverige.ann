  "segments": [
    {
      "forarbete_id": "a4.2.3",
      "sentiment": -0.5,
      "quote": "Vi anser därför att skyddsjakt på eget initiativ inte ska vara en möjlighet och att all skyddsjakt i övrig endast ska beslutas om ifall den skadedrabbade eller den som riskerar att drabbas av skador först redovisar vilka förebyggande åtgärder hen vidtagit.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.4.2",
      "sentiment": -0.2,
      "quote": "De föreskrifter som regeringen föreslås ges bemyndigande att införa om att vilt får fångas på någon annans jaktområde i syfte att märka, undersöka eller vidta andra åtgärder på djuret utifrån behov inom viltförvaltningen, måste då även innehålla regler om att djurvälfärden för det enskilda djuret ska vägas tungt mot syftet åtgärderna och dess förutsättningar att lyckas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.5.2",
      "sentiment": 1.0,
      "quote": "Vi anser vidare att utredarens resonemang om att bedömning om ifall djuret ska avlivas ska göras när djuret lokaliserats är bra.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.6.2",
      "sentiment": 1.0,
      "quote": "Djurskyddet Sverige ser positivt på förslaget att anmälningsskyldigheten i jaktlagen utökas till att även omfatta vilt som skadats under jakt, vilt som har avlivats, som någon har försökt avliva eller som har förföljts för att avlivas samt fågelbon och ägg eller fågelungar som flyttats, så att Sverige kan uppfylla kraven i direktivet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.3",
      "sentiment": -1.0,
      "quote": "Att jaga säl på öppet vatten är en mycket riskfylld verksamhet ur djurskyddsperspektiv i och med att träffytan är liten och bärgningsarbetet är svårt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
