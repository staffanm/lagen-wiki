  "segments": [
    {
      "forarbete_id": "a4.2.3",
      "sentiment": -0.5,
      "quote": "Länsstyrelsen anser att det finns en risk för att skyddsjaktsverktyget försvagas och blir mer svårbedömt om begreppet allvarlig skada tas bort.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.5.2",
      "sentiment": 1.0,
      "quote": "Idag finns det tekniska hjälpmedel som gör att man blir uppmärksam på ett djur som är skadat eller sjukt, och man ska kunna avliva det tidigare för att undvika lidande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.4.2",
      "sentiment": 0.5,
      "quote": "Detta kommer dock med största sannolikhet att innebära en ökad arbetsbörda för länsstyrelserna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.6.2",
      "sentiment": -0.5,
      "quote": "En sådana situation uppstår ofta snabbt och utan myndighetskontakt, vilket innebär att en stor andel sannolikt inte kommer att anmälas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.6.1",
      "sentiment": -0.5,
      "quote": "Detta kan i princip inte uppfyllas i fall av jakt på enskilds initiativ då vissa händelser (med stora rovdjur) uppstår i en situation där det oftast inte finns tid för en selektiv jakt (förutom på den skadegörande individen) eller när det gäller fåglar på ett maxantal, då det inte finns ett maxantal för hur många som får fällas med stöd av jakt på enskilds initiativ.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.6",
      "sentiment": -0.2,
      "quote": "Antalet kända fall i Värmland där hot och våld förekommit mot exempelvis vargskyttar är, såvitt känt, mycket få.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5",
      "sentiment": 0.2,
      "quote": "Det är dock svårt, precis som utredningen påpekar, att bedöma hur väl olika finansieringsmodeller är lämpade, då vi inte vet hur en flerartsförvaltning ska utformas och vad den kommer kosta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": 0.5,
      "quote": "Länsstyrelsen ser positivt på att man ytterligare utreder förslaget på en områdesavgift då förslaget i grunden är positivt.",
