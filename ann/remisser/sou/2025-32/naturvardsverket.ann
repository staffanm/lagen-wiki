    }
  },
  "overall": {
    "sentiment": 0.5,
    "quote": "Vi ser att flera av de förslag som lämnas bidrar till en lagstiftning med mer moderna bestämmelser för långsiktigt hållbar jakt och viltvård.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a4.2.1",
      "sentiment": 1.0,
      "quote": "Sådana arter bör inte längre omfattas av bestämmelsen om skyddsjakt i 23 a § jaktförordningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.2.2",
      "sentiment": 1.0,
      "quote": "jakt med allmän och särskild jakttid samt skyddsjakt på enskilds initiativ enligt 26 § jaktförordningen i första hand bör användas för att förhindra skador, till exempel på gröda.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.2.3",
      "sentiment": 0.2,
      "quote": "En alltför förenklad skyddsjaktsbestämmelse avseende dessa arter kan motverka incitamenten för en samordnad förvaltning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.3.1",
      "sentiment": 0.5,
      "quote": "Systematiken i jaktlagstiftningen, där jaktmedel och hjälpmedel vid jakten regleras på flera olika nivåer (lag, förordning och föreskrift) medför att regelverket idag är svårläst.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.3.2",
      "sentiment": 0.5,
      "quote": "I brist på en tydlig definition av begreppet jaktmedel är det svårt att med säkerhet avgöra om samtliga medel och metoder som räknas upp i bilaga 5 även anses utgöra jaktmedel.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.4.2",
      "sentiment": 0.5,
      "quote": "Därför bör det finnas en möjlighet för Naturvårdsverket att besluta om fångst för märkning av fåglar så vi kan förvalta dessa populationer ändamålsenligt, vare sig det gäller att bevara arter, bruka viltet som en resurs eller hantera en ökande skadeproblematik.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.5.2",
      "sentiment": 0.5,
      "quote": "För en tydligare systematik bör förtydligandet av att sådana beslut även ska kunna tas av djurskyddsskäl i stället framgå av 23 a §.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.6.2",
      "sentiment": 1.0,
      "quote": "Sverige i nuläget inte till fullo följer sina EUrättsliga åtaganden avseende rapporteringen av jaktresultat och delar således utredningens bedömning att det bland annat krävs ökad anmälningsskyldighet för att Sverige ska uppfylla sin rapporteringsskyldighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.7.3",
      "sentiment": 1.0,
      "quote": "Dessa betraktas som utdöda i landet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.8",
      "sentiment": 1.0,
      "quote": "Vi ser svårigheter att genom vägledning ta hänsyn till ekonomiska, sociala och kulturella behov, till regionala och lokala särdrag samt till traditionell kunskap, så som utredningen framför.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.4",
      "sentiment": 1.0,
      "quote": "Naturvårdsverket delar utredningens bedömning av vad som kan ingå i en försöksverksamhet med flerartsförvaltning av klövvilt, med samma motivering som utredningen framför.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a5.5",
      "sentiment": 0.5,
      "quote": "Däremot ser vi att vid ett införande av en permanent flerartsförvaltning behövs ytterligare stöd i författning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.4",
      "sentiment": -0.5,
      "quote": "Vi bedömer att det först behöver beslutas hur flerartsförvaltning ska bedrivas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2",
      "sentiment": 1.0,
      "quote": "Förslaget ligger i linje med det förslag Naturvårdsverket redovisade i regeringsuppdraget Jakt på allmänt vatten (NV-08120-17).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2.2",
      "sentiment": 1.0,
      "quote": "Förutsatt att nya förvaltningssystem utvecklas och införs för de arter där det behövs enligt art- och habitatdirektivet, bedömer Naturvårdsverket att EU- och EES medborgare kan ges möjlighet att jaga på allmänt vatten utifrån samma förutsättningar som svenska medborgare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.3",
      "sentiment": 1.0,
      "quote": "Naturvårdsverket ställer sig bakom förslaget om jakt på säl i Sveriges ekonomiska zon, med utredningens tillhörande motivering.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.3.2",
      "sentiment": 1.0,
      "quote": "Naturvårdsverket ställer sig bakom förslaget om tillsyn över jakt i Sveriges ekonomiska zon, med utredningens tillhörande motivering.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": 0.5,
      "quote": "Genom en sådan lösning skulle den rapportering som idag är obligatorisk utifrån lagstiftningen kunna genomföras på ett för jägarna säkrare och effektivare sätt, exempelvis för säl.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5",
      "sentiment": 1.0,
      "quote": "Naturvårdsverket ställer sig bakom utredningens bedömning av samma skäl som utredningen lägger fram.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.6",
      "sentiment": 1.0,
      "quote": "Naturvårdsverket delar utredningens bedömning att inte införa en sekretessbrytande bestämmelse av samma skäl som utredningen lägger fram.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.4.2",
      "sentiment": 0.2,
      "quote": "Jaktsabotage riskerar medföra att minska både värdet på jakt som ekosystemtjänst och möjligheten att uppnå dessa politiska mål.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.7",
      "sentiment": -0.2,
      "quote": "Naturvårdsverket gör dock bedömningen att den föreslagna bestämmelsen ger otillräckligt skydd, eftersom uppgifter om enskilda avseende jakt på varg förekommer i strukturerad form i andra sammanhang hos Naturvårdsverket och länsstyrelsen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.8",
      "sentiment": 1.0,
      "quote": "För att motverka att vapen kommer till brottslig användning är det därför angeläget att även uppgifter om jägare i länsstyrelsernas register och i Rovbase omfattas av sekretess.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.1",
      "sentiment": 0.5,
      "quote": "Det skulle kunna möjliggöra ökad regelförenkling med systemövergripande förtydliganden och administrativa fördelar, exempelvis rörande framtagande av vägledning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.2",
      "sentiment": 1.0,
      "quote": "Naturvårdsverket ställer sig bakom förslaget om övergångsbestämmelser.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a11.3.1",
      "sentiment": -0.2,
      "quote": "Eftersom det är länsstyrelserna som administrerar detta har vi svårt att följa resonemanget och bedömningen.",
      "quote_type": "grund"
    }
  ]
}