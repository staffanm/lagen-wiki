    {
      "forarbete_id": "a4.5.5",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen tillstyrker förslaget till ändring i förordningen (2017:868) med länsstyrelseinstruktion om att förtydliga länsstyrelsens ansvar när det gäller att motverka uppkomst och spridning av antimikrobiell resistens hos djur och livsmedel samt verka för en rationell användning av antimikrobiella läkemedel till djur.",
      "quote_type": "grund"
