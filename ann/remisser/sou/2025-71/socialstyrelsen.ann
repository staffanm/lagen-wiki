    },
    {
      "forarbete_id": "a19.6",
      "sentiment": -0.5,
      "quote": "Det senarelagda införandet innebär dessutom att viktiga funktioner så som ordinationsorsak fördröjs, vilket inte är önskvärt ur patientsäkerhetsperspektiv.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2",
      "sentiment": 1.0,
      "quote": "Socialstyrelsen delar utredningens bedömning och förslag som möjliggör tillgång till uppgifter om ordinerade läkemedel, både förskrivna och som administreras eller överlämnas i hälso- och sjukvården, samt om vissa tillförda medicintekniska produkterskulle skapa förbättringar av patientsäkerheten eftersom patienter ofta rör sig mellan olika vårdgivare och mellan kommunal och regionalt driven vård.",
      "quote_type": "grund"
