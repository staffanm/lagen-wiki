    {
      "forarbete_id": "a4.3.4",
      "sentiment": 0.2,
      "quote": "Exempelvis är uppgifter om ordinationsorsak, som ingår i nationella läkemedelslistan, av stor betydelse för läkemedelsföretagens möjlighet att använda uppgiften i forskning och uppföljning av läkemedelsanvändning.",
      "quote_type": "grund"
    }
