    },
    {
      "forarbete_id": "a8.3.1",
      "sentiment": 0.5,
      "quote": "Regionen anser dessutom att begreppet ordination måste användas konsekvent som beslut om behandling, oberoende av om läkemedlet administreras i vården eller förskrivs på recept.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.3.3",
      "sentiment": -0.2,
      "quote": "då allt för många patienter i nuläget tolkar informationen i Läkemedelskollen som en ordinationslista.",
