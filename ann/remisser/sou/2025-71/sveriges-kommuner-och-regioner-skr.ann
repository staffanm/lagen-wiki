    },
    {
      "forarbete_id": "a10.9.2",
      "sentiment": 1.0,
      "quote": "SKR tillstyrker utredningens förslag att krav tas bort gällande skriftlig rapportering från apotek till förskrivare om utbyte av läkemedel.",
