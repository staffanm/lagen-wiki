  "segments": [
    {
      "forarbete_id": "a11.2",
      "sentiment": 0.5,
      "quote": "Inhämtande och rapportering av information kring historiska vaccinationer, givna före införandet av registret, kommer dock vara inte bara vanskligt och arbetskrävande utan också vara behäftad med stor risk för felaktigheter och dubbeldokumentation.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec558",
      "sentiment": 1.0,
      "quote": "Smittskyddsläkarnas tillgång till registret är enligt region Gävleborg en förutsättning för ett optimalt smittskyddsarbete på regional och nationell nivå.",
