  "segments": [
    {
      "forarbete_id": "a10.2",
      "sentiment": 1.0,
      "quote": "Förening vill att NLL ska vara ett register med tillhörande funktionalitet som syftar till att förbättra hur patienterna använder sina läkemedel i hemmet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.2",
      "sentiment": 1.0,
      "quote": "Dels har kravet spelat ut sin roll i och med att utbytet är etablerat, dels finns informationen att tillgå för förskrivare som, med patientens samtycke, önskar ta del av vilka läkemedel som expedierats via NLL.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11",
      "sentiment": -0.5,
      "quote": "De nya informationsmängderna är snarare kopplade till ordinationer och bör därför regleras samlat med liknande information inom ramen för EHDS och nationell digital infrastruktur.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.11.3",
      "sentiment": -0.5,
      "quote": "Det som däremot hade kunnat ge effekt på patientsäkerheten vore om farmaceuten hade möjlighet att se andra läkemedel som ordinerats och administrerats under sjukhusvård.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a15.4",
      "sentiment": 0.5,
      "quote": "Det blir därför viktigt att resultatet från den föreslagna samverkan också leder till att krav på förskrivarsidan, från Läkemedelsverket och Ehälsomyndigheten, implementeras i verksamhet och tekniska system.",
      "quote_type": "grund"
