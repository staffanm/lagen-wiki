  "segments": [
    {
      "forarbete_id": "a8.4",
      "sentiment": 0.2,
      "quote": "Samtidigt ser vi behov av ytterligare analys kring i vilken utsträckning en hybridlösning är praktiskt genomförbar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.2",
      "sentiment": 0.8,
      "quote": "Den främsta anledningen är att garanterad livslång tillgång till vaccinationsinformation förutsätter att den inte äventyras av organisatoriska och systemmässiga förändringar lokalt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12",
      "sentiment": -0.5,
      "quote": "Behovet av ett samlat register bedömer vi dock inte som lika starkt som för vaccinationsinformation, eftersom patienter inte har samma uppenbara behov av samlad information om medicintekniska produkter och inte heller rör sig mellan vårdgivare i samma utsträckning som inom vaccinationsområdet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a17.6",
      "sentiment": -0.2,
      "quote": "Dock är vår bedömning att patientens behov av informationen inte är lika stort som det är kring vacciner vilket gör att argumenten för en nationell registerlösning inte är lika starka för administrerade läkemedel.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a18.5.3",
      "sentiment": -1.0,
      "quote": "Vår bedömning är att utredningen kraftigt har underskattat den betydande komplexitet som är förknippad med att både utveckla integrationer och skapa stöd för nya informationsflöden, samt att anpassa berörda verksamheter till nya regelverk och arbetssätt.",
      "quote_type": "grund"
    },
    {
