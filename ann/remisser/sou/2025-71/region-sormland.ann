  "segments": [
    {
      "forarbete_id": "sec25",
      "sentiment": 1.0,
      "quote": "Region Sörmland stödjer utredningens förslag om en tidig lagändring att ta bort nu gällande krav om att apoteket ska rapportera skriftligt till förskrivare om ett läkemedel byts ut.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a11.2.11",
      "sentiment": 0.5,
      "quote": "Även om patienten har möjlighet att spärra registeruppgifter vill regionen poängtera att ur patientsäkerhetsperspektiv är det viktigt att vårdgivaren ser att det finns en spärr i registret som är satt av patienten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.4",
      "sentiment": 0.8,
      "quote": "Det skulle säkerställa att vaccinationsdata följer patienten på ett tydligt sätt och ger förutsättning att minska risken för informationsförlust vid till exempel ett vårdgivarbyte.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec757",
      "sentiment": -0.5,
      "quote": "Region Sörmland anser inte att det är relevant att registrera dosnummer för vacciner då dessa ofta är felaktiga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12",
      "sentiment": 0.5,
      "quote": "En av grundpelarna är att grunddata som ska fylla ett nationellt register måste kunna hämtas automatiskt från regionens ordinarie journalsystem.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec763",
      "sentiment": 1.0,
      "quote": "Region Sörmland stödjer förslaget att unik produktidentifiering (UDI) ska användas för detta ändamål, då UDI är ett krav i den medicintekniska förordningen 2017/745.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.9",
      "sentiment": 0.5,
      "quote": "Hybridlösningen är sannolikt den lösningen som bäst svarar upp mot både de nationella behoven såväl som mot EHDSkraven.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a18.6",
      "sentiment": 0.2,
      "quote": "Finansieringsprincipen ska tillämpas och regionerna behöver få kostnadstäckning för utvecklingen av nationella register.",
