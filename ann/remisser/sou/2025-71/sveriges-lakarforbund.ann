    },
    {
      "forarbete_id": "a8.2",
      "sentiment": 0.5,
      "quote": "det måste finnas ett sätt att säkerställa att enbart aktuella ordinationer speglas mot den nationella läkemedelslistan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": -0.5,
      "quote": "Vi ser ingen potentiell nytta utan i stället stora risker för att irrelevant och felaktig information stör ut det som är viktigt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12",
      "sentiment": 1.0,
      "quote": "avsaknaden av ett nationellt system för medicintekniska produkter (MTP) innebär betydande risker i vården.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.1.3",
      "sentiment": 1.0,
      "quote": "Den nuvarande fragmenteringen (avsnitt 9.1.3) innebär risk för bristande behandlingsunderlag, särskilt vid akuta bedömningar och vid vård av patienter som rör sig mellan regioner.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.4.7",
      "sentiment": 1.0,
      "quote": "En sammanhållen vaccinationshistorik är avgörande för säker vård, epidemiologisk kontroll och individens egen insyn i sina preventiva behandlingar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.2",
      "sentiment": 1.0,
      "quote": "vaccin — både administrerade och planerade — ska ingå i registret nationell läkemedelslista.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a10.6.1",
      "sentiment": -0.2,
      "quote": "För att kunna göra en säker och välgrundad bedömning vid en ny förskrivning av särskilda läkemedel är tillgången till dessa uppgifter ofta avgörande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.2.10",
      "sentiment": 0.5,
      "quote": "Utan en sådan lösning riskerar nuvarande, tidvis riskfyllda hantering att kvarstå och därmed motverka den patientsäkerhetsnytta som NLL är avsedd att skapa.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a15.2.2",
      "sentiment": 1.0,
      "quote": "vårdpersonal måste vara med och utforma gränssnittet för att det ska bli bra och användbart.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a15.3.3",
      "sentiment": 0.5,
      "quote": "Tidsbrist riskerar annars att leda till att den aktuella läkemedelslistan inte hålls uppdaterad, vilket i sin tur kan påverka både arbetsflöden och patientsäkerhet negativt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a15.3.5",
      "sentiment": -0.5,
      "quote": "en okontrollerad överföring av ändringar från NLL till journalen skulle kunna leda till bristande spårbarhet, felaktig dokumentation och potentiellt vårdskadliga situationer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a15.3.6",
      "sentiment": 1.0,
      "quote": "den nationella läkemedelslistan är sannolikt inte rätt verktyg för detta, och bör inte belastas med funktioner som riskerar att varken vara praktiskt användbara eller hålla information aktuell.",
      "quote_type": "grund"
