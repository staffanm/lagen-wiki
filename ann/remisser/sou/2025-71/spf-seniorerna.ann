  "overall": {
    "sentiment": 0.5,
    "quote": "Det är av stor vikt att uppgifter om en patients läkemedel, efter samtycke, kan delas mellan patient, vårdgivare och apotek.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a8.5",
      "sentiment": 1.0,
      "quote": "Användningen av medicintekniska produkter (med eller utan läkemedel) ökar i omfattning och det kan vara av stor betydelse för patientsäkerheten av en patients användning av sådana produkter är registrerad.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.6",
      "sentiment": 1.0,
      "quote": "SPF Seniorerna delar utredningens bedömning att en nationell sammanställning över en patients behandling med eller användning av medicintekniska produkter som ett första steg bör omfatta alla produkter som kan förskrivas och vissa medicintekniska produkter med avsedd långvarig användning, t.ex. vissa implantat och invasiva produkter samt att utvecklingen av en sådan sammanställning bör ske succesivt och i nära dialog med berörda aktörer.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.9",
      "sentiment": 1.0,
      "quote": "Det viktiga är att informationen finns tillgänglig för den som behöver den och för att trygga patientsäkerheten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.11",
      "sentiment": -0.5,
      "quote": "En trygg och säker läkemedelsbehandling av patienter i slutenvården fordrar att farmaceuter i öppenvårdsapotek även har tillgång till vilka läkemedel som används där.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.4",
      "sentiment": 0.5,
      "quote": "SPF Seniorerna menar att ett nationellt register över vilka vaccinationer som erhållits är av stor vikt för patienten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.4.4",
      "sentiment": 1.0,
      "quote": "Det kan till exempel vara att ett visst läkemedel orsakat allergi eller annan biverkning eller att patienten av annat skäl inte kan tillgodo göra sig en viss läkemedelsbehandling.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.2.12",
      "sentiment": 1.0,
      "quote": "Då listan nu föreslås utökas bland annat med uppgifter som rör vaccin och läkemedel med långvarig effekt, är det av stor vikt att patient ges samma möjligheter till direktåtkomst till sina egna uppgifter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.6.2",
      "sentiment": 1.0,
      "quote": "Det är viktigt att all information om patienten som kommer att samlas i det nya medicinteknikregistret är tillgängligt för patienten själv på samma sätt som information i nationella läkemedelslistan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.1",
      "sentiment": 1.0,
      "quote": "Som en följd av att det utökade innehållet i registret blir benämningen nationell läkemedelslista inte relevant, även om begreppet nationell läkemedelslista nu börjat bli ett känt begrepp och sannolikt kommer att användas i dagligt tal.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a15.4.1",
      "sentiment": 1.0,
      "quote": "En struktur för samverkan mellan berörda aktörer är nödvändig för att åstadkomma de nyttor som eftersträvas med en patientsäker läkemedels- och medicinteknikprocess.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a15.4.2",
      "sentiment": 1.0,
      "quote": "SPF Seniorerna delar utredningens bedömning att samverkansstrukturen bör ha i uppgift att samla representanter för berörda aktörer och med patienten i centrum utveckla läkemedels- och medicinteknikprocesserna, samt att målsättningen bör vara att ständigt förbättra patientsäkerheten i processerna utifrån omvärldsutvecklingen och att fortlöpande arbeta med detta över tid.",
      "quote_type": "standpunkt"
    }
  ]
