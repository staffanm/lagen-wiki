  "segments": [
    {
      "forarbete_id": "a4.3.3",
      "sentiment": 0.2,
      "quote": "Läkemedelsverket ser positivt på att en korrekt och enhetlig namngivning för infrastrukturen tillämpas för att säkerställa tydlighet omkring dess funktionalitet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": 0.5,
      "quote": "Samtidigt bör dock beaktas att det erfarenhetsmässigt kan finnas svårigheter att extrahera vissa uppgifter från vårdinformationssystemen med den exakthet och de säkerhetskrav som finns vid primäranvändning på individuell nivå i en hälso- och sjukvårdskontext.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.2",
      "sentiment": 0.2,
      "quote": "En central och samordnad ansats krävs för att hitta de bästa lösningarna på nationell nivå med tillförsäkrande av god patientsäkerhet och användbarhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.10.2",
      "sentiment": 0.5,
      "quote": "För att systemets potential ska kunna utnyttjas på ett effektivt sätt vill Läkemedelsverket framhålla vikten av att användargränssnitt och funktionalitet bör kunna anpassas utifrån den enskilde användarens behov, vilket till exempel kan gälla möjligheter till sökning, sortering och filtrering av information i systemet utifrån aktuell situation.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.4.4",
      "sentiment": -0.2,
      "quote": "Läkemedelsverket anser att det är angeläget att myndigheten får tillgång och direktåtkomst till specifika delar av registeruppgifter, såsom batch-nummer för vacciner, för de personer där misstänkta biverkningar rapporteras till Läkemedelsverket.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.1.5",
      "sentiment": 0.2,
      "quote": "Under förutsättning att detta förslag beslutas och att Läkemedelsverket, som sekundäranvändare av data, får tillgång till förskrivningsdata från hälsodataregistret för att använda uppgifterna för att bland annat förebygga och hantera bristsituationer instämmer Läkemedelsverket i utredningens bedömning i avsnitt 10.1.5.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.9.2",
      "sentiment": 1.0,
      "quote": "Därigenom skulle apoteken avlastas från ett lagkrav som de omöjligen har kunnat uppfylla utan omfattande administration.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.4",
      "sentiment": 0.5,
      "quote": "För att uppfylla syftet att skapa ett ändamålsenligt register och förbättra patientsäkerheten kan även tillägg av historiska data övervägas, exempelvis uppgifter om tidigare vaccinationer och vissa medicintekniska produkter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.6.2",
      "sentiment": -0.2,
      "quote": "Läkemedelsverket vill framhålla att arbetet kan bli resurskrävande inte minst eftersom registret kommer att behöva uppdateras kontinuerligt tills vidare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.6.2",
