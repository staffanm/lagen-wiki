  "segments": [
    {
      "forarbete_id": "sec6",
      "sentiment": 1.0,
      "quote": "Den problembild som beskrivs i betänkandet är en bra utgångspunkt för att skapa förståelse för behovet av en förändrad lagstiftning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec7",
      "sentiment": 1.0,
      "quote": "Det innebär också att uttrycket ”korruption” införs i svenska straffrättslig lagstiftning – något som vi länge påpekat och där Sverige har legat efter jämfört med andra länder och internationella överenskommelser som t.ex. FN:s konvention mot korruption.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec10",
      "sentiment": 1.0,
      "quote": "Vi välkomnar resonemanget att det mest ändamålsenliga sättet att tydliggöra vilka fall av mutbrott som ska anses mer eller mindre allvarliga är att förtydliga vilka omständigheter som ska beaktas vid bedömningen av om brottet är att anse som ringa eller grovt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec15",
      "sentiment": 0.5,
      "quote": "Vi har inga synpunkter på att det straffbara området för trolöshet mot huvudman inte ändras så länge som den nya bestämmelsen missbruk av offentlig ställning införs.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec16",
      "sentiment": 1.0,
      "quote": "införa ett krav på att den påverkan som utövas ska vara otillbörlig är ett bra förtydligande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec17",
      "sentiment": 0.5,
      "quote": "Vi bedömer att denna nya reglering till stor del åtgärdar, i vart fall lagstiftningsmässigt, de brister som OECD pekat på under snart 13 år.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec21",
      "sentiment": 1.0,
      "quote": "Vi ser att flera händelser i närtid hade kunnat lagföras inom ramen för ett sådant utvidgat straffansvar, där åtal inte väcktes eller inte ledde till fällande dom, vilket pekar på det faktiska behovet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7",
      "sentiment": 0.5,
      "quote": "Vi instämmer i utredarens förslag vad gäller tjänstefel under förutsättning att det föreslagna nya brottet missbruk av offentlig ställning införs.",
