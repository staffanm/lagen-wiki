  "overall": {
    "sentiment": 0.5,
    "quote": "Örebro kommun ser positivt på samtliga förslag i utredningen som bedöms kommer att ha positiva effekter både ur civilrättsligt och arbetsrättsligt perspektiv genom ökad tillgänglighet och förståelse för lagstiftningen mot korruption och missbruk av offentlig tjänst eller annan offentlig ställning i samband med eller i relation till tjänst/uppdrag.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "sec173",
      "sentiment": -0.5,
      "quote": "Kommunen vänder sig dock mot förslaget ”lag om vissa korruptionsbrott” eftersom det riskerar att leda till osäkerhet om var övriga korruptionsbrott återfinns i lagstiftningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec177",
      "sentiment": 1.0,
      "quote": "Utredningens förslag till förtydliganden av begreppet muta, samband mellan brott och anställning/uppdrag och 1 personkrets som omfattas av lagstiftningen underlättar tolkning och tillämpning även inom det arbetsrättsliga området både vid införande av förebyggande åtgärder och vid hantering av brott i samband med tjänsteutövning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec207",
      "sentiment": 1.0,
      "quote": "Detsamma gäller förslagen gällande handel med inflytande och vilka rekvisit som ska prövas vid bedömning av dessa brott, utredningens kommentarer som vi förutsätter kommer att ingå i förarbetena gör det tydligt vilka relationer och omständigheter i övrigt som ska beaktas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec223",
      "sentiment": 0.0,
      "quote": "Brottet oaktsam finansiering har vi inte tagit ställning till eftersom vi bedömer att denna typ av kriminella handlingar i första hand förekommer inom den privata sektorn.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec201",
      "sentiment": 0.2,
      "quote": "Därför ser Örebro kommun med fördel att man i lagtext skulle kunna förtydliga skillnaderna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7.2",
      "sentiment": 1.0,
      "quote": "Örebro kommun ställer sig bakom utredningens förslag om tydligare rekvisit och skärpta straff för brott av normalgraden och grovt tjänstefel liksom förtydligandet av att ringa brott ska vara förseelser som hanteras genom arbetsrättslig disciplinpåföljd såsom medvetandegörande (klargörande) samtal eller skriftlig varning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec306",
      "sentiment": 0.8,
      "quote": "Kommunen anser vidare att en sådan brottsrubricering skulle fånga upp nepotism, jäv och intressekonflikter som med nuvarande lagstiftning inte kan bli föremål för åtal, det gäller även lag- och domstolstrots som inte heller regleras i något befintligt lagrum.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec306",
      "sentiment": -0.2,
      "quote": "Det finns en risk med en utökad tystnadskultur och tjänstemän kanske inte kommer påtala brister för att det kommer finnas en rädsla för vilka konsekvenser det skulle kunna leda till.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec309",
      "sentiment": -0.5,
      "quote": "Örebro kommun anser att utredningens förslag innebär en för stor otydlighet om vilka typer av handlingar som blir straffbara.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.1",
      "sentiment": -0.5,
      "quote": "Vidare motsätter sig Örebro kommun att skuldformen uppsåt inte preciseras i de nya straffbestämmelserna som föreslås eller genom ändring av 1 kap 2 § 1 st brottsbalken enligt följande.",
      "quote_type": "grund"
