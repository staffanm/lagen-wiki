  "segments": [
    {
      "forarbete_id": "a6",
      "sentiment": 1.0,
      "quote": "Lif förordar förslaget om förhöjt kostnadsavdrag eftersom det bedöms ge starkare incitament och därmed starkare effekt på konkurrenskraften än det alternativa förslaget om återbetalningsbar skattereduktion.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7",
      "sentiment": -0.5,
      "quote": "Ett förhöjt kostnadsavdrag förflyttar Sverige från dagens bottenposition till toppen med starkast forskningsincitament i OECD, medan en återbetalningsbar skattereduktion endast förflyttar Sverige till en mittposition.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec7",
      "sentiment": -0.2,
      "quote": "Dagens FoU-avdrag präglas av otydlighet och erfarenheten från läkemedelsföretagen är att tillämpningen varierar och att internationell praxis inte tillämpas när kliniska läkemedelsprövningar ibland inte godkänns som FoU.",
