  "overall": {
    "sentiment": 0.5,
    "quote": "Sverige behöver stärka sin attraktionskraft för FoU-investeringar i en tid då många andra länder redan erbjuder kraftfulla och välkända incitament.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a5.4.1",
      "sentiment": 1.0,
      "quote": "En snäv sektorsvis avgränsning hade riskerat att missa viktiga innovationsmiljöer och skapa gränsdragningsproblem.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.4.2",
      "sentiment": 1.0,
      "quote": "Ett utgiftsbaserat incitament är bättre anpassat till målet att stimulera ökade investeringar i FoU än ett inkomstbaserat incitament.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.4.3",
      "sentiment": 1.0,
      "quote": "Ett tak skulle slå särskilt hårt mot större FoU-investeringar och minska incitamentets betydelse i internationella investeringsbeslut.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.4.4",
      "sentiment": 1.0,
      "quote": "Ett system med förhandsprövning skulle riskera att öka osäkerheten, skapa längre ledtider och innebära ytterligare administration för både företag och myndigheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.5",
      "sentiment": 0.5,
      "quote": "Tvärtom bör ambitionen vara att utforma ett system som så långt möjligt är robust även i ljuset av nya internationella regler, utan att förlora sin attraktionskraft.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.6",
      "sentiment": 1.0,
      "quote": "Detta är en viktig utgångspunkt för långsiktig stabilitet och förutsebarhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.7.3",
      "sentiment": 0.2,
      "quote": "Givet de unionsrättsliga ramarna har IKEM dock förståelse för utredningens val.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.8",
      "sentiment": -0.5,
      "quote": "IKEM anser att ett förhöjt kostnadsavdrag väger tyngre sammantaget, särskilt ur ett internationellt konkurrensperspektiv.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1.1",
      "sentiment": 1.0,
      "quote": "Detta är det alternativ som bäst svarar mot behovet av att stärka Sveriges konkurrenskraft för FoU-investeringar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1.2",
      "sentiment": 1.0,
      "quote": "Det är rimligt att utgå från personalkostnader, eftersom dessa i dag utgör den dominerande kostnadsposten i FoU-verksamhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1.3",
      "sentiment": 0.2,
      "quote": "Dagens tillämpning upplevs av många företag som oförutsebar och alltför rigid.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1.4",
      "sentiment": 1.0,
      "quote": "IKEM tillstyrker bedömningen att det förhöjda kostnadsavdraget ska gälla för alla som bedriver näringsverksamhet, oavsett företagsform.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.1.5",
      "sentiment": 1.0,
      "quote": "Det är viktigt att nivån är tillräckligt hög för att få verklig betydelse i investeringsbeslut.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1.6",
      "sentiment": 0.2,
      "quote": "Att samtidigt stärka FoUincitamenten och försämra företagens finansieringsvillkor vore kontraproduktivt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1.7",
      "sentiment": 1.0,
      "quote": "IKEM har inga invändningar mot bedömningen att det förhöjda kostnadsavdraget hanteras inom ramen för inkomstbeskattningen.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.1.8",
      "sentiment": 1.0,
      "quote": "Givet behovet av stärkt konkurrenskraft är det angeläget att reformen genomförs skyndsamt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": 0.5,
      "quote": "IKEM vill också framhålla behovet av bättre statistik och uppföljning från Skatteverket, inklusive möjligheten att identifiera och sammanställa beslut och avslagsbeslut på ett systematiskt sätt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.1",
      "sentiment": -0.5,
      "quote": "IKEM bedömer att den återbetalningsbara skattereduktionen är ett svagare alternativ än ett förhöjt kostnadsavdrag.",
      "quote_type": "grund"
    }
  ]
}