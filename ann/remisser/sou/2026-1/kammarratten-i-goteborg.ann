  "segments": [
    {
      "forarbete_id": "sec7",
      "sentiment": -0.2,
      "quote": "Kammarrätten noterar att Skatteverkets expert, Marie Björklund Eriksson, anser att Skatteverket redan idag upplever stora tillämpningssvårigheter i samband med kontrollerna av FoU-avdraget.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec214",
      "sentiment": -0.2,
      "quote": "Eftersom skattereduktionen påverkar och ingår i ett beslut om slutlig skatt torde en sådan skyldighet redan följa av reglerna i 31 kap. 3 § SFL.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.11",
      "sentiment": -0.5,
      "quote": "Det förhållandet att den nu aktuella skattereduktionen innehåller nyheten ”skattetillgodohavande” innebär inte enligt kammarrättens mening att den generella bestämmelsen i 56 kap. 7 § skatteförfarandelagen behöver ändras eller kompletteras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a57",
      "sentiment": -0.2,
      "quote": "Slutligen är kammarrätten tveksam till om det i 67 kap. 57 § andra stycket inkomstskattelagen behöver föreskrivas att det belopp som inte har kunnat utnyttjas ska tillgodoräknas den skattskyldige som ett skattetillgodohavande specifikt i ett beslut om slutlig skatt eftersom det senare följer av regleringen i skatteförfarandelagen.",
      "quote_type": "grund"
    }
  ]
