  "segments": [
    {
      "forarbete_id": "a11.1",
      "sentiment": 1.0,
      "quote": "TU delar utredningens bedömning att de aktuella postförsändelserna och tillhörande handlingar i normala fall inte är att anse som allmänna handlingar utan omfattas av undantagsbestämmelsen i 2 kap. 14 § tryckfrihetsförordningen (TF) om brev m m som lämnats in till eller upprättats hos en myndighet endast för befordran av ett meddelande.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a11.2",
      "sentiment": 1.0,
      "quote": "Det gäller dels med tanke på vikten av att upprätthålla skyddet för de berörda personernas identifikationsuppgifter, dels då den motsvarande sekretessen är absolut i den ”vanliga” postförmedlingsverksamheten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3",
      "sentiment": 1.0,
      "quote": "I dessa fall kan det finnas ett motstående insynsintresse rörande hur kontrollverksamheten bedrivs, men då bestämmelsen utformats med ett rakt skaderekvisit, d v s med en presumtion för offentlighet, kan TU godta förslaget.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.5",
      "sentiment": 1.0,
      "quote": "Vad slutligen gäller utredningens konstateranden i avsnitt 11.5 – 11.7 om att nya sekretessbrytande bestämmelser inte behövs i förhållande till folkbokföringsverksamheten, om att inga särskilda sekretessbestämmelser behövs vid bistånd med kontroll av postförsändelser och att det inte behövs några sekretessbrytande bestämmelser i förhållande till Polismyndigheten och PTS, så delar TU utredningens bedömning.",
      "quote_type": "standpunkt"
    },
