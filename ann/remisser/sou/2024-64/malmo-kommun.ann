    },
    {
      "forarbete_id": "a5.2.1",
      "sentiment": -0.2,
      "quote": "Detta kan skapa utmaningar när det kommer till att ta hänsyn till synergier mellan lagarna och undvika dubbelarbete.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.2.2",
      "sentiment": -0.2,
      "quote": "Vinstintresset mellan de två typerna av verksamhetsutövare kan variera samtidigt som omsättningen som ligger till grund för sanktioner kan vara lika hög i de båda fallen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.3",
      "sentiment": 0.5,
      "quote": "Undantagen i tillämpningsområdet av lagen om motståndskraft hos kritiska verksamhetsutövare är nödvändiga för att minimera dubbelarbete.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.3",
      "sentiment": -0.5,
      "quote": "De kritiska verksamhetsutövarna inom dessa sektorer bör som för övriga sektorer även undantas implicit genom att de regleras av lagen om cybersäkerhet eller annan lagstiftning i stället.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6-3",
      "sentiment": -0.2,
      "quote": "Malmö stad ser inte varför begreppet samhällsviktig verksamhet inte skulle kunna användas som begrepp i den föreslagna lagen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6-3",
      "sentiment": -0.2,
      "quote": "I lagen om cybersäkerhet beskrivs verksamhetsutövare som viktiga eller väsentliga, och i lagen om motståndskraft hos kritiska verksamhetsutövare beskrivs verksamhetsutövare som kritiska.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.1",
      "sentiment": 0.0,
      "quote": "För att riskbedömningarna ska bli meningsfulla är det viktigt med bred samverkan mellan tillsynsmyndigheterna och kommunerna vid meddelande om föreskrifter för riskbedömning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2",
      "sentiment": -0.2,
      "quote": "I det fall att åtgärderna ska vara genomförda vid den tidpunkten anser Malmö stad att tiden för genomförandet är för kort.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2",
      "sentiment": -0.2,
      "quote": "Det gäller inte minst att säkerställa ett tillfredsställande skydd av lokaler och kritisk infrastruktur exempelvis i fall där kommunal mark nyttjas av enskilda verksamhetsutövare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec207",
      "sentiment": 0.5,
      "quote": "Malmö stad ser därför positivt på utredarnas förslag att MSB bör få ett uppdrag av regeringen att tillsammans med tillsynsmyndigheterna se över om och hur dessa verktygslådor och annat befintligt stöd behöver anpassas och kompletteras för att kunna användas av kritiska verksamhetsutövare enligt CER-direktivet.",
