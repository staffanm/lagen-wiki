    },
    {
      "forarbete_id": "a9.3.4",
      "sentiment": -0.2,
      "quote": "Om det inte finns uppenbara skäl föreligger risk att kontrollerna blir verkningslösa då anställda kan begå brott som gör dem olämpliga för tjänsten samtidigt som det kan ta tid för verksamhetsutövaren att få kännedom om brottet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10-2",
      "sentiment": 0.2,
      "quote": "Malmö stad anser att fokus bör ligga på den rådgivande funktionen framför sanktioner.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11",
      "sentiment": 0.5,
      "quote": "Malmö stad välkomnar utredarnas syn på att det måste finnas en hög grad av förtroende och samarbete mellan tillsynsmyndighet och tillsynsobjekt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11",
      "sentiment": 0.5,
      "quote": "Malmö stad bejakar utredarnas resonemang att omständigheterna i det enskilda fallet ska avgöra sanktionsavgiftens storlek och att den kritiska verksamhetsutövarens ekonomiska styrka ska spela in.",
