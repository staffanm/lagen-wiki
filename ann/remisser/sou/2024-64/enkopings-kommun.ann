  "segments": [
    {
      "forarbete_id": "a6.1",
      "sentiment": 0.8,
      "quote": "Enköpings kommun välkomnar förslaget då det skapar en långt större tydlighet och koppling till den nationella förmågan än vad som gäller för liknande lagstiftningar idag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9-2",
      "sentiment": 0.2,
      "quote": "Samtidigt vill Enköpings kommun påpeka att förfarandet kan innebära en stor administrativ börda för verksamheterna som behöver genomföra bakgrundskontroller.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.3",
      "sentiment": 0.8,
      "quote": "Enköpings kommun välkomnar tillägget i offentlighets- och sekretesslagen (2009:400) 18 kap. 8 § som tydliggör att också uppgifter i incidentrapporter utifrån den föreslagna lagen kan skyddas av sekretess om det inte står klart att uppgiften kan röjas utan att den rapporterande verksamhetsutövarens verksamhet skadas eller de åtgärder som vidtagits motverkas.",
      "quote_type": "grund"
    }
