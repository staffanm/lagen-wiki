    },
    {
      "forarbete_id": "a9.3",
      "sentiment": -1.0,
      "quote": "För att säkerställa syftet med bestämmelsen, skapa enhetliga och rättssäkra bedömningar anser bevakningsbranschen att det är tillsynsmyndigheten och inte en kritisk verksamhetsutövare som ska besluta om en person ska anses vara lämplig",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3",
