    {
      "forarbete_id": "a6.2.1",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen delar utredningens beskrivning av utmaningarna med likheterna och olikheterna mellan begreppen samhällsviktig tjänst kontra samhällsviktig verksamhet och de otydligheter som detta skapar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2",
      "sentiment": -0.5,
      "quote": "Länsstyrelsen anser att detta skapar en begreppsförvirring jämfört med andra områden där tekniska och organisatoriska åtgärder endast utgör delmängder av säkerhetsåtgärder.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.1",
      "sentiment": -0.2,
      "quote": "Om och hur verksamheten ska beakta och hantera detta ur bland annat ett integritetsperspektiv utifrån överlappande kontroller berörs inte av utredningens förslag.",
