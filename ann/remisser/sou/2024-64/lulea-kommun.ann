    {
      "forarbete_id": "sec131",
      "sentiment": -0.2,
      "quote": "Betänkandet har dock inte beskrivit hur bedömningen kommer göras och om kommunen förväntas medverka i det arbetet samt i sådana fall hur omfattande den arbetsinsatsen blir för kommunen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4",
      "sentiment": -0.2,
      "quote": "Det framgår inte av betänkandet hur kommuner bör agera om de anlitar externa leverantörer som tillhör en utpekad samhällskritisk sektor enligt CERdirektivet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.2",
      "sentiment": 0.2,
      "quote": "en eventuell utökning av antalet sektorer förutsätter att vi som kommun får information om detta i god tid.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": -0.2,
      "quote": "Kommunen efterfrågar tydligare definitioner om vad det innebär med ”betydande, störande effekter” samt begreppet ”tillhandahållandet av tjänsten”.",
