    {
      "forarbete_id": "a5.3.4",
      "sentiment": -0.5,
      "quote": "Länsstyrelsen anser vidare att det skulle underlätta tillämpningen och öka acceptansen för regelverket om samtliga aktörer omfattades av lagens tillämpningsområde.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2.1",
      "sentiment": 1.0,
      "quote": "det stora värdet av att i framtiden se över direktivens koppling till det svenska beredskapssystemet och möjligheten till att ensa såväl begrepp som sektorer som träffas av olika regelverk.",
