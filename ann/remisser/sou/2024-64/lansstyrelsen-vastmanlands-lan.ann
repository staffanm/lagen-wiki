    },
    {
      "forarbete_id": "a9.3.1",
      "sentiment": -0.2,
      "quote": "Det vill säga hur verksamhetsutövarna ska beakta och hantera detta ur ett bland annat ett integritetsperspektiv utifrån överlappande kontroller.",
