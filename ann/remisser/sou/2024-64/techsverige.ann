    },
    {
      "forarbete_id": "a8.1",
      "sentiment": -0.2,
      "quote": "Enligt 4 kap §1 i den föreslagna lagstiftningen ska enheter göra en riskbedömning, men det är inte klart om bedömningen ska fokusera på konsekvenser för själva enheten eller för samhället.",
      "quote_type": "grund"
