  "segments": [
    {
      "forarbete_id": "a1.3",
      "sentiment": 0.5,
      "quote": "Vi anser dock att denna ändring även bör omfatta tillsynsmyndigheternas rapporter så att identifierade brister inte blir ingånginformation till obehöriga att utverka skada på företagen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec56",
      "sentiment": -0.2,
      "quote": "Detta kan i värsta fall leda till motstridig reglering från olika tillsynsmyndigheter mot samma företag/koncern.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.1",
      "sentiment": 0.8,
      "quote": "är det en rimlig bortre gräns för att skapa arbetsro och stabilitet i en verksamhet och minimera risken för att skapa en administrativ börda utan mervärde.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec39",
      "sentiment": -0.5,
      "quote": "Vi anser, i likhet med Livsmedelsverket, att syftet med lagen varken är fullständigt, fokuserat eller i linje med syftet med EUdirektivet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2",
      "sentiment": -0.5,
      "quote": "Vår uppfattning är att utredningen därmed missar viktiga delar avseende bedömningen av säkerhetsåtgärder.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.3",
      "sentiment": 0.2,
      "quote": "Här anser vi att det behövs lyftas fram mer om indirekt påverkan som kan leda till skada som är mer än ringa, då alla som har tillgång till en fysisk lokal kan orsaka sabotage och därmed bör omfattas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec231",
      "sentiment": -0.2,
      "quote": "Detta innebär en otydlighet i vad som blir godkända id-handlingar på personer som inte har EU medborgarskap.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec232",
      "sentiment": -0.5,
      "quote": "Att begära utdrag från polisens belastningsregister är tidskrävande för polisen och kommer riskera behov av ytterligare resurser beroende på hur många företag som utses och antal personer inom företagen som omfattas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec234",
      "sentiment": -0.5,
      "quote": "Det bör både vara ett intresse och en ambition att man i samband med de krav på bakgrundskontroll via belastningsregistret även ges möjlighet till ekonomisk bakgrundskontroll då detta sannolikt är den största riskfaktorn.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5",
      "sentiment": -0.2,
      "quote": "Här saknar vi en koppling mellan dessa två delar och hur denna situation ska beaktas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5",
      "sentiment": -0.2,
      "quote": "Vi ser därav en risk i att förfaringssättet med utpekande kan leda till en snedvriden konkurrens inte minst inom dagligvaruhandeln där det finns få stora aktörer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": 1.0,
      "quote": "Att rapporteringstiden för fysiska och personella säkerhetsincidenter ska vara samma som för informationssäkerhetsrelaterade incidenter, dvs 24 h, anser vi vara både korrekt och en rimlig tidsram för att kunna lämna initial information om incidenten.",
