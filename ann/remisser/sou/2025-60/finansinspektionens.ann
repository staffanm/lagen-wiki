  },
  "overall": {
    "sentiment": 0.5,
    "quote": "FI lämnar synpunkter på delar av förslagen som bör behandlas i det fortsatta lagstiftningsarbetet.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "sec309",
      "sentiment": 0.2,
      "quote": "FI anser att det i lagtexten bör anges att de likviditetshanteringsverktyg som väljs ut av fondbolag och AIF-förvaltare ska vara lämpliga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.10",
      "sentiment": -0.5,
      "quote": "Det är i linje med att reglering av konsumentkreditmarknaden på senare tid har skärpts i syfte att stärka skyddet för konsumenter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.2",
      "sentiment": 0.2,
      "quote": "behövs, enligt FI:s mening, ett tillägg om att även AIF-förvaltare och specialfonder har möjlighet att inkomma med en ansökan om ändrade fondbestämmelser senast den 16 oktober 2026.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4-8",
      "sentiment": 0.5,
      "quote": "FI konstaterar dock att utredningens förslag inte behandlar specialfonder.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.5.2",
      "sentiment": 0.0,
      "quote": "FI anser att det i det fortsatta lagstiftningsarbetet behöver förtydligas om det är möjligt för ickeprofessionella investerare att ingå i investerarkretsen indirekt genom försäkringsprodukter så som kapitalförsäkringar eller depåförsäkringar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.5.4",
      "sentiment": -0.2,
      "quote": "Enligt FI:s bedömning torde en sådan åtgärd ha en stor påverkan på andelsägarna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5-4",
      "sentiment": 0.2,
      "quote": "FI anser att inlösen av sekundärmarknadsinvesterare fortfarande bör kunna ske direkt hos värdepappersfonden om börsvärdet av andelarna i väsentlig mån avviker från fondandelsvärdet men att det inte tydligt framgår av utredningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.4",
      "sentiment": 0.0,
      "quote": "FI anser att det i det fortsatta lagstiftningsarbetet bör tydliggöras huruvida FI lämnar tillstånd till inlösen en gång per månad (enligt 4 kap. 13 § andra stycket LVF) genom godkännande av fondbestämmelserna enligt 4 kap. 9 § LVF, samt vad FI ska beakta vid en sådan prövning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.3",
      "sentiment": 0.2,
      "quote": "FI anser att det därför bör framgå av lagtexten att likviditetshanteringsverktygen som väljs ut ska vara lämpliga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.5",
      "sentiment": 0.0,
      "quote": "FI anser att det i det fortsatta lagstiftningsarbetet bör förtydligas vilka krav som ska tillämpas i förhållande till en värdepappersfonds avskilda tillgångar, så kallade sidofickor.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.7",
      "sentiment": 0.0,
      "quote": "FI anser att det i det fortsatta lagstiftningsarbetet bör förtydligas om det är FI eller en annan myndighet som ska utöva denna befogenhet över specialfonder som har en utländsk EES-baserad AIFförvaltare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2",
      "sentiment": 0.0,
      "quote": "Enligt FI:s mening framstår det som motsägelsefullt om det skulle krävas tillstånd för att utföra stödtjänster men inte för funktioner som anges i bilaga I.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": 0.0,
      "quote": "Enligt FI:s mening framstår det som motsägelsefullt om det skulle krävas tillstånd för att utföra stödtjänster men inte för funktioner som anges i bilaga I.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4",
      "sentiment": 0.0,
      "quote": "FI anser att det i det fortsatta lagstiftningsarbetet bör förtydligas om förslaget innebär en utvidgning av den krets som ingår i en AIF-förvaltares ledning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5.1",
      "sentiment": 0.2,
      "quote": "FI anser att den föreslagna bestämmelsen bör kompletteras med ett krav om att AIF-förvaltaren ska säkerställa att utförandet av det som har delegerats även sker i överenstämmelse med andra författningar som reglerar förvaltarens verksamhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7",
      "sentiment": -0.2,
      "quote": "FI delar inte utredningens bedömning att FI:s föreskrifter uttömmande ska ange vilka ändringar som är väsentliga och som därmed ska anmälas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.10",
      "sentiment": 0.0,
      "quote": "FI anser att det i det fortsatta lagstiftningsarbetet bör förtydligas hur de nya tillstånden i 4 kap. 4 a § och 5 kap. 2 c § i utredningens förslag till ändring i LAIF förhåller sig till att program för anställdas andelsägande eller sparande är undantagna lagens tillämpningsområde enligt 1 kap. 13 § andra stycket 6 LAIF.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.12",
      "sentiment": 0.2,
      "quote": "Ett förtydligande bör därför övervägas genom att en hänvisning till penningtvättsdirektivet läggs till.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.6",
      "sentiment": 0.0,
      "quote": "FI anser dock att det bör förtydligas i det fortsatta lagstiftningsarbetet.",
      "quote_type": "grund"
    }
  ]
}