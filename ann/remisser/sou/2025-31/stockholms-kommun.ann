    },
    {
      "forarbete_id": "a8.5.2",
      "sentiment": -0.8,
      "quote": "Att just dessa människor, som saknar både framtid i sitt ursprungsland och möjlighet till återvändande, inte längre skulle omfattas av permanenta uppehållstillstånd är i grunden orimligt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.6",
      "sentiment": -0.5,
      "quote": "Att hindra detta innebär inte bara ett etiskt problem utan försvårar också möjligheterna till lyckad etablering i Sverige.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5",
      "sentiment": -0.5,
      "quote": "Att skära ned på rättsligt stöd riskerar att leda till godtyckliga beslut, vilket både är rättsosäkert och ineffektivt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3.7",
      "sentiment": -0.8,
      "quote": "Avskaffade av permanenta uppehållstillstånd och ett ökat antal tillfälliga uppehållstillstånd innebär ökad osäkerhet inför framtiden hos de barnfamiljer som berörs, vilket riskerar att påverka barns hälsa negativt.",
      "quote_type": "grund"
