    {
      "forarbete_id": "a7.6.14",
      "sentiment": 1.0,
      "quote": "Asylrättscentrum välkomnar även att utredningen inte föreslår att det offentliga biträdets uppdrag vid överklagande av beslut om överföring ska begränsas i tid.",
