  "overall": {
    "sentiment": 0.0,
    "quote": "Migrationsverket delar utredningens slutsatser om utformningen av möjligheten att förklara en ansökan om internationellt skydd som uppenbart ogrundad. Migrationsverket ifrågasätter dock om det finns ett behov av en reglering utan faktisk rättsföljd som riskerar att komplicera tillämpningen.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a6",
      "sentiment": 0.2,
      "quote": "Behovet av denna möjlighet kan dock ifrågasättas, särskilt i ljuset av att regeln saknar rättsverkan och att konstruktionen med en ny rättsfigur riskerar att ytterligare försvåra en redan komplex tillämpning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.6.2",
      "sentiment": 1.0,
      "quote": "Ur ett rättssäkerhetsperspektiv finns det stora fördelar med att den kostnadsfria rättsliga rådgivningen tillhandahålls av någon som är myndighetsoberoende och som har rättslig kompetens.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.6.6",
      "sentiment": -0.5,
      "quote": "Migrationsverket är vidare tveksamt till att de föreslagna tidsbegränsningarna möjliggör efterlevnad av de krav som ställs i de aktuella förordningarna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8",
      "sentiment": -0.2,
      "quote": "Utifrån Migrationsverkets perspektiv kommer utredningens förslag om att permanent uppehållstillstånd ska utmönstras för vissa grupper få stor påverkan på Migrationsverkets verksamhet, bland annat genom ett ökat antal förlängningsärenden och en ökad komplexitet i ärendena.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5.2",
      "sentiment": 0.2,
      "quote": "Att införa tidsbegränsade uppehållstillstånd för vidarebosatta torde innebära att möjligheten till integration i Sverige försvåras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5.3",
      "sentiment": 1.0,
      "quote": "Migrationsverket tillstyrker utredningen förslag om att utmönstra permanent uppehållstillstånd för en utlänning som beviljas ställning som varaktigt bosatt.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.7.2",
      "sentiment": -0.5,
      "quote": "Utifrån de nya bestämmelserna rörande preskription av avlägsnandebeslut ser Migrationsverket, till skillnad från utredningen, att det finns vägande skäl att utöka möjligheten att i vissa situationer upphäva ett avlägsnandebeslut.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.3",
      "sentiment": 0.5,
      "quote": "Migrationsverket anser att det bli tydligare och verkar för större enhetlighet att förhålla sig till en och samma definition och ett begrepp som redan är etablerat inom prövningen av ärenden om anhöriginvandring.",
      "quote_type": "grund"
