  "segments": [
    {
      "forarbete_id": "sec310",
      "sentiment": 0.5,
      "quote": "Det är därför viktigt att det offentliga inte bara tar dessa avgörande resurser i anspråk utan att det också ges förutsättningar för finansiering av de insatserna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.1",
      "sentiment": 0.5,
      "quote": "Vi vill samtidigt lyfta vikten av att det i detta ansvar även innefattas att inkludera externa aktörer i planen och i alla avtal inkludera vilket ansvar som åligger enskilda aktörer och därmed även inkludera att ta hänsyn till hur kostnaderna som medföljer ansvaret fördelas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5.6",
      "sentiment": 0.2,
      "quote": "Hänsyn till ett kraftigt ökat resursbehov behöver tas och kan inte alltid regleras i förväg då arten av krisen styr hur påverkan blir.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.8.4",
      "sentiment": 0.2,
      "quote": "Vi vill dock lyfta vikten av att löpande under en kris bedöma vilka merkostnader som kan följa av de anpassningar som kan komma att behöva göras och att påverkan i vissa verksamheter kan bli väldigt omfattande, särskilt för verksamheter som primärt vänder sig till personer med mycket omfattande behov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.8.4",
      "sentiment": 0.2,
      "quote": "vill lyfta vikten av att det i avtal med externa utförare är mycket väsentligt att det tydligt framgår hur ansvaret fördelas mellan uppdragsgivaren och utföraren samt att adekvat ersättning utgår.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec42",
      "sentiment": 0.5,
      "quote": "För att den snabbrörligheten ska kunna tas tillvara måste också det offentliga sluta upp genom att möta förändringar i behov och förutsättningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec68",
      "sentiment": 0.2,
      "quote": "Vi saknar dock i analysen vikten av den roll som idéburna utförare av vård och omsorg tillsammans med andra delar av civilsamhället har för att nå ut till de mest svårnådda personerna i samhället.",
