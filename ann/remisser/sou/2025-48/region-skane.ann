    },
    {
      "forarbete_id": "a8.8.2",
      "sentiment": 0.5,
      "quote": "Det behöver dock speciﬁceras vad beredskap för storskalig smittspårning innebär, utöver det som tas upp om behov av standardiserade data och interoperabla IT-system.",
      "quote_type": "grund"
    },
    {
