    },
    {
      "forarbete_id": "a8.9.5",
      "sentiment": 0.5,
      "quote": "Arbetet behöver ske i nära samarbete med regionerna som har det ordinarie uppdraget att tillhandahålla och utveckla system för smittspårning i normalläge.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.11",
      "sentiment": 1.0,
      "quote": "VGR delar utredningens analys och bedömning att kostnaderna för utveckling av IT-system, data och digitala verktyg för testning innebär en ambitionshöjning för att uppnå nationell interoperabilitet.",
