  "segments": [
    {
      "forarbete_id": "sec580",
      "sentiment": 1.0,
      "quote": "En stärkt nationell samordning är avgörande för att säkerställa en likvärdig och effektiv smittspårning vid framtida pandemier.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec559",
      "sentiment": 1.0,
      "quote": "Att Folkhälsomyndigheten även får i uppdrag att samordna arbetet med att utveckla en nationell laboratorieberedskap vid storskalig testning är ett bra initiativ.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec39",
      "sentiment": 1.0,
      "quote": "Det ses positivt på att barnets bästa särskilt ska beaktas vid föreskrifter och beslut om samhällsinriktade smittskyddsåtgärder som påverkar verksamheter, sammankomster och tillställningar riktade till barn.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec54",
      "sentiment": 0.5,
      "quote": "Enligt regionens smittskyddsenhets bedömning är det rimligt att det finns en sanktionsmöjlighet för att upprätthålla efterlevnaden av smittskyddsföreskrifter i vissa situationer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec36",
      "sentiment": 1.0,
      "quote": "Uppfattningen delas att en helhetssyn är nödvändig för att säkerställa att smittskyddsarbetet inte leder till oproportionerliga skador på andra delar av folkhälsan och att hanteringen av en pandemi inte enbart kan ligga på smittskyddsmyndigheter, utan kräver en bredare samhällelig samverkan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.3",
      "sentiment": 1.0,
      "quote": "Smittskyddsenheten instämmer med att kravet på vetenskap och beprövad erfarenhet inte ska utgöra ett hinder vid smittskyddsåtgärder i situationer där kunskapsläget är ofullständigt.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec567",
      "sentiment": 1.0,
      "quote": "kan uppstå situationer där skyldigheten att uppsöka läkare och genomgå provtagning inte längre fyller en praktisk funktion – varken för den enskilde individen eller ur smittskyddsperspektiv.",
      "quote_type": "grund"
    },
    {
