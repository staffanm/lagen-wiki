  "segments": [
    {
      "forarbete_id": "sec39",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen delar även utredningens förslag om att principen om barnets bästa bör vara bärande för samhällsinriktade smittskyddsåtgärder som berör barn och att alla aktörer kontinuerligt bör genomföra barnrättsliga analyser inför beslut och åtgärder som vidtas med stöd av den föreslagna lagen.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec62",
      "sentiment": 0.2,
      "quote": "Länsstyrelsen instämmer i utredningens bedömning att det finns en risk att tillsyn över allmänna sammankomster och offentliga tillställningar uppfattas som en dubbel tillsyn som kan leda till gränsdragningssvårigheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a2.1.2",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen håller med om att det är viktigt att lagen anpassas efter epidemiologiska läget och till förutsättningarna att begränsa smittspridning i olika verksamheter och över tid.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec41",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen håller med utredarna om att det är viktigt att arbetet med att minska smittspridningen först och främst bygger på eget ansvar och egna bedömningar av lämpliga åtgärder.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec33",
      "sentiment": 0.2,
      "quote": "Annars riskerar det att bli stora skillnader i bedömningar hos tillsynsmyndigheterna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec46",
      "sentiment": 1.0,
      "quote": "Det är bra att utredningen i 5 kap. 5 § tydliggjort att även den som upplåter en lokal, ett område eller ett utrymme har ansvar att vidta smittskyddsåtgärder.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec47",
      "sentiment": 0.5,
      "quote": "Här vill länsstyrelsen trycka på vikten av att det finns vägledning kring hur bedömningar ska genomföras och att det finns enkla sätt att anmäla detta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec59",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen anser att det är bra att denna möjlighet finns för de fall en viss verksamhet, sammankomst eller tillställning inte följer bestämmelserna eller inte vidtar de åtgärder som bedöms krävas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec64",
      "sentiment": 1.0,
      "quote": "Att begära handräckning av Polismyndigheten är inte heller främmande för länsstyrelsen och det är bra att det i lagstiftningen framgår att detta är möjligt i det enskilda fallet.",
