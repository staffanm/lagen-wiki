  "segments": [
    {
      "forarbete_id": "a2.1",
      "sentiment": 0.8,
      "quote": "SMLF anser att det är en välbalanserad hållning, då studier och forskningsöversikter efter covid-19-pandemin inte visat något tydligt samband mellan långtgående smittskyddsåtgärder, såsom nedstängningar, och utfall i form av lägre nivå av överdödlighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.8",
      "sentiment": 0.8,
      "quote": "En god beredskap är särskilt viktig eftersom det sannolikt är i inledningsskedet av en pandemi som dessa insatser har störst potential att ha effekt på smittspridningen och sjukdomsbördan och åtgärderna måste således komma på plats snabbt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.9.4",
      "sentiment": 0.8,
      "quote": "En förutsättning för att testning och smittspårning ska vara effektiva och kunna hanteras med rimliga resurser är kommunicerande it-system för testresultat samt välfungerande digitala verktyg för smittspårning, varför det välkomnas att utredningen föreslår att Folkhälsomyndigheten i samarbete med E-hälsomyndigheten ska samordna regionernas arbete med att utveckla detta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5",
      "sentiment": -0.2,
      "quote": "Under covid-19-pandemin togs beslut om att avskaffa anmälningsplikten nationellt utifrån belastningen i bland annat Region Stockholm, trots att andra regioner hade kapacitet att fortsätta anmäla och smittspåra och även gjorde det.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.6",
      "sentiment": -0.5,
      "quote": "Dels kommer det i en sådan situation sannolikt att finnas många andra arbetsuppgifter som smittskyddsläkaren måste utföra, och dels bör inte smittskyddsläkaren ta rollen som behandlande läkare, som kan bli fallet om undersökningen inkluderar provtagning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.6.6",
      "sentiment": 0.8,
      "quote": "Mycket välkommet att denna fråga utreds och att ansvaret för karantänsplatser tydliggörs.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a5.3.6",
      "sentiment": -0.2,
      "quote": "Erfarenheten från covid-19-pandemin är att framför allt skolor krävde mycket stora arbetsinsatser för smittskydden, med många lokala eller individuella beslut som riskerade att bli ojämlika över landet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec52",
      "sentiment": -0.2,
      "quote": "Denna möjlighet bör endast utnyttjas i mycket sällsynta fall, då det finns en risk att folksamlingar som annars skulle uppstå utomhus i stället flyttar inomhus, med högre risk för smittspridning som följd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec8",
      "sentiment": -0.2,
      "quote": "En erfarenhet från covid-19-pandemin är att det kunde vara omöjligt att följa olika myndighetsrekommendationer från exempelvis Folkhälsomyndigheten, Socialstyrelsen och Arbetsmiljöverket, då dessa stod i strid med varandra.",
