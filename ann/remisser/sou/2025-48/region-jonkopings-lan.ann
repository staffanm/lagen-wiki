  "segments": [
    {
      "forarbete_id": "a2.1.1",
      "sentiment": 0.8,
      "quote": "Region Jönköpings län anser att det är en välbalanserad hållning, då studier och forskningsöversikter efter covid-19-pandemin inte visat något tydligt samband mellan långtgående smittskyddsåtgärder, såsom nedstängningar, och utfall i form av lägre nivå av överdödlighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a2.1.5",
