  "segments": [
    {
      "forarbete_id": "sec7",
      "sentiment": 1.0,
      "quote": "TCO ser fördelar med förslaget om en ny målkonstruktion, där utsläppen ska följa en linjär målbana relativt dagens punktmål.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec6",
      "sentiment": 0.5,
      "quote": "TCO ser tydlig fördel i förslaget om byte av basår genom ökad tydlighet och jämförbarhet relativt EU-lagstiftningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.2.1",
      "sentiment": 1.0,
      "quote": "Ökad uppföljning av kompletterande åtgärder är central för att säkerställa att de nya målen och nytt basår inte leder till högre utsläpp jämfört med nuvarande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.2.2",
      "sentiment": 1.0,
      "quote": "TCO ser tydligt behov av att skyndsamt ta ställning till vilka bokföringsregler som ska gälla för kompletterande åtgärder och ser positivt på miljömålsberedningens förslag om sådana regler.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.3.2",
      "sentiment": 1.0,
      "quote": "Givet vikten av att alla partier står bakom klimatmålen är det fullt rimligt att Miljömålsberedningen framöver får i uppdrag att genomföra en översyn av Sveriges målkonstruktion och etappmål för 2040 givet förväntningar om systembärande förändringar av EUregelverket.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1",
      "sentiment": 1.0,
      "quote": "TCO välkomnar bibehållandet av 2030-målet för inrikes transporter då omställningen av transportsektorn är central för att nå Sveriges åtaganden inom EU och nationellt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec90",
      "sentiment": 1.0,
      "quote": "TCO håller med om att det behövs en målbild för transportsektorn även efter år 2030 och tillstyrker förslaget att regeringen ska ge i uppdrag till relevanta myndigheter att föreslå mål eller indikatorer för utfasning av fossila bränslen och elektrifiering av fordonsflottan som kompletterar EU-lagstiftningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec101",
      "sentiment": 1.0,
      "quote": "TCO ställer sig positiv till förslaget att miljömålsberedningen att ledamöterna i Klimatpolitiska rådet utses av en valberedning samt att förordnandetiden för ledamöterna förlängs.",
      "quote_type": "standpunkt"
