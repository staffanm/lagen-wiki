  "segments": [
    {
      "forarbete_id": "a5.1",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen välkomnar att förslaget innebär en ökad grad av harmonisering till Sveriges EU-åtagande och bidrar till en ökad tydlighet och jämförbarhet mellan nationella och europeiska klimatmål, bland annat genom att använda 2005 som basår i stället för 1990.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.1.2",
      "sentiment": 1.0,
      "quote": "Hur stor uppvärmning som sker styrs av det totala utsläppet av växthusgaser, inte av om målet nås vid en viss tidpunkt.",
