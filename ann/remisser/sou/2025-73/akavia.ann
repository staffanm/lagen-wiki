    },
    {
      "forarbete_id": "a5.8.4",
      "sentiment": 0.2,
      "quote": "Akavia vill särskilt synliggöra våld i nära relationer som kan påverka arbetet – arbetsgivare behöver rutiner, utbildning och stödlinjer.",
