    },
    {
      "forarbete_id": "a4.1.2",
      "sentiment": 1.0,
      "quote": "Sverige behöver på bästa sätt följa med, lära och anpassa vårt nationella arbetsmiljöarbete utifrån vad nya rön, förutsättningar och bestämmelser säger.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.1.3",
      "sentiment": 0.5,
      "quote": "Det är viktigt att den typen av arbetsgivare får stöd i att klara av sitt uppdrag att skapa en god arbetsmiljön under dessa förutsättningar.",
