  "segments": [
    {
      "forarbete_id": "a3.4.5",
      "sentiment": -0.5,
      "quote": "Man kan inte bortse från att regeringens arbetsmiljöstrategi är ett styrmedel bland andra som berör Arbetsmiljöverket.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.3.3",
      "sentiment": -1.0,
      "quote": "Förslaget om en nationell samordningsfunktion i regeringskansliet saknar enligt vår uppfattning en sakligt grundad motivering, och utredningen redovisar inga erfarenheter, som kan stödja att ett sådant tillvägagångssätt har några positiva effekter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5",
      "sentiment": -0.5,
      "quote": "Fem år är en alldeles för kort tid för en strategi för att kunna följas upp och för att vi ska kunna se några långsiktiga effekter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.2.4",
      "sentiment": 1.0,
      "quote": "Det brottsförebyggande arbetet behöver vara en del av den ordinarie verksamheten, och Arbetsmiljöverket har redan tagit steget rent organisatoriskt till att integrera den befintliga verksamheten med samverkan mot arbetslivskriminalitet med den övriga ordinarie kontrollverksamheten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec84",
      "sentiment": -1.0,
      "quote": "Uppdelningen av nollvisionen på två olika delmål förtydligar inget och kommer inte att bidra till att minska arbetsrelaterad dödlighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec76",
      "sentiment": 0.5,
      "quote": "Elever och studenter behöver lära sig hur man arbetar systematiskt med arbetsmiljöfrågorna och hur man undviker att utsätta sig för risker redan i skolan och när de är på praktik, exempelvis i de yrkesförberedande gymnasieutbildningarna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.2.1",
      "sentiment": -0.2,
      "quote": "Namnen på delmålen idag är så lika att det blir diffust var gränserna går mellan vad som är hållbart och hälsosamt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.2.5",
      "sentiment": -0.2,
      "quote": "Målbilderna under detta delmål behöver i vissa delar konkretiseras eller implementeras i målbilderna under övriga tre delmål eftersom de till viss del överlappar.",
