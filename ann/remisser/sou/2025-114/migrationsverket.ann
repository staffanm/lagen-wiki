    {
      "forarbete_id": "a14.1.4",
      "sentiment": 0.5,
      "quote": "Det är enligt Migrationsverkets mening positivt att ”inhibition av verkställigheten” enligt Ds 2024:23 nu ska kunna handläggas enligt LSU.",
