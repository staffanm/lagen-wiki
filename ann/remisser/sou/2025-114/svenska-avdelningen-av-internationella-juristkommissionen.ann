  "segments": [
    {
      "forarbete_id": "a5.7",
      "sentiment": -1.0,
      "quote": "Juristkommissionen anser att ett sådant tillvägagångssätt är rättsstatligt betänkligt och svårförenligt med grundläggande rättssäkerhetskrav.",
