    },
    {
      "forarbete_id": "a6.8",
      "sentiment": -1.0,
      "quote": "Juristkommissionen bedömer att en sådan ordning riskerar att väsentligt utöka den faktiska räckvidden av övervakningen och göra proportionalitetsbedömningen både svårare och mer svårkontrollerad.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec15",
      "sentiment": -1.0,
      "quote": "I LSU-ärenden, där sekretess och underrättelseinformation ofta begränsar insynen, riskerar domstolsprövningen att i praktiken få en mer begränsad kontrollfunktion.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.11",
      "sentiment": -1.0,
      "quote": "Utredningens mer generella proportionalitetsresonemang ger inte tillräckligt skydd för barns särskilda rättigheter.",
