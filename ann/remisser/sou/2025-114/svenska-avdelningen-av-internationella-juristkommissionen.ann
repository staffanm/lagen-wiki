    },
    {
      "forarbete_id": "a5.8.2",
      "sentiment": -1.0,
      "quote": "En ordning där förvar upp till tolv månader kan aktualiseras riskerar att, i praktiken, förskjuta undantag till huvudregel särskilt i komplexa ärenden där staten samtidigt kontrollerar handläggningstakt och underlagets tillgänglighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.7",
      "sentiment": -1.0,
      "quote": "Juristkommissionens uppfattning är dock att den föreslagna bestämmelsen har en alltför generell utformning som den enskilde har mycket svårt att värdera och försvara sig mot.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.9",
      "sentiment": -1.0,
      "quote": "En konstruktion där anknytning till en grupp ges avgörande betydelse, utan tydliga krav på individualiserade omständigheter, skapar betydande rättssäkerhetsrisker.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6",
      "sentiment": -1.0,
      "quote": "Sammantaget riskerar detta att urholka kravet på en reell och effektiv prövning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7",
      "sentiment": -1.0,
      "quote": "Utredningen redovisar inte tillräckligt varför en sådan utvidgning är nödvändig eller hur riskerna för överanvändning och ändamålsglidning ska motverkas.",
