  "segments": [
    {
      "forarbete_id": "a3.2.1",
      "sentiment": 1.0,
      "quote": "Myndigheten bedömer att kostnadsfrihet är en effektiv och ändamålsenlig smittskyddsåtgärd då det skapar incitament för den smittade att söka vård och behandling, vilket i sin tur minskar risken för smittspridning.",
