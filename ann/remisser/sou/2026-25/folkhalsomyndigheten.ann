    },
    {
      "forarbete_id": "a3.3.1",
      "sentiment": 0.5,
      "quote": "Myndigheten vill dock påtala behovet av att ett sådant uppdrag behöver inkludera arbetet med implementeringen av Europarlamentets och rådets förordning (EU) 2022/2371 av den 23 november 2022 om allvarliga gränsöverskridande hot mot människors hälsa och om upphävande av beslut nr. 1082/2013/EU (hälsohotsförordningen).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.6",
      "sentiment": 1.0,
      "quote": "Informationsplikten som smittskyddsåtgärd vid sexuellt överförbara sjukdomar kan inge en falsk trygghet som uppfattas som att avsaknad av information innebär avsaknad av risk.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5-2",
      "sentiment": 1.0,
      "quote": "Folkhälsomyndigheten anser att utredningens förslag innebär att den enskildas rättigheter och skyldigheter förtydligas och bidrar till stärkt rättssäkerhet för enskilda.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.6",
      "sentiment": 1.0,
      "quote": "Myndigheten anser därför att utredningens förslag är väl avvägt och tydligare utgår ifrån de grundläggande principerna om frivillighet som utgångspunkt och att tvångsåtgärder endast ska vidtas när andra möjligheter saknas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.11",
      "sentiment": 1.0,
      "quote": "Forskning om hiv, som epidemiologiskt har annorlunda förutsättningarna än övriga sexuellt överförbara infektioner, visar att effekten av informationsplikt vid hiv gentemot sexpartners sannolikt är mycket marginell i förhållande till intrånget i den enskildes privatliv.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": 1.0,
      "quote": "Ett upphävande av regleringen om rikskod kommer avsevärt att förbättra och effektivisera Folkhälsomyndighetens epidemiologiska övervakning av de sjukdomar som omfattas av rikskod.",
      "quote_type": "grund"
