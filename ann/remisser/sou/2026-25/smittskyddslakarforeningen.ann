    {
      "forarbete_id": "a3.2.1",
      "sentiment": 1.0,
      "quote": "Smittskyddsläkarföreningen delar utredningens bedömning att det är angeläget att behålla möjligheten till beslut om kostnadsfrihet för undersökning, vård och behandling för vissa sjukdomar, även om smittskyddslagens bestämmelser om allmänfarliga sjukdomar i övrigt inte bedöms vara nödvändiga.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a3.2.3",
      "sentiment": 0.5,
      "quote": "Detta kan försvåra smittskyddsläkarens utredningsarbete av sjukdomar som endast är smittspårningspliktiga.",
