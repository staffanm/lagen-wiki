    {
      "forarbete_id": "a3.2.2",
      "sentiment": 0.8,
      "quote": "Förslaget ger ett mer flexibelt system som bättre kan anpassas till framtida epidemiologiska förändringar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.3.2",
      "sentiment": 0.5,
