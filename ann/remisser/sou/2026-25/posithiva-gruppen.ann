  "segments": [
    {
      "forarbete_id": "a3.2.1",
      "sentiment": 1.0,
      "quote": "PG menar att det är avgörande för smittskyddet att så många hinder som möjligt avlägsnas för att enskilda lättare ska kunna vända sig till vården.",
