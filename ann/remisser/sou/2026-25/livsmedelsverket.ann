    {
      "forarbete_id": "a7.3.8",
      "sentiment": 0.0,
      "quote": "noterar att det förslag som ges gällande att smittskyddsläkarens benämning bör ändras till regional smittskyddsläkare även innebär en förändring av 4 § Livsmedelsverkets föreskrifter (LIVSFS 2005:7) om epidemiologisk utredning av livsmedelsburna utbrott.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.11",
      "sentiment": 0.0,
      "quote": "i kap VIII, punkt 2 i bilaga II till förordning (EG) 852/2004 finns det en skyldighet för arbetstagare att informera arbetsgivaren/livsmedelsföretaget om arbetstagaren lider eller är bärare av en sjukdom som kan överföras via livsmedel eller som till exempel har infekterade sår, hudinfektioner, andra sår eller diarré får inte tillåtas att hantera livsmedel eller vistas på en arbetsplats där livsmedel hanteras om det finns risk för direkt eller indirekt kontaminering.",
      "quote_type": "grund"
    }
  ]
