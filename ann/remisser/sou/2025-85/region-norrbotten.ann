  "segments": [
    {
      "forarbete_id": "a7.5",
      "sentiment": 0.8,
      "quote": "Dessa politikområden har många gemensamma mål och beröringspunkter, men deras delvisa överlappning har hittills skapat otydlighet – både för offentliga aktörer som arbetar med utvecklingsfrågor och för företag och organisationer som ska ta del av insatserna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.1",
      "sentiment": 0.5,
      "quote": "Region Norrbotten stödjer förtydligandet av civilsamhällets roll och potential att bidra i det regionala utvecklingsarbetet, samtidigt som kapaciteten hos civilsamhällets organisationer att delta kan vara en utmaning.",
      "quote_type": "grund"
