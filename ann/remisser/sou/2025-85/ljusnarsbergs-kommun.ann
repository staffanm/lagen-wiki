  "segments": [
    {
      "forarbete_id": "a3.1",
      "sentiment": 1.0,
      "quote": "Beträffande frågan om den regionala utvecklingspolitiken och den sammanhållna landsbygdspolitiken skall slås samman till ett område är Ljusnarsbergs kommun positiv till detta.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a3.3",
      "sentiment": -0.2,
      "quote": "Vad gäller den tekniska utvecklingen i allmänhet och digitaliseringen i synnerhet innebär detta stora kostnader för kommunerna, detta är ett gissel då kommunerna är hårt pressade av digitaliseringsföretagens makt och deras ständiga försök att dränera kommunernas ekonomi.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.5",
      "sentiment": 0.5,
      "quote": "För dessa kommuner är det av yttersta vikt att den kommunalekonomiska utjämningen fungerar för att möjliggöra en positiv utveckling för små kommuner med begränsade resurser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.6",
      "sentiment": -0.2,
      "quote": "Det är olyckligt att de statliga myndigheterna till mycket stora delar har olika geografiska organisationer vilket skapar för kommunerna ett flertal olika geografiska samverkansorgan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.1",
      "sentiment": -0.2,
      "quote": "Här bör påtalas att den pågående sociala dumpning som förekommer mellan olika kommuner inte främjar den sammanhållning som önskas uppnås.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.2",
      "sentiment": -0.2,
      "quote": "Därtill skall noteras att de regionala gränserna utgör problem när det gäller samverkan inom närområdet i de fall en kommun befinner sig i utkanten av en region.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.3",
      "sentiment": 1.0,
      "quote": "Ljusnarsbergs kommun ser positivt på att utredningen noterar att myndigheternas interna geografiska indelningar inte matchar med varandra och med regionerna.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.1",
      "sentiment": 1.0,
      "quote": "Därav skulle en ökad tvärsektoriell samverkan mellan statliga myndigheter vara en klar fördel.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": 0.5,
      "quote": "Ljusnarsbergs kommun vill understryka den stora vikten av att finansieringsprincipen vidmakthålls, för i synnerhet mindre kommuner innebär ökade statliga pålagor en stor påfrestning på den kommunala ekonomin.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": 0.2,
      "quote": "det bör påtalas att en viss försiktighet behöver iakttas vad gäller samverkan med civilsamhället, detta representerar oftast ett särintresse och därmed kan de ur en demokratisk synvinkel få ett för stort inflytande, intressen som inte är lika organiserade kan riskera att bli åsidosatta.",
