  "overall": {
    "sentiment": 0.2,
    "quote": "Region Halland delar i stort utredningens identifierade utgångspunkter och huvudfrågor.",
    "quote_type": "standpunkt"
  },
  "segments": [
    {
      "forarbete_id": "sec69",
      "sentiment": -1.0,
      "quote": "Det är Region Hallands fasta hållning att en ombildning till större regioner inte hade resulterat i ett mer framgångsrikt regionalt utvecklingsarbete.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec122",
      "sentiment": -0.2,
      "quote": "Region Halland anser att en ökad statlig styrning av den territoriella politiken inte får gå ut över regionernas mandat att i demokratiskt förankrade processer anpassa och prioritera insatser efter lokala förutsättningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec131",
      "sentiment": 1.0,
      "quote": "Region Halland upplever att det saknas en samlad analys av i vilken utsträckning regioner och andra aktörer bidrar till den nationella målsättningen för den territoriella politiken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec150",
      "sentiment": 0.0,
      "quote": "Det måste därför fortsatt finnas en flexibilitet i systemet som ger regioner, myndigheter och andra aktörer möjlighet att samverka i gemensamma utvecklingsprocesser när specifika behov uppstår.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec153",
      "sentiment": -0.5,
      "quote": "Region Halland ser inte behov av en intermediär i en sådan samverkansstruktur.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a1.1",
      "sentiment": 1.0,
      "quote": "Region Halland har redan idag en upparbetad samverkan med civilsamhället och har inte några invändningar mot det författningsförslag som presenteras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5",
      "sentiment": 0.0,
      "quote": "Utifrån delbetänkandet är det därför svårt att bedöma vilken effekt en sammanslagning skulle ha och i vilken mån det vore positivt för den territoriella politiken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec184",
      "sentiment": -0.5,
      "quote": "På sikt kan det annars finnas en risk att systemen sammantaget hämmar landets samlade tillväxt- och omställningsförmåga.",
      "quote_type": "grund"
    }
  ]
