    {
      "forarbete_id": "a5.5",
      "sentiment": 0.8,
      "quote": "För att uppnå regional utveckling och landsbygdsutveckling i enlighet med målen inom Agenda 2030 krävs en i högre grad sektorsövergripande statlig samverkan.",
      "quote_type": "grund"
