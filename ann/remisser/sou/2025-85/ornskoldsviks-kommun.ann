  "overall": {
    "sentiment": 0.5,
    "quote": "Örnsköldsviks kommun är positiva till syftet med att skapa en mer sammanhållen, tydlig och långsiktigt hållbar utvecklingspolitik som stärker hela Sveriges utvecklingsförmåga och gör att olika regioners och kommuners särskilda förutsättningar tas bättre tillvara.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "sec27",
      "sentiment": 1.0,
      "quote": "Kommunen ställer sig bakom att styrningen ska vara sammanhållen då utredningen berör många politikområden, från infrastruktur och utbildning till försvarsperspektiv och areella näringar för att nämna några.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7",
      "sentiment": 0.5,
      "quote": "Kommunen anser att landsbygdsfrågor inte ska isoleras från regional utveckling och ställer sig positivt att landsbygdernas särskildheter lyfts och att de behöver få större utrymme i såväl den nationella som regionala politiken eller i en eventuell ny territoriell politik.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec71",
      "sentiment": 1.0,
      "quote": "Det är positivt att utredningen lyfter utmaningar med läns- och kommungränser – många samhällsfrågor, som vattenförvaltning eller kriminalitet, följer inte administrativa gränser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec63",
      "sentiment": 1.0,
      "quote": "Den territoriella politiken behöver, precis om utredningen pekar på, bidra till samhällets robusthet och beredskap varför det är viktigt att beakta att landsbygderna är avgörande för totalförsvaret, särskilt när det gäller att upprätthålla grundläggande samhällsfunktioner.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec130",
      "sentiment": 1.0,
      "quote": "För att skapa en lärande process och följa resursfördelning krävs uppföljning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec114",
      "sentiment": 0.5,
      "quote": "Likt SKR vill håller kommunen med att alltför detaljerade målformuleringar riskerar att begränsa aktörers möjlighet att prioritera och utforma insatser utifrån lokala förutsättningar och behov.",
      "quote_type": "grund"
    }
  ]
