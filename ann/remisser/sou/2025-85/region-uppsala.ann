  "segments": [
    {
      "forarbete_id": "a1.1",
      "sentiment": 1.0,
      "quote": "Även om det redan idag ingår som en given del av uppdraget, ser Region Uppsala positivt på att författningsförslaget tydliggör behovet av samråd med det civila samhällets organisationer och näringslivet, samt poängterar behovet av samråd med nationella minoriteter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.2",
      "sentiment": 0.2,
      "quote": "I betänkandet saknas dock djupare resonemang eller definition av begreppet hållbar utveckling.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.5",
      "sentiment": 0.2,
      "quote": "Region Uppsala anser att det finns behov för staten att utveckla sina verktyg för att bevaka utvecklingen i olika delar av landet och utifrån det tillskjuta resurser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.6",
      "sentiment": 0.2,
      "quote": "Region Uppsala vill betona behovet av en bättre nationell samordning mellan EU:s strukturfonder och regional politik, samt tydligare kopplingar till olika sektorsområden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec126",
      "sentiment": 0.2,
      "quote": "Region Uppsala anser dock att det finns ytterligare utrymme för regeringen att tydliggöra ansvarsfördelningen mellan parterna avseende regional utveckling.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec133",
      "sentiment": 0.5,
      "quote": "Region Uppsala menar att lärande och utveckling – och inte statlig kontroll - måste vara utgångspunkten för ett uppföljningssystem av den framtida utvecklingspolitiken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5",
      "sentiment": 0.5,
      "quote": "Region Uppsala ser goda möjligheter med en sammanslagning av politikområdena om det kan bidra till ett effektivare genomförande av det samlade politikområdets mål, ökad tydlighet, bättre samordning och förenkling.",
      "quote_type": "grund"
