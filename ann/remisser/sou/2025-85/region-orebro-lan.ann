  "segments": [
    {
      "forarbete_id": "a1.1",
      "sentiment": 1.0,
      "quote": "Region Örebro län har inget att invända mot föreslaget förtydligande som innebär att i stället för samråd med företrädare för berörda organisationer ska samråd ske med företrädare för det civila samhällets organisationer.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a1.1",
      "sentiment": 1.0,
      "quote": "Region Örebro län har inte heller någon synpunkt på föreslagen hänvisning till lagen (2009:724) om nationella minoriteter och samråd i frågor som berör dem.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a3.3",
      "sentiment": 0.2,
      "quote": "Utifrån att utredningens tidsperspektiv är satt till 2050, ser Region Örebro län värde att reflektera över människors värderingar och engagemang idag och framöver utifrån att dessa är drivkraften för regional utveckling.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec76",
      "sentiment": 1.0,
      "quote": "Region Örebro län anser att regionerna har det regionala demokratiska mandatet och bäst kunskap om territoriet, förutsättningarna och utvecklingspotentialen och därmed fortsatt ska ha det regionala utvecklingsansvaret.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.1",
      "sentiment": 0.5,
      "quote": "Region Örebro län anser att ansvaret vad gäller rumslig planering kan förtydligas genom en komplettering i lagen (2010:630) om regionalt utvecklingsansvar genom förslagsvis följande lydelse: ” En region ska, med de platsspecifika förutsättningar som utgångspunkt och med beaktande av funktionella kopplingar både inom och utanför länets gränser, redovisa ett rumsligt perspektiv på den regionala utvecklingsstrategin.”",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.2",
      "sentiment": 1.0,
      "quote": "Det är dock viktigt att målen kan uppnås på olika sätt, med hänsyn till de skiftande förutsättningarna runt om i landet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec126",
      "sentiment": -0.2,
      "quote": "Idag förekommer överlappande arbete inom exempelvis områdena energi och klimat samt folkhälsa med otydliga roller och ansvar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.4",
      "sentiment": 0.5,
      "quote": "Genom åren har regionerna levererat in material till olika uppföljningar/utvärderingar men många gånger har orsakssambanden varit svåra att påvisa.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec123",
      "sentiment": 1.0,
      "quote": "processen med att ta fram den regionala utvecklingsstrategin (RUS) och att genomföra den görs i en bred och demokratiskt väl förankrad process med många aktörer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec124",
      "sentiment": 1.0,
      "quote": "Det är också viktigt att möjliggöra samverkan mellan myndigheterna så att de gemensamt kan bidra och göra insatser utifrån ett helhetsperspektiv.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec141",
      "sentiment": -0.2,
      "quote": "Det måste finnas flexibilitet och utrymme för regionernas självstyre och utvecklingsarbete utifrån specifika territoriella förutsättningar och behov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec154",
      "sentiment": 0.5,
      "quote": "Region Örebro län upplever dock att de mindre kommunerna redan idag kan ha utmaningar med kapaciteten utifrån personella resurser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": -0.2,
      "quote": "Region Örebro län anser att samverkan regionalt kan variera utifrån varje regions specifika förutsättningar, dess historik och den regionalt beslutade strategin och därför inte bör regleras och styras alltför detaljerat från nationell nivå.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5",
      "sentiment": 1.0,
      "quote": "Region Örebro län ser positivt på fördelar som lyfts med en sammanslagning exempelvis samordning av insatser, ökad tydlighet och förenkling för aktörer i utvecklingsarbetet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec191",
      "sentiment": 1.0,
      "quote": "Region Örebro län delar utredarens bedömning om att det är avgörande för Sveriges sammanhållna utveckling att sektorspolitiken tar geografiska hänsyn och bidrar till målen för regional utvecklingspolitik och landsbygdspolitik.",
      "quote_type": "standpunkt"
    }
  ]
