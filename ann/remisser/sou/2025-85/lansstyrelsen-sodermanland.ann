  "overall": {
    "sentiment": 0.5,
    "quote": "Länsstyrelsen i Södermanlands län tillstyrker föreslagen författningsändring, men förordar att utredningen gör ett tillägg som även förtydligar kraven på samråd utifrån de tvärsektoriella perspektivfrågorna jämställdhet, barnets rättigheter och tillgänglighet.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a1.1",
      "sentiment": 0.5,
      "quote": "Myndighetens bedömning är att utvecklingen, utifrån ett socialt hållbarhetsperspektiv, skulle gynnas om det blir tydligt att regionen måste samråda med civilsamhällets organisationer och andra relevanta aktörer i centrala utvecklingsfrågor för länet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.7",
      "sentiment": 1.0,
      "quote": "Föreslagna insatser behöver vara flexibla och anpassningsbara till framtida omvärldsförändringar så att de fungerar och är relevanta under lång tid.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec63",
      "sentiment": 0.5,
      "quote": "Vidare ser Länsstyrelsen att det är viktigt att lokal och regional utveckling går hand i hand med byggandet av ett robust samhälle med beredskap för kris och förändring.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec122",
      "sentiment": -0.2,
      "quote": "Staten behöver enligt Länsstyrelsens bedömning ta en tydligare och aktivare roll i politikens genomförande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec126",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen välkomnar ett förtydligande av myndighetens ansvar inom den framtida regionala utvecklingspolitiken och landsbygdspolitiken.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec130",
      "sentiment": 0.2,
      "quote": "Det finns en potential att än mer utnyttja länsstyrelsernas uppgift att redovisa läget i länet till att bistå regeringen med regionala lägesbilder, med analys av nuläge och bedömning av behovet av ytterligare åtgärder.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec137",
      "sentiment": 0.2,
      "quote": "Att länsstyrelsen kan teckna denna helhetsbild är avgörande för att åtgärder inte blir binära – antingen kompensation eller utveckling som gynnar hela landet – utan kombinationer som svarar mot länets faktiska verklighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": 0.5,
      "quote": "Det är dock viktigt att påpeka att det oavsett tydlighet i ansvarsfördelning alltid kommer att finnas mellanrum mellan utpekade ansvarsområden, och att det är något som behöver hanteras genom samverkan mellan de regionala aktörerna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5",
