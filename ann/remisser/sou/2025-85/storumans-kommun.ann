  "segments": [
    {
      "forarbete_id": "a7",
      "sentiment": 0.0,
      "quote": "Vi anser, i likhet med betänkandet, att det är för tidigt att ta ställning till frågan om regionalpolitiken och landsbygdspolitiken ska slås samman",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec191",
      "sentiment": 1.0,
      "quote": "väldigt få statliga myndigheter och bolag genom åren har tagit sina regional- och/eller landsbygdspolitiska uppdrag på allvar – eller åtminstone har man prioriterat dessa perspektiv mycket lägre än andra hänsynstaganden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.2",
      "sentiment": 1.0,
      "quote": "Vi instämmer i slutsatsen om att målen för politikområdena behöver bli tydligare, och att ansvarsfördelningen och styrningen på samma sätt behöver förtydligas och stärkas.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a5.4",
      "sentiment": 0.5,
      "quote": "Uppföljningen behöver åtföljas av ett lärande och ett därigenom mer evidensbaserat arbetssätt i förbättringen av politiken och åtgärderna – naturligtvis med bibehållen rådighet hos respektive myndighet/förvaltningsnivå, men ändå med en möjlighet till ansvarsutkrävande utifrån de satta målen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec76",
      "sentiment": -0.2,
      "quote": "medan regionerna har det övergripande utvecklingsansvaret för det aktuella territoriet, har de samtidigt generellt inte huvudmannaskap för berörda viktiga branscher och samhällsfunktioner som ska implementera politiken i verkligheten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec124",
      "sentiment": -0.5,
      "quote": "Samtidigt blir det ett glapp i styrsystemet när den regionala nivån är ”beställare” men som sagt själva inte styr över de verksamheter som till allra största del ansvarar för genomförandet av politiken",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec156",
      "sentiment": 0.5,
      "quote": "Det skulle leda till en mycket starkare lokal förankring och känsla av sakägarskap och agens hos många mindre kommuner och andra organisationer som idag kan känna att man glöms bort, hamnar i skymundan eller prioriteras lågt.",
      "quote_type": "grund"
    }
  ]
