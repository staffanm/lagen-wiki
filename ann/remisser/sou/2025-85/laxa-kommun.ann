  "overall": {
    "sentiment": 0.6,
    "quote": "Laxå kommun håller med om stora delar av delbetänkandets innehåll, att det är viktigt att geografiska perspektiv i politiken stärks och att ansvarsfördelning, roller och samverkan tydliggörs mellan stat, region och kommun, samt att civilsamhälle och näringsliv är viktiga delar i utvecklingspolitiken.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a3.7",
      "sentiment": 1.0,
      "quote": "Det långsiktiga perspektivet skapar möjlighet till bättre överskådlighet (planeringsförutsättningar), tydlig organisering och ansvarsfördelning över tid.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec76",
      "sentiment": 1.0,
      "quote": "Utredningen trycker på att regionen ska ha kvar sitt regionala utvecklingsansvar, detta tycker Laxå kommun är väldigt bra för att förstärka tydligheten i roller vilket kan underlätta samverkan framgent.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec69",
      "sentiment": 1.0,
      "quote": "Detta är viktigt då utvecklingspolitiken inte kan bygga på en specifik organisering av geografiska områden utan behöver vara hållbar över tid, anser Laxå kommun.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.2",
      "sentiment": 1.0,
      "quote": "Målen för den territoriella politiken behöver bli tydligare, vilket Laxå kommun håller med om, för att skapa utveckling och förändring i samhället.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec124",
      "sentiment": 0.8,
      "quote": "hur viktigt det är att inte enskilda myndigheters agenda får styra utan att man behöver se till helheten på regional och nationell nivå för att skapa förutsättningar för att det fungerar på lokal nivå",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1",
      "sentiment": -0.2,
      "quote": "kommuner tvingas ha många olika myndighetskontakter idag, vilka sällan är samordnade sig emellan, och i vissa fall dessutom har motstridiga uppdrag eller reglementen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec126",
      "sentiment": -0.5,
      "quote": "Utredningen påpekar att länsstyrelserna har förutsättningar att utifrån ett statligt helhetsperspektiv arbeta sektorsövergripande samt att inom sina ansvarsområden samordna olika samhällsintressen och statliga myndigheters insatser, vilket Laxå kommun anser inte riktigt sker idag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec152",
      "sentiment": -0.2,
      "quote": "Laxå kommun anser inte att det ska stå att kommunen bör kunna involveras mer, utan det bör snarare lyftas fram som ett måste för att utvecklingspolitiken ska nå sina mål.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec163",
      "sentiment": 0.2,
      "quote": "Laxå kommun anser att det är viktigt att det inte enbart blir fokus på dialog utan även beslutsfattande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7",
      "sentiment": 0.0,
      "quote": "Däremot är det kanske viktigare att den politiska inriktningen, mål, styrning, ledning, uppföljning och samverkan fungerar väl mellan stat, region, kommun, civilsamhälle och näringsliv och att det arbetas aktivt med frågorna, än huruvida det är ett eller två politikerområden.",
