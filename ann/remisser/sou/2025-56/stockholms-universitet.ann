  "overall": {
    "sentiment": 0.2,
    "quote": "Vad gäller övriga förslag till bestämmelser i lagen om domstolar och domare och de föreslagna följdändringarna har Fakultetsnämnden inga synpunkter utöver dem som följer av ovanstående synpunkter.",
    "quote_type": "standpunkt"
  },
  "segments": [
    {
      "forarbete_id": "sec277",
      "sentiment": -0.5,
      "quote": "regeringens bundenhet vid en underordnad myndighets förslag i utnämningsfrågor framstår som principiellt tveksamt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec275",
      "sentiment": 0.2,
      "quote": "anser att begreppet ”anställd på central nivå i ett politiskt parti” kan behöva preciseras, och eventuellt utsträckas till att även gälla uppdrag som förtroendevald på central nivå i ett politiskt parti.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec54",
      "sentiment": 0.0,
      "quote": "torde det vara mer logiskt att rätten att kvarstå i tjänst följer den.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec67",
      "sentiment": -0.2,
      "quote": "bör den föreslagna 7 kap. 2 § utgå.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec57",
      "sentiment": -0.5,
      "quote": "Även detta framstår som svårförklarligt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec59",
      "sentiment": -0.2,
      "quote": "Det saknas en bestämmelse om att bisysslor inte får vara arbetshindrande, vilket enligt Fakultetsnämndens uppfattning borde införas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec68",
      "sentiment": 1.0,
      "quote": "Fakultetsnämnden anser att denna ordning är lämplig.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec59",
      "sentiment": 1.0,
      "quote": "Dessa förslag framstår som invändningsfria.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec60",
      "sentiment": -0.2,
      "quote": "det är inte uppenbart vad denna särreglering fyller för syfte.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec61",
      "sentiment": 1.0,
      "quote": "Fakultetsnämnden har ingen invändning mot förslaget.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec62",
      "sentiment": 0.2,
      "quote": "Man kan möjligen överväga om två års allvarlig nedsättning av arbetsförmågan i förening med ovisshet om situationen om ett år är en för kort tid för att anse att en person har permanent förlorat förmågan att utöva sin domartjänst.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec63",
      "sentiment": 1.0,
      "quote": "Fakultetsnämnden har ingen invändning mot detta.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec64",
      "sentiment": 1.0,
      "quote": "Fakultetsnämnden har ingen invändning mot förslaget.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec81",
      "sentiment": 1.0,
      "quote": "Fakultetsnämnden har ingen invändning mot dessa förslag.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec71",
      "sentiment": -0.2,
      "quote": "Det är oklart varför man i sådana fall inte föreslår en ordning med möten per capsulam (8 kap. 9 §).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec74",
      "sentiment": 1.0,
      "quote": "I ljuset av intresset av domstolsprövning framstår detta som en rimlig ordning (8 kap. 15-20 §§).",
      "quote_type": "grund"
    }
  ]
