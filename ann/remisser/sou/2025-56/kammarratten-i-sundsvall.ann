  "overall": {
    "sentiment": 0.5,
    "quote": "Kammarrätten instämmer i stora drag i utredningens förslag och bedömningar.",
    "quote_type": "standpunkt"
  },
  "segments": [
    {
      "forarbete_id": "a4.5.1",
      "sentiment": 1.0,
      "quote": "Kommittén har alltså redan gjort flera grundläggande vägval som enligt kammarrättens mening binder utredningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.2",
      "sentiment": 1.0,
      "quote": "Förslaget kommer enligt kammarrättens mening stärka domarnas oberoende.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.3.4",
      "sentiment": -0.2,
      "quote": "Det ter sig med det konstitutionella synsätt som utredningen har anlagt inte tydligt för kammarrätten att Domstolsstyrelsen lämpar sig bättre som värdmyndighet än vad en domstol gör.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2.4",
      "sentiment": -0.5,
      "quote": "Den korrekta karaktäriseringen av nämnden är enligt kammarrätten att den är en förvaltningsmyndighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2.5",
      "sentiment": -0.5,
      "quote": "Kammarrätten anser att en sådan hänvisning är obehövlig och avviker från gängse ordning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2.6",
      "sentiment": -0.5,
      "quote": "Enligt kammarrättens mening kan en sådan möjlighet snarare antas rubba förtroendet för att rättskipningen utförs med sådan omsorg som erfordras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.2",
      "sentiment": 1.0,
      "quote": "Med hänsyn till den parlamentariska förankring kommitténs förslag har bör någon annan ordning inte föreslås nu.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.4",
      "sentiment": -0.2,
      "quote": "Det är för kammarrätten oklart om utredningen har beaktat de konsekvenser i fråga om partsställning och klagorätt som följer av att det är beslutande förvaltningsmyndighet som intar partsställning enligt 11 § lagen (1996:242) om domstolsärenden, ärendelagen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.5",
      "sentiment": -0.5,
      "quote": "Enligt kammarrätten kan det då framstå som att en ordinarie domare är mer ekonomiskt skyddsvärd i sin process mot Domaransvarsnämnden än vad en enskild i allmänhet är i en process mot en förvaltningsmyndighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.2",
      "sentiment": -0.5,
      "quote": "Den ventil för att motverka missbruk av systemet som föreslås genom att lön m.m. i vissa fall kan innehållas, kan också användas för att utöva påtryckningar mot den enskilde domaren.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.7",
      "sentiment": 0.0,
      "quote": "Kammarrätten saknar emellertid i det sammanhanget en närmare analys av om det särskilda syftet med det arbetsrättsliga skydd som den enskilde domaren går miste om i olika avseenden, tillgodoses av det kvarstående eller tillkommande skyddet i den nya ordningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": 0.0,
      "quote": "Kammarrätten saknar i det sammanhanget en analys av konsekvenserna av att det finns en allmän strävan att stärka skyddet för oberoendet för ordinarie domare och möjligheterna att på ett oförändrat sätt låta icke-ordinarie domare utföra rättskipningsuppgifter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5",
      "sentiment": -0.5,
      "quote": "Av motsvarande skäl som ovan anförts i fråga om beslut om avsättning (7.4.2) är kammarrätten kritiskt till förslaget.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a17.13",
      "sentiment": -0.2,
      "quote": "Enligt kammarrätten bör frågor som rör ordinarie domare och som är av kvalificerad betydelse i stället inordnas i den nya prövningsordningen, medan andra frågor om anställningen bör prövas i befintlig arbetsrättslig ordning.",
      "quote_type": "grund"
    }
  ]
}