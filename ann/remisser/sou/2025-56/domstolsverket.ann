    {
      "forarbete_id": "sec292",
      "sentiment": -0.5,
      "quote": "Arbetsgivaransvaret skulle då inte inskränkas lika mycket och handläggningen skulle bli mer tidseffektiv, vilket är särskilt viktigt i den här typen av ärenden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec323",
      "sentiment": 1.0,
      "quote": "Domstolsverket ansluter sig till de skäl som anförs i betänkandet till varför allmän domstol är mer lämpad som överinstans till Domaransvarsnämnden än Arbetsdomstolen, även för det fall prövningen där skulle ske i särskild sammansättning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec17",
      "sentiment": -0.2,
      "quote": "det är viktigt att domaren har möjlighet att komma till tals.",
