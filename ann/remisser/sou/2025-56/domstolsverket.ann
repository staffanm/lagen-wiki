    },
    {
      "forarbete_id": "sec249",
      "sentiment": -0.5,
      "quote": "Detta framstår som en olycklig konsekvens av att det arbetsrättsliga synsättet på domarens anställning tonas ner och det är svårt att se hur det gynnar domarnas och domstolarnas oberoende.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3",
      "sentiment": 1.0,
      "quote": "Domstolsverket har inga invändningar mot att frågan om entledigande på grund av sjukdom flyttas till Domaransvarsnämnden.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec16",
      "sentiment": 1.0,
      "quote": "Domstolsverket delar utredningens bedömning att bestämmelsen i lagen (1994:261) om fullmaktsanställning om förbudet mot entledigande när det är möjligt med förflyttning av en ordinarie domare i princip inte har gått att tillämpa i praktiken och tillstyrker därför detta förslag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.6",
      "sentiment": 1.0,
      "quote": "Domstolsverket tillstyrker utredningens förslag i denna del.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec13",
      "sentiment": 1.0,
      "quote": "Domstolsverket tillstyrker även förslaget att Domaransvarsnämnden ska fatta beslut om innehållande av lön vid avstängning efter begäran från domstolsadministrationen.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec14",
      "sentiment": -1.0,
      "quote": "Möjligheten att meddela disciplinpåföljder bör därför finnas kvar och frågan ska kunna prövas av Domaransvarsnämnden efter anmälan från aktuell myndighetschef.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec22",
      "sentiment": -0.5,
      "quote": "Mot bakgrund av Domstolsverkets uppfattning att det arbetsrättsliga synsättet inte bör tonas ner lika mycket som i förslagen i betänkandet finns det enligt Domstolsverkets mening goda skäl för att behålla den nuvarande ordningen för prövning av bisysslor.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec22",
      "sentiment": 0.5,
      "quote": "Domstolsverket tillstyrker dock att domstolsadministrationen får ett mer aktivt ansvar i fråga om bisysslor och att den ska hantera domstolschefers bisysslor.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec22",
      "sentiment": -0.2,
      "quote": "Domstolsverket anser dock att det skulle kunna skada allmänhetens förtroende för domare och domstolar om domarna själva ska ansvara för att inte åta sig en bisyssla som är förtroendeskadlig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a17.16",
      "sentiment": 0.5,
      "quote": "Till skillnad från utredningen anser inte Domstolsverket att det skulle bli märkligt med olika instanser för åtalsanmälan av ordinarie och icke-ordinarie domare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec27",
      "sentiment": 0.5,
      "quote": "Domstolsverket tillstyrker alltjämt förslaget att inrätta en lag om domstolar och domare, men anser att lagen även borde omfatta hyres- och arrendenämnderna, Rättshjälpsmyndigheten och Rättshjälpsnämnden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec28",
      "sentiment": 1.0,
      "quote": "Domstolsverket anser att det är en god idé att lagen om fullmaktsanställning inte ska omfatta ordinarie domare samt att avstängning av ordinarie domare regleras i den nya lagen.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec29",
      "sentiment": 1.0,
      "quote": "Domstolsverket anser att det är en god idé att lagen om fullmaktsanställning inte ska omfatta ordinarie domare samt att avstängning av ordinarie domare regleras i den nya lagen.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec25",
      "sentiment": 1.0,
      "quote": "Vidare tillstyrker Domstolsverket att uppdraget att bedriva ett aktivt och långsiktigt arbete för att främja rekryteringen av ordinarie domare flyttas från Domarnämnden till domstolsadministrationen.",
      "quote_type": "standpunkt"
