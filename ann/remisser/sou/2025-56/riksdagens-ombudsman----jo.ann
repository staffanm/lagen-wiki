  "overall": {
    "sentiment": 0.4,
    "quote": "Som anfördes där är det välkommet med förslag som är ägnade att förstärka skyddet för domstolarnas och domarnas oberoende.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a5.2",
      "sentiment": 1.0,
      "quote": "Det framstår som lämpligt att Domstolsstyrelsen bör vara värdmyndighet med ett begränsat uppdrag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": 1.0,
      "quote": "De uppgifter som föreslås för JO framstår som naturliga utifrån JO:s uppdrag som exklusivt rättsligt tillsynsorgan för domstolarna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.6.1",
      "sentiment": -0.5,
      "quote": "Jag anser dock att skälen som utredningen anför i denna del inte är helt övertygande",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.2",
      "sentiment": 1.0,
      "quote": "Jag instämmer i att detta alternativ framstår som det lämpligaste med hänsyn till vikten av att skydda prövningen från politisk påverkan",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3",
      "sentiment": 1.0,
      "quote": "Jag instämmer i att det finns ett egenvärde i ett likartat prövningsmönster för justitieråden",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.5",
      "sentiment": 0.2,
      "quote": "Det vore önskvärt med ett förtydligande i denna del inom ramen för den fortsatta beredningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5.3",
      "sentiment": -0.5,
      "quote": "Jag anser dock att utredningens resonemang till stöd för förslaget framstår som något kortfattat och att det saknas en mer djuplodande analys av förslagets konsekvenser och eventuella alternativ till att ta bort disciplinpåföljderna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec334",
      "sentiment": -0.5,
      "quote": "Frågan om rättegångskostnader ska kunna utgå är av principiell karaktär och bör inte bero på antaganden om JO kommer att ställa ombud för sig eller inte.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.8",
      "sentiment": -0.2,
      "quote": "Enligt min bedömning talar formuleringen av 13 kap. 6 § regeringsformen snarare för att den utökade behörigheten bör regleras direkt i JO-instruktionen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": 1.0,
      "quote": "Jag har ingen erinran mot detta.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a10.2.3",
      "sentiment": 1.0,
      "quote": "Jag har således inga invändningar mot förslaget i sig.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a13",
      "sentiment": 1.0,
      "quote": "Jag har ingen erinran mot förslagen.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a17.16",
      "sentiment": 0.2,
      "quote": "Enligt min mening anför utredningen goda skäl för att åtalsanmälan inte ska omfattas av den nya prövningsordningen och att det kan finnas skäl att låta den nuvarande ordningen bestå i den delen.",
      "quote_type": "grund"
    }
  ]
}