  "segments": [
    {
      "forarbete_id": "sec10",
      "sentiment": 1.0,
      "quote": "ser särskilt positivt på att initiativrätten till Domaransvarsnämnden i frågor om avsättning, avstängning och läkarundersökning begränsas till Riksdagens ombudsmän",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec324",
      "sentiment": 0.0,
      "quote": "Tingsrätten har inte, givet att prövningstillstånd till Högsta domstolen vid överklagande av beslut om avsättning och avstängning inte ska krävas, någon synpunkt på att Svea hovrätt som första instans ska pröva överklaganden av Domaransvarsnämndens beslut.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a14.5",
      "sentiment": 0.0,
      "quote": "Tingsrätten har inga synpunkter på den föreslagna ändringen av Domarnämndens organisation.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a15.3",
      "sentiment": 1.0,
      "quote": "framstår renodlingen av Domarnämndens uppgifter – där till exempel uppdraget att främja rekrytering av ordinarie domare i stället ska ges till Domstolsstyrelsen – som ändamålsenligt och resurseffektivt",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.2",
      "sentiment": 1.0,
      "quote": "Den föreslagna ordningen framstår som en naturlig konsekvens av grundlagskommitténs ställningstaganden i fråga om en ny prövningsordning för vissa frågor som rör ordinarie domares rättsställning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec26",
      "sentiment": 1.0,
      "quote": "för att grundlagskommitténs tankegångar ska få fullt genomslag",
      "quote_type": "grund"
    }
  ]
