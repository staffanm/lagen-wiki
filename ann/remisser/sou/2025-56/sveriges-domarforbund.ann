  "segments": [
    {
      "forarbete_id": "sec9",
      "sentiment": 1.0,
      "quote": "Förbundet är i linje därmed positivt inställt till att det införs en ny prövningsordning för sådana grundläggande frågor om ordinarie domares rättsställning som har en särskild konstitutionell förankring och att ett nytt fristående prövningsorgan, Domaransvarsnämnden, inrättas.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a5.3.7",
      "sentiment": -0.2,
      "quote": "Utifrån erfarenheter från andra länder kan det dock finnas skäl att överväga någon form av lagreglering för att på ett robust sätt säkerställa nämndens självständiga och oberoende ställning i nu berört hänseende.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec26",
      "sentiment": 1.0,
      "quote": "Det är av särskild vikt eftersom Domstolsstyrelsen i vissa fall ska göra anmälan och föra talan i Domaransvarsnämnden",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.5",
      "sentiment": 0.5,
      "quote": "Förbundet delar utredningens uppfattning att frågor om bisysslor är av sådan principiell betydelse för oberoendet och av sådan konstitutionell prägel att de bör behandlas i detta sammanhang",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec47",
      "sentiment": -0.2,
      "quote": "För att säkerställa oberoendet, legitimiteten och att olika domarperspektiv tillvaratas inom ledningen är det av yttersta vikt att även andra ordinarie domare än domare som är domstolschefer är representerade",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec11",
      "sentiment": 1.0,
      "quote": "Förbundet anser att det är angeläget att ta ett mer samlat grepp om olika frågor som rör ickeordinarie domares rättsställning och att sådana frågor bör utredas särskild ordning.",
      "quote_type": "grund"
    }
