    }
  },
  "overall": {
    "sentiment": 0.5,
    "quote": "Förvaltningsrätten instämmer i allt väsentligt med förslaget om den förändrade prövningsordningen för ansvarsutkrävande för ordinarie domare, som tonar ner de arbetsrättsliga inslagen till förmån för de offentligrättsliga och konstitutionella inslagen.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a5.3.4",
      "sentiment": -0.2,
      "quote": "Med tanke på detta framstår det, även med beaktande av förslaget på förbud mot personunion mellan domstolsmyndigheterna (avsnitt 17.7), som mindre lämpligt att Domstolsstyrelsen är värdmyndighet till Domaransvarsnämnden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.3.4",
      "sentiment": 1.0,
      "quote": "En särskild anslagspost i anslaget till Sveriges Domstolar framstår som otillräckligt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.5.2",
      "sentiment": 1.0,
      "quote": "Förvaltningsrätten tillstyrker även att Domarnämnden, liksom tidigare, ska ha ett eget kansli och egna lokaler (avsnitt 14.5.2).",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a15.3",
      "sentiment": 1.0,
      "quote": "Förvaltningsrätten tillstyrker även förslaget om renodling av Domarnämndens uppgifter (avsnitt 15.3).",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.2.1",
      "sentiment": 1.0,
      "quote": "Det stärker skyddet för domstolsmyndigheternas, domstolarnas och domarnas oberoende och självständighet att de inte står under tillsyn av någon myndighet underställd regeringen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5",
      "sentiment": 0.2,
      "quote": "Om Domaransvarsnämnden i stället underställs riksdagen skulle den, på samma sätt som exempelvis Sveriges riksbank och Riksrevisionen, tillförsäkras ett starkare skydd mot politiskt inflytande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6",
      "sentiment": 0.8,
      "quote": "Förslagen bedöms stärka skyddet för domstolarnas och domarnas oberoende och självständighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.2",
      "sentiment": -0.2,
      "quote": "Med hänsyn till den föreslagna tonvikten på de offentligrättsliga och konstitutionella inslagen och med beaktande av var myndighetsbeslut överprövas, framstår det emellertid som mest ändamålsenligt att denna prövning sker i allmän förvaltningsdomstol.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.5",
      "sentiment": 0.0,
      "quote": "Förvaltningsrättens uppfattning är att den enskilde domaren inte ska behöva bära sina eventuella rättegångskostnader och inte heller motpartens, i den mån sådana ens kan uppkomma.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2",
      "sentiment": -0.2,
      "quote": "Det kan ifrågasättas om en domstolschef, som är beredd att mot en annan domare utnyttja sådan kännedom på det sättet, skulle känna sig manad att, utifrån egen pliktkänsla, iaktta den föreslagna anmälningsplikten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.2",
      "sentiment": 0.2,
      "quote": "Utöver vägran att genomgå läkarundersökning vore det önskvärt med ytterligare klargörande exempel på vad som anses vara situationer som talar för att överklaganderätten missbrukas; det torde dock vara svårt att slå fast att något objektivt talar för ett syfte.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.3",
      "sentiment": -0.2,
      "quote": "Utredningens hänvisning i fråga om klagorätt till 42 § förvaltningslagen synes inte motsvara avsikten att endast de som haft partsställning hos Domaransvarsnämnden ska få överklaga nämndens beslut, eftersom den bestämmelsen medger en större krets klagorätt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.8",
      "sentiment": -0.2,
      "quote": "För ett system som har konstitutionsnära karaktär och som skapas för att vara robust även när det utsätts för stress, kan det ifrågasättas om det är lämpligt att avskaffa handlingsnormer, samtidigt som ett iakttagande av normerna ändå förutsätts.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a17.16",
      "sentiment": 1.0,
      "quote": "Med hänsyn inte minst till systematiska skäl bör huvudförslaget därför genomföras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a18.3",
      "sentiment": -0.2,
      "quote": "Det framstår därför som främmande att placera den i ikraftträdande- och övergångsbestämmelserna (avsnitt 18.3).",
      "quote_type": "grund"
    }
  ]
}