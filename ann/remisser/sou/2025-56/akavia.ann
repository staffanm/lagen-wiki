  "overall": {
    "sentiment": -0.4,
    "quote": "Sammanfattningsvis är vår bedömning att utredningens förslag innebär en långtgående nedtoning av arbetsrättsliga aspekter som behöver analyseras ytterligare.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a5.2",
      "sentiment": -0.5,
      "quote": "Akavia och Saco-S Domstol anser att frågan om inrättande av en ny nämnd för ordinarie domare är komplex och konsekvenserna svårbedömda, varför frågan bör utredas ytterligare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.3.3",
      "sentiment": 1.0,
      "quote": "Vi delar utredningens bedömning att en majoritet av ansvarsnämndens ledamöter ska bestå av ordinarie domare.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a5.3.3",
      "sentiment": -0.2,
      "quote": "Vi ställer oss tveksamma till bedömningen att ordföranden och vice ordföranden ska ha erfarenhet av att vara domstolschefer, särskilt om målet är att öka det vertikala oberoendet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.3.5",
      "sentiment": 1.0,
      "quote": "Akavia och Saco-S Domstol tillstyrker förslaget att Domaransvarsmänden inte står under Justitiekanslerns tillsyn som ett led i att öka det vertikala oberoendet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6",
      "sentiment": -0.5,
      "quote": "Det är otillfredsställande att betänkandet inte mer ingående prövar hur den befintliga prövningsordningen kan utvecklas för att stärka domstolars och domares oberoende samt ge det konstitutionella skydd som Grundlagskommittén förespråkat och som bättre stämmer överens med europarätten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2.1",
      "sentiment": 1.0,
      "quote": "Vi tillstyrker utredningens förslag att Domaransvarsnämnden som huvudregel inte kan ta upp frågor på eget initiativ.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.2.1",
      "sentiment": -0.2,
      "quote": "Däremot ställer vi oss frågande till lämpligheten i att Justitieombudsmannen (JO), som föreslås ha behörighet att initiera ett ärende i nämnden, vilket är i linje med dagens ordning, samtidigt ska utöva tillsyn över densamma.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2.2",
      "sentiment": 0.5,
      "quote": "Vi vill dock peka på att det emellanåt kan det vara problematiskt att beslutet att göra en anmälan till JO fattas av domstolschefen ensam, då en sådan ordning riskerar att skapa utrymme för intern påverkan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2.4",
      "sentiment": -0.5,
      "quote": "Det är viktigt att ordinarie domare, utifrån utredningens samlade förslag, sammantaget inte hamnar i ett sämre läge sett till arbetsrättsliga aspekter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": -0.5,
      "quote": "Akavia och Saco-S Domstol anser att frågan är komplex, att konsekvenserna är svårbedömda samt att risken för spridningseffekter bör tas på större allvar, detta motiverar att frågan utreds vidare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2",
      "sentiment": -0.5,
      "quote": "Akavia och Saco-S Domstol anser dock att de negativa följderna av förslaget är mer långtgående än den teoretiska risk som utredningen redogör för.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2",
      "sentiment": -1.0,
      "quote": "Som utredningen själv framhåller finns annars en risk att äldre uppgifter om misskötsamhet kan användas som påtryckningsmedel mot ordinarie domare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.2",
      "sentiment": 1.0,
      "quote": "Givet de särskilda förutsättningar som gäller för ordinarie domare, varav ett tungt vägande skäl är att bestämmelsen inte bör kunna användas som ett påtryckningsmedel, framstår det dock som rimligt att den inte längre ska vara tillämplig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5.3",
      "sentiment": 1.0,
      "quote": "Vår bedömning är att disciplinpåföljd är ett ålderdomligt verktyg som inte längre är ändamålsenligt varken för ordinarie domare eller andra statligt anställda.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.7",
      "sentiment": -1.0,
      "quote": "Den nuvarande regleringen i skadeståndslagen avseende fel eller försummelse vid myndighetsutövning, innebär dock en mycket hög tröskel och är svår att tillämpa i praktiken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.6.1",
      "sentiment": -1.0,
      "quote": "Att avskaffa förbudet mot entledigande när omplacering är möjlig står i motsats till grundtanken i utredningen dvs. att öka ordinarie domares vertikala oberoende.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3",
      "sentiment": 0.5,
      "quote": "Det är viktigt att domaren har en reell möjlighet att angripa beslutet utan förbehåll.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.4",
      "sentiment": -1.0,
      "quote": "Detta kan leda till att pågående bisysslor kan komma att avbrytas abrupt med negativa konsekvenser för domaren och andra berörda, trots att situationen enkelt hade kunnat hanterats redan från början.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.6.3",
      "sentiment": 1.0,
      "quote": "Vi tillstyrker utredningens förslag att regeringen inte längre föreslås hantera tvistiga ärenden som ett led i ett ökat oberoende.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.5.2",
      "sentiment": 1.0,
      "quote": "Vi delar utredningens uppfattning att ökad självständighet i horisontellt led mellan domstolsväsendets organ bidrar till ett mer robust skydd för domstolar och domare även mot påverkan i vertikalt led.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a15.3",
      "sentiment": 1.0,
      "quote": "Vi tillstyrker utredningens förslag att uppdraget att bedriva ett aktivt och långsiktigt arbete för att främja rekryteringen av ordinarie domare överförs från Domarnämnden till Domstolsstyrelsen.",
      "quote_type": "standpunkt"
