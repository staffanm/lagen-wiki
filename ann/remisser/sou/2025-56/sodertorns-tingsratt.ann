  "segments": [
    {
      "forarbete_id": "a6",
      "sentiment": 0.5,
      "quote": "Tingsrätten delar uppfattningen att vissa grundläggande frågor om ordinarie domares rättsställning inte bör prövas av Statens ansvarsnämnd eftersom nämnden är ett arbetsgivarorgan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5",
      "sentiment": -1.0,
      "quote": "det starka anställningsskyddet ställer, enligt tingsrätten, samtidigt krav på att det finns ett system för ansvarsutkrävande som är effektivt och ändamålsenligt.",
