  "segments": [
    {
      "forarbete_id": "sec9",
      "sentiment": 0.2,
      "quote": "Fakultetsstyrelsen anser att det finns anledning att i det fortsatta lagstiftningsarbetet ytterligare klarlägga vad lydnadsförhållandet enligt 12 kap. 1 § regeringsformen skulle innebära för Domarnämndens konstitutionella och förvaltningsrättsliga ställning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.3.6",
      "sentiment": -0.2,
      "quote": "denna rubrik inte återspeglar dessa myndigheters särställning",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec330",
      "sentiment": -0.5,
      "quote": "Eftersom Domaransvarsnämnden föreslås vara en förvaltningsmyndighet och nämnden fattar beslut som första instans innebär det enligt ordalydelsen i 11 § ärendelagen att den kommer att inta ställning som den enskildes motpart vid en överklagandeprocess.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.5",
      "sentiment": -0.5,
      "quote": "Att mot den bakgrunden behålla en möjlighet för justitieråd att avsäga sig sina ämbeten muntligen framstår inte som konsekvent utan öppnar för risker för missbruk.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec275",
      "sentiment": -0.2,
      "quote": "För att säkerställa att en ”vanlig” ordinarie domare finns med bör det i stället stå antingen ”en ledamot vara eller ha varit ordinarie domare utan att ha eller ha haft befattning som domstolschef” eller ”en ledamot vara eller ha varit ordinarie domare utan att ha eller ha haft befattning med chefsansvar”.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec18",
      "sentiment": -0.2,
      "quote": "7 kap. 1 § tredje stycket lagen om domstolar och domare är skrivet på ett svårbegripligt sätt.",
      "quote_type": "grund"
    }
  ]
