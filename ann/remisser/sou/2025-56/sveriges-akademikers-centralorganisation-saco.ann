  "segments": [
    {
      "forarbete_id": "sec9",
      "sentiment": 0.2,
      "quote": "Saco har inga invändningar i och för sig mot att en särskild Domaransvarsnämnd inrättas, och att frågor om skiljande från tjänsten, eller avsättning som utredningen benämner det, läggs där i stället för i Statens ansvarsnämnd.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec244",
      "sentiment": -0.5,
      "quote": "Saco menar att det är tveksamt om förslaget är förenligt med den EU-rättsliga regleringen om skydd mot diskriminering, och saknar resonemang om förenligheten med ILO:s konventioner.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec247",
      "sentiment": -0.5,
      "quote": "Genom att ta bort det arbetsrättsliga inslaget, kan inte den enskilde domaren företrädas av arbetstagarorganisationen på det sätt som är möjligt nu.",
