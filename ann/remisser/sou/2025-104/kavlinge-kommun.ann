  "segments": [
    {
      "forarbete_id": "a6.3",
      "sentiment": 0.5,
      "quote": "Det är positivt att ansvarsförhållanden tydliggöra mer precist med tillståndshavare som huvudansvariga, men kommunen betonar att nationell samordning krävs.",
