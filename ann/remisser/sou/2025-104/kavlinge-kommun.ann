    },
    {
      "forarbete_id": "a7.7",
      "sentiment": 1.0,
      "quote": "Kommunen är också positiv till att den nationella avfallsorganisationen ska planera och ta fram en strategi för omhändertagandet – med betoning på att regeringen ska fastställa den strategi som tas fram.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8",
      "sentiment": -0.2,
      "quote": "För transparent hantering och insyn föreslår kommunen att det ska tydliggöras att berörd kommun utgör en remissinstans för den forsknings- och utvecklingsinriktning som kärnkraftaktörer verksamma i kommunen bedriver.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10",
      "sentiment": -0.5,
      "quote": "Kommunen ser det som mycket angeläget att det säkras att den kommun, där anläggningen är belägen, omöjligen kan ställas till ansvarig för att omhänderta avfall i det fall tillståndshavaren inte gör det.",
      "quote_type": "grund"
