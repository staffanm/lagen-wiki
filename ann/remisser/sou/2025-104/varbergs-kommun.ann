  "overall": {
    "sentiment": 0.2,
    "quote": "Varbergs kommun instämmer i förslaget att kommunen får möjlighet att yttra sig om strategin för omhändertagande av radioaktivt avfall och poängterar vikten av att kommunen ges tillräckligt med tid för den demokratiska granskningsprocessen.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "sec65",
      "sentiment": 0.5,
      "quote": "Varbergs kommun anser att det är bra att berörda kommuner ges möjlighet att yttra sig om strategin för omhändertagande av radioaktivt avfall, och poängterar vikten av att den demokratiska processen ges tillräckligt med utrymme samt att kommunen ges tillräckligt med tid för att granska handlingen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.5",
      "sentiment": 0.5,
      "quote": "Varbergs kommun instämmer i förslaget att kommunen ska kompenseras för de kostnader som uppstår för kommunen i processen vid det statliga omhändertagandet av kärntekniska restprodukter från nya kärnkraftsreaktorer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec134",
      "sentiment": -0.5,
      "quote": "Om mellanlagringen av använt kärnbränsle föreslås förändras från en central lagringsplats till flera olika, under längre tid, behöver detta noggrant utredas och konsekvensbedömas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec188",
      "sentiment": 0.8,
      "quote": "Varbergs kommun är positiv till att en nationell avfallsorganisation etableras redan från start av utbyggnaden av ny kärnkraft, och att den är en samordnad aktör för frågor om avfallets omhändertagande och att det kontinuerligt hanteras och utvecklas över tid.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec190",
      "sentiment": -0.2,
      "quote": "Varbergs kommun ställer sig frågande till varför det i underlaget öppnar upp för möjligheter att mellanlagra använt kärnbränsle på flera platser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.2",
      "sentiment": 0.0,
      "quote": "Varbergs kommun anser det behöver förtydligas om det i en ansökan om att uppföra kärnkraftsreaktorer bör eller måste innehålla information om mellanlagring på platsen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2",
      "sentiment": -0.5,
      "quote": "För- och nackdelarna kring detta framgår inte i förslaget och konsekvenser och risker finns inte heller belysta kring detta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14-3",
      "sentiment": 0.5,
      "quote": "Det är viktigt att värna det kommunala självstyret som måste förbli intakt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.4.2",
      "sentiment": 0.0,
      "quote": "Kärnteknisk verksamhet ingår inte i kommunens ordinarie uppdrag. Därför behöver kommunen kompenseras och organisationen måste få den utbildning och de kompetenshöjande åtgärder som krävs avseende bland annat kärnteknik, relaterade avfallsfrågor, säkerhet och beredskap.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec352",
      "sentiment": 0.5,
      "quote": "Varbergs kommun menar att kommunen också behöver kompenseras ekonomiskt för kostnader som detta behov medför.",
      "quote_type": "grund"
    }
  ]
