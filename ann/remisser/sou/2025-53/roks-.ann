  "segments": [
    {
      "forarbete_id": "a10",
      "sentiment": -0.5,
      "quote": "Även om en sådan analys formellt har genomförts, saknar konsekvensbeskrivningen ett tydligt och genomgripande perspektiv på våldsutsatta kvinnor och barn.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.5.3",
      "sentiment": -1.0,
      "quote": "Att genomföra lagstiftning som medför ökade hinder för tillgång till grundläggande trygghet, och som i praktiken försvårar möjligheten till skydd från våld och utsatthet, strider mot både konventionens anda och dess juridiska innebörd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": -1.0,
      "quote": "Förslaget innebär att vissa kvinnor helt skulle utestängas från tillgång till både ekonomiskt bistånd och bosättningsbaserade socialförsäkringsförmåner – med särskilt allvarliga konsekvenser för våldsutsatta kvinnor och barn.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": -1.0,
      "quote": "Förslaget, som innebär att kvalificering ska uppnås genom vistelsetid eller inkomst av arbete, riskerar att kraftigt missgynna våldsutsatta kvinnor och barn.",
      "quote_type": "grund"
    }
  ]
