    },
    {
      "forarbete_id": "a10.8.2",
      "sentiment": -0.5,
      "quote": "Att i detta sammanhang endast hänvisa till möjligheten till nödbistånd enligt socialtjänstlagen, som kommunerna inte har någon skyldighet att bevilja, är uppenbart problematiskt, eftersom detta inte medför någon rätt till bistånd för personer som över tid befinner sig i landet utan egen försörjning eller möjlighet att kvalificera sig för annan ersättning från det allmänna.",
      "quote_type": "grund"
