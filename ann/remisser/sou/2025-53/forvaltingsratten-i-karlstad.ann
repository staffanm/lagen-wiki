    {
      "forarbete_id": "a10.13",
      "sentiment": -0.5,
      "quote": "Förvaltningsrättens uppfattning är att utredningen sannolikt underskattar den ökning av myndighetsärenden och måltillströmning till de allmänna förvaltningsdomstolarna som lagändringarna i vart fall inledningsvis kan antas föranleda.",
      "quote_type": "grund"
    },
    {
