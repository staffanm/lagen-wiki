  },
  "segments": [
    {
      "forarbete_id": "a6.3",
      "sentiment": 0.5,
      "quote": "Även om vi är positiva till ambitionen att kodifiera och förtydliga det som utredningen menar redan gäller i dag, anser vi att det är tveksamt om innebörden av begreppet laglig vistelse är tillräckligt tydlig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.2",
      "sentiment": -1.0,
      "quote": "För det fall att kvalificeringsvillkor ändå ska införas anser ISF att det till stor del saknas kunskapsunderlag och fördjupade resonemang om motiven för att de utpekade förmånerna ska omfattas av kvalificeringsvillkor.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.3",
      "sentiment": 1.0,
      "quote": "ISF delar bedömningarna i avsnitt 6.4.3, 6.4.7, 6.5, 10.3, 10.5, 10.9–10, 10.15 och 10.17.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.4.4",
      "sentiment": -1.0,
      "quote": "ISF avstyrker förslaget att den som bosätter sig i Sverige ska uppfylla ett kvalificeringsvillkor.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.4.5",
      "sentiment": -1.0,
      "quote": "Mot bakgrund av att personliga omständigheter som exempelvis att personen är sjuk eller utsatt inte generellt ska beaktas framstår det enligt ISF som oklart vilka de tänkbara orimliga effekterna skulle kunna vara, liksom i vilka fall det skulle kunna uppfattas som stötande att neka förmåner.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.6",
      "sentiment": 0.0,
      "quote": "Men med de föreslagna beloppsgränserna framstår det som mindre sannolikt att vissa av de grupper som omfattas av kvalificeringsvillkoren kommer att ha en realistisk möjlighet att uppfylla inkomstvillkoret.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.7",
      "sentiment": 1.0,
      "quote": "ISF delar bedömningarna i avsnitt 6.4.3, 6.4.7, 6.5, 10.3, 10.5, 10.9–10, 10.15 och 10.17.",
