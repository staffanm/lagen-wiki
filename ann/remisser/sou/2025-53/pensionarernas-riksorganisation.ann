  "segments": [
    {
      "forarbete_id": "a6.3",
      "sentiment": 1.0,
      "quote": "Det är rimligt att endast den som har rätt att vistas i Sverige bör anses vara bosatt här när det gäller bedömning av rätt till förmåner i trygghetssystemen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.2",
      "sentiment": -0.5,
      "quote": "Vi finner svagt stöd för att dessa argument är relevanta avseende äldreförsörjningsstödet och bostadstillägget.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.3",
      "sentiment": 1.0,
      "quote": "PRO har inget att erinra mot förslaget att övriga bosättningsbaserade förmåner inte ska omfattas av ytterligare kvalificeringsregler.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.4.5",
      "sentiment": -0.5,
      "quote": "I konsekvens med vårt resonemang under avsnitt 6.4.2 avstyrker vi förslaget i de delar vi valt att yttra oss om.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.4.3",
      "sentiment": -0.5,
      "quote": "Att då införa de föreslagna kvalificeringsreglerna även för ekonomiskt bistånd som söks hos kommunen kan enligt vår bedömning få mycket allvarliga konsekvenser för pensionärer som drabbas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.4",
      "sentiment": 0.5,
      "quote": "Om kvalificeringsregler för äldreförsörjningsstöd och bostadstillägg införs är det rimligt att dessa regler enbart ska gälla de som bosätter sig i Sverige efter ikraftträdandet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.5",
      "sentiment": -0.2,
      "quote": "Det hade varit önskvärt att utredningen bedömt och redovisat antalet personer i pensionsåldern som påverkas av de föreslagna regelförändringarna.",
