    },
    {
      "forarbete_id": "a7.4.2",
      "sentiment": -1.0,
      "quote": "Vi vill lyfta att det blir motsägelsefullt att den som har fått beslut och har laglig rätt att befinna sig i Sverige, inte ska ha rätt till någon försörjning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.3",
      "sentiment": -1.0,
      "quote": "Vi menar att modellen strider mot socialtjänstens uppdrag att främja enskildas ekonomiska och sociala trygghet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": -1.0,
      "quote": "Vi anser att det kan bli effekter som utanförskap, segregering, svartjobb, skuldsättning och barnfattigdom varför vi avstyrker förslaget att personer som får etableringsersättning inte ska kunna få kompletterande ekonomiskt bistånd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9",
      "sentiment": 1.0,
      "quote": "Vi instämmer i att det krävs stora åtgärder med utbildningsinsatser och hur administration ska ske för kommunerna samt att övergångsbestämmelser behövs för individen.",
      "quote_type": "grund"
