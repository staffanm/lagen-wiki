    },
    {
      "forarbete_id": "a6.4.4",
      "sentiment": -1.0,
      "quote": "Flera av de som omfattas av kvalificeringsvillkoret står långt ifrån arbetsmarknaden och har behov av stöd varför vi inte tror att utredningens syfte, dvs att det ska leda till ökade drivkrafter för arbete, kommer att uppnås.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.5",
      "sentiment": -0.5,
      "quote": "Att en bosättningstid ska vara 5 år kan ha stora negativa konsekvenser utifrån bl.a. barnperspektivet men även för människors möjlighet till etablering och integrering i samhället.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.6",
      "sentiment": -1.0,
      "quote": "Vi anser inte att det är skäligt att utgå från arbetsinkomster då alla inte har möjlighet att arbeta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.7",
      "sentiment": 1.0,
      "quote": "Sundsvalls kommun instämmer i förslaget.",
