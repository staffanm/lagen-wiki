    },
    {
      "forarbete_id": "a7.2.3",
      "sentiment": -0.5,
      "quote": "Socialstyrelsen anser att förslaget innebär en stor förändring i synen på socialtjänstens arbete inom området ekonomiskt bistånd när det gäller att vara samhällets yttersta skyddsnät.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.5",
      "sentiment": -1.0,
      "quote": "Myndigheten anser att förslaget inte är i linje med dessa rättigheter då förslaget innebär att vissa barn inte kommer ha rätt till ekonomiskt bistånd, inte ens i akuta nödsituationer, för att få sina grundläggande behov tillgodosedda.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.5.4",
      "sentiment": -0.2,
      "quote": "Som nämns ovan kan personer med funktionsnedsättning träffas av kvalificeringsvillkoret, vilket gör att de då kan komma att stå helt utan möjligheter till försörjning trots att de kanske inte kan arbeta.",
      "quote_type": "grund"
    }
