  "overall": {
    "sentiment": -1.0,
    "quote": "Förslagen om kvalificering för bosättningsbaserade förmåner enligt socialförsäkringsbalken samt för ekonomiskt bistånd enligt socialtjänstlagen (SoL), förväntas få negativa konsekvenser för socialnämnderna i Göteborgs Stad, både ekonomiskt och ur ett arbetsmiljöperspektiv.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a6.4",
      "sentiment": -0.8,
      "quote": "Stadsledningskontoret bedömer att kvalificeringsreglerna kommer att skapa en övervältring från statliga bidrag till kommunala bidrag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec191",
      "sentiment": -0.8,
      "quote": "Kommunerna har då fortsatt ansvar att bevilja och verkställa insatsen, men utan statlig finansiering.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.6",
      "sentiment": -0.4,
      "quote": "Stadsledningskontoret gör bedömningen att möjligheten att förkorta tiden för kvalificering genom att uppfylla ett inkomstvillkor i huvudsak kommer att gynna arbetsföra vuxna utan barn och inte föräldrar eller individer med nedsatt arbetsförmåga, det vill säga de som framför allt kan vara aktuella för just bosättningsbaserade socialförsäkringsförmåner.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": -0.8,
      "quote": "Stadsledningskontoret bedömer att förslagen ökar den ekonomiska utsattheten för redan utsatta grupper utan att förbättra möjligheterna till självförsörjning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec318",
      "sentiment": -0.6,
      "quote": "Det kan också innebära att individer kommer att ha olika förutsättningar beroende på i vilken kommun de vistas, då tillämpningen av bestämmelsen kan komma att variera eftersom bistånd enligt 4 kap. 2 § SoL är en möjlighet för kommunerna men ingen rättighet för den enskilde individen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec137",
      "sentiment": -0.8,
      "quote": "Det finns en risk att de föreslagna förändringarna inte kommer att vara förenliga med barnkonventionen, som är svensk lag, och Sveriges åtaganden på grund av internationella konventioner.",
      "quote_type": "grund"
    }
  ]
