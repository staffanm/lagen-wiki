    },
    {
      "forarbete_id": "a6.4.2",
      "sentiment": -1.0,
      "quote": "Socialförsäkringsförmåner möjliggör förutsättningar för en skälig levnadsnivå för barn och deras föräldrar avseende de mest basala levnadsomkostnaderna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.5",
      "sentiment": -1.0,
      "quote": "Mot bakgrund av statens ansvar för migrationspolitiken anser Malmö stad att förslaget om kvalificeringstid om fem år innebär en omfattande övervältring av ansvar och kostnader för nyanländas försörjning från stat till kommun.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.6",
      "sentiment": -1.0,
      "quote": "Mot bakgrund av att kvalificeringskrav enligt utredningens förslag kommer träffa alla som flyttar till och bosätter sig i Sverige bedömer Malmö stad att beloppen är hämtade utifrån felaktigt antaganden.",
