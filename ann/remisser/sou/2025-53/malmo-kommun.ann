    },
    {
      "forarbete_id": "a7.6",
      "sentiment": -0.5,
      "quote": "Utredningen förbiser den försörjningsskyldighet som är aktuell för makar, sambor eller partners samt försörjningsskyldighet för gemensamma barn.",
