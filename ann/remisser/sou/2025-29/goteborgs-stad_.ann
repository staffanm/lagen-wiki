  "segments": [
    {
      "forarbete_id": "a9.1",
      "sentiment": 0.2,
      "quote": "Däremot ser Göteborgs Stad brister när utredningsdirektivet inte synliggjort den kommunala arbetsmarknadspolitikens del både när det gäller nulägesanalys och beskrivning av konsekvenserna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2.1",
      "sentiment": 1.0,
      "quote": "Göteborgs Stad instämmer med den principiella utgångspunkten att kvaliteten hos Samhall behöver öka och bestå över tid.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a9.4",
      "sentiment": -0.5,
      "quote": "Kopplat till detta är staden kritiska till att förändringarna för en höjd kvalitet ska finansieras med en minskning av inflödet och sänkt lön för de nyanställda, detta står i motsats till att utredningen samtidigt bedömer att åtminstone 10 000 personer till är i behov av skyddad anställning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5",
      "sentiment": 0.0,
      "quote": "Arbetstagarnas rätt till en ändamålsenlig introduktion ska inte behöva ske på bekostnad av sänkt lön.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.6",
      "sentiment": 1.0,
      "quote": "Vi ser vidare positivt på förslaget om att komplettera övergångsmålet med ett nytt mål som främjar varaktiga övergångar för att uppnå kvalitet i anställningen och kommande övergång till nytt arbete på den öppna arbetsmarknaden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.8.2",
      "sentiment": 0.5,
      "quote": "Förslaget att indexsäkra merkostnadsersättningen är nödvändigt för att Samhall ska kunna uppfylla sitt samhällsuppdrag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.9",
      "sentiment": -0.5,
      "quote": "Då denna utvecklingsinsats endast kommer erbjudas nyanställda medför det att befintligt anställda inte får ta del av denna kvalitetshöjning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.10.2",
      "sentiment": 1.0,
      "quote": "En sådan anvisning ska fattas av behörig myndighet för att undvika risken att Samhall till följd av effektivitetskrav skulle välja att prioritera mer högpresterande individer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.11.1",
      "sentiment": 1.0,
      "quote": "Dessa förändringar är viktiga för att få en mer personcentrerad handläggning, och underlättar också samverkan med kommunerna",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.11.2",
      "sentiment": -0.5,
      "quote": "Göteborgs Stad har lång erfarenhet av att arbeta med OSA och har sett ett behov av stödinsatser under anställningen, trots att de anställda har fått stödinsatser från Arbetsförmedlingen innan anställningens start.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.11.3",
      "sentiment": 1.0,
      "quote": "Göteborgs Stad instämmer i förslaget att ge Arbetsförmedlingen uppdraget.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a9.12",
      "sentiment": 0.2,
      "quote": "Erfarenheter från Samhall visar att när lönsamhet och produktivitet premieras tenderar personer med omfattande stödbehov att väljas bort.",
