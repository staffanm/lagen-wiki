    {
      "forarbete_id": "a9.11.1",
      "sentiment": 1.0,
      "quote": "Svenska kyrkan delar utredningens bild av att det inte är rimligt att anta att personer med funktionsnedsättning som står långt från arbetsmarknaden ska kunna driva sina myndighetsärenden själva i den utsträckning som de i dag behöver göra.",
      "quote_type": "grund"
