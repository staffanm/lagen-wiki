  "overall": {
    "sentiment": 0.5,
    "quote": "Fremia delar utredningens uppfattning att idéburna organisationer kan och bör spela en större roll i arbetsmarknadspolitiken för att nå dem som har längst avstånd till arbetsmarknaden.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a9.3.1",
      "sentiment": 1.0,
      "quote": "Långsiktighet är en förutsättning för att arbetsmarknadsinsatser, inte minst riktade till dem som står långt ifrån arbetsmarknaden, ska bli effektiva.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.4.1",
      "sentiment": 0.2,
      "quote": "Samtidigt behöver statens anslag till Samhall möjliggöra en rimlig löneutveckling till bolagets anställda.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5.1",
      "sentiment": 0.5,
      "quote": "Som utredaren skriver medför dock detta ökade kostnader för Samhall, som behöver täckas av tillräcklig finansiering.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.6",
      "sentiment": 0.5,
      "quote": "Även kortare övergångar/utrekryteringar har ett värde för individen och för arbetsmarknaden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.7.1",
      "sentiment": -0.2,
      "quote": "Frågan är om de nya målsättningar som utredningen förslår verkligen driver mot ökad kvalitet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.8.2",
      "sentiment": 1.0,
      "quote": "Fremia välkomnar en långsiktig och förutsägbar finansiering, och vill betona att nivån måste spegla ambitionen från ägaren.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.8.3",
      "sentiment": -0.5,
      "quote": "I det fall regeringen i budgetpropositionen får ett sådant uppdrag finns en risk att man jämför styckkostnad mellan olika lönestöd som inte är jämförbara och då gör bedömningar och avvägningar av något som är väsensskilt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.9.1",
      "sentiment": 0.5,
      "quote": "Däremot är det en kostnadsdrivande insats där ansvaret bör ligga på Arbetsförmedlingen innan anvisning till skyddat arbete.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.10.1",
      "sentiment": 0.5,
      "quote": "Dock menar vi att måttet här bör vara baserat på antalet anvisade personer, snarare än på antalet lönetimmar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.10.2",
      "sentiment": 0.5,
      "quote": "För att kunna uppfylla uppdraget behövs mer information om de anvisades förutsättningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.11.1",
      "sentiment": 1.0,
      "quote": "Det ökar möjligheterna för att arbetssökande med funktionsnedsättning kan förberedas på ett bättre sätt inför sin anvisning och få det stöd de behöver.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.12.1",
      "sentiment": 1.0,
      "quote": "Det är ett viktigt steg för att säkerställa att personer med funktionsnedsättning som står långt från arbetsmarknaden inte ska behöva stå utan insats enbart för att deras behov inte passar in enligt dagens definition.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.12.2",
      "sentiment": 0.5,
      "quote": "Stödnivån och de ekonomiska villkoren för det nya skyddade arbetet bör utformas så att idéburna arbetsgivare verkligen har praktisk möjlighet att anställa inom ramen för insatsen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.15.1",
      "sentiment": -0.5,
      "quote": "Fremia anser att en sådan höjning av taket för lönebidraget måste ske så skyndsamt som möjligt, det finns inte tid för någon utredning.",
      "quote_type": "grund"
    }
  ]
