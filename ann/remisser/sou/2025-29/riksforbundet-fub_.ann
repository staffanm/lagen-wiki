    },
    {
      "forarbete_id": "a9.6.1",
      "sentiment": 0.8,
      "quote": "Utredningens förslag att avskaffa nuvarande övergångsmål och ersätta det med tre mera nyanserade mål för övergångar är ett steg i rätt riktning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.11.4",
      "sentiment": 0.8,
      "quote": "Under projekttiden har vi dock påpekat att det är mycket olyckligt att en så liten andel av skolorna som deltar i Samstart hör till den anpassade skolformen, trots att eleverna som går på anpassat gymnasium hör till den gruppen som möter de största utmaningar vad gäller att hitta ett lönearbete.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.13.1",
      "sentiment": 0.8,
      "quote": "Utan en fungerande samverkan mellan dessa aktörer, minimeras chanserna för personer med intellektuell funktionsnedsättning att få en anställning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.12.2",
      "sentiment": 0.5,
      "quote": "Därför ställer vi oss mycket positivt till utredningens förslag att idéburna organisationer ska kunna erbjuda en ny form av skyddat arbete, inte minst för att många idéburna organisationer besitter mycket gedigen kunskap kring olika funktionsnedsättningar och vilket stöd som kan behövas för den enskilde.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.3",
      "sentiment": 1.0,
      "quote": "Det är/bör vara uppenbart att ersättningar av olika slag som hör till samma sfär – i detta fall, löneutveckling i samhället – måste kunna utvecklas i samma takt.",
