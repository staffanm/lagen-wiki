  "overall": {
    "sentiment": 0.2,
    "quote": "Vi anser att det dock är bra att regeringen nu ser över Samhall och förhoppningsvis är beredda att genomföra de förändringar som behövs som på ett påtagligt sätt skulle kunna bidra till att stärka arbetslinjen och öka förankringen på arbetsmarknaden för många.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a9.3.1",
      "sentiment": 1.0,
      "quote": "Funktionsrätt Sverige tillstyrker utredningens bedömning att giltigheten för Samhalls ägaranvisning bör förlängas med tio år.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a9.4.1",
      "sentiment": -1.0,
      "quote": "Vi är mycket kritiska till att färre personer ska anvisas till Samhall när inget minskat behov föreligger.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5.1",
      "sentiment": 1.0,
      "quote": "En förstärkt introduktionsperiod på 24 månader skapar betydligt bättre förutsättningar för en lyckad och utvecklande period som anställd på Samhall.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5.2",
      "sentiment": -1.0,
      "quote": "Det innebär att personer med funktionsnedsättning förväntas arbeta utan ersättning och därmed värde på nedlagt arbete under en fjärdedel av sin arbetsdag och att en redan tuff ekonomisk situation förvärras ytterligare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5.3",
      "sentiment": 1.0,
      "quote": "Funktionsrätt Sverige tillstyrker utredningens bedömning att Samhall även i fortsättningen bör erbjuda möjlighet till återanställning inom 12 månader för en individ som övergår till arbete hos en annan arbetsgivare samt att den förstärkta perioden bör återupptas vid återgången i arbete hos Samhall.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a9.6.1",
      "sentiment": 1.0,
      "quote": "Det är mycket positiv att utredningen har tittat närmare på konsekvenserna av Samhalls alldeles för starka fokus på övergångar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.8.2",
      "sentiment": 1.0,
      "quote": "Det bör vara en självklarhet att ersättningar av detta slag uppräknas årligen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.10.1",
      "sentiment": 1.0,
      "quote": "Funktionsrätt Sverige tillstyrker utredningens bedömning att Arbetsförmedlingen bör ges i uppdrag att i samråd med Samhall ta fram en modell för hur organisationerna, på basis av antalet lönetimmar som regeringen fastställer för Samhall, kan göra fortlöpande gemensamma bedömningar av hur många anvisningar som behövs.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a9.10.2",
      "sentiment": 1.0,
      "quote": "Funktionsrätt Sverige tillstyrker utredningens bedömning att Arbetsförmedlingen bör ges i uppdrag att utveckla enhetliga arbetssätt för prioritering och urval när det finns flera kandidater till en ledig plats hos Samhall.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a9.11.1",
      "sentiment": 1.0,
      "quote": "Vi välkomnar särskilt att utredningen föreslår att frågan om möjligheter och risker med myndighetens ärendebaserade arbetssätt uppmärksammas utifrån målgruppens perspektiv.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.11.2",
      "sentiment": -0.5,
      "quote": "Många människors arbetsförmåga och uthållighet i arbete bärs upp av en fungerande vardag genom anpassningar och stöd utanför själva arbetsplatsen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.11.3",
      "sentiment": 0.2,
      "quote": "Det finns stora behov av att se över Förordning (2017:462) om särskilda insatser för personer med funktionsnedsättning som medför nedsatt arbetsförmåga, vilket funktionsrättsrörelsen upprepade gånger.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.11.4",
      "sentiment": 1.0,
      "quote": "För individen men även ur ett samhällsekonomiskt perspektiv finns enormt mycket att vinna att stötta unga med funktionsnedsättning, att det inte görs tillräckligt är dyrt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.12.1",
      "sentiment": 1.0,
      "quote": "Vi anser, som utredningen, att behovet hos målgruppen bör styra.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.12.2",
      "sentiment": 0.5,
      "quote": "För vår målgrupp har arbetsintegrerande sociala företag mycket stor betydelse.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.13.1",
      "sentiment": 1.0,
      "quote": "Funktionsrätt Sverige tillstyrker utredningens bedömning och betonar vikten av att en sådan utredning genomförs.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a9.13.2",
      "sentiment": 1.0,
      "quote": "Det har länge varit ett problem att personer hamnar i kläm mellan Arbetsförmedlingen och Försäkringskassan, dvs. att personer inte beviljas ersättning från sjukförsäkringen men är för sjuka för Arbetsförmedlingen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.14.1",
      "sentiment": -0.5,
      "quote": "Vi anser att det är viktigt att lönebidragsanställningarna ökar kraftigt då arbetslösheten är mycket låg inom gruppen samtidigt som kompetensbristen i många branscher är hög.",
      "quote_type": "grund"
