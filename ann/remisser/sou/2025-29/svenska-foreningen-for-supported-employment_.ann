  "overall": {
    "sentiment": 0.2,
    "quote": "Vi tror att det finns stora vinster i att organisationer som Samhall, Arbetsförmedlingen och kommunernas arbetsmarknadsenheter i högre utsträckning arbetar mer systematiskt och utbrett med metoder som fungerar för de målgrupper som man avser att ge ett stöd mot arbete och studier.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a9.1.1",
      "sentiment": 1.0,
      "quote": "Att säkerställa möjligheterna till arbete på samma villkor som för andra, och tillgängliggöra arbetslivet genom individuella lösningar och anpassningar, är alltså en rättighetsfråga för individen och därmed en angelägenhet för hela samhället.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5",
      "sentiment": -1.0,
      "quote": "Risken med att låta 25 % av arbetstiden kallas utvecklingstid och inte vara lönegrundande, ser vi som ett sätt att i praktiken sänka lönerna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.6",
      "sentiment": 0.5,
      "quote": "Detta innebär risk för att övergångsarbetet inte i tillräcklig grad utgår från de anställdas individuella behov och en ambition om att övergången ska kunna bli varaktig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.10.2",
      "sentiment": 1.0,
      "quote": "SFSE anser att Arbetsförmedlingen bör få i uppdrag av regeringen att följa upp processen för målgruppen samt att utvärdera i hur hög utsträckning det stöd som ges idag är individuellt utformat.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.13.1",
      "sentiment": 0.5,
      "quote": "SFSE anser att samverkan mellan organisationer och myndigheter är av största vikt för målgruppen, men även att få individuellt stöd och ha en (1) kontaktperson hos Arbetsförmedlingen.",
