    },
    {
      "forarbete_id": "a9.9",
      "sentiment": 0.2,
      "quote": "Vi vill framföra vikten av att den svenska DNA-databasen kopplas samman med redan existerade databaser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec25",
      "sentiment": 0.8,
      "quote": "inte minst mot bakgrund att utredningen visar att adoptionssammanslutningarna sedan starten varit involverade i oegentligheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec26",
      "sentiment": 1.0,
      "quote": "SKAN ställer sig positivt till att en svensk domstol endast får pröva tillstånd till en adoption om en svensk myndighet har gett tillstånd till den.",
