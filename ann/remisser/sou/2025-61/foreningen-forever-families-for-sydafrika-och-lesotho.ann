    },
    {
      "forarbete_id": "a9.3",
      "sentiment": 1.0,
      "quote": "Vi instämmer i utredningens bedömning av behovet av stöd och tillstyrker samtliga förslag, med några medskick och kommentarer.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a9.4",
      "sentiment": 1.0,
      "quote": "Vi ser mycket positivt på ett kommande resurscenter för adopterade och deras familjer, där kompetens samlas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.6",
      "sentiment": 0.5,
      "quote": "Det är viktigt att stödet i resurscentrumet erbjuds oavsett ålder och att även behov i hela adoptivfamiljen omfattas av stödet.",
