  "segments": [
    {
      "forarbete_id": "a7.8",
      "sentiment": 1.0,
      "quote": "Att det förekommit bristande kontroll från staten och adoptionsföreningar och att uppdagade felaktigheter ignorerats är oförlåtligt.",
