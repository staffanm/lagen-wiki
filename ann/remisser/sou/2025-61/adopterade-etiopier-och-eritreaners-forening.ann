    }
  },
  "overall": {
    "sentiment": 0.5,
    "quote": "AEF menar också att utredningen i sig är ett viktigt bidrag när det gäller att dra lärdomar av vad som hänt inom området internationella adoptioner, för att sedan hitta en väg framåt.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a7.7",
      "sentiment": 1.0,
      "quote": "Konventionen ställer särskilda krav på att konventionsstaterna ska utreda adoptioner som skett genom ett påtvingat försvinnande samt återställa den rätta identiteten och ge gottgörelse till de drabbade.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.8",
      "sentiment": 1.0,
      "quote": "För att erkänna omfattningen, konsekvenserna samt hur de kan ha påverkat de adopterade som drabbats behövs en offentlig ursäkt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.10.2",
      "sentiment": 1.0,
      "quote": "De brister och svårigheter som lyfts fram i utredningen talar för att det i princip är omöjligt att garantera barn och deras familjer att internationell adoption sker utan kränkningar av mänskliga rättigheter, oegentligheter eller brott.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.10.3",
      "sentiment": 0.5,
      "quote": "Mot bakgrund av de stora brister i kontrollsystemet som framkommit i utredningen delar AEF utredarens bedömning att adoption av barn med utländsk hemvist fortsättningsvis endast ska kunna göras i de fall det sedan tidigare finns en styrkt stark personlig koppling mellan barnet och de sökande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.10.4",
      "sentiment": 0.2,
      "quote": "AEF delar utredarens bedömning att socialnämnderna ofta saknar förutsättningar att göra tillräckliga bedömningar av alla adoptionshandlingar och att ansvaret därför bör lyftas från dem.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.4",
      "sentiment": 0.5,
      "quote": "AEF delar utredarens åsikt att ett effektivt resurscentrum behöver vara nationellt styrt och samordnat, samtidigt som vissa delar (såsom samtalsstöd och mötesplatser) bör finnas fysiskt utspridda och tillgängliga på olika orter i landet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5",
      "sentiment": 1.0,
      "quote": "Att ha adopterats är en livslång omständighet som är en konsekvens av beslut som ytterst fattats av (i det här fallet svenska) staten och som därmed kommer att påverka den som har adopterats genom hela livscykeln.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.6",
      "sentiment": -0.5,
      "quote": "AEF delar inte bedömningen att resurscentrumet ska ordna mötesplatser för både adopterade och deras föräldrar utan föreslår istället att resurscentret ska ha adopterade i fokus för mötesplatsverksamheten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.7",
      "sentiment": 0.2,
      "quote": "Det innebär att processen att få hjälp att söka sitt ursprung ska ha krav på rättssäkerhet, kvalitet och dokumentation.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.8",
      "sentiment": 1.0,
      "quote": "AEF ser positivt på att adopterade får stöd vid misstankar om oegentligheter och bifaller de förslag som utredningen lägger fram.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a9.9",
      "sentiment": 0.0,
      "quote": "AEF anser inte att MFoF bör utreda förutsättningarna för en nationell DNA-databas men bifaller att Rättsmedicinalverket ska få detta uppdrag.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a9.10",
      "sentiment": 0.5,
      "quote": "För att uppfylla vad som avses behöver Riksarkivet få ett omfattande uppdrag om att ta fram underlag till stöd för en vägledning med råd och stöd till adopterade personer om var och hur man kan hitta sina handlingar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.11",
      "sentiment": 1.0,
      "quote": "Att det hittills inte varit någons ansvar att sprida denna kunskap bortom socialtjänsten menar AEF har haft förödande konsekvenser för de adopterade och adopterades närstående som behövt hjälp eller stöd inom exempelvis hälso- och sjukvård, skola, kriminalvård, etc.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.12",
      "sentiment": -0.2,
      "quote": "Utredningen föreslår en summa på 15 000 kronor vilket AEF vill betona är alldeles för lite.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.13",
      "sentiment": -1.0,
      "quote": "Bakgrunden är att det kan uppstå tveksamheter kring vem som har ansvar för ursprungssökning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.14",
      "sentiment": -1.0,
      "quote": "För att bryta detta 60 åriga mönster behöver placeringen av ett nationellt resurscentrum huvudsakligen ligga på en kunskapsproducerande myndighet med vana av att samverka med kommuner och regioner.",
      "quote_type": "grund"
    }
  ]
}