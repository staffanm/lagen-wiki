    },
    {
      "forarbete_id": "a9.8",
      "sentiment": 0.5,
      "quote": "Utan sådan kompetens riskerar arbetet att bli ytligt och utan verkan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.9",
      "sentiment": 0.5,
      "quote": "Här är det av vikt att det innebär samarbeten med de länder som Sverige adopterat från, för att kunna matcha adopterad och ursprungsfamilj.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.10",
      "sentiment": 0.2,
      "quote": "Detta då det varit svårt att få ut handlingar, och hanteringen har skötts på ett i grunden otillfredsställande för att inte säga oetiskt sätt.",
