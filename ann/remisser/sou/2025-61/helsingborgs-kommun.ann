  "segments": [
    {
      "forarbete_id": "sec19",
      "sentiment": 1.0,
      "quote": "Helsingborgs stad har inget att erinra mot ratificeringen och att därmed acceptera granskningen kring hur Sverige lever upp till konventionens krav.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec20",
      "sentiment": 1.0,
      "quote": "Helsingborgs stad instämmer i att staten bör erkänna de kränkningar av mänskliga rättigheter som skett inom internationell adoptionsverksamhet, de konsekvenser detta haft för adopterade och deras familjer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec22",
      "sentiment": 0.5,
      "quote": "Helsingborgs stad välkomnar denna uppbyggnad av kunskapsbank och vill understryka behovet av att dessa forum inte endast erbjuds i digital form utan även ger möjlighet till fysiska träffar som föregås av en aktiv inbjudan till berörda.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec23",
      "sentiment": 1.0,
      "quote": "Helsingborgs stad tillstyrker förslaget att adopterade personer ska ha rätt till ekonomiskt bidrag för resa till ursprungslandet.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec23",
      "sentiment": 0.2,
      "quote": "Staden vill dock, liksom utredningen själv, betona integritetsriskerna om uppgifterna med känslig information om individen själv och släktingar kan komma att missbrukas och användas i felaktigt syfte.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec25",
      "sentiment": 1.0,
      "quote": "Genom att avveckla förmedlingsverksamheten minskar risken för att barn adopteras under oetiska eller olagliga omständigheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec26",
      "sentiment": 1.0,
      "quote": "I de adoptionsärenden som främst kan komma i fråga - där det finns en personlig koppling mellan barnet och den som vill adoptera - ställer sig Helsingborgs stad bakom förslaget att staten ska ta större ansvar för att säkerställa att internationella adoptioner är rättssäkra och till barnets bästa.",
      "quote_type": "grund"
