  "segments": [
    {
      "forarbete_id": "a7.7",
      "sentiment": 1.0,
      "quote": "AFO tillstyrker utredaren att Sverige skyndsamt ska ratificera ”Konventionen till skydd för alla människors mot påtvingat försvinnande”.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.8",
      "sentiment": 0.5,
      "quote": "AFO tillstyrker förslaget om offentlig ursäkt samt anser att det är av största betydelse att det tillsätts en upprättelsekommission.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.10.2",
      "sentiment": 1.0,
      "quote": "Utredningen visar tydligt på de brister som finns inom internationell förmedlingsverksamhet, både i Sverige och utomlands.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.10.3",
      "sentiment": 0.2,
      "quote": "AFO kan godta att barn som ska adopteras till Sverige ska ha en styrkt personlig koppling till den som vill adoptera, det ska till exempel vara ett syskon som befinner sig i utlandet som behöver sammanföras med biologiskt syskon i Sverige.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.10.4",
      "sentiment": 0.5,
      "quote": "Den myndighet som ska ansvara för uppdraget behöver ha spetskompetens kring frågorna samt ges goda resurser för att kunna åtaga sig uppdraget.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.4",
      "sentiment": 0.5,
      "quote": "AFO anser att det adoptionsspecifika resurscentret ska vara placerat i Stockholm för att bland annat kunna verka i närhet av departement, statliga myndigheter, arkiv och adopterades föreningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5",
      "sentiment": 0.5,
      "quote": "samtalsstödet behöver utformas i samklang med de adopterade för att få bästa nytta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.6",
      "sentiment": 1.0,
      "quote": "AFO ser idag hur viktigt det är att få möta andra adopterade och kunna utbyta erfarenheter, stöd, råd och vägledning i livet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.7",
      "sentiment": 0.5,
      "quote": "Att söka ursprung behöver ske professionellt med goda kunskaper om både det praktiska arbetet men även kring bemötande, stöd och råd till den adopterade.",
      "quote_type": "grund"
    },
    {
