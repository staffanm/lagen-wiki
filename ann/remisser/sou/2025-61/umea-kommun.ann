  "overall": {
    "sentiment": 0.8,
    "quote": "Kommunen ser fördelar med dessa föreslagna förändringar, då de sammantaget kan säkra upp och skapa en grund för ett mer kvalitetsmässigt, jämlikt stöd och mer enhetliga bedömningar och beslut.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a7.5.8",
      "sentiment": 0.8,
      "quote": "Kommunen instämmer i utredningens slutsats att socialtjänsten fått ett stort ansvar i adoptionssammanhang, där rollen som inneburit prövning och kontroll av adoptivföräldrarnas lämplighet upplevts som komplex.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.8",
      "sentiment": 1.0,
      "quote": "Kommunen ställer sig bakom förslaget.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.9.3",
      "sentiment": 1.0,
      "quote": "Kommunen är överens med de förslag som MFOF föreslår.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.10.3",
      "sentiment": 0.8,
      "quote": "Att ge staten större kontroll skulle kunna innebära en mer rättssäker hantering och att oegentligheter undviks (orsakade av exempelvis ekonomiska intressen).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.10.4",
      "sentiment": 0.8,
      "quote": "precis som utredningen beskriver så har MFOF bättre förutsättningar när det gäller att pröva om adoptionsförfarandet får fortsätta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.10.6",
      "sentiment": 1.0,
      "quote": "att det precis som utredningen lyfter fram då behöver säkerställas att barnets bästa är överordnat alla andra intressen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.3",
      "sentiment": 0.8,
      "quote": "Kunskapsnivån är idag ojämn inom socialtjänst och hälso- och sjukvård och för att stödet som ges ska vara likvärdigt finns det behov av ett nationellt organiserat stöd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.4",
      "sentiment": 1.0,
      "quote": "Det är viktigt att adopterade personer får bättre kännedom om vilket stöd som erbjuds, att stödet är lätt tillgängligt och når alla som behöver det.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.4",
      "sentiment": 0.5,
      "quote": "att det möjliggör ett stöd som blir mer jämlikt och mer av samma kvalitet oavsett var i landet personen bor.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.7",
      "sentiment": 1.0,
      "quote": "ser positivt på att resurscentrumet ska vara en samlad väg in för adopterade personer som vill söka sitt ursprung och att verksamheten bygger upp nödvändig och bred kompetens inom området och en fungerande struktur för detta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.8",
      "sentiment": 1.0,
      "quote": "Detta eftersom centrumet även är tänkt att erbjuda stöd till de adopterade personer som misstänker att oegentligheter begåtts i deras adoptioner.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.11",
      "sentiment": 1.0,
      "quote": "vilket ger en likriktning i kompetenshöjning, så att adopterade personer får stöd av samma kvalitet oavsett var den enskilde bor.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.12",
      "sentiment": 1.0,
      "quote": "då det är viktigt att alla får samma förutsättningar att söka sitt ursprung och att det inte blir en ekonomisk fråga som idag då alla inte har råd att resa.",
      "quote_type": "grund"
    }
  ]
}