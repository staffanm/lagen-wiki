  "segments": [
    {
      "forarbete_id": "a8.10.3",
      "sentiment": -0.5,
      "quote": "Myndigheten anser att den föreslagna utformningen av bestämmelsen medför att två aktörer ska göra parallella utredningar och prövningar om samma fråga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec574",
      "sentiment": -0.2,
      "quote": "Med de skärpta krav som utredaren föreslår gällande tillstånd till internationell adoption bedömer myndigheten att utredningar inför beslut kommer att bli betydligt mer omfattande och tidskrävande än idag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec575",
      "sentiment": -0.5,
      "quote": "MFoF anser bestämmelsens föreslagna utformning är rättsosäker och motverkar syftet med den prövning som myndigheten ska göra.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec576",
      "sentiment": 0.5,
      "quote": "Detta för att undvika en situation där en adoption som av olika anledningar inte är lämplig hinner genomföras under den tid som ett överklagande av beslutet är anhängiggjort i domstol.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.1",
      "sentiment": 0.0,
      "quote": "Om bestämmelsen ska vara effektiv och enkel att tillämpa bör det förtydligas vilken eller vilka aktörer som bär ansvar för att anmäla misstanke om brott.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.10.4",
      "sentiment": 1.0,
      "quote": "MFoF tillstyrker förslaget om att myndigheten ska ta över ansvaret för prövning av om ett adoptionsförfarande får fortsätta från socialnämnderna.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.10.5",
      "sentiment": -0.2,
      "quote": "Det kan uppstå situationer där adoptanten varken kan få en genomförd adoption automatiskt erkänd i Sverige eller ett beslut om adoption i svensk domstol.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.1",
      "sentiment": 0.0,
      "quote": "I den fortsatta beredningen bör viss terminologi i författningsförslagen gällande föräldrabalken ses över så att den blir enhetlig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.5",
      "sentiment": -0.2,
      "quote": "Myndigheten anser dock att det är otillfredsställande att det inte är närmare definierat i lagstiftning eller förarbeten vilka åtgärder som kan anses ingå i förmedlingsbegreppet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5",
      "sentiment": 1.0,
      "quote": "MFoF tillstyrker förslaget att förutsättningarna för att kunna öka tillgängligheten och valfriheten av ett adoptionsspecifikt samtalsstöd ska utredas.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a9.7.2",
      "sentiment": -0.2,
      "quote": "Resultatet av en ursprungssökning kan vara osäkert och processen kan vara svår att hantera, även för vuxna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.7.3",
      "sentiment": 0.0,
      "quote": "För att säkerställa att ursprungssökning via organisationer sker på ett systematiskt och kontrollerat sätt måste riktlinjer utarbetas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.8.1",
      "sentiment": 1.0,
      "quote": "Myndigheten tillstyrker att det föreslagna resurscentrumet ska erbjuda ett individuellt stöd till adopterade personer som misstänker oegentligheter i adoption.",
      "quote_type": "standpunkt"
    },
    {
