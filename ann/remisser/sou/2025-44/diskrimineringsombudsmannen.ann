  "overall": {
    "sentiment": 0.2,
    "quote": "DO välkomnar därför en reform som syftar till att alla elever ska få ledning och stimulans för att kunna följa undervisningen, att hinder för ett tidigt och snabbt stöd ska undanröjas och att stödet görs mer flexibelt.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a6.1",
      "sentiment": 0.2,
      "quote": "DO är dock samtidigt kritiska till att utredningen inte har belyst att elever med funktionsnedsättning kan behöva stöd utöver det som direkt rör ämnesspecifika lektioner, exempelvis stöd under raster, med sociala samspel osv.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": -0.2,
      "quote": "DO anser att garantin för tidiga stödinsatser i anpassad skola som infördes under 2024 behöver utvärderas och att utvärderingen sedan läggs till grund för om den behöver tas bort eller inte.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": 0.5,
      "quote": "En förutsättning för att den reform som utredningens förslag är tänkta att leda till ska falla ut väl är att alla lärare får med sig kunskaper från lärarutbildningen om hur olika funktionsnedsättningar, exempelvis dyslexi, påverkar elevens lärande och utveckling",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": 0.5,
      "quote": "DO tillstyrker förslaget då det bör kunna bidra till att elevers behov av stöd kan upptäckas tidigt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5",
      "sentiment": 0.2,
      "quote": "Förslagen om stöd och särskilt stöd utöver den ordinarie undervisningen kan riskera att leda till att elever stigmatiseras, samtidigt som den ordinarie undervisningen kan skapa risker för diskriminering",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.3",
      "sentiment": -1.0,
      "quote": "DO bedömer att minskad dokumentation riskerar leda till att skolan missar att uppmärksamma elevers behov av stöd samt att varken skolan eller föräldrarna kan få en helhetsbild över vilka åtgärder som sats in tidigare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.2",
      "sentiment": 1.0,
      "quote": "Det bör korta väntetiden för sådant stöd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7",
      "sentiment": -0.5,
      "quote": "Utgångspunkten för svensk skola måste vara alla människors lika rätt till inkluderande utbildning och en skola fri från diskriminering.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8",
      "sentiment": 0.5,
      "quote": "Mot bakgrund av att anpassad skola medför att en elev riskerar att inte kunna bli behörig för högre utbildning är det av största vikt att skolan säkerställer undervisning för en mångfald av elever",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.14",
      "sentiment": 1.0,
      "quote": "DO tillstyrker förslagen i 6.5.14",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.8.3",
      "sentiment": 1.0,
      "quote": "Likaså förslaget i 6.8.3 om anpassad studiegång bör följas upp och utvärderas.",
      "quote_type": "standpunkt"
    }
  ]
