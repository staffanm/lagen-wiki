  "segments": [
    {
      "forarbete_id": "a3.4.1",
      "sentiment": -0.2,
      "quote": "Vi skulle helst se att det fanns statliga medel som var öronmärkta för stöd till elever med funktionsnedsättning oavsett antal elever som behöver stöd i en skola eller kommunernas ekonomier.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1",
      "sentiment": 1.0,
      "quote": "Extra anpassningar kan fördröja att utredning om särskilt stöd genomförs.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": 1.0,
      "quote": "Det har visat sig att garantin för tidiga stödinsatser och nationella prov i årskurs 3 inte har inneburit att fler elever har fått stödinsatser inom läsning, skrivande och matematik i förskoleklass och i lågstadiet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": 0.5,
      "quote": "Vi anser att stödet ska garanteras oavsett om eleven har lätt eller svårt att tillgodogöra sig kunskaper i förhållandet till ämnets syfte och centrala innehåll.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": 0.2,
      "quote": "Vi vill dock understryka vikten av att de standardiserade testerna är tillgängliga och anpassade för barn som är blinda eller har en svår synnedsättning och använder punktskrift.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.4",
      "sentiment": 0.5,
      "quote": "Vi vill dock poängtera vikten av att det bör göras i samarbete med Specialpedagogiska skolmyndigheten för att säkerställa tillgängligheten för elever med synnedsättning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5",
      "sentiment": 0.2,
      "quote": "Vi vill dock poängtera att denna korta och tillfälliga insats inte ska användas för att ersätta det kontinuerliga stöd som elever med synnedsättning behöver.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6",
      "sentiment": -0.5,
      "quote": "Om en sådan förändring ska införas ska det vara elevens behov av särskilt stöd som styr valet av hur stödet ges.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.5",
      "sentiment": 1.0,
      "quote": "Elevens behov ska vara styrande när det gäller om stödet ska ges som undervisning enskilt eller i en särskild undervisningsgrupp.",
      "quote_type": "grund"
    }
  ]
