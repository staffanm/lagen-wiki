  "segments": [
    {
      "forarbete_id": "a6.1",
      "sentiment": 0.2,
      "quote": "En synvända mot att klassrumsundervisningen i utgångsläget ska vara en så kollektiv process som möjligt är sannolikt behövlig och klok.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": -0.5,
      "quote": "Förbundet avstyrker dock förslaget att ta bort Garantin för tidiga stödinsatser och menar att den är en viktig kvalitetsmarkör och att ambitionerna för att klara garantin istället bör höjas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": 1.0,
      "quote": "Förbundet delar också utredarens utgångspunkt att den gemensamma undervisningen ska vara utgångspunkten och att det stöd som ges av lärarna ska syfta till att eleverna kan följa den, snarare än att införa en långt gången individualiserad praktik.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": -0.5,
      "quote": "Sveriges Skolledare avstyrker därför från förändringen med hänsyn till den i övrigt omfattande reformagendan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5",
      "sentiment": 0.5,
      "quote": "Förbundet ser samtidigt att förslaget ställer ökande krav på att alla skolors organisation har en utformning och en flexibilitet som inte finns på plats överallt idag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.3",
      "sentiment": -1.0,
      "quote": "Sveriges Skolledare avstyrker förslaget att endast lärare ska kunna bestämma att en elev ska erhålla stödundervisning med hänvisning till att det skulle lägga ett alltför stort ansvar på enskilda lärare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.4",
      "sentiment": 0.5,
      "quote": "Sveriges Skolledare bedömer att det inte finns förutsättningar till detta i alla organisationer idag vilket kommer att innebära krav på resurstillskott, inte minst på mindre skolor där det kanske bara finns enstaka lärare i många ämnen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.5",
      "sentiment": 1.0,
      "quote": "Sveriges Skolledare har inget att invända mot förslaget.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.5.7",
      "sentiment": -1.0,
      "quote": "Sveriges Skolledare anser att ett obligatorium kan få väl långtgående konsekvenser och avstyrker förslaget.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.2",
      "sentiment": -0.2,
      "quote": "Sveriges Skolledare uppfattar det som oklart hur en normal ärendegång kommer att se ut och rekommenderar regeringen att avvakta med allt för genomgripande förändringar av de lagtexter som har i syfte att säkerställa likvärdighet och rättssäkerhet för eleverna.",
