  "overall": {
    "sentiment": 0.4,
    "quote": "Stiftelsen Allmänna Barnhuset anser att utredningen går i rätt riktning, men att flera förslag behöver stärkas, förtydligas och förankras bättre i barns rättigheter och behov.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a6.1",
      "sentiment": 1.0,
      "quote": "Stödet har inte fyllt sitt syfte.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": 1.0,
      "quote": "Den så kallade garantin för tidiga stödinsatser har varit resurskrävande och inte lett till att fler elever får stöd i läs-och skrivinlärning och matematik vilket var syftet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": 0.2,
      "quote": "För att det ska fungera i praktiken skulle det behöva kombineras med mindre klasser samt en god tillgänglighet till specialpedagogiskt stöd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": 1.0,
      "quote": "Erfarenheter från arbetsmodellen Skolfam, stöd i skolgången för barn i familjehem, som Stiftelsen Allmänna Barnhuset samordnar, har visat att det är av stor betydelse att det arbetet inleds med en kartläggning av barnets förmågor.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5",
      "sentiment": 0.5,
      "quote": "Stiftelsen Allmänna Barnhuset ser en risk om lärare lämnas ensamma i bedömningarna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.6",
      "sentiment": 1.0,
      "quote": "vill understryka att det är en oerhört viktig del för att barn och unga med stödbehov ska lyckas i skolan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.7",
      "sentiment": -0.2,
      "quote": "Utan att barns synpunkter har beaktats och en barnkonsekvensanalys har genomförts anser vi att förslaget riskerar att motverka sitt syfte.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.12",
      "sentiment": 0.2,
      "quote": "Det är av vikt att resurser tillförs så att beredskapen för att ordna stödundervisning inte leder till en lägre lärartäthet generellt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6",
      "sentiment": 1.0,
      "quote": "Stiftelsen Allmänna Barnhuset samtycker till förslaget om särskilt stöd.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.6.2",
      "sentiment": 0.2,
      "quote": "det vore bra med en tidsangivelse för detta och inte bara att det ska ske snabbare än i nuvarande system.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.4",
      "sentiment": 1.0,
      "quote": "Erfarenheter från modellen Skolfam är att en tvärprofessionell utredning där även en psykologisk kartläggning ingår som kompletterar den pedagogiska och kan ge ett bredare underlag och en ökad förståelse för elevens behov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.5",
      "sentiment": 1.0,
      "quote": "Det är bra att det betonas att stödet ska kunna sättas in innan eleven har misslyckats i sin ordinarie elevgrupp.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7",
      "sentiment": 0.5,
      "quote": "för barn som gynnas i sin utveckling av att inkluderas i sin ordinarie elevgrupp så bör inte enskild studiegrupp vara ett alternativ.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7.3",
      "sentiment": 1.0,
      "quote": "vill betona att det särskilda stödet ska utgöra undervisning och ges av utbildade lärare med kompetens för uppdraget.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8",
      "sentiment": 1.0,
      "quote": "Det är bra att andra former av stöd ges i första hand och att beslut om anpassad skolgång föregåtts av noggranna överväganden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8.2",
      "sentiment": 0.5,
      "quote": "För elever som är i riskzon för exempelvis kriminalitet eller kan det vara viktigt att tänka på att en anpassad studiegång som leder till kortare schemalagd tid kan medföra en ökad risk att vistas i riskfyllda miljöer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.6.1",
      "sentiment": -0.5,
      "quote": "Stiftelsen Allmänna Barnhuset menar att detta gör det svårt att fullt ut ta ställning till hur barnperspektivet har integrerats i arbetet och saknar ett resonemang utifrån barns synpunkter på utredningens förslag.",
      "quote_type": "grund"
