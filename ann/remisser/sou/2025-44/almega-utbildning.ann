    },
    {
      "forarbete_id": "a6.4",
      "sentiment": 0.5,
      "quote": "För här finns en risk att undervisningen annars riktas in mot ”teaching for the test” på ett icke önskvärt sätt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5",
      "sentiment": -1.0,
      "quote": "Den här utformningen bryter styrkedjan i skolan, där rektor idag har både ansvar och beslutanderätt kring frågor om stöd.",
