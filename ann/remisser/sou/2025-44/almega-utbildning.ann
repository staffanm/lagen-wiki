    },
    {
      "forarbete_id": "a6.2",
      "sentiment": 0.0,
      "quote": "Frågan är om resultaten av de standardiserade proven ger samma nationella bild av elevernas kunskapsutveckling, eller snarare om den bild de kommande proven ger räcker för en nationell avstämning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": 0.2,
      "quote": "förbundet bedömer att det föreslagna förtydligandet i 3 kap. 2 § skollagen inte är tillräckligt tydligt.",
