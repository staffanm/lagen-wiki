    },
    {
      "forarbete_id": "a6.3",
      "sentiment": -0.2,
      "quote": "Tillsynsmyndigheter ställer krav på dokumentation som bevis på att insatser satts in, exv bevisbördan som åligger en kommun för att visa att en elev inte blivit diskriminerad på grund av funktionsnedsättning, och då blir det svårt att minska dokumentationen i skolan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": 1.0,
      "quote": "Det ger möjligheten att tidigt identifiera stödbehov på ett likvärdigt sätt och ger också huvudman och rektor förutsättningar att fördela resurser efter behov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5",
      "sentiment": -0.5,
      "quote": "Det finns överhängande risk för att förslaget skapar en åtgärdande organisation istället för en främjande och förebyggande, särskilt om stöd ska ges utanför den ordinarie undervisningstiden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6",
      "sentiment": -0.5,
      "quote": "Det riskerar att exkludera eleven från det “normala” till special, vilket riskerar att eleven får ännu sämre förutsättningar till att kunna följa den ordinarie undervisningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7",
      "sentiment": -1.0,
      "quote": "Det finns en stor risk att fler elever kräver enskilda lösningar vilket också får som konsekvens att skolans bredare uppdrag nedprioriteras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8",
      "sentiment": 0.5,
      "quote": "Det finns dock utmaningar i att andra samhällsinstanser ställer krav på skolan gällande anpassad studiegång, det handlar exempelvis om barn- och ungdomspsykiatrin och socialtjänsten.",
