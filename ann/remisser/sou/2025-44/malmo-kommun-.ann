  "segments": [
    {
      "forarbete_id": "a6.1",
      "sentiment": 0.5,
      "quote": "En anledning är att det har uppstått missuppfattningar mellan exempelvis kompensatoriska stödinsatser för att motverka funktionsnedsättningars konsekvenser (oftast inom ramen för ledning och stimulans) och extra anpassningar som syftar till att eleven inte ska riskera att inte uppfylla målen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": 0.8,
      "quote": "Dagens obligatoriska bedömningsstöd är utmanande för skolorna att använda sig av då regelverket är krångligt och begreppsförvirring råder.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": 0.5,
      "quote": "Att ge specialpedagogen uppdrag att finnas med i undervisningen kan leda till att specialpedagogers kompetens inte används enligt professionens uppdrag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": -0.2,
      "quote": "Kommunen bedömer att det är av vikt att ta hänsyn till det merarbete som detta kommer att medföra för elever och personal.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5",
      "sentiment": -0.5,
      "quote": "Elever i särskiljande stödåtgärder uttrycker ofta känslor av stigmatisering, utanförskap, låg motivation att lära och sämre självkänsla.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6",
      "sentiment": -0.2,
      "quote": "Ur gymnasieskolans perspektiv ställer sig Malmö stad tveksam till förslaget eftersom gymnasieskolan har färre åtgärder att sätta in inom ramen för särskilt stöd än vad grundskolan har.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7",
      "sentiment": 0.8,
      "quote": "Malmö stad ställer sig positiv till förslaget.",
