  "overall": {
    "sentiment": -0.4,
    "quote": "SPSM anser dock att flera av utredningens förslag är svagt underbyggda och konsekvenserna dåligt utredda.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a6.1",
      "sentiment": 0.2,
      "quote": "Det finns en risk att denna positiva utveckling avstannar om regleringen av extra anpassningar försvinner och det samtidigt saknas andra incitament för att utveckla undervisningen i klassrummet i en inkluderande riktning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": -0.2,
      "quote": "SPSM anser samtidigt att utredningen inte tillräckligt utrett konsekvenserna av att avskaffa garantin, i synnerhet inte i den anpassade grundskolan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": 0.2,
      "quote": "SPSM:s bild är att det som i dag många gånger saknas för att ge elever ändamålsenliga stödinsatser är resurser, kompetens och en ändamålsenlig organisering av stödet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": 0.0,
      "quote": "SPSM anser dock att utredningen dels inte grundligt utrett förutsättningarna för att ta fram denna typ av standardiserade tester, dels inte analyserat konsekvenserna tillräckligt i förhållande till att avskaffa garantin för tidiga stödinsatser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5",
      "sentiment": -1.0,
      "quote": "En stor risk, som SPSM ser det, är därför att arbetet med att organisera och bemanna stödundervisningen kommer ske på bekostnad av att utveckla utbildningens tillgänglighet i sin helhet, stödet inom ramen för ledning och stimulans i undervisningen och insatser inom ramen för särskilt stöd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.2",
      "sentiment": 0.5,
      "quote": "Myndigheten är dock tveksam till om förslaget kommer realisera ambitionen, då bristande resurser och övriga förslag, såsom stödundervisning, riskerar att fördröja utredningar på samma sätt som skett med extra anpassningar i dag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.4",
      "sentiment": 1.0,
      "quote": "Dessa kompetenser kan bidra i kartläggning och utredning av elevs stödbehov utifrån specialpedagogisk kompetens, vilket är viktigt för att ändamålsenligt stöd ska sättas in.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.5",
      "sentiment": -0.5,
      "quote": "SPSM menar att nuvarande skrivning är nödvändig för att elever ska tillförsäkras en inkluderande utbildning, vilket är en rättighet enligt såväl FN:s konvention om barnets rättigheter (barnkonventionen) som FN:s konvention om rättigheter för personer med funktionsnedsättning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7",
      "sentiment": -0.5,
      "quote": "SPSM ser en risk för att borttagande av den tröskel som finns i dag, genom särskilda skäl för nu aktuella åtgärder, och genom att skolan är skyldig att i första hand erbjuda stöd inom elevens ordinarie undervisningsgrupp riskerar leda till att fler elever placeras i särskiljande lösningar, utan att i första hand tillgängliggöra och anpassa lärmiljön och erbjuda stöd inom elevens ordinarie sammanhang.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8",
      "sentiment": 1.0,
      "quote": "SPSM delar utredningens slutsats i denna del, men vill samtidigt lyfta att det finns situationer då anpassad studiegång kan vara en lämplig åtgärd utan att andra åtgärder först testats, exempelvis om en elev inte klarar av att vara i skolan hela dagar på grund av medicinskt tillstånd eller annat hälsoskäl.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5.2",
      "sentiment": -0.2,
      "quote": "SPSM delar utredningens slutsats att stödundervisning kommer att innebära ökade kostnader för SPSM, men är tveksam till de antaganden som görs avseende bland annat bedömningen av andelen elever med behov av stödundervisning, mot bakgrund av specialskolornas särskilda förutsättningar.",
      "quote_type": "grund"
    }
  ]
