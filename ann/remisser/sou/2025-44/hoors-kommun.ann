    },
    {
      "forarbete_id": "a6.8",
      "sentiment": 1.0,
      "quote": "Höörs kommun tillstyrker förslaget att beslut om anpassad studiegång fattas först om elevens behov inte kunnat tillgodoses genom andra former av särskilt stöd.",
