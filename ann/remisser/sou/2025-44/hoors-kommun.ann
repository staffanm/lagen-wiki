  "overall": {
    "sentiment": 0.2,
    "quote": "Höörs kommun anser att utredningen om en förbättrad elevhälsa i flera delar kan leda till positiva förändringar och därmed ställer sig kommunen positiv till delar av utredningen, men har synpunkter på enskilda delar av förslaget.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a6.1",
      "sentiment": 0.5,
      "quote": "Höörs kommun vill dock betona vikten av att det behöver tydliggöras hur ledning och stimulans ska utformas i den ordinarie undervisningen för att möta alla elever och för att minimera antalet elever som är i behov av den föreslagna stödundervisningen eller särskilt stöd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": 1.0,
      "quote": "Höörs kommun tillstyrker förslaget att nationella prov i årskurs 3 i grundskolan och sameskolan, respektive årskurs 4 i specialskolan avskaffas.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": 0.5,
      "quote": "Om detta inte förtydligas kan det finnas en risk för ett mer kategoriskt synsätt på elevers lärande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": 1.0,
      "quote": "Höörs kommun tillstyrker förslaget om att standardiserade tester införs för att uppmärksamma elever med stödbehov.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.5",
      "sentiment": -0.2,
      "quote": "Höörs kommun ser att det kan vara bra att införa stödundervisning men ser vissa nackdelar med att det ska införas på det sätt som utredningen föreslår.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.13",
      "sentiment": -0.5,
      "quote": "Höörs kommun anser att det är ett för snävt urval av ämnen och vill peka på vikten av att gymnasieelever ska kunna få stödundervisning i andra ämnen också, åtminstone även i engelska, för att öka elevernas möjligheter att kunna fullfölja sin utbildning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6",
      "sentiment": 0.5,
      "quote": "Höörs kommun avstyrker denna skrivelse med motiveringen att varje skola bör få möjlighet att utarbeta egna rutiner avseende hur en anmälan ska göras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7.2",
      "sentiment": -0.5,
      "quote": "Motiveringen till detta är att utgångspunkten för bedömning av särskilt stöd alltid ska vara elevens behov vilka framgår av en utredning och att åtgärder ska vidtas utifrån behoven.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7.3",
      "sentiment": -0.5,
      "quote": "Motiveringen är att det i skollagen redan är framskrivet vem som får bedriva undervisning.",
