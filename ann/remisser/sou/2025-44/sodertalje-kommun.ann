  "overall": {
    "sentiment": 0.4,
    "quote": "Utbildningsnämnden ställer sig positiv till utredningens förslag att förenkla och förtydliga stödsystemet i skolan för att skapa mer skyndsamma, träffsäkra och flexibla stödinsatser för elever.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a6.1",
      "sentiment": 1.0,
      "quote": "Utbildningsnämnden tillstyrker avskaffandet av extra anpassningar, då mycket tid i skolan tycks ha ägnats åt att försöka definiera och särskilja de olika delarna ledning och stimulans, extra anpassningar och särskilt stöd för att ansvarsfördela stödinsatserna mellan olika professioner, vilket kan ha fördröjt nödvändigt stöd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": 1.0,
      "quote": "Garantin för tidiga stödinsatser och de nationella bedömningsstöden kopplade till garantin har av lärare uppfattats som omfattande att genomföra.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": 0.2,
      "quote": "Det finns en farhåga att detta uttryck kan förstås som att ”följa undervisningen” pekar på att en förskjutning i lärandebegreppet, mot att titta mer på elevens förmåga, snarare än elevens behov av stöd och lärarens ansvar att pröva och ompröva i sin undervisningspraktik för att nå fram till elever som är i behov av mer stöd i sitt lärande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": 0.5,
      "quote": "Nuvarande bedömningsstöd är grovmaskiga och har inte visat tillräcklig precision för att identifiera elever i behov av stöd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5",
      "sentiment": 0.5,
      "quote": "Möjligheten att ge ämnesspecifikt stöd i mindre grupp eller enskilt, under kortare tidsperioder, bedöms bidra till ökad flexibilitet och snabbare insatser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.3",
      "sentiment": 0.2,
      "quote": "Utbildningsnämnden efterfrågar därför att utredningen föreslår att beslut om stödundervisning ska ske i samråd med speciallärare/specialpedagog.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6",
      "sentiment": -0.5,
      "quote": "Utbildningsnämnden avstyrker dock att övriga elevhälsoprofessioner inte ges en uttalad roll i beslut om särskild undervisningsgrupp eller enskild undervisning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7",
      "sentiment": -0.5,
      "quote": "Utbildningsnämnden avstyrker dock avsaknaden av den samlade elevhälsans resurser vad gäller elevs placering i särskild undervisningsgrupp.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8",
      "sentiment": 0.2,
      "quote": "Risker kan finnas att en elev behöver misslyckas flera gånger innan verkningsfulla åtgärder kan sättas in.",
