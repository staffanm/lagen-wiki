  "overall": {
    "sentiment": 0.5,
    "quote": "Stadsledningskontoret ser positivt på förslagen som bland annat föreslår att slopa ”extra anpassningar” och ”garantin för tidiga stödinsatser” samt införande av nationella standardiserade tester men ser behov av tydliggörande avseende när och hur stödundervisningen ska sättas in.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a6.1",
      "sentiment": 0.8,
      "quote": "Jag ser positivt på utredningens förslag om att avskaffa stöd i form av extra anpassningar eftersom det har saknats en tydlig definition av begreppet samt en osäkerhet kring gränsdragningen mellan extra anpassningar och särskilt stöd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": 1.0,
      "quote": "Det är även rimligt att avskaffa garantin för tidiga stödinsatser då den inte fullt ut uppfyllt sitt syfte utan lett till tidskrävande merarbete.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": 0.8,
      "quote": "En stärkt uppföljning bidrar till att synliggöra utvecklingsområden i undervisningen och kan utgöra ett viktigt underlag för det systematiska kvalitetsarbetet på såväl skol- som huvudmannanivå.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5",
      "sentiment": -0.5,
      "quote": "Hur stödundervisningen innehållsmässigt ska utformas, hur beslut om stödundervisning fattas och vilket professionellt stöd som rektor har i dessa bedömningar samt hur stödundervisningen ska utvärderas och avgränsas i tid är bara några av de frågor som är nödvändiga att reda ut för att faktiskt kunna uppnå ambitionen om ett förbättrat stöd i skolan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5.1",
      "sentiment": -0.5,
      "quote": "Sammantaget bedömer stadsledningskontoret att skolornas extra kostnader kan bli 30 till 50 procent högre än utredningens beräkningar, beroende på stödundervisningens utformning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6",
      "sentiment": 0.8,
      "quote": "Stadsledningskontoret ser övergripande positivt på förslaget att elever ska få särskilt stöd utan onödiga hinder och fördröjning och att det inte ska finnas krav på att annat stöd ska ha getts innan en utredning om särskilt stöd ska inledas, då detta bedöms stärka möjligheten att anpassa stödet efter elevens faktiska behov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7",
      "sentiment": 0.5,
      "quote": "Stadsledningskontoret stödjer förslaget att elevens stödbehov ska styra om en elev ska ges undervisning enskilt eller i en särskild undervisningsgrupp om andra alternativ inte är möjliga utifrån barnets bästa.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7.2",
      "sentiment": -1.0,
      "quote": "Samtidigt motsätter sig stadsledningskontoret förslaget att det inte behöver finnas särskilda skäl för att fatta beslut om enskild undervisning eller undervisning i särskild undervisningsgrupp, då det kan leda till rättsosäker hantering av enskilda elever och en oönskad normalisering av att placera elever utanför den ordinarie gruppen, vilket i sin tur riskerar att underminera skolans inkluderande uppdrag.",
