  },
  "segments": [
    {
      "forarbete_id": "a6.4",
      "sentiment": 0.8,
      "quote": "Det kan bidra till både mer rättvis bedömning och snabbare insatser, vilket är särskilt viktigt för elever med funktionsnedsättning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5",
      "sentiment": 0.8,
      "quote": "Att den kan ges snabbt, individuellt och utan krav på tidigare insatser eller diagnos är särskilt betydelsefullt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7.2",
      "sentiment": 0.8,
      "quote": "För vissa elever med exempelvis neuropsykiatriska funktionsnedsättningar kan enskild undervisning under en period vara mer lämplig, om de påverkas negativt av stora grupper eller många intryck.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.10",
      "sentiment": 0.8,
      "quote": "Det minskar risken för att elever hamnar i separerande åtgärder över längre tid, vilket påverkar inkludering i kamratgrupper och skolans sociala sammanhang.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8",
      "sentiment": 0.8,
      "quote": "Det ska stärka elevens rätt till inflytande, vilket är särskilt viktigt eftersom insatsen kan begränsa framtida utbildnings- och yrkesmöjligheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.14",
      "sentiment": 0.5,
      "quote": "Stödinsatserna behöver följas upp av de enskilda skolhuvudmännen för att kunna se att eleverna klarar målen och för att kunna följa och utvärdera om insatserna är träffsäkra.",
      "quote_type": "grund"
    }
