  "segments": [
    {
      "forarbete_id": "a6.1",
      "sentiment": -0.5,
      "quote": "NSPH stöttar utredningens ambition att se till att rätt stöd sätts in snabbt när behov uppstår hos elever, men avstyrker förslaget om att ta bort formuleringen om extra anpassningar då vi inte ser att skolorna i dagsläget har förutsättningar för att ge detta stöd inom ramen för ledning och stimulans.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": -0.5,
      "quote": "Funktionshindersrörelsen har drivit frågan om en garanti för tidiga stödinsatser hårt för att barn och elever med funktionsnedsättningar ska få en fungerande skolgång, och NSPH avstyrker att denna ska avskaffas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": 0.2,
      "quote": "Ansvaret för sådana kompetenshöjningar läggs dock i detta förslag på skolhuvudmännen, vilket vi ser riskerar bidra till fortsatt ojämlikhet på området.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": -0.2,
      "quote": "Dels kan själva provsituationen upplevas så pass utmanande för elever med exempelvis ångesttillstånd eller neuropsykiatriska diagnoser att resultaten inte kommer att spegla elevens faktiska kunskaper.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5",
      "sentiment": 0.2,
      "quote": "Vi ser samtidigt en risk med att det kan leda till att “jobbiga” elever placeras i ett eget rum, avskilt från övriga klasskamrater och utan tillgång till behöriga lärare eller en undervisning som håller en hög kvalité.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6",
      "sentiment": 0.8,
      "quote": "Många lärare har inte den kompetens som krävs, och det blir då viktigt att rätt specialistkompetens säkras för att göra adekvata bedömningar i de fall mer omfattande stöd behövs.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7",
      "sentiment": 0.2,
      "quote": "vi ser en risk att det under den ansträngda situation som många skolor har kan bli så att elever som till följd av en funktionsnedsättning har ett utmanande beteende placeras avskilt från sina övriga klasskamrater.",
