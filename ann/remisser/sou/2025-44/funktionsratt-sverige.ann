  "overall": {
    "sentiment": -0.6,
    "quote": "Förslagen pekar mot en alltmer segregerad skola där barn och elever som inte faller inom en allt snävare norm riskerar att exkluderas från ordinarie undervisning, och i förlängningen riskerar att exkluderas från arbetsmarknad och vuxenstudier med risk för ett livslångt utanförskap som följd.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a6.1",
      "sentiment": -0.5,
      "quote": "Vi delar bilden att extra anpassningar inte fungerat som det var tänkt men vi anser inte att lösningen är att försämra lagstiftningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": -0.5,
      "quote": "Med de skrivningar som nu föreslås skulle det i praktiken innebära att elever som har sådana behov inte längre alls ska kunna delta i den ordinarie undervisningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": -0.5,
      "quote": "Det måste fortsatt vara tydligt i skollagen att skolan måste sätta in tidiga insatser – ett krav som funktionsrättsrörelsen länge drivit för att fler barn och elever med funktionsnedsättning ska klara sin skolgång.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": -0.5,
      "quote": "Det känns som ett resursslöseri att slänga garantin i papperskorgen och ta fram något helt nytt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5",
      "sentiment": 0.2,
      "quote": "Barn och elever med funktionsnedsättning behöver generellt kontinuerligt stöd, och kan till exempel behöva längre tid, vilket förslaget om stödundervisning inte kommer att erbjuda.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6",
      "sentiment": -0.5,
      "quote": "I den skola som nu föreslås kommer allt färre barn och elever med funktionsnedsättning kunna delta i den ordinarie undervisningen, eftersom förändringen innebär att särskilt stöd alltid ska ges utanför den ordinarie undervisningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7",
      "sentiment": -0.5,
      "quote": "Det här rimmar illa med tanken om en inkluderande skola för alla.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8",
