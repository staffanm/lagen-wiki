  "overall": {
    "sentiment": 0.5,
    "quote": "Uppsala universitet tillstyrker i huvudsak utredningens förslag då de kan underlätta för elever att få snabbare och mer flexibelt stöd som motsvarar deras behov, men vill anföra följande.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a6.1",
      "sentiment": 1.0,
      "quote": "Universitetet instämmer i att a) dessa bestämmelser har lett till oklarhet om var gränsen mellan extra anpassningar och särskilt stöd går, b) kravet att extra anpassningar ska föregå särskilt stöd har riskerat att försena stödinsatser och c) bestämmelserna ibland har tolkats på sätt som leder till för höga förväntningar på att undervisningen ska individanpassas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": 1.0,
      "quote": "Universitetet instämmer i att både de nationella bedömningsstöden i årskurs F och 1 och de nationella proven i årskurs 3 har tagit för mycket av undervisningstiden i anspråk samtidigt som de inte har varit tillräckligt träffsäkra för att identifiera elever i behov av stöd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": 0.0,
      "quote": "Uppsala universitet avstyrker däremot förslaget att sådan personalförstärkning inte ska kräva dokumentation mot bakgrund av att personalförstärkning är en resursfråga som kräver direkt eller indirekt beslut av rektor.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": 0.5,
      "quote": "Forskningen är entydig om att stödinsatser som sätts in tidigt i elevers skolgång ger större effekt än stödinsatser som sätts in senare under skolgången.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.1",
      "sentiment": 1.0,
      "quote": "En sådan avgränsning förenklar konstruktionen av tidseffektiva och träffsäkra tester.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.3",
      "sentiment": -0.2,
      "quote": "Uppsala universitet föreslår att testerna som huvudregel bör utformas för att kunna genomföras i helklass, då tester som kräver individuellt genomförande är tidskrävande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.4",
      "sentiment": 1.0,
      "quote": "Uppsala universitet tillstyrker att Skolverket får i uppdrag att utforma de standardiserade testerna eftersom det är en uppgift som faller inom ramen för Skolverkets instruktion.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5",
      "sentiment": 0.5,
      "quote": "Med tanke på att stödundervisningen ska vara en insats av mindre ingripande karaktär föreslår Uppsala universitet att stödundervisningen sammantaget inte får omfatta mer än 5 timmar per vecka.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.2",
      "sentiment": -0.5,
      "quote": "Uppsala universitet avstyrker formuleringen som föreslås som villkor för att stödundervisning ska ges eftersom den är svår att tolka: att en elev riskerar att 1) ”inte kunna följa undervisningen” och 2) ”har svårt att tillgodogöra sig kunskaper i förhållande till ämnets syfte och centrala innehåll”.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.3",
      "sentiment": 1.0,
      "quote": "Uppsala universitet tillstyrker att beslut om stödundervisning inte ska kunna överklagas mot bakgrund av att det är en kortvarig insats som är av mindre ingripande karaktär.",
      "quote_type": "grund"
    },
    {
