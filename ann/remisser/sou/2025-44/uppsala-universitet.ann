    {
      "forarbete_id": "a6.5.13",
      "sentiment": 1.0,
      "quote": "Uppsala universitet tillstyrker förslaget att stödundervisning ska införas i samtliga ämnen i grundskolan, anpassade grundskolan, sameskolan samt specialskolan.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.5.14",
      "sentiment": 0.5,
      "quote": "Mot bakgrund av att tidigare regleringar i området, såsom införandet av extra anpassningar, ofta har lett till oönskade konsekvenser kan man befara att sådant kan ske även i detta fall.",
