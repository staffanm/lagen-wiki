  "segments": [
    {
      "forarbete_id": "a6.1",
      "sentiment": 0.5,
      "quote": "I praktiken har dock begreppet ofta blivit föremål för missförstånd och en oproportionerlig administrativ belastning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": 0.5,
      "quote": "I stället för att säkra snabb hjälp till elever i behov har garantin i praktiken bidragit till ökad administration och fokus på formell kartläggning snarare än på att sätta in insatser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": 0.2,
      "quote": "Förutsättningarna för ledning och stimulans av individer är tätt förbundet med elevbehov och gruppstorlekar, varför Sveriges Lärare anser att regeringen bör låta utreda frågan om gruppstorlekar i skolan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": 0.5,
      "quote": "Det är dock avgörande att testerna inte används mekaniskt eller leder till ökad stress för elever och lärare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5",
      "sentiment": 0.2,
      "quote": "Om inte fler lärare, lokaler eller elevhälsoprofessioner tillkommer riskerar förslaget att belasta ett redan ansträngt system, eller att löften om snabb hjälp till elever inte infrias.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6",
      "sentiment": 0.2,
      "quote": "vi avråder från att använda begreppet ”anmälan” då det ger en juridisk tyngd som riskerar att skapa en formaliserad process och öka dokumentationsbördan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7",
      "sentiment": -0.2,
      "quote": "Den kan leda till ökad marginalisering, särskilt om den blir långvarig eller genomförs utan god planering för återgång till ordinarie undervisning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8",
      "sentiment": 1.0,
      "quote": "Anpassad studiegång är en mycket ingripande insats med långtgående konsekvenser för elevens fortsatta utbildningsvägar och framtida möjligheter.",
