  "segments": [
    {
      "forarbete_id": "a6.1",
      "sentiment": 1.0,
      "quote": "SKR delar utredningens bedömning att det nu är möjligt med denna förändring eftersom skolors förmåga att brett anpassa undervisningen utifrån elevers olika behov, så kallad universell design, har blivit allt vanligare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": 1.0,
      "quote": "SKR delar utredningen bedömning att de nationella kartläggningsmaterialen och bedömningsstöden är onödigt tidskrävande och inte tillräckligt träffsäkra.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": 0.5,
      "quote": "SKR poängterar att undervisningen behöver utformas utifrån olika elevers behov där stödstrukturerna inte enbart fokuserar på elever som till följd av en funktionsnedsättning har svårt att tillgodogöra sig kunskaper.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": 0.5,
      "quote": "Den här typen av tester behöver därför noga prövas genom försöksverksamhet innan de implementeras brett.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5",
      "sentiment": -0.5,
      "quote": "SKR menar att regleringens utformning kan medföra förändringar i rektors möjligheter att planera och styra verksamheten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6",
      "sentiment": 0.5,
      "quote": "Det särskilda stödet behöver utgå från elevens behov, inte från stödets organisatoriska form.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7",
      "sentiment": -1.0,
      "quote": "Eftersom en längre placering i en särskild undervisningsgrupp är ett stort ingrepp i ett barns liv, är det av stor vikt att beslut om särskilt stöd i en annan undervisningsgrupp än den eleven tillhör fattas med stor försiktighet, då det kan leda till konsekvenser längre fram.",
      "quote_type": "grund"
