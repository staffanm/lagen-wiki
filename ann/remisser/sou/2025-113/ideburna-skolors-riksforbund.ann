  "overall": {
    "sentiment": 0.2,
    "quote": "ISR ställer sig bakom stora delar av förslagen om att förstärka elevhälsan under förutsättning: • att det kan organiseras på ett flexibelt sätt, • att det finns en garanterad finansiering, samt • att det utreds vidare hur kommunerna som hemkommuner (inkluderande också de enskilda huvudmännen) kan få ansvaret för organisation och administration när det gäller den utökade elevhälsan.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a6.1",
      "sentiment": 1.0,
      "quote": "som syftar till att förtydliga och bredda elevhälsans syfte och uppdrag",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": 1.0,
      "quote": "som innebär att tillgången till elevhälsans professioner ska stärkas",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": 1.0,
      "quote": "som innebär att skolhuvudmannen årligen ska informera om elevhälsans uppdrag och bemanning, (Skoll 2 kap. 25 d §)",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.5",
      "sentiment": 1.0,
      "quote": "som innebär att det även fortsättningsvis ska vara möjligt att anordna elevhälsa för elever i kommunal vuxenutbildning, (Skoll 2 kap. 26 §)",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.6",
      "sentiment": 1.0,
      "quote": "om utökade hälsobesök och hälsosamtal",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.7",
      "sentiment": 1.0,
      "quote": "följt av förslag om förstärkta möjligheter för insatser för lättare fysiska och psykiska vårdbehov, (Skoll 2 kap. 27 - 27 a §§)",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.8",
      "sentiment": 1.0,
      "quote": "om förbättrad samverkan mellan elevhälsan, skolan i övrigt, hälso- och sjuk-vården och socialtjänsten, (Utredningen kap. 5.8)",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.8.2",
      "sentiment": 1.0,
      "quote": "om att det vid varje skolenhet ska finnas en samordnande funktion som ansvarar för att samordna insatser, (Skoll 2 kap. 28 b §)",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.9",
      "sentiment": 1.0,
      "quote": "om att flytta skollagens skrivningar om elevhälsans del i skolans kvalitetsarbete till bestämmelsen om skolans kvalitetsarbete i övrigt i skollagen 4 kap. 4 §.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.8.3",
      "sentiment": -1.0,
      "quote": "I stället ska kommunen ingå samverkansavtal med regionen som omfattar såväl kommunala skolor som enskilda huvudmän.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": -1.0,
      "quote": "Om det förslaget genomförs skulle det innebära en ensidig och alltför dominant inriktning mot en medicinsk syn på elevers skolproblematik där den sociala aspekten starkt försvagas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.1",
      "sentiment": -1.0,
      "quote": "Konsekvenserna för små skolhuvudmän kan bli orimliga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.2",
      "sentiment": -1.0,
      "quote": "Konsekvenserna för små skolhuvudmän kan bli orimliga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.3",
      "sentiment": -1.0,
      "quote": "Konsekvenserna för små skolhuvudmän kan bli orimliga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.10.5",
      "sentiment": -1.0,
      "quote": "Utredningens förslag är alltför långtgående och innebär i förlängningen en omvandling av skolan till en vårdgivande organisation.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.12",
      "sentiment": -1.0,
      "quote": "Någon analys i ordets rätta bemärkelse finns dock inte i utredningen, varken med avseende på det interna samarbetet i skolan inom elevhälsan eller externt, gentemot till exempel hälso- och sjukvården.",
      "quote_type": "grund"
    }
  ]
