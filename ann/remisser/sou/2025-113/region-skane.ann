    {
      "forarbete_id": "a6.11",
      "sentiment": 1.0,
      "quote": "Regionen bedömer att nationell uppföljning är viktig för att säkerställa likvärdighet, kvalitet och ett stärkt kunskapsunderlag för utveckling av elevhälsan, inklusive samverkan med hälso- och sjukvården.",
      "quote_type": "grund"
