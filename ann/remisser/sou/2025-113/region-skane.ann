  "segments": [
    {
      "forarbete_id": "a6.1",
      "sentiment": 0.5,
      "quote": "Region Skåne bedömer samtidigt att förslaget kan medföra ökad efterfrågan på medicinska bedömningar, konsultation och samverkan med regionens hälso- och sjukvård.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": 0.2,
      "quote": "Region Skåne vill samtidigt understryka att hälso- och sjukvårdskuratorer inte har formell kompetens att göra diagnostiska bedömningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.1",
      "sentiment": 1.0,
      "quote": "Region Skåne bedömer att föreslagna bemanningsplaner kan bidra till en mer tillgänglig, likvärdig och ändamålsenlig elevhälsa, samt förbättra förutsättningarna för samverkan med hälso- och sjukvården.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.2",
      "sentiment": 0.2,
      "quote": "Region Skåne anser att begreppet tillgänglighet behöver förtydligas, särskilt i relation till hur kontakt och samverkan med regionens hälsooch sjukvård ska ske.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.3",
      "sentiment": -0.2,
      "quote": "Utan sådan tydlighet finns risk för otydlighet i ansvarsfördelning och parallella vårdvägar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6",
      "sentiment": 0.5,
      "quote": "Region Skåne ser positivt på att hälsobesöken och hälsosamtalen förstärks och förtydligas, då detta kan bidra till tidigare identifiering av ohälsa och därmed skapa bättre förutsättningar för samverkan med regionens hälso- och sjukvård.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.3",
      "sentiment": 1.0,
      "quote": "Regionen anser att en enhetlig enkät skulle kunna skapa förutsättningar för uppföljning, analys och kunskapsutveckling på nationell, regional och lokal nivå avseende barns och ungas hälsa.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7",
      "sentiment": -0.5,
      "quote": "Införandet av nya eller otydligt definierade begrepp, såsom “lättare psykiska vårdbehov”, riskerar annars att skapa otydlighet i ansvarsfördelningen och försvåra samverkan mellan elevhälsan och hälso- och sjukvården.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8.1",
      "sentiment": 0.5,
      "quote": "Region Skåne bedömer samtidigt att förslagen förutsätter en tydlig ansvarsfördelning och en ändamålsenlig avgränsning mellan elevhälsans uppdrag och regionens hälso- och sjukvård, för att undvika otydlighet i ansvar, parallella arbetssätt och risk för att barn och unga faller mellan olika aktörer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8.2",
      "sentiment": 0.5,
      "quote": "Det behöver särskilt klargöras att funktionen har ett samordnande, och inte ett operativt, ansvar för insatser från olika aktörer, för att undvika otydlighet i ansvarsfördelningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8.3",
      "sentiment": 0.2,
      "quote": "Region Skåne ser en utmaning i att ett stort antal samverkansöverenskommelser kan behöva tecknas mellan regionen och många kommunala och enskilda skolhuvudmän, vilket riskerar att leda till ojämlika arbetssätt och tillämpning inom regionen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.10",
      "sentiment": 0.0,
      "quote": "Regionen bedömer samtidigt att det kan finnas skäl att vidare analysera huvudmannaskapet för elevhälsans medicinska insats, som utgör hälso- och sjukvård och därmed omfattas av hälso- och sjukvårdslagstiftningens krav på kvalitet och patientsäkerhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.10.5",
      "sentiment": 0.5,
      "quote": "Region Skåne vill samtidigt framhålla att behovet av sådana stödinsatser illustrerar de utmaningar som följer av att hälso- och sjukvårdsverksamhet bedrivs under skolhuvudmannens ansvar.",
      "quote_type": "grund"
