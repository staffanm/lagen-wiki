  "overall": {
    "sentiment": 0.2,
    "quote": "Sveriges Elevkårer och Sveriges Elevråd välkomnar utredningens förslag och delar betänkandets grundläggande problembild.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a6.1",
      "sentiment": 1.0,
      "quote": "Sveriges Elevkårer och Sveriges Elevråd tillstyrker förslaget och delar utredningens bedömning om att elevhälsans syfte och uppdrag i nuläget inte är tillräckligt tydligt formulerat i skollagen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": -0.5,
      "quote": "Det bör samtidigt övervägas ifall hälso- och sjukvårdskurator är det mest ändamålsenliga utbildningskravet, då deras nuvarande roll syftar till att bidra med psykosocialt stöd till patienter och närstående inom hälso- och sjukvården.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.1",
      "sentiment": 1.0,
      "quote": "Vi instämmer här i betänkandets problembild avseende dagens bristande likvärdighet i tillgången till elevhälsans professioner och menar att den föreslagna strukturen med bemanningsplaner är behövlig för att åtgärda problemet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.2",
      "sentiment": 0.2,
      "quote": "Vi menar att strukturen med bemanningsplaner som föreslås i 6.3.1 kommer ha reell effekt för elevers tillgång till elevhälsans insatser, medan de skollagsändringar som föreslås härvid går att möta upp utan att effekten nödvändigtvis blir märkbar för skolans elever.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.3",
      "sentiment": -0.2,
      "quote": "Utredningen gör bedömningen att sju dagar är en rimlig tid för elever att få en första bedömning, där vi ser risker för att en sådan ordning försvårar en ändamålsenlig styrning av elevhälsan enligt det syfte och uppdrag som ges av utredningens 6.1.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": 1.0,
      "quote": "När elever inte har kännedom om elevhälsans verksamhet finns det stor risk att eleverna inte själv tar kontakt för stöd och hjälp, vilket försvårar förutsättningarna för att fånga upp behov i ett tidigt skede och förebygga mer omfattande åtgärder.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6",
      "sentiment": 0.2,
      "quote": "Det är vår bild att vårdnadshavares medverkan vid stora hälsobesök under grundskolans senare årskurser gör missförhållanden i hemmet svårare att upptäcka.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.3",
      "sentiment": 1.0,
      "quote": "Vi ser mycket positivt på att en nationellt framtagen hälsoenkät ska ligga till grund för hälsobesök i syfte att stärka den nationella likvärdigheten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7",
      "sentiment": 0.2,
      "quote": "Vi ser med utredningens förslag även risken att det uppfattas som att elevhälsan blir den aktör som huvudsakligen ska tillgodose elevers vårdbehov, vilket kan leda till att elever inte söker sig till den regionala hälso- och sjukvården i lika stor utsträckning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8.2",
      "sentiment": 1.0,
      "quote": "Det finns därmed ett behov av en tydlig samordnande funktion som håller ihop insatser kring en elev, speciellt när insatserna ägs av olika organ.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8.3",
      "sentiment": 1.0,
      "quote": "Sveriges Elevkårer och Sveriges Elevråd ser betänkandets förslag om samverkansöverenskommelser under 6.8.3 som mycket positivt, mot bakgrund av tidigare rapporter från bland annat Inspektionen för vård och omsorg (IVO) om bristande praktiska rutiner för samverkan mellan huvudman, i förlängningen elevhälsa, och vårdgivare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.10.5",
      "sentiment": 0.5,
      "quote": "Fortbildningen för rektorer om elevhälsans medicinska insatser har varit den mest sökta under flera år, av vilket det går att dra slutsatsen att rektorer redan i nuläget behöver ytterligare kunskap kring sådant som berör elevhälsans medicinska insatser",
      "quote_type": "grund"
    }
  ]
}