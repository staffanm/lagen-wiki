  "overall": {
    "sentiment": 0.2,
    "quote": "Sammantaget bedömer RFS att utredningen innehåller flera viktiga steg mot en mer likvärdig och kunskapsbaserad elevhälsa, men att förslagen behöver kompletteras med tydligare ansvarsfördelning, nationell styrning, realistiska resursförstärkningar och stärkt professionell kompetens för att kunna genomföras på ett hållbart och patientsäkert sätt.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a1.1",
      "sentiment": 0.5,
      "quote": "RFS tillstyrker förslaget om lagändring 25 §1 och 25 a § med undantag för skrivningen “hälso- och sjukvårdskurator\".",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.1",
      "sentiment": 0.2,
      "quote": "RFS vill dock lyfta att ändringen av författningen även kan innebära risker i form av årliga förändringar, otydligt ansvar och risk för bristande kontinuitet och likvärdighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.1",
      "sentiment": -0.5,
      "quote": "RFS avstyrker förslaget om lagändring enligt 25 c § då skrivningen innehåller text om hälsooch sjukvårdskurator.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.1",
      "sentiment": 1.0,
      "quote": "RFS tillstyrker förslagen till lagändring avseende 25 d § samt 26 §",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a1.1",
      "sentiment": -0.5,
      "quote": "Vi anser att det vore problematiskt att skriva vårdbehov då det med den skrivningen förskjuter elevhälsans uppdrag i medicinsk riktning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.1",
      "sentiment": -1.0,
      "quote": "RFS avstyrker förslaget till lagändring enligt 28 a §.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a1.1",
      "sentiment": 0.5,
      "quote": "RFS tillstyrker förslaget till lagändring enligt 28 c § endast om punkten d tas bort",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.2",
      "sentiment": 1.0,
      "quote": "RFS tillstyrker förslaget till lagändring i 7 kap. 10 §",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a5.2.2",
      "sentiment": 1.0,
      "quote": "RFS instämmer i utredningens bedömning att elevers hälsa påverkas starkt av skoltrivsel, skolstress och lärmiljö.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a5.3.1",
      "sentiment": -0.5,
      "quote": "RFS anser att det är viktigt att tydliggöra gränsdragningen för EMI:s uppdrag för att undvika en successiv utvidgning av ansvar som riskerar att tränga undan kärnuppdraget, det vill säga hälsobesök, vaccinationer, medicinska bedömningar samt det långsiktiga hälsofrämjande och förebyggande arbetet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.3.6",
      "sentiment": 0.2,
      "quote": "RFS vill också understryka att ansvar för egenvård inte kan läggas på skolsköterskan, då detta inte ingår i uppdraget enligt gällande regelverk.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.4.1",
      "sentiment": 0.0,
      "quote": "RFS anser att frågor om framtida yrkesval och praktik bör lyftas tidigare än vad utredningen föreslår, samt att det finns otydligheter kring ansvar vid medicinska kontroller kopplade till arbetsmiljörisker inom gymnasiala yrkesutbildningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.5.1",
      "sentiment": -0.2,
      "quote": "RFS vill uppmärksamma att stora geografiska skillnader i organisering och tillgång till skolläkare och skolpsykologer riskerar att påverka kontinuitet, patientsäkerhet och likvärdighet negativt, särskilt där insatser huvudsakligen bygger på upphandling/köp av tjänster.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.5.3",
      "sentiment": 0.5,
      "quote": "RFS vill särskilt lyfta vikten av att vårdgivare fullgör sin skyldighet att anmäla hälso- och sjukvårdsverksamhet till IVO enligt patientsäkerhetslagen, då det finns indikationer på att detta inte alltid sker.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.5.5",
      "sentiment": -0.2,
      "quote": "Rektor kan inte fatta beslut om vård, diagnostik eller behandling, vilket är avgörande att tydliggöra ur ett patientsäkerhetsperspektiv.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.5.6",
      "sentiment": 0.5,
      "quote": "RFS ser därför behov av en nationell inspektionsfunktion med medicinsk, psykologisk och social kompetens som regelbundet granskar elevhälsans kvalitet, tillgänglighet och resultat.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.7.1",
      "sentiment": -0.2,
      "quote": "RFS vill därför understryka att specialistutbildning är en förutsättning för att möta de krav som ställs i skolsköterskans uppdrag, som innefattar ett självständigt medicinskt ansvar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.8.4",
      "sentiment": -0.2,
      "quote": "RFS vill även understryka vikten av förbättrad återkoppling efter utredningar inom BUP, då tydlig återkoppling och kunskapsöverföring är avgörande för att skolan ska kunna ge rätt stöd till eleven.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1",
      "sentiment": 1.0,
      "quote": "RFS tillstyrker förslaget.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.1.1",
      "sentiment": 0.5,
      "quote": "Särskilt behöver begreppet “vård” och gränsdragningen mellan skolans och regionens ansvar förtydligas för att undvika otydlighet och fördröjt stöd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1.2",
      "sentiment": -0.5,
      "quote": "En övergång till hälso- och sjukvårdskuratorer riskerar att förskjuta uppdraget mot hälso- och sjukvård, vilket inte är skolans uppdrag, samt medföra ökade sekretessgränser som kan försvåra den dagliga samverkan med pedagogisk personal, vilket är en central förutsättning för ett fungerande elevhälsoarbete.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1.3",
      "sentiment": 1.0,
      "quote": "RFS ställer sig bakom förslaget att elevhälsans arbete ska vara tvärprofessionellt och delar bedömningen att detta är en förutsättning för att uppnå uppdraget.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1.4",
      "sentiment": 1.0,
      "quote": "RFS delar utredningens bedömning att elevhälsans syfte och uppdrag behöver kompletteras med föreskrifter, samt stöd för implementering, för att säkerställa en mer likvärdig och kunskapsbaserad verksamhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": 0.2,
      "quote": "RFS tillstyrker delvis förslaget om skärpta utbildningskrav, då det bedöms stärka kvalitet och patientsäkerhet inom elevhälsan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": 1.0,
      "quote": "RFS instämmer i att elevhälsan idag är underdimensionerad och att nuvarande bestämmelser om bemanning är otydliga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.1",
      "sentiment": 0.5,
      "quote": "RFS tillstyrker delvis förslaget om en bemanningsplan för elevhälsan och välkomnar att rektor ges ansvar att ta fram en skriftlig plan baserad på behovsanalys.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.2",
      "sentiment": -0.5,
      "quote": "RFS avstyrker förslaget i dess nuvarande form, då det finns en risk att “tillgänglighet” tolkas som en lägstanivå som huvudmän anpassar sig till, snarare än utifrån elevers faktiska behov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.3",
      "sentiment": -1.0,
      "quote": "En tidsfrist riskerar i stället att leda till fler oplanerade besök, svårigheter att planera verksamheten och avbrott i exempelvis hälsobesök och vaccinationer, vilket kan påverka både kvalitet och patientsäkerhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": 1.0,
      "quote": "RFS tillstyrker förslaget utan vidare kommentarer.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.5",
      "sentiment": 1.0,
      "quote": "RFS tillstyrker förslaget att möjliggöra elevhälsa inom kommunal vuxenutbildning.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.6.1",
      "sentiment": 0.5,
      "quote": "RFS menar att ett stort hälsobesök i stället bör genomföras i årskurs 9 och ersätta det föreslagna hälsosamtalet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.2",
      "sentiment": -0.5,
      "quote": "RFS anser att de stora hälsobesöken bör genomföras i årskurs 1, 5 och 9 i stället för i årskurs 8, då detta bättre överensstämmer med barns kognitiva utveckling och pubertet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.3",
      "sentiment": 1.0,
      "quote": "RFS tillstyrker förslaget att en nationell hälsoenkät ska ligga till grund för de stora hälsobesöken, då detta kan bidra till ökad likvärdighet och kvalitet i genomförandet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7",
      "sentiment": 0.5,
      "quote": "RFS tillstyrker förslaget under förutsättning att begreppet ”lättare fysiska och psykiska vårdbehov” tydliggörs.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8.1",
      "sentiment": 0.5,
      "quote": "RFS instämmer i utredningens bedömning att samverkan mellan elevhälsan, skolan i övrigt, hälso- och sjukvården samt socialtjänsten behöver förbättras, och delar uppfattningen att flera parallella insatser krävs för att åstadkomma detta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8.2",
      "sentiment": 0.5,
      "quote": "RFS tillstyrker förslaget om en samordnande funktion i elevhälsan, då det finns en tydlig risk att elever med behov av insatser från flera aktörer inte får ett samordnat och ändamålsenligt stöd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8.3",
      "sentiment": 1.0,
      "quote": "RFS tillstyrker förslaget att skolhuvudmän ska ingå samverkansöverenskommelser med regionen.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.9",
      "sentiment": 1.0,
      "quote": "RFS tillstyrker förslaget och delar bedömningen att elevhälsans samtliga professioner ska ingå i det systematiska kvalitetsarbetet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.10",
      "sentiment": 1.0,
      "quote": "RFS delar utredningens bedömning att elevhälsans nuvarande huvudmannaskap är ändamålsenligt.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.10.1",
      "sentiment": 0.5,
      "quote": "RFS ser därför behov av ett tydligare medicinskt ledningsansvar, där verksamhetschef enligt hälso- och sjukvårdslagstiftningen ges ett tydligare mandat och ansvar för frågan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.10.5",
      "sentiment": 0.5,
      "quote": "Det finns en tydlig risk för sammanblandning mellan ansvar enligt skollagen och hälso- och sjukvårdslagstiftningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.11",
      "sentiment": 1.0,
      "quote": "RFS tillstyrker förslaget.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.12",
      "sentiment": 1.0,
      "quote": "RFS delar utredningens bedömning att förslagen i utredningen inte föranleder några ändringar av offentlighets- och sekretesslagstiftningen.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.4.2",
      "sentiment": 1.0,
      "quote": "RFS instämmer i utredningens bedömning att elevhälsan inte ska få ett mer utpräglat hälsooch sjukvårdsuppdrag.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.5.2",
      "sentiment": -0.2,
      "quote": "RFS ställer sig tveksam till utredningens bedömning att behovet av speciallärare kan mötas genom en ökning av utbildningsplatser med över 80 procent, då detta bedöms vara svårt att realisera.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5.3",
      "sentiment": -0.2,
      "quote": "RFS instämmer inte i utredningens bedömning att elevhälsans tidiga insatser skulle leda till färre besök i primärvården.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.5.6",
      "sentiment": 0.2,
      "quote": "RFS instämmer i utredningens bedömning att förslagen sammantaget innebär ett ökat arbetsinnehåll för elevhälsans professioner.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.6.2",
      "sentiment": -0.5,
      "quote": "RFS instämmer i att förslagen om förstärkta hälsobesök innebär ett ökat personalbehov, men anser att utredningens beräkningar av tidsåtgång och därmed kostnader är allvarligt underskattade.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.6.4",
      "sentiment": -0.5,
      "quote": "Eftersom utredningens uppskattning av tidsåtgång är tydligt underskattad, bedömer RFS att även kostnadsberäkningarna är felaktiga och i realiteten betydligt högre.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.6.5",
      "sentiment": -0.5,
      "quote": "RFS bedömer därför att de redovisade kostnaderna är systematiskt underskattade och inte ger en rättvisande bild av det faktiska resursbehov som förslagen innebär.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.1",
      "sentiment": 0.5,
      "quote": "RFS avstyrker förslaget att vårdnadshavare ska kallas till samtliga stora hälsobesök, med hänvisning till barnets rätt till integritet, och anser att vårdnadshavare bör kallas till besöket i årskurs 1 och därefter erbjudas att delta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.5",
      "sentiment": 1.0,
      "quote": "RFS instämmer i utredningens bedömning att faktorer såsom skolfrånvaro, låga skolprestationer, bristande vuxenkontakt, psykisk ohälsa och social utsatthet ökar risken för normbrytande beteende, medan god skolanknytning, stabil vuxennärvaro och god psykisk hälsa utgör viktiga skyddsfaktorer.",
      "quote_type": "grund"
    }
  ]
