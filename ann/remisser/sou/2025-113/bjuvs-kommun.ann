  "overall": {
    "sentiment": 0.2,
    "quote": "Kommunen välkomnar förslag som stärker det förebyggande och hälsofrämjande arbetet, förbättrar samverkan mellan elevhälsan och andra aktörer samt tydliggör elevhälsans roll i skolans systematiska kvalitetsarbete.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a6.1",
      "sentiment": 0.5,
      "quote": "Kommunen tillstyrker att elevhälsan tydligare ska bidra till att skapa förutsättningar för elevers lärande, hälsa och utveckling samt arbeta hälsofrämjande och förebyggande för att tidigt identifiera ohälsa.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": -0.2,
      "quote": "bedömer att HSL-reglering av kuratorsfunktionen inte är nödvändig för att säkerställa samverkan med socialtjänsten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": -0.2,
      "quote": "bedömer kommunen att de föreslagna kraven sammantaget är otillräckliga i förhållande till elevernas faktiska behov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": 1.0,
      "quote": "Kommunen bedömer att förslaget tydliggör informationsansvaret utan att i sig förändra elevhälsans uppdrag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5",
      "sentiment": 1.0,
      "quote": "bedömer att förslaget kan bidra till förbättrade förutsättningar för att tillgodose elevers behov av stöd inom vuxenutbildningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6",
      "sentiment": 0.2,
      "quote": "Krav på vårdnadshavares medverkan vid flera hälsobesök samt ökad frekvens av besök förutsätter ökad personaltäthet och tillgång till kompetens, vilket behöver beaktas för att säkerställa ett genomförande med tillräcklig kvalitet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7",
      "sentiment": 0.5,
      "quote": "Här behöver det tydligt framgå att skolpsykologens roll inte är behandlande, utan inriktad på förebyggande, konsultativa och stödjande insatser inom ramen för elevhälsans uppdrag, samt på samverkan med andra ansvariga verksamheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8",
      "sentiment": 0.5,
      "quote": "Kommunen ser särskilt positivt på införandet av en samordnande funktion inom elevhälsan, vilket kan stärka rättssäkerheten och tydliggöra ansvar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.9",
      "sentiment": 1.0,
      "quote": "Bjuvs kommun tillstyrker förslaget att elevhälsan ska ingå i det systematiska kvalitetsarbete som bedrivs på skolenhetsnivå enligt 4 kap. 4 § skollagen",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.10",
      "sentiment": -0.5,
      "quote": "Det medicinska vårdgivaransvaret bör även fortsättningsvis vara tydligt förankrat hos huvudmannen och ansvarig vårdgivare, i enlighet med hälso- och sjukvårdslagstiftningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.11",
      "sentiment": 1.0,
      "quote": "Kommunen är samtidigt positiv till bedömningen att en nationell uppföljning och utvärdering av elevhälsans organisation och arbete bör genomföras av lämplig myndighet, i syfte att stärka likvärdighet och kvalitet i verksamheten.",
      "quote_type": "grund"
    },
    {
