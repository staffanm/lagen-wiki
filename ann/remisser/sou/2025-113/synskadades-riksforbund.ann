    },
    {
      "forarbete_id": "a6.1.2",
      "sentiment": -0.5,
      "quote": "Våra medlemmars erfarenheter visar att stödet för elever med synnedsättning i många fall inte räcker till för att säkerställa fungerande anpassningar och tillräckligt stöd till lärare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1.4",
      "sentiment": 0.5,
      "quote": "SRF:s erfarenheter visar att tillgången till stöd och specialistkompetens för elever med synnedsättning varierar mellan olika huvudmän.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": 0.5,
      "quote": "För elever med synnedsättning är det viktigt att elevhälsans professioner har förståelse för hur synnedsättning kan påverka lärande, social delaktighet och självständighet i skolmiljön.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.1",
      "sentiment": 0.5,
      "quote": "För elever med synnedsättning är det viktigt att sådana analyser även tar hänsyn till elever med omfattande och specialistberoende stödbehov, eftersom dessa stödinsatser ofta kräver mer tid, samverkan och specialistkompetens än generella stödinsatser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.2",
      "sentiment": 0.5,
      "quote": "SRF anser samtidigt att tillgänglighetsperspektivet behöver omfatta fler aspekter än fysisk närvaro.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": 0.5,
      "quote": "Detta är viktigt för att skapa trygghet och ge möjlighet att planera stödinsatser inför skolstart.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6",
      "sentiment": 0.8,
      "quote": "Forskning visar att oupptäckta synfel och brytningsfel kan påverka barns läsförmåga, koncentration, uthållighet vid närarbete och skolprestationer negativt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8",
      "sentiment": 0.5,
      "quote": "För elever med synnedsättning är fungerande och långsiktig samverkan ofta avgörande för att stödinsatser ska fungera i praktiken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8.2",
      "sentiment": 0.8,
      "quote": "För elever med synnedsättning är det ofta avgörande att det finns en tydlig funktion som kan samordna stödinsatser och fungera som kontaktväg mellan elev, vårdnadshavare, skola och externa verksamheter.",
