  "overall": {
    "sentiment": 0.2,
    "quote": "Fysioterapeuterna är positiva till förslag om tydligare syfte och uppdrag för elevhälsan, men hade gärna sett förslag om att fysioterapeuter ska ingå i elevhälsans lagstadgade professioner för att uppfylla syftet och det bredare uppdraget.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a6.1",
      "sentiment": 0.2,
      "quote": "Det finns en risk att fysisk hälsa blir ett övergripande mål utan tydlig professionsanknytning, vilket kan leda till ett otydligt ansvar och att området i praktiken får lägre prioritet jämfört med psykisk och psykosocial hälsa.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": -0.5,
      "quote": "Om regeringen står kvar vid att inte inkludera fysioterapeuter som en av de lagstadgade professionerna behövs, för mer likvärdiga förutsättningar för alla barn, att formulering bör vara ”ska” snarare än ”kan”.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.1",
      "sentiment": -0.2,
      "quote": "Fysioterapeuterna anser att det ställer höga krav på en rektor som inte är medicinskt utbildad att bedöma vilka andra professioner som behövs och att ha kännedom om vad t ex en fysioterapeut kan bidra med för att elevhälsans syfte och uppdrag ska uppfyllas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6",
      "sentiment": 0.5,
      "quote": "Det är positivt att fysisk, psykisk och social hälsa hålls samman och att innehållet ska regleras närmare i föreskrifter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7",
      "sentiment": 0.5,
      "quote": "Fysioterapeuter är särskilt lämpade att bedöma rörelserelaterade besvär, belastningsproblematik och smärttillstånd hos barn och ungdomar, och kan därmed bidra till tidig och korrekt triagering.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8",
      "sentiment": 0.2,
      "quote": "Samtidigt finns en risk att samverkan i praktiken främst fokuseras på psykosociala och psykiatriska behov, medan fysiska funktionsnedsättningar och smärttillstånd hamnar i skymundan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.9",
      "sentiment": 1.0,
      "quote": "Elevhälsans perspektiv behöver vara integrerat i skolans analys och utvecklingsarbete.",
