  "segments": [
    {
      "forarbete_id": "a6.1",
      "sentiment": 1.0,
      "quote": "Ett stärkt fokus på hälsofrämjande och förebyggande arbete samt tidig upptäckt av ohälsa är avgörande för att elevhälsan ska kunna möta barns och ungas behov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": -0.5,
      "quote": "En reglering mot hälso- och sjukvårdskurator riskerar att förskjuta elevhälsans uppdrag mot ett mer vårdinriktat perspektiv, i strid med intentionen om tidiga och förebyggande insatser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": 0.5,
      "quote": "Specialistkompetens är avgörande för kvaliteten i elevhälsans medicinska insatser och för skolsköterskans möjligheter att göra kvalificerade bedömningar utifrån elevernas behov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.1",
      "sentiment": 1.0,
      "quote": "Vårdförbundet tillstyrker utredningens förslag om krav på bemanningsplaner som grundas på systematiska behovsanalyser, vilket är nödvändigt för att motverka den långvariga underdimensioneringen av elevhälsan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.2",
      "sentiment": 0.5,
      "quote": "Närvaro i skolan är en förutsättning för tidig upptäckt av ohälsa, hälsofrämjande och förebyggande insatser samt ett tryggt och tillgängligt medicinskt stöd i elevernas vardag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.3",
      "sentiment": 0.2,
      "quote": "Om krav på skyndsam handläggning inte kombineras med ökade resurser och rimliga förutsättningar finns en risk för ökad arbetsbelastning och stress, vilket i förlängningen kan påverka både kvaliteten i bedömningarna och tillgängligheten för eleverna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": 1.0,
      "quote": "Tydlig och återkommande information är en förutsättning för att stärka elevers kännedom om elevhälsan och för att underlätta kontakt och tillgång till stöd i skolvardagen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5",
      "sentiment": 1.0,
      "quote": "Förslaget kan bidra till ökad tillgång till hälsofrämjande och förebyggande insatser även för elever inom vuxenutbildningen, utifrån deras behov och förutsättningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6",
      "sentiment": 0.5,
      "quote": "Förbundet delar bedömningen att hälsobesöken utgör en central del i elevhälsans hälsofrämjande och förebyggande arbete samt i den tidiga upptäckten av ohälsa.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.3",
      "sentiment": 0.5,
      "quote": "Förbundet understryker vikten av att enkäten samordnas med befintliga enkäter om barns och ungas hälsa för att undvika dubbelarbete och minska belastningen på både elever och verksamheter.",
