    },
    {
      "forarbete_id": "a6.7",
      "sentiment": 0.2,
      "quote": "Utan tydlig vägledning finns en risk för undanträngning, där elever med mer omfattande behov får stå tillbaka, vilket kan påverka prioriteringar och resursanvändning negativt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8.1",
      "sentiment": 1.0,
      "quote": "Vårdförbundet instämmer i bedömningen om att fungerande samverkan är en grundförutsättning för att elever ska få ett sammanhållet stöd utifrån en helhetssyn på deras behov.",
      "quote_type": "grund"
