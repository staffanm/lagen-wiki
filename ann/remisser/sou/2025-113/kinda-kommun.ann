  "segments": [
    {
      "forarbete_id": "a6.1",
      "sentiment": 0.2,
      "quote": "dock ser vi en risk i utredningens slutsatser att elevhälsans uppdrag snarare blir än mer otydligt, främst genom det ökade fokuset på individinriktade, åtgärdande insatser med oklara gränser gentemot hälso- och sjukvården.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": 0.2,
      "quote": "Kravet på att kurator ska vara utbildad hälso- och sjukvårds innebär att det finns en risk att det sker en förskjutning av ansvar från hälso- och sjukvården till skolan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.1",
      "sentiment": 0.2,
      "quote": "Dock ser vi en fara i en ökad administrativ börda för rektor.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.2",
      "sentiment": -0.5,
      "quote": "Orimligt mycket tid för psykolog och skolläkare kommer läggas på förflyttningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.3",
      "sentiment": -0.5,
      "quote": "Kinda kommun bedömer att tidsfristen på 7 dagar är för kort.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.5",
      "sentiment": 1.0,
      "quote": "Kinda kommun välkomnar möjligheten att erbjuda elevhälsa inom vuxenutbildningen.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.6",
      "sentiment": 0.2,
      "quote": "Vi ser en utmaning att kalla vårdnadshavare till alla stora hälsobesök och att det inte är de som behöver det mest som kommer till hälsobesöken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7",
      "sentiment": -0.8,
      "quote": "Ett dilemma är att det skulle innebära en orimlig arbetsbelastning på bekostnad av hälsofrämjande och förebyggande insatser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8.2",
      "sentiment": 0.5,
      "quote": "Kinda kommun välkomnar kraven på samordning men det måste också finnas någon att möta i samordningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8.3",
      "sentiment": -0.5,
      "quote": "För en liten kommun kan det vara svårt att vara den som driver detta.",
