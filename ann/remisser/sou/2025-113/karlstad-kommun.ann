  "segments": [
    {
      "forarbete_id": "a6.1",
      "sentiment": 1.0,
      "quote": "De föreslagna skrivningarna tydliggör hur elevhälsan ska arbeta mot hela utbildningens uppdrag och att lärande och hälsa går hand i hand.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec268",
      "sentiment": 0.5,
      "quote": "Legitimationen bedöms bidra till höjd kvalitet och ökad likvärdighet i elevhälsans psykosociala arbete, särskilt mot bakgrund av att kuratorer i dagens skolväsen har varierande utbildningsbakgrund.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec283",
      "sentiment": 1.0,
      "quote": "Detta skapar förutsättningar för en mer likvärdig elevhälsa över landet och ger huvudmän och rektorer ett gemensamt och kunskapsbaserat ramverk för planering.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec280",
      "sentiment": 1.0,
      "quote": "Detta möjliggör ett mer systematiskt, transparent och behovsstyrt arbetssätt, där elevhälsans resurser sätts i relation till elevsammansättning, socioekonomiska förutsättningar och identifierade behov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec292",
      "sentiment": -1.0,
      "quote": "Det är angeläget att elevhälsan kan göra bedömningar och prioriteringar utifrån behov och inte utifrån fastslagen tidsfrist.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec273",
      "sentiment": 1.0,
      "quote": "då detta stärker kvalitet, professionalism och likvärdighet i det specialpedagogiska arbetet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec306",
      "sentiment": 0.2,
      "quote": "utredningens samlade förslag innebär en betydande ökning av arbetsbelastningen för den medicinska elevhälsan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec318",
      "sentiment": 1.0,
      "quote": "En gemensam nationell enkät är avgörande för att säkerställa likvärdighet, kvalitet och jämförbarhet mellan huvudmän och över tid.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec338",
      "sentiment": 1.0,
      "quote": "Med en stark primärvård, en tillgänglig specialistvård och tydliga samarbetsstrukturer kan elevhälsan bidra på rätt nivå: genom tidig upptäckt, kompetent bedömning och effektiv remittering, utan att tappa sitt kärnuppdrag i skolmiljön.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec364",
      "sentiment": 1.0,
      "quote": "Ett sådant stöd är viktigt för att säkerställa en likvärdig, rättssäker och professionellt organiserad medicinsk elevhälsa.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec361",
