  "segments": [
    {
      "forarbete_id": "a6.1.1",
      "sentiment": 0.5,
      "quote": "Dock finns det en risk för att ett större fokus på individnivån sker på bekostnad av främjande och förebyggande insatser på grupp- och skolnivå.",
