  "overall": {
    "sentiment": 0.5,
    "quote": "En fungerande skolgång med en individanpassad undervisning, tidigt stöd och stark elevhälsa är en av de viktigaste skyddsfaktorerna för barn och ungas psykiska hälsa.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a6.1",
      "sentiment": 0.5,
      "quote": "elevhälsan är väldigt ojämlikt utformad över landet, vilket gör att det stöd ett barn eller en ungdom kan förvänta sig att få av elevhälsan beror i stor utsträckning på var man bor och i vilken skola man råkar gå.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": 0.2,
      "quote": "Att det förtydligas att det är en legitimerad hälso- och sjukvårdskurator som ska finnas tillgänglig i elevhälsan ser vi som en viktig förstärkning, då utbildningsbakgrunden för kuratorer idag varierar kraftigt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": 0.2,
      "quote": "Elevhälsan har ett viktigt uppdrag att ge stöd till barn och unga, och en unik möjlighet att träffa alla landets barn och ungdomar och bygga relationer till dem som kan göra det lättare att söka stöd när behov uppstår.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": 1.0,
      "quote": "Att barn och unga samt deras vårdnadshavare vet om vilket stöd som finns att tillgå inom elevhälsan kan vara avgörande för om de vänder sig till verksamheten för att få stöd eller inte.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6",
      "sentiment": 0.5,
      "quote": "Att mer regelbundet ha olika omfattningar av dessa besök ser vi kan bidra till att det kan ligga närmare till hands för elever att vända sig till elevhälsan, om det är någon de åtminstone träffat någon eller några gånger tidigare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7",
      "sentiment": 0.2,
      "quote": "Att barn och unga kan få lättare tillgång till stöd tidigt när behoven uppstår ser vi som mycket värdefullt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8",
      "sentiment": 0.5,
      "quote": "Att införa en samordnande funktion och obligatoriska samverkansöverenskommelser ser vi skulle ha positiva effekter på att få till samverkan med övriga aktörer i samhället - något som vi ofta ser brister i.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.11",
      "sentiment": 0.5,
      "quote": "I detta arbete ser vi det som centralt att inkludera elevers upplevelser och erfarenheter av elevhälsan, för att säkerställa att verksamhetens organisation och bemanning leder till det att möta det stödbehov som finns hos barn och unga i skolorna.",
      "quote_type": "grund"
    }
  ]
}