  "segments": [
    {
      "forarbete_id": "sec3",
      "sentiment": -0.5,
      "quote": "Kommunens erfarenhet är att elevhälsans arbete i praktiken präglas av en komplex balans mellan individinriktade insatser, sociala och psykosociala frågor samt pedagogiskt stöd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec11",
      "sentiment": -0.5,
      "quote": "För en kommun med många mindre skolenheter innebär kraven: • betydande rekryteringssvårigheter, • behov av omfattande omorganisation, • samt ökade kostnader.",
