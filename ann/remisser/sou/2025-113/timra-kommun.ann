    {
      "forarbete_id": "sec9",
      "sentiment": -0.5,
      "quote": "De utökade kraven på hälsobesök, hälsosamtal och bedömningar inom angivna tidsramar riskerar att tränga undan det relationsskapande och förebyggande arbetet, vilket är centralt för elevhälsans långsiktiga effekt.",
      "quote_type": "grund"
