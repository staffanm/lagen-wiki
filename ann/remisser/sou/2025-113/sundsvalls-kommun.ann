    },
    {
      "forarbete_id": "a6.3.1",
      "sentiment": 0.5,
      "quote": "Om planen upprättas på huvudmannanivå kan detta avlasta rektorn och skolan samt öka likvärdigheten inom huvudmannens organisation.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.2",
      "sentiment": 0.2,
      "quote": "Sundsvalls kommun ser att förslaget kan vara svårt att realisera för huvudmän med många små skolor, exempelvis glesbygdsskolor eller resursskolor.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.3",
      "sentiment": -0.5,
      "quote": "Sundsvalls kommun anser att detta ligger inom regionens grunduppdrag och därmed inte ska finansieras med kommunala skattemedel.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.2",
      "sentiment": -0.5,
      "quote": "Att skolläkaren tillsammans med skolsköterska ska genomföra samtliga hälsobesök anser Sundsvalls kommun är att nyttja denna resurs på ett ineffektivt och icke ändamålsenligt sätt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.2",
      "sentiment": 0.5,
      "quote": "Sundsvalls kommun anser att samtalet bör genomföras av psykolog eller kurator, inte av skolsköterskan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7",
      "sentiment": -0.5,
      "quote": "Anledningarna är desamma som togs upp i avsnittet om tidsfrister för elevhälsan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8.2",
      "sentiment": 0.5,
      "quote": "Detta ökar likvärdigheten mellan huvudmannens skolor och minskar risken för att en rektor vid en viss skolenhet nedprioriterar en viss elevhälsofunktions kärnuppdrag genom att ålägga den ett för stort samordningsuppdrag.",
