  "segments": [
    {
      "forarbete_id": "a6.1.1",
      "sentiment": 0.2,
      "quote": "Myndigheten anser att uppdraget och ansvaret för elevernas hälsa riskerar att bli otydligt mellan skolan och hälso- och sjukvården samt mellan skolan och vårdnadshavarna",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1.2",
      "sentiment": 1.0,
      "quote": "Skolverket tillstyrker förslaget om att elevhälsan ska genomföra medicinska, psykologiska, psykosociala och specialpedagogiska insatser utifrån samma skäl som utredningen skriver fram.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.1.3",
      "sentiment": 1.0,
      "quote": "Skolverket vill betona att elevhälsan är en integrerad del av utbildningen och inte en separat verksamhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1.4",
      "sentiment": -0.5,
      "quote": "Enligt Skolverkets bedömning är dock bestämmelser om bland annat elevhälsans syfte och uppdrag av sådan karaktär att de bör framgå i förordning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": -0.5,
      "quote": "För legitimerade hälso- och sjukvårdskuratorer gäller bland annat krav på journalföring och patientsäkerhetslagstiftning, vilket kan öka den administrativa bördan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.1",
      "sentiment": 0.0,
      "quote": "I stället för nationellt fastställda beräkningsgrunder vill Skolverket lyfta fram att bemanningsplanen bör baseras på det systematiska kvalitetsarbetets analys av skolans behov och förutsättningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.2",
      "sentiment": -0.5,
      "quote": "Skolverket anser att förslaget inte tar hänsyn till skolors olika förutsättningar, såsom skolform, storlek, geografiska läge eller elevers skiftande behov",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.3",
      "sentiment": -0.5,
      "quote": "Skolverket anser att förslaget inte tar hänsyn till skolors olika förutsättningar, såsom skolform, storlek, geografiska läge eller elevers skiftande behov",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.2",
      "sentiment": 0.2,
      "quote": "En utökning av hälsobesök och hälsosamtal kan bli resurskrävande för huvudmän vilket Skolverket bedömer kan ställa nya krav vad gäller allokering, främst organisation, administration, lokaler och personal.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.3",
      "sentiment": -0.5,
      "quote": "Skolverket bedömer att det finns risker med att samla in integritetskänsliga uppgifter om individers hälsa.",
