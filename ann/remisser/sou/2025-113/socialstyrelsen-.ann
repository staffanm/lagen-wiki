    },
    {
      "forarbete_id": "a6.3",
      "sentiment": 0.2,
      "quote": "Socialstyrelsen ser en risk att det kan bli svårt att uppfylla förslaget i praktiken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": 1.0,
      "quote": "Socialstyrelsen instämmer till förslaget om att skolhuvudmannen ska vara skyldig att informera elever och vårdnadshavare om elevhälsans uppdrag, vilka professioner som ingår i elevhälsan, när de finns tillgängliga vid skolenheten och hur elever och vårdnadshavare kan komma i kontakt med dem.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.5",
      "sentiment": -0.2,
      "quote": "Socialstyrelsen poängterar att förslaget om tillgång till elevhälsa i vuxenutbildning behöver förtydligas.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.6",
      "sentiment": 0.2,
      "quote": "Myndigheten bedömer att en reglering genom föreskrifter av innehållet i elevhälsans hälsobesök och hälsosamtal riskerar att stå i strid med de principer som ligger till grund för kunskapsstyrningen inom hälso- och sjukvården.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.3",
      "sentiment": 0.2,
      "quote": "Nyttan med en nationell insamling behöver ställas i relation till kostnaderna samt tekniska, juridiska (inklusive sekretess och etik) och praktiska förutsättningar och hinder.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7",
      "sentiment": -0.2,
      "quote": "Gränsdragningen mellan att arbeta med vad som är hälsofrämjande och förebyggande för ohälsa respektive behandlande, eller utredande, kan riskera att bli otydlig om det inte klargörs vilken profession och verksamhet som ansvarar för vad, respektive elevhälsa kontra primärvård.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8.2",
      "sentiment": 1.0,
      "quote": "Det finns starkt stöd i samverkansforskning om behovet av samordning och att det finns i form av en tilldelad samordnarroll.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8.3",
      "sentiment": 1.0,
      "quote": "Socialstyrelsen tillstyrker utredningens förslag om att skolhuvudmän ska ingå samverkansöverenskommelser med regionen.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.10",
      "sentiment": 1.0,
      "quote": "Socialstyrelsen tillstyrker förslaget om att stärka huvudmannens styrning och ledning av elevhälsan och att myndigheten ska ges i uppdrag att ta fram stödmaterial om vårdgivaransvaret och ledning och styrning av elevhälsans medicinska insatser, riktat till skolhuvudmän och rektor.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.5.1",
      "sentiment": -0.2,
      "quote": "Gränsdragningen mellan regionens respektive elevhälsans ansvar riskerar att bli otydlig för dessa barn och unga då ansvaret vilar på båda huvudmännen och inte ensidigt hos en.",
