      "artifact:forarbete/sou/2025-113": "8c1c0cf1be8ee429662154c8dc64f07f510f8551ac68bae66465171635e8c748"
    }
  },
  "overall": {
    "sentiment": 0.5,
    "quote": "tillstyrker i huvudsak utredningens förslag, men vill anföra följande:",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a5.3.2",
      "sentiment": -0.2,
      "quote": "Vi menar att när man använder egna definitioner på hälsa, prevention och hälsofrämjande insatser bör det följas av en kommentar att skolans definitioner avviker från Folkhälsomyndighetens och världshälsoorganisationens WHO:s definitioner och speglar inte vetenskaplig konsensus.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1.1",
      "sentiment": 0.5,
      "quote": "I linje med utredningens förslag menar vi att benämning ”elever” borde ersättas med ”barn och unga”, då detta bättre speglar uppdraget att stärka barn och ungas hälsa.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1.2",
      "sentiment": 0.2,
      "quote": "Vi menar att den medicinska insatsen inte tillräckligt tydligt har beskrivits i utredningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1.3",
      "sentiment": 0.2,
      "quote": "Siffrorna visar med tydlighet hur begränsad skolläkarresursen är idag och som vi tidigare påpekat används i dag skolläkaren huvudsakligen till direkta kontakter med elever och vårdnadshavare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1.4",
      "sentiment": 0.5,
      "quote": "menar vi att Socialstyrelsen ska få uppdraget att utforma de föreskrifter som gäller elevhälsans medicinska insats (EMI) och dess roll i elevhälsoarbetet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": -0.5,
      "quote": "Till skillnad från övrig hälso- och sjukvård ställer man inga krav på adekvat specialistutbildning för att få arbeta som skolläkare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": 0.5,
      "quote": "Tvärprofessionell elevhälsa förutsätter inte enbart samverkan mellan professioner, utan även en tydlig ansvarsfördelning där medicinska bedömningar och prioriteringar görs av skolläkare inom elevhälsans medicinska insats.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.1",
      "sentiment": 0.5,
      "quote": "vill betona att tillgång till hälso- och sjukvårds-personal måste ges en tydlig och självständig plats i beräkningsgrunderna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.2",
      "sentiment": -0.2,
      "quote": "Kravet på fysisk närvaro i skolans lokaler riskerar att medföra omfattande resor för specialiserad elevhälsopersonal, vilket kan ta i anspråk en betydande del av arbetstiden och därmed minska tillgängligheten för eleverna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.3",
      "sentiment": 0.5,
      "quote": "anser att Socialstyrelsen ska ansvara för att ta fram beräkningsgrunder för tidsramar för legitimerad hälso- och sjukvårdspersonal och att detta fastställs i föreskrift.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": 1.0,
      "quote": "Vi tillstyrker förslaget.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.5",
      "sentiment": 0.5,
      "quote": "De individer som deltar i vuxenutbildning har en betydligt högre sannolikhet att ha en somatiskt eller neuropsykiatrisk funktionsnedsättning och har därmed ett större behov av elevhälsa än elever i övrigt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6",
      "sentiment": 0.2,
      "quote": "Föreningarna noterar dock med förvåning att slutbetänkandet valt att inte följa WHO:s rekommendation om minst 4 skolläkarbedömningar under skoltiden vilket vi anser är anmärkningsvärt då Sverige har en lång tradition att följa WHO:s rekommendationer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.1",
      "sentiment": 1.0,
      "quote": "Vi instämmer i utredningens beskrivning.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.6.2",
      "sentiment": -0.2,
      "quote": "Föreningarna bedömer att förslaget är problematiskt och riskerar att otydliggöra det uppdrag elevhälsans medicinska insats (EMI) har i elevhälsoarbetet då elevhälsans medicinska insats (EMI) lyder under hälso-och sjukvårdslagen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.3",
      "sentiment": 0.5,
      "quote": "vill betona vikten av att det regleras att vid tecken till ohälsa i hälsoenkäten ska skolläkare konsulteras samt att en nationell hälsoenkät ska utformas av Socialstyrelsen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7",
      "sentiment": -0.2,
      "quote": "vill betona att utredningen inte tillräckligt har beskrivit och analyserat samt gjort en konsekvensbeskrivning av att skolpsykologer och skolkuratorer ska utföra hälso- och sjukvård utan att samtidigt vara en del av EMI.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8",
      "sentiment": 1.0,
      "quote": "Vi tillstyrker och välkomnar förslaget.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.8.1",
      "sentiment": 1.0,
      "quote": "Vi delar utredningens bedömning.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.8.2",
      "sentiment": -0.2,
      "quote": "Samtidigt finns en påtaglig risk att samordningsansvaret i praktiken överförs till skolan i alltför stor utsträckning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8.3",
      "sentiment": -0.2,
      "quote": "Det kommer leda till tusentals separata samverkansöverenskommelser vilket vare sig är sannolikt eller praktiskt genomförbart.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.9",
      "sentiment": -0.2,
      "quote": "Föreningarna anser att det är olyckligt att utredningen inte kommer med ett tydligare krav att elevhälsans samtliga professioner ska vara en del av skolans kvalitetsarbete",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.10.4",
      "sentiment": 1.0,
      "quote": "Vi delar utredningens analys och ställningstagande.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.10.5",
      "sentiment": 1.0,
      "quote": "Vi är positiva till förslaget.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.11",
      "sentiment": 0.5,
      "quote": "anser att Socialstyrelsen ska ansvara för att på nationell nivå följa upp och utvärdera i vilken omfattning legitimerad hälso- och sjukvårdspersonal ingår i elevhälsans organisation och arbete samt att detta fastställs i föreskrift.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.12",
      "sentiment": -0.2,
      "quote": "De olika verksamheternas tystnadsplikt och sekretess skapar dock betydande praktiska svårigheter i samverkan mellan verksamheter då det saknas tydliga riktlinjer från myndigheter hur de olika sekretessbrytande möjligheter som finns kan undanröja hinder",
      "quote_type": "grund"
    }
  ]
}