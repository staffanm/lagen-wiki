  "segments": [
    {
      "forarbete_id": "sec280",
      "sentiment": -0.2,
      "quote": "Det finns en oro för att de fastslagna professionernas närvaro på varje skolenhet medför svårigheter när det gäller rekrytering av professionerna som redan i dag kan vara svåra att rekrytera.",
