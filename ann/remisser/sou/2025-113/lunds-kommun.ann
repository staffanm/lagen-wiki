  "overall": {
    "sentiment": -0.3,
    "quote": "Nämnden tillstyrker en del av utredningens förslag, medan vi avstyrker andra.",
    "quote_type": "standpunkt"
  },
  "segments": [
    {
      "forarbete_id": "a6.1",
      "sentiment": 0.8,
      "quote": "Nämnden ser positivt på utredningens ambition att tydliggöra elevhälsans syfte och uppdrag i skollagen, särskilt vad gäller att synliggöra sambandet mellan hälsa och lärande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": -1.0,
      "quote": "Detta förslag, och även andra i utredningen, innebär en förskjutning mot ett stärkt kliniskt vårduppdrag inom skolan, vilket medför en risk för att elevhälsans arbete ges en för snäv medicinsk eller psykiatrisk ram.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.1",
      "sentiment": -1.0,
      "quote": "Förslaget om bemanningsplan går stick i stäv med de förslagen och leder tvärtom till mer administration och statlig byråkrati för rektor.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.2",
      "sentiment": -1.0,
      "quote": "Att reglera fysisk närvaro i lag riskerar att leda till minskad flexibilitet och ett ineffektivt resursutnyttjande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.3",
      "sentiment": -1.0,
      "quote": "I likhet med andra vårdgarantier är risken att de i praktiken främst leder till att ett första kontakt- eller bedömningsmöte genomförs inom angiven tidsram utan att elever får faktisk hjälp snabbare än vad som annars hade varit fallet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": -1.0,
      "quote": "Nämnden bedömer att förslaget innebär en omfattande detaljstyrning som riskerar att kräva mycket administrativt arbete och resurser, utan att detta nödvändigtvis leder till ökad faktisk tillgänglighet eller bättre stöd till eleverna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.2",
      "sentiment": -0.5,
      "quote": "Samtidigt behöver det behov som elever kan ha av enskilda samtal med skolsköterskan värnas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.3",
      "sentiment": 1.0,
      "quote": "En nationellt framtagen hälsoenkät att använda i elevhälsan har efterfrågats länge.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8.2",
      "sentiment": -1.0,
      "quote": "Nämnden anser att sådana befintliga strukturer bör tas till vara och utvecklas snarare än att kompletteras med nya obligatoriska funktioner.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8.3",
      "sentiment": 1.0,
      "quote": "Att skolhuvudmän formaliserar sin samverkan med aktuell region i en överenskommelse bidrar till ökad likvärdighet nationellt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.9",
      "sentiment": 1.0,
      "quote": "Förslaget klargör elevhälsans betydelse som en integrerad del av planering, uppföljning och utveckling av utbildningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.10.5",
      "sentiment": 0.8,
      "quote": "Detta kan bidra till ökad tydlighet i ansvarsförhållanden och arbetssätt.",
