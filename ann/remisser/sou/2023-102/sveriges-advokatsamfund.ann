    {
      "forarbete_id": "sec28",
      "sentiment": -0.2,
      "quote": "Här saknar Advokatsamfundet ett mer utförligt resonemang om vad det innebär för möjligheten för operatören att följa reglerna i dataskyddsförordningen, när det i praktisk mening inte är operatören själv som genomför registreringsåtgärder.",
      "quote_type": "grund"
