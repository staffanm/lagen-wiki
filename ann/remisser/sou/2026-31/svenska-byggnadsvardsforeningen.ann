  "segments": [
    {
      "forarbete_id": "a5",
      "sentiment": -0.2,
      "quote": "Utredningen redovisar flera internationella modeller som är relevanta ur kulturarvs- och kulturmiljöperspektiv, men drar inte tillräckligt långtgående slutsatser av dem.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2",
      "sentiment": 0.5,
      "quote": "Det byggda kulturarvet skiljer sig från många andra kulturverksamheter genom att behoven ofta är långsiktiga, materiella och underhållsrelaterade.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2.2",
      "sentiment": -0.2,
      "quote": "Samtidigt finns en risk att privata gåvor till offentliga verksamheter absorberas i den ordinarie budgeten och därmed inte blir ett verkligt tillskott.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.3",
      "sentiment": 0.2,
      "quote": "Kulturmiljövård kräver ofta långsiktighet, sakkunskap och återkommande underhåll, snarare än korta projektlogiker.",
      "quote_type": "grund"
    }
  ]
