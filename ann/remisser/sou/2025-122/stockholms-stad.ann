  "overall": {
    "sentiment": 0.2,
    "quote": "Staden befarar att förändringarna där prövningstillstånd blir svårare att få, prövningstillstånd blir fakultativt, samtidigt som prövningskretsen begränsas och avgifter införs på överklaganden, kan få systempåverkande effekter som i förlängningen kan komma att påverka legitimiteten och förtroendet för systemet.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a3.7.4",
      "sentiment": 0.5,
      "quote": "Dagens ordning där större ansökningsmål endast överprövas av i praktiken en instans, Markoch miljööverdomstolen, medan kommunala tillsynsbeslut överprövas av tre instanser, innebär inte en effektiv eller proportionerlig fördelning av de överprövande instansernas resurser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.7.6",
      "sentiment": 1.0,
      "quote": "Stadsledningskontoret tillstyrker förslaget att mark- och miljödomstolens beslut i mål som har överklagats till mark- och miljödomstol och som avser avvisning av överklagande som kommit in för sent, på motsvarande sätt som i dag gäller för exempelvis överklagade beslut enligt fastighetsbildningslagen, inte ska få överklagas.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a3.7.7",
      "sentiment": 1.0,
      "quote": "Stadsledningskontoret tillstyrker förslaget.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a3.7.8",
      "sentiment": -1.0,
      "quote": "Det ökar enligt kontoret risken för materiellt felaktiga beslut.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.6.4",
      "sentiment": -1.0,
      "quote": "Kontoret ifrågasätter att det går att identifiera vad som är ett gynnande beslut, eftersom plan- och bygglagsärenden ofta rymmer flera motstridiga enskilda intressen, och inte består av ett enskilt intresse som står mot ett allmänt intresse (företrätt av myndigheten).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7.3",
      "sentiment": -1.0,
      "quote": "I och med de förändringar som föreslås avseende samrådskretsen, med tillhörande kommunikationsskyldighet och tydliggörande av sakägarbegreppet anser kontoret att behovet tillgodoses.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.7.2",
      "sentiment": -1.0,
      "quote": "Tidsfristen riskerar att förhindra en ändamålsenlig handläggning ifall frågor som behöver utredas skriftligen uppstår under huvudförhandling eller sammanträde.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.7.2",
      "sentiment": 1.0,
      "quote": "EU- och konventionsrätten anger, som utredningen konstaterar, ramarna i denna fråga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.3",
      "sentiment": 1.0,
      "quote": "Stadsledningskontoret tillstyrker vidare utredningens förslag att förenkla processen för planeringsbesked genom att samrådet med tillhörande processteg slopas.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.7.4",
      "sentiment": 0.5,
      "quote": "I antagandeskedet är bedömningen om betydande miljöpåverkan således fortfarande bara en bedömning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.5",
      "sentiment": 1.0,
      "quote": "Detta kommer att minska kommunens utredningsbörda avseende vilka som är berörda av ett planförslag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.6",
      "sentiment": 1.0,
      "quote": "Kontoret tillstyrker även förslaget att bestämmelser om plankostnadsavtal införs.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.7.7",
