  "overall": {
    "sentiment": 0.5,
    "quote": "Svemin tillstyrker huvudsakligen förslagen i betänkandet, då det är viktiga följdändringar till förslagen i ”En ny samordnad miljöbedömnings- och tillståndsprövningsprocess”, SOU 2024:98.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "sec167",
      "sentiment": 0.8,
      "quote": "Det framstår som rimligt att Högsta domstolen (HD) utgår ur instansordningen för mål enligt miljöbalken, eftersom HD i praktiken inte har någon betydelsefull funktion som överprövningsinstans inom miljörätten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.7.4",
      "sentiment": -0.5,
      "quote": "Detta skapar väsentligt bättre förutsättningar för en enhetlig praxisbildning och en mer förutsägbar rättstillämpning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.7.8",
      "sentiment": 1.0,
      "quote": "Som nämnts ovan tillstyrker Svemin att MÖD:s roll som prejudikatbildande instans stärks genom att man inför en möjlighet till förstärkt sammansättning vid prövning av frågor av principiell betydelse.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.7.3",
      "sentiment": -0.2,
      "quote": "De skäl som framförts är bland annat att länsstyrelsen fungerar som en berednings- och filterfunktion i det stora antal ärenden det rör sig om, vikten av det förvaltningsjuridiska perspektivet, processekonomi och samordningen med länsstyrelsens roll för att bevaka de statliga intressena.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.6.3",
      "sentiment": 0.5,
      "quote": "Att ta bort möjligheten att få ändrings- eller granskningsdispens hade onekligen lett till snabbare tillståndsprocesser, men borttagandet bör som sagt kombineras med att alla miljöärenden från den nya prövningsmyndigheten överklagas till en och samma markoch miljödomstol.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7.3",
      "sentiment": 1.0,
      "quote": "En mindre avgift kan ha effekten att potentiella klaganden tänker efter en extra gång och att det därmed blir mer genomtänkta och kvalitativa överklaganden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.7.2",
      "sentiment": 1.0,
      "quote": "Att sätta en tidsgräns för mark- och miljödomstolarna om när dom ska ha meddelats minskar risken för att dom dröjer och att projekt blir försenade.",
      "quote_type": "grund"
    }
  ]
