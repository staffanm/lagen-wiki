  "overall": {
    "sentiment": 0.2,
    "quote": "SKR tillstyrker förslaget om en kortare instanskedja och att länsstyrelsen samt ventilen till Högsta domstolen tas bort.",
    "quote_type": "standpunkt"
  },
  "segments": [
    {
      "forarbete_id": "sec7",
      "sentiment": 1.0,
      "quote": "Det är ovanligt med fyra och upp till fem instanser inom andra rättsområden och framstår inte som motiverat att just kommunala beslut som fattas med stöd av miljöbalken eller PBL, som ofta är mindre omfattande ärenden, ska prövas i fler instanser än många andra myndighetsbeslut.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.6.4",
      "sentiment": 1.0,
      "quote": "som ett led i att effektivisera processen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.6.3",
      "sentiment": -1.0,
      "quote": "Det kommer sannolikt att finnas ett utökat behov av att MÖD överprövar domar från mark- och miljödomstolarna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.8.2",
      "sentiment": 1.0,
      "quote": "då det skulle kunna förenkla och effektivisera processerna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7.3",
      "sentiment": 0.2,
      "quote": "Det är dock viktigt att det inte medför att enskilda inte kan få sin rätt prövad, oavsett inkomst.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.7.2",
      "sentiment": 1.0,
      "quote": "SKR tillstyrker förslaget om att nuvarande reglering i MB om att dom ska meddelas inom två månader från huvudförhandling flyttas till Lag om mark- och miljödomstolar (LOMM) och framöver tillämpas för alla mål och ärenden där huvudförhandling eller sammanträde har hållits.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.7.3",
      "sentiment": 1.0,
      "quote": "Tidsfrister kommer att följa av flera EUförordningar framöver och att utöver det ha svenska tidsfrister är inte lämpligt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.3",
      "sentiment": 1.0,
      "quote": "En förenklad process för begäran om planeringsbesked så som utredningen föreslår skulle kunna göra planeringsbeskedet till ett mer användbart planeringsverktyg och bidra till mer effektiva och förutsägbara planprocesser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.4",
      "sentiment": -0.2,
      "quote": "är tveksamma till förslagen i nuvarande utformning eftersom det framstår som att det medför ytterligare steg i planprocessen som riskerar att förlänga processen, även om det inte har varit utredningens intention.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.5",
      "sentiment": -1.0,
      "quote": "Det står inte klart att förslaget kommer att innebära någon effektivisering av planprocessen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.6",
      "sentiment": 1.0,
      "quote": "Det är viktigt att denna möjlighet till finansiering av planer kvarstår för att arbetet även fortsatt ska kunna prioriteras hos kommunerna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.7",
      "sentiment": -0.2,
      "quote": "SKR har under en lägre tid noterat att utredningsbördan har växt och att planprocesserna har blivit allt mer komplexa.",
      "quote_type": "grund"
    }
  ]
}