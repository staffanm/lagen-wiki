  "overall": {
    "sentiment": 0.5,
    "quote": "Green Power Sweden bedömer att förslagen i betänkandet överlag kan bidra till e n mer effektiv, förutsägbar och ändamålsenlig tillstånds process .",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a3.7",
      "sentiment": 1.0,
      "quote": "E n mer koncentrerad instansordning med tidigare domstolsprövning kan ge snabbare och mer förutsebara beslut , och främja både rättssäkerhet och effektivitet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.7.6",
      "sentiment": 0.5,
      "quote": "Ibland gör underinstansen fel och då borde det vara möjligt för verksamhetsutövaren att överklaga frågan om rättidsprövning särskilt innan domstol eller rege ring prövar ärendet i sak.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.7.7",
      "sentiment": 0.5,
      "quote": "Nu är det oklart om domstolen ska bereda klart samtliga frågor som inte rör Försvarsmakten innan ärendet lämnas över till regeringen , eller om det ska vara upp till regeringen att återförvisa ärendet till mark- och miljödomstolen efter att regeringen har vägt av försvarsfrågan .",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.7.8",
      "sentiment": -0.2,
      "quote": "Att minska mängden fall som kan tas upp i Mark - och miljööverdoms tolen samtidigt som länsstyrelsen försvinner som prövningsinstans kan kraftigt begränsa möjligheterna till prövning av ärenden där vi fortfarande ser stort behov av ny praxis.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.7.2",
      "sentiment": 0.5,
      "quote": "En sådan tydlig ansvarsfördelning minskar risken för överlappande bedömningar och bidrar till mer ändamålsenliga processer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.7.2",
      "sentiment": -0.2,
      "quote": "När det gäller förslaget att domstolarnas handläggningstid för beslutfattande begränsas till två månader e fter huvudförhandling ser vi dock en risk för att det vid hög arbetsbelastning kan leda till fler avslag eller avvisningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7.3",
      "sentiment": 0.2,
      "quote": "Att det föreslås att avgiften endast ska gälla för klaganden med ett ekonomiskt underlag som överstiger 260 000 kr bedömer vi dock kommer innebära att förändringen blir liten för vindkrafts - och solparker jämfört med idag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8",
      "sentiment": 1.0,
      "quote": "Även en väldigt enkelt avgränsad planprocess kan ta 2 –4 år, dvs. minst lika lång tid som en komplex miljötillståndsprocess i domstol.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9",
      "sentiment": -0.2,
      "quote": "Vi vill lyfta att stegvis genomförande av dessa förslag, om de blir lagförslag, kan skapa otydligheter kring övergångsbestämmelser och prövningsmandat.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a2.3.4",
      "sentiment": 1.0,
      "quote": "Det vore önskvärt att samla in sådan statistik från alla berörda aktörer så att den finns tillgänglig i ett konsekvent format, och att göra statistiken lättillgänglig i digital form.",
      "quote_type": "grund"
    }
  ]
