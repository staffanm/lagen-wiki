    {
      "forarbete_id": "a3.7.8",
      "sentiment": 0.7,
      "quote": "En tydligare prejudikatroll bedöms kunna bidra till ökad rättslig förutsebarhet och mer enhetlig tillämpning, vilket är viktigt för både kommuner och byggaktörer.",
      "quote_type": "grund"
