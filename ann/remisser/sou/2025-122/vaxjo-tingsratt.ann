  },
  "overall": {
    "sentiment": -0.2,
    "quote": "Mark- och miljödomstolen bedömer mot den bakgrunden att förslaget innebär en allt för omfattande förändring med hänsyn till risken för eftersatt rättssäkerhet.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "sec7",
      "sentiment": 0.2,
      "quote": "Domstolen delar utredningens bedömning att den sammanlagda tiden för överprövning av ett överklagat beslut som prövas i samtliga möjliga instanser förkortas med införandet av en sådan förändring.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.5.5",
      "sentiment": -0.5,
      "quote": "Praxisbildning i den högsta instansen är av stort värde för underinstansernas prövning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.7.6",
      "sentiment": 1.0,
      "quote": "Mark- och miljödomstolen instämmer i utredningens bedömning i fråga om fullföljdsförbud avseende mark- och miljödomstolens domar i mål som avser överklagade avvisningsbeslut av för sent inkomna överklaganden.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a3.7.7",
      "sentiment": 1.0,
      "quote": "Den föreslagna nya rubriken före 13 kap. 7 § PBL bedöms förtydliga att överlämnandeskyldigheten gäller även överklagade detaljplanemål som rör försvaret på sätt som anges i betänkandet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.7.8",
      "sentiment": -1.0,
      "quote": "Den statistik som presenterats över Mark- och miljööverdomstolens prövningar talar enligt mark- och miljödomstolen för att det av rättssäkerhetsskäl är olämpligt att begränsa Mark- och miljööverdomstolens roll till att vara en prejudikatinstans.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec183",
      "sentiment": 1.0,
      "quote": "det är därför viktigt med ändamålsenliga sammansättningsregler.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.6.4",
      "sentiment": 1.0,
      "quote": "förslaget kommer att medföra minskade handläggningstiderna och bidra till ett mer effektiv nyttjande av domstolens kompetens.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.7.2",
      "sentiment": 1.0,
      "quote": "Domstolen instämmer därvid även i bedömning att överklaganden som skulle kunna ses som okynnesöverklaganden är ovanliga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.7.3",
      "sentiment": -0.5,
      "quote": "Ett sådant krav bedöms kunna förkorta handläggningstiden i ett stort antal mål med flera veckor.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7.3",
      "sentiment": -1.0,
      "quote": "Som domstolen ser det vägs en sådan minskning emellertid inte upp av den ökade administration som införande av en avgift skulle medföra.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.7.2",
      "sentiment": -1.0,
      "quote": "Förslaget att reglera även tid för dom efter sammanträde i överklagade mål har, menar domstolen fler nackdelar än fördelar och riskerar att fördröja handläggningen av målen snarare än att snabba upp den.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.3",
      "sentiment": 1.0,
      "quote": "Förenklingen bör, enligt domstolens mening, öka användningen av planeringsbesked även om det inte går att bedöma i vilken omfattning det kan röra sig om.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.4",
      "sentiment": 1.0,
      "quote": "Härvid vill domstolen framhålla att det genom förslaget blir tydligare hur kommunerna ska hantera undersökningen i planprocessen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.5",
      "sentiment": 0.5,
      "quote": "Förslaget innebär en effektivisering och en förenkling för kommunerna vid framtagandet av planer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.6",
      "sentiment": 1.0,
      "quote": "införandet av en sådan bestämmelse gör det tydligare för både kommuner och byggherrar, varför förslaget tillstyrks.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.7",
      "sentiment": 1.0,
      "quote": "tycker även att förslaget att ge Boverket i uppdrag att ta fram en ny samlad vägledning om detaljplaneprocessen och vilka utredningar som bör krävas beroende på ändamålet med planen och platsens förutsättningar är bra och bör genomföras.",
      "quote_type": "grund"
    }
  ]
}