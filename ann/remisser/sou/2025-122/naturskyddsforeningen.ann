    },
    {
      "forarbete_id": "a3.7.4",
      "sentiment": -0.5,
      "quote": "Det rör sig framförallt om tillsynsärenden, där en stor sakkunskap finns i länsstyrelsernas organisationer som vi ser som svår att flytta över.",
