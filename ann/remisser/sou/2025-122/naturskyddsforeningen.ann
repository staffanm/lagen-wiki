    },
    {
      "forarbete_id": "a4.6.4",
      "sentiment": 1.0,
      "quote": "Föreningen tillstyrker möjligheten för Mark- och miljööverdomstolen att meddela prövningstillstånd i beslut som tas med endast en lagfaren domare när frågan är enkel.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.7.2",
      "sentiment": 0.2,
      "quote": "Som alla tidsfrister kan förslaget minska flexibiliteten och öka personalbehovet i någon mån.",
