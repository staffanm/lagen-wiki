    },
    {
      "forarbete_id": "a3.7.6",
      "sentiment": 0.5,
      "quote": "Förslaget skulle nämligen annars kunna försvåra möjligheten för överinstanserna att utveckla praxis när det gäller talerätten i enlighet med framförallt EU-rätten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.7.7",
      "sentiment": 0.5,
      "quote": "innebär förslaget bättre ordning och att regeringen får ta del av ett yttrande från domstolen när målet överlämnas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.7.8",
      "sentiment": 1.0,
      "quote": "Föreningen tillstyrker möjligheten för Mark- och miljööverdomstolen att avgöra mål av principiell betydelse med förstärkt sammansättning.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a4.6.3",
      "sentiment": -0.5,
      "quote": "Mark- och miljööverdomstolen behövs inte bara för att bilda prejudikat, utan även för att rätta till felaktiga domar genom gransknings- och ändringsdispens.",
