  "overall": {
    "sentiment": 0.0,
    "quote": "Tingsrätten delar utredningens bedömning att det finns möjligheter att få en kortare process i mark- och miljöärenden genom att slopa länsstyrelsen som överprövningsinstans och tillstyrker därför utredningens förslag i den delen. Domstolen anser däremot att förslagen om att ändra Mark- och miljööverdomstolen och Högsta domstolens roller har för stora nackdelar och avstyrker i stora delar dessa förslag.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a3.7.3",
      "sentiment": 0.5,
      "quote": "Domstolen delar uppfattningen att det finns förutsättningar att minska de totala handläggningstiderna om förslaget genomförs och förslaget innebär också en ökad enhetlighet i det svenska systemet för överprövningen av myndighetsbeslut i allmänhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.7.4",
      "sentiment": 0.5,
      "quote": "Domstolen delar uppfattningen att det finns förutsättningar att minska de totala handläggningstiderna om förslaget genomförs och förslaget innebär också en ökad enhetlighet i det svenska systemet för överprövningen av myndighetsbeslut i allmänhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.5.5",
      "sentiment": -1.0,
      "quote": "Det rättsområdet har, i likhet med mål enligt fastighetsbildningslagen, många frågor av mer juridisk än teknisk karaktär där Högsta domstolens särskilda kompetens som prejudikatinstans är värdefull för rättsutvecklingen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.6.3",
      "sentiment": -1.0,
      "quote": "Förslaget är alltså förenat med risk för materiellt felaktiga domar i mål av stor betydelse och innebär en särlösning som försvårar verksamheten vid domstolarna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.7.8",
      "sentiment": 1.0,
      "quote": "tingsrätten tillstyrker förslagen om ändrade sammansättningsregler i Mark- och miljööverdomstolen.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a3.7.6",
      "sentiment": 1.0,
      "quote": "Tingsrätten tillstyrker förslaget om att mark- och miljödomstolens avgörande inte ska få överklagas i mål som avser avvisning av överklagande som kommit in för sent och som har överklagats till mark- och miljödomstol.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a3.7.7",
      "sentiment": -0.5,
      "quote": "Att under sådana förhållanden under lång tid i detalj utreda och pröva en mängd andra komplicerade och omfattande frågor är processekonomiskt omotiverat och ett ödslande av resurser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7.3",
      "sentiment": -0.2,
      "quote": "Förslaget innebär att det behöver vidtas administrativa åtgärder med åtföljande tids- och resursåtgång, vilket kommer att minska de av utredningen förväntade fördelarna med införandet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.7.2",
      "sentiment": -0.2,
      "quote": "Även om ett mål ofta kan vara klart för avgörande efter ett sammanträde så finns det alltså tillfällen när ett mål inte är det.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.6",
      "sentiment": 0.2,
      "quote": "I förslaget till 12 kap. 12 § plan- och bygglagen bör ”ett” före plankostnadsavtal i båda stycken tas bort för att avsikten med regeln ska bättre avspeglas i lagtexten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.4",
      "sentiment": 0.2,
      "quote": "Förslaget till 5 kap. 11 b § första stycket plan- och bygglagen bör omformuleras så att det tydligare framgår att samråd ska ske efter att kommunen tagit ställning till frågan om planen kan antas medföra en betydande miljöpåverkan.",
      "quote_type": "grund"
    }
  ]
