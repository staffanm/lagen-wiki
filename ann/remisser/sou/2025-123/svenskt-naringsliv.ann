  "overall": {
    "sentiment": -0.5,
    "quote": "Svenskt Näringsliv menar dock att flera av utredningens förslag riskerar att försämra rättssäkerheten, minska flexibiliteten för seriösa huvudmän och skapa oproportionerliga hinder för utveckling och anpassning av verksamheter.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a10.4.1",
      "sentiment": -0.5,
      "quote": "Förslaget innebär att även mindre eller redan avhjälpta brister kan leda till fleråriga hinder, vilket väcker tydliga proportionalitetsinvändningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.5.2",
      "sentiment": -1.0,
      "quote": "Förslaget är oproportionerligt, då det i en stor koncern som driver ett flertal olika skolformer kan vara omöjligt att med full säkerhet redovisa tillsyner och när en tillsyn avslutas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec202",
      "sentiment": -0.8,
      "quote": "Sammantaget innebär kravet på adress ett reellt etableringshinder, särskilt för mindre huvudmän som saknar realistiska ekonomiska möjligheter att ansöka om att starta ny verksamhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec204",
      "sentiment": -0.8,
      "quote": "Ett fast elevantal är därför en oproportionerligt ingripande åtgärd som kraftigt begränsar verksamheternas handlingsutrymme och riskerar att inskränka elevers och vårdnadshavares valfrihet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.5.3",
      "sentiment": 0.0,
      "quote": "Svenskt Näringsliv anser att dagens bestämmelser enligt 2 kap 5 § skollagen om påtagligt negativa följder är fullt tillräckliga och leder till en tydlig bedömning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec215",
      "sentiment": -1.0,
      "quote": "Bestämmelsen avser kommunens omställning, inte enskilda elever, och fem år är ett rimligt riktmärke för någon som går i skolan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.5.4",
      "sentiment": 0.5,
      "quote": "Svenskt Näringsliv är dock av uppfattningen att ett kommunalt yttrande inte får innebära ett veto mot etablering av en fristående skola; därtill är valfriheten för föräldrar och elever allt för väsentlig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.2",
      "sentiment": -1.0,
      "quote": "Svenskt Näringsliv bedömer att nyttan av omstämplingen inte står i proportion till de negativa konsekvenserna för huvudmännen.",
      "quote_type": "grund"
    }
  ]
}