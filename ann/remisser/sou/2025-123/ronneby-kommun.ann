  "segments": [
    {
      "forarbete_id": "a11.5.4",
      "sentiment": 1.0,
      "quote": "Ronneby kommun bedömer att förslaget skapar en mer rättssäker process, minskar risken för ogenomtänkta etableringar och stärker kommunens planeringsförmåga avseende lokaler, personal och ekonomi.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.5.3",
      "sentiment": 1.0,
      "quote": "Den nya definitionen – konsekvenser som består längre än tre år och omfattar ekonomiska, organisatoriska och pedagogiska effekter – möjliggör mer förutsägbara bedömningar och stärker elevperspektivet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.3.1",
      "sentiment": 1.0,
      "quote": "Förslagen innebär att huvudmän med återkommande eller allvarliga missförhållanden inte kan starta eller förvärva nya verksamheter, vilket Ronneby kommun bedömer som nödvändigt för att värna barns trygghet och kvalitet i utbildningen.",
      "quote_type": "grund"
    },
    {
