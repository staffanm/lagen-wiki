  "overall": {
    "sentiment": -0.2,
    "quote": "Föräldraalliansen Sverige ser slutbetänkandets förslag som steg i rätt riktning, men inte som en tillräcklig reform.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a10.3",
      "sentiment": 0.5,
      "quote": "Det är rimligt att en huvudman som har återkommande eller allvarliga brister inte ska kunna expandera, starta nya verksamheter eller utöka befintliga verksamheter innan bristerna är åtgärdade och kvaliteten är säkerställd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.4",
      "sentiment": 0.5,
      "quote": "Det är angeläget att huvudmän eller ägare som inte bedöms kunna leva upp till skolförfattningarnas krav inte ska kunna expandera genom att förvärva redan godkända skolor.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.6",
      "sentiment": -1.0,
      "quote": "Om ägare kan fatta beslut som påverkar verksamhetens kvalitet, resurser, lokaler, organisation och långsiktighet bör de också ha insikt i skolans uppdrag och regelverk.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.5",
      "sentiment": 0.0,
      "quote": "Samtidigt riskerar ett strikt system med belägenhetsadress och högsta antal utbildningsplatser att försvåra för små och idéburna skolor.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.5.2",
      "sentiment": 0.2,
      "quote": "Föräldraalliansen Sverige vill dock framhålla att mindre, idéburna och icke-vinstdrivande huvudmän inte bör riskera kraftiga sanktioner för mindre avvikelser som inte påverkar elevernas rätt till utbildning, kvalitet eller trygghet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.5.3",
      "sentiment": 0.2,
      "quote": "För icke-vinstdrivande och idéburna huvudmän bör även positiva följder vägas in.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.5.4",
      "sentiment": 0.2,
      "quote": "Särskilt när ansökan gäller en icke-vinstdrivande eller idéburen huvudman bör yttrandet föregås av ett verkligt samråd mellan kommunen och huvudmannen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.2",
      "sentiment": -0.5,
      "quote": "Befintliga tillstånd är gynnande beslut, och förändringar som i praktiken begränsar en huvudmans möjligheter måste hanteras varsamt.",
      "quote_type": "grund"
    }
  ]
}