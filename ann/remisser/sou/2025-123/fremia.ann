  },
  "overall": {
    "sentiment": -0.4,
    "quote": "Fremia delar i grunden denna ambition, men bedömer att flera av förslagen, så som de utformats under rubrikerna om ny ansökan vid ändring av verksamheten, kommunernas yttranden samt förvärvsförbud, riskerar att: - öka administrationen och kostnaderna på ett sätt som missgynnar idéburna huvudmän, - förstärka kommunernas redan starka ställning i tillståndsprocessen och skapa intressekonflikter, - ge oproportionerliga konsekvenser för huvudmän som i grunden bedriver seriös och kvalitativ verksamhet men som, liksom i dag, kan få förelägganden vid tillsyn för mindre brister.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a11",
      "sentiment": -0.5,
      "quote": "Förslagen riskerar att medföra oproportionerlig administrativ börda och kostnader för mindre huvudmän, och kan leda till rättsosäkerhet genom långa handläggningstider.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec242",
      "sentiment": -0.5,
      "quote": "Förslagen riskerar att medföra oproportionerlig administrativ börda och kostnader för mindre huvudmän, och kan leda till rättsosäkerhet genom långa handläggningstider.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.5.4",
      "sentiment": -1.0,
      "quote": "Förslagen riskerar att förstärka intressekonflikter och missgynnar mindre aktörer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.4",
      "sentiment": -0.5,
      "quote": "Mot denna bakgrund finns en påtaglig risk att ett föreläggande som rör mindre, ickesystematiska brister automatiskt får långtgående konsekvenser genom förvärvsförbud.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.4.1",
      "sentiment": -0.2,
      "quote": "Det bör klart framgå i lagtext och förarbeten att förvärvsförbud inte ska aktualiseras vid mindre, administrativa eller snabbt avhjälpta brister där elevens trygghet och utbildningens kvalitet inte varit allvarligt hotad.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.4.4",
      "sentiment": 0.2,
      "quote": "Möjligheten till förhandsbesked, som regleras i 35–37 §§, är viktig, men måste kombineras med skyndsam handläggning och tydliga kriterier, inte minst när seriösa huvudmän vill ta över problemtyngda verksamheter för att säkerställa kontinuitet för eleverna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.5",
      "sentiment": -0.2,
      "quote": "För att säkerställa rättssäkra och likvärdiga bedömningar är det av stor vikt att nationellt stödmaterial till kommuner tas fram och färdigställs innan den nya regleringen träder i kraft.",
      "quote_type": "grund"
    }
  ]
