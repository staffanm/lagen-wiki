    },
    {
      "forarbete_id": "sec202",
      "sentiment": 0.5,
      "quote": "Utredningen ger en övertygande bild av att nuvarande reglering, som inte kräver att dessa grundläggande uppgifter framgår av godkännandet, underminerar prövningen av påtagliga negativa följder.",
      "quote_type": "grund"
