    {
      "forarbete_id": "a6.2.8",
      "sentiment": 0.5,
      "quote": "Skolans, bibliotekens och museernas gemensamma arbete med kulturpedagogik och läsfrämjande bör stärkas och ges särskilda uppdrag och finansiering inom ramen för kanonprojektet.",
      "quote_type": "grund"
