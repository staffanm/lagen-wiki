    },
    {
      "forarbete_id": "a6.2.5",
      "sentiment": -0.5,
      "quote": "Det föreslagna antalet tryckta exemplar (5 000) bedöms som otillräckligt; en väsentligt större upplaga krävs för att säkerställa spridning till skolor, bibliotek och kulturinstitutioner i hela landet.",
      "quote_type": "grund"
