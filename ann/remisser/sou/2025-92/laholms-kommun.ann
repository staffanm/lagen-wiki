  "overall": {
    "sentiment": 0.5,
    "quote": "Laholms kommun ställer sig i huvudsak positiv till betänkandets ambition att stärka kunskapen om svensk kultur genom en nationell kulturkanon och att kultur och bildning utgör grundläggande förutsättningar för ett demokratiskt och sammanhållet samhälle.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a6.2.2",
      "sentiment": 0.2,
      "quote": "Styrelsen bör tillsättas med bred representation från kulturinstitutioner, folkbildning, utbildningsväsendet och civilsamhället, med fokus på transparens, sakkunskap och mångfald, för att motverka politisering och stärka förtroendet för projektet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2.8",
      "sentiment": -0.5,
      "quote": "implementering inom befintliga resurser riskerar att belasta redan ansträngda skolbudgetar, särskilt i mindre kommuner, och kan tränga undan andra kultur- och bildningsinsatser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1",
      "sentiment": -0.5,
      "quote": "Att använda dessa medel för en kulturkanon ligger utanför fondens ändamål och riskerar att direkt försvaga stöd till grupper med begränsad tillgång till kultur och bildning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2.3",
      "sentiment": -0.2,
      "quote": "översättningar till andra språk bör inte ske genom automatiserade metoder (AI), utan med etisk, språklig och kulturell sakkunskap.",
