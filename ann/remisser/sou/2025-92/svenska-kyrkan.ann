  "segments": [
    {
      "forarbete_id": "a6.2.2",
      "sentiment": 1.0,
      "quote": "Svenska kyrkan instämmer i bedömningen att en stiftelse kan vara en lämplig form för att härbärgera ett fortsatt arbete med kulturkanon.",
