    },
    {
      "forarbete_id": "a6.2.4",
      "sentiment": 0.5,
      "quote": "Svenska kyrkan tillstyrker därför att stiftelsen bör samverka med ett kanonnätverk, men menar att underlaget till detta även bör omfatta teologisk och kyrkohistorisk kompetens.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec537",
      "sentiment": 1.0,
      "quote": "Svenska kyrkan har inga särskilda synpunkter på förslagen att producera och visa en permanent kanonutställning i samarbete med ett museum, och att ta fram och sprida tryckt material om kulturkanon.",
      "quote_type": "standpunkt"
    },
    {
