    {
      "forarbete_id": "a6.2.2",
      "sentiment": -1.0,
      "quote": "Ett uttag på 150 miljoner kronor från fonden kommer att påverka dess möjlighet att stödja civilsamhället negativt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2.3",
      "sentiment": 0.5,
      "quote": "Det är viktigt att verken också tillgängliggörs digitalt för forskning.",
