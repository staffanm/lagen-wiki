  "segments": [
    {
      "forarbete_id": "a2.1.1",
      "sentiment": -0.8,
      "quote": "Utredarnas historieskrivning är felaktig då Sverige fram till år 1962 hade ett parallellskolesystem där social klass (och i viss mån kön) delade in elever i olika skolformer med skilda läroplaner.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.1.3",
      "sentiment": 0.2,
      "quote": "Man hade kunnat tänka sig att fler negativt laddade verk och företeelser inkluderades, eftersom de till lika stor del har format den svenska staten såsom den ser ut idag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2.2",
      "sentiment": -1.0,
      "quote": "Förslaget framstår som ett onödigt kostsamt och ofrånkomligt stelbent sätt att hantera frågan om en sådan rörlig materia som kulturyttringar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2.8",
      "sentiment": -1.0,
      "quote": "Att föra in den föreslagna kulturkanon är dock inte en lösning, då det riskerar att bidra till en fragmentariskt präglad undervisning på bekostnad av mer övergripande kunskaper om historiska skeden, samhällets utveckling och litterära strömningar i Sverige.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2.9",
      "sentiment": 0.2,
      "quote": "Däremot ser Uppsala universitet, liksom debattörer som tagit del av utredningen i offentlig debatt, att de valda verken även här har ett värde som fönster till svensk historia, rättstradition och vardagsliv i samband med introduktion av nyanlända.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3",
      "sentiment": -0.5,
      "quote": "Danska och nederländska forskare har kritiserat införandet av kanon i respektive länders skolor utifrån de uppenbara ideologiska nationalistiska bevekelsegrunder som drivit projekten, samt även visat brister i hur kanon implementerats i undervisning.",
      "quote_type": "grund"
    }
