  "segments": [
    {
      "forarbete_id": "a6.2.1",
      "sentiment": -0.2,
      "quote": "Om regeringen väljer att gå vidare med att inrätta en nationell kulturkanon bör det enligt Göteborgs universitet övervägas huruvida utredningens förslag om en självständig stiftelse är den bästa lösningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2.2",
      "sentiment": -1.0,
      "quote": "Göteborgs universitet motsätter sig förslaget om finansiering med kapital från Allmänna Arvsfonden, eftersom det skulle innebära ett politiskt ingrepp i en verksamhet som har till syfte att stödja ideella initiativ och intressen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2.3",
      "sentiment": -1.0,
      "quote": "Göteborgs universitet motsätter sig en digital portal och menar att det varken är vetenskapligt motiverat eller kostnadseffektivt att ge en ny stiftelse ansvaret att utveckla en sådan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2.4",
      "sentiment": -1.0,
      "quote": "En permanent kanonutställning riskerar att fungera just konserverande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2.5",
      "sentiment": -1.0,
      "quote": "Göteborgs universitet ställer sig tveksam till hur en illustrerad publikation skulle främja arbetet med kulturkanon och motsätter sig därför förslaget.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2.6",
      "sentiment": 0.5,
      "quote": "Om folkbildningen ska ta ett större ansvar, exempelvis för kulturkanon, måste resurserna anpassas för detta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2.7",
      "sentiment": -1.0,
      "quote": "Göteborgs universitet motsätter sig och vill varna för att en utvärdering efter 10 år i kombination med 50-årsgränsen för inkluderade verk riskerar att frysa en redan föråldrad bild av svensk kultur under lång tid.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2.8",
      "sentiment": -0.2,
      "quote": "Göteborgs universitet motsätter sig och vill varna för tvingande skrivningar i läroplaner, vilket kan inskränka lärarnas professionella frihet att tillsammans med eleverna välja lämplig litteratur.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2.9",
      "sentiment": -1.0,
      "quote": "Göteborgs universitet motsätter sig förslaget att integrera kulturkanon i SFI/samhällsorienteringen, som framför allt måste utvecklas utifrån forskning om andraspråksinlärning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": -1.0,
      "quote": "Organisationsformen för arbetet med kulturkanon behöver klargöras innan verksamheten startar och här vill universitetet åter påminna om den kunskap, kompetens och erfarenhet som finns hos befintliga aktörer inom utbildnings- och kultursektorn.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7",
