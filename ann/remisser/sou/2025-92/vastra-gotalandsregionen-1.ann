  "segments": [
    {
      "forarbete_id": "a6.2.1",
      "sentiment": 1.0,
      "quote": "VGR instämmer i utredningens bedömning att förvaltningen av kulturkanonen bör organiseras så att den fredas från risken för politisk styrning.",
