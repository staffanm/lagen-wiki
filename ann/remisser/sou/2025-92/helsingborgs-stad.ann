  "segments": [
    {
      "forarbete_id": "a6.2.2",
      "sentiment": 0.5,
      "quote": "En särskild stiftelse kan vara en lämplig form under förutsättning att dess uppdrag och styrning regleras så att öppenhet, transparens och bred representation säkerställs.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2.3",
      "sentiment": 1.0,
      "quote": "Portalen bör utvecklas med funktioner som främjar lärande och fördjupning, vara pedagogisk, interaktiv och tillgänglig för alla.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2.4",
      "sentiment": 0.5,
      "quote": "De föreslagna regionala kanonprojekten är därför positiva, men förutsätter långsiktig finansiering och tydliga uppdrag till landets regionala och kommunala aktörer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2.8",
      "sentiment": 0.2,
      "quote": "Eventuella skrivningar i styrdokument bör dock utformas med varsamhet och i nära dialog med skolhuvudmän, lärare och kultursektorn så att de inte uppfattas som styrande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2.7",
      "sentiment": 1.0,
      "quote": "Relevans skapas genom att kombinera tradition och förnyelse, samt genom att involvera invånare i utvecklingsprocesser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1",
      "sentiment": -0.5,
      "quote": "De ekonomiska konsekvenserna behöver enligt stadens bedömning utredas mer ingående, särskilt gällande finansieringen av stiftelsen samt stöd till regionala och kommunala aktörer.",
      "quote_type": "grund"
    }
  ]
