  },
  "overall": {
    "sentiment": -0.2,
    "quote": "De regionala museernas ekonomiska situation måste stärkas om ett arbete med en regional kulturkanon ska kunna förverkligas.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a6.1",
      "sentiment": -0.5,
      "quote": "Vår bedömning är att det är svårt att finansiera denna form av kulturverksamhet på detta sätt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": 1.0,
      "quote": "Vi delar kommitténs betonande av att armlängds avstånd måste respekteras i arbetet med såväl en nationell som en regional kulturkanon.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.2.2",
      "sentiment": 0.2,
      "quote": "medel därifrån inte kan ersätta statens åtagande för att finansiera arbetet med kulturkanon.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2.3",
      "sentiment": 0.5,
      "quote": "För att få god spridning, förespråkar vi en pluralism av kommunikationskanaler.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2.4",
      "sentiment": 0.5,
      "quote": "Den svåra ekonomiska situationen måste lösas innan ytterligare uppgifter kan läggas på oss regionala museer, annars finns en stor risk att den verksamhet som bedrivs idag vid de regionala museerna måste stå tillbaka.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2.4",
      "sentiment": -0.5,
      "quote": "Det är på en regional nivå som stora delar av befolkningen tar del av kultur, och det är på den regionala nivån som en utställning om kulturkanon kan få sin bästa räckvidd – inte genom att placera den i ett centralt läge i Stockholm.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2.4",
      "sentiment": -0.2,
      "quote": "Genom pedagogiska program och inte minst utbildade museipedagoger, finns en möjlighet att arbeta med en kulturkanon riktat mot många olika samhällsgrupper.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2.7",
      "sentiment": -0.5,
      "quote": "Ska en kulturkanon omsättas i utställning och pedagogisk verksamhet, måste det finnas tid både för framtagande och förverkligande innan en revidering ska göras.",
      "quote_type": "grund"
    }
  ]
}