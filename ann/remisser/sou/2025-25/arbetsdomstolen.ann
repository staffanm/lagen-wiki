  "segments": [
    {
      "forarbete_id": "a6.7.1",
      "sentiment": -0.2,
      "quote": "Arbetsdomstolens bedömning är att den nya lagen kan väntas leda till att byggsyndikatet väcker talan mot arbetsgivare med kollektivavtal med annan arbetstagarorganisation i avsevärt fler lönetvister än tidigare, dvs. tvister som normalt är mer komplicerade än tvister om förhandlingsvägran.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7.3",
      "sentiment": -0.2,
      "quote": "Även förslaget om ett särskilt statsbidrag till arbetstagarorganisationer för att hjälpa irreguljära migranter att ta tillvara sina rättigheter enligt lagen (2013:644) om rätt till lön och annan ersättning för arbete utfört av en utlänning som inte har rätt att vistas i Sverige kan i förlängningen förväntas leda till fler processer i Arbetsdomstolen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8.2",
      "sentiment": 0.5,
      "quote": "Arbetsdomstolen föreslår att ett skyndsamhetskrav införs för mål där part har ett tidsbegränsat uppehållstillstånd enligt 5 kap. 15 d § utlänningslagen, förslagsvis likt det som gäller i tvister om ogiltigförklaring av uppsägning eller avskedande (se 43 § lagen [1982:80] om anställningsskydd).",
      "quote_type": "grund"
    }
  ]
