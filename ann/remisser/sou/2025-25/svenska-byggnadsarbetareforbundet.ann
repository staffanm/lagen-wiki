  "segments": [
    {
      "forarbete_id": "a4.2.5",
      "sentiment": 0.2,
      "quote": "beträffande de åtgärder som nämns, entreprenörsansvar för lön samt fördjupad kontroll av löner och andra ersättningar, är det inte helt korrekt att beskriva det som att Byggföretagen och Byggnads har kommit överens om dessa.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5",
      "sentiment": 0.5,
      "quote": "Om lagen ska fungera som ett skydd för den anställde behöver det emellertid i praktiken vara möjligt för denne att hävda bättre anställningsvillkor än de som arbetstillståndet grundades på.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.6",
      "sentiment": 1.0,
      "quote": "Byggnads tillstyrker förslaget om en sanktionsavgift för den som har tillämpat sådana arbets- och anställningsvillkor som har medfört att ett uppehållstillstånd för arbete har återkallats eller en ansökan om förlängt arbetstillstånd har avslagits.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.4.3",
      "sentiment": 1.0,
      "quote": "För att bekämpa dessa företeelser måste vi införa ett regelverk som kraftigt minskar incitamenten för att exploatera människor på arbetsmarknaden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7",
      "sentiment": 0.2,
      "quote": "Byggnads tillstyrker de tre förslag som syftar till att stärka papperslösas möjlighet att få ut lön under förutsättning att förslagen utreds närmare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.10.2",
      "sentiment": 0.5,
      "quote": "Byggnads anser emellertid att sanktionsavgiften bör höjas ytterligare samt att det föreslagna taket om 200 000 kronor ska slopas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.12.2",
      "sentiment": 0.5,
      "quote": "Byggnads anser emellertid att en regelbunden elektronisk överföring av personalliggare till Skatteverket ska ske, i enlighet med det till nämnda utredning bifogade särskilda yttrandet från Skatteverkets expert.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.12.3",
      "sentiment": 0.5,
      "quote": "Byggnads delar delegationens bedömning om att förslagen i SOU 2024:61 om åtgärder för att motverka fusk och arbetslivskriminalitet vid utförandet av bland annat rot- och ruttjänster bör genomföras, samt att utredningens förslag borde ha gått längre när det gäller de uppgifter en utförare ska lämna i samband med en begäran om utbetalning från Skatteverket.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.4",
      "sentiment": 1.0,
      "quote": "Byggnads delar delegationens bedömning om att det inte är lämpligt att i Sverige införa straffbestämmelser om lönestöld enligt norsk förebild",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.4.5",
      "sentiment": 1.0,
      "quote": "det finns skäl att överväga att införa en reglering med innebörd att den som träffar överenskommelse med en arbetstagare om att lön och andra ersättningar ska betalas tillbaka i efterhand eller att kvittning ska ske mot framtida lön ska kunna dömas till en straffrättslig påföljd.",
