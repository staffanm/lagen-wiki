  "overall": {
    "sentiment": 0.5,
    "quote": "Utredningen visar tydligt att arbetslivskriminalitet är ett omfattande och komplext problem som drabbar arbetstagare, seriösa företag och samhället i stort.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "sec21",
      "sentiment": -0.5,
      "quote": "det är en brist att delar av välfärdssektorn och andra högriskområden inte omfattas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5",
      "sentiment": 0.5,
      "quote": "För att få full effekt behöver lagen kompletteras med en bevislättnadsregel, och presumtionen bör gälla under hela arbetstillståndets löptid.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6",
      "sentiment": 0.2,
      "quote": "de föreslagna nivåerna är för låga och behöver höjas för att bli avskräckande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.10",
      "sentiment": 0.5,
      "quote": "nivåerna måste vara kännbara, särskilt för större företag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7",
      "sentiment": 0.5,
      "quote": "De tre föreslagna åtgärderna: utökat mandat för Diskrimineringsombudsmannen, statsbidrag till arbetstagarorganisationer och tillfälliga uppehållstillstånd. Bör ses som ett samlat paket och utvecklas vidare i en särskild utredning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.17.1",
      "sentiment": 1.0,
      "quote": "ett mer långtgående system för näringsförbud kan bli ett effektivt verktyg mot oseriösa aktörer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec806",
      "sentiment": 1.0,
      "quote": "Förbundet vill också betona vikten av att flera av de förslag som presenterats i delegationens tidigare betänkande (SOU 2024:14) nu realiseras, bland annat införandet av en myndighetsgemensam tipsfunktion.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.14",
      "sentiment": -0.2,
      "quote": "Det innebär att lagen om offentlig upphandling bör ses över med fokus på sociala villkor, obligatorisk uppföljning och tydliga sanktionsmöjligheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.6",
      "sentiment": -0.5,
      "quote": "En allvarlig brist i betänkandet är att arbetsmiljöfrågorna i stort sett utelämnats.",
      "quote_type": "grund"
