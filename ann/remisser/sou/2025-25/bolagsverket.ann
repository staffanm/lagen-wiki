  "overall": {
    "sentiment": 0.2,
    "quote": "Bolagsverket är generellt positivt till betänkandets förslag till en ny funktion för vidareförmedling av registeruppgifter om företag, då den kan bidra till att dels förenkla uppgiftsinhämtning för företag, dels också motverka arbetslivskriminalitet, organiserad brottslighet och att företag utnyttjas för brottslig verksamhet.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a1.6",
      "sentiment": -0.2,
      "quote": "Ordvalet riskerar att medföra att bestämmelserna om teknisk bearbetning och teknisk lagring i 2 kap. 9 och 13 §§ tryckfrihetsförordningen inte kommer att vara tillämpliga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.15.9",
      "sentiment": -0.2,
      "quote": "Betänkandets resonemang om varför den föreslagna funktionen för en samordnad vidareförmedling av registerinformation om företag bör tillhandahållas av en offentlig aktör behöver kompletteras med analys av eventuell risk för att den konkurrerar med privat verksamhet, jfr, 3 kap. 27 § konkurrenslagen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.17.1",
      "sentiment": 0.5,
      "quote": "Som nämns i betänkandet kan upprepade och allvarliga regelöverträdelser göra att det bör anses påkallat med näringsförbud, även om regelöverträdelserna inte utgör brott enligt svensk lag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.17.3",
      "sentiment": -0.5,
      "quote": "anser Bolagsverket att ett återinförande av revisionsplikten måste övervägas noggrant, eftersom många företagare kommer att drabbas av både ökade kostnader och ökad administration.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.18",
      "sentiment": 0.8,
      "quote": "Bolagsverket delar betänkandets bedömning att brister i identitetsförvaltningen ger negativa konsekvenser för flera olika samhällsområden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8",
      "sentiment": -0.5,
      "quote": "En samordning av de två olika uppgiftskanalerna skulle visserligen kunna innebära vissa mindre fördelar ur ett teknikutvecklingsperspektiv, men för Bolagsverket skulle det också medföra en omfattande ökning av resursbehovet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.7.2",
      "sentiment": 0.2,
      "quote": "Även om viss information är samma i de båda uppgiftskanalerna, kan de sannolikt inte använda samma tekniska infrastruktur.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.7.11",
      "sentiment": -0.2,
      "quote": "Det finns en risk för att en avgiftsfri funktion påverkar Bolagsverkets intäkter negativt, vilket kommer att påverka finansieringen av myndighetens verksamhet.",
