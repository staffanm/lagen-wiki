  "segments": [
    {
      "forarbete_id": "sec501",
      "sentiment": 0.5,
      "quote": "I detta sammanhang vill Malmö stad lyfta behovet av att säkerställa att informationsutbyte kan ske i enlighet med dataskyddsförordningen och offentlighets- och sekretesslagstiftning vid bland annat begäran om utlämnande av handling.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.5",
      "sentiment": 1.0,
      "quote": "Malmö stad välkomnar en fortsatt utredning av frågan om det bör införas ett förbud mot förfaranden där arbetstagare på ett otillbörligt sätt betalar tillbaka en tidigare utbetald lön till arbetsgivaren.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.7.3",
      "sentiment": 0.2,
      "quote": "Dessa människor befinner sig i en utsatt situation, vilket gör att organisationerna behöver arbeta uppsökande för att arbetstagarna ska kunna vända sig till dem.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.5.6",
      "sentiment": -0.5,
      "quote": "Det förekommer bedrägerier där personer beviljas ekonomiskt bistånd utifrån att de saknar sjukdomsgrundande inkomst och enligt läkarintyg saknar arbetsförmåga, samtidigt som personen i själva verket arbetar utan att betala skatt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5.2",
      "sentiment": 0.5,
      "quote": "Det rör till exempel samverkan mot organiserad brottslighet eller regionala center mot arbetslivskriminalitet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.8",
      "sentiment": -0.5,
      "quote": "Malmö stad vill lyfta att de föreslagna sanktionsavgifterna i avsnitt 6.6.8 är förhållandevis låga och Malmö stad bedömer inte att de kommer fungera avskräckande i tillräcklig utsträckning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.5",
      "sentiment": 1.0,
      "quote": "Malmö stad tillstyrker förslaget om att den lön som anges som grund för uppehållstillstånd ska gälla och att förändringar av villkor i anställningsavtal ska meddelas Migrationsverket.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.8.2",
      "sentiment": 0.2,
      "quote": "För Malmö stad är det viktigt att försörjningsfrågan för den enskilde under det tillfälliga uppehållstillståndet förtydligas.",
