  "overall": {
    "sentiment": 0.5,
    "quote": "TCO tillstyrker flertalet av delegationens förslag i det aktuella slutbetänkandet som bör underlätta för utsatta arbetstagare att hävda sina rättigheter.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "sec338",
      "sentiment": 0.2,
      "quote": "TCO anser därför att det är mycket viktigt att kvaliteten på statistiken i utstationeringsregistret förbättras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.2",
      "sentiment": 1.0,
      "quote": "TCO delar delegationens bedömning att det finns skäl att överväga åtgärder som kan stärka den svenska arbetsmarknadsmodellen, för att till exempel motverka att arbetstagare utnyttjas och konkurrensen snedvrids.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.3",
      "sentiment": 0.5,
      "quote": "TCO beklagar att delegationen inte har haft möjlighet, tid eller resurser att göra den bredare översyn som hade krävts för att lämna förslag på reviderade eller nya bestämmelser mot arbetskraftsexploatering.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.4",
      "sentiment": 1.0,
      "quote": "TCO:s uppfattning är att sådana bestämmelser inte är förenliga med den svenska arbetsmarknadsmodellen, samt att utsikterna för att de skulle vara effektiva är små, både utifrån den omfattande utredning i enskilda ärenden sådana bestämmelser skulle innebära, samt de norska erfarenheterna med få åtal och fällande domar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.5",
      "sentiment": 0.0,
      "quote": "För TCO är det centralt att en eventuell fortsatt utredning eller ett hypotetiskt förslag på området, inte på något sätt får innebära några begränsningar av fackförbundens möjligheter att företräda sina medlemmar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.6",
      "sentiment": 0.2,
      "quote": "TCO anser att delegationen i sina resonemang om kollektivavtalsbrott och rätt till villkor i kollektivavtal kommer väldigt nära frågor som arbetsmarknadens parter reglerar och att eventuella förslag på området riskerar att rubba balansen mellan parterna vilket kan få långtgående konsekvenser för hela arbetsmarknaden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.2",
      "sentiment": 1.0,
      "quote": "TCO delar delegationens bedömning att det finns skäl – till och med starka skäl – att stärka skyddet för arbetstagare med arbetstillstånd i fall där arbetsgivare inte har tillämpat de anställningsvillkor som har varit en förutsättning för tillståndet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.5",
      "sentiment": 0.5,
      "quote": "TCO anser att regeringen i den fortsatta beredningen av denna fråga bör överväga att presumtionen sträcks ut till att omfatta en längre period och, om möjligt, hela tillståndstiden, ifall frågan om under vilken tid som arbete har utförts är tvistig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.6",
      "sentiment": 1.0,
      "quote": "TCO tillstyrker delegationens förslag.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.5.7",
      "sentiment": 1.0,
      "quote": "TCO tillstyrker delegationens förslag.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.5.8",
      "sentiment": 1.0,
      "quote": "TCO tillstyrker delegationens förslag att tillämpningen av den föreslagna lagen ska handläggas enligt lagen om rättegången i arbetstvister.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.6.5",
      "sentiment": 1.0,
      "quote": "TCO delar delegationens bedömning att arbetsgivares ansvar för att tillämpa minst sådana anställningsvillkor som har varit en förutsättning för arbetstillståndet för en utlänning med arbetstillstånd bör skärpas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.6",
      "sentiment": 1.0,
      "quote": "TCO tillstyrker delegationens förslag att den som har tillämpat villkor som är sämre än de villkor som låg till grund för ett arbetstillstånd eller förlängt arbetstillstånd, och som har lett till att tillstånden återkallats eller en ansökan om förlängning har avslagits, ska betala en sanktionsavgift.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.6.8",
      "sentiment": 0.5,
      "quote": "TCO anser därför att sanktionsavgiften ska vara minst på samma nivå som den högre nivå på den särskilda avgiften för arbetsgivare som anställer arbetstagare utan nödvändiga tillstånd som föreslogs i SOU 2024:15",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7.2",
      "sentiment": -1.0,
      "quote": "DO har enligt sin instruktion expertkompetens inom diskrimineringslagen och föräldraledighetslagen men har ingen expertkompetens inom den typ av arbetsrättsliga tvister som delegationens förslag handlar om.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7.3",
      "sentiment": 0.5,
      "quote": "TCO bedömer att fackförbunden – till skillnad mot en myndighet – har bättre utsikter att framgångsrikt kunna bistå irreguljära arbetskraftsmigranter att hävda sina rättigheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8.2",
      "sentiment": 1.0,
      "quote": "TCO anser att delegationens förslag fyller en mycket viktig funktion för att stärka enskildas möjligheter att hävda sina rättigheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.9",
      "sentiment": 0.5,
      "quote": "TCO vill även understryka vikten av att förslaget inte får innebära att medlen till andra former av människohandel minskar, utan att förändringen allra helst bör följas av en ökning av tillgängliga medel för arbete mot alla former av människohandel.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.10.2",
      "sentiment": 1.0,
      "quote": "TCO anser därför att det är mycket viktigt att sanktionsavgifterna sätts på en tillräckligt hög nivå för att ha en avskräckande effekt och indexeras för att effekten inte ska urholkas över tid.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.10.3",
      "sentiment": 1.0,
      "quote": "TCO delar delegationens uppfattning att en progressiv ökning av sanktionsavgiften har goda möjligheter att verka avskräckande för de arbetsgivare som medvetet begår upprepade överträdelser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.11.4",
      "sentiment": 1.0,
      "quote": "TCO ser precis som delegationen att en översyn av nystartsjobben är nödvändig eftersom stödformen är utformad på ett sätt som gör det svårt att motverka missbruk av den.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.15.9",
      "sentiment": 1.0,
      "quote": "TCO tillstyrker förslaget att Bolagsverket ska ansvara för uppgiften att tillhandahålla ett system för samordnad vidareförmedling av registerinformation om företag.",
