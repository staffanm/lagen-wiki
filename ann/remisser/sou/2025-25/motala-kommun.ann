    {
      "forarbete_id": "a6.15.8",
      "sentiment": 1.0,
      "quote": "En sådan lösning förväntas underlätta för upphandlande myndigheter att effektivt kontrollera uteslutningsgrunderna enligt 13 kap. lagen (2016:1145) om offentlig upphandling (LOU), vilket i sin tur stärker möjligheterna till en rättssäker upphandlingsprocess.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.14.1",
      "sentiment": 1.0,
      "quote": "Liknande risker förekommer även inom andra kommunala myndighetsområden, såsom beslut och tillsyn enligt alkohollagen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.14",
      "sentiment": 1.0,
      "quote": "Vår mening är att stort fokus bör läggas på hur upphandlande myndigheter kan och ska kontrollera de arbetsrättsliga villkoren under kontrakts fullgörande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5.2",
      "sentiment": 1.0,
      "quote": "Vidare instämmer Motala kommun i att kommuner bör involveras mer i de regionala centren mot arbetslivskriminalitet (AKC).",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": 1.0,
      "quote": "Avslutningsvis instämmer Motala kommun i att genom att förbättra informationsutbytet mellan olika myndigheter kan vi säkerställa en mer effektiv och samordnad hantering av ärenden, vilket i sin tur gynnar medborgarna och främjar en rättssäker förvaltning.",
      "quote_type": "grund"
