    },
    {
      "forarbete_id": "a6.4.5",
      "sentiment": 1.0,
      "quote": "Plattformen ser, i likhet med delegationen, ett behov av att reglera ett förbud mot återförande av lön, utbetald eller utlovad/avtalad",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.6",
      "sentiment": -0.5,
      "quote": "Plattformen delar inte delegationens uppfattning att det inte ﬁnns skäl att företa ändringar i regelverket kring utstationering och konstaterar att det är en fråga som lämnas olöst",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8",
      "sentiment": 0.5,
      "quote": "Plattformen instämmer i delegationens slutsats att det ﬁnns ett behov att öka medvetenheten hos socialtjänsten, men även polisen, om möjligheterna med tillfälliga uppehållstillstånd",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8.2",
      "sentiment": 1.0,
      "quote": "Plattformen välkomnar möjligheterna till utökade uppehållstillstånd för dem som vill hävda sin rätt",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.7.2",
      "sentiment": 1.0,
      "quote": "den civilrättsliga ordning, som föreslås t ex i den i och för sig välkomna Lagen om lön och andra ersättningar för utstationerade eller utländska arbetstagare med arbetstillstånd förutsätter, trots den roll arbetstagarorganisationerna åläggs, en kunskap och kompetens som de berörda arbetstagarna i regel inte besitter.",
