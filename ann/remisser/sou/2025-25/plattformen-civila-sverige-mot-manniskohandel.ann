  "segments": [
    {
      "forarbete_id": "a6.9",
      "sentiment": 0.5,
      "quote": "Plattformen vill understryka att en utvidgning av möjligheten till ersättning till civilsamhället förutsätter en ökning av de tillgängliga beloppen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.3",
      "sentiment": 0.5,
      "quote": "Plattformen delar delegationens uppfattning att en förändring, och förtydligande i den straffrättsliga regleringen av brotten är viktig och nödvändig, bland annat av hänsyn till Sveriges internationella åtaganden och menar, i likhet med delegationen, att det bör tas ett helhetsgrepp.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.4",
      "sentiment": -0.2,
      "quote": "Plattformen delar inte uppfattningen att begreppet lönestöld skulle vara främmande i en svensk kontext",
