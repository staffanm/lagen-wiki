    },
    {
      "forarbete_id": "a6.2",
      "sentiment": 1.0,
      "quote": "Visita anser att ovanstående är helt avgörande för att arbetet mot arbetslivskriminalitet ska fungera i praktiken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.3",
      "sentiment": 0.0,
      "quote": "Fel begås ofta av okunskap, inte i syfte att fuska eller spara pengar otillbörligt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.4",
      "sentiment": 1.0,
      "quote": "Visita delar bedömningen att det inte är lämpligt att i Sverige införa straffbestämmelser om lönestöld enligt norsk förebild.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.4.5",
      "sentiment": -1.0,
      "quote": "Problemet är inte själva avtalet, utan vilseledandet – det är det som bör kriminaliseras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.4",
      "sentiment": 1.0,
      "quote": "Visita delar bedömningen att det inte är lämpligt att i detta sammanhang lägga fram förslag om särskilda regler om skadestånd på den grunden att arbetsgivaren till en utlänning med arbetstillstånd inte tillämpar minst sådana villkor som har varit en förutsättning för tillståndet.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.5.5",
      "sentiment": -1.0,
      "quote": "Förslaget kan också medföra att arbetsgivare får betala för tid då arbetstagaren inte arbetat.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6",
      "sentiment": -1.0,
      "quote": "Kostnaden vältras istället över på företagen – i form av ökad administration och höga avgifter även vid oavsiktliga fel.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7",
      "sentiment": -1.0,
      "quote": "Dock är det främmande att en statlig myndighet ska föra talan för människor som vistas eller vistats illegalt i landet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8",
      "sentiment": -1.0,
      "quote": "Men en utökning av möjligheterna till tillfälliga uppehållstillstånd medför risk för missbruk och att möjligheterna utnyttjas medvetet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.10",
      "sentiment": -1.0,
      "quote": "Högre sanktionsavgifter medför att affärsrisken för utländska tjänsteutövare ökar, vilket kommer att motverka rörligheten av tjänster på den inre marknaden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.11.4",
      "sentiment": 0.5,
      "quote": "Det är därför avgörande att kontrollåtgärderna inte blir så betungande att arbetsgivare slutar använda dessa stödformer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.14",
      "sentiment": 1.0,
      "quote": "Visita delar bedömningarna beträffande leverantörskontroll vid offentlig upphandling.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.15.5",
      "sentiment": 1.0,
      "quote": "Visita anser att det är viktigt att företag har tillgång till uppgifter som behövs för att göra kontroller som motverkar arbetslivskriminalitet vid upphandlingar, både av leverantörer och underentreprenörer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.17.3",
      "sentiment": 0.2,
      "quote": "Kostnaden som revisionsplikt innebär kan mycket väl medföra att sådana små bolag aldrig startas eller läggs ned.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.3.1",
      "sentiment": 1.0,
      "quote": "Visita delar bedömningen att det finns behov av att stärka förmågan att utvärdera den samhällsekonomiska effektiviteten i kriminalpolitiken i bred bemärkelse och att Regeringen bör överväga att utveckla Brås uppdrag i denna riktning.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.3.3",
      "sentiment": 1.0,
      "quote": "Styrningen är helt avgörande för att få de samverkande myndigheternas arbete mot arbetslivskriminalitet att fungera.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.2",
      "sentiment": 1.0,
      "quote": "Det är naturligt att personer från tredjeland, som inte känner till det svenska regelverket och ofta saknar språkkunskaper, löper högre risk att utsättas för arbetslivskriminalitet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5.1",
