  "segments": [
    {
      "forarbete_id": "a7.1",
      "sentiment": 1.0,
      "quote": "För att förtydliga och uppmärksamma detta, men också för att komma åt privat användning av illegal iptv för att ta del av innehåll som inte skyddas av upphovsrättslagen, är det - som utredningen konstaterar - nödvändigt att ändra avkodningslagen genom att införa ett förbud mot privat nyttjande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec58",
      "sentiment": 1.0,
      "quote": "Dock har teknikutvecklingen varit sådan att tillgången till illegala tjänster sker på nya sätt, t.ex. utan att någon avkodning krävs, vilket har medfört att det idag uppstått en olycklig oklarhet kring i vilken utsträckning den aktuella bestämmelsen kan tillämpas på illegala iptv-tjänster.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec59",
      "sentiment": 1.0,
      "quote": "De föreslagna förbudet mot privat innehav medför tillsammans med det föreslagna förbudet mot privat nyttjande en ökad tydlighet för konsumenten rörande de illegala tjänsterna och bör minska efterfrågan och bidra till att minska den organiserade brottsligheten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec60",
      "sentiment": 1.0,
      "quote": "Förbudet i marknadsföringslagen är inte tillräckligt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2",
      "sentiment": 1.0,
      "quote": "En uppdatering ger en enhetlig påföljdstillämpning och leder till att straffskalan ligger i linje med övriga immaterialrättsbrott, såsom brott mot upphovsrättslagen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.3",
      "sentiment": 1.0,
      "quote": "Specialdomstolarna har fördjupad kunskap om immaterialrätt vilket säkerställer kvalificerade beslut och en enhetlig rättstillämpning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": 1.0,
      "quote": "Vi instämmer i bedömningen i 7.4. om att inga övergångsbestämmelser är nödvändiga.",
