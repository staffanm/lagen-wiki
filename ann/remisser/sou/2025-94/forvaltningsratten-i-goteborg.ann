  "overall": {
    "sentiment": 0.5,
    "quote": "Förvaltningsrätten har, utifrån de aspekter som domstolen har att beakta, inget att invända i sak mot de förslag som lämnas i betänkandet.",
    "quote_type": "standpunkt"
