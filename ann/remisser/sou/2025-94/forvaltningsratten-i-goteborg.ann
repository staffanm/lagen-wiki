  "segments": [
    {
      "forarbete_id": "sec62",
      "sentiment": -0.5,
      "quote": "Hänvisningen i 9 § första meningen ska rätteligen avse bestämmelsen i 6 § första stycket, enligt vilken en säkerhetskontroll ska inriktas på att upptäcka vapen och andra föremål som är ägnade att användas vid sådana gärningar som anges i 1 §.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a17.7",
      "sentiment": -0.2,
      "quote": "Det framgår inte varför en motsvarande reglering inte anses nödvändig i den föreslagna lagen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a20.2",
      "sentiment": -0.2,
      "quote": "Någon bestämmelse om samråd finns inte i den föreslagna lagen om säkerhetskontroll och det saknas även en motivering till detta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a17.4",
      "sentiment": -0.2,
      "quote": "Detta är särskilt relevant eftersom kroppsvisitation innebär ett ingrepp i skyddet enligt 2 kap. 6 § regeringsformen mot påtvingade kroppsliga ingrepp, och därför endast bör utföras när det är nödvändigt.",
      "quote_type": "grund"
    }
  ]
}