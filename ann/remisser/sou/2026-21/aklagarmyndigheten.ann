  "overall": {
    "sentiment": 0.0,
    "quote": "Mot denna bakgrund måste varje begränsning av det grundlagsskyddade medborgarskapet vila på starka skäl och utformas med höga krav på legalitet, tydlighet, förutsebarhet och rättssäkerhet.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a8",
      "sentiment": 0.5,
      "quote": "En ordning som innebär att medborgarskapsbeslut som tillkommit på ett illojalt eller bedrägligt sätt inte kan angripas i efterhand riskerar att undergräva förtroendet för rättsordningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.8",
      "sentiment": 0.5,
      "quote": "Myndigheten delar dock utredningens bedömning att situationen skiljer sig från fall där återkallelse grundas på brottslighet och att det är förenligt med konventionsåtagandena att i dessa situationer, under tydligt angivna förutsättningar och med beaktande av barnets bästa, låta barnets medborgarskap följa förälderns.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.1",
      "sentiment": 0.2,
      "quote": "Det framstår som rimligt att Sverige kan lösgöra sig från sina förpliktelser mot den som direkt angriper Sveriges centrala intressen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.4",
      "sentiment": -0.5,
      "quote": "den föreslagna avgränsningen av brottslighetens allvar inte uppfyller rimliga krav på tydlighet och förutsebarhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.6",
      "sentiment": -0.5,
      "quote": "Att låta sådana domar ligga till grund för återkallelse av ett svenskt medborgarskap riskerar att stå i konflikt med högt ställda svenska krav på rättssäkerhet, legalitet och förutsebarhet, om inte tydliga begränsningar och kvalitetskrav införs.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11",
      "sentiment": -1.0,
      "quote": "Den brottskatalog som föreslås i detta alternativ är mycket omfattande och saknar i allt väsentligt en tydlig koppling till brott riktade mot staten som sådan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.2",
      "sentiment": 0.5,
      "quote": "Det är viktigt att regelverket utformas så att återkallelseförfarandet inte framstår som en ny prövning av samma gärning eller som ett förtäckt straff.",
      "quote_type": "grund"
    }
  ]
