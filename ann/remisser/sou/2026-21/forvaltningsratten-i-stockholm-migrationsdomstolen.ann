  "segments": [
    {
      "forarbete_id": "a8",
      "sentiment": 0.5,
      "quote": "Domstolen har ingen erinran mot denna del av förslaget, utom att vi föreslår ett förtydligande av barnperspektivet, se nedan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec8",
      "sentiment": 1.0,
      "quote": "förordar domstolen det alternativ som innebär att det svenska medborgarskapet får återkallas för den som har dömts för brott som allvarligt hotar Sveriges säkerhet.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a11",
      "sentiment": -1.0,
      "quote": "Det alternativet skulle såvitt domstolen kan bedöma innebära en allt för ingripande ordning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.3.1",
      "sentiment": -0.5,
      "quote": "Domstolen anser att sannolikt är ett för lågt beviskrav sett till de konsekvenser en återkallelse av medborgarskapet kan förväntas få för den enskilde (se t.ex. prop. 2009/10:31 s. 114 f).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec220",
      "sentiment": -0.2,
      "quote": "Domstolen anser således att en (1) bestämmelse om att barnets bästa ska beaktas vid samtliga fall av återkallelse av svenskt medborgarskap tas in i en separat bestämmelse.",
      "quote_type": "grund"
