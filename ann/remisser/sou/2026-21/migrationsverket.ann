  "segments": [
    {
      "forarbete_id": "a8.3.2",
      "sentiment": -0.5,
      "quote": "Genom att undanta barn som fått svenskt medborgarskap från födseln men där uppgiften om föräldraskapet visar sig felaktig, från bestämmelserna om återkallelse av medborgarskap, upprätthålls en reglering som i praktiken möjliggör fortsatt handel med svenskt medborgarskap.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5.3",
      "sentiment": 0.2,
      "quote": "Migrationsverket önskar här betona att en återkallelse av ett svenskt medborgarskap för en person som bor och har sin familj i Sverige, inte är att likställa med en utvisning från Sverige med en familjesplittring som följd då grund för annan vistelserätt kan föreligga (jmf EU- domstolens dom i mål C- 221/17).",
      "quote_type": "grund"
    },
    {
