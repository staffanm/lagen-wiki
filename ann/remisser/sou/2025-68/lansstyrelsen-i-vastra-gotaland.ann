  "overall": {
    "sentiment": 0.5,
    "quote": "Länsstyrelsen ställer sig i stort bakom de förslag som redovisas i betänkandet.",
    "quote_type": "standpunkt"
  },
  "segments": [
    {
      "forarbete_id": "a2.4",
      "sentiment": -0.5,
      "quote": "Länsstyrelsen anser dock att utredningens förslag riskerar att medföra ytterligare en resurskrävande analysprocess för enskilda aktörer, parallellt med andra etablerade processer som kontinuitetshanteringen eller risk- och sårbarhetsanalysen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.4.3",
      "sentiment": 0.5,
      "quote": "Det finns emellertid vidare behov av att utveckla arbetssätt för hur rutiner och kontakterna mellan samhällsviktiga aktörer sker horisontellt, samt rutiner för hur kontakter mellan aktörer som verkar på lokal, regional och nationell nivån bör ske.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.6",
      "sentiment": -0.2,
      "quote": "Däremot anser Länsstyrelsen, till skillnad från utredningen, att en ändring i Upphandlingsmyndighetens instruktion skulle kunna bidra till en större tydlighet gällande beredskapsperspektivet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.7.2",
      "sentiment": -0.5,
      "quote": "Däremot är Länsstyrelsen av uppfattningen att utredningen inte på ett tillräckligt utförligt sätt redogör för varför inte kommuner och regioner ska kunna teckna nu nämnda avtal.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.7.3",
      "sentiment": 0.5,
      "quote": "Det är rimligt att civilområdesansvariga länsstyrelser, i egenskap av representanter av den högre regionala nivån, ges möjlighet att bidra med viktiga geografiska perspektiv när prioritering och fördelning av resurser ska ske.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.7.5",
      "sentiment": -0.5,
      "quote": "Detta då en sådan lösning generellt sett går emot upphandlingslagstiftningens grundläggande principer och riskerar att hämma eller snedvrida konkurrensen inom berörda branscher.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.7.8",
      "sentiment": 0.2,
      "quote": "Länsstyrelsen vill av denna anledning betona att utformningen av 15 kap. 2 § OSL är problematisk då det även finns uppgifter inom totalförsvaret på såväl lokal som regional nivå som är i stort behov av att kunna sekretessbeläggas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec184",
      "sentiment": 0.5,
      "quote": "Vidare ser Länsstyrelsen ett behov av att införandet av detta kansli kompletteras med ett tydligt uppdrag till aktörer med regional förankring, såsom civilområdesansvariga länsstyrelser, Trafikverket med flera.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.4",
      "sentiment": -0.2,
      "quote": "Länsstyrelsen bedömer att förslaget till resurstilldelning till länsstyrelserna även behöver ta hänsyn till vissa läns särskilda betydelse för den nationella försörjningsberedskapen.",
      "quote_type": "grund"
    }
