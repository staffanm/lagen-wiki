  "segments": [
    {
      "forarbete_id": "a3.1",
      "sentiment": 0.5,
      "quote": "Svenskt Näringsliv delar utredningens bedömning om att avtals- och författningsberedskap behöver stärkas samt att det inte finns en standardlösning som passar samtliga sektorer.",
