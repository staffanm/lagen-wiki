  "segments": [
    {
      "forarbete_id": "a2.1",
      "sentiment": 0.0,
      "quote": "Vi bedömer att det för vår sektor kan bli en utmaning, eftersom sektorn utrikeshandeln omfattar import och export av alla varor och tjänster.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.6",
      "sentiment": -0.2,
      "quote": "Mot bakgrund av att ett sådant krav inte är tydligt definierat utifrån mål och nivåer kopplat till försörjningsberedskap som ska säkerställas, kan det bli svårt att tillämpa för upphandlande myndigheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.7",
      "sentiment": 0.5,
      "quote": "Vår bedömning är därför att utrymmet för vad som är lämpligt att reglera i ett F-avtal bör analyseras närmare utifrån EU-rätten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.7.3",
      "sentiment": 0.5,
      "quote": "Det framgår dock inte på ett tydligt sätt i själva förordningsförslagen om bl.a. sektorsansvariga myndigheter också ska involveras i bedömningar om lämplig prioritering och fördelning av resurser i det konkreta fallet vid allvarliga försörjningsavbrott, vilket vi tror är lämpligt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.10",
      "sentiment": -0.5,
      "quote": "Kommerskollegium noterar, liksom utredningen, att ålägganden är ingripande åtgärder när det gäller avtals- och näringsfriheten, som bör tillämpas restriktivt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4",
      "sentiment": 1.0,
      "quote": "Kommerskollegium delar utredningens uppfattning att en byggnads- och reparationsberedskap behövs.",
