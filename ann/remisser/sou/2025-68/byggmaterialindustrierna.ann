  "segments": [
    {
      "forarbete_id": "a1.1",
      "sentiment": 0.5,
      "quote": "En förutsättning för ett väl fungerande system och en effektiv materialförsörjning är att BRB-kansliet samverkar med näringslivet samt kommuner och regioner.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a2",
      "sentiment": 0.2,
      "quote": "Genomförandet av försörjningsanalyser inom bygg- och anläggningssektorn behöver resurssättas och inledas omgående då en väl fungerande materialförsörjning är en förutsättning för en robust försörjningsberedskap.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.10.2",
      "sentiment": -1.0,
      "quote": "Tillgång till specifika material och produkter vid kris eller krig behöver säkerställas med marknadsmässiga avtal, inte tvång.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.7",
      "sentiment": 1.0,
      "quote": "Ett system byggt på förtroende, incitament och ömsesidig nytta är starkare, mer robust, resilient och hållbart än ett tvångsbaserat system.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.10",
      "sentiment": -1.0,
      "quote": "En mer effektiv strategi är fokus på utveckling av privat-offentlig samverkan inom beredskapssektorerna samt stärkta förutsättningar och lärande mellan sektorerna i samverkan med MSB, Tillväxtverket och det kommande BRB-kansliet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.1",
      "sentiment": 1.0,
      "quote": "Byggmaterialindustrierna delar synen på att myndigheter på central nivå behöver skapa förutsättningar för uppbyggnad av förmåga i hela landet, hos alla berörda aktörer - på central, regional och lokal nivå.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.3.5",
      "sentiment": 0.5,
      "quote": "Det är viktigt att civilplikten utformas så att den stärker företagens kontinuitetsplanering och personalförsörjning, utan att skapa administrativa eller ekonomiska hinder.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.2.2",
      "sentiment": 0.5,
      "quote": "det praktiska tillvägagångssättet behöver specificeras med en tydlig struktur för ansvar och mandat.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.3",
      "sentiment": 0.5,
      "quote": "Det är viktigt att ansvar och gränsdragningar mellan BRB-kanslierna hos Tillväxtverket och Boverket tydligt definieras och arbetet samordnas löpande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.3.4",
      "sentiment": 1.0,
      "quote": "Detta ökar sektorns överblick över de resurser som finns att tillgå, och var dessa befinner sig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.4",
      "sentiment": 0.5,
      "quote": "Finansieringen behöver i huvudsak ske genom statliga medel.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.5",
      "sentiment": 1.0,
      "quote": "då båda har viktiga roller i planeringen och genomförandet av åtgärder inom bygg- och anläggningssektorn och för effektiv materialförsörjning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1",
      "sentiment": 1.0,
      "quote": "Det är centralt för att försörjningen av byggmaterial ska fungera att det finns tydliga regelverk för eventuell dispens eller anpassning av kraven på provning och certifiering, samt CE-märkning eller annan produktmärkning, vid höjd beredskap, kris och krig, alternativt åtgärder som säkerställer bibehållen funktion.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": 1.0,
      "quote": "Berörda myndigheterna behöver också klargöra förutsättningarna för dispens från krav på CE-märkning eller annan produktmärkning, samt har planer och beredskap för snabb handläggning utan dröjsmål i kris och höjd beredskap.",
      "quote_type": "grund"
    }
  ]
