  "overall": {
    "sentiment": 0.5,
    "quote": "FOI tillstyrker förslagen om försörjningsberedskapshänsyn i upphandling, införandet av försörjningsberedskapsavtal (F-avtal) och behovet av en central funktion för byggnads- och reparationsberedskap – men efterlyser tydligare definitioner, samordning och fortsatt utredning av bland annat rättsliga förutsättningar.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a2",
      "sentiment": 0.2,
      "quote": "Snarare behövs olika typer av beredskapsåtgärder anpassade för att dämpa de värsta konsekvenserna av en eventuell försörjningskris.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.1",
      "sentiment": 0.2,
      "quote": "Ur ett totalförsvarsperspektiv kan det dock inte nog understrykas att det finns utmaningar med att inkludera privata aktörer i totalförsvarsplaneringen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.6",
      "sentiment": 1.0,
      "quote": "FOI tillstyrker utredningens förslag att upphandlingslagarna ska kompletteras med ett nytt beaktandekrav om försörjningsberedskapshänsyn.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a3.7",
      "sentiment": 0.2,
      "quote": "Utan närmare definition av F-avtal ser FOI en risk för utveckling av en avtalsflora bestående dels av ”renodlade F-avtal” som i alla delar och enbart syftar till att stärka näringslivets förmåga att hantera störningar och i övrigt skapa robusthet och dels av ”inköpsavtal” i bemärkelsen upphandlingskontrakt, med inslag av villkor avseende försörjningsberedskap.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.7.2",
      "sentiment": 0.2,
      "quote": "Systemet med Favtalsmyndigheter riskerar – trots sina fördelar – att belasta beredskapsplaneringen med ytterligare en nivå som i sin tur kräver ytterligare resurser och samordning, utöver de nivåer som redan finns i beredskapssystemet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.7.3",
      "sentiment": 0.2,
      "quote": "FOI anser att frågan om vilka aktörer som ska bidra till en allmän prioriteringsordning för försörjningsberedskap bör utredas mer ingående innan beslut fattas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.10",
      "sentiment": 1.0,
      "quote": "FOI delar utredningens uppfattning att lagstiftningen för fredstida avtalsrelationer och fullmaktslagstiftning för höjd beredskap bör kompletteras med en tvingande lagstiftning som ger möjlighet att ålägga företag att vidta vissa åtgärder för främjande av försörjningsberedskapen vid såväl fredstida kris, höjd beredskap som krig.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a4",
      "sentiment": 0.5,
      "quote": "Ur ett totalförsvarsperspektiv är en god förmåga att skyndsamt kunna reparera, bygga och anlägga såväl militär som civil infrastruktur en förutsättning för att såväl samhällsviktig verksamhet som det civila och det militära försvaret ska kunna fortsätta sin verksamhet i händelse av kris eller krig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.3.5",
      "sentiment": 1.0,
      "quote": "Att säkerställa personella resurser i dessa företag är således helt centralt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6",
      "sentiment": -0.2,
      "quote": "FOI anser att en djupare analys och avgränsning ska göras avseende vilken forskning som bör omfattas av ett eventuellt utökat uppdrag till RISE så att inte dubblering av nationell forskning och expertis riskeras.",
      "quote_type": "grund"
