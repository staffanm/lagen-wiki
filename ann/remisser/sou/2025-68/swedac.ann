    },
    {
      "forarbete_id": "a2.4",
      "sentiment": 0.5,
      "quote": "Swedac bedömer att det finns ett behov av en nationell samordning av arbetet med försörjningsanalyser, där även tvärsektoriella beroenden och behovet av ackrediterade och anmälda organ beaktas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a2.5.3",
      "sentiment": -0.2,
      "quote": "I en kris- eller krigssituation, då importmöjligheterna kan vara starkt begränsade, finns dock en risk att den svenska produktionskapaciteten inte är tillräcklig för att möta det inhemska behovet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1.2",
      "sentiment": -0.2,
      "quote": "Detta innebär att den internationella trovärdigheten och erkännandet av Sveriges nationella mätinfrastruktur i vissa avseenden kan påverkas negativt, då den sannolikt inte kan anses förenlig med ingångna internationella avtal på området.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1.4",
      "sentiment": -0.5,
      "quote": "Swedac vill även uppmärksamma risken för att RISE, genom ett utökat samhällsuppdrag med tillhörande finansiering, kan ges en konkurrensfördel gentemot andra svenska aktörer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": 0.5,
      "quote": "För att detta ska vara möjligt krävs dock att vissa grundläggande förutsättningar klargörs.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
