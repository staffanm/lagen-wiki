  "segments": [
    {
      "forarbete_id": "sec9",
      "sentiment": 0.8,
      "quote": "Det stödjer strävan att ur värnplikten mera flexibelt kunna utnyttja samhällets bredare förmågor.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec10",
      "sentiment": 0.8,
      "quote": "Genom att Försvarsmakten ges möjligheten att till den ”ordinarie” grundutbildningen (som normalt avslutas med en grundläggande krigsförbandsövning), lägga till ett skede där det färdigutbildade förbandet används för beredskapsuppgifter, ges möjligheten att avlasta anställda förbands verksamhet (som i säkerhetstjänst, flygbastjänst, sjöövervakning mm).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec11",
      "sentiment": 0.8,
      "quote": "Utredningens förslag att 180 dagar i stället ska vara gränsen för varje enskilt tillfälle ökar regeringens handlingsfrihet och är välbetänkt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9",
      "sentiment": 0.8,
      "quote": "Det är en förnuftigt korrigering av regelverket.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec12",
      "sentiment": 0.8,
      "quote": "Om yrkesofficerare utifrån sin anställning kan vara krigsplacerade när de är över 47 år, torde det vara möjligt att även krigsplacera förtidsavgångna över 47 år.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec13",
      "sentiment": 0.8,
      "quote": "Förslaget är bra då det gör det möjligt för Försvarsmakten att bygga upp större reserver.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec14",
      "sentiment": 0.5,
      "quote": "Det är rimligt när en mindre del av befolkningen är ianspråktagen att ersättningarna är förmånliga.",
