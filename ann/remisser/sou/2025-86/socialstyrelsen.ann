    {
      "forarbete_id": "a18.2",
      "sentiment": 0.2,
      "quote": "Inom beredskapssektor hälsa, vård och omsorg är personalförsörjning en utmaning redan i fredstid och Socialstyrelsen vill betona vikten av samråd och konsekvensutredning som omfattar konsekvenser för den civila hälso- och sjukvården i totalförsvaret.",
      "quote_type": "grund"
