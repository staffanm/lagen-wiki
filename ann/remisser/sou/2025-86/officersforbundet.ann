  "segments": [
    {
      "forarbete_id": "a9.5",
      "sentiment": -1.0,
      "quote": "Det är i grunden oskäligt att de som gjort en insats, baserad på frivilligt engagemang och avtal, ska bestraffas för detta i efterhand.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11",
      "sentiment": 0.5,
      "quote": "Dessa olikheter bör undanröjas så att rättvisa och attraktiva villkor bör gälla alla, oavsett roll i fred.",
