  "overall": {
    "sentiment": 0.2,
    "quote": "Förbundet Reservofficerarna är sammantaget nöjt med att ett antal värdefulla förändringar nu föreslås, inte minst lagstadgad rätt till tjänstledighet för reservofficerare.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "sec287",
      "sentiment": 1.0,
      "quote": "Oklarheter kring rätt till tjänstledighet har påverkat svensk försvarsförmåga negativt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec278",
      "sentiment": 1.0,
      "quote": "Förutsatt att Försvarsmakten erbjuder attraktiva villkor och inkomstbortfallet åtgärdas är Förbundets fasta övertygelse att fler reservofficerare kommer att vilja tjänstgöra.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.5",
      "sentiment": 1.0,
      "quote": "Förbundet delar utredningens bedömning avseende åtgärdsförslaget och att UHR:s föreskrifter är ett lämpligt sätt att reglera frågan.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a9.5",
      "sentiment": -1.0,
      "quote": "Förslaget riskerar urholka reservofficerares anställningar och deras roll som anställda, försvaga reservofficerskollektivets förhandlingsposition på ett dramatiskt sätt utan att ge någon vidare trovärdighet för krigsorganisationen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.6",
      "sentiment": -0.5,
      "quote": "Vi menar att det är ett reellt hinder för att bygga militär förmåga att tjänstgöringsvilliga reservofficerare nekas att förstärka Försvarsmaktens grundorganisation på ett för båda parter värdefullt sätt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.9.3",
      "sentiment": 1.0,
      "quote": "Goda villkor för värnpliktiga är avgörande för en hållbar rekrytering till det militära försvaret.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.9.4",
      "sentiment": 1.0,
      "quote": "Förbundet Reservofficerarna tillstyrker detta förslag.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a11.9.5",
      "sentiment": 0.0,
      "quote": "Vi tillstyrker även förslaget att dagpenningens storlek bör höjas från 90 procent av sjukpenninggrundande inkomst (SGI) till 100 procent av SGI.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a11.9.6",
      "sentiment": 1.0,
      "quote": "Vad gäller ersättning för resor tillstyrker vi utredningens förslag.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a15.10.2",
      "sentiment": 1.0,
      "quote": "Vad gäller ianspråktagande av tidvis tjänstgörande civil personal delar förbundet utredningens bedömning och tillstyrker förslaget.",
      "quote_type": "standpunkt"
    }
