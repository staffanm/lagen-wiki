  "segments": [
    {
      "forarbete_id": "a8.6",
      "sentiment": 0.5,
      "quote": "Detta förtydligande krävs då det är oklart hur lång tid som ska gå mellan varje tjänstgöringstillfälle, vilket kan leda till att samma totalförsvarspliktiga kallas med korta intervaller.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec150",
      "sentiment": 1.0,
      "quote": "Plikt- och prövningsverket tillstyrker utredningens förslag om att skyldigheten inte bör begränsas till värnpliktiga utan även bör omfatta de som krigsplacerats med civilplikt.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a9.5",
      "sentiment": 1.0,
      "quote": "Myndigheten delar utredningens mening att det vore olämpligt att en värnpliktig under pågående tjänstgöring, då det råder höjd beredskap, skulle avsluta tjänstgöringen enbart på grund av att han eller hon uppnår den övre åldersgränsen för värnplikt och därmed föranleda en vakans i det krigsförband där han eller hon tjänstgör.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec12",
      "sentiment": 0.5,
      "quote": "Myndigheten anser dock att förslaget bör inrymmas i samma regelverk som för personalreserv respektive värnpliktsreserv då en krigsplacering på ett förband utan föregående repetitionsutbildning inte kan ske.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.7.2",
      "sentiment": 0.5,
      "quote": "Myndigheten anser att det bör vara samma tillämpning för civilpliktiga inom Försvarsmakten som inte tjänstgjort under tio år, att han eller hon placeras i Försvarsmaktens personalreserv och däri ingå i en civilpliktsreserv.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.9.2",
      "sentiment": 0.2,
      "quote": "Myndigheten anser dock att nivåerna i den föreslagna höjningen inte är tillräckliga, särskilt i förhållande till civilpliktiga som skrivs in genom annan utredning än mönstring.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.9.4",
      "sentiment": 1.0,
      "quote": "Om ersättningen inte är anpassad efter den allmänna prisutvecklingen riskerar förmånssystemet, och i förlängningen även pliktsystemet, att uppfattas som orättvist.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.9.5",
      "sentiment": 1.0,
      "quote": "Då totalförsvarsplikten utgör en inskränkning i individens rättigheter, anser Plikt- och prövningsverket att den ersättning som den totalförsvarspliktige erhåller bör återspegla den insats som genomförs.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.5.1",
      "sentiment": -1.0,
      "quote": "Myndigheten anser att ett samlat råd för både värnpliktiga och civilpliktiga är mer ändamålsenligt då värnplikt och civilplikt regleras av samma lag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.4",
      "sentiment": 1.0,
      "quote": "Plikt- och prövningsverkets erfarenhet från inkomna frågor till myndigheten påvisar att det finns en osäkerhet bland allmänheten vad som gäller avseende ledighet från sin civila anställning, vid exempelvis repetitionsutbildning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.6.2",
      "sentiment": 1.0,
      "quote": "I takt med ett ökat behov av civilplikt även inom Försvarsmakten ser myndigheten att det behöver göras en helhetsanalys av totalförsvaret och dess behov där det tydligt framgår hur prioriteringar ska göras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.6.3",
      "sentiment": 0.5,
      "quote": "Myndigheten vill dock lyfta att de exempel på delfunktioner inom övrig logistik där civilplikt ska kunna fullgöras bör läggas till bland de verksamheter som anges i förteckningen under B. i bilagan till förordningen om totalförsvarsplikt i stället för att det samlas inom ett nytt verksamhetsområde med samlingsnamnet övrig logistik.",
      "quote_type": "grund"
    }
  ]
