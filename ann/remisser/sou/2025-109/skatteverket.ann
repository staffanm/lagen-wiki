  "segments": [
    {
      "forarbete_id": "a4.6.3",
      "sentiment": 1.0,
      "quote": "Skatteverket delar utredningens bedömning att de brottsbekämpande myndigheterna har behov av att kunna använda fordon med uppgifter som innebär att fordonen inte kan kopplas till myndigheterna och att uppgifterna om fordonen i statliga register – däribland folkbokföringen – ska vara fiktiva.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.7.4",
      "sentiment": 0.2,
      "quote": "Om förslagen i propositionen antas kan hänvisningen i 4 § inte kvarstå.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.7.5",
      "sentiment": -0.2,
      "quote": "Det har inte varit möjligt för Skatteverket att göra en fullständig analys av hur dessa och andra risker bör hanteras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.7.6",
      "sentiment": -0.5,
      "quote": "En sådan åtgärd skulle innebära stora kostnader för Skatteverket, och bör därför inte omfattas av de ändringar som föreslås kunna beslutas om enligt 7 § andra stycket i den föreslagna lagen om fiktiva fordonsuppgifter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.7.8",
      "sentiment": -0.2,
      "quote": "Med hänsyn härtill och den stora betydelse det har för det svenska samhället med korrekt folkbokföring och ett lågt folkbokföringsfel är det enligt Skatteverkets mening viktigt med en återkommande, effektiv och noggrann tillsyn av beslutsmyndigheterna.",
      "quote_type": "grund"
    }
  ]
