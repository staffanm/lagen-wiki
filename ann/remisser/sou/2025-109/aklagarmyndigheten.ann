  "overall": {
    "sentiment": -0.5,
    "quote": "Den relativa osäkerhet som följer med nuvarande oreglerade tillstånd skulle i mycket hög grad komma att kvarstå.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a3.11",
      "sentiment": 1.0,
      "quote": "Det är givetvis också riktigt att det finns ett tydligt behov av att kunna använda provokativa åtgärder i brottsbekämpningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.12",
      "sentiment": -0.2,
      "quote": "Med de här svårigheterna att bedöma hur en provokation ska betecknas är det en given nackdel att enbart lagreglera de särskilda provokativa åtgärderna, eftersom det skapar en skarp rättslig gräns mellan det tillåtna och det helt otillåtna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.12.3",
      "sentiment": -0.2,
      "quote": "Åklagarmyndigheten ser en risk att förslaget uppfattas på det sättet att det skulle vara förbjudet – inte bara oreglerat – att i underrättelseverksamhet vidta åtgärder som avser att provocera fram bevisning och annan information om brott och brottslighet, åtgärder som kan leda till att någon begår brott.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec171",
      "sentiment": -0.5,
      "quote": "Åklagarmyndigheten anser att kravet på att åtgärden ska vara av synnerlig vikt är en alltför restriktiv och återhållsam syn på provokativa åtgärder som arbetsmetod.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec173",
      "sentiment": -0.5,
      "quote": "Åklagarmyndigheten avstyrker dock en reglering som innebär att redan en aldrig så begränsad risk för personskada ska utesluta åtgärden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.13.4",
      "sentiment": -0.5,
      "quote": "Enligt Åklagarmyndighetens bedömning fungerar det sättet att avgränsa dåligt – det blir stelbent, svårtillämpat och riskerar att lämna angelägna områden utan rättsligt stöd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec184",
      "sentiment": -0.2,
      "quote": "Även i det här sammanhanget framstår parallellen med tvångsmedlet som omotiverad, även här blir gränsen för det tillåtna stelbent och svårtillämpad.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.13.5",
      "sentiment": -0.5,
      "quote": "Mot den bakgrunden är utredningen fåordig kring de principiella frågor som förslaget om att tillåta delning av fiktiva barnpornografiska bilder aktualiserar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.13.6",
      "sentiment": 1.0,
      "quote": "Åklagarmyndigheten instämmer i att särskilda provokativa åtgärder ska prövas och beslutas av åklagare, att det inte bör införas något krav på särskilda villkor och att de brottsbekämpande myndigheterna får genomföra åtgärden, men att endast Polismyndigheten ska få dela fiktiva barnpornografiska bilder om en sådan rätt tillskapas.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a3.13.7",
      "sentiment": 1.0,
      "quote": "Åklagarmyndigheten tillstyrker att särskilda provokativa åtgärder ska dokumenteras i förundersökningsprotokollet.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a3.14",
      "sentiment": 1.0,
      "quote": "Åklagarmyndigheten delar bedömningen att provokativa åtgärder som genomförs med stöd av en lagreglering inte ska kunna medföra straffrättsligt ansvar för det brott provokatören bidrar till.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a3.15",
      "sentiment": 1.0,
      "quote": "Åklagarmyndigheten delar utredningens bedömning att den provocerades ansvar ska prövas av domstol med utgångspunkt i gällande rätt.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a3.16",
      "sentiment": 1.0,
      "quote": "I likhet med utredningen instämmer vi i att åklagaren, med stöd av 20 kap. 6 § rättegångsbalken, ska avstå från att väcka åtal om det skulle innebära en kränkning av rätten till en rättvis rättegång att fälla till ansvar för brottet.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a3.17",
      "sentiment": 1.0,
      "quote": "Åklagarmyndigheten tillstyrker att tystnadsplikten ges företräde framför meddelarfriheten såvitt avser uppgifter som rör särskilda provokativa åtgärder.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a4",
      "sentiment": 1.0,
      "quote": "På de skäl som anförs i betänkandet tillstyrker Åklagarmyndigheten förslaget om fiktiva fordonsuppgifter för fordon som används i polismyndigheternas och Tullverkets verksamhet.",
      "quote_type": "grund"
    }
  ]
}