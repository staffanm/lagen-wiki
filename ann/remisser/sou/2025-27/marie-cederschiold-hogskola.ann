  "segments": [
    {
      "forarbete_id": "a6.1.1",
      "sentiment": -0.5,
      "quote": "Förståelse innebär att vi inte bara vet något, utan att vi också förstår hur och varför det hänger ihop.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1.1",
      "sentiment": -0.5,
      "quote": "Den här typen av omnämnande av specifika grupper riskerar att snabbt bli inaktuella.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1.1",
      "sentiment": -0.5,
      "quote": "Dessa aspekter ryms inom övriga examensmål.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1.1",
      "sentiment": -0.5,
      "quote": "Hedersrelaterat våld och förtryck ryms inom mäns våld mot kvinnor och våld i nära relationer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2.1",
      "sentiment": -0.5,
      "quote": "Förmåga handlar om kapaciteten att använda kunskaper och färdigheter på ett genomtänkt sätt, dvs. tillämpa, analysera, bedöma, kommunicera, samarbeta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2.1",
      "sentiment": -0.5,
      "quote": "Examensmålet är viktigt eftersom det ställer krav på att socionomutbildningen ska förbereda studenterna på att arbeta med socialt arbete på olika nivåer – individ-, grupp- och samhällsnivå.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2.1",
      "sentiment": -0.5,
      "quote": "Vi menar att examensmålet är svårtolkat då det är oklart vad som avses med att studenterna ska kunna diskutera nya fakta och frågeställningar med olika målgrupper och på vilket sätt bidrar det till utveckling av yrket och verksamheten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.1",
      "sentiment": 0.5,
      "quote": "Vi tillhör de lärosäten som har undervisning i juridik i denna omfattning så vi delar bedömningen att det är ungefär det som är rimligt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.1",
      "sentiment": 0.2,
      "quote": "Om studenterna ska vara placerade på VFU under samtliga veckor under sammanlagt en termin (dvs totalt 20 veckor) kommer vi ha mycket stora svårigheter att realisera detta på grund av bristen på tillgängliga VFU-platser.",
