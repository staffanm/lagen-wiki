  "overall": {
    "sentiment": 0.8,
    "quote": "Helsingborgs stad ser positivt på förslaget i stort om behovet av en bred översyn av utbildningen och anser att utredningen korrekt har analyserat systemhotande problem och utmaningar med tyngdpunkt på barn och unga i organiserad brottslighet och hedersförtryck.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a6.1.1",
      "sentiment": 0.8,
      "quote": "Samhällets snabba förändringstakt påverkar socialtjänstens uppdrag och medarbetarnas yrkesroll.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1.1",
      "sentiment": 0.8,
      "quote": "Staden vill betona att kunskap om förebyggande åtgärder och ett proaktivt förhållningssätt i detta sammanhang är och kommer att vara mycket betydelsefullt för nyutexaminerade socionomer, och helt i linje med det förebyggande fokus som den nya socialtjänstlagen betonar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1.1",
      "sentiment": 0.8,
      "quote": "Helsingborgs stad vill betona vikten av den fördjupning som utredningen föreslår med tanke på de allvarliga konsekvenserna av våld och hedersförtryck inom familjer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1.1",
      "sentiment": 0.8,
      "quote": "Det räcker inte att endast känna till symptomen, socionomer måste också förstå hur dessa symptom påverkar individens möte med samhället.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1.1",
      "sentiment": 0.8,
      "quote": "Samtidigt som utredningen betonar vikten av praktiska färdigheter hos socionomer som lämnar universiteten ser staden det som tillfredsställande att det även finns ett förstärkt fokus på att socionomer behöver hålla sig uppdaterade kring den nationella kunskapsbank som finns kring forskning och vetenskap inom socialt arbete.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2.1",
      "sentiment": 0.8,
      "quote": "Närståendes situation förbises ofta, möjligen på grund av tidsbrist, men ibland kanske av brist på förståelse för hur viktig deras medverkan är.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2.1",
      "sentiment": 0.8,
      "quote": "samverkan mellan olika samhällsaktörer är avgörande för ett gott socialt arbete.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.1",
      "sentiment": 0.8,
      "quote": "Förstärkt juridisk kunskap gör att socionomer bättre kan argumentera för insatser för barn som begår brott och erbjuda relevanta alternativ till onödiga påföljder.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.1",
      "sentiment": 0.8,
      "quote": "Idag är det upp till varje lärosäte att avgöra hur mycket verksamhetsförlagd utbildning som behövs för att studenten ska nå examensmålen. Det riskerar att medföra skillnader eller brister i nya socionomers praktiska färdigheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2.1",
      "sentiment": 0.8,
      "quote": "Kravnivåerna är avgörande, dvs de faktiska krav som ställs på studenterna och deras studieresultat genom en adekvat studietakt och examinationsformer som säkerställer att de har rätt kunskap och kan använda den med gott omdöme.",
      "quote_type": "grund"
    }
  ]
