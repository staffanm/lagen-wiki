  },
  "overall": {
    "sentiment": 0.2,
    "quote": "Högskolan i Jönköping välkomnar att slutbetänkandet från Utredningen om en översyn av socionomexamen – En socionomutbildning i tiden (SOU 2025:27) – syftar till att anpassa socionomprogrammet till dagens samhällsutmaningar, såsom ungdomskriminalitet, psykisk ohälsa och social utsatthet, men vi vill framhålla att flera av betänkandets förslag kräver ytterligare överväganden för att säkerställa en långsiktigt hållbar och högkvalitativ utbildning.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a6.1",
      "sentiment": -0.2,
      "quote": "Det är viktigt att examensmålen är långsiktigt hållbara och inte används som styrinstrument för att hantera aktuella frågor, eftersom detta kan underminera den professionella och akademiska utvecklingen av socionomrollen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec279",
      "sentiment": -0.5,
      "quote": "Att lägga till ett separat mål är inte nödvändigt och riskerar att fragmentisera utbildningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec280",
      "sentiment": -0.5,
      "quote": "Att skapa ett särskilt mål riskerar att fragmentisera förståelsen av våld som samhällsfenomen och kan försvaga helhetsperspektivet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": -0.2,
      "quote": "Vi anser att den juridiska utbildningen bör fokusera på de rättsområden som är mest relevanta för socialt arbete, exempelvis barnrätt, socialrätt, diskrimineringslagstiftningen och mänskliga rättigheter, vilket avviker från utredarens förslag att prioritera straffrätt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": 0.0,
      "quote": "Det är viktigt att tydliggöra vad omfattningen och innehållet innebär, för att säkerställa likvärdighet och hög kvalitet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec298",
      "sentiment": 1.0,
      "quote": "vi menar att detta kan bidra till en mer flexibel och integrerad utbildning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec308",
      "sentiment": 0.5,
      "quote": "Vi ser dock ett behov av att diskutera om det kan vara generella eller specifika arbetslivserfarenheter och vilken typ av arbetslivserfarenheter som gynnar verksamhetsanknytning och färdighetsträning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1",
      "sentiment": 0.2,
      "quote": "Dock delar vi inte utredningens uppfattning att en förlängd socionomutbildning bör vara den primära lösningen.",
      "quote_type": "grund"
    }
  ]
