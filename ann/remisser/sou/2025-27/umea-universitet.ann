  "segments": [
    {
      "forarbete_id": "sec81",
      "sentiment": -1.0,
      "quote": "Att ta bort det skulle riskera att försvaga den värdegrund och den reflexivitet som är nödvändig för socionomprofessionen – och därmed även kvaliteten i det sociala arbetet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec276",
      "sentiment": -1.0,
      "quote": "Införandet av detta examensmål riskerar att leda till ökad detaljstyrning av utbildningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec279",
      "sentiment": -1.0,
      "quote": "Utredningen och dess förslag vilar på en felaktig premiss – nämligen att socionomutbildningen i sin nuvarande utformning inte skulle ge studenterna tillräckliga kunskaper om hur ungdomskriminalitet kan förebyggas eller hur återfall kan motverkas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec280",
      "sentiment": -1.0,
      "quote": "Ett separat examensmål för hedersrelaterat våld riskerar att fragmentisera förståelsen av våld som samhällsfenomen och kan leda till en urholkning av helhetsperspektivet i utbildningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": 0.5,
      "quote": "Att kraftigt öka inslaget av juridik kan riskera att tränga undan andra centrala ämnesområden såsom psykologi, socialt arbete, etik, metod eller teoriutveckling.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": 0.5,
      "quote": "Om det inte tydligt specificeras vad som avses med omfattning och innehåll kan skillnader i tolkning uppstå, vilket kan motverka ett av utredningens egna mål – nämligen att främja likvärdighet mellan socionomprogrammen i landet och därigenom säkerställa en jämn kunskapsnivå hos nyexaminerade socionomer.",
      "quote_type": "grund"
