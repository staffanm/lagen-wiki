  "segments": [
    {
      "forarbete_id": "a6.1.1",
      "sentiment": -1.0,
      "quote": "Socialstyrelsen anser att det finns en risk att förslaget kommer att innebära att viktig tid för undervisning inom socionomprogrammet avsetts för starkt tidsbundna företeelser som forskningen ännu inte hunnit ge tillförlitlig kunskap om.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec277",
      "sentiment": 0.5,
      "quote": "Socialstyrelsen saknar dock en förklaring till att formuleringen i det nuvarande målet ändras, från ”visa kunskap om och förståelse för” till enbart ”visa kunskap om”.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec272",
      "sentiment": -1.0,
      "quote": "Socialstyrelsen anser att det krävs ytterligare beredning av hur ett nytt mål ska formuleras utifrån vilka kompetenser det ska omfatta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec279",
      "sentiment": -1.0,
      "quote": "Socialstyrelsen avstyrker förslaget i dess nuvarande utformning eftersom målet avser en typ av kunskap som enbart en mindre del av alla studenter på socionomutbildningen förväntas behöva och kunna använda.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec280",
      "sentiment": 0.5,
      "quote": "det finns andra begrepp som inkluderar hedersrelaterat våld och förtryck och som med fördel kan användas istället, exempelvis negativ social kontroll vilket är det uttryck som föreslås i Att omhänderta barn och unga och som innefattar hedersrelaterat våld och förtryck (se SOU 2025:38, s. 267).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec295",
      "sentiment": -1.0,
      "quote": "Kunskap i juridik är centralt för socionomer men det framgår inte av betänkandet varför nivån om minst 30 högskolepoäng är önskvärd och vilka delar av juridiken som bör ingå i dessa högskolepoäng.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1",
      "sentiment": 1.0,
      "quote": "En sådan utredning kan också göra de analyser, fördjupningar och kompletteringar som behövs för att förslagen i SOU 2025:27 ska kunna ligga till grund för förändrade bestämmelser.",
