  "segments": [
    {
      "forarbete_id": "a6",
      "sentiment": -0.2,
      "quote": "FSS ställer sig frågande till om förslagen till justeringar i examensordningen är rimliga och möjliga inom ramen för en oförändrad längd på socionomutbildningen.",
