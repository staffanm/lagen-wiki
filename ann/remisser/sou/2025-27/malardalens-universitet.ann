  "overall": {
    "sentiment": 0.2,
    "quote": "Mälardalens universitet (MDU) har tagit del av den aktuella remissen och ser positivt på att en översyn av socionomutbildningen har inletts i syfte att stärka dess relevans i en föränderlig och alltmer komplex samhällskontext.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a5.5",
      "sentiment": 0.2,
      "quote": "Detta innebär också att särskilt specialiserade metodkunskaper lämpar sig bättre för vidareutbildning på avancerad nivå, snarare än som ett generellt krav inom grundutbildningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec268",
      "sentiment": -0.2,
      "quote": "Att socialt arbete benämns som huvudområde istället för huvudämne beror inte på att det är ett val från universitetens sida för att det skulle vara bredare, utan en följd av ändringarna i Högskoleförordningens bilaga 2, examensordningen (SFS 2006:1053) som i sin tur låg till grund för Bolognaprocessen 2007.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec277",
      "sentiment": 0.2,
      "quote": "I stället för att betrakta vetenskap och beprövad erfarenhet som ett direkt samband, ser vi det som avgörande att dessa förstås som två distinkta men kompletterande kunskapskällor, som i den professionella praktiken behöver vägas samman, relateras till varandra och integreras med hänsyn till det aktuella sammanhanget.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec278",
      "sentiment": -0.5,
      "quote": "Att inkludera fasta målgruppsbeskrivningar kan leda till att examensmålen förlorar i långsiktig hållbarhet och relevans.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec279",
      "sentiment": -0.5,
      "quote": "Ett alltför snävt åldersfokus i examensmålen riskerar därmed att begränsa utbildningens generalistiska karaktär och dess anpassningsförmåga till olika verksamhetsområden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec280",
      "sentiment": -0.2,
      "quote": "Universitetet ser dock en utmaning i att examensmål som listar enskilda typer av våld eller specifika målgrupper riskerar att tappa i aktualitet och relevans över tid.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec288",
      "sentiment": 0.2,
      "quote": "Det är enligt vår mening avgörande att examensmålet uttryckligen omfattar denna analytiska dimension, i enlighet med utbildningens akademiska nivå.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec295",
      "sentiment": -1.0,
      "quote": "Ett sådant ingrepp innebär ett direkt hot mot den akademiska friheten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec303",
      "sentiment": 0.2,
      "quote": "För att säkerställa en likvärdig och rättssäker tillämpning nationellt bör begreppet definieras mer precist.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec305",
      "sentiment": 1.0,
      "quote": "Universitetet ser positivt på att de ekonomiska förutsättningarna för utbildningens VFU föreslås stärkas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec308",
      "sentiment": 1.0,
      "quote": "Universitetet ställer sig positivt till ett alternativt urval till socionomprogrammet då äldre sökanden med tidigare erfarenhet från arbetslivet skulle berika utbildningen samt socionomyrket.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.1",
      "sentiment": -0.2,
      "quote": "En sådan omfattning framstår i nuläget som överambitiös.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.2",
      "sentiment": -0.2,
      "quote": "Det riskerar bli en ökad akademisering utan nödvändig koppling till praktisk tillämpning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.3",
      "sentiment": -0.5,
      "quote": "Det saknas belägg för att en förlängd utbildning i sig skulle fungera som tillräcklig drivkraft.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.4",
      "sentiment": -0.5,
      "quote": "Målbilden att hälften av alla socionomer ska vara specialistsocionomer år 2040 kan ifrågasättas som orealistisk utan tydligare åtgärder, styrning eller finansiering.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.5",
      "sentiment": -0.5,
      "quote": "Mälardalens universitet kan här betona att innan strukturella förändringar föreslås, krävs en gedigen förståelse för behoven och hindren i det nuvarande systemet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2.1",
      "sentiment": -0.2,
      "quote": "En mer aktuell och evidensbaserad analys behövs innan generella slutsatser dras.",
