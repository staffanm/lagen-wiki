  "segments": [
    {
      "forarbete_id": "sec277",
      "sentiment": 0.5,
      "quote": "Det är ett tydliggörande av vad som ingår, men innebär inte någon förändring.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec278",
      "sentiment": -0.5,
      "quote": "Förslaget innebär att examensmålet förståelse tas bort vilket enligt Bolognareformen betyder lägre och förenklade lärandekrav.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec30",
      "sentiment": 1.0,
      "quote": "Tillstyrker.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec276",
      "sentiment": 0.5,
      "quote": "”samhällsutmaningar inom området” är en otydlig formulering.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec279",
      "sentiment": -0.5,
      "quote": "Denna tematik ryms i befintliga examensmål samtidigt som ungdomskriminalitet endast utgör ett av många områden för socionomer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec280",
      "sentiment": -0.5,
      "quote": "tillägget om hedersrelaterat våld och förtryck då befintligt examensmål förutsätts behandla detta samt andra relaterade våldsformer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec284",
      "sentiment": -0.5,
      "quote": "tillägget innebär en onödig specificering eftersom närstående redan omfattas av socionomers yrkesområden enligt nationella anhörigstrategin och socialtjänstlagen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec294",
      "sentiment": 0.5,
      "quote": "Formulering ”relevant kunskap” avvisas, men behålla ”inom ramen för socialt arbete”.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec34",
      "sentiment": 0.5,
      "quote": "Termen ”området” är otydlig och bör ersättas med termen ”socialt arbete”",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec288",
      "sentiment": -1.0,
      "quote": "Den nya formuleringen tillför inget av värde och borttagandet av de två gamla målen innebär att flera centrala delar i det sociala arbetet försvinner, exempelvis framskrivningen av ”sociala problem”.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec295",
      "sentiment": -0.5,
      "quote": "Går emot generell praxis och Bolognareformens målstyrning där kunskaper och färdigheter ska skrivas fram, inte specifika poäng i ett ämne.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a2",
      "sentiment": -0.2,
      "quote": "det finns en underliggande ton i hur uppdraget är beskrivet som i sig andas en oförtjänt misstro mot svensk socialtjänst och socionomers arbete.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3",
      "sentiment": -0.2,
      "quote": "Denna positiva bild står i stark kontrast till utredningens genomgående kritiska och misstroende hållning gentemot socionomutbildningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.3",
      "sentiment": -0.5,
      "quote": "utredaren målar upp en alltför snäv bild av vad som kan uppfattas vara just aktuella samhällsutmaningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5",
      "sentiment": -0.5,
      "quote": "Utredningens fokus mot ungdomskriminalitet i detta kapitel är alltså en insnävning av ett bredare problemområde.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6",
      "sentiment": -0.5,
      "quote": "I kapitlet framgår dock tydligt de brister gällande koherens och stringent argumentation som generellt präglar utredningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1",
      "sentiment": 1.0,
      "quote": "Vi ser flera av dessa förslag som högst relevanta och vi instämmer därför i behovet av att bland annat vidare utreda ett förlängt Socionomprogram.",
