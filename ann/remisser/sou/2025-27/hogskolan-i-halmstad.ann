  "segments": [
    {
      "forarbete_id": "a1.1",
      "sentiment": -1.0,
      "quote": "Vi anser att detta mål är centralt för att socionomutbildningen även framöver ska kunna möta kraven på ett professionellt och rättssäkert socialt arbete.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec82",
      "sentiment": 0.5,
      "quote": "Högskolan i Halmstad betonar vikten av att detta krav bibehålls även i framtiden.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.1",
      "sentiment": 0.2,
      "quote": "Det är angeläget att utbildningen speglar de förändringar som sker i omvärlden och rustar studenterna för det komplexa arbete som väntar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec271",
      "sentiment": 1.0,
      "quote": "Målet att” visa kunskap om aktuella samhällsutmaningar inom området” möjliggör att anpassa socionomutbildningen till de aktuella samhällsutmaningar som råder i samhället.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec277",
      "sentiment": 0.5,
      "quote": "Samtidigt anser vi att den nya formuleringen riskerar att bli mindre skarp än tidigare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec278",
      "sentiment": -1.0,
      "quote": "Högskolan i Halmstad ser en risk med att formulera alltför detaljerade mål: det leder till en överreglerad utbildningsstruktur där utrymmet för fördjupningar, kritisk reflektion och pedagogisk flexibilitet minskar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec279",
      "sentiment": -1.0,
      "quote": "Högskolan i Halmstad menar, att dessa frågor är en tydlig del av utbildningen redan idag och att utbildningen redan idag utifrån dagens examensordning inkluderar undervisning om social utsatthet, normbrytande beteende och kriminalitet, inklusive förebyggande och åtgärdande insatser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec280",
      "sentiment": -1.0,
      "quote": "Att specifikt lyfta fram hedersrelaterat våld och förtryck i målet riskerar att fragmentisera förståelsen av våld som ett sammanhängande samhällsfenomen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": 0.2,
      "quote": "socionomer behöver vara trygga i sin professionella roll och rustade att hantera komplexa situationer i praktiken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec284",
      "sentiment": -1.0,
      "quote": "Högskolan i Halmstad menar att målet redan i sin nuvarande formulering inkluderar närstående, då de är människor som berörs.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2.1",
      "sentiment": 0.5,
      "quote": "Däremot föreslår vi att begreppet ”lagarbete” tas bort ur målformuleringen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec34",
      "sentiment": -1.0,
      "quote": "Detta mål innebär orimliga förväntningar på studenter som befinner sig på grundnivå.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec30",
      "sentiment": -1.0,
      "quote": "Det ger en teoretisk grund och förståelse för ledarskapets roll inom socialt arbete utan att förutsätta att studenten ska ha tränats i praktiskt ledarskap.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec288",
      "sentiment": 0.5,
      "quote": "Den mest problematiska delen gäller kravet på att studenten ska ”bidra till utveckling av yrket och verksamheten”.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec294",
      "sentiment": 1.0,
      "quote": "Högskolan i Halmstad tillstyrker förslaget om förändringen av examensmålet visa förmåga att utifrån relevant kunskap tillämpa författningar inom ramen för socialt arbete.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec295",
      "sentiment": -1.0,
      "quote": "Det framstår dock som orimligt att examensordningen för socionomutbildningen skulle fokusera på antal poäng snarare än utbildningens innehåll och kvalitet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec303",
      "sentiment": -1.0,
      "quote": "Återigen måste vi framhålla att det problematiska i om examensordningen för socionomutbildningen i så hög grad skulle fokusera på antal poäng snarare än utbildningens innehåll och kvalitet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec22",
      "sentiment": 1.0,
      "quote": "Det är ett nödvändigt steg för att säkerställa utbildningens kvalitet och relevans.",
