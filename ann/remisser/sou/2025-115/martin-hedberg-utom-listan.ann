  "segments": [
    {
      "forarbete_id": "a6.13.1",
      "sentiment": 0.2,
      "quote": "Det saknas dock resonemang med anledning av att organen kan vara utländska, jämför prop. 2012/13:55 Ny lag om kontroll av ekologisk produktion s. 67, vilket aktualiserar 10 kap. 8 § andra stycket regeringsformen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.14",
      "sentiment": 0.2,
      "quote": "Jag delar utredningens slutsats att de anmälda organens beslut ska kunna överklagas till förvaltningsdomstol men det är problematiskt att utredningen inte verkar analyserat frågan utifrån primärrätten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec168",
      "sentiment": -0.5,
      "quote": "Det brister dock i stringensen när utredningen inte funderar över författningsstöd för det här intrånget , jämfört med resonemanget om författningsstöd att lämna över myndighetsutövning till enskild.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.3.4",
      "sentiment": -0.5,
      "quote": "Lagförslaget bör därför kompletteras med reglering av kumulationen av sanktionsavgifter eftersom artikel 64 inte tydligt reglerar den frågan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.3.2",
      "sentiment": -0.5,
      "quote": "Skrivningarna fokuserar på tidigare svenska resonemang istället för vad EU försöker uppnå och vad EU har för krav på sanktioner.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.3.3",
      "sentiment": -1.0,
      "quote": "Varför analyserar utredningen en EU-förordnings begrepp utifrån svensk rätt och dess begrepp?",
      "quote_type": "grund"
    }
  ]
