  "segments": [
    {
      "forarbete_id": "sec51",
      "sentiment": -0.5,
      "quote": "Vi har identifierat att det är oklart hur sanktionsavgifter kan tas ut i de fall då det är möjligt att utkräva sanktionsavgift enligt flera tillämpliga regelverk, som till exempel AI-förordningen och cyberresiliensförordningen .",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec51",
      "sentiment": -0.5,
      "quote": "Arbetsmiljöverket vill istället att regleringen av sanktionsavgifter utformas med samma lydelser som föreslås i genomförandet av AI-förordningen, se SOU 2025:101 Anpassningar till AI-förordningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.4",
      "sentiment": -0.5,
      "quote": "En alltför begränsande bestämmelse om preskription skulle innebära att sanktionsavgifter inte kommer kunna användas i majoriteten av ärendena.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.3.2",
      "sentiment": 0.5,
      "quote": "Vi bör därför inte begränsa oss till att använda myndighet med hänvisning till en analys av innebörden utifrån svensk lagstiftning, då detta annars kan ge oönskad följdverkan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec47",
      "sentiment": -0.5,
      "quote": "Arbetsmiljöverket vill att föreskriftmandatet endast tilldelas en utpekad myndighet, förslagsvis Post- och telestyrelsen, då vi bedömer att ett sådant förfarande skulle förenkla både tillämpning och regelutveckling.",
      "quote_type": "grund"
    }
  ]
}