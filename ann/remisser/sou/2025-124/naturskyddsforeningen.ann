  "segments": [
    {
      "forarbete_id": "sec97",
      "sentiment": -0.2,
      "quote": "Naturskyddsföreningen anser det av stor vikt att ”officiellt erkända” avseende nationella eller regional EN ISO 14024 Typ I miljömärkningar harmoniseras mellan medlemsstaterna, i en gemensam databas, lista eller likartad lösning så att ”officiellt erkänd” i en stat, per automatik innebär ”officiellt erkänd” i andra medlemsstater.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.8",
      "sentiment": -0.5,
      "quote": "Eftersom det i stor utsträckning är tydligt vilka delar som appliceras på enbart konsumenter, anser vi exkluderandet av näringsidkare vara ett steg i fel riktning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec96",
      "sentiment": -0.5,
      "quote": "Naturskyddsföreningen ser tydlig risk för att otydlighet kring miljöpåståenden kvarstår i svensk rätt men framför allt i svensk praxis.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3",
      "sentiment": -0.5,
      "quote": "Ekonomiska styrmedel är avgörande för att förändra beteenden och göra cirkulära affärsmodeller konkurrenskraftiga i en linjär ekonomi.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.6",
      "sentiment": -0.5,
      "quote": "Naturskyddsföreningen delar inte denna bedömning och vill understryka att nyköp, i en övervägande del av marknaden alltjämt är billigare för konsumenten än reparation.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.12.3",
      "sentiment": -0.5,
      "quote": "Om inte en fungerande tillsyn är på plats så riskerar även utredningens lagförslag att inte följas av tillverkare och importörer, vilket bidrar till snedvriden konkurrens, ökar miljöbelastningen och belastar skattekollektivet för avfallshantering av produkter som inte repareras.",
      "quote_type": "grund"
