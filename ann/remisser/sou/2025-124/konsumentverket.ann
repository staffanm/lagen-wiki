  "segments": [
    {
      "forarbete_id": "a5.2",
      "sentiment": 1.0,
      "quote": "Många av begreppen har tidigare givits uttryck för i rättstillämpningen och det är därför viktigt att definitionerna införs för att undvika att begreppen tolkas på olika sätt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.3",
      "sentiment": -1.0,
      "quote": "Då det saknas en konsekvensanalys av den föreslagna ändringen kan det inte uteslutas att konsumentskyddet och utövandet av tillsyn påverkas negativt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": -0.2,
      "quote": "Konsumentverket befarar att det harmoniserade meddelandet om en reklamationsrätt på minst två år riskerar att vilseleda konsumenter om deras rättigheter att reklamera en vara inom tre år i Sverige.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": 0.0,
      "quote": "Den myndighet som får ansvar för tillsyn av den nya informationsbestämmelsen som följer av konsumentmaktsdirektivet bör samverka med Energimyndigheten för att undvika överlappning och dubbelarbete.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.3",
      "sentiment": 0.5,
      "quote": "Förlängningen om 12 månader bedöms ändock överlag vara en förbättring av konsumentskyddet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.12.3",
      "sentiment": -0.5,
      "quote": "Myndigheten anser inte att tillsyn över 8 och 9 §§ bör tillfalla Konsumentverket när det handlar om att tillhandahålla reservdelar och verktyg till annan än konsument, samt i situationer som rör det näringsrättsliga förhållandet mellan en tillverkare och andra aktörer som ska kunna reparera en vara.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.4",
      "sentiment": 1.0,
      "quote": "Vidare instämmer myndigheten i utredningens bedömning om att det vore mindre lämpligt att utse Konsumentverket till kontaktpunkt eftersom det kan skada myndighetens förtroende som tillsynsmyndighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.2",
      "sentiment": 1.0,
      "quote": "Konsumentverket tillstyrker förslaget om myndigheten ska informera om konsumenters rättigheter som följer av direktivet.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a11.3",
      "sentiment": 1.0,
      "quote": "Konsumentverket tillstyrker förslaget om att myndigheten ska vidta en åtgärd för att främja reparation i enlighet med artikel 13 i direktivet.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a12",
      "sentiment": 0.2,
      "quote": "Konsumentverket anser att det bör förtydligas att marknadsföring som vidtagits innan ikraftträdandet men som fortfarande är aktuell och pågående efter ikraftträdandet bör omfattas av det nya regelverket.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.6",
      "sentiment": -0.2,
      "quote": "Myndigheten är dock inte övertygad om att samtliga regeländringar minskar risken för att konsumenter vilseleds om produkters miljömässa egenskaper eller påverkan.",
