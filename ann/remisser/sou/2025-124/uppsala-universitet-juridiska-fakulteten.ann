  "overall": {
    "sentiment": 0.5,
    "quote": "Juridiska fakultetsnämnden tillstyrker utredningens förslag i stort, men vill på det generella planet dels rikta uppmärksamheten mot de principiella svårigheter som ambitionen att utforma reglerna på ett sätt som är förenligt med grundläggande civilrättsliga principer ger upphov till, dels ifrågasätta hur ändamålsenlige de föreslagna ändringarna i marknadsföringslagen egentligen är.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a7.2",
      "sentiment": -0.2,
      "quote": "Samtidigt tynger tillägget texten, som redan är otymplig, vilket i sig rimligen inte gagnar det övergripande konsumentskyddande syftet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec192",
      "sentiment": 1.0,
      "quote": "I den föreslagna nya lagen om reparation av konsumenters varor vill utredningen, vilket är följdriktigt, ta in en definition av uttrycket auktoriserad representant.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec203",
      "sentiment": -0.5,
      "quote": "Eftersom kvalifikationen att reparationen kan utföras kostnadsfritt närmast är avsedd att vara en sakupplysning (direktivet skäl 16) och möjligheten som sådan följer av allmänna principer och av 5 § finns ingen anledning att låta den ingå i formuleringen, särskilt inte som språkbruket kan vara vilseledande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.4",
      "sentiment": 0.2,
      "quote": "Principiellt kan ifrågasättas hur effektivt och ändamålsenligt det nya marknadsföringsrättsliga regelverk som sammantaget föreslås kan bli.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.8",
      "sentiment": -0.2,
      "quote": "Den täcker in både miljömässig hållbarhet (eng. sustainability) och en varas hållbarhet (durability).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.2",
      "sentiment": 0.2,
      "quote": "Det behövs dock ytterligare diskussion om hur rättstillämpare kan, bör eller ska bedöma exempelvis om en bildsättning är vilseledande, eller hur den kan bidra till ett vilseledande helhetsintryck.",
      "quote_type": "grund"
    }
  ]
