  },
  "overall": {
    "sentiment": 0.2,
    "quote": "BFN gör bedömningen att BFN:s normgivning för löpande bokföring och årsredovisning behöver ses över för att utreda om normgivningen behöver kompletteras eller anpassas till den nya företagsformen.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "sec584",
      "sentiment": 1.0,
      "quote": "BFN har inget att invända mot att AIF-bolag avslutar den löpande bokföringen med en årsredovisning.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec584",
      "sentiment": -0.2,
      "quote": "Det framgår inte av betänkandet syftet med att ett AIF-bolag dels ska avsluta den löpande bokföringen både med en årsredovisning dels tillhandahålla en årsberättelse jämfört med investeringsbolag och associationsrättsliga specialfonder, som också är fondandelsbolag, som däremot enbart ska avsluta den löpande bokföringen med en årsberättelse.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec584",
      "sentiment": -0.2,
      "quote": "Enligt BFN:s bedömning bör Finansinspektionen ansvara för den kompletterande normgivningen vid tillämpning av LAIF även när bestämmelserna ska tillämpas på årsberättelsen för ett AIF-bolag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec580",
      "sentiment": -0.5,
      "quote": "Någon motsvarande definition med hänvisning till fondandelsbolagslagen finns inte för investeringsbolag, trots att dessa genom en ny bestämmelse i BFL ska undantas från skyldigheten att upprätta årsredovisning",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec581",
      "sentiment": -0.2,
      "quote": "För att undvika missförstånd bör rubriken utformas med utgångspunkt i lydelsen av rubriken närmast före 6 kap. 3 § BFL.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec580",
      "sentiment": -0.2,
      "quote": "Hänvisningen till LVF bör avse 4 kap. 18 och 18a §.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec33",
      "sentiment": -0.5,
      "quote": "BFN nämns inte bland de myndigheter som räknas upp.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec581",
      "sentiment": -0.2,
      "quote": "Enligt BFN:s bedömning kan det finnas anledning att se över definitionen av begreppet nettoomsättning i ÅRL för en eventuell anpassning för de företag som bedriver finansiell verksamhet som inte är bank, värdepappersbolag eller försäkringsföretag, dvs företag som upprättar årsredovisning enligt ÅRL.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec592",
      "sentiment": -0.5,
      "quote": "Det synes som det har skett en sammanblandning mellan begreppen god revisionssed och god redovisningssed i kommentaren.",
      "quote_type": "grund"
    }
  ]
}