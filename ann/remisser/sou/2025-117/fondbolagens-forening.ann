      "artifact:remisser/sou/2025:117/fondbolagens-forening": "c962cca64c6f89c4bdac1d823d825a98e18b89681ab82b41bfb5c350c1e0a3f0",
      "artifact:forarbete/sou/2025-117": "e9f7c3ab9cf49724fafdf32b1ac759e11d234a9fee7d593cc7ebb686a52a59d9"
    }
  },
  "overall": {
    "sentiment": 0.5,
    "quote": "Genom införandet av fondandelsbolag möjliggörs etablering i Sverige av fondstrukturer som i dag förläggs till andra jurisdiktioner där associationsrättsliga fondstrukturer finns.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a4.3.2",
      "sentiment": -0.5,
      "quote": "Utredningens slutsats att ett AIF-bolag inte skulle kunna äga exempelvis gruvor eller råvarulager saknar därför stöd (s. 396 i betänkandet).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.3.4",
      "sentiment": -0.5,
      "quote": "Om ett krav på ledningsprövning grundas på en sådan jämförelse finns det en risk att prövningen utformas utifrån andra utgångspunkter än de som är relevanta för fondstrukturer, och därmed får ett innehåll som inte är motiverat i detta sammanhang.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.3.6",
      "sentiment": 0.0,
      "quote": "Detta bör komma till uttryck även i lagtexten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.4.3",
      "sentiment": 0.0,
      "quote": "bör det övervägas om möjligheten för andelsägarna att begära en extra stämma ska vara knuten till röstvärdet för innehavda andelar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.4.4",
      "sentiment": -0.5,
      "quote": "Något behov av ett mer långtgående krav i lag som kan motivera de kostnader detta kan medföra, framför allt i en större styrelse, har inte framkommit.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.4.7",
      "sentiment": 0.2,
      "quote": "Det bör därför åläggas förvaltaren att lämna erforderliga uppgifter till styrelsen, förslagsvis genom tillägg i 10 kap. 7 § FABL.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.5.4",
      "sentiment": 0.0,
      "quote": "Fondens (delfondens) namn kommer, såsom beskrivs i betänkandet, inte att vara detsamma som det registrerade företagsnamnet för fondandelsbolaget.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.6.1",
      "sentiment": 0.0,
      "quote": "Det angivna syftet är ett av syftena med distributionsklasser, men inte det enda.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.8",
      "sentiment": 0.0,
      "quote": "Det bör förtydligas att det är förvaltaren som bär det näringsrättsliga ansvaret för att informationskraven uppfylls.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.9.1",
      "sentiment": 0.0,
      "quote": "Rubriken bör därför justeras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec630",
      "sentiment": -0.5,
      "quote": "Att skadeståndsansvarets omfattning skulle variera beroende på i vilken form fonden bildats framstår som olämpligt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec633",
      "sentiment": -0.5,
      "quote": "Att införa motsvarande skadeståndsansvar även för styrelseledamöter i fondandelsbolaget framstår inte som logiskt med hänsyn till den roll och det ansvar styrelsen ska ha och riskerar att göra denna roll otydlig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.11.4",
      "sentiment": -1.0,
      "quote": "Det saknas dessutom en analys av vilka konsekvenser en sådan ansvarsregel kan få för investerares vilja att investera i fondandelsbolag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.12.1",
      "sentiment": -0.5,
      "quote": "Den föreslagna regleringen medför därmed regelöverlappning, vilket riskerar att leda till tolknings- och tillämpningssvårigheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.12.3",
      "sentiment": -0.2,
      "quote": "Några motsvarande bestämmelser som knyter sådana ingripanden till den enskilda fonden finns inte idag för alternativa investeringsfonder, som ofta drivs i bolagsform.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.12.6",
      "sentiment": -0.5,
      "quote": "Det saknas skäl att införa en särskild årlig tillsynsavgift för just fondandelsbolag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.13.1",
      "sentiment": 0.0,
      "quote": "Hänvisningen i betänkandet till 2 kap. 2 § LVF synes avse 4 kap. 2 § LVF (s. 630).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.13.2",
      "sentiment": 0.0,
      "quote": "Av tydlighetsskäl behöver därför en bestämmelse införas i FABL som klargör tillämpligheten av aktiebolagslagens bestämmelser om konkurs.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.14.2",
      "sentiment": -0.5,
      "quote": "Det saknas enligt föreningens mening skäl att göra någon annan bedömning i denna fråga än den som tidigare gjorts.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.14.3",
      "sentiment": 0.0,
      "quote": "Detta synes vara en lapsus och bör ändras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.14.4",
      "sentiment": 1.0,
      "quote": "Det har sedan lång tid funnits behov av en sådan reglering och bristen på reglering har t.ex. skapat problem i samband med behovet att dela fonder med innehav i ryska värdepapper.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.15.3",
      "sentiment": -0.2,
      "quote": "En tidsfrist om tio dagar för bolaget att utse en ny förvaltare framstår därför som otillräcklig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.15.5",
      "sentiment": -0.5,
      "quote": "Denna ordning framstår som inkonsekvent.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.16.2",
      "sentiment": 0.0,
      "quote": "Föreningen anser dock att det behöver klargöras hur delfonder påverkas vid en konkurs i investeringsbolaget.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.19",
      "sentiment": -0.5,
      "quote": "Det bör inte i detta sammanhang införas sådana regler, eftersom det skulle leda till att samma företeelse behandlas olika beroende på i vilken form fonden är bildad.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec780",
      "sentiment": -0.2,
      "quote": "Ett särskilt tillägg i syfte att tydliggöra detta framstår därför som obehövligt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec31",
      "sentiment": 0.5,
      "quote": "En förutsättning för att Eltif-fonder ska kunna etableras i Sverige är att de inte beskattas på ett sätt som i praktiken innebär att de inte kan konkurrera med utländska motsvarigheter.",
      "quote_type": "grund"
    }
  ]
}