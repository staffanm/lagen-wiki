  "segments": [
    {
      "forarbete_id": "sec130",
      "sentiment": -0.2,
      "quote": "Den tolkningen är inte självklar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec135",
      "sentiment": -0.5,
      "quote": "Särskilt med tanke på att leverantörer av databehandlingstjänster kan ha en global miljardomsättning finns en risk att den valda lösningen med ett beloppstak inte ger den preventiva effekt som krävs.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec147",
      "sentiment": -0.5,
      "quote": "Denna konstruktion riskerar att bli cirkulär, eftersom den rättsliga kvalifikationen görs beroende av om en överträdelse re-dan ägt rum.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.7",
      "sentiment": -0.2,
      "quote": "Bedömningen att artikel 32.2 i dataförordningen saknar självständig skyldighet är en tolkning som kan ifrågasättas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec187",
      "sentiment": 0.0,
      "quote": "Även om utredningens tolkning av dataförordningen framstår som rimlig, är den i slutändan förbehållen EU-domstolen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5.1",
      "sentiment": -0.2,
      "quote": "Intresset av rättssäkerhet talar för att i möjligaste mån precisera hur begreppet allmänt nödläge i dataförordningen förhåller sig till närliggande begrepp i svensk intern rätt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.2",
      "sentiment": 0.0,
      "quote": "En sådan tillämpning skulle tillföra en kompletterande processuell väg för berörda näringsidkare eller sammanslutningar av näringsidkare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.3.1",
      "sentiment": -0.5,
      "quote": "Bestämmelsen missar därutöver det svenska särdraget att katalogskyddet i 49 § URL är vidare än sui generis-rätten i databasdirektivet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.8.4",
      "sentiment": -0.2,
      "quote": "Frågan bör adresseras i den fortsatta beredningen, exempelvis genom ett bemyndigande som tillåter regeringen att utse en eller flera relevanta myndigheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7.6",
      "sentiment": -0.2,
      "quote": "Utredningen identifierar risken att deltagande företag erhåller konkurrensfördelar (se s. 298 i betänkandet), men före-slår inte någon rättslig ram för att motverka detta.",
      "quote_type": "grund"
    }
  ]
