  "overall": {
    "sentiment": 0.5,
    "quote": "Tillväxtverket är sammanfattningsvis positivt till förslagen.",
    "quote_type": "standpunkt"
  },
  "segments": [
    {
      "forarbete_id": "a7.11",
      "sentiment": 0.2,
      "quote": "Med utgångspunkt i kapitel 7.11 om åtgärder för att underlätta datadelning i krissituationer anser Tillväxtverket att det kan förtydligas hur ansvarsfördelningen mellan berörda myndigheter ska fungera i operativa situationer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.11.5",
      "sentiment": 0.2,
      "quote": "Tillväxtverket ser som sektorsansvarig myndighet för industri, byggande och handel att det behöver förtydligas hur datadelning ska fungera vid cyberstörningar och andra liknande förhållanden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.11.5",
      "sentiment": 0.2,
      "quote": "Det vore också önskvärt att de sektorsansvariga myndigheternas kartläggningsuppdrag konkretiseras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5.1",
      "sentiment": 0.2,
      "quote": "Ur ett dataskyddsperspektiv behövs det tydlig vägledning i kompletterande nationella regelverk kring gränsdragning mellan dataförordningen och dataskyddsförordningen (GDPR) i de situationer där datamängder som delas av företag eller offentliga organ även innehåller personuppgifter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5.1",
      "sentiment": 0.2,
      "quote": "För att minska risken för de administrativa hinder som utredningen lyfter, bör det tydligt framgå att dataförordningen inte utgör rättslig grund enligt GDPR.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5.2",
      "sentiment": 0.2,
      "quote": "Det bör även framgå att all behandling av personuppgifter fortsatt måste uppfylla kraven i dataskyddsförordningen, samt att principerna om dataminimering och ändamålsbegränsning beaktas vid begäran av data även vid krissituationer.",
      "quote_type": "grund"
    }
  ]
}