  "segments": [
    {
      "forarbete_id": "a8.6",
      "sentiment": 1.0,
      "quote": "Sverige bör aktivt delta i det europeiska standardiseringsarbetet genom CEN, samt på den internationella nivån genom ISO för att tillvarata svenska intressen och säkerställa att svenska företag och offentliga organ får tillgång till välfungerande standarder.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6",
      "sentiment": 0.5,
      "quote": "Standardisering kan bidra till att säkerställa kvalitet, transparens och kontinuitet i certifieringsprocesserna.",
