    },
    {
      "forarbete_id": "a7",
      "sentiment": 0.5,
      "quote": "SIS vill framhålla att standardisering kan underlätta för offentliga organ att ta emot, bearbeta och använda data från olika datahållare genom att säkerställa teknisk och semantisk interoperabilitet.",
      "quote_type": "grund"
