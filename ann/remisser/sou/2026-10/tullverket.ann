  "segments": [
    {
      "forarbete_id": "a3-2",
      "sentiment": 1.0,
      "quote": "Förslagen innebär en mer enhetlig reglering och innebär bättre möjlighet att säkra återtagande av brottsvinster.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.6.2",
      "sentiment": 1.0,
      "quote": "så bedöms förslaget innebära att förverkandelagstiftningen blir mer effektiv, samtidigt som de föreslagna undantagen från regleringen innebär att effektiviteten i den brottsbekämpande verksamheten bibehålls.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.4.10",
      "sentiment": 0.5,
      "quote": "Tullverket kommer med detta förslag till exempel kunna behålla förverkat förpackningsmaterial samt kläder och liknande för att använda i beslagshanterings- respektive spaningsverksamheten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.5",
      "sentiment": 0.2,
      "quote": "Med denna utökning kommer Tullverket kunna förtida försälja och förstöra egendom som härrör från samtliga brott i Tullverkets direkta brottsbekämpning .",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.13.2",
      "sentiment": 1.0,
      "quote": "Detta kommer innebära en tydlig, enhetlig och effektiv reglering.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.14.2",
      "sentiment": 1.0,
      "quote": "Detta kommer effektivisera Tullverkets handläggning när beslut tas enligt 3 kap. 4 § 2024 års förfarandelag.",
