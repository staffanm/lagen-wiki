  "segments": [
    {
      "forarbete_id": "sec7",
      "sentiment": -1.0,
      "quote": "Det framstår som en otillfredsställande ordning att en frikänd person som är i stort behov av medel eller egendom för sin eller sin familjs försörjning ska behöva invänta en lagakraftvunnen dom, i synnerhet i de fall där domen överklagas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec302",
      "sentiment": 1.0,
      "quote": "När en part inte påkallar förhandling ser tingsrätten fördelar både ur effektivitetsskäl och förenklingsskäl att i stället kunna avgöra frågan på handlingarna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.4",
      "sentiment": 1.0,
      "quote": "Tingsrätten instämmer i förslaget om att fristen för att pröva frågor om beslag ska förlängas till en vecka.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a3.4",
      "sentiment": 1.0,
      "quote": "I likhet med utredningen ser tingsrätten att beslagsmål, som enligt nuvarande ordning utgör fristmål, riskerar att påverka och tränga undan andra brådskande mål.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec845",
      "sentiment": 1.0,
      "quote": "En sådan ordning skulle innebära ett orimligt stort avsteg från de grundläggande principer som finns i brottmålsprocessen.",
      "quote_type": "grund"
