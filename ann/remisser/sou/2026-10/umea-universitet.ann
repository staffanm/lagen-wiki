  "overall": {
    "sentiment": 0.2,
    "quote": "Utvidgningen ses som ett angeläget allmänt intresse, eftersom det kan förstärka effektiviteten i brottsbekämpningen.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a3.2.4",
      "sentiment": 0.8,
      "quote": "Bestämmelsen torde genom denna förändring bli enklare att tillämpa än den nuvarande ordningen med beslag och penningbeslag som två olika tvångsmedel.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.3.8",
      "sentiment": -0.5,
      "quote": "Den förslagna huvudregeln resulterar sannolikt i att beslag slentrianmässigt består även i situationer där ingendera parten avser att överklaga domen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.4.5",
      "sentiment": 0.2,
      "quote": "Detta är något som JO sedan länge ansett bör göras (se JO 1975/76 s. 132), men som inte alltid torde ske i praktiken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.5.3",
      "sentiment": -0.5,
      "quote": "Domstolarna bör ha ett uttryckligt och fortlöpande ansvar för att pröva att beslag inte upprätthålls under längre tid än vad som är proportionerligt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.6.1",
      "sentiment": 0.5,
      "quote": "Förslaget ligger i linje med de senaste årens utveckling som innebär att rättens officialansvar alltmer har begränsats (jämför exempelvis 35 kap. 6 § första stycket rättegångsbalken).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.15.1",
      "sentiment": 0.2,
      "quote": "Den nuvarande regleringen har lett till märkliga konsekvenser i den praktiska tillämpningen och det är positivt att detta rättas till.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.15.2",
      "sentiment": -0.2,
      "quote": "Bestämmelsens första stycke – som ger beslutsbehörighet för bland annat den som verkställer vissa tvångsmedel enligt rättegångsbalken – är inte självklart direkt tillämplig i de fall då tvångsmedel verkställs enligt andra författningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.4",
      "sentiment": -0.2,
      "quote": "I beslagssammanhang är det däremot mer motiverat att det är den som drabbas av beslaget och inte den misstänkte – som ju inte alltid är den drabbade – som bör vara närvarande vid beslagsförhandling.",
      "quote_type": "grund"
    }
  ]
}