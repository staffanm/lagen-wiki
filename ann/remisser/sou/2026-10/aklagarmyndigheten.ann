    },
    {
      "forarbete_id": "a9.1",
      "sentiment": 1.0,
      "quote": "Det är bra att det blir tydligt att strafförelägganden kan avse att målsäganden har rätt till betalning ur förverkad egendom.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2",
      "sentiment": 0.0,
      "quote": "önskar Åklagarmyndigheten ett klargörande om uttrycket ”det barnpornografiska materialet” även inkluderar de digitala lagringsenheterna.",
