  },
  "overall": {
    "sentiment": 0.5,
    "quote": "Det är vår uppfattning att förslagen i allt väsentligt kommer att förenkla och effektivisera förverkandeförfarandet och att brottsvinster i större utsträckning än idag kommer att kunna förverkas.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "sec5",
      "sentiment": 1.0,
      "quote": "Vi delar bedömningarna och ser stora fördelar med de förenklingar och den enhetlighet som förslagen innebär och är av uppfattningen att förslagen kommer att underlätta åklagares och polisens arbete.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.2.4",
      "sentiment": 0.5,
      "quote": "Att beslag nu generaliseras innebär att åklagaren får ett snabbare och enklare verktyg i situationer där egendom behöver säkras skyndsamt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.3.8",
      "sentiment": 1.0,
      "quote": "Förslaget att även förverkande- och återställandebeslag som huvudregel ska bestå till dess domen vinner laga kraft löser ett konkret och sedan länge känt problem.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.4.5",
      "sentiment": 1.0,
      "quote": "Att den enskilde behåller rätten att begära förhandling, och att detta bara får nekas om det är uppenbart obehövligt, tillgodoser rättssäkerhetsintresset.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.5.3",
      "sentiment": 1.0,
      "quote": "Att rätten inte längre ska ansvara för beslagsfrågan efter prövning är en logisk och tillämparvänlig förändring.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.6.3",
      "sentiment": 0.2,
      "quote": "i grunden positivt men problem skulle kunna uppstå om den anvisade egendomens ursprung kan ifrågasättas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4",
      "sentiment": 0.5,
      "quote": "Åklagarmyndigheten tillstyrker samtliga förslag i detta avsnitt men har vissa synpunkter.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a4.2.5",
      "sentiment": -0.2,
      "quote": "Det verkar inte som att alla EU-stater delar den svenska regeringens bedömning att EIO-direktivet inte är tillämpligt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.6.2",
      "sentiment": 0.2,
      "quote": "Förslaget leder till ett ökat behov av fler finansiella utredare och bättre tekniskt stöd, inte minst inom Polismyndigheten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.6.4",
      "sentiment": 0.5,
      "quote": "Åklagarmyndigheten anser att det är positivt att ARO-kontoren föreslås få ökad åtkomst till vissa uppgifter.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a5.4.5",
      "sentiment": 0.2,
      "quote": "Eftersom penningtvättsbrotten i sig inte direkt ger vinst, utan är just åtgärder med brottsvinster som redan uppstått kan tillämpningen bli problematisk.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6",
      "sentiment": 0.5,
      "quote": "Åklagarmyndigheten är positiv till förslagen i detta avsnitt men har vissa synpunkter och anser att några frågor bör analyseras närmare i den fortsatta beredningen.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.5.2",
      "sentiment": 0.2,
      "quote": "volatiliteten går i båda riktningarna och målet är ju inte bara att skydda tillgångarna, utan också att om möjligt öka värdet på tillgångarna",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.3",
      "sentiment": -0.2,
      "quote": "Det skulle kunna få konsekvenser för möjligheten för en övertagande myndighet att fullgöra bokföringen på ett adekvat sätt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7-2",
      "sentiment": -0.2,
      "quote": "konstaterar att omfattningen av uppdraget är otydligt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8-2",
      "sentiment": -0.5,
      "quote": "det finns skäl för att införa en omvänd bevisbörda för utvidgat förverkande.",
