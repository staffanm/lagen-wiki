  "overall": {
    "sentiment": 0.5,
    "quote": "Sammantaget bedömer Polismyndigheten att de föreslagna regleringarna motsvarar kraven som ställs i rättsakterna och även innebär en väl avvägd och nödvändig förstärkning av den tillgångsinriktade brottsbekämpningen i Sverige på de områden som varit i fokus för utredningen.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a3.2.4",
      "sentiment": 1.0,
      "quote": "Polismyndigheten anser att förslaget kommer att förenkla och effektivisera processen med tvångsmedelshantering av egendom för de brottsbekämpande myndigheterna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.3.8",
      "sentiment": 1.0,
      "quote": "Förslaget är särskilt viktigt när det gäller lättrörliga tillgångar som t.ex. bankkontobehållningar, kontanter och kryptovalutor, men Polismyndigheten har efter friande tingsrättsdomar även noterat t.ex. snabba ägarförändringar i fastigheter som har varit säkrade.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.6.1",
      "sentiment": 1.0,
      "quote": "Enligt Polismyndighetens bedömning är utredningens överväganden helt i linje med skälen bakom det regeringsuppdrag som Polismyndigheten nyligen fått om att inrätta ett center för återtagande av brottsvinster.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.6.2",
      "sentiment": 1.0,
      "quote": "Enligt myndighetens bedömning är ett sådant tillägg i rättegångsbalken avgörande för att alla delar av de brottsbekämpande myndigheterna ska börja se tillgångsutredning som en naturlig del av att utreda brott.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.4.9",
      "sentiment": 0.5,
      "quote": "För det fall att beslagsmyndigheterna är de som ska betala in medlen till Brottsoffermyndigheten är det enligt Polismyndighetens bedömning nödvändigt att myndigheterna tilldelas dispositionsrätt till dessa inkomster.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.5",
      "sentiment": 0.5,
      "quote": "Polismyndigheten ser dock även ett behov av att ett sådant beslut ska kunna gälla till förmån för annan myndighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1",
      "sentiment": -0.2,
      "quote": "Därmed finns en risk för att nödvändig IT-utveckling inte kommer vara på plats inom den tid som förverkandedirektivet föreskriver.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5.1",
      "sentiment": 1.0,
      "quote": "Som utredningen påpekar sänktes beviskravet så sent som 2024 och med beaktande av de rättssäkerhetsaspekter som finns bör enligt Polismyndighetens bedömning en sådan ändring avvaktas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.2",
      "sentiment": -0.5,
      "quote": "I 2 kap. 1 § i förslaget till den nya lagen står det dock alltjämt ”Polismyndigheten”, något som Polismyndigheten bedömer är ett förbiseende och föreslår mot denna bakgrund att begreppet ”myndigheten som hanterar egendomen” ska användas även i denna bestämmelse.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.4",
      "sentiment": -0.5,
      "quote": "Polismyndighetens bedömning är att kostnaderna för upprätthållande av vårdplikten för beslagtaget gods i egen regi och/eller med stöd av sysslomän kan komma att bli omfattande och att myndigheten kommer att behöva tillföras både resurser i form av lokaler, men även kompetens.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec1172",
      "sentiment": -0.2,
      "quote": "På skäl som Gustaf Almkvist anför anser även Polismyndigheten att det är angeläget att komplettera förfogandeförbudet med en regel som tydligt begränsar eventuella negativa effekter av ett förfogande över beslagtagen egendom.",
      "quote_type": "grund"
