    },
    {
      "forarbete_id": "sec285",
      "sentiment": 1.0,
      "quote": "Om en sådan förändring behövs, bör detta även enligt Justitiekanslerns mening utredas särskilt och i samband med en bredare översyn av statens skadeståndsansvar vid straffprocessuella tvångsmedel.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec845",
      "sentiment": 1.0,
      "quote": "En omvänd bevisbörda skulle, även om en sådan kan vara godtagbar ur ett internationellt perspektiv, i svensk rätt innebära en avvikelse från vad som typiskt sett gäller för straffprocessen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec1011",
      "sentiment": 1.0,
      "quote": "Förutom att det skulle innebära en stor ökning i antalet ärenden går den effektivitetsvinst som det innebär att rätten redan är insatt i målet förlorad.",
      "quote_type": "grund"
