  "overall": {
    "sentiment": 0.5,
    "quote": "Halmstads kommun ser positivt på betänkandets inriktning att stärka rektors kärnuppdrag och skapa bättre förutsättningar för ett hållbart pedagogiskt ledarskap samt att rektors pedagogiska ledarskap uppmärksammas och förstärks i författningar.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a7.1.1",
      "sentiment": 1.0,
      "quote": "En sådan definition kan i olika sammanhang användas för att tolka och förstå rektors uppdrag att ansvara för utbildningen i en förskole- eller skolenhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.2",
      "sentiment": 1.0,
      "quote": "Den föreslagna regleringen ger möjlighet till lokalt anpassade lösningar inom ramen för att rektor ska kunna utöva det pedagogiska ledarskapet",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.3",
      "sentiment": 1.0,
      "quote": "Likaså tillstyrks förslaget om att reglera huvudmannens ansvar för att ge förutsättningar till rektor att kunna utöva det pedagogiska ledarskapet och att det särskilt ligger på skolchefs uppdrag.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.1.4",
      "sentiment": -0.5,
      "quote": "Eftersom huvudmannen har det övergripande ansvaret för utbildningens likvärdighet och kvalitet kan den därför behöva styra resurser på ett visst sätt exempelvis att stärka förskollärareller lärartätheten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.5",
      "sentiment": 0.0,
      "quote": "• Förslaget om att begränsa rektors rätt att delegera sitt pedagogiska ledarskap i sin helhet uppfattas till viss del som överflödigt utifrån syftet med reformerna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2.7",
      "sentiment": 1.0,
      "quote": "Staten bör stödja huvudmän på olika sätt att underlätta rektors pedagogiska ledarskap och att rekrytera och behålla rektorer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.7",
      "sentiment": 1.0,
      "quote": "Det är rimligt att det ska ställas krav på en akademisk examen för rektor.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.8",
      "sentiment": 1.0,
      "quote": "Detta då skolledare, som vanligtvis har lärarbakgrund, ofta saknar särskild kompetens om att leda multiprofessionella team med de olika specialistkompetenser som ingår i ett elevhälsoteam.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.11",
      "sentiment": -0.5,
      "quote": "Det kan finnas skäl till att ha bestämmelser om att skolchef inte samtidigt kan vara rektor men att även här ha undantag för små enheter/huvudmän.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.12",
      "sentiment": 1.0,
      "quote": "Däremot tillstyrks förslaget att det ska finnas en befattningsutbildning för skolchefer.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.2.1",
      "sentiment": 1.0,
      "quote": "Utredningen gör bedömningen att staten bör ta ansvar för att skolväsendet tillförs tillräckliga resurser och för att resurser används till avsett ändamål.",
