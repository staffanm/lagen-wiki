  },
  "overall": {
    "sentiment": 0.5,
    "quote": "Föräldraalliansen delar därför utredningens grundläggande problembild: när rektorer belastas av alltför stora ansvarsområden, administration och otydliga styrkedjor påverkas skolans kvalitet och därmed elevernas vardag.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a7.1.1",
      "sentiment": 0.5,
      "quote": "Samtidigt får definitionen inte bli så allmänt hållen att huvudmän tolkar den olika eller att den blir svår att följa upp.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.2",
      "sentiment": 0.5,
      "quote": "En rektor med ansvar för alltför många enheter, medarbetare eller elever riskerar att bli en administrativ områdeschef snarare än en skolledare med insyn i elevernas vardag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.3",
      "sentiment": 0.5,
      "quote": "Förbundet menar att många huvudmän inte ger rektorer tillräckliga förutsättningar, och att detta har betydelse för undervisningens kvalitet och elevers lärande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.4",
      "sentiment": 0.2,
      "quote": "För elever och vårdnadshavare är det viktigt att det finns en tillgänglig och tydlig skolledning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.5",
      "sentiment": 1.0,
      "quote": "Elever och vårdnadshavare ska inte behöva möta en organisation där det är oklart vem som ytterst ansvarar för undervisningens kvalitet, stödinsatser, trygghet eller skolans åtgärder.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.7",
      "sentiment": 0.5,
      "quote": "Rektor fattar beslut som direkt påverkar elevers rätt till stöd, trygghet och undervisning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.8",
      "sentiment": 0.5,
      "quote": "Det är rimligt att den statliga rektorsutbildningen inte bara ska påbörjas utan också genomföras med godkänt resultat.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.11",
      "sentiment": 1.0,
      "quote": "Det är viktigt för transparens, ansvarsfördelning och rättssäkerhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.12",
      "sentiment": 0.5,
      "quote": "Skolchefen har en central roll i att säkerställa att huvudmannen tar ansvar för kvalitet, likvärdighet och regelefterlevnad.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2.1",
      "sentiment": 1.0,
      "quote": "Likvärdigheten i svensk skola påverkas i hög grad av huvudmännens olika ekonomiska och organisatoriska kapacitet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2.2",
      "sentiment": 1.0,
      "quote": "Ett komplett register är viktigt inte bara för myndigheter utan också för insyn, transparens och ansvarsutkrävande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2.3",
      "sentiment": 0.5,
      "quote": "Otydliga, splittrade eller icke-kommunicerande system kan göra det svårt för vårdnadshavare att följa frånvaro, stödinsatser, åtgärdsprogram, betygsinformation och kommunikation med skolan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2.4",
      "sentiment": 0.5,
      "quote": "Föräldrar möter ofta skolans brister tydligast när elevhälsoarbete, särskilt stöd eller anpassningar inte fungerar.",
      "quote_type": "grund"
    }
  ]
}