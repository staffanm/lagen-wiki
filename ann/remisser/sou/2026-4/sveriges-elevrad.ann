  "overall": {
    "sentiment": 0.8,
    "quote": "Elevrörelsen välkomnar utredningens ambition att förbättra rektorers förutsättningar att utföra sitt uppdrag.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a7.1.1",
      "sentiment": 0.2,
      "quote": "En möjlig oönskad effekt av den föreslagna definitionen skulle vara att rektorn blir tvungen delegera samråd med elevsammanslutningar med hänvisning till att det pedagogiska ledarskapet behöver prioriteras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.2",
      "sentiment": 1.0,
      "quote": "Vi delar utredningens bedömning att regleringen kan skapa bättre förutsättningar för rektorer att utföra sitt uppdrag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.3",
      "sentiment": 1.0,
      "quote": "Vi delar utredningens bedömning om att huvudmannens dialog med rektorn kring vilka stödbehov som finns inom verksamheten är central för att uppnå ett ändamålsenligt och behovsanpassat stöd som i längden möjliggör för rektorn att säkerställa utbildningens kvalitet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.5",
      "sentiment": 1.0,
      "quote": "Som vi redogjort för ovan finns det en problematik med organisationsstrukturen med rektorer som fungerar som områdeschefer där det pedagogiska ledarskapet i sin helhet är delegerat till biträdande rektorer och vi ser därför positivt på att utredningens förslag syftar till att motverka en sådan organisation.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.8",
      "sentiment": 1.0,
      "quote": "Vi delar utredningens bedömning om vikten av att befattningsutbildningen för rektorer ska genomföras med godkänt resultat.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2.3",
      "sentiment": 1.0,
      "quote": "Med ett mer ändamålsenligt interoperabelt digitalt system för skolväsendet skulle däremot både lärares och rektorers administrativa börda minska, utan att det sker på bekostnad av elevers rättssäkerhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2.4",
      "sentiment": 1.0,
      "quote": "Sveriges Elevråd och Sveriges Elevkårer tillstyrker utredningens bedömning om att befattningsutbildningen för rektorer bör behandla ledning av elevhälsoarbetet.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.2.7",
      "sentiment": 1.0,
      "quote": "Vi kan, likt utredningen, konstatera att långsiktighet i rektorns ledarskap är en avgörande faktor för att vända en negativ resultatutveckling.",
      "quote_type": "grund"
    }
  ]
}