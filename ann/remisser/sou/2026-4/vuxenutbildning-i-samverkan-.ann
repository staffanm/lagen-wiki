  "overall": {
    "sentiment": 0.5,
    "quote": "VIS tillstyrker i stort utredningens förslag, men uttrycker en avvikande åsikt i frågorna rörande huruvida det skall vara tillåtet att vara rektor samtidigt som man utses till Skolchef enligt skollagen.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a7.1.1",
      "sentiment": 1.0,
      "quote": "Det är i kombinationen av väl balanserat pedagogiskt, organisatoriskt, ekonomiskt och personellt ansvar som ett pedagogiskt ledarskap kan utvecklas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.2",
      "sentiment": 1.0,
      "quote": "VIS tillstyrker utredningens förslag och delar uppfattningen att det inte är lämpligt att fastställa en numerär över antalet medarbetare en rektor kan ansvara för då detta bara är en dimension i det pedagogiska ledarskapet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.3",
      "sentiment": 1.0,
      "quote": "VIS tillstyrker förslaget och ser särskilt positivt på förtydligandet att huvudmannen med hjälp av ansvarig skolchef ska säkerställa att rektorn ges förutsättningar att utöva sitt pedagogiska ledarskap.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.4",
      "sentiment": 1.0,
      "quote": "I och med detta bör det vara rektorn och ingen annan som tar beslut om de ska ingå i den inre organisationen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.5",
      "sentiment": 1.0,
      "quote": "Punkten känns helt central för att rektor faktiskt skall ansvara för det pedagogiska ledarskapet och kommer, om den tillämpas korrekt, också leda till att rektors ansvarsområde avseende exempelvis antalet underställda medarbetare hålls på en rimlig nivå.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.7",
      "sentiment": 1.0,
      "quote": "För att kunna utöva det nära pedagogiska ledarskapet, på det sätt som det formuleras i förslag 7.1.1, så ser vi att ett förtydligande rörande behörighetskravet för att få anställas som rektor är helt nödvändigt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.8",
      "sentiment": 1.0,
      "quote": "VIS tillstyrker förslaget.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.1.11",
      "sentiment": -1.0,
      "quote": "I många kommuner är kunskapen om komvux på huvudmannanivå starkt begränsad och att då undanta rektor för komvux, som ofta är den som lokalt har störst systemkunskap, från möjligheten att bistå huvudmannen i rollen som Skolchef riskerar att minska möjligheterna till ett aktivt huvudmannaskap.",
      "quote_type": "grund"
