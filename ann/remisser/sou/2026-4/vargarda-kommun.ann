  "segments": [
    {
      "forarbete_id": "a7.1.1",
      "sentiment": 1.0,
      "quote": "Vårgårda kommun ställer sig bakom förslaget att det pedagogiska ledarskapet bör definieras enligt nedan: ” Pedagogiskt ledarskap handlar om att ta ansvar för undervisningens kvalitet och för förskolans och skolans lärprocesser.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.1.2",
      "sentiment": 1.0,
      "quote": "Detta ställer sig Vårgårda kommun bakom då det måste vara upp till varje huvudman att organisera ansvaret för de enheter som finns hos respektive huvudman.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.3",
      "sentiment": 0.5,
      "quote": "Dock krävs att staten identifierar nivå på nödvändig administration samt drar ner på den administrativa bördan kopplat till statlig styrning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.4",
      "sentiment": 1.0,
      "quote": "Kommunen stödjer förslaget om ökat mandat för rektor att besluta om sin egen inre organisation samt att det förtydligas i skollagen.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.1.5",
      "sentiment": 0.5,
      "quote": "Att leda och samordna det pedagogiska arbetet är inte en arbetsuppgift bland andra, utan en lagstadgad funktion som definierar rektorsrollen och särskiljer den från ett mer allmänt chefskap.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.7",
      "sentiment": 1.0,
      "quote": "Då utbildningen i skolväsendet ska vila på vetenskaplig grund förutsätter det att den som ska leda verksamheten själv besitter kunskaper som förvärvas genom utbildning på högskolenivå.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.8",
      "sentiment": 0.5,
      "quote": "Det behöver därför säkerställas att rektorerna har de kunskaper som krävs för att uppfylla kraven i skolförfattningarna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.11",
      "sentiment": 1.0,
      "quote": "Vårgårda kommun ställer sig bakom förslaget med de skäl som anges i utredningen.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.1.12",
      "sentiment": 1.0,
      "quote": "Det är viktigt att skolchefen som ska leda rektorer har denna bakgrund och utbildningsnivå.",
      "quote_type": "grund"
    }
  ]
