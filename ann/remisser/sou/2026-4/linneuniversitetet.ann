  "overall": {
    "sentiment": 0.6,
    "quote": "Linnéuniversitetet bedömer att utredningens förslag som en sammanhållen helhet kan bidra till att förbättra rektorers förutsättningar för uppdraget.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a7.1.1",
      "sentiment": 0.2,
      "quote": "För att definitionen ska få effekt som ett erkänt och användbart begrepp inom skolväsendet krävs det att definitionen inte är mer omfattande än att den går att komma ihåg för att kunna användas i vardagliga sammanhang.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.2",
      "sentiment": 1.0,
      "quote": "Liksom utredningen menar Linnéuniversitetet att den grundläggande princip som innebar ”en skola – en rektor” som fastslogs i den så kallade Ansvarspropositionen (Prop. 1980/91) fortfarande bör gälla (s 228).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.4",
      "sentiment": -0.2,
      "quote": "Om rektorsområdena minskar i storlek med en större närhet till skolans ledning som följd, finns det en risk att det kan uppstå ett tryck på rektor att avstå från att inrätta en befattning som biträdande rektor även om behov finns, eftersom personalen kan uppfatta att det finns viktigare prioriteringar att göra på förskolan/skolan än att förstärka ledningsresursen, till exempel att utöka lärarpersonalen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.5",
      "sentiment": 1.0,
      "quote": "Linnéuniversitetet ställer sig bakom utredningens förslag att det pedagogiska ledarskapet inte ska gå att delegera i sin helhet.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.1.7",
      "sentiment": 1.0,
      "quote": "Linnéuniversitetet menar, i likhet med utredningen, att rektor ska ha en pedagogisk utbildning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.8",
      "sentiment": 0.5,
      "quote": "Bestämmelsen riskerar dock att bli verkningslös om den inte samtidigt kombineras med vilka konsekvenser som följer av en genomgången rektorsutbildning utan godkänt resultat.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.12",
      "sentiment": 0.0,
      "quote": "Eftersom det inte anges någon specifik form av högskoleexamen torde en sådan bestämmelse få begränsad effekt för skolans organisation.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2.1",
      "sentiment": -0.5,
      "quote": "Linnéuniversitetet menar att frågan om en statligt styrd skola, alternativt ett ökat statligt ansvarstagande för skolan, bör beslutas i samband med ett genomgripande reformarbete som rör ansvarsfördelningen mellan stat, kommun och enskilda huvudmän i stället för att ingå som ett delförslag i andra reformer, som till exempel i nya bestämmelser om rektorsrollen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2.4",
      "sentiment": 1.0,
      "quote": "Linnéuniversitetet ställer sig bakom utredningens förslag att förtydliga rektors behov av kompetens att leda och samordna elevhälsoarbetet i rektorsprogrammets nationella måldokument.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.2.5",
      "sentiment": 1.0,
      "quote": "Linnéuniversitetet ställer sig bakom utredningens förslag att utreda om och på vilket sätt det nationella professionsprogrammet för rektorer ska inkludera meriteringsnivåer, på samma sätt som för legitimerade förskollärare och lärare.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.2.6",
      "sentiment": 1.0,
      "quote": "Linnéuniversitetet ställer sig bakom utredningens förslag på hur statens insatser skulle kunna samordnas på ett bättre sätt för att främja progression i rektorers lärande och professionella utveckling.",
      "quote_type": "standpunkt"
    }
  ]
