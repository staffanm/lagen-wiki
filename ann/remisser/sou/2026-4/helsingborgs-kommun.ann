  "segments": [
    {
      "forarbete_id": "a7.1.1",
      "sentiment": 0.8,
      "quote": "Nämnden ser positivt på att det pedagogiska ledarskapet definieras i skollagen och att det tydliggörs att det är rektor som har det yttersta pedagogiska ansvaret på skolan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.2",
      "sentiment": -0.2,
      "quote": "Tvärtom ser nämnden att en viss storlek ger bättre möjlighet att få ekonomisk bärkraft och därmed ökade möjligheter att kunna organisera goda lärmiljöer och undervisningssituationer utifrån elevernas olika behov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.3",
      "sentiment": 0.5,
      "quote": "Att säkerställa förutsättningar för rektorns pedagogiska ledarskap är viktigt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.4",
      "sentiment": 0.8,
      "quote": "Den bidrar till att göra arbetet som rektor hanterbart och därigenom även mer attraktivt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.5",
      "sentiment": -0.5,
      "quote": "Nämnden ställer sig därför inte bakom utredningens förslag att personalansvar inte längre ska få delegeras till biträdande rektorer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.8",
      "sentiment": 0.0,
      "quote": "Nämnden känner inte igen sig i bilden av stor omsättning bland rektorer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.7",
      "sentiment": -0.5,
      "quote": "Men, att som utredningen dra slutsatsen, att lärarexamen är den enda vägen till att kunna inneha en befattning som rektor är en för snäv bedömning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.8",
      "sentiment": -0.5,
      "quote": "Två parallella utbildningar, en för rektorer och en för biträdande rektorer, skulle troligen innebära en stor överlappning i innehåll.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.11",
      "sentiment": 0.8,
      "quote": "Nämnden delar utredningens uppfattning om att den som leder en skolverksamhet som vilar på vetenskaplig grund ska ha en högskoleexamen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2.1",
      "sentiment": -0.2,
      "quote": "De sammanvägda konsekvenserna av de olika förslagen behöver beaktas i ett sammanhang, som en helhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2.3",
      "sentiment": 0.2,
      "quote": "Fördelar med att införa gemensamma system måste överväga de risker och kostnader som finns vid ett införande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2.4",
      "sentiment": 0.8,
      "quote": "Nämnden instämmer i bedömningen då det är viktigt att rektor har kunskap om och möjlighet att leda det tvärprofessionella elevhälsoarbetet i skolorna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2.5",
      "sentiment": 0.5,
      "quote": "Nämnden ser positivt på att denna fråga ska utredas vidare.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.2.6",
      "sentiment": 0.8,
      "quote": "Nämnden delar utredningens uppfattning och instämmer i vikten av att möjligheter skapas för rektorer att nå masterexamen som kvalificerar för forskarutbildning.",
