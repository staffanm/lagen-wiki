  "segments": [
    {
      "forarbete_id": "a7.1.1",
      "sentiment": 0.8,
      "quote": "Som konstateras i utredningen saknas det idag en gemensam förståelse av begreppet vilket riskerar att leda till otydlighet i ansvarsfördelning och variation i hur uppdraget kan tolkas och genomföras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.2",
      "sentiment": -0.2,
      "quote": "En sådan uppdelning riskerar att leda till en mer fragmentiserad organisation vilket i sin tur kan försvåra kontinuiteten i elevernas skolgång samt minska förutsägbarheten för både elever och vårdnadshavare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.3",
      "sentiment": 0.8,
      "quote": "Då utredningen lämnat förslag på hur rektorns pedagogiska ledarskap ska definieras i skollagen finns det också en logik i att det i lagen förtydligas att huvudmannen har ett ansvar för att säkerställa förutsättningarna för rektor att utöva detta ledarskap.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.4",
      "sentiment": -1.0,
      "quote": "Skulle beslutanderätten decentraliseras till rektor riskerar det att skapa en ökad otydlighet kring roller och mandat i styrkedjan och försvåra huvudmannens insyn och ansvar för skolans ledning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.5",
      "sentiment": 1.0,
      "quote": "ser det som positivt att det tydliggörs att rektorn alltid har det övergripande ansvaret för utbildningens kvalitet.",
