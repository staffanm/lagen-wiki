  "overall": {
    "sentiment": 0.0,
    "quote": "Skolinspektionen ser dock svårigheter att utöva tillsyn av flera av förslagen utifrån den föreslagna definitionen av rektors pedagogiska ledarskap.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a7.1.1",
      "sentiment": -0.5,
      "quote": "Den föreslagna lagtexten är för allmänt hållen för att Skolinspektionen ska kunna tillämpa den i tillsynen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.2",
      "sentiment": -0.5,
      "quote": "Då ovan nämnda definition av pedagogiskt ledarskap (se förslag 7.1.1) föreslås ligga till grund för bestämmelsen innebär det dock att även detta förslag är för allmänt hållet för att ligga till grund för ett föreläggande inom tillsyn.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.3",
      "sentiment": -0.5,
      "quote": "Skolinspektionen avstyrker dock förslaget i sin nuvarande utformning då det grundas på förslaget om definitionen av pedagogiskt ledarskap (se förslag 7.1.1) som Skolinspektionen anser vara för allmänt hållen för att kunna tillämpas inom tillsyn.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.4",
      "sentiment": -0.2,
      "quote": "Det kan vidare konstateras att det varken av lagtexten eller motiveringen framgår vad som närmare avses med ”annat ledningsstöd”.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.5",
      "sentiment": -0.5,
      "quote": "Då den föreslagna definitionen av pedagogiskt ledarskap (se förslag 7.1.1) föreslås ligga till grund för denna bestämmelse innebär det att även denna bestämmelse är alltför allmänt hållen för att kunna tillämpas inom myndighetens tillsyn.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.7",
      "sentiment": 0.5,
      "quote": "Den föreslagna förändringen av bestämmelsen bör dessutom förenkla myndighetens tillsyn, detta eftersom nuvarande bestämmelse är mer allmänt hållen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.8",
      "sentiment": -0.5,
      "quote": "Myndigheten ser dock svårigheter i att bedöma om huvudmannen sett till att rektorn fått ett godkänt resultat.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.11",
      "sentiment": 0.5,
      "quote": "Skolinspektionen anser att ett sådant förtydligande bör bidra till att minska risken för intressekonflikter som kan uppstå om en och samma person är både rektor och skolchef.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.12",
      "sentiment": 0.5,
      "quote": "Mot bakgrund av skolchefens betydelsefulla roll, att bistå huvudmannen i arbetet med regelefterlevnad, måluppfyllelse och kvalitet i huvudmannens verksamhet och vidta åtgärder för att tillse att författningarna följs, anser Skolinspektionen att det är positivt att behörighetskrav införs i skollagen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2.2",
      "sentiment": 0.5,
      "quote": "Ett komplett huvudmanna- och skolenhetsregister skulle bidra till både bättre information och förutsättningar för Skolinspektionen att utföra träffsäker inspektion.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2.3",
      "sentiment": 0.5,
      "quote": "Det skulle sannolikt bidra till bättre förutsättningar för en effektivare verksamhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2.4",
      "sentiment": 0.5,
      "quote": "Som framgår av utredningen är Skolinspektionens erfarenhet att en viktig förutsättning för att rektorn framgångsrikt ska kunna leda och samordna elevhälsoarbetet är att denne har adekvat kompetens.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2.7",
      "sentiment": 0.5,
      "quote": "De handlar exempelvis om risk för att skolutvecklingen stannar av och sämre förutsättningar för lärare att bedriva framgångsrik undervisning.",
      "quote_type": "grund"
    }
  ]
