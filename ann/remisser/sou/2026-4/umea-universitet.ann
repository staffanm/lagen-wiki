  "overall": {
    "sentiment": 0.2,
    "quote": "Syftet med utredningen, att rektor ska få mer mandat och bättre förutsättningar, är vällovligt men det finns uppenbara risker att förslagen är så tolkningsbara att de inte ger avsedda effekter.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a7.1.1",
      "sentiment": 0.5,
      "quote": "Det sker endast om även huvudmän och statliga aktörer är engagerade i de frågor som direkt rör utbildningen och undervisningen av barn och elever.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.2",
      "sentiment": 0.2,
      "quote": "samtidigt är det problematiskt eftersom det är svårt att genomföra i praktiken då det inte går att precisera utifrån heterogeniteten bland huvudmän och skolor.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.3",
      "sentiment": 0.2,
      "quote": "Det finns en risk att det som är menat som stöd och utförs som gemensamt arbete och lärande för rektorsgruppen på förvaltningsnivå tar tid från rektors arbete på den egna skolan",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.4",
      "sentiment": 1.0,
      "quote": "Vi ställer oss positiva till förslaget som en precisering av nuvarande lagstiftning (2010:800, kap. 2. §).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.5",
      "sentiment": 0.5,
      "quote": "Det är viktigt att påpeka att det kräver ett undervisningsfokus i hela styrkedjan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.7",
      "sentiment": 0.2,
      "quote": "Samtidigt saknar vi ett uttryckligt behörighetskrav som säkerställer att rektor även har utbildning eller dokumenterad erfarenhet av ledarskap.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.8",
      "sentiment": 0.8,
      "quote": "Vi bedömer att det är en viktig markering som inte kommer att få negativa konsekvenser för utbildningens innehåll eller upplägg.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.11",
      "sentiment": 0.8,
      "quote": "Vi stödjer förslaget att samma person inte ska inneha två så viktiga funktioner som rektor och skolchef samtidigt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.12",
      "sentiment": 0.5,
      "quote": "Skolchefer har ett övergripande ansvar för att leda rektorer och lärare med långa och kvalificerade utbildningar, vilket förutsätter en gedigen akademisk grundkompetens.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2.2",
      "sentiment": 1.0,
      "quote": "Ett samlat och aktuellt register skulle väsentligt underlätta sådan samverkan samt bidra till bättre planering, uppföljning och kunskapsutveckling inom skolväsendet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2.4",
      "sentiment": 1.0,
      "quote": "Det behandlas redan idag inom det nationella rektorsprogrammet och bör även fortsättningsvis vara ett av inslagen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2.5",
      "sentiment": 0.8,
      "quote": "I dagsläget saknas både tydliga incitament och en samlad struktur för rektorers långsiktiga kompetensutveckling.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2.6",
      "sentiment": 0.5,
      "quote": "Det nuvarande systemet innebär att utbildningsinsatser ibland planeras men inte genomförs på grund av begränsat deltagarunderlag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2.7",
      "sentiment": 0.5,
      "quote": "På motsvarande sätt bör man erbjuda skolor som har små huvudmän särskilt stöd då det ofta innebär att det inte finns tillräcklig kompetens eller resurser för att ge rektor det stöd som är nödvändig i att hantera många olika sorters frågor.",
      "quote_type": "grund"
    }
  ]
}