  "overall": {
    "sentiment": 0.5,
    "quote": "Förbundets sammantagna bedömning är att utredaren lyckats väl med sitt uppdrag och presenterat förslag som har goda förutsättningar att komma till rätta med de organisatoriska svårigheter som idag försvårar rektorsuppdraget på många håll.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a7.1.1",
      "sentiment": 0.5,
      "quote": "Förbundet ställer sig bakom utredarens förslag och framhåller att en tydligare definition i skollagen förväntas kunna bidra till att säkerställa kvalitet i verksamheterna genom att tydliggöra rektors huvudsakliga uppgifter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.2",
      "sentiment": 0.8,
      "quote": "Genom regleringen skulle man kunna motverka den nuvarande trenden som tenderar lyfta rektorsbefattningen allt högre upp i organisationerna och som fjärmar rektor från det undervisningsnära arbetet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.3",
      "sentiment": 0.5,
      "quote": "Då det fortsatt inte är ovanligt att finansieringen av utbildningsverksamheten hos en huvudman fastställs utifrån kommunens finansiella förutsättningar snarare än barns och elevers behov, kommer det även fortsättningsvis att finnas organisationer detta inte kommer att fungera som avsett.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.4",
      "sentiment": 0.8,
      "quote": "Sveriges Skolledare blir återkommande uppmärksammade på situationer när detta inte fungerar som avsett i dag och ser att ett förtydligande behövs.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.5",
      "sentiment": 0.8,
      "quote": "Sveriges Skolledare ser att denna reglering är nödvändig för att säkerställa avsikten med reformen och tydliggöra att rektorn ska vara en undervisningsnära ledare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.7",
      "sentiment": 0.2,
      "quote": "Att öka behörighetskraven kan vara ett sätt att komma tillrätta med detta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.8",
      "sentiment": 0.5,
      "quote": "Om det föreslagna förtydligandet innebär att fler huvudmän blir bättre på att anpassa uppdrag och ge förutsättningar för framgångsrika studier är det mycket värdefullt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.11",
      "sentiment": -0.5,
      "quote": "Förbundet ser att denna reglering kan komma att avsevärt försvåra för mindre verksamheter och avråder därför från förslaget.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.12",
      "sentiment": 0.8,
      "quote": "Sveriges Skolledare bedömer det som rimligt att skolchefer bör ha en utbildning som till nivå inte avviker från den som övriga professionella inom sektorn befinner sig på.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2.1",
      "sentiment": 0.8,
      "quote": "Skärpta kvalitetskrav kommer sannolikt inte att ge avsedd effekt för barn och elever om inte dessa grundläggande förutsättningar finns på plats.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2.2",
      "sentiment": 0.8,
      "quote": "Ett register, förutsatt att det går att föra med hög informationskvalitet, skulle underlätta i sådana fall och förbundet delar därför utredarens bedömning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2.3",
      "sentiment": 0.8,
      "quote": "Sveriges Skolledare delar utredarens bedömning och framhåller att det finns stora arbetsmiljövinster att göra för landets skolledare med en förbättrad infrastruktur på IT-området inom skolväsendet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2.4",
      "sentiment": 0.0,
      "quote": "Mot bakgrund av att dagens rektorsprogram är fullmatat och att många skolledare uppfattar det som rejält utmanande att genomföra det med hög ambitionsnivå parallellt med ett rektorsuppdrag, ser förbundet det inte som möjligt att tillföra ytterligare innehåll utan att andra förändringar görs.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2.5",
      "sentiment": 0.8,
      "quote": "Förbundet kommer att arbeta för att en sådan utredning kommer till stånd.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.2.6",
      "sentiment": 0.8,
      "quote": "Sveriges Skolledare ser att ett system för meritering skulle kunna utgöra ramen för dessa insatser.",
      "quote_type": "grund"
