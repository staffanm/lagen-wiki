  "overall": {
    "sentiment": 0.2,
    "quote": "Särskilt positivt är att huvudmannens ansvar tydliggörs samt att pedagogiskt ledarskap definieras som rektors kärnuppdrag.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a7.1.1",
      "sentiment": 0.2,
      "quote": "En långtgående juridifiering riskerar att:  låsa in pedagogiskt ledarskap i en statisk begreppsram,  försvåra situerade och verksamhetsnära tolkningar,  påverka det professionella och vetenskapliga samtalet negativt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.2",
      "sentiment": 0.5,
      "quote": "Det är en nödvändig förutsättning för att ett pedagogiskt ledarskap över huvud taget ska kunna utövas i enlighet med styrdokumentens intentioner.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.3",
      "sentiment": 0.5,
      "quote": "Utan detta finns risk för att ansvaret i praktiken förskjuts till rektor, trots att förutsättningarna inte är givna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.4",
      "sentiment": 0.5,
      "quote": "Ett starkare mandat att besluta om den inre organisationen bedöms kunna:  stärka rektors autonomi,  öka anpassningen till lokal kontext,  förbättra arbetsmiljö och effektivitet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.5",
      "sentiment": 0.2,
      "quote": "Den kollektiva ledningspraktik som i dag är vanlig mellan rektor och biträdande rektor kan försvagas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.7",
      "sentiment": 0.5,
      "quote": "Samtidigt kan ett alltför snävt krav på lärarutbildning:  låsa in behörighetsbegreppet,  minska tillgången till andra kompetenta ledare med pedagogisk erfarenhet,  bidra till att kvalificerade lärare lämnar undervisningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.8",
      "sentiment": 1.0,
      "quote": "Tillstyrks",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.1.11",
      "sentiment": 0.2,
      "quote": "För mindre huvudmän, inklusive glesbygdskommuner och fristående huvudmän med begränsade administrativa resurser, riskerar en strikt åtskillnad mellan rollerna att medföra ökade administrativa belastningar och i vissa fall minska den skolnära kompetensen i skolchefsfunktionen.",
      "quote_type": "grund"
    },
