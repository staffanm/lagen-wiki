  "segments": [
    {
      "forarbete_id": "sec177",
      "sentiment": -0.5,
      "quote": "LOs sammantagna uppfattning är att utredningens förslag för att genomföra art. 4 och 5 i direktivet, dvs. 2 kap. 1-3 §§ i författningsförslaget, inte är tillräckliga för att uppfylla direktivets krav vad gäller sysselsättningsstatus och inrättandet av en rättslig presumtion.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec178",
      "sentiment": -0.2,
      "quote": "LO efterlyser därför en djupare analys av presumtionens påverkan på arbetstagarbegreppet inom skatterätten, arbetslöshetsförsäkringen och socialrätten innan lagstiftningen införs.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec177",
      "sentiment": -0.5,
      "quote": "LO anser därför att utredningens förslag i detta hänseende inte är tillräckligt utrett och bör utredas vidare innan lagstiftningen kan införas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec191",
      "sentiment": 0.5,
      "quote": "Men även om detta är ett steg i rätt riktning så löser inte förslaget alla oklarheter och den problematik som fortfarande kommer att finnas kopplat till det faktiska arbetsmiljöansvaret när plattformsarbetare arbetar via en intermediär.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec367",
      "sentiment": 1.0,
      "quote": "LO betonar att det är av största vikt att plattformsarbetare som arbetar genom en intermediär också i praktiken har samma skyddsnivå som den som arbetar direkt genom arbetsplattformen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7",
      "sentiment": 1.0,
      "quote": "LO välkomnar att utredningens förslag till genomförande i detta kapitel tar sitt avstamp utifrån gällande reglering av arbetsmarknaden.",
      "quote_type": "grund"
