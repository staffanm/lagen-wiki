  "overall": {
    "sentiment": 0.5,
    "quote": "Taxiunionen anser att genomförandet av plattformsdirektivet måste utgå från de faktiska maktförhållandena på marknaden.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a4.2.2",
      "sentiment": 0.5,
      "quote": "Utredningen konstaterar att svensk rätt till stor del saknar bestämmelser som motsvarar plattformsdirektivets regler och att det därför är svårt att genomföra direktivet i befintliga lagar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.2.1",
      "sentiment": 0.5,
      "quote": "I taxibranschen är det vanligt att plattformen behåller den faktiska ekonomiska och tekniska styrningen samtidigt som ett åkeri används som formell motpart.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2.5",
      "sentiment": 0.2,
      "quote": "När plattformen i praktiken sätter både kundpriset och förarersättningen i en marknad där föraren annars borde ha verkligt inflytande över sin taxa, är det ett tungt indicium på arbetsledning och ekonomisk kontroll.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5.3",
      "sentiment": 1.0,
      "quote": "För taxi är det särskilt viktigt att datainsamlingen begränsas och att plattformen inte använder breda mängder beteendedata utan tydligt lagstöd och utan verklig insyn.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.6.4",
      "sentiment": 0.5,
      "quote": "Konsekvensbedömningarna måste uttryckligen omfatta prisalgoritmer, ersättningssystem och system för fördelning av körningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.9.3",
      "sentiment": 0.2,
      "quote": "I taxi måste dessa rättigheter också kunna användas när den arbetspresterande parten systematiskt erbjuds sämre ersättning, sämre körningar eller missgynnas genom automatiserad pris- eller fördelningsstyrning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.11.3",
      "sentiment": 0.5,
      "quote": "Dessa regler måste uttryckligen förstås som omfattande automatiserad prissättning, ersättningsdifferentiering och fördelning av resor.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.4.5",
      "sentiment": -0.5,
      "quote": "I taxibranschen har plattformarna organiserat verksamheten på ett sätt som skiljer den faktiska ekonomiska styrningen från den formella arbetsgivarrelationen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.5",
      "sentiment": 0.5,
      "quote": "Informationsskyldigheten måste i praktiken användas för att få fram data om hur pris- och ersättningsmodellerna fungerar, hur körningar fördelas, hur intermediärerna används och hur stor del av resans värde som går till plattformen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5",
      "sentiment": 0.2,
      "quote": "Mellanled används ofta för att försvåra ansvarsutkrävande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.7.3",
      "sentiment": 1.0,
      "quote": "För taxiförare är möjligheten att jämföra erbjudna körningar, ersättningar och mönster i prissättningen central för att kunna upptäcka missförhållanden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.8.3",
      "sentiment": 0.2,
      "quote": "Skyddet blir svagt om det inte går att få fram underlag om varför en viss resa erbjudits med visst pris till kund, varför en viss förare erbjudits en viss ersättning eller varför samma resa kan ha visats olika för olika förare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10",
      "sentiment": 0.2,
      "quote": "Myndigheter och berörda aktörer bör få tydlig vägledning i god tid, särskilt om hur prisalgoritmer, intermediärer och representationsfrågor ska bedömas.",
      "quote_type": "grund"
    }
  ]
}