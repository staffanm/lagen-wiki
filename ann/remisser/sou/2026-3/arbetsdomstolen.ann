  "segments": [
    {
      "forarbete_id": "sec180",
      "sentiment": 0.2,
      "quote": "Arbetsdomstolen efterfrågar dock ett resonemang kring varför inte den digitala plattformen eller intermediären, dvs. de i sammanhanget potentiella arbetsgivarna, ska ha motsvarande rätt att föra en negativ fastställelsetalan om att dessa aktörer inte är en arbetsgivare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec313",
      "sentiment": -0.2,
      "quote": "Arbetsdomstolen saknar dock ett närmare resonemang kring vem en sådan särskild representant skulle kunna vara och vilken rättslig ställning den har i förhållande till bestämmelserna i den föreslagna lagen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec367",
      "sentiment": -1.0,
      "quote": "Mot denna bakgrund anser domstolen att bestämmelsen är onödigt ingripande och även tvistedrivande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec365",
      "sentiment": -0.5,
      "quote": "En sådan ordning medför att Arbetsdomstolen kan få handlägga olika typer av tvister som inte är arbetstvister och inte heller förs av de som normalt är parter i domstolen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec439",
      "sentiment": -0.2,
      "quote": "Arbetsdomstolens anser att utredningen kan ha underskattat den potentiella måltillströmning som den föreslagna lagen ger upphov till, inte minst mot bakgrund av den rättsliga presumtion som föreslås i 2 kap. 1 och 2 §§ lagen om plattformsarbete samt den därtill kopplade möjligheten att föra en fastställelsetalan enligt 2 kap. 5 §.",
      "quote_type": "grund"
    }
  ]
