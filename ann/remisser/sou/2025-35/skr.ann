  "segments": [
    {
      "forarbete_id": "a8.1.3",
      "sentiment": 1.0,
      "quote": "SKR tillstyrker förslag om kriterier i fördelningsmodellen där de tillkommande kriterierna jämfört med idag är kommunernas önskemål, bostadsmarknad och förekomsten av områden med utmaningar av utanförskap.",
