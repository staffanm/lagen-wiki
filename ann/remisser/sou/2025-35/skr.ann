    },
    {
      "forarbete_id": "a9.8.2",
      "sentiment": 0.2,
      "quote": "Kommunen har inte kompetens att bedöma vilka grunder som kan tänkas föreligga för ett uppehållstillstånd och det utlänningsrättsliga regelverket är därutöver komplicerat.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.9",
      "sentiment": -0.2,
      "quote": "Dels riskerar en ordning där endast kvotflyktingar ska matchas en undanträngning av möjligheter för nyanlända som anvisas från anläggningsboende.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.3",
      "sentiment": 0.5,
      "quote": "Mot bakgrund av vad som här anförts, för att främja långsiktig integration och motverka negativa flyttmönster bland nyanlända, anser SKR att regleringen om nyanländas rätt till etableringsboende ska gälla under tre år men att det ska framgå av regelverket att kommunen får erbjuda etableringsboende under längre tid.",
      "quote_type": "grund"
