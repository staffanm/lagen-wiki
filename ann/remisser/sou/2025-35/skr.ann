    },
    {
      "forarbete_id": "a9.3",
      "sentiment": -0.5,
      "quote": "Det framstår också som krångligt och oförutsägbart för kommunen att under tre år ha ansvar att erbjuda etableringsboende för personer som aldrig har tagits emot i kommunen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.6.2",
      "sentiment": 0.2,
      "quote": "Det är enligt SKR helt nödvändigt för att ge kommunerna rimliga förutsättningar för sitt åtagande.",
