  "segments": [
    {
      "forarbete_id": "a8.1.3",
      "sentiment": 1.0,
      "quote": "Att bostadsmarknaden och förekomsten av områden med problem kopplade till utanförskap ska påverka fördelningen, kan få till följd att en lägre andel kommer att anvisas till Göteborg.",
      "quote_type": "grund"
