    {
      "forarbete_id": "a9.9",
      "sentiment": 0.2,
      "quote": "Det finns annars en risk att uppgiften inte kommer att kunna genomföras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.3",
      "sentiment": -0.5,
      "quote": "Förslaget om begränsning till tre år kan leda till ökad hemlöshet, försämrade uppväxtvillkor för barn som behöver bo i osäkra boendeförhållanden och flytta ofta samt en försvårad integrationsprocess.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.2",
      "sentiment": 1.0,
      "quote": "Det fördröjer risken att nyanlända söker sig till andra kommuner och kanske dåliga boendelösningar för att de inte hittar bostad i bosättningskommunen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.6.2",
      "sentiment": -0.2,
      "quote": "det kan bli en utökad uppgift för kommunen att begära ut uppgifter från Arbetsförmedlingen om detta är en kontroll som ska göras av alla i etableringsboende.",
