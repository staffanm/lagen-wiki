    {
      "forarbete_id": "sec227",
      "sentiment": 0.5,
      "quote": "det är viktigt att myndigheten får förutsättningar att föra dialog med kommunerna för att det ska motsvara den kommunikation som länsstyrelserna ansvarar för idag.",
      "quote_type": "grund"
