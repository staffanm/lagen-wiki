  "overall": {
    "sentiment": 0.2,
    "quote": "Länsstyrelsen Västra Götaland är i huvudsak positiv till utredningens förslag om länsstyrelsernas uppdrag det nya bosättningssystemet.",
    "quote_type": "standpunkt"
  },
  "segments": [
    {
      "forarbete_id": "a8.1.3",
      "sentiment": -1.0,
      "quote": "Den huvudsakliga anledningen är att förslaget väntas motverka fördelningen av nyanlända mellan kommunerna på grund av arbetsmarknadsförutsättningar, vilket kan försämra nyanländas arbetsmarknadsetablering.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.2",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen är positiv till att samrådsförfarandet i framtagandet av fördelnings- och takmodellen enligt förslagen ska bedrivas på ett liknande sätt som dagens samråd gällande läns- och kommuntal.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.4.4",
      "sentiment": 0.2,
      "quote": "Förslaget till etableringsboendeförordning och Figur 8.1 Utredningens förslag till fördelningsförfarande på sidan 193 i utredningen är dock inte tillräckligt tydliga vad gäller länsstyrelsernas roll i detta avseende.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.3",
      "sentiment": 0.5,
      "quote": "Det är Länsstyrelsens uppfattning att långsiktigt hållbara boendelösningar är en grundläggande förutsättning för nyanländas integration.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.6.1",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen tillstyrker förslaget i kap. 10.6.1 att den kommun som ansvarar för att ordna boende i enskilda fall får besluta att den nyanländes rätt till etableringsboende ska upphöra i förtid om den nyanlände skiljts från den bostadslägenhet kommunen ordnat efter att dennes hyresrätt förverkats med stöd av 12 kap. 42 § jordabalken.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a10.6.2",
      "sentiment": -1.0,
      "quote": "Länsstyrelsen ser inte att förslaget är motiverat då det väntas få små om några positiva effekter för nyanländas deltagande i arbetsmarknadspolitiska program, men leda till negativa effekter för nyanländas integration och ökad arbetsbelastning för det offentliga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3",
      "sentiment": 0.5,
      "quote": "Genom att inkludera länsstyrelsernas uppföljningsuppdrag i förordningen, knyts det uppdraget tydligare till kommunernas bosättningsuppdrag och även till länsstyrelsernas uppdrag att föra dialog med kommunerna om planeringen för mottagandet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a18.7.3",
      "sentiment": -0.5,
      "quote": "Länsstyrelsens bedömning är därför att behovet av insatser i alla fall inledningsvis kommer att öka till följd av utredningens förslag.",
      "quote_type": "grund"
    }
  ]
}