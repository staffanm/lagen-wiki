  "overall": {
    "sentiment": 0.0,
    "quote": "Länsstyrelsen betonar vår centrala roll som kunskaps- och informationsmyndighet med en nyckelfunktion i samverkan, samordning och uppföljning inom mottagandet av målgruppen i sin helhet, där bosättningsprocessen ingår som en del.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a8.1",
      "sentiment": -0.2,
      "quote": "Vi anser att kommunernas möjlighet att lämna önskemål redan ger tillräcklig flexibilitet för att ta hänsyn till boendeförutsättningar och socioekonomiska utmaningar vid fördelningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": 0.5,
      "quote": "Som kunskapsmyndighet med etablerade dialoger och god kännedom om kommunernas förutsättningar har länsstyrelserna en central roll som informationsbärare och samordnare i hela processen och mottagandet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4",
      "sentiment": 0.5,
      "quote": "Det underlättar för alla parter om en myndighet ansvarar för att samordna informationen och dialogen med kommunerna samt sammanställer deras önskemål.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.1",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen tillstyrker förslagen.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a9.2",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen tillstyrker att kommuntalet ska kunna överskridas när det är nödvändigt för att beakta barnets bästa.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a9.3",
      "sentiment": 0.0,
      "quote": "Länsstyrelsen bedömer dock att det finns en risk för att andelen avbrutna bosättningar kan komma att öka om kommunernas önskemål får större genomslag i fördelningsprocessen, särskilt om dessa inte överensstämmer med de anvisades egna preferenser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.4",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen tillstyrker förslaget och instämmer i att en prognos ger en mer realistisk och mindre missvisande bild än en planering.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5",
      "sentiment": 0.5,
      "quote": "Länsstyrelsen tillstyrker förtur vid anvisningar för ärenden med barn och anser att även andra särskilt utsatta grupper, såsom våldsutsatta kvinnor, bör ges förtur.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a9.6",
      "sentiment": 0.2,
      "quote": "Länsstyrelsen tillstyrker förslaget, men vill samtidigt understryka att det är problematiskt att den reglerade tidsfristen på två månader ofta inte följs för nyanlända som bott på asylboende.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.7",
      "sentiment": 1.0,
      "quote": "Förslaget omfattar rimliga områden för dialog och kan kopplas till länsstyrelsens bredare uppdrag att verka för beredskap och kapacitet att ta emot nyanlända (förordning 2016:1363).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.1",
      "sentiment": 0.5,
      "quote": "Vi föreslår därför att formuleringen ”bör” ändras till ”ska ha rätt” eller ”har rätt” för att undvika tolkningsutrymme och stärka rättighetsperspektivet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.2",
      "sentiment": 0.5,
      "quote": "Länsstyrelsen vill föreslå att lokaliserings- och kvalitetsaspekter tydligt framgår i regelverket, så att intentionen att främja etablering och integration samt motverka utsatthet beaktas i kommunernas arbete med etableringsboenden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.3",
      "sentiment": -1.0,
      "quote": "Vi föreslår istället att rätten bör gälla i minst tre år, en gemensam miniminivå, för att undvika otrygga boendeförhållanden och försämrade förutsättningar för integration.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.4",
      "sentiment": 0.2,
      "quote": "En risk är att nyanlända accepterar en anvisning av taktiska skäl – inte för att bosätta sig, utan för att behålla rätten till etableringsboende som en trygghetsåtgärd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.6",
      "sentiment": -0.5,
      "quote": "De aktuella programmen är redan kopplade till ekonomiska ersättningar, vilket bör utgöra tillräckliga incitament för deltagande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.1",
      "sentiment": 0.5,
      "quote": "Länsstyrelsen föreslår också att kommunens ansvar att ”erbjuda den nyanlände stöd i att söka bostad” kompletteras i förordningen med en skrivning om att stödet även ska omfatta insatser som stärker nyanländas förutsättningar att etablera sig på bostadsmarknaden och förebygga vräkning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen har en viktig och upparbetad roll i att följa upp och föra dialog med kommunerna samt samordna och samverka för att ge stöd, men kan spela en än större roll i att följa upp helheten av de relativa förutsättningarna för integration i län och kommuner.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a18.7.3",
      "sentiment": -1.0,
      "quote": "Länsstyrelsen anser att det saknas tillräckligt stöd för att motivera minskad finansiering.",
      "quote_type": "grund"
    }
  ]
