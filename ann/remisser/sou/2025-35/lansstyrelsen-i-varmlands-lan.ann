  "overall": {
    "sentiment": 0.2,
    "quote": "Länsstyrelsen tillstyrker i stor del utredningens förslag och ser särskilt positivt på de förslag till förbättringar som gjorts utifrån ett barnperspektiv, att etableringsboendet är en individuell rättighet samt att personer som nu omfattas av massflyktsdirektivet inte kommer behöva anvisas två gånger till en kommun.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "sec192",
      "sentiment": -0.5,
      "quote": "Det nya kriteriet kopplat till bostadsförsörjning kommer troligtvis inte få önskad effekt, då kommuner med god bostadsmarknad ofta har sämre arbetsmarknadsförutsättningar, vilket på sikt försämrar integrationsförutsättningarna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec193",
      "sentiment": -0.5,
      "quote": "I en kommun med socioekonomiska utmaningar i vissa delar av kommunen kan arbetsmarknadsförutsättningarna i stort vara goda, men vid beaktandet av detta kriterium får hela kommunen en lägre tilldelning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec211",
      "sentiment": 1.0,
      "quote": "Det bidrar till kunskapsöverföring och synergier mellan områdena integration, bostadsförsörjning och utanförskap som kan nyttjas på fler sätt än i arbetet med fördelningsmodellen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.1",
      "sentiment": -0.2,
      "quote": "Med en mer komplex process bedömer vi att det är för sent att länsstyrelserna kommer in i informationsprocessen först när anvisningstalen redan är fastställda (2 kap. 11 § i den föreslagna förordningen).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.3",
      "sentiment": 0.5,
      "quote": "Om sådana önskemål beviljas finns en överhängande risk att mottagningsverksamhet i berörda kommuner avvecklas och att befintlig kunskap, kompetens och strukturer går förlorade.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.4",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen tillstyrker förslaget om att länsstyrelserna får i uppdrag att sammanställa kommunernas önskemål och informera Migrationsverket om önskemålen.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a10.1",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen tillstyrker förslaget att etableringsboende föreslås bli en rättighet.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a10.3",
      "sentiment": -0.5,
      "quote": "Ett fast maxtak riskerar att bli normerande nedåt och leda till att dessa mer långsiktiga lösningar avvecklas, med försvagad stabilitet och sämre etableringsförutsättningar för de nyanlända som följd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.6.2",
      "sentiment": -1.0,
      "quote": "Ett villkorat boende innebär att nyanländas boendesituation blir än mer otrygg och kan förstärka upplevelser av utsatthet och utanförskap.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen tillstyrker förslaget om nytt uppdrag till Länsstyrelsen att följa upp kommunernas ansvar för etableringsboende.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a18.7.3",
