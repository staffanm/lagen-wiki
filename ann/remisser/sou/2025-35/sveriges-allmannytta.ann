  "segments": [
    {
      "forarbete_id": "sec191",
      "sentiment": 1.0,
      "quote": "Sveriges Allmännyttas medlemmar har på vissa orter lediga lägenheter och på andra ett stort söktryck.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec192",
      "sentiment": 1.0,
      "quote": "Prognoserna utifrån den demografiska utvecklingen pekar mot att dessa skillnader kommer att bli än större i framtiden mellan olika delar av landet .",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec193",
      "sentiment": 1.0,
      "quote": "Det är välkänt att nyanlända ofta hamnar i bostadsområden med socioekonomiska utmaningar vilket kan försvåra integrationen i samhället.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.3",
      "sentiment": 1.0,
      "quote": "Det kan även vara vägledande i de fall bostadsföretagen är osäkra på hur man bäst löser uppgiften med att tillhandahålla lägenheter för de anvisade.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.5",
      "sentiment": 0.2,
      "quote": "Saknas besittningsskydd för hyresgästen, vilket sägs gälla i dessa fall, finns rimligen inget hinder för att säga upp avtalet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.6",
      "sentiment": 1.0,
      "quote": "Det är inte rimligt att en kommun under tre år ska ansvara för att ordna nya boenden för nyanlända som inte betalar hyran eller bryter mot andra avtalsenliga skyldigheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.1",
      "sentiment": 1.0,
      "quote": "Sveriges Allmännytta delar bedömningen att detta kommer att öka chansen för den nyanlände att ha möjlighet att få ett hyreskontrakt efter att rätten till etableringsboende löpt ut.",
      "quote_type": "grund"
    }
  ]
