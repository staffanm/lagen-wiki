  "overall": {
    "sentiment": 0.2,
    "quote": "Jag anser att det finns vissa otydligheter vad gäller förslaget om anvisningsförfarande, att utredningens beräkning av tidsåtgången per nyanländ för stöd i att söka bostad är för låg samt att utredningen inte i tillräcklig omfattning har utrett konsekvenserna förslagen riskerar att få för kommunernas kostnader, både vad gäller uppdraget att ordna etableringsboende men även vad gäller ekonomiskt bistånd.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "sec10",
      "sentiment": 0.8,
      "quote": "Stadsledningskontoret ser att kommunernas möjlighet att önska hur många nyanlända kommunerna vill ta emot kan bidra till att upprätthålla kapacitet och kompetens i de kommuner som vill ta emot, vilket kan bidra positivt till nyanländas etablering.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.9.3",
      "sentiment": -0.2,
      "quote": "Stadsledningskontoret anser att utredningens förslag om att Arbetsförmedlingen ska rekommendera Migrationsverket om en eller flera lämpliga kommuner som en kvotflykting kan anvisas till är otydlig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2.2",
      "sentiment": 1.0,
      "quote": "Prioritering av barn och möjlighet att överskrida kommuntal för barnets bästa är en viktig förbättring jämfört med nuvarande bosättningslag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.2",
      "sentiment": -0.2,
      "quote": "En instabil boendesituation kan leda till försämrad integration och etablering.",
