  "overall": {
    "sentiment": 0.0,
    "quote": "Kungsbacka kommun har ingen erinran mot huvuddelen av utredningens förslag, men avstyrker • att etableringsboende ska vara en ovillkorlig rättighet för nyanlända i anvisningskommunen när eget boende har ordnats på egen hand. • rätten att överklaga kommunens beslut om upphörande av etableringsboende i förtid genom förvaltningsbesvär. • tidsfrister för mottagande.",
    "quote_type": "standpunkt"
  },
  "segments": [
    {
      "forarbete_id": "a8.2",
      "sentiment": 1.0,
      "quote": "utredningen genomsyras av statistiska antaganden som är ”svåra att uppskatta”, vilket tyder på en brist i myndigheternas uppföljning, tillsyn och kontroll för bland annat statistiska ändamål, effektiv verksamhet eller för allsidiga beslutsunderlag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.6",
      "sentiment": -0.5,
      "quote": "Kommunen föreslår i stället att tidsfristen förlängs till minst tre månader för bättre framförhållning, särskilt med hänsyn till principen om barnets bästa och till de begränsade förutsättningar som en stor del av kvotflyktingar kommer med.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.3",
      "sentiment": -0.5,
      "quote": "Kommunen anser att nuvarande ordning är tillräcklig och att kommunens skyldighet att anordna boende för nyanlända invandrare tidsbegränsas till tre år.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.4",
      "sentiment": -0.5,
      "quote": "Boende på egen hand bör villkoras med något av de skäl som framgår av utredningen, till exempel studier på annan ort eller ett arbete för att kommunens skyldighet ska kvarstå.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.9",
      "sentiment": -0.5,
      "quote": "Laglighetsprövning är tillräckligt.",
