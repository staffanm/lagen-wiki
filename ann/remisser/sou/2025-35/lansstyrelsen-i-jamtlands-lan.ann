    },
    {
      "forarbete_id": "a8.4.4",
      "sentiment": 1.0,
      "quote": "Vi anser att detta går i linje med nuvarande arbetssätt vid fördelning av mottagande enligt massflyktsdirektivet och anvisningsandelar för ensamkommande barn.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.2",
      "sentiment": 0.5,
      "quote": "Boendets kvalitet har stor betydelse för möjligheten till etablering i arbets- och samhällsliv.",
