  "segments": [
    {
      "forarbete_id": "a9.7",
      "sentiment": 0.5,
      "quote": "Länsstyrelsen tillstyrker att myndigheten fortsatt ska föra dialog med kommunerna, men anser att detta bör regleras tydligare i etableringsboendeförordningen och kopplas till uppdraget om uppföljning av kommunernas arbete.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a18.7.3",
      "sentiment": -1.0,
      "quote": "Minskade resurser riskerar därför att försvaga uppdragets genomförande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.3",
      "sentiment": -0.5,
      "quote": "En fast övre gräns riskerar annars att motverka långsiktig integration och skapa otrygghet för enskilda, särskilt i kommuner med svag bostadsmarknad.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.6.2",
      "sentiment": -1.0,
      "quote": "Det riskerar att underminera tryggheten i boendesituationen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.1",
      "sentiment": -1.0,
      "quote": "Förslaget riskerar att skapa en målkonflikt mellan bostadsförsörjning och möjligheten till etablering på arbetsmarknaden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.1",
      "sentiment": 0.5,
      "quote": "Ett sådant tillvägagångssätt skapar bättre förutsättningar för en sammanhållen och effektiv process i fördelningsförfarandet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.2",
      "sentiment": 0.5,
      "quote": "Det är en nödvändig åtgärd för att säkra en fungerande implementering.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.3",
      "sentiment": 0.2,
      "quote": "Vi ser en risk med att kommuner kan önska, och beviljas, noll i kommuntal.",
