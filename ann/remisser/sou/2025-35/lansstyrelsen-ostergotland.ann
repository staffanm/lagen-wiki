    },
    {
      "forarbete_id": "a10.2.1",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen Östergötland tillstyrker förslaget att det inte ska vara möjligt för anvisningskommunen att ordna etableringsboende i en annan kommun i enlighet med den skyldighet som följer av etableringsboendelagen.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a10.3",
      "sentiment": -0.5,
      "quote": "Kommuner som önskar ska kunna erbjuda nyanlända mer långsiktiga boendelösningar direkt vid mottagande eller efter en kortare tid.",
