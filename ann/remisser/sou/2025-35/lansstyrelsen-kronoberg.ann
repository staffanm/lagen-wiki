  "overall": {
    "sentiment": 0.5,
    "quote": "Länsstyrelsen i Kronobergs län (härefter Länsstyrelsen) ser positivt på utgångspunkterna i remissen och intentionen att skapa ett mer hållbart och flexibelt system som främjar integration av nyanlända.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a8.1",
      "sentiment": -1.0,
      "quote": "En anledning är att de båda variablerna kan försämra nyanländas förutsättningar till etablering på arbetsmarknaden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.1",
      "sentiment": 0.5,
      "quote": "Länsstyrelsen bedömer det som viktigt att ansvaret för processen med information och dialog med kommunerna fortsatt åvilar Länsstyrelsen utifrån vår roll som regional myndighet med kunskap om lokala behov och förutsättningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.2",
      "sentiment": 0.5,
      "quote": "För att säkerställa att länsstyrelsen och övriga samrådsmyndigheter ges goda förutsättningar för utveckling av fördelnings- och takmodellerna krävs tillförande av medel för detta uppdrag, åtminstone inledningsvis.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.3",
      "sentiment": 0.0,
      "quote": "Enligt länsstyrelsen riskerar avsaknaden av golv att underminera det.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.7",
      "sentiment": 0.5,
      "quote": "På så vis knyts uppdraget tydligare till länsstyrelsernas uppdrag att följa upp kommunernas insatser och mottagande (11.3 i utredningen).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.2",
      "sentiment": -0.5,
      "quote": "Ges inte möjlighet för kommuner att fortsatt erbjuda längre hyreskontrakt riskerar förslaget om etableringsboende i max tre år innebära sämre förutsättningar för integration än vad som gäller i länet idag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.3",
      "sentiment": 0.5,
      "quote": "En rätt som i sig är en förstärkning av individens förutsättningar för en bättre integration.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.6.2",
      "sentiment": -1.0,
      "quote": "Ett villkorat boende skapar ovisshet, inte minst för barn, som kan ge negativa effekter på målgruppens integration, vilket motverkar syftet med det föreslagna bosättningssystemet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.1",
      "sentiment": 1.0,
      "quote": "Detta skulle kunna motverka aktiv medverkan till bosättning i annan kommun, så kallad ”social dumpning”.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3",
      "sentiment": 0.2,
      "quote": "Länsstyrelsen ser en risk med att reglera ett så specifikt uppföljningsuppdrag i det bredare uppdrag avseende beredskap och kapacitet som länsstyrelserna har utifrån förordning 2016:1363.",
