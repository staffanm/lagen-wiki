      "artifact:forarbete/sou/2025-35": "714b8500e63e7332a0838b0ab133e0525ceab22d4636b418ba3d2ac111780a44"
    }
  },
  "overall": {
    "sentiment": 0.2,
    "quote": "Länsstyrelsen Örebro (fortsättningsvis Länsstyrelsen) tillstyrker i stor del utredningens förslag och ser särskilt positivt på de förslag till förbättringar som gjorts utifrån ett barnperspektiv.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a8.1",
      "sentiment": -1.0,
      "quote": "Om intentionen är att styra mottagandet av nyanlända till kommuner där det finns bostäder finns det en stor risk att det blir kommuner där arbetsmarknadsförutsättningarna är sämre.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2",
      "sentiment": 0.5,
      "quote": "Det bidrar till kunskapsöverföring och synergier mellan områdena integration, bostadsförsörjning och utanförskap som kan nyttjas på fler sätt än i arbetet med fördelningsmodellen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.1",
      "sentiment": -0.2,
      "quote": "Med en mer komplex process bedömer vi att det är för sent att länsstyrelserna kommer in i informationsprocessen först när anvisningstalen redan är fastställda enligt § 11 i förslaget.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.2",
      "sentiment": 0.5,
      "quote": "Att inledningsvis ta fram en ny fördelningsmodell och takmodell (kap. 8.4.3.) för implementering kommer kräva extra arbetsinsatser för berörda myndigheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.3",
      "sentiment": 0.2,
      "quote": "Vi ser en risk med möjligheten att önska, och potentiellt få, 0 i kommuntal vilket kan komma att påverka kommunernas beredskap och kapacitet negativt på längre sikt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.2",
      "sentiment": -0.2,
      "quote": "För att säkerställa barns rätt till en trygg uppväxtmiljö och göra mottagandet mer jämlikt bör lagen innehålla en bestämmelse som garanterar viss boendekvalitet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.3",
      "sentiment": 0.2,
      "quote": "I stället för att få ett förstahandskontrakt redan efter några månader så kommer de nyanlända att få ett etableringsboende i tre år vilket innebär en större osäkerhet kring boendesituation under en betydligt längre tid.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.1",
      "sentiment": 0.5,
      "quote": "Kommunens stöd bör inte enbart fokusera på att söka bostad, utan även rusta den nyanlände i att kunna få och behålla en bostad samt förebygga framtida vräkningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3",
      "sentiment": 0.5,
      "quote": "Därigenom knyts det uppföljande uppdraget av etableringsboende på ett tydligare sätt till länsstyrelsens uppdrag i samma förordning om att föra dialog om kommunernas planering för att ta emot och ordna en bostad.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a18.7.3",
      "sentiment": -1.0,
      "quote": "Länsstyrelsernas uppdrag om beredskap och kapacitet kvarstår och integrationsuppdraget har ändrats med nya och komplicerade uppdrag utan finansiering.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5.2",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen finner flera av utredningens förslag som positiva utifrån ett barnperspektiv",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2.2",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen finner flera av utredningens förslag som positiva utifrån ett barnperspektiv",
      "quote_type": "grund"
