  "segments": [
    {
      "forarbete_id": "a8.1",
      "sentiment": -0.2,
      "quote": "Mot den bakgrunden menar DO att det är viktigt att upprätta ett system som skyddar individer från diskriminerande preferenser vid anvisning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5.2",
      "sentiment": 1.0,
      "quote": "DO välkomnar utredningens förslag att ge förtur till familjer med barn i anvisningsförfarandet med hänvisning till att barn är särskilt skyddsvärda.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.1",
      "sentiment": 0.5,
      "quote": "Det skapar förutsägbarhet och ökar chanserna till etablering i samhället och för den enskilda att bättre kunna tillgodogöra sig sina rättigheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.3",
      "sentiment": -1.0,
      "quote": "En sådan hantering skulle minska risken för hemlöshet, trångboddhet och öka möjligheterna till etablering samt ge bättre förutsättningar för nyanländas lika möjligheter och rättigheter i hela samhället, inte minst bidra till trygghet för den enskilda, öka förutsättningarna för egenförsörjning och deltagande i samhällslivet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.4",
      "sentiment": 1.0,
      "quote": "Det möjliggör bland annat att kvinnor som utsätts för våld eller kontroll av sin partner får förbättrade möjligheter att lämna sin relation vilket utgör en viktig del för att våldsutsatta kvinnor ska kunna tillgodogöra sig sina rättigheter och möjligheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.5",
      "sentiment": -1.0,
      "quote": "Om det finns kommuner som vill och kan erbjuda mer långsiktiga boendelösningar ser inte DO behovet av att begränsa tiden eller undanröja möjligheterna för kommuner att erbjuda långsiktiga lösningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.6",
      "sentiment": -1.0,
      "quote": "Att villkora bostaden är oacceptabelt eftersom det riskerar att urholka en fundamental rättighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.1",
      "sentiment": 1.0,
      "quote": "DO välkomnar och anser att det är av största vikt att kommunerna ska erbjuda stöd i sökandet efter en mer permanent bostadslösning när treårsfristen gått ut, oavsett hur tidsfristen i modellen för etableringsboendet villkoras eller utformas.",
      "quote_type": "grund"
    }
  ]
