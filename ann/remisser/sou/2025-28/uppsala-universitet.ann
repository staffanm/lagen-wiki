  "segments": [
    {
      "forarbete_id": "a1",
      "sentiment": 1.0,
      "quote": "Jämställdhetsmyndigheten är en lämplig instans för denna typ av koordinering, som Uppsala universitet bedömer har goda förutsättningar att förbättra institutionalisering, likvärdighet, effektivitet och långsiktighet i arbetet mot våld.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5",
      "sentiment": 0.2,
      "quote": "Tillräckliga och ändamålsenliga resurser måste tillföras för att kommuner och regioner ska ha kapacitet att ta emot och implementera det stöd som tas fram nationellt, samt bedriva ett kunskapsbaserat arbete.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": 0.2,
      "quote": "Långsiktig och ändamålsenlig finansiering för NCK:s verksamhet kan säkerställas genom höjda anslag till Uppsala universitet med särskild hänvisning till NCK:s verksamhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.1",
      "sentiment": 0.5,
      "quote": "Uppsala universitet välkomnar hänvisningar till en s.k. ”kunskapskedja”, men saknar konkreta förslag på hur forskning och evidens ska inhämtas och komma till användning för strategins genomförande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": 1.0,
      "quote": "Uppsala universitet ser positivt på förslaget om en grundstruktur där centrala myndigheter får instruktionsenliga uppgifter som knyter an till Jämställdhetsmyndighetens samordningsroll.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4",
      "sentiment": 1.0,
      "quote": "Det är därför bra att Socialstyrelsen som redan har ett samlat ansvar för dessa professioner får förtydligat uppdrag om samordning av kunskapsutveckling.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.1",
      "sentiment": 1.0,
      "quote": "Uppsala universitet instämmer i bedömningen att en enad strategi bidrar till helhetssyn i styrningen på området liksom i det strategiska och praktiska arbetet mot våld.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.1",
      "sentiment": 1.0,
      "quote": "Uppsala universitet välkomnar strategins tre utgångspunkter med särskild vikt på ett kunskapsbaserat arbete som förutsättning för samtliga områden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.1",
      "sentiment": 0.5,
      "quote": "Uppsala universitet ser behov av en höjd ambitionsnivå för att bättre svara upp mot GREVIO:s rekommendation om att vidta åtgärder för specialiserad verksamhet för personer utsatta för sexuellt våld, enligt artikel 25 i Istanbulkonventionen.",
