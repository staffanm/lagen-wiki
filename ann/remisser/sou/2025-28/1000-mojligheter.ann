  "overall": {
    "sentiment": 0.5,
    "quote": "Att gå från tidsbegränsade, tillfälliga uppdrag till ett hållbart, långsiktigt arbete genom stärkta grunduppdrag och ett tydligt utpekat ansvar för ett antal centrala myndigheter är avgörande för att ta viktiga steg framåt på området.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "sec8",
      "sentiment": 1.0,
      "quote": "En styrning på så vis som tidigare skett, genom framför allt tidsbegränsade uppdrag, har inte gagnat arbetet på området och inte heller, precis som betänkandet konstaterar, tillfört den långsiktighet och stabilitet som krävs.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec9",
      "sentiment": 1.0,
      "quote": "Behovet av att det offentliga på ett bättre vis tar vara på kunskapen från, och samverkar med, civilsamhället är stort.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4",
      "sentiment": 0.5,
      "quote": "Civilsamhället, och särskilt kvinnojoursrörelsen, står för en stor del av både expertis och erfarenhet av just insatser, metoder och arbetsformer när det gäller att identifiera, bedöma och ge stöd och behandling till våldsutsatta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.6.4",
      "sentiment": 0.5,
      "quote": "Under lång tid har digitala sexköp och pornografi varit områden för människohandel för sexuella ändamål som inte adresserats och följts upp tillräckligt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.1",
      "sentiment": 1.0,
      "quote": "Att både killars våld mot tjejer, våld i ungas relationer samt sexuell exploatering av barn och unga särskilt uppmärksammas på olika vis under de strategiska områdena är mycket viktigt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.5.1",
      "sentiment": -0.5,
      "quote": "Att gå mot en större könsneutralisering riskerar att underminera både rättstryggheten för våldsutsatta kvinnor och flickor och effektiviteten i våldsförebyggande insatser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.2.1",
      "sentiment": 0.2,
      "quote": "vår erfarenhet pekar också på att unga aktivt efterfrågar ett specifikt arbete kring hur man kan ha schyssta, fungerande och våldsfria relationer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.2.2",
      "sentiment": 1.0,
      "quote": "Precis som betänkandet konstaterar så ser vi mycket tydligt att civilsamhället har en unik roll att upptäcka våldsutsatthet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.2.3",
      "sentiment": 0.5,
      "quote": "en stor del av ett framgångsrikt arbete på det här området är avhängigt att civilsamhället får de resurser, mandat och förutsättningar som krävs för att kunna bedriva sitt arbete eftersom det till stor del är verksamheter inom civilsamhället som tillser stöd och skydd för våldsutsatta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.2.4",
      "sentiment": 0.5,
      "quote": "Rättsväsendet behöver alltså växla upp sitt arbete avsevärt och för detta krävs tydliga skrivningar och instruktioner så att det mycket välbehövliga utvecklingsarbete som behöver genomföras faktiskt sker.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.2.5",
      "sentiment": 1.0,
      "quote": "ett angeläget utvecklingsområde är insatser till unga våldsutövare – en målgrupp som stiftelsen, som en av få aktörer, arbetat med under flera år.",
