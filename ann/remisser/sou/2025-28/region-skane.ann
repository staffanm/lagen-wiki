  "segments": [
    {
      "forarbete_id": "sec8",
      "sentiment": 0.5,
      "quote": "Region Skåne menar att det är strategiskt viktigt att inkludera våld i nära relationer i bekämpning av allvarlig kriminalitet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec9",
      "sentiment": 1.0,
      "quote": "Graden av samordning bör öka och skulle om så sker bland annat ge bättre förutsättningar att genomföra den nationella jämställdhetspolitiska strategin mot våld, förtryck och utnyttjande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec10",
      "sentiment": 0.5,
      "quote": "Förslaget ger en grundstruktur som möjliggör ett gemensamt, mer strategiskt och långsiktigt jämställdhetspolitiskt arbete.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec11",
      "sentiment": 1.0,
      "quote": "En utvidgning av kunskapsområdet med inkludering av våldsutövare är angelägen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec12",
      "sentiment": 1.0,
      "quote": "En förändring av Länsstyrelsens roll för att ytterligare förstärka samverkan inom länet är positiv.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec13",
      "sentiment": 0.2,
      "quote": "Region Skåne menar att utvecklingsarbetet mot våld i nära relationer, förutom utredningens förslag till uppdrag till Socialstyrelsen, skulle kunna stärkas om kunskapsområdet blev en del av den nationella kunskapsstyrningsmodellen på så sätt att ett nationellt programområde Våld i nära relationer skapades.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec14",
      "sentiment": 0.5,
      "quote": "Region Skåne stödjer förslaget att arbetet mot hedersrelaterat våld och förtryck inkluderas och ges utrymme i den nationella strategin men där det bör understrykas att det inte får innebära att arbetet mot hedersrelaterat våld och förtyck nedprioriteras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec15",
      "sentiment": 1.0,
      "quote": "Region Skåne stödjer förslaget om en nationell jämställdhetspolitisk strategi mot våld, förtryck och utnyttjande.",
