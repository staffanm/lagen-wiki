    },
    {
      "forarbete_id": "sec16",
      "sentiment": 1.0,
      "quote": "Region Skåne stödjer förslag om en strategi som gäller i tio år och har de föreslagna utgångspunkterna.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec17",
      "sentiment": 1.0,
      "quote": "Förebyggande arbete som gäller barn och unga och som sker i samverkan mellan olika myndigheter och på olika områden i samhället är av stor betydelse för utvecklingen inom området och för att minska förekomsten av våld i nära relationer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec18",
      "sentiment": -0.2,
      "quote": "Befogenheterna för professionella ser enligt lagen olika ut vad gäller möjligheten att uppmärksamma det ofödda barnets utsatthet.",
