  "overall": {
    "sentiment": 1.0,
    "quote": "Region Stockholm ser positivt på utredningens förslag om förstärkt samverkan hos centrala myndigheter för ett effektivt och långsiktigt arbete med att bekämpa mäns våld mot kvinnor, våld i nära relationer, hedersrelaterat våld och förtryck samt utnyttjande i prostitution och människohandel.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a8.1",
      "sentiment": 1.0,
      "quote": "Region Stockholm ser att det samordningscentrum, placerat hos Jämställdhetsmyndigheten, som föreslås för att hålla ihop arbetet har goda möjligheter att skapa effektiva strukturer för myndigheter och andra aktörer till ett samlat långsiktigt arbete mot våld.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5",
      "sentiment": 1.0,
      "quote": "En ökad långsiktighet i det regionala arbetet mot våld, genom samverkan och behovsanpassat stöd till kommuner, regioner samt andra lokala och regionala aktörer, gynnar alla invånare, oavsett diskrimineringsgrund eller socioekonomisk status.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.1",
      "sentiment": 1.0,
      "quote": "Ett sammanhållet helhetsperspektiv där myndigheter och andra organisationer samverkar utifrån respektive styrkeområde, har samsyn och arbetar långsiktigt mot målet är positiv och minskar risken för att olika områden hamnar i separata stuprör i stället för i en gemensam kontext.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.1.5",
      "sentiment": 1.0,
      "quote": "Ett separat mål riskerar att motverka samverkansambitionen och att synergier med koppling till övriga jämställdhetsmål förloras då även hedersvåld sker i en kontext och inte som isolerade händelser.",
      "quote_type": "grund"
    }
  ]
