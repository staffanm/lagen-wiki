  "segments": [
    {
      "forarbete_id": "a2",
      "sentiment": 0.2,
      "quote": "Vi ser positivt på att utredningen arbetat med bred dialog, men vill understryka behovet av att nationella minoriteters organisationer involveras systematiskt både i fortsatt utvecklingsarbete och i implementeringsfasen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.1",
      "sentiment": 0.5,
      "quote": "Det är dock avgörande att det i styrningen tydliggörs hur erfarenheter och kunskap från minoriteter, såsom romska kvinnor och flickor, ska tas tillvara, både genom representation och riktade konsultationer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.1",
      "sentiment": -0.5,
      "quote": "Vår ser att denna typ av våld har särskilda normstrukturer, kollektiv dynamik och långtgående konsekvenser för flickors och kvinnors rättigheter som kräver en egen strategi och handlingsplan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11",
      "sentiment": 0.5,
      "quote": "Vi instämmer i att arbetet ska vara rättighetsbaserat och kunskapsbaserat, men vill understryka vikten av att erfarenhetsbaserad kunskap, särskilt från civilsamhälle och minoritetsorganisationer, ges utrymme.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12",
      "sentiment": 0.5,
      "quote": "Vi stödjer en långsiktig och samordnad strategi mot våld, men det är viktigt att strategin säkerställer likvärdig tillgång till stöd och skydd oavsett etnicitet, kön, ålder eller bostadsort.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14",
      "sentiment": 0.5,
      "quote": "Vi ser positivt på utveckling av indikatorer och uppföljning, men rekommenderar att dessa även speglar minoritetsstatus och barns rätt till skydd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.3",
      "sentiment": 0.5,
      "quote": "Det är avgörande att civilsamhällets organisationer, inklusive nationella minoriteters egna, ges långsiktiga förutsättningar och finansiering för att bidra till både förebyggande insatser, utbildning och stöd.",
      "quote_type": "grund"
