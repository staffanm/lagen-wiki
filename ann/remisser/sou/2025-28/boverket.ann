  "segments": [
    {
      "forarbete_id": "sec8",
      "sentiment": 1.0,
      "quote": "Den förstärkta styrningen och uppföljningen kommer enligt utredningen att förbättra förutsättningarna för det jämställdhetspolitiska arbetet mot våld, en bedömning Boverket instämmer i.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec9",
      "sentiment": 1.0,
      "quote": "En sådan åtgärd, tillsammans med en stärkt styrning av centrala myndigheter, kan tydliggöra varifrån kommunerna kan hämta råd och stöd för att uppfylla sitt ansvar, exempelvis för frågor inom ramen för bostadsförsörjningen för personer som utsatts för våld eller hot.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5",
      "sentiment": 1.0,
      "quote": "Med detta tillägg tydliggörs vikten av likvärdig kunskaps- och informationsspridning till kommunerna baserad på nationella myndigheters underlag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.4",
      "sentiment": 1.0,
      "quote": "Idag finns liknande indikatorer om oro huvudsakligen kopplade till allmän plats, som det egna bostadsområdet, men inte den egna bostaden eller om någon känner oro för en specifik person.",
      "quote_type": "grund"
