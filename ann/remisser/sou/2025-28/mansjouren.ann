  "overall": {
    "sentiment": 0.2,
    "quote": "Samtidigt ser vi viktiga brister i betänkandet, främst i bristen på könsneutralitet, föreställningar om manlighet, samt avsaknaden av stödstrukturer för våldsutsatta män.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "sec307",
      "sentiment": 0.5,
      "quote": "I dag saknar många män tillgång till anpassade skyddsinsatser och bemötande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec308",
      "sentiment": 0.5,
      "quote": "efterlyser att även civilsamhällets aktörer som stödjer män, inkluderas i myndighetsgemensamma forum och som kunskapsbärare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec309",
      "sentiment": 0.2,
      "quote": "Det finns idag stora kunskapsluckor kring män som oﬀer i hetero- och samkönade relationer samt i hederskontext.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec311",
      "sentiment": 0.5,
      "quote": "det är också viktigt att inte kollektivt skuldbelägga män.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec324",
      "sentiment": 0.5,
      "quote": "Många män berättar inte om sin utsatthet p.g.a. skam och förväntningar på att vara starka.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec334",
      "sentiment": -0.5,
      "quote": "Stödet till våldsutsatta är i dag ojämnt fördelat – både geografiskt och könsmässigt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec346",
      "sentiment": 0.2,
      "quote": "manliga brottsoﬀer ofta bemöts med skepsis.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec357",
      "sentiment": 0.5,
      "quote": "ser att dessa måste bygga på frivillighet, helhetsperspektiv och inte vara stigmatiserande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.1",
      "sentiment": -0.2,
      "quote": "Strategin bör tydligare betona civilsamhällets mångfald.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14",
      "sentiment": 0.2,
      "quote": "Indikatorerna som föreslås bör inkludera uppdelning på kön, könsidentitet och relationsform.",
