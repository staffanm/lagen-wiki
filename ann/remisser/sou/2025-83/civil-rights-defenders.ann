  "segments": [
    {
      "forarbete_id": "a6.4.1",
      "sentiment": 1.0,
      "quote": "Civil Rights Defenders instämmer i den slutsatsen, men vill betona att skälet inte primärt är att det skulle saknas behov av ett nationellt tiggeriförbud, utan att ett nationellt tiggeriförbud står i strid med de mänskliga rättigheterna och diskrimineringsförbud som följer av Sveriges internationella åtaganden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.2",
      "sentiment": -1.0,
      "quote": "Enligt Civil Rights Defenders mening är förslaget så generellt till sin utformning att det inte uppfyller Europakonventionens krav på vare sig nödvändighet eller proportionalitet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec178",
      "sentiment": -1.0,
      "quote": "Av samma skäl som anförts ovan, nämligen att tiggeriförbud i sig, oavsett om det regleras i ordningslagen eller brottsbalken, innebär oproportionerliga inskränkningar i mänskliga rättigheter och risker för diskriminering avstyrker Civil Rights Defenders dock även det förslag som presenteras i det särskilda yttrandet.",
      "quote_type": "grund"
    }
  ]
