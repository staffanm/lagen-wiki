  "segments": [
    {
      "forarbete_id": "sec417",
      "sentiment": 0.5,
      "quote": "Förslaget stärker barnrättsperspektivet och skapar bättre förutsättningar att låta barnets behov av trygghet, skydd och stabilitet vara vägledande vid bedömningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec17",
      "sentiment": -1.0,
      "quote": "Det finns därför en risk att beslut fattas på ett otillräckligt beslutsunderlag, vilket riskerar att skada tilliten till både socialtjänsten och rättsväsendet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec357",
      "sentiment": -1.0,
      "quote": "Göteborgs Stad bedömer att det finns en risk för att frekventa domstolsprövningar kan komma att påverka kontinuiteten och tryggheten i vården negativt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec165",
      "sentiment": 0.5,
      "quote": "Detta gäller framför allt kostnader för att anlita sakkunniga, inhämtande av kompletterande medicinska eller psykologiska bedömningar samt den ökade administration och handläggning som följer av ett större inslag av extern expertkunskap i LVU-processen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec367",
      "sentiment": 0.2,
      "quote": "Om familjehemssekreteraren även ska hantera kontakten med vårdnadshavare riskerar det att skapa otydlighet i roller och ansvarsfördelning, som i förlängningen kan leda till försämrad kvalitet i stödet till familjehemmet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec504",
      "sentiment": 1.0,
      "quote": "Därutöver bedömer Göteborgs Stad att dessa förslag är positiva",
      "quote_type": "standpunkt"
