  "segments": [
    {
      "forarbete_id": "sec7",
      "sentiment": 1.0,
      "quote": "instämmer i att rättssäkerheten för den enskilde ökar som en följd av att beslutsunderlagen är gedigna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec8",
      "sentiment": 1.0,
      "quote": "Vad avser förslagen om hur sakkunskapen ska tillförsäkras inom ramen för domstolsprocessen anser socialnämnden i Danderyd att dom är relevanta och ställer sig därmed bakom även dessa utan att närmare bedöma förslagen.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec13",
      "sentiment": -0.5,
      "quote": "Socialnämnden bedömer att tillämpningen av denna bestämmelse kommer vara ytterst begränsad och att möjligheten snarare förvirrar än skapar nytta i praktiken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec238",
      "sentiment": -1.0,
      "quote": "det föreligger en risk att förslaget urholkar den enskildes rättigheter genom att tillåta en sådan uttrycklig möjlighet i lagtexten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec260",
      "sentiment": -0.2,
      "quote": "Det är dock inte helt okomplicerat att föreslå en sådan skrivning då det kan leda till svårigheter att tillämpa bestämmelsen i praktiken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec326",
      "sentiment": 1.0,
      "quote": "Socialnämnden instämmer med att förutsättningarna för vårdens upphörande bättre ska spela förutsättningarna för ett omhändertagande för en enhetlig och konsekvent tillämpning och ställer sig därmed bakom den föreslagna ordningen för vårdens upphörande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec327",
      "sentiment": 1.0,
      "quote": "en sådan detaljerad reglering skulle frånta socialnämnden att göra en bedömning utifrån omständigheterna i det enskilda fallet och ställer sig bakom att definitionen fortsatt lämnas oreglerad.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec333",
      "sentiment": 1.0,
      "quote": "bedöms det finnas ett behov av ett förtydligande utifrån den delvis felaktiga praktiska tillämpningen av bestämmelsen för vårdens upphörande enligt 3 § LVU.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec335",
      "sentiment": 1.0,
      "quote": "förslaget innebär en tydlig ställning för den enskildes rättigheter samt ett i praktiken mycket tydligare och mer rättssäker tillämpning av tvångslagstiftningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec343",
      "sentiment": 1.0,
      "quote": "Socialnämnden i Danderyd ställer sig även helt bakom förslaget att det i socialtjänstförordningen ska förtydligas att det i vårdplanen ska framgå vilka förändringar som behövs för att barnet ska kunna återvända hem och vilket stöd en socialnämnd kan erbjuda vårdnadshavarna för att det ska vara möjligt.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec345",
      "sentiment": 1.0,
      "quote": "Socialnämnden ser även värdet i förslaget att en socialsekreterare som ansvarar för kontakterna med en vårdnadshavare när ett barn är placerat utanför hemmet ska utses.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec392",
      "sentiment": 1.0,
      "quote": "Socialnämnden i Danderyd ställer sig som helhet bakom förslagen om stärkt skydd och rättssäkerhet vid umgänge och vårdens upphörande.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec477",
      "sentiment": 1.0,
      "quote": "delar utredningens uppfattning om att drogtester som ett obligatoriskt utredningsmedel är inte förenligt med proportionalitetsprincipen och står i strid med 2 kap. 6 § regeringsformen och artikel 8 i Europakonventionen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec538",
      "sentiment": 1.0,
      "quote": "Socialnämnden ställer sig bakom utredningens resonemang om uppföljning av ett bars situation och instämmer i samtliga förslag i denna del.",
      "quote_type": "standpunkt"
    }
  ]
