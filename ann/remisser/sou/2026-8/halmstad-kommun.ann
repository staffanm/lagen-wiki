    },
    {
      "forarbete_id": "sec18",
      "sentiment": 1.0,
      "quote": "Det nya lagförslaget underlättar att barn inte under långa perioder befinner sig inom vård som inte ger resultat.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec21",
      "sentiment": 1.0,
      "quote": "Detta skapar tydlighet för alla, både barn och föräldrar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec30",
      "sentiment": 1.0,
      "quote": "Drogtester är främst användbara som ett komplement i medicinsk vård eller som en del av en rehabiliteringsprocess, men de bör inte ses som en universallösning för att bedöma någons skötsamhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec32",
      "sentiment": 1.0,
      "quote": "Det är bra med ett förtydligande om ansvar för kostnader och utförande av provtagning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec42",
      "sentiment": 1.0,
      "quote": "Förtydligandet kan minska social dumpning, kanske även eliminera det.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec570",
      "sentiment": 1.0,
      "quote": "Det är bra att det som är praxis blir ett ska-krav.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec13",
      "sentiment": -1.0,
      "quote": "det i huvudsak finns fungerade regelverk och organisation som möjliggör att ett barn eller en ung person omhändertag enligt LVU samt att det finns en risk för att barn och unga omhändertas på felaktiga grunder och att tilliten till socialtjänsten och lagstiftningen skadas.",
