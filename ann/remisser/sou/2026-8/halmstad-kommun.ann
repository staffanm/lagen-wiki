  "segments": [
    {
      "forarbete_id": "sec7",
      "sentiment": 1.0,
      "quote": "De berörda barnen kommer genom detta att servas med en snabbare handläggningstid.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec14",
      "sentiment": 1.0,
      "quote": "Det stärker skyddet att den unge får den vård den behöver.",
