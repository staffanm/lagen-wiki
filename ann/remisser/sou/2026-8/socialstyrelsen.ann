  "overall": {
    "sentiment": 0.5,
    "quote": "Förslagen i utredningen stärker barn och ungas rättigheter och trygghet samt har principen om barnets bästa i fokus.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a3.7.4",
      "sentiment": 0.5,
      "quote": "I ett uppstartsskede skulle myndigheten dock behöva utreda vidare hur verksamheten kan organiseras och bedrivas på bästa sätt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec221",
      "sentiment": -1.0,
      "quote": "Myndigheten menar att det finns ett fungerande regelverk och organisation för omedelbara omhändertaganden enligt LVU 6 §.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec326",
      "sentiment": 0.2,
      "quote": "förslaget om att LVU vården upphör om beslutet inte underställts förvaltningsrätten inom föreskriven tid kan försätta barnet eller den unge i en riskfylld situation om barnet eller den unge förlorar det skydd som vård enligt LVU ger.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.3",
      "sentiment": 0.2,
      "quote": "Dock menar myndigheten att förslaget behöver beredas ytterligare, i samråd med myndigheten, när det gäller upplägg, organisation, tidsåtgång, vad som är möjligt att göra, med mera.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec348",
      "sentiment": 0.0,
      "quote": "Socialstyrelsen förordar att ett tilläggsuppdrag om att utreda detta ges till uppdraget att förbereda införandet av en ny lag om socialdataregister.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec443",
      "sentiment": 0.2,
      "quote": "men vill samtidigt uppmärksamma att de kan komma att medföra en betydande resursåtgång för socialtjänsten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec477",
      "sentiment": 1.0,
      "quote": "Myndigheten anser, likt den majoritet av yrkesverksamma som utredningen inhämtat synpunkter från, att drogtester inte bör vara ett obligatoriskt utredningsmedel.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec538",
      "sentiment": -1.0,
      "quote": "Myndigheten menar att nuvarande uppföljningstid är tillräcklig särskilt med tanke på att det ställs höga krav på att LVU vård ska upphöra.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec541",
      "sentiment": 0.5,
      "quote": "Det kan därför finnas skäl att överväga om undantaget bör begränsas till en vårdnadsöverflyttning enligt just 6 kap. 8 § föräldrabalken, eller om undantaget även bör kunna tillämpas vid vårdnadsöverflyttning enligt andra bestämmelser.",
      "quote_type": "grund"
    }
  ]
}