    },
    {
      "forarbete_id": "a4.9.2",
      "sentiment": -1.0,
      "quote": "Detta främst eftersom det inte finns något tydligt behov av att kunna fatta sådana interimistiska beslut.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.2",
      "sentiment": -0.5,
      "quote": "En konsekvens av det andra steget i den föreslagna trestegsbedömningen kan bli att vården i vissa fall upphör trots att det fortfarande finns ett skyddseller vårdbehov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec331",
      "sentiment": -1.0,
      "quote": "Sammantaget anser kammarrätten att nackdelarna överväger de eventuella fördelarna med förslaget.",
