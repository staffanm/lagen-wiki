    {
      "forarbete_id": "a3.7.3",
      "sentiment": 0.8,
      "quote": "Förslaget möjliggör ett mer fullgott beslutsunderlag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.7.4",
      "sentiment": -0.2,
      "quote": "Detta mot bakgrund av att det redan idag finns lagstöd för sådana åtgärder och att utredningen inte i tillräcklig grad har analyserat konsekvenserna av de föreslagna ändringarna.",
