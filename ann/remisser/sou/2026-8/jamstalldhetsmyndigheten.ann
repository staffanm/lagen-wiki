  "overall": {
    "sentiment": 0.5,
    "quote": "Jämställdhetsmyndigheten tillstyrker majoriteten av utredningens förslag, men anser att flera av dem tydligare behöver utformas utifrån ett jämställdhetsperspektiv.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "sec153",
      "sentiment": 0.5,
      "quote": "Det är samtidigt viktigt att satsa på kunskapshöjande insatser till socialtjänsten om våld mot barn, hedersrelaterat våld och förtryck, sexuell exploatering och människohandel samt mäns våld mot kvinnor och våld i nära relationer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec161",
      "sentiment": 0.5,
      "quote": "I avsaknad av en sådan ordning bedömer vi att utredningens förslag om att tydliggöra domstolarnas möjlighet att inhämta sakkunnigutlåtanden kan bidra till mer välgrundade bedömningar med utgångspunkt i barnet och den ungas bästa.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec170",
      "sentiment": 0.5,
      "quote": "En förutsättning är dock att Socialstyrelsen har tillräcklig kompetens för att förordna sakkunniga och säkerställa att sakkunniga har relevant kompetens grundad i beprövad kunskap och erfarenhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec219",
      "sentiment": 1.0,
      "quote": "Som utredningen understryker finns det flera risker med ett sådant förfarande, inte minst vad gäller risken att LVU kan komma att tolkas som strafflagstiftning snarare än skyddslagstiftning och att det skulle kräva kompetens som åklagare inte besitter idag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec238",
      "sentiment": 0.5,
      "quote": "Däremot anser vi att en sådan möjlighet även bör gälla vid beslut om tillfälligt utreseförbud.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec260",
      "sentiment": 1.0,
      "quote": "En förlängd tidsfrist ökar möjligheten för svenska myndigheter att både agera för att återföra bortförda barn och att snabbt ge barn rätt mottagande och vård när de åter är i Sverige.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec324",
      "sentiment": 0.5,
      "quote": "Därför är det viktigt att det i författningskommentarerna förtydligas att prövningens tredje steg, om vård kan ges med samtycke, inte alltid tillgodoser behovet av skydd för exempelvis hedersvåldsutsatta barn även om samtycke från vårdnadshavare finns.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec326",
      "sentiment": 0.2,
      "quote": "Utan sådan kunskap finns en risk att traumarelaterade uttryck misstolkas som ett kvarstående socialt nedbrytande beteende, vilket kan leda till att tvångsvård upprätthålls längre än nödvändigt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec333",
      "sentiment": -0.2,
      "quote": "Vidare anser vi att utredningens bedömning om risken att ett omhändertagande kan upphöra om beslutet inte har underställts förvaltningsrätten i tid är bristfällig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec335",
      "sentiment": 0.5,
      "quote": "För att detta ska stärka barns rättigheter i praktiken krävs att det offentliga biträdet är särskilt lämplig utifrån kunskap om våld mot barn, hedersrelaterat våld och förtryck, sexuell exploatering och människohandel samt mäns våld mot kvinnor och våld i nära relationer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec341",
      "sentiment": 0.5,
      "quote": "Återföreningsprincipen får inte gå före barnets rätt till skydd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec348",
      "sentiment": 0.5,
      "quote": "Jämställdhetsmyndigheten tillstyrker förslaget och föreslår att Socialstyrelsen även får i uppdrag att utveckla en metodik för att redogöra på vilken grund vården ges",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec392",
      "sentiment": -0.2,
      "quote": "Vidare anser vi att kravet på nödvändighet för umgängesbegränsning är ett för högt ställt krav, då barn inte ska tvingas till umgänge med en våldsutövande förälder.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec400",
      "sentiment": 1.0,
      "quote": "Det är av största vikt att det finns fullgoda underlag till de riskbedömningar och bedömningar av barnets bästa som socialtjänsten genomför för att följa vården.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec443",
      "sentiment": 1.0,
      "quote": "Det är av vikt att värna om placerade barns relationer till syskon och andra för barnet viktiga närstående, vilket behöver förtydligas i lagstiftningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec446",
      "sentiment": -1.0,
      "quote": "Upprepande överklaganden om umgängesbegränsningar från syskon och släktingar kan innebära påtryckningar på barnet och få negativa konsekvenser för barnets skydd, stöd och behandling.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec538",
      "sentiment": 1.0,
      "quote": "En längre uppföljningstid ökar möjligheten att upptäcka eventuella brister i barnets livssituation efter återförening eller annan placering.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec541",
      "sentiment": 1.0,
      "quote": "En vårdnadsöverflytt innebär i regel en stabil och långsiktig lösning för barnet, där ansvaret tydligt övergår till vårdnadshavaren.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec545",
      "sentiment": 0.5,
      "quote": "Det är dock viktigt att det klargörs hur denna uppföljning ska avgränsas i förhållande till andra insatser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec555",
      "sentiment": 1.0,
      "quote": "En sådan skyldighet riskerar att förskjuta uppföljningens karaktär från stödjande till kontrollerande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec558",
      "sentiment": 1.0,
      "quote": "En tydlig ansvarsfördelning är avgörande för att undvika att barn faller mellan olika huvudmän.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec570",
      "sentiment": 1.0,
      "quote": "Det kan bidra till att syskon och andra barn i samma hem som det barn anmälan gäller kan uppmärksammas och skyddas i tid.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec576",
      "sentiment": 1.0,
      "quote": "Jämställdhetsmyndigheten instämmer i utredningens bedömning om att det behövs en ökad tydlighet och rättssäkerhet vid beslut om placering på särskilda ungdomshem och att detta behöver utredas närmare, särskilt utifrån flickors och pojkars särskilda förutsättningar och behov.",
      "quote_type": "grund"
