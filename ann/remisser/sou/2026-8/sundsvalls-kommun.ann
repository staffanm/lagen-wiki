  "overall": {
    "sentiment": 0.2,
    "quote": "Samtidigt vill vi också vara tydliga med att vi ser och uppskattar att flertalet förslag sannolikt kommer att leda till en ökad rättssäkerhet för barn, unga och deras familjer.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a3",
      "sentiment": 1.0,
      "quote": "Vi är positiva till att tillgången på sakkunskap förbättras, både för socialsekreterare inom socialtjänsten och för domstolarna i ärenden där expertbedömningar behöver göras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.9.2",
      "sentiment": 1.0,
      "quote": "Förslaget om utökade befogenheter för åklagare riskerar leda till bristande kvalitet i bedömningsunderlaget eftersom åklagare saknar kunskap och utbildning som en socionom har i dessa situationer, åklagaren saknar dessutom tillgång till socialnämndens bakgrundskunskap i ärenden och har inte heller möjlighet att inhämta uppgifter från socialtjänstens journaler som kan behövas vid bedömning av vårdbehov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5",
      "sentiment": 0.5,
      "quote": "Man kanske bör överväga att införa någon form av ytterligare bedömning i ärenden där vård inte kunnat verkställas inom en viss tid och ställa krav på verkställighetsprövning när ett beslut verkställs senare än inom t.ex sex månader.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": 0.2,
      "quote": "Men det finns samtidigt en uppenbar risk för ökad administrativ börda, både för socialtjänsten men framför allt för Förvaltningsrätterna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": 0.2,
      "quote": "Samtidigt finns det en påtaglig risk för att det blir väldigt många personer från socialtjänsten inblandade i varje ärende – en handläggare för vårdnadshavare, en för barnet och en för familjehemmet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7",
      "sentiment": 0.5,
      "quote": "Att syskon och andra närstående ska kunna överklaga beslut om begränsning av umgänge kommer sannolikt att medföra mer administration och kräva mer resurser av nämnden, men även för Förvaltningsrätterna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": 0.5,
      "quote": "Däremot uppfattar vi att beskrivningen av en förälders skyldighet att lämna drogtest blir motsägelsefull eftersom det saknas medel att genomdriva ett beslut från nämnden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8",
      "sentiment": -0.2,
      "quote": "Våra farhågor är att det kan bli otydligt vad som ska följas upp om insatsen ska pågå så länge som ett år.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2",
      "sentiment": 0.8,
      "quote": "Samtidigt uppfattas det som positivt att det görs ett förtydligande om denna skyldighet vilket säkerställer en mer likvärdig hantering av dessa ärenden över landet.",
      "quote_type": "grund"
    }
  ]
}