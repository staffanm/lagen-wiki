  "segments": [
    {
      "forarbete_id": "a3.7.3",
      "sentiment": 0.5,
      "quote": "Många barn som är aktuella för tvångsvård enligt LVU har en livssituation som är komplex och som påverkas av många olika faktorer – en enskild profession har därmed svårt att ha en fullständig kunskap om barnets hela livssituation.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.7.4",
      "sentiment": 0.5,
      "quote": "Barn som är föremål för tvångsvård har, som ovan nämnts, ofta en komplex och multisystemisk problembild.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.9.2",
      "sentiment": 1.0,
      "quote": "Rädda Barnen delar utredningens bedömning att genom att ge åklagare denna befogenhet riskerar det att leda till att beslut om omhändertagande fattas på felaktiga grunder.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec17",
      "sentiment": -1.0,
      "quote": "Rädda Barnen avstyrker detta, utifrån samma resonemang som utredningen själv för.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.4.2",
      "sentiment": 0.5,
      "quote": "Sammantaget är Rädda Barnen positiva till den förslagna ordningen, som innebär ökade krav på tydlighet och transparens.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.3",
      "sentiment": 0.5,
      "quote": "Rädda Barnen bedömer det som positivt att det ställs ökade krav hos socialnämnden på transparens och tydlighet gentemot vårdnadshavare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec469",
      "sentiment": 1.0,
      "quote": "Relationen med syskon och andra närstående är för många barn lika viktiga som föräldrar och vårdnadshavare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec417",
      "sentiment": 1.0,
      "quote": "Särskilt vid beslut om umgängesbegränsning så är det inte ovanligt att bedömning av barnets bästa helt saknas, något exempelvis även JO konstaterat .",
