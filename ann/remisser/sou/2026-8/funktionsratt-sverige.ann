  "segments": [
    {
      "forarbete_id": "sec150",
      "sentiment": 0.8,
      "quote": "Det finns stora behov av att tillföra kompletterande sakkunskap från andra professioner både tidigare i processen och i högre grad, det gäller både expertkunskap om olika funktionsnedsättningar/diagnoser och kunskap om det enskilda barnet eller den unge.",
      "quote_type": "grund"
