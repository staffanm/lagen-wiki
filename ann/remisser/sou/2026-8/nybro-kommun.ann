    {
      "forarbete_id": "sec14",
      "sentiment": -1.0,
      "quote": "Kommunen bedömer att akuta beslut om omedelbart omhändertagande kräver god kännedom om barnets situation, familjens förhållanden, tidigare dokumentation och möjliga skyddsplaneringar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec26",
      "sentiment": 0.5,
      "quote": "Kommunen bedömer att det är viktigt att barns behov av umgänge med föräldrar och vårdnadshavare tillgodoses så långt det är möjligt och förenligt med barnets bästa.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec32",
      "sentiment": 0.5,
      "quote": "Drogtester kan vara ett relevant underlag i vissa situationer, men resultatet behöver alltid bedömas tillsammans med övriga omständigheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec20",
      "sentiment": 0.5,
      "quote": "Kommunen bedömer att vårdnadshavare tidigt behöver få konkret, begriplig och löpande information om vilka förändringar som behöver ske, hur dessa förändringar ska uppnås och på vilket sätt utvecklingen kommer att följas upp inför bedömningen av vårdens upphörande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec37",
      "sentiment": -0.2,
      "quote": "Ett obligatoriskt krav riskerar att bli mindre träffsäkert och kan innebära att resurser binds upp även i ärenden där behovet av lång uppföljning inte är lika stort.",
      "quote_type": "grund"
