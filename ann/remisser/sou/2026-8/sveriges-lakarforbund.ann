  "segments": [
    {
      "forarbete_id": "a3.7.2",
      "sentiment": 0.5,
      "quote": "Sveriges läkarförbund vill dock tillägga att sakkunniga som förordnas av Socialstyrelsen även bör inbegripa skolläkare med adekvat specialistkompetens, förutsatt att barnet i fråga inte har en pågående nära läkarkontakt inom den specialiserade hälso-och sjukvården.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec156",
      "sentiment": 1.0,
      "quote": "Sveriges läkarförbund tillstyrker bedömningen",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec158",
      "sentiment": 0.5,
      "quote": "Detta är rimligt, under förutsättning att de frågeställningar som ska belysas är tydliga och genomtänkta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec160",
      "sentiment": -0.2,
      "quote": "Sveriges läkarförbund anser att det behöver tydliggöras om man i utredningens förslag avser ”intyg från läkare” eller ”utlåtande från läkare”, då dessa termer har olika innebörd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec174",
      "sentiment": 0.2,
      "quote": "Sveriges läkarförbund uppfattar att man snarare borde föreslå att legitimerade hälso- och sjukvårdskuratorer bör kunna förordnas som sakkunniga, då dessa har ett kompetensområde som på ett tydligare sätt kompletterar socialtjänstens.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec178",
      "sentiment": 0.5,
      "quote": "Vi vill därutöver betona behovet av utbildning i de situationer där olika regelverk överlappar, kolliderar eller lämnar utrymme för rättslig osäkerhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec223",
      "sentiment": 1.0,
      "quote": "Sveriges läkarförbund tillstyrker förslaget.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec17",
      "sentiment": -1.0,
      "quote": "En utvidgning av åklagares befogenheter riskerar att förskjuta fokus från barnets vård- och skyddsbehov till de processuella eller brottsutredande omständigheter som åklagaren normalt har att hantera.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec242",
      "sentiment": 1.0,
      "quote": "Sveriges läkarförbund tillstyrker förslaget.",
