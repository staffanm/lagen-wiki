  "segments": [
    {
      "forarbete_id": "sec165",
      "sentiment": -1.0,
      "quote": "det är redan enligt den allmänna bestämmelsen i förvaltningsprocesslagen möjligt för domstolarna att hämta in ett yttrande från en sakkunnig eller höra en sakkunnig vid muntlig förhandling.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec176",
      "sentiment": 1.0,
      "quote": "En sådan ordning skulle underlätta förfarandet med att anlita en sakkunnig vilket skulle kunna förbättra beslutsunderlaget i mer komplicerade ärenden och därmed även rättssäkerheten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec225",
      "sentiment": -1.0,
      "quote": "Det finns inte ett tydligt behov av en sådan ordning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec272",
      "sentiment": -0.5,
      "quote": "Det finns därför en risk att ett omhändertagande för vård verkställs utifrån omständigheter och förhållanden som inte är aktuella.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec338",
      "sentiment": 0.2,
      "quote": "Även om det enligt kammarrättens uppfattning är tydligt hur prövningen av när vården inte längre behövs ska göras är det ur rättssäkerhetssynpunkt positivt med en förtydligande reglering för vad som krävs för att ett omhändertagande för vård ska upphöra.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec357",
      "sentiment": -1.0,
      "quote": "Det riskerar dessutom att leda till parallella processer, exempelvis om en begäran om vårdens upphörande aktualiseras samtidigt som nämndens beslut ska underställas förvaltningsrätten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec469",
      "sentiment": 1.0,
      "quote": "Förslaget bidrar till att säkerställa att svensk lagstiftning uppfyller de åtaganden som följer av Europakonventionen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec499",
      "sentiment": 1.0,
      "quote": "Som utredningen redovisar är obligatoriska drogtester inte heller förenliga med regeringsformen och Europakonventionen.",
