  "overall": {
    "sentiment": 0.0,
    "quote": "Lunds kommun är positiv till flertalet av utredningens förslag vad gäller förändringar i lagstiftningen och förtydliganden av gällande rätt, b.la. vad gäller ökad sakkunskap i LVU-processen, förtydligade förutsättningar för att vården ska upphöra samt ökat skydd för syskon vid inkommen orosanmälan. Lunds kommun avstyrker också flera av utredningens förslag b.la. förslaget om att omprövningar alltid ska underställas förvaltningsrätten, att en särskild socialsekreterare ska utses till föräldrarna samt utformningen av bestämmelsen avseende beslut i frågan om att reglera umgänget.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a3.7.3",
      "sentiment": 0.5,
      "quote": "Sett i relation till beslutsprocessen inom kommunalförvaltning är tidsfristen ännu kortare än fyra veckor i praktiken, ibland så kort som ca två veckor beroende på dagen för det omedelbara omhändertagandet samt datum för myndighetsutskottets sammanträde.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.7.4",
      "sentiment": 0.2,
      "quote": "Lunds kommun vill att det tydliggörs om parternas inställning och önskemål om att hämta in uppgifter från en sakkunnig ska ingå i domstolens bedömning av om en sakkunnig behövs i processen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.9.2",
      "sentiment": -1.0,
      "quote": "Lunds kommun delar utredningens bedömning av de risker som är förenade med förslaget.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.2.6",
      "sentiment": 1.0,
      "quote": "Lunds kommun tillstyrker förslaget om att det framgår av lag att ett beslut om omedelbart omhändertagande ska underställas förvaltningsrätten utan oskäligt dröjsmål och senast inom en vecka.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a5.3.6",
      "sentiment": -0.5,
      "quote": "Lunds kommun anser dock att en tidsfrist på ett år skulle kunna innebära en ökad risk för att vårdnadshavare undanhåller sitt barn under en mycket lång tid.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.2",
      "sentiment": -0.2,
      "quote": "Det behöver därför förtydligas om LVU överhuvudtaget är tillämpligt för de fall behovet av vård enbart eller i huvudsak ska tillgodoses genom hälso- och sjukvården.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec331",
      "sentiment": -0.5,
      "quote": "Att samtliga beslut om omprövning ska underställas förvaltningsrätten innebär inte bara en ökad administrativ belastning för socialnämnden, utan också en belastning för barnet och föräldrarna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.3",
      "sentiment": -0.2,
      "quote": "Samtidigt ser Lunds kommun en svårighet i att på ett konkret sätt formulera de förbättringar som krävs utan att det för föräldrarna och barnet framstår som en checklista som ska bockas av.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2.7",
      "sentiment": 1.0,
      "quote": "Lunds kommun tillstyrker förslaget och instämmer i utredningens bedömningar.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.3.9",
      "sentiment": -0.5,
      "quote": "Dels innebär det en risk för ökad administration för socialnämnder och domstolar, dels kan det komma innebära ett stort integritetsintrång i det omhändertagna barnets och dennes vårdnadshavares situation.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": 0.5,
      "quote": "Drogtester är en färskvara och det behöver därför finnas en kontinuerlig tillgång till provtagning för föräldrar vars barn är placerade.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8",
      "sentiment": 1.0,
      "quote": "Lunds kommun tillstyrker utredningens förslag vad gäller uppföljning av ett barns situation och anser att förslagen är väl avvägda i samtliga delar.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a9.2",
      "sentiment": 1.0,
      "quote": "Lunds kommun tillstyrker utredningens förslag om att en omedelbar skyddsbedömning även ska göras i fråga om syskon eller andra barn i samma hem.",
