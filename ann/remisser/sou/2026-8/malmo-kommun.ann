    {
      "forarbete_id": "a4",
      "sentiment": 1.0,
      "quote": "Malmö stad instämmer i utredningens avrådan.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a5",
      "sentiment": -0.5,
      "quote": "Malmö stad bedömer att det inte är rimligt att barnet ska riskera att stå utan vård i en sådan situation.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6-2",
      "sentiment": -0.5,
      "quote": "Det finns en risk att vårdnadshavare motverkar att barnet knyter an till familjehemmet utifrån rädsla att en återförening inte blir möjlig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec357",
      "sentiment": -0.5,
      "quote": "Förslaget att beslutet om vård enligt § 3 ska underställas rätten var sjätte månad innebär, enligt Malmö stad, en risk att barn kommer att befinna sig i ständiga rättsprocesser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec477",
      "sentiment": -0.2,
      "quote": "Malmö stad bedömer att formuleringen andra närstående är ett brett begrepp vilket kan medföra svårigheter att definiera vilka som avses.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.3.4",
      "sentiment": -0.5,
      "quote": "Sådant material kan innehålla mycket integritetskänsliga uppgifter om barnet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec476",
      "sentiment": -0.5,
      "quote": "Vissa vårdnadshavare överklagar återkommande nämndens beslut och det finns en risk för ökad instabilitet i vården när fler personer i barnets nätverk får samma möjlighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8",
      "sentiment": -0.5,
      "quote": "I fråga om förslaget kring beslut om uppföljning efter oplanerade avslut av strukturerade öppenvårdsinsatser finns det en risk att barns situation inte följs upp i de situationer som lagstiftaren eftersträvar.",
      "quote_type": "grund"
