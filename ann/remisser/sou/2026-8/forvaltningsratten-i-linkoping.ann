    },
    {
      "forarbete_id": "sec223",
      "sentiment": 1.0,
      "quote": "Förvaltningsrätten instämmer i utredningens uppfattning att det inte har framkommit något behov av att åklagare ska kunna fatta beslut om omedelbara omhändertaganden",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec357",
      "sentiment": -1.0,
      "quote": "Rätten befarar vidare att en halvårsvis prövning av domstol av om vården ska fortsätta, kan skapa oro och inverka menligt på vården i och med att detta tar fokus från den vård som bedrivs.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec467",
      "sentiment": -0.5,
      "quote": "Utifrån skrivningarna på s. 320 och 444 skulle exempelvis nära vänner och andra personer utan släktskap som är viktiga för den unge kunna omfattas, vilket skulle medföra ett mycket långtgående ansvar för nämnden.",
      "quote_type": "grund"
