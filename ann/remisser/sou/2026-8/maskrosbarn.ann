  "segments": [
    {
      "forarbete_id": "a3.7.3",
      "sentiment": 0.8,
      "quote": "Maskrosbarn delar utredningens bedömning att det finns ett påtagligt behov av ett större inslag av sakkunskap i socialnämndens LVU-processer för att stärka barns möjligheter att få sina rättigheter tillgodosedda.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.7.4",
      "sentiment": 0.9,
      "quote": "Vi bedömer att utredningens förslag är ett viktigt steg för att öka rättssäkerheten och stärka barnrättsperspektivet i LVU-mål.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.9.2",
      "sentiment": -0.7,
      "quote": "Trots dessa snäva kriterier avstyrker vi förslaget då vi ser en risk för otydlighet och att unga kan komma att omhändertas på felaktiga grunder.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.2",
      "sentiment": 0.7,
      "quote": "Att prövningen delas upp i tre tydliga led ökar förutsebarheten och rättssäkerheten för barnet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec417",
      "sentiment": 0.8,
      "quote": "Det föreslagna perspektivskiftet är ett efterlängtat och nödvändigt steg för att säkerställa att umgänget anpassas efter barnets reella behov av trygghet och läkning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.3.9",
      "sentiment": 0.9,
      "quote": "Baserat på de erfarenheter och perspektiv som organisationens målgrupp förmedlar, bedömer vi det som mycket angeläget att utredningen väljer att definiera detta som en rätt till ett umgänge som barnet önskar ha, snarare än som en möjlighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": 0.6,
      "quote": "Att behålla behovs- och proportionalitetsbedömningen, men samtidigt införa en tydlig beslutsbörda för myndigheten, är ett stort framsteg.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2.4",
      "sentiment": 0.9,
      "quote": "Det föreslagna tillägget är därför av avgörande betydelse, inte bara för att säkerställa skydd för de kvarvarande syskonen, utan också för att sänka tröskeln för att barn ska våga berätta om sin hemsituation.",
      "quote_type": "grund"
    }
  ]
