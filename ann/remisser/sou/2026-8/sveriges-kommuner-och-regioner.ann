  "overall": {
    "sentiment": 0.0,
    "quote": "SKR anser att det är viktigt att stärka skyddet vid vårdens upphörande och tillstyrker därmed flera av utredningens förslag, som förbättrade möjligheter för socialnämnder att hämta in uppgifter, förlängd uppföljningstid efter avslutad LVU-vård och att uppföljning av ett barns situation ska kunna beslutas i fler fall.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a4.9.2",
      "sentiment": 1.0,
      "quote": "Enligt SKR saknas det därmed skäl att föreslå en ordning där åklagare ges en subsidiär rätt att fatta sådana beslut.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec326",
      "sentiment": -0.2,
      "quote": "Utredningen utvecklar dock inte närmare hur socialnämnden ska agera i de fall vården upphör men vissa missförhållanden i hemmiljön eller hos den unge kvarstår.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec326",
      "sentiment": -0.2,
      "quote": "Enligt SKR saknas det vidare tillräckligt underlag för att bedöma hur detta förslag förhåller sig till den nya grunden för omhändertagande för vård på grund av anknytning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec331",
      "sentiment": -1.0,
      "quote": "En sådan beredskap kräver resurser för planering och samordning och medför en ökad arbetsbelastning för socialnämnden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec341",
      "sentiment": 0.0,
      "quote": "Det finns svårigheter att tydligt beskriva vilka förändringar hos en förälder som krävs för att en återförening ska kunna bli aktuell.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec341",
      "sentiment": -0.2,
      "quote": "Det är därför av vikt att frågan lämnas öppen och att socialnämnden ges utrymme att göra bedömningen utifrån omständigheterna i det enskilda fallet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec341",
      "sentiment": -0.2,
      "quote": "Enligt SKR försvårar avsaknaden av en sådan analys bedömningen av förslagets praktiska genomförbarhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.3.9",
      "sentiment": 0.0,
      "quote": "SKR noterar att utredningen inte närmare berör frågan om den som begär umgänge med barnet också ska anses vara part i ärendet och hur information om barnet och vårdnadshavare i sådana fall bör hanteras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.3.9",
      "sentiment": -0.2,
      "quote": "Enligt SKR hade ett bättre alternativ varit att reglera umgänge med andra än vårdnadshavare och föräldrar med umgängesrätt i 11 § LVU, för att åstadkomma en tydligare åtskillnad mellan personer med reglerad umgängesrätt och andra.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.4.4",
      "sentiment": -0.5,
      "quote": "I de flesta fall är det fler än en socialsekreterare närvarande vid förhandlingen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.4.5",
      "sentiment": -0.2,
      "quote": "Någon närmare konsekvensberäkning i denna del redovisas dock inte.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.4.6",
      "sentiment": -0.2,
      "quote": "Enligt SKR är det därmed rimligt att anta att kostnaden för att följa upp ett barns situation i ett år kommer att vara det dubbla.",
      "quote_type": "grund"
    }
