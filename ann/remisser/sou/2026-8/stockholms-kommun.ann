  },
  "segments": [
    {
      "forarbete_id": "a3",
      "sentiment": -0.5,
      "quote": "Det finns en risk att sakkunnigas utlåtanden får ett alltför stort genomslag, vilket kan försvaga socialnämndens och domstolens självständiga ansvar för bedömningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.9.2",
      "sentiment": 1.0,
      "quote": "Stockholms stad tillstyrker utredningens bedömning att åklagare inte bör ges en generell rätt att fatta beslut om omedelbart omhändertagande, utan att identifierade brister i stället bör hanteras inom ramen för nuvarande system.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec251",
      "sentiment": 1.0,
      "quote": "En sådan tydligare reglering, tillsammans med ett uttryckligt lagstöd för undantag i situationer där verkställigheten annars riskeras, bedöms stärka rättssäkerheten och förutsebarheten i handläggningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec338",
      "sentiment": 1.0,
      "quote": "Den föreslagna stegvisa prövningsmodellen tydliggör vilka kriterier som ska ligga till grund för bedömningen och minskar risken för att otydliga begrepp, såsom kravet på ”varaktig och genomgripande förändring”, i praktiken får en alltför styrande betydelse.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec357",
      "sentiment": -0.5,
      "quote": "Den föreslagna ordningen riskerar att medföra ökad administrativ belastning och komplexitet i handläggningen, både för socialtjänst och domstolar, utan att tillföra ett tydligt mervärde i fråga om rättssäkerhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec503",
      "sentiment": 0.5,
      "quote": "Sådana beslut ska dock endast fattas när mindre ingripande åtgärder inte är tillräckliga och när åtgärden är proportionerlig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec512",
      "sentiment": 1.0,
      "quote": "Förslaget bedöms tydliggöra ansvarsfördelningen och minska nuvarande otydlighet, vilket kan motverka praktiska hinder såsom inställda umgängen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec367",
      "sentiment": -0.5,
      "quote": "det riskerar att leda till otydlig ansvarsfördelning och en fragmentisering av arbetet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec469",
      "sentiment": -0.5,
      "quote": "bedöms förslaget öka komplexiteten och risken för olika tolkningar snarare än att skapa ökad likvärdighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec564",
      "sentiment": 1.0,
      "quote": "Möjlighet till tidsbegränsad uppföljning, upp till ett år, bedöms skapa bättre förutsättningar att uppmärksamma kvarstående eller återkommande behov av stöd och skydd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec584",
      "sentiment": 1.0,
      "quote": "Stockholms stad tillstyrker en tydligare reglering av ansvarsfördelningen mellan kommuner vid uppföljning.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec596",
      "sentiment": 1.0,
      "quote": "Att skydds- och förhandsbedömningar även omfattar syskon och andra barn i samma hushåll är en viktig åtgärd för att säkerställa att inga barn förbises.",
      "quote_type": "grund"
    }
  ]
