  "segments": [
    {
      "forarbete_id": "a5.9",
      "sentiment": -0.2,
      "quote": "Det saknas i förslaget särskilda bestämmelser om att detta ska anmälas till Bolagsverket för registrering.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec927",
      "sentiment": -0.2,
      "quote": "Dock saknas Kla bestämmelser om avregistrering när uppdraget upphör i förtid eller när mandattiden har löpt ut.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec1128",
      "sentiment": -0.2,
      "quote": "Mot bakgrund av att det inte i något register kommer att antecknas huruvida ett företag är ett broföretag eller tillgångsförvaltningsföretag, kommer Bolagsverket inte att kunna kontrollera om det för godkännande av en anmälan om registrering krävs att Riksgäldskontoret har röstat för aktierna i de fall ett beslut från en stämma skickas in för registrering hos Bolagsverket.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec1156",
      "sentiment": -0.2,
      "quote": "Det är enligt Bolagsverket mening otydligt vad som avses med avveckling, om det är likvidation som avses, dels vad som avses med inkomster, om det t.ex. är överskottet efter en likvidation",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec138",
      "sentiment": -0.5,
      "quote": "Frågor som kommer att uppstå och som i förslaget är olösta är bl.a. hur aktierna ska fördelas och på vilka de ska fördelas, vad aktiekapitalet ska vara och var det ska tas från, hur ombildningen ska ske",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec139",
      "sentiment": -0.2,
      "quote": "Ett förtydligande av hur förslaget förhåller sig till och kompletterar befintliga regler i dessa delar är ur Bolagsverkets perspektiv önskvärt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec145",
      "sentiment": -0.2,
      "quote": "Det vore enligt Bolagsverkets uppfattning önskvärt om förslaget förtydligas i dessa delar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec159",
      "sentiment": -0.5,
      "quote": "Det saknas lagstöd för att Riksgäldskontoret – efter att resolutionen har avslutats – ska kunna ansöka om likvidation i ett försäkringsföretag.",
