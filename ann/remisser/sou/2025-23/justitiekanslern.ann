    },
    {
      "forarbete_id": "a9.6.3",
      "sentiment": 1.0,
      "quote": "Justitiekanslern tillstyrker vidare att jämkning på grund av den enskildes eget beteende bör kunna ske även när detta till någon del består av det handlande som åklagaren har angett i sin gärningsbeskrivning.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a9.6.3",
      "sentiment": -0.2,
      "quote": "Behovet av bestämmelsen i den civilrättsliga lagstiftning som frihetsberövandelagen utgör kan också ifrågasättas.",
