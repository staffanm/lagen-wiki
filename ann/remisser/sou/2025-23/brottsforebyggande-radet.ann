    },
    {
      "forarbete_id": "sec11",
      "sentiment": 1.0,
      "quote": "Brå delar utredningens iakttagelser i dessa delar och ställer sig bakom utredningens bedömning som innebär att det inte i nuläget behövs lagändringar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec12",
      "sentiment": 1.0,
      "quote": "I likhet med utsatta polismän har då även dessa yrkesgrupper behov av ersättning för sakskador och för skyddsåtgärder. Mot den bakgrunden delar Brå utredningens bedömning att sådana ersättningsmöjligheter behöver införas, och ser positivt på den föreslagna utformningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5.2",
      "sentiment": -1.0,
      "quote": "En extra höjning framstår inte i det läget som en framkomlig väg för att förmå vårdnadshavarna att känna och ta ökat ansvar för sina barn och de brott de kan begå, vilket gör att Brå avstyrker förslaget.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5.1",
      "sentiment": 1.0,
      "quote": "Brå instämmer här i utredningens konstateranden att det inte finns något egentligt argument för att sådana brott inte ska omfattas av principalansvaret nu när barn och unga inte sällan medverkar i sådan brottslighet, varför Brå tillstyrker det förslaget.",
      "quote_type": "grund"
    },
