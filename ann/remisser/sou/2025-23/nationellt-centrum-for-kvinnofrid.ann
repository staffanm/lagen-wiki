  "segments": [
    {
      "forarbete_id": "a3.6.1",
      "sentiment": 0.5,
      "quote": "En rättssäker och tillgänglig ersättningsordning är därför av stor vikt för att inte ytterligare belasta brottsoffer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.5.1",
      "sentiment": 1.0,
      "quote": "Förbättrade möjligheter att enkelt och snabbt fullgöra skadeståndsskyldigheten skulle vara till gagn för både brottsoffer och gärningsperson, och möjliggöra att båda parter kan lägga de rättsliga processerna bakom sig snabbare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.7.1",
      "sentiment": 0.5,
      "quote": "Det bör övervägas att utöka möjligheterna till utmätning av skadestånd i syfte att förbättra brottsoffers möjligheter att få sina fordringar betalda samt för att tydliggöra gärningspersoners ekonomiska ansvar för de skador som deras brottsliga handlingar har orsakat.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7.2",
      "sentiment": 1.0,
      "quote": "Vad gäller utredningens förslag beträffande rätten till kränkningsersättning för poliser och andra yrkesgrupper, samt rätten till ersättning för Polismyndighetens anställda vid sakskada och särskilda medarbetarskyddsåtgärder, tillstyrker NCK utredningens förslag.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.4.1",
      "sentiment": 1.0,
      "quote": "Vad gäller utredningens förslag beträffande rätten till kränkningsersättning för poliser och andra yrkesgrupper, samt rätten till ersättning för Polismyndighetens anställda vid sakskada och särskilda medarbetarskyddsåtgärder, tillstyrker NCK utredningens förslag.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.5.1",
      "sentiment": 1.0,
      "quote": "Det saknas tillräckligt underlag för att anta att en sådan förändring skulle ha någon påtaglig effekt på ungdomskriminaliteten, varför åtgärdens verkningsfullhet måste ifrågasättas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.6.2",
      "sentiment": 1.0,
      "quote": "Rätten till ersättning för den som felaktigt har varit frihetsberövad är en grundläggande rättsstatsprincip och garanteras även av Europakonventionen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.6.3",
      "sentiment": -1.0,
      "quote": "Som tidigare påpekats är det av stor betydelse för rättssäkerheten att det i normala fall följer en rätt till ersättning för den som har varit frihetsberövad men som slutligen inte fälls för brott.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.6.4",
      "sentiment": 1.0,
      "quote": "NCK tillstyrker utredningens förslag gällande frihetsberövandeersättning och ersättningens bestämmande.",
