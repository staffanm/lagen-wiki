    {
      "forarbete_id": "sec477",
      "sentiment": -1.0,
      "quote": "TU vänder sig mot att införa samma bestämmelse för alla artiklar i AI-förordningen då det inte kan anses proportionerligt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec493",
      "sentiment": -1.0,
      "quote": "TU:s erfarenhet är att ett omvänt skaderekvisit i praktiken leder till absolut sekretess.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec705",
      "sentiment": -1.0,
      "quote": "Enligt TU:s erfarenhet får omvänt skaderekvisit i praktiken effekt som absolut sekretess och det kommer att begränsa insyn i den verksamhet som bedrivs i de regulatoriska sandlådorna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec713",
      "sentiment": -1.0,
      "quote": "TU anser därför att det inte finns behov av någon ytterligare sekretessbestämmelse för att skydda en myndighets utveckling, träning, testning eller validering av ett AI-system i de regulatoriska sandlådorna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec339",
      "sentiment": -1.0,
      "quote": "TU anser att det är oerhört viktigt att det utses en myndighet med särskild kunskap på medieområdet, och förordar att Mediemyndigheten blir marknadskontrollmyndighet.",
      "quote_type": "grund"
    }
  ]
