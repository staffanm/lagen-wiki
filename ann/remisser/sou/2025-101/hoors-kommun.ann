  "segments": [
    {
      "forarbete_id": "sec364",
      "sentiment": 1.0,
      "quote": "Detta med bakgrund av de krav som ställs på dem enligt AI-förordningen gällande tillräckligt med personal som besitter lämplig kompetens och nödvändig sakkunskap.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec374",
      "sentiment": 1.0,
      "quote": "Detta anser vi bör fortsätta baserat på deras erfarenhet och kunskap.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec377",
      "sentiment": 1.0,
      "quote": "Då IMY är den behöriga tillsynsmyndigheten i Sverige ser vi som kommun det naturligt att IMY föreslås som marknadskontrollmyndighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec436",
      "sentiment": 1.0,
      "quote": "Kommunen delar bedömningen att PTS, med sitt huvudsakliga ansvar, behöver bygga upp bred och djup kompetens om AI-system och därmed också bör ha ett särskilt ansvar att stödja andra myndigheter i komplexa ärenden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec452",
      "sentiment": 1.0,
      "quote": "Kommunen delar bedömningen att PTS bör fungera som en ”en-väg-in”-portal för operatörer och allmänhet och ha ett särskilt ansvar att stödja övriga marknadskontrollmyndigheter med expertkunskap i komplexa ärenden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec477",
      "sentiment": 0.5,
      "quote": "Samtidigt bör sekretessen begränsas – beslut i marknadskontrollärenden ska undantas och uppgifter som rör människors hälsa, säkerhet, miljön eller redligheten i handeln ska lämnas ut om allmänintresset är tillräckligt starkt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec481",
      "sentiment": 1.0,
      "quote": "Kommunen stödjer även förslaget om sekretessbrytande bestämmelser för att möjliggöra effektiv samverkan mellan marknadskontrollmyndigheterna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec493",
      "sentiment": 1.0,
      "quote": "Kommunen delar bedömningen att sekretessen bör omfatta alla uppgifter i incidentrapporten enligt artikel 73 och åtgärder som följer av en sådan incident, eftersom dessa är känsliga och rör allvarliga incidenter som kan påverka hälsa, säkerhet, miljö eller kritisk infrastruktur.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.2.4",
      "sentiment": 1.0,
      "quote": "Detta är en viktig förutsättning för att kunna uppnå hög kvalitet och säkerhet i AI‑lösningar, särskilt när syntetiska eller anonymiserade data inte är tillräckliga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec630",
      "sentiment": -0.2,
      "quote": "Vår uppfattning är att flera kommuner saknar den fördjupade kompetens inom AI och juridik som behövs, vilket gör det avgörande att den ansvariga myndigheten har en tvärvetenskaplig arbetsgrupp som kan ge stöd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec680",
      "sentiment": -0.5,
      "quote": "Kommuner med begränsade resurser kan få svårare att delta, vilket motverkar syftet att främja bred innovation och likvärdig utveckling.",
