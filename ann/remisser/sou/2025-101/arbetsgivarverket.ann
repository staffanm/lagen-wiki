    },
    {
      "forarbete_id": "a10.5",
      "sentiment": 1.0,
      "quote": "Arbetsgivarverket instämmer i att straffrättsliga sanktioner inte ska utdömas och att ingripandena bör vara av administrativt slag (avsnitten 10.5-7, sidorna 440ff).",
