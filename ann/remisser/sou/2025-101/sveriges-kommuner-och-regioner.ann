  "segments": [
    {
      "forarbete_id": "a9.5",
      "sentiment": 0.5,
      "quote": "Det är centralt att PTS har kapacitet att ha en vägledande och rådgivande funktion även för aktörer som inte är marknadskontrollmyndigheter eller annars har ett särskilt ansvar enligt AI-förordningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.9.6",
      "sentiment": 0.5,
      "quote": "Om utredningens förslag antas kommer det finnas ett antal olika bestämmelser om incidentrapportering i OSL (se 18 kap. 8 §-18 kap. 8 e), varav flera kan bli aktuella för kommuner och regioner att tillämpa.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.7.3",
      "sentiment": 0.5,
      "quote": "Att ytterligare utöka möjligheterna till sanktioner utöver för överträdelser av artikel 99.3-5 vore därför oproportionerligt och gå stick i stäv med regeringens ambitioner så som de kommer till uttryck i implementeringsrådets uppdrag, nämligen att undvika genomförande av EU-lagstiftning över miniminivån.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.8.1",
      "sentiment": -0.5,
      "quote": "Sådan verksamhet kommer dock oftast omfattas av andra regelverk med sanktionsmöjligheter, såsom dataskydds- och cybersäkerhetsregleringen.",
      "quote_type": "grund"
