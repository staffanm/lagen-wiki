  "segments": [
    {
      "forarbete_id": "a6.9",
      "sentiment": -0.2,
      "quote": "En lydelse som inte kan uppfattas som att möjligheten att vittnesersättningar och liknande hanteras av expeditionerna försvinner vore att föredra.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5.2",
      "sentiment": -0.2,
      "quote": "Språkligt kan detta läsas motsatsvis som att åklagarens åtal vid tingsrätt är en förutsättning för målsägandens rätt att klaga till högre rätt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": -0.2,
      "quote": "Ombud kan ha uppdrag som inte omfattas av det juridiska yrket, som uppdrag i en förening och denne kan även ibland utföra andra uppgifter som att betala räkningar, där inga sådana sekretessöverväganden som ingår i advokatetiken gör sig gällande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5.3",
      "sentiment": -0.2,
      "quote": "Den föreslagna texten ger dock upphov till två frågor: (i) är målsäganden förhindrad att ställa andra frågor (det vill säga innebär skrivningen en rättighet eller en begränsning); och (ii) vad gäller när målsägaren åtalat brottet?",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.7.7",
      "sentiment": -0.2,
      "quote": "Underinstansen till allmän domstol intar inte sällan en endast rent formell motpartsställning efter ett överklagande av myndighetens beslut, som för inskrivningsmyndigheten eller för Bolagsverket.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.11.1",
      "sentiment": -0.2,
      "quote": "Det framstår därför inte som klart varför det inte finns en delegationsmöjlighet avseende målsägandebiträden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5",
      "sentiment": -0.5,
      "quote": "Tillämpas taxan rätt av kan ersättningen bli orättvis i förhållande till aktörer med större arbetsbörda.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.15.3",
      "sentiment": -1.0,
      "quote": "det kan diskuteras huruvida det utifrån den låga tröskel som gäller för försvararförordnanden är skäligt att föräldrar ska bära den kostnadsbördan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.15.4",
      "sentiment": 1.0,
      "quote": "Genom en ökad koncentration kan förhoppningsvis såväl förundersökning, som rättegång bedrivas med ökad effektivitet.",
