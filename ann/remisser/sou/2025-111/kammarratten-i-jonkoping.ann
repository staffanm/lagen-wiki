  "segments": [
    {
      "forarbete_id": "sec209",
      "sentiment": -0.2,
      "quote": "Kammarrätten anser att det vore lämpligare att, på det sätt som görs i rättsfallet, låta tidsspillan avse tid som tas i anspråk i samband med ett uppdrag men då något produktivt arbete med något uppdrag eller annan uppgift inte kan utföras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5.2",
      "sentiment": -0.5,
      "quote": "Som de föreslagna bestämmelserna är formulerade kan de dock innebära att rätten är domför utan nämndemän även vid beslut som rör ersättning för rättegångskostnader.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.7.3",
      "sentiment": -0.5,
      "quote": "I sådana fall medför den föreslagna ordningen att den enskilde inte kan få ersättning för alla de biträdeskostnader som kan ha uppstått efter att det, genom det första myndighetsbeslutet, uppstått en tvist mellan myndigheten och den enskilde.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.7.4",
      "sentiment": -0.5,
      "quote": "Med tanke på att ersättningsskyldighet för en enskild part kan förväntas uppstå sällan, och då endast i vissa särskilda måltyper, anser kammarrätten att det vore att föredra att införa sådana bestämmelser i relevant speciallagstiftning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec533",
      "sentiment": -0.8,
      "quote": "Att en sådan part ska kunna riskera att bli ersättningsskyldig trots att han eller hon har processat efter bästa förmåga framstår inte som en lämplig ordning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.8.7",
      "sentiment": -0.2,
      "quote": "Därför är det enligt kammarrättens mening svårt att med ledning av betänkandet få en tillräckligt tydlig bild av i vilka situationer en rätt till rättshjälp ska inträda i förvaltningsmål.",
      "quote_type": "grund"
    }
  ]
