  "overall": {
    "sentiment": 0.5,
    "quote": "Det är både angeläget och konstitutionellt nödvändigt att förvaltningsdomstolar ges möjlighet att bevilja sådan ersättning inom ramen för förvaltningsmålet.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a12.7.1",
      "sentiment": 1.0,
      "quote": "För det första är det Centrum för rättvisas bedömning att en sådan reform är nödvändig för att säkerställa att förvaltningsprocessen är förenlig med rätten till en rättvis rättegång.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.6",
      "sentiment": 1.0,
      "quote": "Av 2 kap. 11 § andra stycket regeringsformen, artikel 6.1 i Europakonventionen och artikel 47 i EU-stadgan följer att det under vissa förhållanden står i strid med rätten till en rättvis rättegång att enskilda saknar möjlighet att få ersättning för rättegångskostnader som de haft för att tillvarata sin rätt gentemot det allmänna",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.3.5",
      "sentiment": 1.0,
      "quote": "Av de skäl som anförts ovan framstår det som inte bara angeläget utan även konstitutionellt nödvändigt att utredningens förslag till reform denna gång genomförs.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.7.3",
      "sentiment": 1.0,
      "quote": "Den utformning av regeln som utredningen föreslår framstår som lämplig och väl förenlig med såväl Högsta domstolens som Europadomstolens praxis avseende rätten till en rättvis rättegång.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.7.3",
      "sentiment": 1.0,
      "quote": "Centrum för rättvisa instämmer i utredningens bedömning att en sådan utformning av regeln är förenlig med rätten till en rättvis rättegång och kan därför tillstyrka även ett sådant förslag.",
      "quote_type": "grund"
    }
  ]
}