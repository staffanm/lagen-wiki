    },
    {
      "forarbete_id": "a8.5.1",
      "sentiment": 0.2,
      "quote": "enbart det förhållandet att en advokat arbetat i ett visst antal år inte i sig innebär att denne är lämpad att hantera allvarliga och mer komplexa brottmål",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5.1",
      "sentiment": 1.0,
      "quote": "Vi tillstyrker utredningens förslag att avskaffa målsägandens möjligheter att biträda åtalet",
