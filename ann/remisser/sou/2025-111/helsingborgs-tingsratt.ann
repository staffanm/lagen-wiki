    },
    {
      "forarbete_id": "a6.11.2",
      "sentiment": 1.0,
      "quote": "en sådan bestämmelse ge rätten ett bättre underlag att ta ställning till behovet av offentlig försvarare eller målsägandebiträde",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.5.1",
      "sentiment": 1.0,
      "quote": "I förhållande till det totala antalet skadestånd som handläggs i anslutning till brottmål utgör detta en mycket liten andel",
