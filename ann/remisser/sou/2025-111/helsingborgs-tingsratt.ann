    },
    {
      "forarbete_id": "a6.8",
      "sentiment": 1.0,
      "quote": "ett sådant krav inte medföra någon kvalitativt bättre hantering av inkomna kostnadsanspråk då arbetsläget för domare normalt sett inte tillåter en granskning av dessa i förtid",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5.2",
      "sentiment": 0.5,
      "quote": "inga invändningar mot utredningens förslag att nämndemän inte ska medverka vid prövningen av vissa ersättningsfrågor",
