  "overall": {
    "sentiment": 0.4,
    "quote": "Sammantaget välkomnar BOJ flera av de reformer som föreslås i utredningen, särskilt de som syftar till att stärka brottsoffers tillgång till juridiskt stöd och förbättra möjligheterna till rättslig prövning.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a9.5.1",
      "sentiment": -0.2,
      "quote": "Det finns därför en risk att utredningens förslag leder till att vissa målsägande i praktiken får en mer begränsad möjlighet att delta i processen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5.3",
      "sentiment": 0.5,
      "quote": "BOJ anser dock att dessa rättigheter inte enbart bör tillkomma målsägande som väcker talan om enskilt anspråk, utan bör vara kopplade till målsägandes ställning som brottsoffer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5.2",
      "sentiment": 1.0,
      "quote": "BOJ ser därför positivt på att utredningen värnar målsägandens möjlighet att överklaga domar, även i ansvarsdelen, i de fall åklagaren väljer att inte överklaga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.6.4",
      "sentiment": 1.0,
      "quote": "BOJ välkomnar särskilt det utvidgade omedelbarhetskravet gällande förundersökningsledares ansökan om målsägandebiträde som innebär att det inte längre kommer att gälla enbart sexualbrott utan även andra brottstyper som begås i nära relation.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.6.3",
      "sentiment": 1.0,
      "quote": "BOJ ställer sig också bakom förslaget om att tydliggöra att inte enbart brottets art, utan även faktorer som ålder, sjukdom och funktionsnedsättning ska utgöra grund för förordnande av målsägandebiträde.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.6.2",
      "sentiment": 0.2,
      "quote": "BOJ bedömer dessutom att begränsningen till tre timmars arbete per ärende, om inte särskilda skäl föreligger, är snävt tilltagen och bör utvidgas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.5.2",
      "sentiment": 1.0,
      "quote": "BOJ tillstyrker förslaget att ett förordnande av målsägandebiträde ska bestå även när handläggningen av det enskilda anspråket skiljs från brottmålet, både i ordinära och förenklade tvistemål.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a11.5.1",
      "sentiment": 1.0,
      "quote": "En gemensam handläggning bidrar till att hålla nere processkostnaderna och minskar risken för att brottsoffer ska behöva hantera parallella rättsprocesser under en längre tid.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.5.3",
      "sentiment": -0.5,
      "quote": "Att ett brottsoffer vid återkallelse eller vid ogillande av skadeståndstalan kan bli skyldigt att ersätta gärningspersonens rättegångskostnader, även i fall där gärningspersonen dömts för brottet, är enligt BOJ:s mening inte rimligt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.7.1",
      "sentiment": 1.0,
      "quote": "Möjligheten för enskilda att i vissa fall få ersättning för rättegångskostnader gentemot det allmänna i förvaltningsmål är enligt BOJ ett viktigt steg för att stärka den enskildes rättssäkerhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.8.1",
      "sentiment": 1.0,
      "quote": "BOJ delar även utredningens bedömning att inkomstgränsen bör kopplas till prisbasbelopp i stället för att fastställas till ett statiskt belopp. En sådan konstruktion innebär att gränsen automatiskt kan följa den ekonomiska utvecklingen över tid.",
