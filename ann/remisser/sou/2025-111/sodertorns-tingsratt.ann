    {
      "forarbete_id": "a6.6",
      "sentiment": 0.5,
      "quote": "För att förslaget ska medföra en förbättring krävs att E-tjänsten utformas på det sätt som anges i betänkandets förslag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.11.1",
      "sentiment": -0.5,
      "quote": "Tingsrätten anser därför att det inte har framkommit något behov av att begränsa en tingsrätts möjlighet att delegera beslutanderätt i fråga om förordnande av offentliga försvarare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5.2",
      "sentiment": 0.5,
      "quote": "Tingsrätten anser att det i grunden är ett bra förslag men att det inte tydligt framgår om det är tillåtet att låta nämndemän vara med och besluta eller om nämndemän aldrig ska få delta vid prövningen.",
      "quote_type": "grund"
