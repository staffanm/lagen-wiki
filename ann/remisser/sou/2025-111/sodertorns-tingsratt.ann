  "segments": [
    {
      "forarbete_id": "sec209",
      "sentiment": 0.0,
      "quote": "Tingsrätten konstaterar att rätten inte har någon praktisk möjlighet att kontrollera de skäl som anges till grund för begäran om ersättning för tidsspillan.",
