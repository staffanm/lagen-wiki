    {
      "forarbete_id": "a6.7",
      "sentiment": 0.2,
      "quote": "Tingsrätten noterar att det inte framgår av betänkandet om och i så fall hur de skärpta kraven ska tillämpas på kostnadsräkningar i mål där brottmålstaxan är tillämplig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": -0.2,
      "quote": "En differentierad timkostnadsnorm kan därför leda till merarbete för domstolarna.",
