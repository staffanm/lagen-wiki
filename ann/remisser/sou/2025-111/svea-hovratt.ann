    {
      "forarbete_id": "a13.8.1",
      "sentiment": 1.0,
      "quote": "Hovrätten tillstyrker att inkomstgränsen för rättshjälp höjs och att bedömningarna knyts till prisbasbeloppet i stället för till fasta belopp.",
