  "segments": [
    {
      "forarbete_id": "a6.3",
      "sentiment": 1.0,
      "quote": "Hovrätten instämmer i utredningens bedömning att det inte finns skäl att ändra den grundläggande rätten till ersättning för tidsspillan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7.2",
      "sentiment": 1.0,
      "quote": "Ett sådant krav skulle innebära en ökad administrativ börda för domstolarna som inte står i proportion till behovet av en sådan bestämmelse.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.15.1",
      "sentiment": 1.0,
      "quote": "Hovrätten är positiv till att Domstolsverket får ett förtydligat bemyndigande att meddela föreskrifter om utlägg.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": 0.5,
      "quote": "Detta skulle överensstämma med regleringen i första och andra styckena samt medföra att avrundningsregeln kan utgå.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5",
      "sentiment": 1.0,
      "quote": "Eftersom hovrätten ofta har avbrott i en huvudförhandling på grund av sammanträde för hänvisning till muntlig bevisning är hovrätten av uppfattningen att en sådan utökning skulle innebära att brottmålstaxan många gånger skulle bli tillämplig i hovrätten även om den inte varit det i tingsrätten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6",
      "sentiment": 0.2,
      "quote": "Hovrätten är inte övertygad om att tjänsten kommer att leda till en ökad kostnadskontroll.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7",
      "sentiment": -0.2,
      "quote": "I fråga om de skärpta kraven på kostnadsräkningar anser hovrätten att det i 20 § andra stycket rättshjälpsförordningen (1997:404) bör anges även att det av kostnadsräkningen ska framgå vilken dag som tidsspillan uppstått.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8",
      "sentiment": 1.0,
      "quote": "Hovrätten instämmer i utredningens slutsatser att det inte bör införas ett krav på att ersättningsanspråk i brottmål ska framställas löpande eller vid vissa särskilt angivna tidpunkter.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.15.3",
      "sentiment": 1.0,
      "quote": "Hovrätten delar utredningens bedömning att en reglering som ålägger föräldrar till barn som döms för brott att ersätta staten för kostnader som staten haft för en offentlig försvarare som utsetts för barnet skulle kunna bidra till att dämpa den samlade kostnadsutvecklingen av anslaget för rättsliga biträden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7",
      "sentiment": 1.0,
      "quote": "Hovrätten ställer sig bakom förslaget om att hovrätten ska vara domför utan nämndemän vid prövning av dels fråga om ersättning av allmänna medel till biträde, försvarare eller någon annan, dels fråga om återbetalningsskyldighet enligt 31 kap. rättegångsbalken eller liknande kostnad.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a9.5.1",
      "sentiment": 1.0,
      "quote": "Hovrätten instämmer i utredningens bedömning att de skäl som har motiverat målsägandens rätt att biträda åtalet inte längre framstår som tillräckligt bärande liksom att utgångspunkten i ett rättssystem är att det är åklagaren som ska föra talan om straffrättsligt ansvar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5.2",
      "sentiment": 0.0,
      "quote": "Hovrätten ser dock flera problem med den lagtekniska lösning som utredningen föreslår i denna del.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5.3",
      "sentiment": -0.5,
      "quote": "Mot bakgrund av det nu sagda ser hovrätten inget behov av den författningsändring som utredningen nu föreslår.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a9.5.4",
      "sentiment": 0.0,
      "quote": "Utredningen anger inte heller varför regleringen behövs eller hur den förhåller sig till den avvägning som, enligt hovrättens uppfattning ovan, redan ska göras enligt den föreslagna första meningen i det nya stycket i 5 kap. 3 § rättegångsbalken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.6.1",
      "sentiment": -0.5,
      "quote": "Hovrätten ifrågasätter alltså sammanfattningsvis behovet av den nya punkten i 1 a § andra stycket och avstyrker därför utredningens förslag i den delen.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a10.6.2",
      "sentiment": -0.5,
      "quote": "En målsägande kan emellertid enligt hovrätten antas ha liknande behov av stöd och hjälp, oavsett vilken av de nu aktuella brottstyperna det är fråga om.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.6.3",
      "sentiment": -1.0,
      "quote": "Något behov av författningsändringar finns därför inte varför hovrätten avstyrker förslaget.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a11.5.1",
      "sentiment": 1.0,
      "quote": "Hovrätten instämmer i utredningens förslag i de nu aktuella delarna.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a11.5.4",
      "sentiment": 0.5,
      "quote": "Hovrätten anser därför att den rättegångskostnadsregel som utredningen föreslår har goda skäl för sig.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a12",
      "sentiment": -0.5,
      "quote": "Utredningen synes ha förbisett dessa mål, som tidigare huvudsakligen handlades i allmän förvaltningsdomstol, och alltså borde träffas av just de rättegångskostnadsregler som utredningen föreslår ska gälla för ”förvaltningsmål”.",
