  "segments": [
    {
      "forarbete_id": "a6.15.3",
      "sentiment": -1.0,
      "quote": "Kalmar kommun gör bedömningen att en överläggning av kostnadsansvaret för rättegångskostnader på föräldrarna inte skulle ha några brottsförebyggande effekter, utan snarare skulle öka risken för ytterligare marginalisering av redan resurssvaga grupper och drabba exempelvis hemmavarande syskon ekonomiskt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.6.3",
      "sentiment": 1.0,
      "quote": "Kalmar kommun har inställningen att en lagförändring som stärker äldres och funktionsnedsattas förutsättningar att få sina rättigheter tillvaratagna och som ger stöd vid deras deltagande i rättsprocessen om de har blivit utsatta för även vissa egendomsbrott – exempelvis bedrägerier - är en mycket välkommen och angelägen åtgärd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.5.4",
      "sentiment": 1.0,
      "quote": "Kommunal verksamhet rymmer en hel del myndighetsutövande verksamhet, där det då och då uppstår situationer som innehåller kränkande uttalanden och olika typer av mer eller mindre uttalade hot.",
      "quote_type": "grund"
