  "overall": {
    "sentiment": -0.1,
    "quote": "Rättssäkerheten har ett pris även på biträdessidan.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a6.3",
      "sentiment": 1.0,
      "quote": "En ordning där biträdet inte skulle få någon form av ersättning för sådan tid vore orimlig mot bakgrund av att biträden och advokater måste finansiera sina egna kostnader.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": -1.0,
      "quote": "Sammanfattningsvis är det Advokatsamfundets uppfattning att förslaget med en differentierad timkostnadsnorm, som innebär en sänkning utifrån dagens nivå, allvarligt riskerar att försvåra för advokatbyråer inom humanjuridiken att rekrytera och anställa biträdande jurister, vilket i förlängningen kommer att inverka på statens tillgång till rättsliga biträden och enskildas möjlighet att föra sin talan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5",
      "sentiment": -1.0,
      "quote": "Advokatsamfundet avstyrker varje utökad användning av taxor för ersättning till rättsliga biträden, då taxa inte ger det förordnade biträdet skälig ersättning för sitt arbete.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6",
      "sentiment": -1.0,
      "quote": "Advokatsamfundet ser flera betänkligheter och få fördelar med att samtliga biträden ska lämna in sina kostnadsräkningar via ett gemensamt elektroniskt system.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7",
      "sentiment": 1.0,
      "quote": "Givetvis ska skattefinansierad verksamhet gå att kontrollera och följa upp, och medlen ska användas effektivt och ändamålsenligt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8",
      "sentiment": 1.0,
      "quote": "Mot bakgrund av hur brottmålsadvokater arbetar, särskilt i större brottmål, är det svårt att se vilka vinster ett sådant system skulle medföra.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.12",
      "sentiment": 0.5,
      "quote": "En biträdande jurist som arbetar under den förordnade advokatens ledning har i regel god kännedom om det aktuella ärendet och kan på ett ändamålsenligt sätt tillvarata klientens intressen vid förhör.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7",
      "sentiment": 1.0,
      "quote": "De skäl för ändring som redovisas i utredningen är välmotiverade och välgrundade.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5.1",
      "sentiment": 0.2,
      "quote": "Det kan dock ifrågasättas om det föreligger ett faktiskt behov av att lagreglera ytterligare behörighetskrav, särskilt mot bakgrund av att Advokatsamfundet redan tillämpar kvalifikationskrav inom ramen för det advokatetiska regelverket.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5.1",
      "sentiment": -1.0,
      "quote": "Detta innebär ofrånkomligen en försvagning av målsägandens ställning i brottmålsprocessen – även om målsägandebiträdet förstås kan ha en löpande underhandsdialog med åklagarsidan under förundersökningen i frågor rörande gärningsbeskrivningens utformning, rubricering och behovet av bevisning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.6.1",
      "sentiment": 1.0,
      "quote": "Den nuvarande ordningen innebär att ett förordnande som utgångspunkt upphör när tiden för att överklaga tingsrättens dom har löpt ut, vilket inte är förenligt med lagstiftarens intention om att stärka brottsoffers ställning i brottmålsprocessen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.6.3",
      "sentiment": 1.0,
      "quote": "Utifrån Advokatsamfundets perspektiv går det att ifrågasätta varför detta inte redan har gällt, då det får anses utgöra självklara omständigheter att beakta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.6.4",
      "sentiment": 1.0,
      "quote": "Det förekommer alltjämt att målsägandebiträde även i den typen av ärenden förordnas först efter initiala förhör, vilket är olyckligt ur flera avseenden, varför ett förtydligande av denna skyldighet är välkommet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.5.1",
      "sentiment": 1.0,
      "quote": "Advokatsamfundet instämmer i utredningens uppfattning att det inte föreligger tillräckliga skäl för att avskaffa eller begränsa möjligheterna att avskilja en talan om enskilt anspråk enligt 22 kap. 5 § rättegångsbalken.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a11.5.2",
      "sentiment": 1.0,
      "quote": "Advokatsamfundet delar bedömningen att de skäl som motiverar att ett biträdesförordnande kvarstår i ett ordinärt tvistemål i princip gör sig gällande med samma styrka även när ett enskilt anspråk handläggs som ett förenklat tvistemål.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.5.3",
      "sentiment": 1.0,
      "quote": "En sådan ordning skulle medföra att målsäganden kunde framställa ogrundade yrkanden eller yrka belopp utan stöd i lag eller praxis, vilket vore olyckligt ur ett handlingsdirigerande perspektiv.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.5.4",
      "sentiment": 1.0,
      "quote": "Framför allt gäller detta offentliganställda som genom sin tjänsteutövning i större utsträckning än andra riskerar att bli utsatta för brott.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.7.1",
      "sentiment": 1.0,
      "quote": "Den nuvarande ordningen, att en vinnande part för att få sina kostnader ersatta måste framställa ett skadeståndsanspråk gentemot staten i ett separat mål med all den olägenhet och kostnad som detta kan vara förenat med, är orimlig varför utredningens förslag är mycket välkomna och efterlängtade.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.7.3",
      "sentiment": 0.2,
      "quote": "Denna osäkerhet riskerar i vissa fall att motverka syftet med reformen genom att enskilda avstår från att driva befogade processer mot det allmänna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.7.4",
      "sentiment": 1.0,
      "quote": "Advokatsamfundet har inte någon erinran mot att det införs en särskild kostnadsregel i förvaltningsmål där enskilda är motparter till varandra, av de skäl som utredningen anför.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a13.8.1",
      "sentiment": 1.0,
      "quote": "Inkomstgränsen har dock inte justerats sedan 1999, vilket har urholkat tillgången till rättshjälp och i alltför hög grad begränsat den enskildes möjligheter att få sin sak prövad eller göra sin rätt gällande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.8.7",
      "sentiment": 1.0,
      "quote": "Förhållandena är i grunden ojämna då den enskilde ska processa mot en myndighet som har egna jurister och goda ekonomiska förutsättningar att driva process.",
      "quote_type": "grund"
    }
  ]
}