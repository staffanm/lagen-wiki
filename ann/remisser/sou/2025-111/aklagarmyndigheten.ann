  "segments": [
    {
      "forarbete_id": "a6.7",
      "sentiment": 1.0,
      "quote": "Åklagarmyndigheten menar också, i likhet med utredningen, att det är av stor vikt att kraven på vilka uppgifter som ska redovisas i en kostnadsräkning är höga",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.10",
      "sentiment": 1.0,
      "quote": "Åklagarmyndigheten delar utredningens bedömning att de nuvarande beloppsgränserna för när en åklagare ska yttra sig över ett ersättningsanspråk bör behållas och att det inte heller bör införas ett krav på att en åklagare ska yttra sig skriRligen över ett ersättningsanspråk.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.11.2",
      "sentiment": 1.0,
      "quote": "en regel som tydliggör vad en anmälan enligt 23 kap. 5 § rättegångsbalken eller enligt 24 § lagen med särskilda bestämmelser om unga lagöverträdare ska innehålla kan vara av värde för att minska behovet av kompletteringar och skapa bättre förutsättningar för rätten att pröva behovet av försvarare eller målsägandebiträde.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.12.2",
      "sentiment": 1.0,
      "quote": "Det är därför, enligt Åklagarmyndighetens uppfattning, olämpligt att åklagaren ska fatta beslut om den misstänktas offentliga försvarare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.15.4",
      "sentiment": 1.0,
      "quote": "Åklagarlnyndigheten delar utredningens bedömning och välkomnar, av såväl kostnadsbesparings- som effektivitetsskäl, förslaget om ytterligare överväganden för att åstadkomma effektivare brottsutredningar och mer koncentrerade huvudförhandlingar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5.1",
      "sentiment": 1.0,
      "quote": "Åklagarmyndigheten anser att det är av stor vikt för samhället och rättsstaten att förtroendet för advokater upprätthålls och delar därför utredningens förslag om att behörighetskraven bör skärpas för uppdrag som offentlig försvarare i vissa mål om allvarlig brottslighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5.1",
      "sentiment": 0.2,
      "quote": "målsägandens nuvarande möjlighet att biträda åtalet kan skapa otydlighet i fråga om processens ram för såväl de processande parterna som domstolen, vilket talar för att denna möjlighet bör avskaffas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5.2",
      "sentiment": 1.0,
      "quote": "För det fall målsägandens möjlighet att biträda åtalet avskaffas delar Åklagarmyndigheten utredningens förslag om att det bör genomföras vissa ändringar när det gäller målsägandens rätt att överklaga en dom i ansvarsdelen.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a9.5.3",
      "sentiment": 0.2,
      "quote": "i anledning av de skilda tolkningar av det nuvarande rättsliga läget som utredningen uppmärksammat välkomnar Åklagarmyndigheten ett förtydligande i denna del.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5.4",
      "sentiment": 1.0,
      "quote": "Åklagarmyndigheten tillstyrker förslaget.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a10.6.1",
      "sentiment": -0.5,
      "quote": "Att målsägandebiträdet i tingsrätten per automatik förordnas i överrätt innebär en trygghet och ökar förutsägbarheten för målsäganden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.6.3",
      "sentiment": 1.0,
      "quote": "Förslaget i denna del möjliggör en bättre behovsbedömning i det enskilda fallet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.6.4",
      "sentiment": 0.5,
      "quote": "förslaget kan innebära en viss risk för att domstolarna bedömer att underlagen inte är tillräckliga för att förordna ett målsägandebiträde i ett tidigt skede av en förundersökning, särskilt i ärenden som rör mindre allvarlig brottslighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.5.1",
      "sentiment": 1.0,
