  "segments": [
    {
      "forarbete_id": "sec209",
      "sentiment": -0.2,
      "quote": "Däremot befarar hovrätten att förslaget riskerar att bli tandlöst.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec211",
      "sentiment": 1.0,
      "quote": "det är rimligt att advokater erhåller ett högre arvode än annan jurist med hänsyn till skillnader i kompetens, erfarenhet och ansvar, samt att detta lämpligen bör återspeglas i timersättningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec215",
      "sentiment": 0.5,
      "quote": "Hovrätten är däremot av uppfattningen att brottmålstaxan utan vidare skulle kunna utvidgas till att omfatta en huvudförhandlingstid om sex timmar, vilket får anses utgöra normal förhandlingstid motsvarande en heldagsförhandling.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec218",
      "sentiment": 1.0,
      "quote": "en sådan ordning bland annat skulle leda till en smidigare och mer enhetlig hantering av kostnadsräkningar, att kvaliteten ökar och att kostnadskontrollen förbättras, liksom att fel och dubbeldebitering motverkas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec262",
      "sentiment": 1.0,
      "quote": "Förslaget ligger väl i linje med hur hovrätten hanterar handläggningen av denna typ av ärenden idag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec295",
      "sentiment": 1.0,
      "quote": "Hovrätten tillstyrker förslaget om att tingsrätt och hovrätt ska vara domför utan nämndemän vid rättens prövning i frågor som rör ersättning till rättsliga biträden samt återbetalningsskyldighet i vissa fall.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec339",
      "sentiment": 1.0,
      "quote": "vilket överensstämmer med de kvalifikationskrav som finns i advokatsamfundets vägledande regler för god advokatsed.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec362",
      "sentiment": 1.0,
      "quote": "Hovrätten delar utredningens bedömning att målsägandens möjlighet att biträda åtalet bör avskaffas.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec364",
      "sentiment": -0.5,
      "quote": "Det framstår som orimligt att målsäganden efter avslutad huvudförhandling ska kunna begära att överklagandet prövas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10",
      "sentiment": 0.0,
      "quote": "Det finns inget behov av att förordna målsägandebiträde i fler fall än vad som görs idag.",
