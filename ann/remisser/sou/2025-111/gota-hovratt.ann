    },
    {
      "forarbete_id": "sec403",
      "sentiment": 1.0,
      "quote": "målsägandes behov i vissa fall av information om hovrättsprocessen och kurativt stöd på ett rimligt sätt bör kunna tillgodoses genom ett särskilt målsägandestöd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.6",
      "sentiment": -0.2,
      "quote": "Tillägget i 1 § lagen om målsägandebiträde att rätten ska beakta målsägandens ålder, sjukdom och funktionsnedsättning är obehövligt eftersom reglerna redan tillämpas på det sättet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec435",
      "sentiment": 1.0,
      "quote": "Hovrätten delar utredningens bedömning att det är viktigt att möjligheten att avskilja det enskilda anspråket från brottmålet ska kvarstå.",
