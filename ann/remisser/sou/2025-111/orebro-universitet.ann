  "segments": [
    {
      "forarbete_id": "sec209",
      "sentiment": 0.0,
      "quote": "Med tanke på att detta redan torde vara den gängse definitionen av begreppet tidsspillan så kan man undra vad som egentligen uppnås genom denna nya legaldefinition, men saken kan i detta sammanhang lämnas därhän.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6",
      "sentiment": -0.5,
      "quote": "Det är naturligtvis utmärkt att en sådan elektronisk tjänst erbjuds, men inslaget av tvång är här svårsmält.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a17.3",
      "sentiment": 1.0,
      "quote": "Att alla utlägg alltjämt ska stärkas genom verifikationer är däremot självklart och bra.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5.2",
      "sentiment": 1.0,
      "quote": "Det är också välkommet att tings- och hovrätter i brottmål ska kunna pröva ersättningsfrågor utan nämndemäns medverkan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5.2",
      "sentiment": 0.2,
      "quote": "Kanske hade man här förväntat sig något skarpare och tuffare samt tydligare åtgärder.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.6",
      "sentiment": 1.0,
      "quote": "En sådan rätt finns i normalfallet inte i dag, vilket kan strida mot art. 6 i Europakonventionen om mänskliga rättigheter och rätten till en rättvis rättegång i 2 kap. 11 § Regeringsformen.",
      "quote_type": "grund"
    },
    {
