  "overall": {
    "sentiment": 0.0,
    "quote": "Hovrätten över Skåne och Blekinge har granskat betänkandet utifrån de aspekter som särskilt berör domstolen.",
    "quote_type": "standpunkt"
  },
  "segments": [
    {
      "forarbete_id": "a6.7",
      "sentiment": -0.2,
      "quote": "På grund av vad som anförts ovan ställer sig hovrätten tveksam till om de föreslagna förändringarna skulle medföra en så mycket bättre kostnadskontroll att det motiverar det merarbete som förändringarna skulle innebära.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8",
      "sentiment": 0.8,
      "quote": "Hovrätten instämmer i utredningens bedömning att det är tveksamt om ett krav på att kostnadsräkningar ska ges in tidigare under handläggningen kommer att förbättra domstolarnas granskning av kostnadsräkningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7",
      "sentiment": 0.8,
      "quote": "Däremot välkomnas förslaget att kunna avgöra dessa frågor utan nämndemän eftersom det förbättrar förutsättningarna att göra en noggrann kostnadskontroll.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5.1",
      "sentiment": -0.5,
      "quote": "Enligt hovrätten finns det därför inget behov av att också införa lagstadgade behörighetsregler.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5.1",
      "sentiment": 0.0,
      "quote": "Hovrätten har inga andra synpunkter än att det bör förtydligas hur författningsförslaget i 20 kap. 8a § rättegångsbalken förhåller sig till 51 kap. 24 § rättegångsbalken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5.2",
      "sentiment": 0.0,
      "quote": "instämmer i att det bör förtydligas om, och i så fall med vilken sammansättning, ett särskilt beslut ska fattas när målsägandens överklagande förfaller enligt författningsförslaget i 20 kap. 8a § andra stycket rättegångsbalken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5.3",
      "sentiment": -0.5,
      "quote": "De tillägg som föreslås i 36 kap. 17 § rättegångsbalken och 40 kap. 10 § rättegångsbalken är därför obehövliga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5.4",
      "sentiment": 0.8,
      "quote": "Hovrätten anser liksom utredningen att det är rimligt att en målsägande som inte för talan tillförsäkras en rätt att närvara vid huvudförhandling även om denna äger rum inom stängda dörrar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.6.1",
      "sentiment": 0.2,
      "quote": "Enligt hovrättens mening är denna exemplifiering olycklig eftersom den täcker in betydligt fler fall än vad som framgår av lagtexten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.5.4",
      "sentiment": 0.2,
      "quote": "Det kan därför ifrågasättas om det är motiverat att begränsa regelns tillämplighet till att enbart gälla offentliganställda och skadestånd på grund av brott enligt 17 kap. 1–3 §§ brottsbalken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.7.3",
      "sentiment": 0.5,
      "quote": "I likhet med vad Svea hovrätt har anfört i sitt yttrande över betänkandet bör dock en rätt till ersättning av det allmänna utformas i linje med den rättsregel som Högsta domstolen slog fast i rättsfallet NJA 2015 s. 374.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.8.5",
      "sentiment": -0.2,
      "quote": "Hovrätten ifrågasätter om det är förenligt med Sveriges åtaganden enligt barnkonventionen.",
      "quote_type": "grund"
    }
  ]
}