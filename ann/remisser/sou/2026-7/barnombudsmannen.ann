  "overall": {
    "sentiment": -0.2,
    "quote": "Barnombudsmannen välkomnar därför ambitionen att stärka kunskapsunderlaget om barns hälsa och levnadsvillkor, men betonar att detta måste ske på ett sätt som omfattar alla barn, inklusive de grupper som i dag riskerar att falla utanför befintliga system.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a13.5.3",
      "sentiment": 0.5,
      "quote": "Primärvården är ofta den första och ibland enda kontakten barn har med hälso- och sjukvården, och en stärkt datainsamling är därför central för att säkerställa barns rätt till bästa möjliga hälsa enligt artikel 24 i barnkonventionen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.5.4",
      "sentiment": 0.5,
      "quote": "För att detta ska vara möjligt krävs att elevhälsans yrkesverksamma systematiskt frågar barn om våldsutsatthet, i enlighet med barnets rätt till skydd enligt artikel 19.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.5.5",
      "sentiment": 0.5,
      "quote": "Tandhälsa är en central del av barns allmänna hälsa och välbefinnande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.5.6",
      "sentiment": 1.0,
      "quote": "En mer heltäckande registrering stärker möjligheterna att följa barns rätt till bästa möjliga hälsa och bidrar till ett mer jämlikt och kunskapsbaserat folkhälsoarbete.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.5.7",
      "sentiment": 0.5,
      "quote": "En utökad och systematisk insamling av hälsodata från statlig vård och samhällsvård är därför en nödvändig förutsättning för att identifiera brister, följa upp insatser och säkerställa att alla barn får den vård de har rätt till.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.5.9",
      "sentiment": 0.5,
      "quote": "En heltäckande registrering är nödvändig för att säkerställa barns rätt till utbildning enligt artikel 28 i barnkonventionen och för att möjliggöra tidig upptäckt av frånvaro som kan signalera ohälsa, utsatthet eller bristande stöd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.6",
      "sentiment": -0.5,
      "quote": "Avsaknaden av en barnrättslig analys innebär att konsekvenserna för barn inte fullt ut synliggörs eller beaktas.",
      "quote_type": "grund"
    }
