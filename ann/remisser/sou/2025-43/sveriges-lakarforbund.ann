  "overall": {
    "sentiment": 0.5,
    "quote": "Sveriges läkarförbund tillstyrker utredningens förslag, men vill understryka att begränsningar endast får användas i undantagsfall.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a3.1.3",
      "sentiment": 0.0,
      "quote": "För läkarna innebär det utöver den ökade arbetsbörda som utredningen nämner också en etisk stress att veta att patienten inte kan erbjudas det bästa behandlingsalternativet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.4.1",
      "sentiment": -0.2,
      "quote": "Att det uppstår brist på ett läkemedel på grund av kraftigt ökad efterfrågan för användningsområden utanför indikation till patientgrupper som inte är prioriterade är dock inte en särskilt representativ bristsituation och bör inte ges alltför stor vikt när åtgärder utformas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.6.1",
      "sentiment": 0.2,
      "quote": "Vi vill dock understryka att det bör vara en sista utväg efter att mjukare styrmedel prövats, till exempel olika former av rekommendationer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec64",
      "sentiment": 1.0,
      "quote": "Läkarförbundet tillstyrker att begränsningar ska gälla både humanläkemedel och veterinärmedicinska läkemedel, inte minst för att kunna omfördela läkemedel från djur till människor i de fall det handlar om produkter som även är lämpliga för människor.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec67",
      "sentiment": 0.5,
      "quote": "Inför en begränsning behöver verket noga överväga vad som ska gälla för de patienter som har recept som utfärdats innan begränsningen trätt i kraft.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec68",
      "sentiment": 1.0,
      "quote": "Läkarförbundet menar att detta förefaller vara ett ändamålsenligt sätt att reglera att begränsningar endast ska användas i undantagsfall när andra styrmedel visat sig otillräckliga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec6",
      "sentiment": 0.2,
      "quote": "Vi vill dock understryka att möjligheten att begränsa förordnande till godkänd indikation måste användas med stor försiktighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec71",
      "sentiment": 1.0,
      "quote": "Det är svårt för Läkemedelsverket att förutse alla enskilda patientbehov och hur de påverkas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec72",
      "sentiment": 1.0,
      "quote": "Läkarförbundet anser att alla beslut om begränsningar bör vara tidsbegränsade, och förlängas i de fall bristsituationen kvarstår.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.6.5",
      "sentiment": 1.0,
      "quote": "Läkarförbundet instämmer i utredningens bedömning att systemstöd är en viktig förutsättning för att underlätta tillämpning och kontroll av efterlevnaden av föreskrifter om begränsad förskrivningsrätt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.8.1",
      "sentiment": -0.2,
      "quote": "Det innebär krångel och oro för patienterna, risk för missnöje i mötet med apotekspersonal och merarbete för läkare när patienten behöver andra läkemedel eller annan behandling.",
      "quote_type": "grund"
    },
    {
