  "segments": [
    {
      "forarbete_id": "a3.1.3",
      "sentiment": -0.5,
      "quote": "Här saknas konsekvensbeskrivning för regionerna: - Arbetet med att hitta alternativa lösningar tar resurser såväl personella som ekonomiska.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.6.1",
      "sentiment": 1.0,
      "quote": "Region Gävleborg ställer sig bakom utredningens bedömning om att det finns behov av att tillfälligt kunna begränsa förordnande och utlämnande av läkemedel i vissa bristsituationer.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a3.6.2",
      "sentiment": 0.2,
      "quote": "Rutiner och beslutsprocesser behöver finnas för att möjliggöra snabba beslut, detta i nära samverkan med hälso- och sjukvården och är nödvändiga för att arbetet ska fungera i praktiken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.6.5",
      "sentiment": 0.5,
      "quote": "Region Gävleborg välkomnar att det föreslås ett systemstöd men vill understryka vikten av att ett sådant är integrerat i journalsystemen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.6.6",
      "sentiment": -0.2,
      "quote": "Det är viktigt att tillsynen tar hänsyn till alla aspekter hos aktörerna att i praktiken tillämpa beslutade begränsningar och i de fall avvikelser sker, alltid i första hand titta på förutsättningar för och bakomliggande, strukturella orsaker till varför avsteg skett från beslutade begränsningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.7",
      "sentiment": -0.5,
      "quote": "Region Gävleborg är mycket tveksam till om tidpunkten för ikraftträdande är realistisk med hänsyn till nödvändigheten av bland annat ett integrerat systemstöd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.8.1",
      "sentiment": -0.5,
      "quote": "En begränsning av rätten till att förordna men inte lämna ut innebär en ojämlik vård då enbart nyskrivna recept kommer omfattas av begränsningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.8.3",
      "sentiment": 0.2,
      "quote": "Samma kommentar som under 3.6.2, se denna.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a3.8.4",
      "sentiment": -0.5,
      "quote": "Att enbart begränsa till förordnande kommer enligt vår bedömning inte att fungera – begränsningar i utlämnande kommer sannolikt alltid behöva följa med som en konsekvens om begränsningar görs av förordnandet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.8.6",
      "sentiment": -0.5,
      "quote": "Följande slutsats i utredningen bedömer Region Gävleborg vara mycket svår att förvänta sig fullt genomslag i, och kan därför heller inte ställa sig helt bakom: ”Om det inte finns något systemstöd i journalsystem som informerar om tillfälliga begränsningar eller förhindrar att läkemedel förordnas felaktigt behöver de som förordnar läkemedel hålla sig uppdaterade om vilka begränsningar som gäller för att inte riskera att förordna läkemedel i strid med gällande regler.”",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.8.7",
      "sentiment": -0.5,
      "quote": "Region Gävleborg bedömer att detta kan få stora konsekvenser där väldigt mycket ansvar läggs på regionerna.",
      "quote_type": "grund"
