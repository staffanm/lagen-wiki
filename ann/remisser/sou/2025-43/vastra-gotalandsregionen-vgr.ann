  "overall": {
    "sentiment": 0.2,
    "quote": "VGR lägger idag mycket resurser, både personella och ekonomiska, på att hantera problematiken med läkemedelsbrister och är i grunden positiva till åtgärder som syftar till att styra tillgången till läkemedel.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "sec62",
      "sentiment": -0.5,
      "quote": "VGR anser utifrån denna erfarenhet därför att Läkemedelsverket ensamt inte kan fatta beslut om lämpliga begränsningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.6.2",
      "sentiment": -0.5,
      "quote": "Så kallad offlabelanvändning är stor i vården vilket riskerar att man missar viktiga patientgrupper om man begränsar på detta sätt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.2.6",
      "sentiment": -0.5,
      "quote": "Konsekvensen blir ojämlik vård beroende på var patienten finns geografiskt men också att läkemedel riskerar att behöva kasseras på grund av att hållbarheten blir för kort eller går ut under den tid då utlämnandet begränsas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.8.1",
      "sentiment": -0.2,
      "quote": "Detta resonemang gäller endast vid nyinsättning och receptförnyelse.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.8.7",
      "sentiment": -0.5,
      "quote": "Att hänvisa patienter dit skulle medföra merarbete för både patient och personal samt leda till ökade väntetider för patienter och därmed ökad risk för patientsäkerheten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.6.5",
      "sentiment": -0.5,
      "quote": "Anpassningen kommer vara komplex för att möjliggöra både ”spärr”funktionalitet och rekommendationer om alternativ.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.2.5",
      "sentiment": -0.5,
      "quote": "Vårdgivare har inte skyldighet att anmäla brister till Läkemedelsverket i bemärkelsen läkemedelsbrist som texten antyder.",
      "quote_type": "grund"
    }
  ]
