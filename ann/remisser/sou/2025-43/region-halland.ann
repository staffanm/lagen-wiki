    {
      "forarbete_id": "a3.6.5",
      "sentiment": 0.2,
      "quote": "Region Halland vill även förstärka behovet av att E-hälsomyndigheten samarbetar med regionerna vid utredning om möjligt att införa systemstöd då det potentiellt innebär en utveckling av alla regionens system som hanterar läkemedel.",
      "quote_type": "grund"
    }
  ]
