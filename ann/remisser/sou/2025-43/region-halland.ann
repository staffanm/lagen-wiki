  "segments": [
    {
      "forarbete_id": "a3.2.6",
      "sentiment": 0.5,
      "quote": "Det är positivt att inte enbart luta sig mot Ransoneringslagen (1978:268) som instrument för att prioritera försörjningen av läkemedel vid rest- och bristsituationer, då fullmaktslagarna i grunden är avsedda att tillämpas vid krig, krigsfara och utomordentliga förhållanden – vilket rest- och bristsituationer för läkemedel inte alltid kan antas utgöra.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.3",
      "sentiment": -0.2,
      "quote": "Ett förordnande eller ett utlämningsförbud kan i sådana situationer ge upphov till en inlåsningseffekt, vilket riskerar att begränsa flexibiliteten i försörjningskedjan och därigenom motverka det avsedda syftet med begränsningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec70",
      "sentiment": 0.2,
      "quote": "Region Hallands bedömning är att det är viktigt att det finns rutiner och beslutsprocesser på plats till ikraftträdandet som medger snabba beslut i de fall en begränsning kan vara ett av flera verktyg för att mildra konsekvenserna av en bristsituation.",
      "quote_type": "grund"
