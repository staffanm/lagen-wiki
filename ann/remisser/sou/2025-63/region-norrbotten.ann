  "segments": [
    {
      "forarbete_id": "a6.3.2",
      "sentiment": 1.0,
      "quote": "Det främjar ökad kompetens, yrkesskicklighet och patientsäkerhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.18",
      "sentiment": 1.0,
      "quote": "En skyddad yrkestitel kan leda till en högre yrkesstatus och gynna personalförsörjningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": 0.2,
      "quote": "Regionen anser däremot att det i utredningen inte tydligt framgår vad som avses med ”ett tillräckligt brett patientunderlag”.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.2",
      "sentiment": -0.2,
      "quote": "Dels har en ST-läkare i slutet av sin ST redan varit verksam som legitimerad läkare i cirka 6 år.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5",
      "sentiment": 0.2,
      "quote": "Regionen anser däremot att avsaknaden av sanktioner mot verksamheter som inte genomför externa granskningar vart femte år är problematiskt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.6.1",
      "sentiment": 0.5,
      "quote": "Om det ska ställas krav på tillägg i föreskrifterna gällande ett ”tillräckligt brett patientunderlag” så behöver det också vara volym- och diagnosmässigt väldefinierat vad som avses med ”tillräckligt brett patientunderlag”.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.1",
      "sentiment": 0.5,
      "quote": "För att avhjälpa bristen på specialister genom specialiseringstjänstgöring, anser regionen att det bör avsättas statliga medel till regionerna för att möjliggöra en god uppstart av denna process.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.5",
      "sentiment": 0.5,
      "quote": "Det råder idag ojämlika förutsättningar för att genomföra specialistutbildning för logopeder, särskilt i Region Norrbotten där handledarkompetens saknas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5.3",
      "sentiment": 0.5,
      "quote": "Däremot finns risk att parallella system uppstår, vilket kan skapa otydlighet kring exempelvis verksamhetsförlagd utbildning (VFU) som ska ske i verksamheterna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec578",
      "sentiment": -0.2,
      "quote": "Region Norrbotten anser att införande av ny reglering kan uppfattas som att arbetsgivaren inte redan tar detta ansvar, vilket riskerar att signalera bristande tillit till arbetsgivarens ambitioner att följa lagkrav och vara en attraktiv arbetsgivare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec637",
      "sentiment": -0.5,
      "quote": "En förbättrad regelbunden fortbildning kommer att kräva ökade resurser i form av samordning, genomförande av utbildning och uppföljning, vilket är kostnadsdrivande och förutsätter statlig ersättning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec594",
      "sentiment": -0.2,
      "quote": "Beskrivningen är grund och det är enligt regionens mening viktigt att det tydliggörs på vilket sätt efterlevnaden av detta krav ska kontrolleras.",
      "quote_type": "grund"
