  "segments": [
    {
      "forarbete_id": "sec7",
      "sentiment": 0.8,
      "quote": "Fotterapeuter arbetar självständigt med direkt patientansvar, bland annat inom prevention och behandling av fotsår hos riskpatienter, vilket har stor betydelse för patientsäkerheten i ett helhetsperspektiv.",
