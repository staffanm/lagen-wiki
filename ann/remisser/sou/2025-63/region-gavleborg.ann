  "segments": [
    {
      "forarbete_id": "sec7",
      "sentiment": 1.0,
      "quote": "Förslaget om skyddad yrkestitel för medicinska fotterapeuter stöds, utifrån deras självständiga patientansvar och behandlingsuppgifter.",
