  "overall": {
    "sentiment": 0.0,
    "quote": "Socialstyrelsen lämnar i huvudsak följande synpunkter:",
    "quote_type": "standpunkt"
  },
  "segments": [
    {
      "forarbete_id": "a6.3.2",
      "sentiment": 0.5,
      "quote": "Med hänsyn till att utbildningen i medicinsk fotterapi regleras och blir en enhetligare yrkeshögskoleutbildning bedömer Socialstyrelsen att det inte är nödvändigt att myndigheten för framtida yrkesverksamma ska föreskriva alternativ till den föreslagna yrkeshögskoleutbildningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.3",
      "sentiment": 0.5,
      "quote": "Socialstyrelsen anser dock till skillnad från utredningen att en reglering av yrket medicinsk fotterapeut med en skyddad yrkestitel bör inkludera en prövning av både kompetens och lämplighet hos yrkesutövaren då det är ett yrke där lämplighet är av särskild vikt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.4",
      "sentiment": 1.0,
      "quote": "Förslaget står i paritet mot liknande sanktioneringar för andra yrkesgrupper, bland annat undersköterskor.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.6",
      "sentiment": -0.5,
      "quote": "En lång övergångsperiod kan riskera att motverka den förstärkta patientsäkerhet som är syftet med att reglera yrket medicinska fotterapeuter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.7",
      "sentiment": -1.0,
      "quote": "Med hänsyn till vikten av att stärka hälso- och sjukvårdens och tandvårdens beredskap i händelse av kris eller krig anser Socialstyrelsen att det är viktigt att även dessa aspekter utreds närmare innan ett ställningstagande sker.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": -0.5,
      "quote": "Socialstyrelsen bedömer att den brist som pekas ut i utredningen inte kan lösas genom enbart en översyn av föreskrifterna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.6.1",
      "sentiment": 0.2,
      "quote": "Socialstyrelsen anser, till skillnad från utredningen, att det finns skäl att införa ett krav på att behörig myndighet eller organ ska godkänna verksamheter som anordnar specialistutbildningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.1",
      "sentiment": 0.5,
      "quote": "Socialstyrelsen anser att även följande förutsättning behöver beaktas: • En medicinsk specialitet bör ha ett tillräckligt antal utövande specialister för att möjliggöra att specialiteten kan inrättas och upprätthållas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.5",
      "sentiment": 0.5,
      "quote": "Socialstyrelsen påtalar dock, som delvis förs fram genom yttrandet till punkten 8.4.1, farhågan om det finns tillräckligt många utövande specialister för att en specialitet kan inrättas och sedermera upprätthållas framförallt när det gäller logopeder.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.7",
      "sentiment": 0.2,
      "quote": "Så som förslaget är formulerat uttrycks att individen snarare än verksamheten har ett utbildningsbehov, vilket kan innebära en risk för att insatser på systemnivå uteblir.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.7.2",
      "sentiment": 1.0,
      "quote": "Socialstyrelsen tillstyrker förslaget att hälso- och sjukvårdspersonal ska ha en skyldighet att regelbundet ta del av fortbildning.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a9.7.3",
      "sentiment": -1.0,
      "quote": "Så som kravet på uppföljning och redovisning av resultat på vårdgivarnivå i den årliga patientsäkerhetsberättelsen är formulerat bedömer Socialstyrelsen att det inte utgör en ändamålsenlig uppföljning av vårdgivarens systematiska arbete utifrån ansvaret att identifiera och prioritera behov av kompetensutveckling och ge förutsättningar och möjligheter till regelbunden fortbildning.",
      "quote_type": "grund"
    }
  ]
}