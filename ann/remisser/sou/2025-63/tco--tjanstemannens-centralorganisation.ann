  "overall": {
    "sentiment": -0.4,
    "quote": "TCO, som hade förhoppningar om att utredningen skulle komma med förslag som gav ett starkt stöd till denna utveckling av hälso- och sjukvården, måste tyvärr uttrycka sin besvikelse, och framför därför följande synpunkter på några av utredningens bedömningar och förslag.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a6.3.1",
      "sentiment": 0.8,
      "quote": "Detta eftersom kriterierna beaktar aspekter som patientsäkerhet, yrkesrollens innehåll, utbildningsnivå och internationella förhållanden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.7",
      "sentiment": 0.8,
      "quote": "En viktig aspekt är att det inte får blir en inflation i legitimerade yrken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.12",
      "sentiment": -1.0,
      "quote": "Idag kan personer utan relevant utbildning anställas som mediciniska vårdadministratörer, vilket utgör en risk för patientsäkerheten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.18",
      "sentiment": -1.0,
      "quote": "Att en person utan tandsköterskeutbildning kan kalla sig tandsköterska utgör stora risker för patientsäkerheten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.1",
      "sentiment": -0.2,
      "quote": "Vårdförbundet anser att förutsättningarna bl.a. framgår av utredningens redovisning av möten med arbetsgivare, professioner och patientorganisationer vilka samstämmigt efterfrågar och ser behovet av specialister och specialistkompetenser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.7",
      "sentiment": -1.0,
      "quote": "Den pågående omställningen till en god och nära vård tillsammans med landets demografi och en åldrande befolkning med ökat vårdbehov förutsätter fler specialistutbildade medarbetare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.7",
      "sentiment": 0.8,
      "quote": "Vårdförbundet anser att det är av vikt att vårdgivaren identifierar utbildningsbehovet och ger möjlighet till regelbunden fortbildning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.7.2",
      "sentiment": 0.8,
      "quote": "För legitimerade yrkesgrupper ingår detta förhållningssätt som en naturlig del av ett yrkesliv.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.7.3",
      "sentiment": 0.8,
      "quote": "Förbundet ser därför positivt på förslaget att HSL och PSL ska kompletteras med skrivningar vilka innebär att vårdgivaren ska redovisa omfattningen av fortbildningen i den årliga patientsäkerhetsberättelsen.",
      "quote_type": "grund"
    }
  ]
