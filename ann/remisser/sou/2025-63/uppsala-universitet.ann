  "segments": [
    {
      "forarbete_id": "sec7",
      "sentiment": 1.0,
      "quote": "Uppsala universitet tillstyrker utredningens förslag att medicinska fotterapeuter bör få skyddad yrkestitel.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.3.8",
      "sentiment": -0.2,
      "quote": "Detta må vara en korrekt bedömning men bemöter egentligen inte de starka önskemål om yrkesreglering som framförts av professionsförbunden och de rekommendationer som framkommer av de utredningar och det forskningsunderlag som presenteras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.11",
      "sentiment": -0.5,
      "quote": "Uppsala universitet anser dock att det utifrån patientsäkerhetsperspektivet finns starka skäl att reglera yrkeskategorierna genetisk vägledare och sjukhusgenetiker.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.17",
      "sentiment": -0.5,
      "quote": "Sjukhusgenetiker ansvarar för genetisk diagnostik, från analys och tolkning till rapportering av provsvar, ofta utan att en läkare direkt medverkar i bedömningsprocessen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": 1.0,
      "quote": "Uppsala universitet tillstyrker utredningens förslag att förtydliga de privata vårdgivarnas ansvar för ST-utbildningen.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.4.2",
      "sentiment": 0.5,
      "quote": "Uppsala universitet anser att nyttan med ett sådant prov uppväger nackdelen med den ökade administrativa börda som skulle resultera ur detta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.5",
      "sentiment": 0.5,
      "quote": "Dock ser Uppsala universitet att det kan utvecklas ett praktiskt problem om fördelningen av specialistutbildningskurser mellan lärosätena inte samordnas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.8",
      "sentiment": -0.5,
      "quote": "Apotekare och receptariers arbete för förbättrad läkemedelsanvändning i olika roller inom apotek, region och kommuner är i högsta grad viktig för patientsäkerheten och utifrån det perspektivet hade det varit naturligt att inkludera dem.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.7",
      "sentiment": -0.5,
      "quote": "Inom dessa yrken ges idag möjlighet att ta en magisterexamen (dvs en akademisk examen på avancerad nivå) och det finns många yrkesverksamma med en sådan examen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5.3",
      "sentiment": 0.5,
      "quote": "Lärosätena kommer dock att behöva en långsiktig planering för att klara av lärarbemanningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.7",
      "sentiment": 0.5,
      "quote": "Samtidigt bör definitionen preciseras för att undvika oklarheter, och även apotekare och receptarier inom apoteksväsendet och andra vårdnära verksamheter bör omfattas av reglerna och uppföljning.",
      "quote_type": "grund"
    }
  ]
