  "segments": [
    {
      "forarbete_id": "a6.2",
      "sentiment": 1.0,
      "quote": "KI instämmer i utredningens bedömning att det inte finns något behov av att ändra de principer och kriterier som ligger till grund för bedömningen av vilka yrkesgrupper som ska vara reglerade.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.3.2",
      "sentiment": 1.0,
      "quote": "Förslaget är väl underbyggt och har stor betydelse för både kvalitet och patientsäkerhet, särskilt med tanke på den stora gruppen patienter med diabetes.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.7",
      "sentiment": 0.2,
      "quote": "KI delar den bedömning som görs utifrån principerna för behörighetsreglering, men har kommentarer avseende några av yrkesgrupperna i genomgången.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.3.8",
      "sentiment": -0.5,
      "quote": "Utredningens bedömning, där yrkesrollen föreslås definieras av den enskilda arbetsgivaren utan nationell samordning, riskerar att leda till en alltför snäv yrkesprofil.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.9",
      "sentiment": 0.2,
      "quote": "vill betona vikten av att de, utöver sin vidareutbildning, ska vara legitimerade biomedicinska analytiker för att säkerställa patientsäkerheten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.13",
      "sentiment": 0.2,
      "quote": "det skulle öka tydligheten i yrkesrollen om endast de som innehar rekvisitionsrätten skulle få kalla sig optometrister.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.14",
      "sentiment": 0.2,
      "quote": "Det skulle öka tydligheten i yrkesrollen om endast personer med rätt kompetens skulle få kalla sig ortoptister.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.1",
      "sentiment": 0.2,
      "quote": "En återkommande fråga är att utredningen inte tydligare kommenterar varför man bedömer att det inte går att kombinera en specialisttjänstgöring med en examen i högskolan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.5",
      "sentiment": 0.5,
      "quote": "specialistkompetens för dessa två yrkeskategorier skulle kunna bidra till ökad patientsäkerhet, förbättrade vårdresultat samt till att vården effektiviseras, särskilt för patienter med komplexa behov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec454",
      "sentiment": 0.2,
      "quote": "Det finns dock en potentiell risk att förslaget kan skapa regionala skillnader i kvalitet och tillgång, beroende på resurser och lokala förutsättningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec452",
      "sentiment": -0.2,
      "quote": "Förslaget innebär dock en tydlig förkortning av logopeders specialistutbildning samt att den formella vetenskapliga fördjupningen tas bort från specialiseringen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.7",
      "sentiment": -0.5,
      "quote": "KI vill understryka att det är väsentligt att de med en yrkesexamen från treåriga utbildningar har möjlighet till, och att det ges incitament för, fortsatta studier på avancerad nivå med relevans för hälso- och sjukvården.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.10",
      "sentiment": -0.5,
      "quote": "Det finns en fara att ha en yrkesbenämning på en kvalificerad yrkesroll som används nationellt men som inte har en tydlig och gemensam definition.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.11",
      "sentiment": -0.2,
      "quote": "KI anser att frågan om barnmorskeutbildningens framtida utformning behöver utredas snarast.",
