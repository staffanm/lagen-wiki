  "segments": [
    {
      "forarbete_id": "a6.3.2",
      "sentiment": 1.0,
      "quote": "Region Uppsala stödjer förslaget om skyddad yrkestitel för medicinsk fotterapeut i sin helhet.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": 1.0,
      "quote": "Region Uppsala stödjer utredningens bedömning att föreskrifterna om läkarnas specialiseringstjänstgöring, ST, behöver ses över.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.4.1",
      "sentiment": 1.0,
      "quote": "Region Uppsala instämmer i bedömningen att vårdgivarens ansvar för att säkerställa att specialiseringstjänstgöringen innehåller ett tillräckligt brett patientunderlag för att kompetensmålen i målbeskrivningen ska kunna uppnås behöver förtydligas i Socialstyrelsens föreskrifter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.2",
      "sentiment": 1.0,
      "quote": "Kunskapsprov och progressionstest är viktiga och används redan idag som stöd för ST-läkaren i dennes kompetensutveckling, och som stöd för verksamheterna i arbetet med kvalitetssäkring av ST.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5",
      "sentiment": 1.0,
      "quote": "Region Uppsala ställer sig positiva till ett tillägg i föreskrifterna som innebär att åtgärder som har vidtagits för att hantera brister som framkommit vid extern granskning bör följas upp inom ett år.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.5",
      "sentiment": -1.0,
      "quote": "Uppföljning enligt utredningens förslag skulle medföra oproportionerligt ökade kostnader ekonomiskt och administrativt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.6.1",
      "sentiment": -1.0,
      "quote": "Om det ska finnas ett system för att i förväg bedöma och godkänna verksamheter med uppdrag att bedriva ST, särskilt i relation till enskilda vårdgivare, så bör ett sådant uppdrag ligga hos en nationell myndighet, inte hos regionerna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.6.1",
      "sentiment": -1.0,
      "quote": "Frågor som rör ekonomisk ersättning till enskilda vårdgivare bör hanteras på regional, ej nationell, nivå.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec385",
      "sentiment": 1.0,
      "quote": "Regionen instämmer i att regionerna årligen bör redovisa statistik över antal personer som genomför specialiseringstjänstgöring till Socialstyrelsen.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.4.5",
      "sentiment": 0.5,
      "quote": "En författningsreglerad specialistutbildning för psykologer skulle leda till ökad patientsäkerhet och förbättrade vårdresultat, särskilt för patienter med komplexa behov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5.3",
      "sentiment": 1.0,
