  "overall": {
    "sentiment": 0.5,
    "quote": "Äldre samt vård- och omsorgsnämnden tillstyrker remiss angående Stärkt patientsäkerhet genom rätt kompetens – utifrån hälso- och sjukvårdens och tandvårdens behov.",
    "quote_type": "standpunkt"
  },
  "segments": [
    {
      "forarbete_id": "sec7",
      "sentiment": 1.0,
      "quote": "En sådan reglering kan bidra till ökad patientsäkerhet för personer som behöver fotvård av medicinska skäl, exempelvis vid diabetes.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.8",
      "sentiment": 1.0,
      "quote": "Eftersom sjuksköterskor redan har legitimation bedöms ytterligare reglering inte öka patientsäkerheten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.5",
      "sentiment": 1.0,
      "quote": "Förvaltningen har inga synpunkter avseende detta förslag.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": 1.0,
      "quote": "En översyn är motiverad med tanke på de förändringar som sker inom hälso- och sjukvården utifrån omställningen till nära vård och välfärdsutmaningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.7",
      "sentiment": 0.5,
      "quote": "Ett tydligt och lagstadgat ansvar bedöms kunna bidra till att kompetensutveckling prioriteras och genomförs mer systematiskt inom vård- och omsorgsverksamheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.7.2",
      "sentiment": 1.0,
      "quote": "Ett sådant förtydligande bedöms kunna stärka yrkesrollen, främja kontinuerlig kompetensutveckling och bidra till ökad patientsäkerhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.7.3",
      "sentiment": -0.2,
      "quote": "Den utökade administration som krävs för att redovisa planerade och genomförda lärandeaktiviteter innebär ett resursbehov som inte fullt ut beaktas i utredningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5.2",
      "sentiment": 1.0,
      "quote": "Ett nationellt system för strukturerad vidareutbildning bedöms kunna stärka kompetensförsörjningen inom vårdsektorn och bidra till en mer jämlik tillgång till kompetensutveckling.",
      "quote_type": "grund"
    }
  ]
