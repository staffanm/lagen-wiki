      "artifact:forarbete/sou/2025-63": "461094f462cdf3d5e300f64df1c13bc71f9e5017089a2d108dbaf9978b04511e"
    }
  },
  "overall": {
    "sentiment": 0.5,
    "quote": "Både läkares specialiseringstjänstgöring och fortbildning är kritiska för läkarkårens kompetens, och i förlängningen sjukvårdens kvalitet och säkerhet.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a7.4",
      "sentiment": 0.5,
      "quote": "de verksamheter som erbjuder eller tar emot läkare för specialiseringstjänstgöring, måste kunna tillhandahålla ett sådant patientunderlag som säkerställer att ST-läkaren kan uppnå måluppfyllelse inom aktuell specialitet",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.6.1",
      "sentiment": 0.5,
      "quote": "Förbundet kan inte nog betona vikten av att ett sådant system behöver inbegripa såväl offentliga som privata vårdgivare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": 0.2,
      "quote": "vi inte stödjer ett obligatorium för kunskapsprov (specialistexamen), utan detta måste vara upp till respektive specialitetsförening att rekommendera.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5",
      "sentiment": 1.0,
      "quote": "de brister som uppdagats vid en extern granskning av en verksamhets eller regions specialiseringstjänstgöring ska följas upp inom ett år efter granskningen",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.6.1",
      "sentiment": -0.2,
      "quote": "för att säkerställa att samtliga huvudmän och vårdgivare deltar i utbildningen av läkare för att säkra kompetensförsörjningen av specialistläkare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.6.1",
      "sentiment": 0.5,
      "quote": "Det måste dock även framgå inom vilken specialitet ST-läkaren genomför sin specialiseringstjänstgöring.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.7",
      "sentiment": 0.5,
      "quote": "den möjlighet som vårdgivarna ger också ska vara reell, och att detta behöver följas upp på något sätt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.7",
      "sentiment": 1.0,
      "quote": "Verksamhetens behov av kompetens och fortbildning måste styra, inte personalens anställningsform eller anställningens omfattning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.7.2",
      "sentiment": 0.5,
      "quote": "Vi vill dock understryka vikten av att arbetsgivare möjliggör fortbildning, till exempel genom att frigöra tid från det kliniska arbetet, i annat fall blir det orimligt att hålla enskilda vårdanställda ansvariga för bristande fortbildning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.7.3",
      "sentiment": 1.0,
      "quote": "Det är oerhört viktigt att regleringen av fortbildning följs upp, och vi tycker att det är bra att utredaren tydliggör att fortbildning är en integrerad del i vårdgivarens systematiska kvalitets- och patientsäkerhetsarbete.",
      "quote_type": "grund"
    }
  ]
}