    },
    {
      "forarbete_id": "a6.3.7",
      "sentiment": 0.5,
      "quote": "En viktig aspekt är att det inte får blir en inflation i legitimerade yrken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.1",
      "sentiment": -0.2,
      "quote": "Vårdförbundet anser att förutsättningarna bl.a. framgår av utredningens redovisning av möten med arbetsgivare, professioner och patientorganisationer vilka samstämmigt efterfrågar och ser behovet av specialister och specialistkompetenser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.7",
      "sentiment": -0.5,
      "quote": "Den pågående omställningen till en god och nära vård tillsammans med landets demografi och en åldrande befolkning med ökat vårdbehov förutsätter fler specialistutbildade medarbetare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.7",
      "sentiment": 0.5,
      "quote": "Vårdförbundet anser att det är av vikt att vårdgivaren identifierar utbildningsbehovet och ger möjlighet till regelbunden fortbildning.",
