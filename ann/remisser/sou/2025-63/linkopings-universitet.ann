    {
      "forarbete_id": "a6.3.7",
      "sentiment": -0.5,
      "quote": "Linköpings universitet anser det mycket olyckligt att utredningen inte föreslår att fler yrkesgrupper ska omfattas av skyddad yrkestitel.",
