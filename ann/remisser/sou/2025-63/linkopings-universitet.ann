    },
    {
      "forarbete_id": "a6.3.8",
      "sentiment": -1.0,
      "quote": "Avsaknaden av reglering riskerar att leda till fragmenterade utbildningar med varierande kvalitet, vilket kan försvåra både rörlighet och kvalitetssäkring inom yrket.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.11",
      "sentiment": -1.0,
      "quote": "Det undergräver patientsäkerheten att inte ha specifika behörighetskrav och garantera kompetensutveckling för de yrkesroller som handhar patienterna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": 0.5,
      "quote": "Det är viktigt att säkerställa att tjänstgöringen omfattar ett tillräckligt brett patientunderlag för att målen i målbeskrivningarna för specialiseringstjänstgöringen ska kunna uppnås.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.2",
      "sentiment": 0.5,
      "quote": "Kunskapsprov kan bidra till ökad transparens och nationell jämförbarhet, men bör ses som ett komplement till den helhetsbedömning som görs inom ramen för den kliniska tjänstgöringen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5",
      "sentiment": 0.5,
      "quote": "En tydlig återkoppling stärker kvalitetssäkringen och bidrar till ökad patientsäkerhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.6.1",
      "sentiment": 0.5,
      "quote": "Linköpings universitet delar utredningens bedömning att det finns ett behov av att säkerställa jämlik tillgång till vidareutbildning samt ökad transparens i utbildningsutbud och krav.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.5",
      "sentiment": 0.5,
      "quote": "För att garantera den vetenskapliga kvaliteten i utbildningen bör det ställas krav på tillgång till disputerad handledningskompetens, alternativt etableras samverkan med universitet och högskolor.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5.1",
      "sentiment": 0.5,
      "quote": "I det fortsatta arbetet är det dock avgörande att lärosätena ges en betydligt mer aktiv roll än vad som hittills varit fallet i utredningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.7",
      "sentiment": 1.0,
      "quote": "Linköpings universitet instämmer i att Vårdgivaren ska identifiera hälso- och sjukvårdspersonalens utbildningsbehov och ge möjlighet till regelbunden fortbildning i en sådan omfattning som leder till att kravet på god vård i hälso- och sjukvårdslagen (2017:30) respektive tandvårdslagen (1985:125) upprätthålls.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.7.2",
      "sentiment": 1.0,
      "quote": "Linköpings universitet instämmer i att Hälso- och sjukvårdspersonal ska ha en skyldighet att regelbundet ta del av fortbildning.",
