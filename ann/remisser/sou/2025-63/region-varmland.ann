  "segments": [
    {
      "forarbete_id": "sec7",
      "sentiment": 0.8,
      "quote": "tror att denna förändring på sikt kan, förutom att kvaliteten på vården säkras, göra att statusen för yrket förbättras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.18",
      "sentiment": -0.5,
      "quote": "Tandsköterskans arbetsuppgifter har utvecklats, där tandsköterskan förutom arbete på tandklinik även har många självständiga arbetsuppgifter utanför en tandklinik.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.5",
      "sentiment": 0.5,
      "quote": "Det skapar en tydligare struktur, högre kvalitet och bättre förutsättningar för en långsiktig kompetensförsörjning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.5",
      "sentiment": -0.8,
      "quote": "I Värmland, såsom mindre region, prioriteras att logopederna har en bred kompetens inom många olika diagnosgrupper snarare än djupare specialistkunskap.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5.3",
      "sentiment": 0.2,
      "quote": "Regionens förslag är att först utreda om det är möjligt att förändra det nuvarande antagningssystemet, med målet att anpassa det mer till arbetsgivarnas fortbildningsbehov, innan det skapas en alternativ parallell utbildningsväg",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": 0.8,
      "quote": "Det är positivt med en skärpning av kraven på fortbildning och examination, att säkerställa att ST läkarna har den bredd som krävs för att alla ska kunna bli fullvärdiga specialister samt att SPUR-granskningen får mer tyngd och följs upp av examinatorerna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9",
      "sentiment": 0.2,
      "quote": "Regionen anser att en viss reglering för att stärka fortbildningens status kan vara av godo för patientsäkerheten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.7.3",
      "sentiment": -0.5,
      "quote": "Patientsäkerhetsberättelsen tas fram en gång per år och är ett övergripande dokument för hela regionen.",
