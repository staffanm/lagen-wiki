  "segments": [
    {
      "forarbete_id": "a4.5.1",
      "sentiment": 1.0,
      "quote": "Specifikt utformad reglering ger större möjligheter att skydda den enskildes personliga integritet och minskar risk för att överskottsinformation hämtas in eller att sekretessbelagda uppgifter lämnas ut felaktigt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.6.1",
      "sentiment": 1.0,
      "quote": "ser att det finns effektivitetsvinster att göra som sparar tid och arbete för både den arbetssökande och för myndigheten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.6.2",
      "sentiment": 1.0,
      "quote": "Vi ser fördelar med att informationsdelningen blir mer effektiv, att myndigheten bättre kan följa upp samt att felaktigheter minskar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.6.5",
      "sentiment": 1.0,
      "quote": "Funktionsrätt Sverige tillstyrker utredningens förslag som innebär att universitet och högskolor på begäran ska lämna uppgifter om en arbetssökandes ansökan, antagning, deltagande i studier, studiernas tid och omfattning och examen till Arbetsförmedlingen om uppgiften behövs för att Arbetsförmedlingen ska kunna utföra sina uppgifter i den arbetsmarknadspolitiska verksamheten.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a4.6.8",
      "sentiment": 1.0,
      "quote": "Funktionsrätt Sverige tillstyrker att en skyldighet införs för folkhögskolor att på begäran lämna uppgifter om en arbetssökandes ansökan, antagning, deltagande i studier, studiernas tid och omfattning, intyg och studieomdöme från studierna till Arbetsförmedlingen, om uppgiften behövs för att Arbetsförmedlingen ska kunna utföra sina uppgifter i den arbetsmarknadspolitiska verksamheten.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a4.7",
      "sentiment": 1.0,
      "quote": "Funktionsrätt Sverige tillstyrker utredningens förslag som innebär att ett kreditinstitut på begäran ska lämna uppgifter till\n\nArbetsförmedlingen om en arbetsgivares förhållande till institutet, om uppgifterna behövs för att kontrollera om lön har betalats ut till den som har eller har haft en anställning med ekonomiskt stöd beslutat av Arbetsförmedlingen och i så fall med vilket belopp.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a4.8.1",
      "sentiment": 1.0,
      "quote": "för att Samhall ska kunna fullgöra sin uppgift att producera efterfrågade varor och tjänster och genom detta skapa meningsfulla och utvecklande arbeten åt personer med funktionsnedsättning som medför nedsatt arbetsförmåga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.8.2",
      "sentiment": 1.0,
      "quote": "Vi kan inte nog betona vikten av att funktionsnedsättningens konsekvenser i förhållande till arbete liksom anpassningsbehov är väl kända för att skapa de bästa förutsättningarna för snabbt stöd för individen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.8.3",
      "sentiment": 1.0,
      "quote": "Eftersom den sekretessbrytande bestämmelsen som föreslås möjliggör utlämnande av känsliga uppgifter, är det viktigt att den enskildes integritet skyddas genom en utökad tystnadsplikt hos Samhall.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.8.6",
      "sentiment": 1.0,
      "quote": "För våra medlemsgrupper är det högst angeläget att Samhall och Arbetsförmedlingen förbättrar sin samverkan och skapar en större samsyn om vilka uppgifter som behöver utbytas för bättre samarbete, kvalitet och snabbare handläggning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.10.2",
      "sentiment": 1.0,
      "quote": "Information om hälsa och eventuell funktionsnedsättning och dess påverkan på arbetsförmåga är viktig information som socialtjänsten behöver känna till för att på ett individanpassat sätt kunna utforma insatser som fungerar för individen och på ett bra sätt i övrigt stödja individen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.11",
      "sentiment": 1.0,
      "quote": "bollas personer med funktionsnedsättning mellan olika myndighetsanställda och de tvingas upprepa samma information vilket varken är effektivt eller förtroendeingivande och i många fall är det mycket krävande för individen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5",
      "sentiment": 1.0,
      "quote": "för att kontrollera om förutsättningarna för stöd är uppfyllda och att verksamheten håller hög kvalitet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.8.2",
      "sentiment": 1.0,
      "quote": "Det är en brist att sådana inte i tillräcklig grad görs idag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.9.3",
