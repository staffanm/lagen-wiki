  "segments": [
    {
      "forarbete_id": "a4",
      "sentiment": 0.8,
      "quote": "Ett förbättrat informationsutbyte mellan myndigheter och andra aktörer är en välkommen och nödvändig åtgärd för att stärka arbetsmarknadens funktion och motverka arbetslivskriminalitet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5",
      "sentiment": -0.5,
      "quote": "Det nuvarande förslaget är otydligt på den punkten på vad gäller kontrollbesöken och vad som får inhämtas och det riskerar att i kombination med den administrativa bördan att avskräcka mindre företag från att anställa personer med stöd, vilket i sin tur vore olyckligt med tanke på syftet med arbetsmarknadspolitiken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.9.6",
      "sentiment": -0.5,
      "quote": "Förslaget om oannonserade kontrollbesök ställer orimliga krav på mindre företag.",
      "quote_type": "grund"
