  "segments": [
    {
      "forarbete_id": "a6",
      "sentiment": 1.0,
      "quote": "Verahill instämmer i utredarens bedömning avseende att barnets behov av att föräldrarna fattar genomtänkta beslut i separationen väger tyngre än intresset för parterna att få dom på äktenskapsskillnad innan föregående betänketid.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.7.2",
      "sentiment": -0.5,
      "quote": "En tioårig tidsram tillåter en part att vidmakthålla kontroll och avsiktligt förlänga konﬂikten genom hotet om en framtida bodelning.",
