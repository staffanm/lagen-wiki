    },
    {
      "forarbete_id": "a8.6",
      "sentiment": 0.5,
      "quote": "Det är nödvändigt att förrättaren utrustas med verktyg som effektivt kan motverka parter som avsiktligt förhalar processen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.1",
      "sentiment": 0.5,
      "quote": "Verahill välkomnar en förändring i bodelningsreglerna och ﬁnansiering av bodelningsförrättarens kostnader, för att med detta motverka ekonomiskt våld och inlåsningseffekter för den ekonomiskt svagare parten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.3.1",
      "sentiment": 1.0,
      "quote": "Verahill välkomnar förslaget att bodelningsförrättaren ska kunna fatta ett mellanbeslut över en av ﬂera omständigheter som är av omedelbar betydelse för bodelningen eller över hur en viss uppkommen fråga ska bedömas.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a10.3.3",
      "sentiment": -1.0,
      "quote": "Om förrättaren nekar direkt klander i en central fråga riskerar hela processen att genomföras utifrån en felaktig premiss.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3.1",
      "sentiment": 0.2,
      "quote": "en begränsning i möjligheten att föra särskild talan i domstol minskar risken att en sådan talan används illojalt av en part att i syfte att fördröja och fördyra bodelningsprocessen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.8.1",
      "sentiment": 0.5,
      "quote": "En tidsgräns skulle dessutom ge bodelningsförrättaren ett incitament att handlägga bodelningen effektivt och utan onödigt dröjsmål, samt att förrättaren kan kräva att makarna deltar aktivt utan att förhala eller hindra bodelningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.7.1",
      "sentiment": 1.0,
      "quote": "Att möjliggöra verkställande av bodelningsbeslut utan föregående fastställelsetalan motverkar utdragna processer med ökad risk för ekonomiskt våld och en segmenterad tvist mellan parterna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.5.1",
      "sentiment": 0.5,
      "quote": "Genom att införa en rätt till anslutningsklander minskar osäkerheten för parterna under den ordinarie klanderfristen.",
      "quote_type": "grund"
