  "segments": [
    {
      "forarbete_id": "a6.5",
      "sentiment": 1.0,
      "quote": "Detta innebär en ökad frihet och stärkta möjligheter för de kvinnor som befinner sig i destruktiva och våldsamma äktenskap, där hon nu kan begära skilsmässa omedelbart.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6",
      "sentiment": -1.0,
      "quote": "Förslaget innebär att betänketiden finns kvar i vissa fall och utgör därmed ett hinder för alla kvinnor med barn i Sverige som vill skilja sig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.9",
      "sentiment": 1.0,
      "quote": "Det skulle vara svårt att tillämpa ett sådant undantag i praktiken, då det förutsätter särskilda bedömningar av om våld förekommit, som exempelvis ekonomiskt eller psykiskt våld.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.6.8",
      "sentiment": 1.0,
      "quote": "Dessa kan tillsammans minska risken för att ena maken förhalar och minska kostnaderna för en utsatt och ekonomiskt svagare part, oftast en kvinna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.6.11",
      "sentiment": 1.0,
      "quote": "Dessa kan tillsammans minska risken för att ena maken förhalar och minska kostnaderna för en utsatt och ekonomiskt svagare part, oftast en kvinna.",
      "quote_type": "grund"
    },
    {
