  "segments": [
    {
      "forarbete_id": "a8.6.9",
      "sentiment": 0.2,
      "quote": "I den fortsatta beredningen får gärna uppmärksammas hur uppgifter som omfattas av s.k. skattesekretess kan komma att hanteras i allmän domstol och under vilka omständigheter uppgifterna kan omfattas av sekretess där.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.7.1",
      "sentiment": 0.2,
      "quote": "Att sådana beslut är korrekt utformade är en förutsättning för en effektiv utsökningsprocess.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.7.5",
      "sentiment": -0.2,
      "quote": "Det innebär att utmätning kan komma ske innan gäldenären haft möjlighet att klaga på den exekutionstitel som ligger till grund för verkställighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.5.1",
      "sentiment": -0.5,
      "quote": "För att minimera risken för parallella processer, eller att prövning som bäst sker i klanderprocessen förskjuts till utsökningsprocessen, borde domstolen kunna göra detsamma i mål gällande klander av bodelning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.13",
      "sentiment": 1.0,
      "quote": "Tingsrätten tillstyrker förslaget om att en särskild uppföljning av förslaget om att vissa beslut av bodelningsförrättare ska kunna verkställas sker två till tre år efter ikraftträdandet.",
