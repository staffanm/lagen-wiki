  "segments": [
    {
      "forarbete_id": "a6.3",
      "sentiment": -0.5,
      "quote": "Ett omedelbart avskaffande av betänketiden i de fall där endast en make önskar erhålla äktenskapsskillnad skulle därför enligt Advokatsamfundets uppfattning riskera att försämra skyddet för den ekonomiskt svagare maken, särskilt i relationer där det råder ekonomisk obalans.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec5",
      "sentiment": 0.2,
      "quote": "Det finns en risk att ökad reglering leder till tyngre administration för bodelningsförrättare och i vissa fall till mer komplexitet, snarare än till den effektivitet som eftersträvas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.7.2",
      "sentiment": 1.0,
      "quote": "Förslaget att införa en tioårig tidsfrist för att begära bodelning skapar ökad förutsebarhet och rättssäkerhet för makarna efter en skilsmässa.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.6",
      "sentiment": 0.2,
      "quote": "Flera av förslagen tenderar att bli väl detaljstyrda, vilket riskerar att försvåra uppdraget för bodelningsförrättarna i praktiken och samtidigt äventyra den opartiska roll som är central för funktionen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec295",
      "sentiment": 1.0,
      "quote": "Det skyddar vidare den part som aktivt försöker få till stånd en bodelning och säkerställer att processen inte kan blockeras genom strategisk inaktivitet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.3.1",
      "sentiment": 1.0,
      "quote": "Detta är ett viktigt steg för att skapa tydlighet i handläggningen och ge parterna ett klart besked i prejudiciella frågor, som i praktiken ofta är avgörande för bodelningens fortsatta handläggning.",
