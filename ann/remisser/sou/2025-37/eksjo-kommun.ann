    },
    {
      "forarbete_id": "sec16",
      "sentiment": 0.2,
      "quote": "Det som dock kan resoneras kring är om de omständigheter som anges verkligen är heltäckande eller om det bör införas fler omständigheter för att kunna återkräva kommunala bidrag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec17",
