    },
    {
      "forarbete_id": "a5.7.1",
      "sentiment": 1.0,
      "quote": "Malmö stad ser detta som ett lämpligt verktyg för att säkerställa att resurser används på ett sätt som kommer barnen i verksamheten till godo.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.7.2",
      "sentiment": 1.0,
      "quote": "Malmö stad instämmer i utredningens förslag.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a5.7.3",
      "sentiment": 1.0,
      "quote": "det är viktigt att försäkra sig om att ett värdeöverföringsförbud inte kan kringgås.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.7.4",
      "sentiment": 0.2,
      "quote": "I och med det så finns det risk för att endast en temporär förbättring av de fristående skolenheternas ekonomi uppnås.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.7.5",
      "sentiment": 1.0,
      "quote": "Det bedöms att detta är en nödvändig förutsättning för att genomföra och följa upp flera av de övriga föreslagna förändringarna, särskilt de som rör ekonomisk redovisning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.7.6",
      "sentiment": 1.0,
      "quote": "En särredovisning per enhet kommer att underlätta den ekonomiska granskningen inom ramen för tillsynsuppdraget.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.7.7",
      "sentiment": 1.0,
      "quote": "En enhetlig redovisningspraxis ökar jämförbarheten och förenklar tillsynsarbetet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.7.8",
      "sentiment": 1.0,
      "quote": "Förslaget stärker tillförlitligheten i de ekonomiska underlagen för enskilda huvudmän.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.7.9",
      "sentiment": 0.5,
      "quote": "förslaget innebär en ambitionshöjning som kommer att kräva anpassning i arbetsprocesserna, samt medföra ett ökat resursbehov för kommunen.",
      "quote_type": "grund"
    },
    {
