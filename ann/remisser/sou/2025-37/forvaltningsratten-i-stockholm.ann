  "overall": {
    "sentiment": 0.2,
    "quote": "Förvaltningsrätten anser att betänkandet framstår som väl genomarbetat.",
    "quote_type": "standpunkt"
  },
  "segments": [
    {
      "forarbete_id": "a5.7.4",
      "sentiment": -0.2,
      "quote": "Ett sådant särskilt beslut kan framstå som överflödigt, eftersom ett förbud alltid ska meddelas när ett tillstånd att starta en ny verksamhet ges.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec395",
      "sentiment": -0.5,
      "quote": "Förvaltningsrätten anser att ett sådant undantag från tillämpningen av 26 kap. 12 § skollagen bör framgå av författningstexten och inte enbart av författningskommentaren.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5.2",
      "sentiment": -0.2,
      "quote": "Förvaltningsrätten anser att den föreslagna lydelsen är något otydlig och att formuleringen ”använts i brott” kan tolkas så att det ska vara fråga om att bidraget finansierat brottslig verksamhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5.4",
      "sentiment": -0.2,
      "quote": "Förvaltningsrätten anser att detta bör förtydligas redan i lagtext.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec583",
      "sentiment": -0.5,
      "quote": "Förvaltningsrätten ser en risk att utredningen har underskattat den kommande arbetsbördan och kostnaderna till följd av förslagen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.7.5",
      "sentiment": 0.0,
      "quote": "Detta bör avse allvarlig sjukdom hos företrädare för huvudmannen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.2",
      "sentiment": -0.2,
      "quote": "Det kan ifrågasättas om inte begreppen är för lika för att rymma två så pass skilda tidsspann.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec49",
      "sentiment": -0.2,
      "quote": "Rubriken före föreslagna 2 a kap. 25 § skollagen – Årsredovisning och årsbokslut – framstår som alltför vid i sin innebörd, eftersom den följande bestämmelsen enbart avser verksamhet som bedrivs i kommission.",
      "quote_type": "grund"
    }
  ]
}