  "segments": [
    {
      "forarbete_id": "a5.7.2",
      "sentiment": 0.2,
      "quote": "Föreslagna begränsningar av värdeöverföringar bedöms ha begränsad påverkan på etablerade koncerner.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.7.4",
      "sentiment": -0.2,
      "quote": "Eftersom det inte framgår tydligt i utredningen vilka situationer som ska anses innebära en sådan etablering, riskerar det att leda till olika tolkningar i tillämpningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.7.5",
      "sentiment": -0.2,
      "quote": "eftersom den som driver fristående pedagogisk omsorg räknas som en enskild huvudman finns det behov av att tydliggöra vilka verksamhetsformer som den föreslagna lagförändringen avser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.7.11",
      "sentiment": 0.2,
      "quote": "Då tillkommande uppgifter åläggs kommunerna i egenskap av tillsynsmyndighet önskar Göteborgs Stad betona vikten av att kommunerna, i enlighet med den kommunala finansieringsprincipen, kompenseras för ökade kostnader.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.1",
      "sentiment": 0.5,
      "quote": "Ett sådant förtydligande skulle kunna bidra till ökad rättssäkerhet och likvärdighet i tillämpningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.2",
      "sentiment": 0.5,
      "quote": "Sammantaget bedömer Göteborgs Stad att förslagen om skärpta krav på ekonomisk stabilitet och långsiktighet är positiva.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.6.4",
      "sentiment": 0.0,
      "quote": "Tidigare erfarenhet visar att vid planerade omstruktureringar av skolenheter får lägeskommunen i regel löpande och tidig information.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5.1",
      "sentiment": 0.2,
      "quote": "Staden ser att det finns risker kring en ökad administration innan digitalt verksamhetshetsstöd och rättspraxis hunnit utvecklats.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5.2",
      "sentiment": 0.5,
      "quote": "Innan det finns en lagakraftvunnen dom kan lång tid ha förflutit och därmed har kommunala bidrag till omfattande värden betalats ut.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5.3",
      "sentiment": -0.2,
      "quote": "I fall som dessa kan det krävas ett omfattande utredningsarbete och det kan vara svårt för kommunen att styrka hur länge eleven varit frånvarande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5.4",
      "sentiment": 0.5,
      "quote": "Innan rättspraxis och rutiner inom området utvecklats kan det uppstå diskussioner eller tvister mellan hemkommun och enskild huvudman om hur ett eventuellt överskott av grundbeloppet uppstått och om det då är föremål för återbetalning eller ej.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5.8",
      "sentiment": 0.5,
      "quote": "vid en eventuell tvist skulle den administrativa pålagan hos berörda parter bli omfattande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2.3",
      "sentiment": -0.2,
      "quote": "Eftersom endast skolenhet står framskrivet finns det utrymme att tolka skrivningen som ett verktyg som endast Skolinspektionen kan tillämpa.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.3.3",
      "sentiment": -0.2,
      "quote": "Hur den konkreta hanteringen av detta förslag skulle gå till blir därför mycket oklart.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.5",
      "sentiment": 0.0,
      "quote": "Principen om barnets bästa kan i vissa fall innebära att elevsamtal inte ska genomföras alls.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14",
      "sentiment": 0.5,
      "quote": "Det är viktigt att regelverket ger utrymme för sådana situationer utan att det automatiskt utlöser krav på ett nytt godkännande, förutsatt att kvalitet och säkerhet kan upprätthållas.",
      "quote_type": "grund"
    }
