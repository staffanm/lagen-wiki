  "overall": {
    "sentiment": 0.5,
    "quote": "Skolinspektionen konstaterar att utredningens förslag innebär såväl nya som skarpare verktyg, och därmed förbättrade förutsättningar att uppmärksamma enskilda huvudmän som inte lyckas fullgöra sitt uppdrag.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a3.3",
      "sentiment": -0.2,
      "quote": "Att använda myndighetens förelägganden som ensamt mått på förskolors och skolors kvalitet påverkar således möjligheten att identifiera de verksamheter där det enligt utredningsdirektivens utgångspunkter bedömts finnas skäl att begränsa möjligheten till vinstuttag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.7.1",
      "sentiment": 0.5,
      "quote": "Ett system med värdeöverföringsförbud kan enligt Skolinspektionen ytterligare tydliggöra huvudmännens ansvar att i sin verksamhet ha sådana resurser att brister inte uppkommer, och även bidra till att tillgängliga resurser vid behov används för att åtgärda uppkomna brister.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.7.2",
