  "segments": [
    {
      "forarbete_id": "sec11",
      "sentiment": 1.0,
      "quote": "Anser att förslaget är bra då det främjar långsiktighet, som i sin tur är bra för elever och samhället.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec10",
      "sentiment": 1.0,
      "quote": "Anser att förslaget är bra då det ökar transparensen i hur offentliga medel används i den fristående sektorn.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec12",
      "sentiment": 0.5,
      "quote": "fristående enheter med kvalitetsbrister ska rimligtvis inte kunna föra ut kapital från bolaget.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec13",
      "sentiment": 1.0,
      "quote": "Redan idag finns vissa oklarheter över vilka ekonomiska förutsättningar som ska krävas för den fristående verksamheten, exempelvis vilken soliditetsmått eller annat resultatmått som är tillräcklig för att inte kommunen ska göra en anmärkning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec14",
      "sentiment": 0.2,
      "quote": "Att koppla olika tidsaspekter kring krav skapar också mer administration och kontroll.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec16",
      "sentiment": 0.5,
      "quote": "En återbetalning av medel som använts vid brott eller om friskolan inte fullföljt sina åtaganden kring tilläggsbeloppet torde vara en självklarhet.",
