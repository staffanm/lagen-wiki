    },
    {
      "forarbete_id": "sec17",
      "sentiment": 0.5,
      "quote": "Anser att sanktionsavgifter är bra eftersom det skapar incitament för fristående enheter att rapportera in i tid och bättre följa regelverken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec18",
      "sentiment": 1.0,
      "quote": "Att villkora vissa statsbidrag och koppla dessa till värdeöverföring är fullt rimligt, exempelvis riktade statsbidrag som avsändaren menar ska användas till att förbättra verksamheten eller åtgärda kvalitetsbrister.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec19",
      "sentiment": 1.0,
      "quote": "alla skolenheter som inte kan erbjuda eleven, oavsett huvudman, den lagliga rätt till en likvärdig kvalitativ skolgång måste omedelbart åtgärda brister eller i värsta fall stängas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec20",
