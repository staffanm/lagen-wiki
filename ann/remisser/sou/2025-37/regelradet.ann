    {
      "forarbete_id": "a17",
      "sentiment": -0.5,
      "quote": "Mot bakgrund av de omfattande konsekvenser som vissa av utredningens förslag kommer att få för delar av friskolesektorn är denna avsaknad av konkretion, enligt Regelrådets uppfattning, en uppenbar brist.",
      "quote_type": "grund"
