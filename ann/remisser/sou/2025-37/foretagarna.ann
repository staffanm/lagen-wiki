  "segments": [
    {
      "forarbete_id": "sec11",
      "sentiment": -0.8,
      "quote": "Ett femårigt förbud mot vinstuttag vid övertagande eller nyetablering av friskolor kan minska intresset för privata investeringar och etablering, försvåra kapitalanskaffning som är ytterst nödvändig vid nyetablering och påverka skolöverlåtelser negativt, exempelvis vid generationsskiften.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec13",
      "sentiment": -0.5,
      "quote": "de föreslagna kraven på stärkt ekonomi och omfattande ekonomisk redovisning, särredovisning och revisorsgranskning kan vara oproportionerligt betungande för små enskilda huvudmän.",
