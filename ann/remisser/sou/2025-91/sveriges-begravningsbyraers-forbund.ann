  "segments": [
    {
      "forarbete_id": "sec7",
      "sentiment": 0.5,
      "quote": "Det förslag till lagändring som utredningen presenterar anser vi stämmer överens med lösningar vi idag önskar fanns att tillgå.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec14",
      "sentiment": 0.5,
      "quote": "Sverige befinner sig i ett samhälle där digital kommunikation är en naturlig del av vardagen, och det är därför rimligt att lagstiftningen anpassas till hur människor faktiskt uttrycker sin vilja i dag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec493",
      "sentiment": -0.2,
      "quote": "Digitala uttryck kan vara svårare att autentisera, särskilt i ljuset av Al-teknikens snabba utveckling där bild, ljud och video med förhållandevis enkla insatser kan manipuleras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec494",
      "sentiment": 0.5,
      "quote": "SBF bedömer att de föreslagna tidsfristerna är rimliga och bidrar till att skapa ordning och förutsebarhet i processen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec496",
      "sentiment": 0.5,
      "quote": "Detta speglar dagens informationshantering och ökar flexibiliteten utan att tumma på rättssäkerheten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec497",
      "sentiment": -0.5,
      "quote": "kommer med största sannolikhet medföra att den praktiska hanteringen av ett dödsbo och dess avveckling försvåras och försenas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec486",
      "sentiment": 0.5,
      "quote": "Ett formkrav som inte uppfylls pga okunskap hos testatorn vid upprättandet skulle kunna leda till att i grunden giltiga testamenten underkänns, vilket vore negativt för rättssäkerheten och för den enskildes yttersta vilja.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec12",
      "sentiment": 0.5,
      "quote": "Digital signering och e-legitimation används redan i många myndighetsprocesser, och både teknisk utveckling och samhällsutveckling talar för att även arvsrätten behöver moderniseras i denna del.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.7.2",
      "sentiment": -0.2,
      "quote": "Viktig är därför att de tjänster som tas fram av myndighet enbart är för digital signering och inte några ”mallar” eller hjälpmedel för upprättande av testamente —- eftersom det riskerar att bli vilseledande för testator och otroligt krävande för myndigheten kring rådgivning för de som använder tjänsten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec11",
      "sentiment": -0.5,
      "quote": "Vi har en oro kring att den föreslagna regleringen i realiteten kommer att inskränka formlösheten kring återkallandet och att det därmed finns en risk att testators sista vilja inte beaktas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.6.3",
      "sentiment": -0.2,
      "quote": "Det är olämpligt om Skatteverket hamnar i juridisk rådgivning kring testamenten något som är särskilt olämpligt då Skatteverket som myndighet även registrerar bouppteckningar.",
      "quote_type": "grund"
    }
  ]
