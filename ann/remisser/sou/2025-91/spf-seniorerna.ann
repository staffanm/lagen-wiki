    {
      "forarbete_id": "a7.3.4",
      "sentiment": 1.0,
      "quote": "Det är rimligt att en arvlåtare ska kunna begränsa laglotten även för den som har begått brott som inneburit en allvarlig kränkning av arvlåtarens närmaste anhöriga.",
      "quote_type": "grund"
