  "overall": {
    "sentiment": 0.0,
    "quote": "FSÖ vill inledningsvis framhålla att det som framkommer i SOU 2025:91 om att förslaget inte kommer att medföra några ekonomiska konsekvenser för kommuner är felaktigt.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "sec7",
      "sentiment": 1.0,
      "quote": "FSÖ har inga synpunkter på att skydd för sambo förstärks genom att den enskilde genom testamente ska kunna förorda att sambo ärver före gemensamma barn som då blir efterarvingar.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.3.1",
      "sentiment": 0.5,
      "quote": "Den som förlorat sin rätt till laglott ska likt 15 kap. 4 § ÄB behandlas som avliden före arvlåtaren med följden att dennes barn har rätt till laglott i sin förälders ställe.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1",
      "sentiment": 1.0,
      "quote": "FSÖ har inga synpunkter på de föreslagna förändringarna i basbeloppsreglerna.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a19",
      "sentiment": -0.2,
      "quote": "FSÖ är av uppfattningen att god man enlig 11 kap. 2 § föräldrabalken samt även framtidsfullmaktshavare ska vara behörig att ansöka om boutredningsman.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19",
      "sentiment": -0.2,
      "quote": "FSÖ vill framföra att skyldighet att redovisning ska skickas till överförmyndaren enl. 19:14 a § ÄB, även bör gälla om delägare företräds av god man enl. 11 kap. 4 § föräldrabalken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9",
      "sentiment": 0.5,
      "quote": "För att kunna fatta beslut, behöver överförmyndaren kunna säkerställa att en person som har god man/förvaltare, eller en omyndig som har del i dödsbo får det som hen har rätt till.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a15.4",
      "sentiment": -0.5,
      "quote": "Överförmyndarna kommer att behöva göra större, svårare och mer omfattande utredningar vilket kommer att bli kostsamt för kommunerna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec6",
      "sentiment": -0.5,
      "quote": "Om arvsrätten utökas till att omfatta kusiner, kommer landets socialnämnder att behöva göra större, mer omfattande och mer tidskrävande utredningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8",
      "sentiment": -0.2,
      "quote": "Det finns en beaktansvärd risk att det, vid den överlevande sambons bortgång, inte finns något arv kvar och att arvinge som avstått från arv med överförmyndarens samtycke då blir utan det arv som denne haft rätt till.",
      "quote_type": "grund"
    }
  ]
}