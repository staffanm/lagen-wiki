  "overall": {
    "sentiment": 0.2,
    "quote": "Fakultetsnämnden välkomnar det relativt breda utredningsuppdraget men hade gärna sett att det gjorts ännu bredare och att det tillsatts en utredning med uppdraget att arbeta fram en helt ny ärvdabalk.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a4.4.1",
      "sentiment": 1.0,
      "quote": "Enligt fakultetsnämndens mening har argumenten från 1928 i dag ännu högre bärkraft eftersom det inte finns något som tyder på att den sociala kontakten mellan kusiner ökat de senaste 100 åren.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.3",
      "sentiment": 0.5,
      "quote": "Förslagen är rimliga utifrån de begränsningar som fanns i utredningens uppdrag, nämligen att överväga ett stärkt skydd för efterlevande sambo men inte att lägga fram förslag om arvsrätt i större eller mindre omfattning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.3",
      "sentiment": -0.5,
      "quote": "Det är inte oproblematiskt att knyta förlusten av rätt till laglott till en lagakraftvunnen dom.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9",
      "sentiment": 1.0,
      "quote": "Utredningens förslag framstår på det hela som väl avvägt och bestämmelserna om underrättelse och den föreslagna presumtionsregeln bör åstadkomma syftet att medvetandegöra berörda personer om att det finns ett testamente och var detta bör återfinnas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10",
      "sentiment": -1.0,
      "quote": "Risken är att man inför ett komplicerat system som särskilt äldre testatorer kan ha svårt att förstå och hantera – och testatorer tenderar att vara just äldre.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1",
      "sentiment": 0.2,
      "quote": "Om man ska ha kvar basbeloppsregeln är de föreslagna ändringarna rimliga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": 0.5,
      "quote": "Fakultetsnämnden kan med undantag för den del som avser värdetidpunkt bara hoppas att regeringen den här gången går vidare med utredningens förslag, som innebär välkomna förtydliganden och att regeln såvitt avser återbäring av gåva överhuvudtaget blir praktiskt tillämpbar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": 1.0,
      "quote": "Utredningens förslag är ett välkommet förtydligande, men det hade också varit välkommet om rättstillämparen inte hade varit tvungen att gå till den juridiska litteraturen (eller utredningsbetänkanden) för att förstå skillnaden mellan arvsavsägelse, arvsavstående och särkullbarns uppskjutande av arv från först avlidne maken (och, som utredningen föreslår, en möjlighet för barn till sambor att göra detsamma, se ovan avsnitt 3.3).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12",
      "sentiment": -1.0,
      "quote": "Fakultetsnämnden menar att rättsosäkerheten blir alldeles för stor och att de få fall där den avlidnes sista vilja med nuvarande regler inte kan få genomslag inte motiverar de möjligheter till missbruk som öppnar sig.",
      "quote_type": "grund"
    }
