  "segments": [
    {
      "forarbete_id": "a4.4.1",
      "sentiment": 1.0,
      "quote": "Utredningen visar att det saknas tillräckligt stöd för antagandet att arvlåtares förmodade vilja typiskt sett är att kusiner ska ärva framför att kvarlåtenskapen tillfaller Allmänna arvsfonden.",
