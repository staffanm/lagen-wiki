  "overall": {
    "sentiment": 0.5,
    "quote": "Härjedalens kommun har främst besvarat denna remiss utifrån vår verksamhet överförmyndarnämnden och hur det som kommit fram i utredningen kan antas påverka våra huvudmän och ställföreträdare.",
    "quote_type": "standpunkt"
  },
  "segments": [
    {
      "forarbete_id": "a4.4.1",
      "sentiment": 1.0,
      "quote": "Vi anser att det tar för mycket både ekonomiskt och tidsmässigt i förhållande till vad det skulle ge för positiva effekter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.3.1",
      "sentiment": 0.0,
      "quote": "Det är i vår uppfattning otidsenligt att barnbarn, barnbarnsbarn ska förlora rätten till arv för att en förälder begått ett brott mot arvlåtaren eller närstående till arvlåtaren.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.3.1",
      "sentiment": 0.5,
      "quote": "Vi vidhåller med utredningen om att skyddet för efterlevande sambo bör stärkas både för att skydda den aktuella individen, och framför allt eventuella minderåriga barn om efterlevande sambo ärver den del som annars gått till barnen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec377",
      "sentiment": 1.0,
      "quote": "Detta för att göra det mer klart och tydligt, och för att underlätta i processen kring bouppteckning och bodelning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec11",
      "sentiment": 0.2,
      "quote": "Den enda invändning vi har är att det fortsatt bör kunna finnas alternativ för personer som inte är digitala, och att de alternativen ska vara lika giltiga som digitala testamentregister i offentlig regi.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec12",
      "sentiment": 0.5,
      "quote": "Vi anser att i ett modernt samhälle där det mesta fungerar att göra digitalt även bör innefatta att kunna upprätta ett testamente digitalt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec13",
      "sentiment": 0.5,
      "quote": "Tillförlitligheten i att det är testator som skrivit testamentet kan faktiskt öka, under förutsättning att testamentet måste bevittnas med digital underskrift i samband med att testator skriver under.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec14",
      "sentiment": 0.2,
      "quote": "Det finns dock farhågor vad gäller möjligheterna att skapa fabricerade nödtestamenten som inte kommer gå att särskilja från ett äkta.",
      "quote_type": "grund"
    }
  ]
}