  "overall": {
    "sentiment": 0.2,
    "quote": "Stadsledningskontoret ställer sig i huvudsak positiv till de förslag som framförs i utredningen, men vill dock klargöra att utredningens förslag är kostnadsdrivande för kommunerna i form av personal- och utredningskostnader.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a4.4.1",
      "sentiment": 1.0,
      "quote": "Kusinarv kommer sannolikt att medföra en ökad efterfrågan av godmanskap enligt 11 kap. 3 § föräldrabalken, godmanskap för bortavarande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.3.1",
      "sentiment": 0.5,
      "quote": "Att barn till sambor i denna del likställs med barn till makar både vad avser gemensamma och särkullbarn förstärker skyddet för efterlevande sambo och medför att bedömningen ur ett barnrättsperspektiv till viss del förändras genom att större hänsyn tas till sambos skydd i synnerhet vid avvägning när samtycke till avstående krävs.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6",
      "sentiment": 0.2,
      "quote": "Stadsledningskontoret tillstyrker förslagen, men vill påtala vikten av att uppgifterna som beaktas vid beräkning av basbeloppsregeln och efterarvsrätt tillgängliggörs på ett sätt som gör det möjligt att utöva överförmyndarens tillsynsansvar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.3.1",
      "sentiment": 0.2,
      "quote": "Stadsledningskontoret anser därför att det vore önskvärt med ett tydligt ställningstagande om vad som gäller för personer som utsatts för likvärdig brottslighet men som redan innan brottet saknade rättshandlingsförmåga att upprätta testamente som begränsar gärningsmannens laglottsanspråk.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8",
      "sentiment": 1.0,
      "quote": "Stadsledningskontoret emotser förslaget att arvsavstående ska antecknas i bouppteckningen då det medför tydlighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9",
      "sentiment": 0.5,
      "quote": "Detta förutsätter dock att kommunerna får tillgång till registret vilket inte föreslås i betänkandet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10",
      "sentiment": 1.0,
      "quote": "Förvaltningens uppfattning är att det går i linje med samhällets utveckling att möjliggöra digital signering.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11",
      "sentiment": 1.0,
      "quote": "Det kräver dock att testamentsvittnen kan höras och det är därför av stor vikt att de kan identifieras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13-2",
      "sentiment": -0.2,
      "quote": "Stadsledningskontoret anser att den språkliga ändring som föreslås i Ärvdabalken 20 kap 2 § felaktigt kan tolkas som att socialnämnder är skyldiga att se till att bouppteckningar förrättas och delges Skatteverket.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a15.2.2",
      "sentiment": -0.5,
