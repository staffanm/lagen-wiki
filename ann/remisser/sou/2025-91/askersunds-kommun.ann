  "segments": [
    {
      "forarbete_id": "sec10",
      "sentiment": 0.2,
      "quote": "Om utredningens förslag genomförs vill nämnden uppmärksamma att författningskommentar till 15 kap. 6 § saknas och bör läggas till.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec6",
      "sentiment": 0.2,
      "quote": "Det medför behov av ökade resurser hos landets överförmyndarverksamheter och ökade kostnader för kommunerna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec11",
      "sentiment": 0.5,
      "quote": "bedömer att registret bör vara frivilligt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19",
      "sentiment": -0.2,
      "quote": "Behörigheten att ansöka om boutredningsman i 19 kap. 1 § Ärvdabalken bör även omfatta god man enligt 11 kap. 2 § Föräldrabalken och framtidsfullmaktshavare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.3.3",
      "sentiment": 0.2,
      "quote": "nämnden bedömer att istadarätten ska gälla vid tillämpningen av nya 7 kap. 3 a § Ärvdabalken.",
      "quote_type": "grund"
