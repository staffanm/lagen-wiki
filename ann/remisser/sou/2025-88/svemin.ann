  "segments": [
    {
      "forarbete_id": "sec12",
      "sentiment": 0.8,
      "quote": "Eftersom hushållningsbestämmelserna i nuläget ligger i miljöbalken kan det antas att bevarandeintressen har fått större tyngd än vad som ursprungligen varit syftet när bestämmelserna fanns i naturresurslagen, vilket innebär att andra intressen har försvagats såsom vikten av ökad självförsörjning och beredskap, samt industrins möjlighet att bidra till klimatomställningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec14",
      "sentiment": 0.8,
      "quote": "Det framstår därför som principiellt rätt att det går att begära ett besked av en politiskt vald församling i frågan om markanvändning i stället för att frågan prövas i domstol.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5.2",
      "sentiment": 0.8,
      "quote": "Tillåtlighetsprövning enligt 17 kap. miljöbalken sker sent i processen och det finns därför en påtaglig risk att en tillåtlighetsprövning hos regeringen leder till att tillståndsprocessen förlängs.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec39",
      "sentiment": -0.5,
      "quote": "Att områdesanvändningsbesked enbart föreslås vara giltigt i fem år, innan en ansökan om miljöprövning måste ha gjorts, är med detta i åtanke en alltför kort tid.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec332",
      "sentiment": 0.8,
      "quote": "När det behövs är det lämpligare att göra en sådan prövning senare i samband med tillståndsprövningen av den specifika verksamheten eftersom verksamhetsutövaren då har mer detaljerad information om hur verksamheten ska utformas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.1",
      "sentiment": -0.2,
      "quote": "Det är viktigt att ordalydelsen i den nya lagen om hushållning med mark- och vattenområden anpassas till ändringarna som föreslås i prop. 2024/25:203 Förbudet mot utvinning av uran tas bort, då det i denna proposition föreslås att det görs ändringar i nuvarande 17 kap. 1 § miljöbalken.",
      "quote_type": "grund"
    }
  ]
