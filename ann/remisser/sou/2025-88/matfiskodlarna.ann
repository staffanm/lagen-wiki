  "segments": [
    {
      "forarbete_id": "sec25",
      "sentiment": 0.2,
      "quote": "Matfiskodlarna anser att det kan behöva förtydligas att aspekterna ekologisk, social, kulturell och samhällsekonomisk ska väga lika tungt vid en samlad bedömning av god hushållning av mark- och vattenområden för att tillgodose samhällets behov och utveckling.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec26",
      "sentiment": -0.2,
      "quote": "När vi använder oss av begrepp som är otydliga och öppnar upp för tolkning skapar vi processer som riskerar att ta lång tid, upplevs rättsosäkra, skapar osäkerhet kring vilket bedömningsunderlag som krävs för att avgöra om området är ”stort” och ”särskilt känsligt” med mera.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec26",
      "sentiment": 1.0,
      "quote": "Detta är principiellt viktigt och välkommet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec27",
      "sentiment": -0.5,
      "quote": "Konsekvensen blir att vattenbruket i praktiken saknar skydd mot åtgärder som kan försvåra näringens bedrivande när det inte är inkluderat i andra stycket.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec28",
      "sentiment": -0.2,
      "quote": "Vi anser därför att det ska utredas vidare om dessa samhällsviktiga näringar ska ges företräde, mot bakgrund av deras betydelse för livsmedelsförsörjning, beredskap och totalförsvar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.18",
      "sentiment": -0.5,
      "quote": "Avsaknaden av utpekande och därmed även ansvarig myndighet innebär i praktiken att vattenbruket ställs utanför den struktur som är avsedd att värna näringar och intressen av nationell betydelse.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec14",
      "sentiment": 0.0,
      "quote": "Matfiskodlarna anser dock att det är oklart hur processen för ansökan om områdesanvändningsbesked ska ske och vad som kommer att gälla i förhållande till bland annat miljöbalkens 2 kapitel allmänna hänsynsregler.",
      "quote_type": "grund"
