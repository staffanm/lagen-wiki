  "overall": {
    "sentiment": 0.5,
    "quote": "Havs- och vattenmyndigheten är positiv till att regeringen ges möjlighet att tidigt lämna beslut om lämplig lokalisering i förhållande till allmänna intressen inkl. riksintressen.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a7.2.1",
      "sentiment": -0.2,
      "quote": "Havs- och vattenmyndigheten är tveksam till om föreslagen lag kommer att medföra att prövningsmyndigheterna tar hänsyn till allmänna intressen som inte tidigare har beaktats i prövningen av hushållningsbestämmelserna, vilket är ett av syftena med den nya lagen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2.2",
      "sentiment": -0.5,
      "quote": "Skulle det vara så att det enbart är verksamheter inom territorialhavet som har möjlighet att få ett sådant besked skulle detta kunna leda till en otillbörlig konkurrensfördel för dessa verksamhetsutövare i förhållande till dem som vill etablera sig längre ut i havet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2.2",
      "sentiment": -0.2,
      "quote": "Havs- och vattenmyndigheten anser att det kommer att behövas mer fördjupad utredning innan det går att bedöma om den lagstiftning som krävs för nationell planering i ett bredare perspektiv är lämplig att placera i lagförslagets femte kapitel.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.3",
      "sentiment": 1.0,
      "quote": "Erfarenheter från havsplaneringen visar att enbart avvägningar mellan oförenliga riksintresseanspråk inte är tillräckligt för att vägleda om mest lämplig användning av havsområdena utan att andra allmänna intressen av väsentlig betydelse också måste beaktas och ibland även prioriteras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5.8",
      "sentiment": -0.2,
      "quote": "Detta förhållande är något som inte kan utläsas direkt av den föreslagna lagtexten utan är något som blir tydligt först vid läsning av förarbetena.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.7.3",
      "sentiment": 0.0,
      "quote": "Havs- och vattenmyndigheten vill här lyfta fram att det – om frågan om exklusivitet fortsätter utredas i särskild ordning – är viktigt att beakta hur dagens reglering i 16 kap. 11 § miljöbalken förhåller sig till en framtida prövning av exklusivitet för områdesanvändningsbesked.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.7",
      "sentiment": 1.0,
      "quote": "Havs- och vattenmyndigheten delar utredningens bedömning att en eventuell översyn av planläggning i havsplan lämpligen bör göras samordnat och samtidigt med en översyn av förutsättningarna för nationell fysisk planering på land.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6",
      "sentiment": -0.2,
      "quote": "Myndigheten ser det som angeläget att regeringen gör en samlad bedömning av de förslag som rör hantering av allmänna intressen i prövning och planläggning för att undvika en fragmenterad framtida lagstiftning.",
      "quote_type": "grund"
    }
  ]
}