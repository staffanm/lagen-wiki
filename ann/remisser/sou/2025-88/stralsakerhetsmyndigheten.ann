  "overall": {
    "sentiment": 0.2,
    "quote": "SSM anser dock att det generellt är en brist i förslaget till ny hushållningslag att det inte tydligt framgår vilken eller vilka tillståndsprocesser som åsyftas i lagförslaget.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "sec12",
      "sentiment": 1.0,
      "quote": "SSM tillstyrker delbetänkandets förslag om att flytta över hushållningsbestämmelserna från miljöbalken till den föreslagna lagen om hushållning med mark- och vattenområden (hushållningslagen).",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.5.4",
      "sentiment": -0.2,
      "quote": "förslaget till 6 kap. 1 § hushållningslagen behöver förtydligas genom att det klargörs inom vilka förfaranden och enligt vilka lagar områdesanvändningsbesked ska tillämpas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5.6",
      "sentiment": -0.2,
      "quote": "Här anser SSM att det tydligare ska framgå vilken typ av tillstånd som avses, t.ex. om det enbart är tillstånd enligt miljöbalken som avses eller om det gäller även andra typer av tillstånd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5.4",
      "sentiment": -0.2,
      "quote": "bestämmelsen i 6 kap. 2 § 1 i hushållningslagen behöver ses över för det fall lagförslaget i utkastet till lagrådsremiss genomförs om att den myndighet som regeringen bestämmer ska kunna bli beslutande instans i större utsträckning än idag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5.5",
      "sentiment": -0.5,
      "quote": "denna tidsbegränsning kan vara svår att upprätthålla för myndigheten i det fall SSM ska bidra till prövningsmyndighetens framtagande av yttrande inför regeringens prövning, då ärenden med konstruktion av kärntekniska anläggningar har en hög teknisk komplexitet och kräver ett omfattande underlag för att myndigheten ska kunna göra ett välgrundat yttrande om tillräckligheten i underlaget utifrån de aspekter myndigheten måste beakta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5.5",
      "sentiment": -0.5,
      "quote": "förfarandet inte uttryckligen anger att yttranden vid behov ska inhämtas från berörda myndigheter och föreslår att följande punkt läggs till i 9 §: 4. myndigheten inhämtar de yttranden som behövs.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.4.6",
      "sentiment": -0.2,
      "quote": "I det fall SSM ska bidra till beredande myndighets framtagande av yttrande över miljökonsekvensbeskrivningar inför regeringens beslut om områdesanvändningsbesked, kommer detta att innebära en ökad arbetsbörda för myndigheten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.8",
      "sentiment": 0.0,
      "quote": "bedömer att det inte innebär någon skillnad för tillämpningen av bestämmelsen.",
      "quote_type": "grund"
    }
  ]
