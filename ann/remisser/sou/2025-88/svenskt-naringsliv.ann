    {
      "forarbete_id": "a7.5.8",
      "sentiment": 1.0,
      "quote": "Det är nödvändigt att områdesanvändningsbeskedet, såsom föreslås, blir bindande i efterföljande prövningar i de frågor som beskedet avser.",
