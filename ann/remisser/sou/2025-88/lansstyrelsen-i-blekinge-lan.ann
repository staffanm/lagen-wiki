  "overall": {
    "sentiment": 0.0,
    "quote": "Länsstyrelsen i Blekinge län anser att det är positivt med förslaget om tidiga områdesanvändningsbesked på så sätt att syftet med förslaget är att underlätta för investeringsviljan och effektivisera förfarandet med tillståndsprocessen. Samtidigt ser länsstyrelsen att utredningen inte tydligt visar på att lagförslagen kommer att få avsedd effekt.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a1.15",
      "sentiment": -0.2,
      "quote": "Länsstyrelsen är dock tveksam till ordalydelsen ”förhandsbesked inför tillståndsgivning”, eftersom det kan ge intrycket av att detta också skulle avse förhandsbesked enligt andra lagstiftningar, såsom enligt plan- och bygglagen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2.2",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen är positiv till att kopplingen till 7 kap. miljöbalken tydliggörs med en upplysningsbestämmelse och instämmer med utredningens bedömning att 7 kap. miljöbalken fortsatt bör finnas kvar i miljöbalken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.3",
      "sentiment": -0.5,
      "quote": "Länsstyrelsen anser att utelämnandet av till exempel en slutlig prövning av Natura 2000 bestämmelserna inför ett områdesanvändningsbesked medför att beskedet inte får avsedd effekt som ett förhandsbesked.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.3.3",
      "sentiment": -0.5,
      "quote": "Länsstyrelsen ser en risk i att beskedet skapar ett processteg som snarare förlänger processen än kortar den och att den tid som läggs ner inte kommer att motsvara nyttan av beskedet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.3.3",
      "sentiment": -0.5,
      "quote": "Länsstyrelsen anser därför att frågor om Natura 2000 och artskydd behöver ingå i den prövning som regeringen ska göra i ett områdesanvändningsbesked, eftersom dessa frågor ofta är avgörande för om en verksamhet är lämpligt lokaliserad.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5.5",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen ser inget problem i att tillhandahålla det planeringsunderlag som krävs till de som ska tillämpa denna lag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5.7",
      "sentiment": -0.5,
      "quote": "Länsstyrelsen anser att det kommunala vetot i denna fråga kan komma att ytterligare minska områdesanvändningsbeskedets verkliga tyngd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5.8",
      "sentiment": -0.2,
      "quote": "Länsstyrelsen ställer sig frågande till hur områdesanvändningsbeskedet ska omhändertas i planläggningsprocessen enligt plan- och bygglagen hos kommuner och myndigheter i de fall då till exempel en detaljplan behöver upprättas med anledning av områdesanvändningsbeskedet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5.8",
      "sentiment": -0.2,
      "quote": "Länsstyrelsen vill se ett förtydligande kring situationen där regeringen lämnar ett negativt områdesanvändningsbesked, eller ändrar ett från början positivt områdesanvändningsbesked till ett negativt besked i förhållande till Sveriges säkerhet, om detta i praktiken kan innebära hinder för kommunen att planlägga området för den typen av verksamhet som fått det negativa beskedet.",
      "quote_type": "grund"
    }
  ]
