  "overall": {
    "sentiment": -1.0,
    "quote": "Naturskyddsföreningen avstyrker det remitterade förslaget i sin helhet eftersom det i många fall finns risk för negativ inverkan på möjligheterna att nå riksdagens miljömål om riksintressebedömningar förs över från domstolar och myndigheter till regeringen.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a7.2",
      "sentiment": -1.0,
      "quote": "Föreningen avstyrker förslaget om en ny lag, eftersom det splittrar tillståndsprövningen på ett sätt som försvårar möjligheten att få en sammanhållen och allsidig prövning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2.1",
      "sentiment": -0.5,
      "quote": "utredningen lyckas inte visa att det rör sig om krav som innebär att miljöstyrningen i riksintressebedömningarna behöver minska.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.3",
      "sentiment": -1.0,
      "quote": "Det är snarare så att ett förtida ställningstagande om riksintressena kan leda till en överdriven förväntan på godkännande och att investeringar görs i verksamhet som inte har förutsättningar att klara den senare miljötillståndsprövningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.3.3",
      "sentiment": 1.0,
      "quote": "Vi ansluter oss till utredningens slutsats om att det inte är möjligt att vid ett tidigt områdesanvändningsbesked binda den efterföljande miljötillståndsprövningen av till exempel miljökvalitetsnormer, artskydd och Natura 2000-områden.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.3.4",
      "sentiment": -1.0,
      "quote": "Det öppnar som sagt för politiska bedömning av aspekter som i allt väsentligt bör avgöras rättsligt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5.2",
      "sentiment": -1.0,
      "quote": "Det överför prövningen från en i huvudsak rättslig prövning där domstolarna har ett avgörande inflytande till regeringsmakten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5.3",
      "sentiment": -1.0,
      "quote": "Ett ansökningsförfarande kan bidra till att öka förväntningarna på att starta verksamheter i områden som idag anses helt stängda för sådana i fjärde kapitlet miljöbalken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5.5",
      "sentiment": -0.2,
      "quote": "Föreningen är av uppfattningen att ett områdesanvändningsbesked enligt betänkandet i praktiken kommer att utsläcka andra lokaliseringsalternativ.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5.6",
      "sentiment": -1.0,
      "quote": "Föreningen anser att en Natura 2000-prövning bör ske senast i samband med regeringens prövning om ett områdesanvändningsbesked kan medges.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5.7",
      "sentiment": 1.0,
      "quote": "Föreningen tillstyrker att den kommunala vetorätten behålls enligt det remitterade förslaget om en ny lag.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.5.8",
      "sentiment": 0.5,
      "quote": "tillstyrker att områdesanvändningsbesked endast ska ha bindande verkan avseende de regler som motsvarar hushållningsbestämmelserna i dagens 3 och 4 kapitel miljöbalken, och inte binda den senare miljöbalksprövningen i andra avseenden.",
