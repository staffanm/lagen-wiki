  "segments": [
    {
      "forarbete_id": "a7.2",
      "sentiment": 0.8,
      "quote": "Förslaget att flytta 3 och 4 kap. miljöbalken till en ny lag om hushållning med markoch vattenområden tror vi kan skapa större tydlighet eftersom bestämmelserna aktualiseras bredare än i miljöprövningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5.5",
      "sentiment": -0.5,
      "quote": "Omfattningen av vilka underlag som ska krävas för att ansöka om ett områdesanvändningsbesked behöver begränsas jämfört med utredningens förslag eftersom de innebär att det ska krävas en full miljökonsekvensbeskrivning samt ytterligare underlag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec39",
      "sentiment": -0.5,
      "quote": "Fem år räcker i många fall inte för en prövning av storskalig vindkraft eller solkraft.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5.6",
      "sentiment": -0.5,
      "quote": "Vi ser också behov av tidsfrister för när regeringen ska fatta beslut, för i dag är handläggningstiderna långa.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5.7",
      "sentiment": -0.5,
      "quote": "Vi ser inte att förslaget ger någon ökad tydlighet om den kommunala tillstyrkan i ärenden där den sökande begär tidigt områdesanvändningsbesked, bara att den hanteras i regeringens process i stället för i miljöprövningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec332",
      "sentiment": -0.5,
      "quote": "utformningen av förslaget innebär att värdet av ett tidigt områdesanvändningsbesked minskar.",
