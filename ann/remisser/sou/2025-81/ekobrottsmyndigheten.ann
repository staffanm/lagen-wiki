  "segments": [
    {
      "forarbete_id": "a8.3",
      "sentiment": 1.0,
      "quote": "Inte minst avsaknaden av åtkomst till penningtvättsregistret innebär en stor nackdel för en effektiv utredningsverksamhet och är, som utredningen framhåller, inte en rimlig ordning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4",
      "sentiment": 1.0,
      "quote": "Myndigheten delar bedömningen att det varken ter sig rimligt eller ändamålsenligt att tre brottsbekämpande myndigheter med delvis samma uppdrag och överlappande brottskataloger inte har tillgång till samma information.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5",
      "sentiment": 0.5,
      "quote": "Ekobrottsmyndigheten ser även positivt på möjligheten att få tillgång till uppgifter ur tulldatabasen.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a14.3",
      "sentiment": -0.2,
      "quote": "För att underlätta tillämpningen anser Ekobrottsmyndigheten att det är angeläget och ändamålsenligt att, så långt det är möjligt, samma regler ska gälla för förundersökningar som utredningar om självständigt förverkande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.4.2",
      "sentiment": 1.0,
      "quote": "Att olika bestämmelser gäller i en situation där utmätningsbar egendom påträffas vid t.ex. en husrannsakan beroende på om polismannen arbetar i Polismyndighetens eller i Ekobrottsmyndighetens verksamhet är därför inte rimligt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.8",
      "sentiment": -1.0,
      "quote": "Om en myndighet, t.ex. Bolagsverket, hanterar försenade årsredovisningar i administrativ ordning, skulle detta kunna leda till att de brottsbekämpande myndigheterna inte får sådana indikationer på att ytterligare, straffrättslig, utredning behövs.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.7",
      "sentiment": 1.0,
      "quote": "Institutet, som använts i liten utsträckning, synes inte ha lett till något positivt resultat utan främst inneburit möjlighet att skrämma målsägande till tystnad, trakassera åklagare och förhala domstolsprocesser.",
      "quote_type": "grund"
