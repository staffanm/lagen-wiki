    },
    {
      "forarbete_id": "a5.8",
      "sentiment": -0.2,
      "quote": "Vi efterfrågar ytterligare vägledning avseende vilken version av standarderna som är tillämpliga för tivolianordningar bland annat med beaktade av tivolianordningens tillverkningsår och genomförda förändringar av tivolianordningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.2",
      "sentiment": 0.5,
      "quote": "Detta motiveras av två skäl: dels ser vi positivt på att få ett sammanhållet regelverk, dels vill vi minska risken för behov av ytterligare regeländringar i ett senare skede eftersom införandet av ny reglering bland annat innebär ökad administration för verksamhetsutövarna.",
      "quote_type": "grund"
