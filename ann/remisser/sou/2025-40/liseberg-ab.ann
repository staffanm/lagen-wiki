    {
      "forarbete_id": "a5.8",
      "sentiment": -0.2,
      "quote": "Tillsynsmyndigheten måste ha rätt kompetens om mekanik, konstruktion och underhåll, som idag finns hos besiktningsorganen som verkar på marknaden, för att tillsynen ska kunna bidra till att tivolianordningar som tillhandahålls ska vara säkra.",
      "quote_type": "grund"
