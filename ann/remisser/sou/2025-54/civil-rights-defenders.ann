    {
      "forarbete_id": "a7.2",
      "sentiment": -1.0,
      "quote": "Enligt Civil Rights Defenders är det angeläget att verkställighetshinder prövas i ett tidigt skede, eftersom det kan minska den ovisshet och förhindra det rättsliga limbo som annars drabbar både den enskilde och dennes anhöriga.",
      "quote_type": "grund"
