  "segments": [
    {
      "forarbete_id": "a5.2",
      "sentiment": 0.5,
      "quote": "Det torde finnas stora vinster i att låta Migrationsverket, som expertmyndighet, ta ett helhetsgrepp om frågor kring utvisning, återreseförbud, återkallelse av eventuell skyddsstatusförklaring samt uppehållstillstånd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.2",
      "sentiment": -0.5,
      "quote": "Genom att 8 a kap. 1 § utlänningslagen föreslås bli obligatorisk, istället för som nu fakultativ, ökar sannolikheten för att en utlänning kan komma att omfattas av flera beslut om utvisning på grund av brott.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.6",
      "sentiment": -0.2,
      "quote": "Migrationsverkets roll, till skillnad från allmän domstols, är inte att döma en utlänning för en specifik gärning och den bedömning som myndigheten gör är inte begränsad till enskilda brott.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.2",
      "sentiment": 0.0,
      "quote": "Eftersom det i dessa fall enbart rör sig om en framåtsyftande bedömning av om utlänningen utgör en fara för samhället eller säkerheten finns en ännu större risk för diskrepans i bedömningarna i de olika förfarandena.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.4",
      "sentiment": -0.2,
      "quote": "Såsom tidigare påpekats innebär ändringarna från får till ska inte att de får den innebörd som de lagtekniskt bör ha.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2",
      "sentiment": 0.5,
      "quote": "Migrationsverket välkomnar förslaget att upphäva 8 a kap. 3 § utlänningslagen och att prövningen av frågan om verkställighetshinder istället tas över av Migrationsverket.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4",
      "sentiment": 0.5,
      "quote": "Migrationsverket anser att förslaget kan bidra till en mer enhetlig rättstillämpning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.3.1",
      "sentiment": 0.5,
      "quote": "Migrationsverket instämmer i att kostnadsökningarna till följd av att fler kan komma att tas i förvar inte ryms inom befintlig ram och att medel därför bör tillskjutas.",
      "quote_type": "grund"
    }
  ]
