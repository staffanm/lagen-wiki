  "segments": [
    {
      "forarbete_id": "a6.5.3",
      "sentiment": -0.5,
      "quote": "Utifrån att det inte går att avgöra om utredningens förslag är ändamålsenligt ifrågasätter vi förslagets proportionalitet i relation till dess syfte.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec237",
      "sentiment": 1.0,
      "quote": "Institutet tillstyrker förslaget om att proportionalitetsbedömningen ska framgå direkt av lagtexten i 8 kap. 2 § utlänningslagen.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.5.5",
      "sentiment": -1.0,
      "quote": "För att möta kravet på förutsägbarhet behöver det tydligt framgå vad skärpningen är eftersom det annars finns stor risk för att det blir spretig praxis något som utredningen också påpekar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7.2",
      "sentiment": -1.0,
      "quote": "Förslaget riskerar att få oproportionerliga konsekvenser och saknar tillräcklig motivering i relation till syfte.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2",
      "sentiment": -1.0,
      "quote": "Detta skulle riskera att den enskildes rättigheter inte till fullo tas till vara då den tilltalade exempelvis inte är garanterad ett offentligt biträde, till skillnad från dagens ordning där den tilltalade har tillgång till en offentlig försvarare vid frågan om utvisning på grund av brott.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4",
      "sentiment": -0.2,
      "quote": "Institutet ifrågasätter däremot att en plikt ska införas för åklagaren att alltid yrka på utvisning om förutsättningarna är uppfyllda.",
      "quote_type": "standpunkt"
    }
  ]
