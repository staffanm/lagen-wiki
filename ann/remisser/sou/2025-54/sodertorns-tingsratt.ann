      "artifact:forarbete/sou/2025-54": "7aaeb3a04e899501717f3265fee63505ccf9529ba9e8e7301f283a0cd3c94fac"
    }
  },
  "overall": {
    "sentiment": -1.0,
    "quote": "Den ökade arbetsbördan, förlängningen av handläggningstiderna och ökade kostnader kan inte anses rimliga eller motiverade innan en alternativ och mer effektiv processordningen har utretts.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a6.5.5",
      "sentiment": 0.2,
      "quote": "Det kan dock konstateras att det av den föreslagna lagtexten inte tydligt framgår att risken för fortsatt brottslighet ska tala för utvisning i större utsträckning än tidigare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.1",
      "sentiment": 1.0,
      "quote": "Utifrån utredningens uppdrag och syfte framstår de föreslagna lagändringarna för flyktingar och utlänningar som har uppehållstillstånd (8 a kap. 4 §), EES-medborgare och deras familjemedlemmar (8 a kap. 7 §) och varaktigt bosatta (8 a kap. 8 §) som välavvägda och ändamålsenliga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.4",
      "sentiment": 1.0,
      "quote": "Utifrån utredningens uppdrag och syfte framstår de föreslagna lagändringarna för flyktingar och utlänningar som har uppehållstillstånd (8 a kap. 4 §), EES-medborgare och deras familjemedlemmar (8 a kap. 7 §) och varaktigt bosatta (8 a kap. 8 §) som välavvägda och ändamålsenliga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.5",
      "sentiment": 1.0,
      "quote": "Utifrån utredningens uppdrag och syfte framstår de föreslagna lagändringarna för flyktingar och utlänningar som har uppehållstillstånd (8 a kap. 4 §), EES-medborgare och deras familjemedlemmar (8 a kap. 7 §) och varaktigt bosatta (8 a kap. 8 §) som välavvägda och ändamålsenliga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.3",
      "sentiment": 1.0,
      "quote": "Att det kvalificerade kravet för utvisning av utlänningar som kom till Sverige som barn tas bort framstår också, mot bakgrund av utredningens uppdrag och syfte, som välavvägt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.2",
      "sentiment": -0.5,
      "quote": "Med hänsyn till det osäkra rättsläget finns det dessutom en stor risk att motstridiga bedömningar görs av allmänna domstolar respektive Migrationsverket.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7.2",
      "sentiment": 1.0,
      "quote": "Utifrån utredningens uppdrag och syfte framstår de föreslagna lagändringarna för återreseförbuden välavvägda och ändamålsenliga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2",
      "sentiment": -0.2,
      "quote": "Av utredningen framgår dock att det i vissa fall är osäkert om en sådan ordning är förenlig med EU-domstolens praxis, av vilken följer att nationella myndigheter är skyldiga att i varje skede av återvändandeförfarandet iaktta principen om non-refoulement (se s. 323 och 324).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": 1.0,
      "quote": "Detta undanröjer den osäkerhet som idag finns beträffande frågan om en domare kan lyfta frågan om utvisning utan att äventyra skyldigheten att förhålla sig objektiv och opartisk i brottmålsprocessen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4",
      "sentiment": -0.2,
      "quote": "Det är inte lämpligt att åklagaren måste framställa ett sådant yrkande även i fall då det är uppenbart att utvisning inte ska/bör ske.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2",
      "sentiment": 1.0,
      "quote": "Tingsrätten instämmer i utredningens bedömning att det bör förtydligas i lag att uppehållstillstånd och arbetstillstånd upphör att gälla vid beslut om utvisning och tillstyrker förslaget.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.4.3",
      "sentiment": 1.0,
      "quote": "Mot bakgrund av utredningens uppdrag och syfte tillstyrks därför förslagen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.4.5",
      "sentiment": 1.0,
      "quote": "Utifrån utredningens uppdrag och syfte framstår förslaget om att skärpa maximistraffet för den som har en utlänning anställd som saknar rätt att vistas här eller förskrivet arbetstillstånd som välavvägt och ändamålsenligt.",
      "quote_type": "grund"
    }
  ]
}