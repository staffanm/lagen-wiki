  "segments": [
    {
      "forarbete_id": "a5.2",
      "sentiment": 1.0,
      "quote": "Hovrätten delar därför utredningens bedömning att det finns starka skäl att överföra prövningen av frågan om utvisning på grund av brott från allmän domstol till Migrationsverket.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.5",
      "sentiment": 0.5,
      "quote": "Hovrätten ställer sig positiv till att det i 8 a kap. 2 § utlänningslagen tydliggörs att det vid prövningen av utvisningsfrågan ska göras en intresseavvägning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7",
      "sentiment": 0.2,
      "quote": "Som utredningen framhåller (s. 319 ff.) kan det dock ifrågasättas on en sådan ordning är förenlig med den principen om nonrefoulement.",
