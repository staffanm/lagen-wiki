  "segments": [
    {
      "forarbete_id": "a6.5.1",
      "sentiment": 1.0,
      "quote": "Utvisning är en sådan ingripande åtgärd att den inte bör aktualiseras för brott vars straffvärde (och påföljdsval) stannar vid böter, d.v.s. brott som inte förtjänar ett fängelsestraff eller annan påföljd som alternativ till fängelse.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.2",
      "sentiment": 0.2,
      "quote": "Den tekniska innebörden av att regeln är obligatorisk torde inte innebära någon större praktisk skillnad i prövningen av huruvida villkoren för utvisning är uppfyllda.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.3",
      "sentiment": -0.5,
      "quote": "Fakultetsstyrelsen har fått det intrycket att utredningens förslag har präglats främst av direktivets syfte att åstadkomma utvisning i betydligt högre utsträckning och inte motiveras av ett verkligt behov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.4",
      "sentiment": 1.0,
      "quote": "Fakultetsstyrelsen har ingen erinran mot utredningens överväganden och förslag.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.6.2",
      "sentiment": 1.0,
      "quote": "Fakultetsstyrelsen har ingen invändning mot utredningens slutsats att utformningen av svensk rätt uppfyller kravet enligt EU-rätten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.3",
      "sentiment": 0.2,
      "quote": "Fakultetsstyrelsen anser trots detta att det förhållandet, att barnet kom till Sverige som ung, bör vara en omständighet som beaktas särskilt vid den samlade bedömningen och ser gärna att detta lyfts fram i lagtexten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7.2",
      "sentiment": 0.0,
      "quote": "det saknas underlag för Fakultetsstyrelsen att ta ställning till frågan om behov för detta finns, eller om justeringarna enbart ska tjäna ett symbolsyfte.",
