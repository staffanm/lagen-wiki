  "segments": [
    {
      "forarbete_id": "sec164",
      "sentiment": -0.5,
      "quote": "En sådan definition landar väsentligt bredare än vad som synes vara avsikten med uppdraget enligt direktiven.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3",
      "sentiment": -0.5,
      "quote": "Den föreslagna definitionen av kriminell sammanslutning är dessutom så vidsträckt att den riskerar att göra gränsen mellan en straffbar sammanslutning och skyddad föreningsverksamhet svår att förutse.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec178",
      "sentiment": -0.5,
      "quote": "I dess nuvarande form lämnas en avsevärd bedömningsmarginal till rättstillämparen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec197",
      "sentiment": -0.8,
      "quote": "Detta innebär att även rådgivning med ett rent neutralt innehåll, exempelvis information om gällande rätt, skulle kunna utgöra brott om den lämnas med avsikt att informationen ska användas i samband med den kriminella sammanslutningens brottsliga verksamhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.3",
      "sentiment": -0.5,
      "quote": "Eftersom den brottslighet som den kriminella sammanslutningen enligt definitionen ska ägna sig åt inte förutsätter att de konkreta brotten som har begåtts inom ramen för sammanslutningen behöver preciseras, och att även misstanke om försöksbrott ska kunna utgöra grund för att använda hemliga tvångsmedel, ges betydande möjligheter att inleda en förundersökning på relativt tunna grunder.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.3.2",
      "sentiment": -0.5,
      "quote": "Även här saknar tingsrätten en analys av hur en sådan reglering överensstämmer med barns särskilda integritetsintresse, Barnkonventionens ställning som svensk lag och Sveriges internationella åtaganden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec319",
      "sentiment": -0.5,
      "quote": "Att i en sådan situation döma för båda brotten i konkurrens förefaller främmande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16",
      "sentiment": -0.5,
      "quote": "Ytterligare en invändning är att utredningen inte har analyserat förslagens konsekvenser i förhållande till andra förslag på straffrättens område som beslutats eller lagts fram parallellt.",
      "quote_type": "grund"
    }
  ]
