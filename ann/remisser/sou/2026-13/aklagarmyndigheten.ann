  "segments": [
    {
      "forarbete_id": "a10",
      "sentiment": 0.8,
      "quote": "Det är därför angeläget att kriminalisera straffvärda situationer som nuvarande lagstiftning – inklusive de aktuella lagändringarna i 23 kap. brottsbalken – inte täcker in.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.2",
      "sentiment": 0.5,
      "quote": "Ett överlappande straffansvar framstår inte som nödvändigt, utan riskerar i stället i många fall att utgöra en effektivitetshämmande svårighet i bekämpningen av allvarlig brottslighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.2.2",
      "sentiment": 0.2,
      "quote": "Vi menar att det är naturligt att kräva åtminstone viss varaktighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.2.3",
      "sentiment": 0.2,
      "quote": "Med underlag i de synpunkter som har hämtats in från den operativa verksamheten finns det dock ett behov av ytterligare vägledning om gränsen mellan straffbara och icke straffbara deltagande- och samröreshandlingar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec184",
      "sentiment": -0.2,
      "quote": "Trots detta anser vi att det inte går att jämställa denna typ av brottslighet med den som utövas inom ramen för en terroristorganisation.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec319",
      "sentiment": -0.5,
      "quote": "Vi har sammantaget svårt att se fördelarna med ett dubblerat straffansvar för de situationer där det handlande och händelseförlopp som klarläggs utgör, eller utgör ett led i, ett redan idag kriminaliserat brott.",
      "quote_type": "grund"
