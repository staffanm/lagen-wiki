  "segments": [
    {
      "forarbete_id": "a3.2.2",
      "sentiment": -0.5,
      "quote": "Det riskerar att leda till att begränsningen av föreningsfriheten slår brett och att även oavsiktliga kontakter kan träffas av kriminaliseringen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.2.2",
      "sentiment": -0.5,
      "quote": "Att det i den föreslagna definitionen av en kriminell sammanslutning inte förekommer något krav på varaktighet, till skillnad från EU:s kriterier, innebär vidare att lagen kommer vara tillämplig även vid första brottstillfället.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.2.3",
      "sentiment": -0.5,
      "quote": "Gränserna för vad som utgör ett straffbart deltagande eller samröre är inte tillräckligt tydligt definierade, och särskilt oroväckande är otydligheterna kring när lagliga och brottsliga verksamheter ska anses klart avskiljbara eller så pass integrerade att sammanslutningen i sin helhet ska komma att betraktas som kriminell.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.2.4",
      "sentiment": -1.0,
      "quote": "Civil Rights Defenders vill också särskilt betona att förslaget om att samröresbrottet innefattar juridisk rådgivning strider mot grundläggande rättsstatliga principer.",
      "quote_type": "grund"
    }
  ]
