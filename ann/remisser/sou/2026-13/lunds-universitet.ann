    {
      "forarbete_id": "a3.2.2",
      "sentiment": -0.5,
      "quote": "Den sammanlagda effekten av de senaste årens genomförda och föreslagna straffskärpande eller annars repressionshöjande lagstiftning minskar utrymmet för att ändamålet med de nu aktuella förslagen skulle stå i proportion till de därtill knuta frihetsinskränkningarna.",
      "quote_type": "grund"
