  "segments": [
    {
      "forarbete_id": "sec6",
      "sentiment": -1.0,
      "quote": "Det är med den föreslagna definitionen av ”kriminella sammanslutningar” vare sig språkligt eller juridiskt möjligt att på ett rättssäkert sätt förutse vilka ”sammanslutningar” som kommer att falla inom kriminaliseringarnas tillämpningsområde.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.3.1",
      "sentiment": -1.0,
      "quote": "Utredningens förslag att utvidga användningen av hemliga tvångsmedel till att också omfatta misstankar om ”samröre med kriminella sammanslutningar” skulle, inte minst på grund av att förslagets lagstiftningsteknik öppnar för avsevärda tolknings- och tillämpningssvårigheter, på ett allvarligt sätt hota att underminera det för en rättsstat avgörande skyddet för kommunikationen mellan en advokat och dennes klient.",
      "quote_type": "grund"
