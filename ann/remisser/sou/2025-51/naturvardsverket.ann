      "artifact:forarbete/sou/2025-51": "258d56514e13c4c5451bf445ef12c74926eae0c3d6b9e933fa95a5d91e5d1ad9"
    }
  },
  "overall": {
    "sentiment": 0.5,
    "quote": "Naturvårdsverket anser däremot att det är en brist att utredningen har ett så snävt perspektiv på fysiska åtgärder och avgränsning till den byggda miljön.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a8.1",
      "sentiment": 0.0,
      "quote": "Utifrån regeringens bedömning och vår egen erfarenhet ser vi därför inte att förslaget är tillräckligt motiverat eller behovet av förändringen tillräckligt väl beskrivet för att vi ska kunna ta ställning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": 0.5,
      "quote": "Vi bedömer att utredningens förslag underlättar förvaltningen av allmänna dagvattenanläggningar vilket bidrar till att anläggningarna blir mer robusta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4",
      "sentiment": 0.5,
      "quote": "Reglering om dagvattensystemets kapacitet bidrar till robusthet i va-systemet, till stärkt beredskap och även till mål inom EU:s strategi för vattenresiliens.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5",
      "sentiment": 1.0,
      "quote": "Naturvårdsverket ställer sig bakom förslaget.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.6",
      "sentiment": 0.5,
      "quote": "Vi bedömer att en ytterligare specificering av 3 kap. 5 § första stycket 4 plan- och bygglagen bidrar till en större förståelse för enskilda aktörer hur kommunen långsiktigt avser arbeta med klimatrisker.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7",
      "sentiment": 1.0,
      "quote": "Naturvårdsverket ställer sig bakom förslaget.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.8",
      "sentiment": 1.0,
      "quote": "Naturvårdsverket ställer sig bakom förslaget.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.9",
      "sentiment": 1.0,
      "quote": "Vi instämmer i utredningens bedömning att det utgör ett viktigt steg för kommuner att kunna ta ställning kring markanvändning i framtida riskutsatta områden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.10",
      "sentiment": 1.0,
      "quote": "Naturvårdsverket ställer sig bakom förslaget.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a9.2.1",
      "sentiment": 1.0,
      "quote": "Vi instämmer i att det är viktigt att intressen vägs mot varandra och att en statlig företrädare kan besluta om vilka åtgärder som staten finner angelägna att genomföra.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2.2",
      "sentiment": -0.2,
      "quote": "Därför är det av vikt att få en nationell planeringsnivå på plats, där flera intressen och sektorer samlas för att möjliggöra en helhetsbedömning avseende långsiktiga prioriteringar men även nedprioriteringar av områden för kustskydd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2.3",
      "sentiment": 0.2,
      "quote": "Den korta tiden möjliggör inte framtagande av nya och kompletterande underlag, vilket kan vara nödvändigt på grund av kända brister i befintliga underlag eller avsaknad av underlag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2.4",
      "sentiment": -0.2,
      "quote": "Kustskydden bygger inte på natur- och kulturvärden och därför bör paragrafen snarare placeras som 11 § eller möjligen 9 a §, eftersom större likheter finns med geologisk lagring av koldioxid än med natur- och kulturvärden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2.6",
      "sentiment": 0.2,
      "quote": "Med tanke på identifierade kvalitets- och aktualitetsbrister i befintliga riksintresseunderlag bedömer vi dock att det skulle vara värdefullt om underlaget fanns tillgängligt för de prioriteringar som föreslås göras i arbetet med uppdraget enligt avsnitt 9.2.3.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.5",
      "sentiment": 0.5,
      "quote": "Möjligheten att ta ut en avgift från fastighetsägare blir i sammanhanget principiellt viktig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.2.3",
      "sentiment": -0.5,
      "quote": "Enligt vår mening behöver reglerna rörande markavvattning och markavvattningssamfälligheter moderniseras utifrån flera intressen.",
      "quote_type": "grund"
    }
  ]
}