  "overall": {
    "sentiment": 0.2,
    "quote": "Förslagen är ett viktigt steg för att ge kommunerna bättre verktyg, vilket är centralt för en kustkommun som Varberg.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a8.1",
      "sentiment": 1.0,
      "quote": "Kommunen ser detta som en potentiell möjlighet att underlätta för nödvändiga skyddsåtgärder och har inga invändningar mot förslaget.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": 0.5,
      "quote": "Detta bedöms minska juridiska hinder och främja mer hållbara, naturliga och kostnadseffektiva dagvattenlösningar som är värdefulla ur ett klimatanpassningsperspektiv.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4",
      "sentiment": -0.5,
      "quote": "Samtidigt medför förslaget i sin nuvarande form betydande praktiska och ekonomiska utmaningar som utredningen inte har belyst tillräckligt",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5",
      "sentiment": -0.2,
      "quote": "Förslaget om en lagstadgad informationsskyldighet medför dock flera utmaningar som måste hanteras innan det kan genomföras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.6",
      "sentiment": 0.2,
      "quote": "Kommunen är positiv till att i översiktsplanen redovisa övergripande intentioner för fysiska åtgärder, men anser att mer detaljerade åtgärder bör hanteras i andra dokument.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7",
      "sentiment": -0.2,
      "quote": "Kommunen ser utmaningar med att i genomförandet av detaljplaner bilda rättigheter för osäkra framtida behov och efterfrågar mer vägledning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.8",
      "sentiment": -0.2,
      "quote": "Regleringar där markens lämplighet för bebyggelse är beroende av åtgärder på en annan plats kan leda till osäkerhet i genomförandet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.9",
      "sentiment": -0.5,
      "quote": "Dock har förslaget i sin nuvarande utformning brister och dess konsekvenser är inte tillräckligt utredda.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.10",
      "sentiment": -0.2,
      "quote": "Kommunen konstaterar att denna föreslagna upplysningsskyldighet är en ny arbetsuppgift som kommer att generera kostnader för byggnadsnämnden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.11",
      "sentiment": 0.2,
      "quote": "Utredningen saknar dock helt en analys av de betydande ekonomiska och praktiska konsekvenserna för kommunerna som huvudmän och utförare inom exempelvis äldreomsorgen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2.1",
      "sentiment": 0.5,
      "quote": "Detta är en fråga av nationell betydelse som enskilda kommuner har svårt att hantera på egen hand.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.5",
      "sentiment": 0.2,
      "quote": "Modellen, som bygger på att avgifter kan tas ut från de fastighetsägare som får nytta av åtgärden, bedöms ge bättre förutsättningar att finansiera kostsamma investeringar.",
      "quote_type": "grund"
    }
  ]
