    },
    {
      "forarbete_id": "a8.9",
      "sentiment": -1.0,
      "quote": "Att införa ett krav på att kommuner ska släcka outnyttjade byggrätter inom riskområde innebär ett stort merarbete för kommunerna, och riskerar samtidigt att drabba privatpersoner och fastighetsägare som förlorar sin byggrätt på ett oproportionerligt sätt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.10",
      "sentiment": 0.2,
      "quote": "Dock bör informationen inte endast vara tillgänglig för fastighetsägaren, utan även för relevanta externa aktörer såsom banker, försäkringsbolag eller den som tänkt förvärva en fastighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.11",
      "sentiment": 1.0,
      "quote": "Det är ett viktigt steg för att stärka skyddet för personer som är särskilt utsatta vid värmeböljor",
