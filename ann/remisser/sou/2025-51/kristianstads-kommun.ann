  "segments": [
    {
      "forarbete_id": "sec18",
      "sentiment": 0.2,
      "quote": "Frågan kring enskild egendom och allmänt intresse bör utredas vidare i förslaget för att inte riskera stora negativa konsekvenser avseende de allmänna intressen som strandskyddet värnar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec8",
      "sentiment": 0.5,
      "quote": "Det finns ett stort värde i att det av översiktsplanen framgår var det behöver vidtas fysiska åtgärder för att mer varaktigt skydda befintlig eller planerad markanvändning mot naturhändelser med negativa konsekvenser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec13",
      "sentiment": 0.5,
      "quote": "Det är samhällsekonomiskt viktigt att klimatskydd byggs i den omfattning och vid den tidpunkt då de behövs utifrån gällande riskscenario samt baserade på lokala förhållande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec14",
      "sentiment": 0.5,
      "quote": "Förslaget har särskilt stor betydelse för exploatering som kräver skyddsåtgärder i form av gemensamhetsanläggning där flera fastighetsägare berörs och som idag saknar stöd i lagstiftning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec9",
      "sentiment": -0.5,
      "quote": "Att släcka ut detaljplaner med gällande byggrätt medför svårigheter avseende likabehandlingsprincipen som är en viktig grund i kommunal verksamhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec15",
      "sentiment": 0.2,
      "quote": "Om lagförslaget ska realiseras så behöver det tydligt beskrivas vad som avses med 2025-09-08 Änr 2025/721 underlag och utifrån vilken syn på klimatrelaterade risker som detta underlag ska utformas för att anses vara tillräckligt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec19",
      "sentiment": 0.5,
      "quote": "Det är positivt att staten allmänt tar ett större ansvar för klimatanpassningsåtgärder samt bidrar med statlig finansiering till dessa då förslaget belyser ett stort behov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec10",
      "sentiment": 0.2,
      "quote": "en ökning av luftkonditionering i denna utsträckning riskerar att försvåra kommunens klimatoch energieffektiviseringsmål.",
