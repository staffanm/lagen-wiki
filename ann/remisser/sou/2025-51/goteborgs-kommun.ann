    },
    {
      "forarbete_id": "a9.2.1",
      "sentiment": 0.5,
      "quote": "Det är dock av största vikt att komma till ett ställningstagande i närtid där staten klarlägger vad och var den avser att ta ansvar för skydd av kusten och vad som inte kommer att skyddas.",
      "quote_type": "grund"
