  "segments": [
    {
      "forarbete_id": "a5.3.1",
      "sentiment": -0.2,
      "quote": "Länsstyrelsen vill, likt betänkandet, betona att Länsstyrelsen inte tillförs särskilda medel för att arbeta med klimatanpassning sedan 2024. Detta försvårar denna roll och har en negativ inverkan på möjligheten att stödja kommunerna i deras klimatanpassningsarbete.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.1",
      "sentiment": -0.5,
      "quote": "Ytterligare dispensgrunder motverkar strandskyddets syfte.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2",
      "sentiment": 1.0,
      "quote": "Det får anses vara fråga om ett angeläget allmänt intresse att denna möjlighet finns.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.6",
      "sentiment": 1.0,
      "quote": "Det bidrar förhoppningsvis till att konsekvenserna av klimatriskerna faktiskt minskar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7",
      "sentiment": 0.5,
      "quote": "Det är därför viktigt att det finns en koppling till kommunens översiktsplan där helheten är möjlig att hantera.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.8",
      "sentiment": 1.0,
      "quote": "Tillägget är relevant utifrån att behovet av att genomföra sådana åtgärder har ökat.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.9",
      "sentiment": 0.2,
      "quote": "Länsstyrelsen ser dock att det kan bli en utmaning för kommunerna att ta fram de underlag som krävs för att bedöma risker och ändra eller upphäva en detaljplan inom den förslagna tidsramen om sex år.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec27",
      "sentiment": 0.0,
      "quote": "Vi saknar ett helhetsperspektiv där det även bör framgå att bästa sammantagna effekten av åtgärder mot höga flöden också kan fås genom att spara vatten på rätt plats i landskapet i stället för att leda bort det.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.11",
      "sentiment": 1.0,
      "quote": "Det är också en rimlig bedömning att kostnaden för införandet av åtgärder för att hålla temperaturen nere faller på kommunerna och att den i de fall verksamheterna drivs av privata utförare kan regleras genom avtal.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.5.6",
      "sentiment": -0.2,
      "quote": "Utredningen i sin helhet bedöms i förhållande till sin omfattning dock ha gjort detta bara i begränsad utsträckning.",
