    },
    {
      "forarbete_id": "a8.9",
      "sentiment": -0.5,
      "quote": "Länsstyrelsen avstyrker dock förslaget i sin nuvarande utformning då den föreslagna lagändringen anses gå emot kommuners planmonopol.",
