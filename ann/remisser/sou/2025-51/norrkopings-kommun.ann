  "overall": {
    "sentiment": 0.5,
    "quote": "Norrköpings kommun står inför stora utmaningar när det gäller klimatanpassning och välkomnar därför generellt utredningen samt de flesta förslag och bedömningar i betänkandet.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a8.1",
      "sentiment": 1.0,
      "quote": "Det är positivt att det endast föreslås gälla befintliga byggnader och naturområden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2",
      "sentiment": 0.5,
      "quote": "I rollen som ansvarig för allmän väg och järnväg, så ser Norrköpings kommun mycket positivt på förslaget eftersom det möjliggör att utredningar kan påskyndas och återställande åtgärder kan vidtas snabbare än i dagsläget.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": 0.2,
      "quote": "En begränsning av förslaget till enbart bortledande av dagvatten riskerar att utesluta andra öppna dagvattenanläggningar från möjligheten till ledningsrättsupplåtelse, vilket kan motverka syftet med en långsiktigt hållbar och ändamålsenlig klimatanpassning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4",
      "sentiment": 1.0,
      "quote": "Det är positivt att tydlighet skapas gällande systemets kapacitet och begränsningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5",
      "sentiment": 1.0,
      "quote": "Det är positivt att tydlighet skapas gällande systemets kapacitet och begränsningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.6",
      "sentiment": 1.0,
      "quote": "Det ger ökad transparens och spårbarhet för alla berörda aktörer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7",
      "sentiment": 1.0,
      "quote": "Ett tydligt ställningstagande från kommunen i form av ett markreservat kan underlätta för storskaliga anläggningar som gynnar både det specifika området och angränsande områden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.8",
      "sentiment": 1.0,
      "quote": "välkomnar förslaget som innebär ett tydligt verktyg för att säkerställa att klimatanpassningsåtgärder genomförs.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.9",
      "sentiment": 0.2,
      "quote": "Norrköpings kommun konstaterar samtidigt att det finns ett behov av vägledning och kunskapsunderlag från nationell nivå för att förslaget ska vara praktiskt genomförbart och för att skapa en likartad hantering mellan kommuner.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.10",
      "sentiment": 1.0,
      "quote": "Det är viktigt att påminna om dessa saker i samband med bygglov eftersom det då är högst aktuellt för fastighetsägaren.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.11",
      "sentiment": 0.5,
      "quote": "Statliga projektmedel eller fonder behöver införas, som kan sökas för att kommunerna ska kunna leva upp till de skärpta kraven.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2.3",
      "sentiment": 0.5,
      "quote": "Norrköpings kommun ser vidare ett behov av att ansvaret breddas till att inte endast inkludera områden där skyddsbehovet är stort utifrån nationella intressen, utan att även andra tunga allmänna intressen vägs in där det är samhällsekonomiskt motiverat ur ett regionalt perspektiv.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2.5",
      "sentiment": 0.2,
      "quote": "vill samtidigt understryka vikten av att utredningen inte innebär att övriga föreslagna åtgärder försenas.",
      "quote_type": "grund"
    },
    {
