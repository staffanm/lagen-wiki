  "overall": {
    "sentiment": 0.0,
    "quote": "ser vi dock behov av vissa justeringar i det fortsatta arbetet med förslagen, dels för att säkerställa att klimatanpassningsåtgärder inte oavsiktligt försvårar eller fördyrar elförsörjningen i Sverige, och dels för att säkerställa att klimatanpassning sker i samklang med elförsörjningens krav på robusthet, säkerhet och långsiktig planering.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a10.5",
      "sentiment": -0.5,
      "quote": "En risk är att näringslivet, av kostnadsskäl, nedprioriterar frågan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec264",
      "sentiment": -0.5,
      "quote": "Det finns en risk att transmissionsnätsägare påförs avgifter för åtgärder som de inte har initierat och inte kan påverka, särskilt i fall där nyttan är indirekt eller svår att kvantifiera.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.1.2",
      "sentiment": -0.5,
      "quote": "Risken är att klimatanpassningsåtgärder hamnar mellan stolarna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.4",
      "sentiment": -0.5,
      "quote": "Svenska kraftnät anser att klimatförändringens potentiella konsekvenser riskerar att underskattas såsom det framläggs i betänkandet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.9",
      "sentiment": -1.0,
      "quote": "Om kommunerna ges skyldighet att upphäva detaljplaner kan det medföra att viktiga framtida anläggningar för elförsörjningen hindras eller fördröjs.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.11",
      "sentiment": 0.5,
      "quote": "Ett regelverk som anger högsta tillåtna inomhustemperaturer på arbetsplatser och i arbetsmiljön såväl inomhus som utomhus kan minska risken för värmerelaterad ohälsa och dödsfall bland särskilt utsatta grupper.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2",
      "sentiment": 0.5,
      "quote": "Ett utvidgat mandat för länsstyrelsen gör det möjligt att snabbt undanröja risker och återställa samhällsviktig infrastruktur.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.8",
      "sentiment": -1.0,
      "quote": "Externt uppställda villkor riskerar att skapa ineffektiva eller olämpliga lösningar och kan äventyra driftssäkerheten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4",
      "sentiment": 0.0,
      "quote": "Givet klimatförändringens framåtskridande effekter kan ett tioårsregn komma att bli ett återkommande ettårsregn i framtidens klimat.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2",
      "sentiment": 1.0,
      "quote": "Ett tydligare nationellt ställningstagande skapar klarhet för kommunernas planering och underlättar avvägningar mellan klimatanpassning och bevarande av riksintressen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": 0.2,
      "quote": "För att säkra driftssäkerhet och skydd mot intrång måste lagstiftningen tydligt värna befintlig infrastruktur vid nya anspråk, särskilt eftersom transmissionsnätsanläggningar är klassade som riksintressen samt ofta bedriver säkerhetskänslig verksamhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.6",
      "sentiment": 0.2,
      "quote": "Utan samverkan riskerar viktiga investeringar i elinfrastrukturen att försvåras.",
      "quote_type": "grund"
