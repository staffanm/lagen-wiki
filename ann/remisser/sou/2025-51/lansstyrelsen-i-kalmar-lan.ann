  "segments": [
    {
      "forarbete_id": "a8.1",
      "sentiment": -0.2,
      "quote": "Strandskyddsreglerna har en positiv inverkan på efterlevnaden av miljökvalitetsnormerna för vatten, varför en generell dispens riskerar att medföra en negativ påverkan på efterlevnaden av dessa.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2",
      "sentiment": 0.5,
      "quote": "Visserligen rör förslaget att tillfälligt ta annan mark i användning, men även tillfälliga ingrepp kan ha negativ påverkan på vattenmiljön.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": 0.2,
      "quote": "Höga flöden för med sig både näringsämnen och miljögifter, varför enbart bortledande av vatten inte är en fullgod hantering.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4",
      "sentiment": 0.5,
      "quote": "Vi vill påpeka att vad som definieras som tioårsregn kan behöva ändras i takt med att klimatet ändras och därför förordar vi att kapaciteten ska vara större än ”bara” ett tioårsregn.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5",
      "sentiment": 1.0,
      "quote": "Vi är positiva till förslaget att va-huvudmannen ska lämna uppgifter om vilken mängd dagvatten den allmänna va-anläggningen kan bortleda från en fastighet.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.6",
      "sentiment": 0.2,
      "quote": "Översiktsplanen är vägledande för kommunernas fysiska planering, men är inte juridiskt bindande eller att betrakta som en genomförandeplan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7",
      "sentiment": 1.0,
      "quote": "Vi delar betänkandets bedömning att det är värdefullt att kunna införa planbestämmelser som möjliggör skyddsåtgärder för att möta klimatförändringar, men där det inte finns något behov av att genomföra åtgärderna under planens genomförandetid.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.8",
      "sentiment": 1.0,
      "quote": "Vi är positiva till förslaget som är särskilt viktigt för genomförandet av klimatanpassningsåtgärder i områden med risk för översvämning vid tillfälliga höga nivåer i havet eller vid skyfall.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.9",
      "sentiment": 0.2,
      "quote": "Lagförslaget innebär dock att kommunerna blir skyldiga att agera oavsett om det finns något exploateringstryck eller inte, vilket kan ta resurser från andra nödvändiga processer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.10",
      "sentiment": 0.5,
      "quote": "Förslagets ”visst underlag” bör förtydligas och det behöver framgå utifrån vilken syn på klimatrelaterade risker som detta underlag ska utformas för att anses vara tillräckligt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2.1",
      "sentiment": 0.2,
      "quote": "Länsstyrelsen anser dock att det finns stora problem med att införa områden för kustskydd i miljöbalkens fjärde kapitel.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2.3",
      "sentiment": 0.2,
      "quote": "Vi anser dock att det är en brist att betänkandet inte inkluderat erosion i denna del.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2.4",
      "sentiment": 0.2,
      "quote": "Vi anser dock inte att det är lämpligt att områden där kustskydd ska anläggas automatiskt ska ha status som riksintresse.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2.5",
      "sentiment": -0.5,
      "quote": "Länsstyrelsen ser inte förslaget att avskära Östersjön från världshaven med en skyddsvall som rimligt att genomföra med hänsyn till flera samhällsintressen och gällande miljölagstiftning, däribland vattendirektivet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2.6",
      "sentiment": 1.0,
      "quote": "Förslaget att ge riksintressemyndigheterna i uppdrag att värdera hur ändamålet med sina riksintresseanspråk påverkas av stigande havsnivåer är rimligt.",
      "quote_type": "grund"
