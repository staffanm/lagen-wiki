    },
    {
      "forarbete_id": "sec15",
      "sentiment": 0.2,
      "quote": "Det gynnar, liksom förslaget om att Va-huvudmannen ska tillhandahålla underlag, exempelvis en fastighetsägares förutsättningar att vidta adekvata klimatanpassningsåtgärder.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec16",
      "sentiment": 0.5,
      "quote": "Förslaget bidrar till att fastighetsägarens förutsättningar att dimensionera sina klimatanpassningsåtgärder rätt gynnas.",
