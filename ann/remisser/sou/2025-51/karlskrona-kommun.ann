      "quote": "Karlskrona kommun är positiv till detta förslag",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a1.6",
      "sentiment": 0.2,
      "quote": "Många äldre VA-ledningar uppfyller inte detta krav, och att anpassa systemen skulle innebära omfattande investeringskostnader – både för utredning och för ombyggnation.",
      "quote_type": "grund"
