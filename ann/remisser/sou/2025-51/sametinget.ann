  "segments": [
    {
      "forarbete_id": "a3.1.14",
      "sentiment": -0.2,
      "quote": "Sametinget anser att det bör framgå i betänkandet - exempelvis under avsnitt 3.1.14 - att renskötseln omfattas av egendomsskyddet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.1",
      "sentiment": -0.2,
      "quote": "Vid sådana beslut är det viktigt att säkerställa att samisk markanvändning och behovet av funktionella marker beaktas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2",
      "sentiment": -0.2,
      "quote": "Sametinget anser att det är viktigt att säkerställa att renbetesmarkerna fortsatt kan användas och att renskötselarbetet kan utföras under tiden arbetena pågår.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.2",
      "sentiment": -0.5,
      "quote": "Sametinget vill lyfta att de bristande kunskaper hos beslutsfattare om samer, samisk kultur och samisk markanvändning utgör ett hinder för ett effektivt klimatanpassningsarbete.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.3.1",
      "sentiment": 0.5,
      "quote": "Det begränsade resursläget riskerar att påverka både kvaliteten och omfattningen av klimatanpassningsinsatser, särskilt i områden där samisk markanvändning och renskötsel behöver beaktas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.4",
      "sentiment": -0.5,
      "quote": "Detta innebär att fördelningen av statliga resurser inte är rättvis, särskilt med tanke på att klimatförändringar påverkar renskötseln direkt och ofta med stora konsekvenser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1",
      "sentiment": -0.5,
      "quote": "Sametinget vill lyfta fram att okunskap hos beslutsfattare om samer, samisk kultur och samisk markanvändning utgör ett hinder för ett effektivt klimatanpassningsarbete.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": 0.5,
      "quote": "Sametinget vill samtidigt understryka att samma typer av hinder även gäller för de samiska näringarna och den samiska kulturen.",
