    },
    {
      "forarbete_id": "sec16",
      "sentiment": 1.0,
      "quote": "Det är ett rimligt krav i en tid där skyfall och ytavrinning orsakar betydande egendoms- och försäkringsskador, och där samordning mellan offentliga och enskilda åtgärder är avgörande.",
      "quote_type": "grund"
    },
    {
