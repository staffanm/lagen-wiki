  "segments": [
    {
      "forarbete_id": "a8.1",
      "sentiment": 1.0,
      "quote": "Helsingborgs stad delar uppfattningen att ”klimatanpassning” som ett eget särskilt skäl inom strandskyddet kan ha relevans eftersom de nuvarande skälen inte fullt ut bedöms vara tillämpbara för sådana åtgärder.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2",
      "sentiment": 1.0,
      "quote": "Helsingborgs stad ställer sig positiv till förslaget.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": 0.5,
      "quote": "Att kommuner och VA-organisationer får möjlighet att anlägga öppna dagvattenstråk på privat mark, mot ersättning, kommer underlätta klimatanpassning i tätbebyggda områden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4",
      "sentiment": 0.5,
      "quote": "Förslaget är i linje med dagens rättspraxis, men innebär ett viktigt tydliggörande i lagtexten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5",
      "sentiment": 0.5,
      "quote": "Förslaget syftar till att stärka samverkan och förutsägbarhet i dimensionering av åtgärder, vilket kan förbättra planprocessen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.6",
      "sentiment": 0.5,
      "quote": "Vi tycker det är bra att krav på redovisning kompletteras så att det utmynnar i ett tydligt krav på redovisning av var kommunen anser att riskerna bör mötas med förebyggande åtgärder.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7",
      "sentiment": 1.0,
      "quote": "Detta kan gälla både kvartersmark och allmän platsmark och säkerställer att marken inte bebyggs eller förändras på ett sätt som försvårar framtida skyddsåtgärder.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.8",
      "sentiment": 1.0,
      "quote": "Det är värdefullt för kommunen att kunna villkora bygglov för att säkerställa klimatskydd för flera fastigheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.9",
      "sentiment": 0.5,
      "quote": "Förslaget innebär en anpassning till en reell risk som redan finns.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.10",
      "sentiment": 1.0,
      "quote": "Förslaget är i linje med nuvarande lagstiftning som ger kommunen en skyldighet att lämna upplysningar och information och kan eventuellt bidra till att fler fastighetsägare klimatanpassar sina fastigheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.11",
      "sentiment": 1.0,
      "quote": "Förslaget fokuserar på de individer som är mest utsatta och har svårast att klara värmeböljor och där risken för hälsoeffekter är som störst, vilket vi ser som en rimlig prioritering ur ett samhällsekonomiskt och folkhälsoperspektiv.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2.1",
      "sentiment": 0.5,
      "quote": "Vi tycker att det är bra att staten tar ett ansvar för att bedöma hur risken för översvämningar längs kusten ska mötas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.5",
      "sentiment": 0.2,
      "quote": "På grund av den stora risken för överklaganden är det också bra om kommuner kan hänvisa till nationellt beslutade riktlinjer.",
