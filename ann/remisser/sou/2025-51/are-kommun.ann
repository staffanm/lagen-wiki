  "segments": [
    {
      "forarbete_id": "sec8",
      "sentiment": -1.0,
      "quote": "I lämplig skala bör detta redan kunna framgå av översiktsplanen och ett lagkrav framstår inte som nödvändigt eller motiverat.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec9",
      "sentiment": -0.5,
      "quote": "I kommuner med äldre planer eller i områden där riskbilden har förändrats kraftigt riskerar det att leda till omfattande kostnader för utredningar, handläggning och ersättningsfrågor.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec10",
      "sentiment": -1.0,
      "quote": "Behovet, nyttan och de ekonomiska konsekvenserna av förslaget är inte tillräckligt belysta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec11",
      "sentiment": 0.8,
      "quote": "Förslaget kan underlätta förvaltningen av allmänna VA-anläggningar och göra det mer likvärdigt att välja mellan öppna och rörförlagda lösningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec12",
      "sentiment": 0.5,
      "quote": "Skyfall och erosion, som senast 2023 orsakade omfattande störningar, visar behovet av att snabbt kunna vidta åtgärder för att skydda kritisk infrastruktur.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.1",
      "sentiment": 0.2,
      "quote": "En modell som i huvudsak bygger på avgifter riskerar att leda till rättsliga prövningar, fördröjda åtgärder och höga administrativa kostnader, snarare än det förebyggande arbete som medborgarna har behov av.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec13",
      "sentiment": 0.2,
      "quote": "Att låsa mark i detaljplan för framtida åtgärder som kanske aldrig byggs kan vara svårt att försvara samhällsekonomiskt, särskilt i kommuner där marken är en begränsad resurs.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec14",
      "sentiment": 0.5,
      "quote": "För en kommun som Åre, där risker för ras, skred, erosion och skyfall är påtagliga, är det viktigt att kunna ställa krav på förebyggande åtgärder redan i samband med nybyggnation.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec15",
      "sentiment": -1.0,
      "quote": "Utredningen har heller inte visat något behov som motiverar lagstiftning, eller förväntad effekt av kravet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec16",
      "sentiment": 0.2,
      "quote": "Utan stöd riskerar uppgifterna att bli ojämförbara mellan kommuner, vilket kan försvåra snarare än underlätta klimatanpassningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec17",
      "sentiment": 0.2,
      "quote": "Utan metodstöd och finansiering finns en risk att kommuner får olika tolkningar och att kraven blir resurskrävande snarare än styrande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec18",
      "sentiment": 0.5,
      "quote": "Det är rimligt att åtgärder som syftar till att skydda bebyggelse, infrastruktur eller samhällsviktiga funktioner i vissa fall får företräde.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.6",
      "sentiment": 1.0,
      "quote": "Ett lagstadgat ansvar för kommunerna utan motsvarande resurser riskerar att urholka det kommunala självstyret och skapa en obalans mellan uppdrag och faktiska möjligheter att genomföra det.",
      "quote_type": "grund"
    }
  ]
