  "overall": {
    "sentiment": 0.5,
    "quote": "Samtidigt vill kommunen betona att klimatanpassning i praktiken bara kan bli effektiv om staten tar ett tydligt ansvar för finansiering, kunskapsstöd och samordning.",
    "quote_type": "grund"
