  "segments": [
    {
      "forarbete_id": "a1.1",
      "sentiment": 0.5,
      "quote": "Rent ekonomiskt är Örebro kommun positiva till förslaget om medfinansiering då Örebro kommun är den kommun med näst störst antal byggnader inom riskområde för översvämning från sjöar och vattendrag vid BHF (Beräknat Högsta Flöde), efter Karlstad kommun.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.4",
      "sentiment": 1.0,
      "quote": "Förslag till ändring i ledningsrättslagen ser Örebro kommun positivt på och det är en nödvändig utveckling för de typer av klimatanpassningsåtgärder som behövs.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.7",
      "sentiment": 0.2,
      "quote": "Det framstår som rimligt att redovisa områden inom vilka kommunen avser att ta initiativ till fysiska åtgärder för att skydda mot sådana risker.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.9",
      "sentiment": -0.5,
      "quote": "Särskilt med hänsyn till att utredningen inte redogör på ett tydligt sätt vilka konsekvenser det kan bli med exempelvis skadestånd om kommunen inte uppfyller sin skyldighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.2",
      "sentiment": -0.5,
      "quote": "Örebro kommun anser att förslaget därmed inte är tillräckligt utrett och att konsekvenser i form av skadestånd för kommunerna behöver utredas innan lagstiftaren går vidare med förslaget.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.10",
      "sentiment": -0.5,
      "quote": "En sådan reglering skulle få stora konsekvenser för kommunerna både resursmässigt och kostnadsmässigt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": 1.0,
      "quote": "Kommunen ställer sig bakom utredningens bedömning att detta är ett nödvändigt och välmotiverat steg för att säkerställa en långsiktigt hållbar och rättssäker hantering av va-infrastrukturen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4",
      "sentiment": 0.2,
      "quote": "Samtidigt vill påpekas att det finns ett stort behov av förtydliganden för att förslaget ska kunna tillämpas på ett rättssäkert och praktiskt genomförbart sätt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5",
      "sentiment": -1.0,
      "quote": "Det saknar praktisk förankring, riskerar att skapa fler problem än det löser, och bygger på en förenklad bild av både vasystemens komplexitet och fastighetsägarnas förutsättningar att tolka teknisk information.",
