    {
      "forarbete_id": "a8.6",
      "sentiment": -0.8,
      "quote": "Översiktsplanen är dock ett långsamt planinstrument och det är tveksamt att det är rätt verktyg för att redovisa åtgärdsförslag som är relevanta på fastighetsnivå.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7",
      "sentiment": -0.2,
      "quote": "Skyldighet för huvudmannen till förvärv på fastighetsägarens begäran kan komma långt in framtiden och skapar en stor osäkerhet.",
