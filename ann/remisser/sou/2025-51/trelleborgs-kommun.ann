    },
    {
      "forarbete_id": "sec19",
      "sentiment": 0.2,
      "quote": "Trelleborgs kommun ser positivt på förslaget i utredningen då staten har flera intressen längs med Trelleborgs kust och behöver därmed ta ansvar för att inte bara bevaka dessa utan även skydda dem.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec17",
      "sentiment": 0.0,
