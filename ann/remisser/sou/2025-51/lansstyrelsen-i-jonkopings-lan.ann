  "segments": [
    {
      "forarbete_id": "a7",
      "sentiment": 0.2,
      "quote": "Det är utmanande för många kommuner att finansiera en sådan funktion vilket skapar hinder för att utveckla och upprätthålla ett systematiskt klimatanpassningsarbete.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.1",
      "sentiment": -1.0,
      "quote": "Enligt länsstyrelsens bedömning är de särskilda skäl som redan anges i strandskyddslagstiftningen tillräckliga för att hantera behovet av klimatanpassningsåtgärder inom strandskyddat område.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2",
      "sentiment": 1.0,
      "quote": "Det är positivt att förslaget ger ökade möjligheter till att reparera områden och infrastruktur som tagit skada till följd av olyckor eller kan tänkas utgöra en alltför stor risk för att det ska anses vara acceptabelt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen tillstyrker förslaget.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.4",
      "sentiment": 0.2,
      "quote": "Behovet av en differentierad bedömning utifrån hur bebyggelsen ser ut bedömer Länsstyrelsen måste kvarstå och lyftas fram i lagtexten för att säkerställa att en anläggnings utformning ska anses tillgodose skäliga anspråk på säkerheten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5",
      "sentiment": 1.0,
      "quote": "Det är positivt att en fastighetsägare får information för att kunna vidta relevanta åtgärder och länsstyrelsen delar utredningens bedömning att dagvattenkapacitet vid en fastighet sällan omfattas av sekretess.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.6",
      "sentiment": 0.2,
      "quote": "Länsstyrelsen anser dock att även den föreslagna skrivningen riskerar att innebära otydlighet och att formuleringen behöver vässas och bli skarpare avseende åtgärder.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7",
      "sentiment": 0.0,
      "quote": "Länsstyrelsen ifrågasätter dock lämpligheten i att planlägga mark för ny bebyggelse och samtidigt utgå ifrån att det kommer att behöva byggas skyddsvallar längre fram, något som bör aktualisera frågor om markens lämplighet och om huruvida lokaliseringen är den rätta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.8",
      "sentiment": 0.5,
      "quote": "Det är också viktigt att möjligheterna med utökade villkor inte leder till långa processer som föregår genomförandet, till exempel att villkor ställs som sedan blir svåra att hantera i genomförandeskedet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.9",
      "sentiment": -0.5,
      "quote": "Om detta krav genomförs utan att stöd tillförs kommunerna kan det komma att ta resurser från arbetet med att ta fram nya översiktsplaner och detaljplaner och därmed stå i konflikt med andra nationella och lokala mål om bostadsbyggande, tillväxt, grön omställning med mera.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.10",
      "sentiment": 0.5,
      "quote": "Att bara redovisa risker för påverkan av naturhändelse ger inte full vägledning till vilka åtgärder som är lämpliga för den enskilda fastigheten, exempelvis ur kulturmiljöhänseende.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.11",
      "sentiment": 0.2,
      "quote": "Gällande efterlevnad, tillsynsmyndighet och konsekvenser om överträdelser sker kontinuerligt behövs dock förtydliganden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2.1",
      "sentiment": -0.5,
      "quote": "Länsstyrelsen ser med oro på att förslaget i sin nuvarande form innebär att man tar finansieringen för detta från de få redan existerande potterna för klimatanpassning, exempelvis åtgärder för ras och skred och för statligt kunskapsuppbyggande.",
      "quote_type": "grund"
