  },
  "overall": {
    "sentiment": 0.2,
    "quote": "Sammanfattningsvis ser Laholms kommun positivt på ambitionen att stärka klimatanpassningsfrågorna i översiktsplaneringen, men framhåller att lagstiftningen måste klargöra ansvarsfördelningen, att nationella riktlinjer krävs för att skapa enhetlighet, och att resurser och kompetens måste tillföras för att kommunerna ska kunna uppfylla kraven på ett ändamålsenligt sätt.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a6.1.1",
      "sentiment": 1.0,
      "quote": "Avsaknaden av gemensamma riktlinjer leder idag till osäkerhet i beslutsfattande och en risk för bristande likvärdighet mellan olika kommuner och regioner.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7",
      "sentiment": 0.5,
      "quote": "I dag saknas en tydlig struktur för hur arbetet ska samordnas och följas upp, vilket försvårar både långsiktig planering och genomförande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.1",
      "sentiment": 0.2,
      "quote": "Kommunen vill dock framhålla att om dispens ges alltför lättvindigt finns en risk att allmänhetens tillgång till stränder successivt urholkas, särskilt i kustnära lägen där trycket redan idag är stort.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": 0.2,
      "quote": "Kommunen vill därför understryka att VA-huvudmannens ansvar måste klargöras för att undvika framtida oklarheter och konflikter kring underhåll, finansiering och långsiktig funktionalitet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4",
      "sentiment": 1.0,
      "quote": "Ett lagkrav skapar en enhetlig och förutsägbar standard för kommuner och VA-huvudmän, vilket minskar osäkerhet vid planering, byggande och tillsyn.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.6",
      "sentiment": 0.2,
      "quote": "Förslaget innebär vidare mer komplexa planeringsprocesser och krav på omfattande tekniska underlag, såsom hydrologiska modeller, geotekniska utredningar och riskkartor.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7",
      "sentiment": 0.2,
      "quote": "Om varje kommun själv väljer vilka scenarier som motiverar reservering av mark finns risk för ojämn tillämpning, rättsosäkerhet för fastighetsägare och potentiella konflikter med exploatörer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.8",
      "sentiment": 0.5,
      "quote": "Det ger en ökad möjlighet att planlägga områden som idag kräver åtgärder kopplat till skydd och säkerhet för att vara möjliga att bebygga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.9",
      "sentiment": -0.5,
      "quote": "Tidsfristen på sex år från det att lagändringen har trätt i kraft bedöms således som väl begränsad för att kommuner ska hinna åtgärda alla riskutsatta planer med outnyttjade byggrätter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.10",
      "sentiment": 0.2,
      "quote": "Utan tydliga riktlinjer riskerar förslaget att skapa osäkerhet både för kommunens resurser och för fastighetsägare som planerar åtgärder.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.11",
      "sentiment": 0.2,
      "quote": "Förslaget reglerar vidare inte metoder för att uppnå målen, vilket medför en risk att kortsiktiga lösningar, exempelvis mobila luftkonditionerings- eller fläktlösningar, används.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2.1",
      "sentiment": 0.2,
      "quote": "Uppdraget bedöms kunna genomföras på endast 18 månader, vilket kan vara en kort tid för en komplex och omfattande uppgift.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2.4",
      "sentiment": 0.2,
      "quote": "Om riksdagen beslutar om statens åtagande utan lokal förankring riskerar besluten att upplevas som toppstyrda, vilket kan försvåra både planering och genomförande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.5",
      "sentiment": 0.2,
      "quote": "Kommunen vill framhålla att även åtgärder som kräver regelbundet underhåll kan vara nödvändiga och verksamma, och att definitionen av varaktigt skydd därför bör omprövas för att bättre motsvara praktiska behov och lokala förutsättningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.6.1",
      "sentiment": -0.2,
      "quote": "Det är oklart hur beslutsförfarandet ska förhålla sig till annan lagstiftning, såsom planoch bygglagen och miljöbalken.",
      "quote_type": "grund"
    }
  ]
