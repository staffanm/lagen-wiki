    }
  },
  "overall": {
    "sentiment": 0.2,
    "quote": "Flera av förslagen som utredningen lämnar är bra, en del kan komma att kräva vidare utredning och vissa förslag skulle innebära stora svårigheter och kostnader för kommunerna att genomföra.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a8.1",
      "sentiment": -0.5,
      "quote": "Risken med ett nytt undantagsskäl är att enskilda kan komma att göra åtgärder med hänvisning till att de fått strandskyddsdispens men inte inser att åtgärden också kräver tillstånd för vattenverksamhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2",
      "sentiment": 0.5,
      "quote": "Kommuner måste emellertid vara delaktiga i processen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": 0.8,
      "quote": "Kommunen noterar att förslaget medger att dessa öppna dagvattenanläggningar kan anpassas på ett sätt så att även andra typer av regn än de som ska hanteras inom allmänna va-anläggningar kan bortledas (skyfall), vilket är positivt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4",
      "sentiment": 0.2,
      "quote": "Det kommer kräva mycket stora investeringskostnader för att få den kapacitet i ledningssystemet som lagkravet innebär.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5",
      "sentiment": 0.5,
      "quote": "Kommunen anser dock att det tydligt behöver framgå vilken typ av uppgifter och utifrån vilken syn på klimatrelaterade risker som uppgifterna ska utgå ifrån samt vilket ansvar som va-huvudmannen har om en översvämning trots allt sker.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.6",
      "sentiment": 0.0,
      "quote": "Översiktsplanen är vägledande för kommunernas fysiska planering och exploatering och är varken juridiskt bindande eller att betrakta som en genomförandeplan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7",
      "sentiment": 1.0,
      "quote": "Kommunen delar betänkandets bedömning att det är av stort värde att kunna utforma detaljplaner så att de även fungerar i ett förändrat klimat, genom att möjliggöra att införa bestämmelser som gör det möjligt att på sikt anlägga kustskydd mot erosion och översvämning eller att kunna vidta andra skyddsåtgärder som föranleds av klimatförändringarna, men där det inte finns något behov av att genomföra åtgärderna under planens genomförandetid.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.8",
      "sentiment": 0.2,
      "quote": "Kommunen ser dock svårigheter med kompetens kopplat till dessa frågor hos handläggare som har mycket kort tid på sig att bedöma bygglovshandlingar, särskilt när det gäller anläggningar för hantering av skyfall.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.9",
      "sentiment": -1.0,
      "quote": "Det är både en mycket stor inskränkning av det kommunala självstyret och kommunala planmonopolet och en helt orimlig syn på klimatrelaterade risker i befintlig stadsmiljö.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.10",
      "sentiment": 0.0,
      "quote": "I enlighet med både 3 kap 5 § 4 pkt och 12 kap 3 § PBL så tas detta underlag fram redan idag i översiktsplaneprocessen (både nu gällande rätt och med föreslagen förändring) och utgör därmed en allmän handling.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.11",
      "sentiment": 0.8,
      "quote": "Ystads kommun ställer sig positiv till förslaget och vill lyfta att lagstiftaren bör överväga om det även ska omfatta förskolor och skolor.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2.1",
      "sentiment": 0.5,
      "quote": "Kommunen anser dock att det finns delar av förslaget som behöver utvecklas vilket tydliggörs nedan och i följande punkter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2.3",
      "sentiment": -0.2,
      "quote": "Ystads kommun anser att uppdraget snarare ska omfatta att identifiera (jmf förslagets formulering där det står prioritera) de kuststräckor där det är av nationellt intresse att långsiktigt skydda befintliga värden mot översvämningar och erosion.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2.6",
      "sentiment": -0.2,
      "quote": "Ystads kommun vill uppmärksamma lagstiftaren på att detta uppdrag inte är möjligt att genomföra utan en gemensam, nationell syn på klimatrelaterade risker, vilken tidshorisont som riskbedömningarna ska utgå från samt en nationell syn på vad begreppet ”återkommande” innebär.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.5",
      "sentiment": 0.0,
      "quote": "Ystads kommun anser att den föreslagna finansieringsmodellen är intressant, men den måste problematiseras och utvecklas ytterligare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7",
      "sentiment": 0.5,
      "quote": "ett samordningsansvar utan skyldigheter snarare skapar felaktiga förväntningar hos befintliga fastighetsägare, vilket inte bidrar till att klimatanpassningen av Sverige sker i högre grad.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": -0.5,
      "quote": "Ystads kommun ifrågasätter ställningstagandet att kommunerna idag har den rådighet som krävs för markåtkomst för åtgärder som behöver komma till stånd.",
      "quote_type": "grund"
    }
  ]
}