  "segments": [
    {
      "forarbete_id": "sec18",
      "sentiment": 0.2,
      "quote": "Dock kan det finnas fördelar med den ökade tydlighet som förslaget kommer att medföra för såväl enskilda som för prövande myndigheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec11",
      "sentiment": 1.0,
      "quote": "Det finns ett stort behov av den föreslagna ändringen, och det är angeläget att den genomförs, i syfte att säkra kapaciteten i befintliga och kommande dagvattennät.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec17",
      "sentiment": 1.0,
      "quote": "Lantmäteriet bedömer, utifrån myndighetens förrättningsverksamhet, att förslaget kan komma att innebära ökad tydlighet och förutsebarhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec16",
      "sentiment": 0.5,
      "quote": "Lantmäteriet föreslår att utredningens förslag i denna del kompletteras med att uppgiftsskyldigheten gäller med de begränsningar som framgår av offentlighets- och sekretesslagen, enligt samma systematik som gäller för bl.a. 10 § förvaltningslagen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec8",
      "sentiment": 1.0,
      "quote": "Lantmäteriet tillstyrker förslaget, då det underlättar myndighetens arbete att information och kommunernas bedömningar i dessa delar görs än mer tydliga och tillgängliga för både myndigheter och enskilda.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec13",
      "sentiment": 0.5,
      "quote": "Risken är då att lovfria byggnader uppförs över mark som lagts ut som markreservat för klimatanpassningsanläggningar vilket kan försvåra eller omöjliggöra anläggandet/genomförandet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec14",
      "sentiment": 1.0,
      "quote": "Lantmäteriet tillstyrker förslaget, som bedöms vara ändamålsenligt utformat och som möjliggör klimatanpassningsanläggningar som inte är förlagda inom en specifik fastighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec9",
      "sentiment": 0.2,
      "quote": "Det framgår dock inte av den föreslagna lagtexten inom vilken tidsrymd behövliga planändringar/upphävanden ska vara genomförda.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec15",
      "sentiment": 0.5,
      "quote": "Lantmäteriet föreslår, liksom avseende förslaget om upplysningsskyldighet ang. dagvattenanläggnings kapacitet ovan, att utredningens förslag i denna del kompletteras med att uppgiftsskyldigheten gäller med de begränsningar som framgår av offentlighets- och sekretesslagen, enligt samma systematik som gäller för bl.a. 10 § förvaltningslagen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2.1",
      "sentiment": 0.5,
      "quote": "Inrättandet av ett nytt riksintresse med den föreslagna formuleringen kan då komma att omfatta bebyggda områden såväl inom som utom detaljplan.",
      "quote_type": "grund"
