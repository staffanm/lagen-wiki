  "segments": [
    {
      "forarbete_id": "a8.1",
      "sentiment": -1.0,
      "quote": "Genomförandet av klimatanpassningsåtgärder som särskilt skäl för dispens från strandskyddet anser vi redan är möjligt idag enligt 7 kap. 18 e § 3 Miljöbalken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.6",
      "sentiment": 0.5,
      "quote": "Länsstyrelsen vill dock betona att implementeringen kommer kräva ytterligare vägledning från nationell nivå för att kommunerna ska ha tillräckliga förutsättningar för att uppnå förslagets effekt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.9",
      "sentiment": -1.0,
      "quote": "förslaget kräver omfattande resurser som inte finns i dagsläget, genomförandetiden är inte rimlig, och förslaget saknar en tydlig uppföljningsprocess.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.11",
      "sentiment": 0.5,
      "quote": "Precis som utredningen förtydligar är värmeböljor den mest konsekventa klimatrelaterade risken för människors liv och hälsa i Sverige och det är viktigt att vi har en lagstiftning som förebygger detta på ett rättvist sätt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2.1",
      "sentiment": -0.2,
      "quote": "Finansieringen av förslaget bör inte riskera att skada förutsättningarna för att anta klimatanpassningsåtgärder i andra delar av Sverige.",
      "quote_type": "grund"
    }
  ]
