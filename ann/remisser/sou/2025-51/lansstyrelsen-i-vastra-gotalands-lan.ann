  "segments": [
    {
      "forarbete_id": "a8.1",
      "sentiment": -0.5,
      "quote": "Vi anser dock att det behövs striktare kriterier för vad som är en giltig klimatanpassningsåtgärd och vad den avser skydda.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2",
      "sentiment": 0.5,
      "quote": "Länsstyrelsen anser dock att lagändringen även bör omfatta erosion, som inte uttryckligen nämns.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": 0.5,
      "quote": "Ur ett samhällsekonomiskt perspektiv är det mycket viktigt att underlätta för att anlägga öppna dagvattenlösningar som kan fördröja eller leda bort vatten som en integrerad del av dagvattensystemet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4",
      "sentiment": -0.5,
      "quote": "Återkomsttiden på 10 år anses dock vara ett otillräckligt mått på kapacitet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5",
      "sentiment": 0.5,
      "quote": "Länsstyrelsen anser att informationsplikten principiellt bör utökas till fastighetsägare som inte själva är riskutsatta men som vill (eller uppmuntras) vidta åtgärder för att fördröja dagvatten på sin fastighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.6",
      "sentiment": 0.5,
      "quote": "Länsstyrelsen anser att det är rimligt att redovisningen av risker i översiktsplanen utökas med förslag på åtgärder.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7",
      "sentiment": 0.2,
      "quote": "Länsstyrelsen vill dock belysa att när en detaljplan tas fram, behöver det framgå av planbeskrivningen hur markreservatet är tänkt att genomföras och vilka konsekvenser detta får för fastighetsägarna och andra berörda.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.8",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen tillstyrker förslaget.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.9",
      "sentiment": 0.5,
      "quote": "Länsstyrelsen anser att de 6 år som kommunerna har på sig att upphäva olämpliga detaljplaner borde förlängas till 10 år.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.10",
      "sentiment": 0.2,
      "quote": "Det bör dock förtydligas vem som ansvarar för att tillhandhålla underlag för att bedöma risken som avses förebyggas och på vilken detaljnivå.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.11",
      "sentiment": 0.5,
      "quote": "Förslaget är ett viktigt steg för att stärka skyddet för personer som är särskilt känsliga för höga temperaturer och därmed bidra till en mer jämlik hälsa i ett förändrat klimat.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2",
      "sentiment": 0.0,
      "quote": "Detta stämmer inte överens med innebörden i miljöbalkens fjärde kapitel och kan komma att skapa svårigheter i tillämpningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.5",
      "sentiment": 0.2,
      "quote": "Om det som ska skyddas har ett större värde för fastighetsägarna än för allmänna intressen bör inte kommunen tvingas att bekosta hälften av kostnaderna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.6",
