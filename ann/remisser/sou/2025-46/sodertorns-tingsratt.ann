    {
      "forarbete_id": "sec213",
      "sentiment": -0.2,
      "quote": "Den höjning av maxstraffet för en överträdelse av ett tillträdesförbud som utredningen nu föreslår riskerar därför att inte förändra att böter fortsatt kommer att bli påföljden för sådana brott.",
      "quote_type": "grund"
