    },
    {
      "forarbete_id": "a6.4",
      "sentiment": 1.0,
      "quote": "RF välkomnar utredarens förslag om effektivare tillträdesförbud för en mer förutsägbar tillämpning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.2",
      "sentiment": 1.0,
      "quote": "Frågan är av avgörande betydelse för att idrottsföreningar ska kunna leva upp till de krav som ställs och, på ett rättssäkert sätt, kunna identifiera och stänga av de individer som begår brott och ordningsstörningar i samband med idrottsevenemang.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec95",
      "sentiment": 1.0,
      "quote": "RF håller med utredaren om att det är viktigt att bevara idrottsrörelsens självständighet och att statsmakterna inte onödigtvis ska reglera, eller ha synpunkter på, sådant som idrottsrörelsen är bäst skickad att sköta själv.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2",
      "sentiment": 0.5,
      "quote": "Frågan om arrangörsavstängningar är viktig och vi noterar att utredaren lyfter den handbok som RF, i samarbete med bl.a. Svenska Fotbollförbundet och Svenska Ishockeyförbundet, tagit fram som ett verktyg för att stänga av besökare som begår brott eller ordningsstörningar i samband med idrottsevenemang.",
      "quote_type": "grund"
