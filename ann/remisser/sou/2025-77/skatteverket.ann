    },
    {
      "forarbete_id": "a7.7",
      "sentiment": 0.2,
      "quote": "För att försvåra för individer som vill missbruka lönegarantin anser Skatteverket att det behövs en reglering som anger att en utbetalning ska gå till arbetstagarens eget bankkonto.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2",
      "sentiment": -0.5,
      "quote": "Utformningen av lagregeln är otydlig och eftersom förutsättningarna för att få anstånd respektive avtala om en avbetalningsplan inte skiljer sig åt så fyller regeln om avtal ingen funktion och bör tas bort.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": -0.5,
      "quote": "En sådan skrivning riskerar att möjliggöra bedrägerier.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.2",
      "sentiment": 0.5,
      "quote": "Samma argument som används för varför staten ska ha rätt till regressrätt avseende utbetald lönegaranti kan användas som motivering för att staten ska ha rätt till återbetalning av betalda arbetsgivaravgifter avseende lönegaranti vid både konkurs och företagsrekonstruktion.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a15.1.9",
      "sentiment": 0.2,
      "quote": "För att det ska vara möjligt för Skatteverket att använda uppgifterna även för analys föreslår myndigheten att det i förordningen framgår att uppgifter även får lämnas ut för utveckling av kontrollverksamheten alternativt för utveckling av verksamheten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.1",
      "sentiment": 0.2,
      "quote": "När det gäller släktförhållanden avseende arbetstagare som har invandrat till Sverige så saknas sådana uppgifter i Skatteverkets beskattningsverksamhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.2",
      "sentiment": 0.2,
      "quote": "Skatteverket önskar även en motsvarande reglering i förordningen när tillsynsmyndigheten uppmärksammar att en förvaltare eller rekonstruktör missköter sig i förhållande till sitt uppdrag på ett sådant sätt att det också kan riskera att påverka tilltron till upprättade underlag eller annan information som lämnas inom ramen för lönegarantilagen.",
