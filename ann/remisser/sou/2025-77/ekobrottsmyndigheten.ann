    },
    {
      "forarbete_id": "a5.3",
      "sentiment": 0.5,
      "quote": "Mer utvecklade förarbeten förbättrar förutsättningarna för likvärdiga bedömningar och underlättar kontrollverksamheten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1",
      "sentiment": 1.0,
      "quote": "Förslaget kan förväntas medföra att en sökande blir mer uppmärksam på vikten av att lämna korrekta uppgifter och därigenom avskräckas från missbruk av systemet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1",
      "sentiment": -0.2,
      "quote": "För att undvika att lönegarantin kan utnyttjas genom falska eller styrda identiteter bör Skatteverket ges möjlighet att under vissa omständigheter begära fysisk inställelse.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": 1.0,
      "quote": "Förvaltarna, som har bra insikt i verksamheten och som ofta har goda förutsättningar att se indikationer på om något inte stämmer, har möjlighet att kontrollera kontoutdrag och bokföring samt har kontakt med arbetstagarna och kan då ställa frågor om sånt som de reagerar på.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": -0.5,
      "quote": "En sådan möjlighet öppnar upp för missbruk av systemet och att de underlag som lämnas till Skatteverket inte är tillförlitliga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.7.4",
      "sentiment": 1.0,
      "quote": "Det finns stora fördelar med att på förhand kunna förhindra att felaktiga belopp betalas ut i stället för att i efterhand försöka återkräva felaktigt utbetalda belopp.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5",
      "sentiment": -0.2,
      "quote": "Ekobrottsmyndigheten bedömer att det för en effektiv modell krävs en nationell riskmodell, så att riskerna som identifieras blir enhetliga hos samtliga myndigheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.1",
      "sentiment": 1.0,
      "quote": "Förslaget medför att flera fall av missbruk kommer att kunna lagföras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.1",
      "sentiment": -0.2,
      "quote": "Regelverket bör därför tydligare spegla dessa risker och säkerställa att kontrollkedjan inkluderar bolags- och nätverksstrukturer, inte enbart individnivå.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.1",
      "sentiment": 1.0,
      "quote": "Ekobrottsmyndigheten är den brottsbekämpande myndighet som har störst erfarenhet av att handlägga brott som begås genom företag eller med företag som brottsverktyg.",
