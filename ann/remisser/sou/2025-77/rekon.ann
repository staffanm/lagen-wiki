  },
  "overall": {
    "sentiment": 0.5,
    "quote": "REKON tillstyrker i huvudsak regeringens förslag till översyn av och ändringar i den statliga lönegarantin.",
    "quote_type": "standpunkt"
  },
  "segments": [
    {
      "forarbete_id": "a3.5",
      "sentiment": 0.5,
      "quote": "Mot bakgrund härav synes förslaget att Skatteverket ska överta huvudansvaret för handläggningen av samtliga lönegarantiärenden välmotiverat, förutsatt att Skatteverket kan upprätthålla en både rättssäker och skyndsam handläggning av ärendena.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13",
      "sentiment": 1.0,
      "quote": "Förvaltarens möjlighet att anmärka mot Skatteverkets bevakning kopplad till utbetald lönegaranti säkerställer att konkurslagens regler om betalningsrätt kan upprätthållas och förmedlar förvaltarens oberoende i förhållande till staten som borgenär.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1",
      "sentiment": 0.2,
      "quote": "Det kan därför förutskickas att egna ansökningar om lönegaranti allt som oftast kommer att vara i behov av kompletteringsförelägganden från Skatteverkets sida.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.6",
      "sentiment": -0.5,
      "quote": "En sådan förändring skulle bidra till likabehandling bland arbetstagarna och i större utsträckning uppfylla lagen syfte såsom social skyddslagstiftning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.6",
      "sentiment": -0.5,
      "quote": "REKON önskar framhålla att den föreslagna regleringen om att lönegarantianspråk prekluderas åtta månader efter konkursutbrottet riskerar att diskriminera föräldralediga arbetstagare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.1",
      "sentiment": -1.0,
      "quote": "REKON ansluter sig till Advokatsamfundets bedömning i sitt remissvar att den föreslagna avräkningsregeln (7 § andra stycket lönegarantilagen och 12 § andra stycket förmånsrättslagen) inte är förenlig med lönegarantidirektivet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.3",
      "sentiment": 1.0,
      "quote": "Den nu föreslagna utvidgningen i 3 kap. 3 § lönegarantilagen är därför välkommen och ger samtliga aktörer i lönegarantihandläggningen goda verktyg att minska felaktiga utbetalningarna från garantin.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2",
      "sentiment": 0.2,
      "quote": "REKON passar i denna del på att framföra att det är av stor vikt för handläggningen av konkursen/rekonstruktionen att Skatteverket på lämpligt sätt tillhandahåller förvaltaren respektive rekonstruktören information som också innefattar en sammanställning över samtliga arbetstagares beviljade lönegarantimedel i insolvensförfarandet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.6",
      "sentiment": -0.5,
      "quote": "Mot denna bakgrund ligger det inte i arbetstagarnas intresse att särskilda kostnader ska betalas först, såvida inte dessa brister först åtgärdas i nuvarande utbetalningsfunktion.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10",
      "sentiment": 0.0,
      "quote": "Lagstiftaren bör överväga om det kan vara lämpligt att rubricerad situation tillföra bestämmelser om vad som blir utfallet för fordringarna då arbetstagaren har avlidit före eller efter beslutet om konkurs eller rekonstruktion.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.2",
      "sentiment": -0.5,
      "quote": "Ett genomförande av lagförslaget i denna del kommer dock otvetydigt att bli konkursdrivande, eftersom den ökade ekonomiska belastningen genom återbetalningsskyldigheten innebär att färre företag kommer i fråga för ett rekonstruktionsförfarande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.1",
      "sentiment": 1.0,
      "quote": "I sammanhanget erinrar REKON om att motsvarande uppgifter i många fall skulle komma till stor nytta även vid de brottsutredningar som förvaltarna genomför enligt konkurslagen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec44",
      "sentiment": -1.0,
      "quote": "REKON avstyrker förslaget om en vitessanktionerad upplysningsplikt för förvaltare och rekonstruktörer, eftersom denna vitesmöjlighet framstår som överflödig.",
      "quote_type": "grund"
    }
  ]
}