  "overall": {
    "sentiment": -0.2,
    "quote": "Gentekniknämnden stödjer avtalets intention att säkerställa bevarande och hållbar användning av biologisk mångfald i havsområden utanför nationell jurisdiktion, samt målet att nå en rimlig och rättvis fördelning av nytta som uppstår vid verksamhet som avser marina genetiska resurser från dessa områden.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "sec268",
      "sentiment": 0.5,
      "quote": "Deponering av data i nationella databaser innebär en stor risk för fragmentisering, och att informationen inte blir öppet tillgängligt för alla, oavsett språk och nationell tillhörighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec289",
      "sentiment": -0.2,
      "quote": "Det är väsentligt att begrepp och definitioner inte införs som skulle kräva spårning av aktiviteter i databaserna, eller som är otydliga och därmed rättsosäkra.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3.3",
      "sentiment": -0.5,
      "quote": "Det är väsentligt att Sveriges lagstiftning och EU:s kommande direktiv på området harmoniserar och det är mycket troligt att EU inte kommer att definiera digital sekvensinformation.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec299",
      "sentiment": 1.0,
      "quote": "Nämnden håller med om utredningens resonemang i frågan.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec301",
      "sentiment": -1.0,
      "quote": "Doktorandprojekt löper i regel över fyra år och om forskare måste lämna ut data inom tre år efter tillträde finns risk att det blir svårt att anställa doktorander på projekt som använder den typen av data.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec302",
      "sentiment": -1.0,
      "quote": "Det kan handla om tusentals, eller för digital sekvensinformation miljontals av sekvenser, och det blir ett orimligt ansvar för den som ansvarar för en samling eller databas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec302",
      "sentiment": -1.0,
      "quote": "Nämnden anser att det skulle ge en oproportionerligt stor administrativ börda relativt den nytta en sådan rapport skulle ge.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec306",
      "sentiment": 0.0,
      "quote": "Om intentionen är att även genetiska resurser från mikroorganismer ska samlas in och göras tillgängliga kan det finnas skäl att undersöka om någon annan myndighet, kanske något av universiteten, vore lämpligare att få det uppdraget, då museet idag inte har den typen av samlingar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.2.4",
      "sentiment": -0.2,
      "quote": "Det finns därför risk för viss otydlighet och därmed potentiell rättsosäkerhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec378",
      "sentiment": 1.0,
      "quote": "Gentekniknämnden har inga synpunkter på att Havs- och vattenmyndigheten får uppdraget att utöva tillsyn över verksamheter som hanterar marina genetiska resurser utanför nationell jurisdiktion.",
      "quote_type": "standpunkt"
    }
  ]
}