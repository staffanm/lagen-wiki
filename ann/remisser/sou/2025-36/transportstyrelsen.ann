  "overall": {
    "sentiment": 0.5,
    "quote": "Transportstyrelsen tillstyrker i huvudsak förslagen om Sveriges tillträde till och genomförande av avtalet– The Agreement under the United Nations Convention on the Law of the Sea on the Conservation and Sustainable Use of Marine Biological Diversity of Areas beyond National Jurisdiction (BBNJ).",
    "quote_type": "standpunkt"
