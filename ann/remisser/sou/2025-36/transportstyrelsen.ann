  "segments": [
    {
      "forarbete_id": "sec372",
      "sentiment": 0.2,
      "quote": "Eftersom sjöfart inte är tillståndspliktig enligt miljöbalken idag och Transportstyrelsen inte nämns som samrådspart eller prövningsmyndighet, finns det en risk att tillståndsgivning av verksamheter till sjöss sker utan att Transportstyrelsens regelverk och föreskrifter till fullo beaktas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec20",
      "sentiment": 0.0,
      "quote": "Beroende på vilken funktion och vilken omfattning IMO får i genomförandet av avtalet, kan detta påverka Sveriges engagemang och i förlängningen få organisatoriska konsekvenser för berörda myndigheter, inklusive Transportstyrelsen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec250",
      "sentiment": 0.2,
      "quote": "Det bör dock särskilt beaktas hur sådana åtgärder kan påverka sjöfarten och hur eventuella restriktioner ska hanteras inom ramen för IMO:s regelverk, där Transportstyrelsen har central kompetens och ett särskilt ansvar för det internationella regelutvecklingsarbetet.",
      "quote_type": "grund"
    }
  ]
