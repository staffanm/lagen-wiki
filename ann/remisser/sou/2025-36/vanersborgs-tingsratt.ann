  "segments": [
    {
      "forarbete_id": "sec149",
      "sentiment": 1.0,
      "quote": "Tingsrätten tillstyrker utredningens förslag om krav på miljöbedömning och tillstånd för sådana verksamheter och åtgärder som avses i 2 kap. 1 § i den föreslagna lagen om skydd för biologisk mångfald i havsområden utanför nationell jurisdiktion.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec372",
      "sentiment": 1.0,
      "quote": "Med hänsyn till den kompetens som finns hos Havs- och vattenmyndigheten är det lämpligt att denna myndighet svarar för miljöbedömning, tillståndsprövning och tillsyn.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec216",
      "sentiment": 1.0,
      "quote": "Vidare är det en lämplig ordning att beslut enligt den föreslagna lagen som huvudregel ska överklagas till mark- och miljödomstol.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec155",
      "sentiment": 0.2,
      "quote": "Det bör dock övervägas om det finns skäl att precisera huruvida det finns delar av 2 kap. som inte bör göras tillämpliga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec193",
      "sentiment": -0.2,
      "quote": "Även om 10 kap. miljöbalken bygger på principen om att förorenaren betalar behöver det tydliggöras vad som utgör skäliga återställningsåtgärder och hur 2 kap. 32 § lagen om skydd för biologisk mångfald utanför nationell jurisdiktion förhåller sig till 10 kap. miljöbalken i allmänhet och 10 kap. 5 a § miljöbalken i synnerhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec224",
      "sentiment": -0.5,
      "quote": "Tingsrätten konstaterar att utredningens förslag inte omfattar en särskild forumbestämmelse.",
      "quote_type": "grund"
    }
  ]
