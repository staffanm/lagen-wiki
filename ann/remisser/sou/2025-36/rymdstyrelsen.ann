  "segments": [
    {
      "forarbete_id": "sec373",
      "sentiment": 1.0,
      "quote": "Att ge Havs- och vattenmyndigheten (HaV) ett samordnande ansvar för frågor om biologisk mångfald i havsområden utanför nationell jurisdiktion är väl motiverat och lämpligt utifrån myndighetens nuvarande uppdrag och erfarenhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8",
      "sentiment": 0.5,
      "quote": "Satellitdata kan bidra till att kartlägga och övervaka marina ekosystem och därmed·stödja hållbar förvaltning av genetiska resurser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7",
      "sentiment": 0.5,
      "quote": "Övervakning och efterlevnad av skyddade områden i svårtillgängliga havsområden kräver avancerad fjärranalys och realtidsdata.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5",
      "sentiment": 0.5,
      "quote": "Jordobservationsdata möjliggör objektiva, uppdaterade och jämförbara miljöbedömningar över stora havsområden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9",
      "sentiment": 0.5,
      "quote": "Sverige kan genom sina investeringar i rymdteknik och internationella samarbeten bidra till global kapacitetsuppbyggnad och tekniköverföring, exempelvis via Group on Earth Observations (GEO), och bilaterala samarbeten med olika länder.",
      "quote_type": "grund"
    }
