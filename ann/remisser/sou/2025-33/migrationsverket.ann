  "overall": {
    "sentiment": 0.3,
    "quote": "Samtidigt ser verket risker för det fall det utlänningsrättsliga regelverket belastas med bestämmelser som inte motsvarar faktiska behov och att fler bestämmelser än nödvändigt införs, som leder till överflödig reglering.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a5.5.5",
      "sentiment": -0.2,
      "quote": "Enligt verkets mening vore det att föredra att samma begrepp används så långt det är möjligt och att det är det begreppet som definieras i portalbestämmelsen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.5.6",
      "sentiment": -0.2,
      "quote": "Det kan dock inte bortses ifrån att tillämpningssvårigheter av föreslagna vandelsbestämmelser kan uppstå när de ska tillämpas på andra omständigheter än brott och bristande regelefterlevnad.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.6",
      "sentiment": -0.5,
      "quote": "Det kan komma att få oönskade effekter och medföra att verkets bedömningsutrymme begränsas på ett icke önskvärt sätt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.12",
      "sentiment": -0.2,
      "quote": "Enligt verkets mening hade det varit önskvärt med utvecklade resonemang och mer ledning i denna del.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.3.1",
      "sentiment": -0.2,
      "quote": "Enligt Migrationsverkets mening riskerar rubriken att skapa osäkerhet vid den praktiska tillämpningen och snarare ge intrycket av att kraven för att neka uppehållstillstånd nu ska vara högre än tidigare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.3.2",
      "sentiment": -0.5,
      "quote": "Lagtekniskt framstår därför ändringen som både omotiverad och tveksam.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.6",
      "sentiment": 0.5,
      "quote": "Eftersom avsikten synes vara att bestämmelsen bara ska kunna tillämpas på tidsbegränsade uppehållstillstånd bör detta framgå av lagtexten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.8.1",
      "sentiment": -0.5,
      "quote": "Det bör snarare eftersträvas att inte tynga en i många delar redan svårgenomtränglig lag med återkallelsegrunder som blir tillämpliga i samma situation.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.4",
      "sentiment": 0.5,
      "quote": "Det framstår dock som oklart om utredningens avsikt varit att bestämmelsen ska kunna tillämpas på personer som beviljats ett uppehållstillstånd som skyddsbehövande men sedan får sin skyddsstatusförklaring återkallad",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.7",
      "sentiment": 0.5,
      "quote": "Det kan uppstå situationer där en anmälan görs upprepade gånger och därmed en risk för att bestämmelsen missbrukas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.3",
      "sentiment": -0.5,
      "quote": "Migrationsverket ställer sig frågande till den praktiska betydelsen av bestämmelsen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.8",
      "sentiment": 0.5,
      "quote": "det finns en risk att den uppgiftsskyldighet som föreslås i 17 kap. 7 § utlänningslagen inte fullt ut kommer att få avsedd effekt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.2",
      "sentiment": 0.0,
      "quote": "Migrationsverket anser mot denna bakgrund att det kan finnas anledning att överväga om vissa av de bestämmelser som nu föreslås bör kunna tillämpas direkt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.3.1",
      "sentiment": -0.5,
      "quote": "I nuläget anser Migrationsverket att det är tveksamt om utredningens slutsatser i avsnitt 13.3.1, att verket har tilldelats tillräckliga medel för att omhänderta förslagen, stämmer.",
      "quote_type": "grund"
    }
  ]
