    {
      "forarbete_id": "sec238",
      "sentiment": -0.5,
      "quote": "Lagstiftningen i denna del riskerar därför att inte enbart träffa personer med ett normbrytande beteende, utan även att omfatta personer med psykisk sjukdom i en utsträckning som inte är önskvärd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec240",
      "sentiment": -0.5,
      "quote": "Utan tydliga definitioner riskerar bedömningen att bli alltför vidsträckt och oförutsebar.",
