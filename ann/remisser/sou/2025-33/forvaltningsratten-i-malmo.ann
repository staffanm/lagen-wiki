    {
      "forarbete_id": "sec238",
      "sentiment": -0.8,
      "quote": "Domstolen ser det som problematiskt att i övriga fall lägga någon större vikt vad som närmast är en beroendesjukdom.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.9",
      "sentiment": -0.2,
      "quote": "Mot bakgrund av att en återkallelse av ett uppehållstillstånd får anses vara en mer ingripande åtgärd för en enskild, som tidigare beviljats en förmån i form av tillstånd, kan frågan ställas om det bör krävas en högre tröskel för att återkalla ett tillstånd än för att bevilja ett sådant.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec291",
      "sentiment": -0.2,
      "quote": "Domstolen ser behov av att det säkerställs att de båda utredningarna är förenliga med varandra och med kraven som följer av Europakonventionen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.8",
      "sentiment": -0.2,
      "quote": "Utifrån den befintliga utredningen är det otydligt hur och i vilka sammanhang informationsöverföringen ska göras i de olika leden, vilket försvårar möjligheten att lämna synpunkter i denna del.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.3.4",
      "sentiment": -0.5,
      "quote": "Förvaltningsrätten ifrågasätter slutsatsen att de förslagna förändringarna ryms inom befintliga budgetanslag och betonar behovet av långsiktighet i anslagstilldelningen.",
      "quote_type": "grund"
    }
