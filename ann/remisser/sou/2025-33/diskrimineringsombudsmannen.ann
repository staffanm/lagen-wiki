  "segments": [
    {
      "forarbete_id": "a5.5",
      "sentiment": -1.0,
      "quote": "DO:s bedömning är att det trots försöken till förtydligande finns ett för stort utrymme för subjektiva bedömningar, oklara gränsdragningar och kvarvarande frågor om vilka typer av handlingar som kan tänkas inbegripas i definitionen för vandel.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.6",
      "sentiment": -0.2,
      "quote": "Oklarhet kring gränsdragningar kan bidra till ett självhämmande, en så kallad ”chilling effect ” som innebär att den enskilde drar sig från att uttrycka sig och utöva sina mänskliga rättigheter.",
      "quote_type": "grund"
    },
    {
