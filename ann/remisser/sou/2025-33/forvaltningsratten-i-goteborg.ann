  "segments": [
    {
      "forarbete_id": "a5.5.5",
      "sentiment": -0.2,
      "quote": "den definition som valts, och den vägledning kring tolkningen som hittills föreligger, kan leda till vissa tolknings- och tillämpningssvårigheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.5.4",
      "sentiment": 0.5,
      "quote": "Det är både utifrån rättssäkerhetsskäl och i syfte att undvika en onödigt omfattande prövning i bl.a. migrationsdomstolarna angeläget att bedömningen av en utlännings vandel i så stor utsträckning som möjligt koncentreras till fall där eventuella brister i vandeln kommit till uttryck genom ett lagakraftvunnet domstolsavgörande eller myndighetsbeslut, eller på annat sätt är klarlagda och tydligt dokumenterade, redan innan de blir föremål för prövning i migrationsrättsliga sammanhang.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7",
      "sentiment": 0.5,
      "quote": "Eftersom syftet är att genomgående byta ut begreppet bör motsvarande ändring göras av detta lagrum.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.4",
      "sentiment": -0.2,
      "quote": "Det kan ifrågasättas om uttrycket \"om det kommer fram omständigheter\" fyller någon funktion i sammanhanget.",
      "quote_type": "grund"
