  "segments": [
    {
      "forarbete_id": "a5",
      "sentiment": -0.8,
      "quote": "Enligt Civil Rights Defenders är den föreslagna vandelsdefinitionen vag och öppnar upp för godtyckliga bedömningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.6",
      "sentiment": -0.6,
      "quote": "Om det är så att även icke-kriminaliserade yttranden – eller i vart fall ”konsekvenserna” av sådana yttranden – ska kunna räknas som bristande vandel är det ytterst oroande ur ett yttrandefrihetsperspektiv.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": -1.0,
      "quote": "Mot bakgrund av de betydande brister som omgärdar den föreslagna vandelsprövningen ser Civil Rights Defenders mycket allvarligt på att såväl tillfälligt som permanent uppehållstillstånd ska kunna vägras på grund av bristande vandel.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": -1.0,
      "quote": "Civil Rights Defenders ser flera rättssäkerhetsrisker med den breda och öppet formulerade vägransgrund som föreslås i utredningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": -0.8,
      "quote": "Enligt Civil Rights Defenders är den föreslagna bestämmelsen alltför snäv och riskerar att leda till att vissa omständigheter av betydelse – såsom vistelsens varaktighet och personens ålder – inte ges tillräcklig, om ens någon, hänsyn.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.3",
      "sentiment": -1.0,
      "quote": "I fråga om avvisningsärenden vill Civil Rights Defenders särskilt framhålla att det i dessa fall oftast finns mycket lite information om en persons vandel att tillgå, varför det kan ifrågasättas att en sådan avvisningsgrund alls kan fylla någon betydelsefull funktion.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.6",
      "sentiment": -0.4,
      "quote": "Vad gäller de icke-straffbara beteenden som utredningen i avsnitt 5 har bedömt kan utgöra brister i vandeln bedömer Civil Rights Defenders att det är få – om ens några – av dessa som kan anses utgöra ett sådant verkligt, aktuellt och tillräckligt allvarligt hot som åsyftas med det EU-rättsliga begreppet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2",
      "sentiment": -1.0,
      "quote": "Att begränsa denna ventil riskerar att leda till oproportionerliga och rättsosäkra beslut.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5",
      "sentiment": -1.0,
      "quote": "Att tillstånd ska kunna återkallas på grund av att oriktiga uppgifter lämnas från någon annan än utlänningen själv – exempelvis en arbetsgivare, hyresvärd eller anhörig – innebär att individen riskerar allvarliga rättsliga konsekvenser utan att ha haft kontroll över eller kännedom om uppgifterna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.9",
      "sentiment": -1.0,
      "quote": "Att återkalla ett uppehållstillstånd på grund av ett otydligt och rättsosäkert vandelsbegrepp riskerar att leda till oproportionerliga ingrepp i individens liv och rättigheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10",
      "sentiment": -1.0,
      "quote": "Utredningens förslag om en ny uppgiftsskyldighet kommer att innebära intrång i den personliga integriteten, bland annat genom ökad och i viss mån ny behandling av personuppgifter samt genom risken för ökad kartläggning av enskilda.",
      "quote_type": "grund"
    }
  ]
