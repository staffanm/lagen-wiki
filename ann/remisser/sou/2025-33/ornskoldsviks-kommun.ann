    },
    {
      "forarbete_id": "a10.9.1",
      "sentiment": 0.2,
      "quote": "Kommunen anser dock att det kan bli svårt att bedöma när det står klart att det intresse som sekretessen ska skydda har företräde framför intresset av att uppgiften lämnas ut.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.13.2",
      "sentiment": -0.5,
      "quote": "Det finns en risk för att människor i utsatta situationer undviker att söka hjälp och stöd i rädsla för att Migrationsverket ska få del av uppgifter som medför att en då riskerar att förlora sin rätt att vistas i Sverige.",
      "quote_type": "grund"
