  "segments": [
    {
      "forarbete_id": "sec133",
      "sentiment": 1.0,
      "quote": "Inte minst vid eventuella genomföranden i OPS-form är det viktigt för att undvika risken att man frestas att välja enklare och billigare bygglösningar som medför högre underhållskostnader och i slutänden resulterar i att totalkostnaden blir högre.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec8",
      "sentiment": -0.2,
      "quote": "SJ menar att denna avgränsning kan visa sig starkt försvåra ambitionen att arbeta med sammanhållna stråk, då det i Sverige närmast blivit praxis att de större behoven delas upp i många mindre delar som planmässigt hanteras och beslutas enskilt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.4.2",
      "sentiment": 0.2,
      "quote": "Vi saknar dock ett utvecklat resonemang om, och rekommendationer rörande, andra möjliga återbetalningsformer, till exempel tillgänglighetsersättning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec130",
      "sentiment": 1.0,
      "quote": "Vi delar utredningens uppfattning att det är viktigt att staten alltid äger infrastrukturen och därmed säkerställer full rådighet över fördelning av kapacitet och trafikering av denna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2.2",
      "sentiment": -0.2,
      "quote": "Sverige behöver som diskuterats ovan så snabbt som möjligt utöka kapaciteten i järnvägssystemet och detta är en möjlig metod för att under en begränsad period skapa ett större ekonomiskt utrymme.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec61",
      "sentiment": -0.5,
      "quote": "SJ menar att i detta finns en inbyggd risk att inte kunna planera objektens genomförande på ett optimalt sätt och att man, i värsta fall, behöver pausa ett arbete mot slutet av ett år för att sedan dra igång det igen efter nyår då nya friska pengar frigjorts.",
      "quote_type": "grund"
