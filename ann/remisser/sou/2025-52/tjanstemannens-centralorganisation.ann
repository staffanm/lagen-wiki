  "overall": {
    "sentiment": 0.2,
    "quote": "Att de politiska beslutsprocesserna kan granskas och förstås stärker allmänhetens tillit till dessa och till demokratin i stort.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a12.5",
      "sentiment": 1.0,
      "quote": "TCO konstaterar att rätten att fritt bestämma över sin interna verksamhet är ett av den fackliga föreningsfrihetens centrala och grundläggande drag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.2",
      "sentiment": 0.5,
      "quote": "Om en lag införs för allmänhetens insyn i lobbyverksamhet riktad mot politiska beslutsfattare och dess medarbetare med avsikt att påverka politiska beslut är det viktigt att denna bygger på en avvägning mellan nödvändiga åtgärder för att öka insynen och hindra korruption samt rimliga krav och åtgärder både utifrån praktiska och ekonomiska aspekter för de som omfattas av lagstiftningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.5.2",
      "sentiment": -0.5,
      "quote": "Det torde vara näst intill omöjligt för arbetsmarknadsorganisationer såsom till exempel TCO att korrekt kunna redovisa alla dessa kontakter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.6.1",
      "sentiment": -0.2,
      "quote": "Det är inte rimligt att så olika aktörer åläggs samma skyldigheter och där uppenbarligen civilsamhället drabbas av en orimligt tung börda avseende både administration och kostnader.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.6.6",
      "sentiment": -0.2,
      "quote": "TCO kan till exempel se problem i den praktiska verksamheten när det gäller var gränsen för sedvanliga kontakter med myndigheter går.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.7.5",
      "sentiment": 0.5,
      "quote": "Enligt TCO finns det en uppenbar konfliktyta mellan å ena sidan den nya anmälningsskyldigheten, särskilt i kombination med Kammarkollegiets utredningsskyldighet, och meddelar- och anskaffarfriheten, samt efterforskningsförbudet å andra sidan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.8.1",
      "sentiment": -0.5,
      "quote": "Redovisningskraven i förslaget riskerar att leda till orimliga ekonomiska konsekvenser för många organisationer där bland annat fackförbund utmärker sig genom att i princip vara helt medlemsfinansierade, eller i vart fall i mycket ringa utsträckning finansierade av offentliga medel.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.9.1",
      "sentiment": -0.5,
      "quote": "Tre redovisningstillfällen per år innebär en allt för stor arbetsinsats.",
      "quote_type": "grund"
    }
  ]
}