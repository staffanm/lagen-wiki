  },
  "overall": {
    "sentiment": 0.2,
    "quote": "Mot bakgrund av BFN:s verksamhetsområde har nämnden följande redovisningsmässiga synpunkter att framföra på förslagen i betänkandet.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "sec37",
      "sentiment": -0.2,
      "quote": "Enligt BFN behöver det framgå tydligare vad som avses med begreppet huvudsaklig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec38",
      "sentiment": -0.2,
      "quote": "BFN anser att det behöver tydliggöras till vilken punkt kostnader för externa personer hör.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec46",
      "sentiment": -0.2,
      "quote": "Detta dels för att tydliggöra vad som avses, dels för att samordna paragrafen med 11 §.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec58",
      "sentiment": -0.2,
      "quote": "BFN anser att om ett partis sidoorganisation kan vara en annan företagsform än ideell förening behöver formuleringen i förslaget till ändring förtydligas",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec58",
      "sentiment": -0.2,
      "quote": "BFN föreslår att ”värdet av” tas bort då det är otydligt vilket värde som avses.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec58",
      "sentiment": -0.2,
      "quote": "Om avsikten är att punkt 9 ska omfatta samma krets som i definitionen av bidragsgivare, anser BFN att punkt 9 bör samordnas med 2 §.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec58",
      "sentiment": -0.2,
      "quote": "BFN anser att stycket behöver formuleras om för att överensstämma med det som står i första stycket, att redovisningen ska innehålla föreningens intäkter m.m.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec62",
      "sentiment": -0.5,
      "quote": "Det kan därför vara betungande för föreningen dels att bedöma vilka kostnader som är huvudsakliga, dels att specificera dessa kostnader.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec58",
      "sentiment": -0.2,
      "quote": "BFN vill förtydliga att föreningar som upprättar ett förenklat årsbokslut inte delar in tillgångarna i anläggnings- och omsättningstillgångar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec812",
      "sentiment": -0.2,
      "quote": "Det innebär att den uppgift om intäkter i form av bidrag som ska lämnas enligt 11 § punkt 9 kan vara en annan än det belopp som redovisas i föreningens årsredovisning eller årsbokslut.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec404",
      "sentiment": 0.2,
      "quote": "BFN vill förtydliga att i Bokföringsnämndens allmänna råd (BFNAR 2013:2) om bokföring med tillhörande vägledning förtydligas att de gåvor som avses i 5 kap. 1 § BFL är begagnade kläder, möbler och liknande som mottagaren avser att sälja vidare, skänka bort eller utrangera",
      "quote_type": "grund"
    }
  ]
}