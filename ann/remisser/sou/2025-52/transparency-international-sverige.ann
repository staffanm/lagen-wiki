  "overall": {
    "sentiment": 0.5,
    "quote": "Vi välkomnar i stora delar de förslag som läggs i betänkandet.",
    "quote_type": "standpunkt"
  },
  "segments": [
    {
      "forarbete_id": "sec10",
      "sentiment": -0.2,
      "quote": "Vi anser att detta är problematiskt eftersom det sänder ut en signal att mottagande parti eller kandidat inte heller behöver ha dessa uppgifter tillgängliga, vilket ju inte är fallet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.3.2",
      "sentiment": 1.0,
      "quote": "Det blir därmed tydligt att bidrag inte får tas emot från organ som har samlat in pengar utan att uppgift samtidigt lämnas om de personer som har lämnat bidrag till organet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.5",
      "sentiment": -0.2,
      "quote": "Det blir återigen otydligt om man behåller den förenklade hanteringen av små bidrag, d.v.s. om det finns anledning att misstänka att en givare har gett så många bidrag, under beloppsgränsen för förenklad hantering av små bidrag eller inom ramen för en insamling eller på annat sätt, att summan överstiger gränsen för redovisning av givarens identitet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.6.1",
      "sentiment": 1.0,
      "quote": "Att redovisning enligt insynslagen idag gäller endast intäkter är något som vi länge, i likhet med Greco, pekat på som en allvarlig brist.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.7",
      "sentiment": 1.0,
      "quote": "Vi stödjer kommitténs förslag att alla föreningar som är redovisningsskyldiga enligt insynslagen ska vara skyldiga att låta en revisor eller en särskild granskare granska intäktsredovisningen och lämna ett yttrande över granskningen.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a10.8.2",
      "sentiment": -0.5,
      "quote": "Vi hade önskat att man i betänkandet var något mer tydlig kring behovet av att Kammarkollegiets tillsyn ska vara mer aktiv.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.2",
      "sentiment": 0.5,
      "quote": "Vi saknar samtidigt förslag till begränsning av storlek på bidragsbelopp, oavsett ursprung.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.2",
      "sentiment": 0.2,
      "quote": "Vi ser dock detta som ett första steg, något som också nämns i betänkandet, och en mer ambitiös lösning borde egentligen ha föreslagits.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.9.1",
      "sentiment": 0.0,
      "quote": "Däremot anser vi att den uppgiftsskyldige löpande ska, och senast 30 dagar efter genomförd aktivitet, lämna en redovisning om bedriven påverkanskommunikation.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.12.1",
      "sentiment": 1.0,
      "quote": "Vi instämmer i utredningens bedömning att förslagen är förenliga med de grundläggande frioch rättigheter som regleras i regeringsformen.",
      "quote_type": "standpunkt"
    }
  ]
