    {
      "forarbete_id": "a7.5.4",
      "sentiment": 0.5,
      "quote": "Våra erfarenheter visar att kvinnor och barn ofta förs utomlands mot sin vilja, och lagstiftningen måste ge möjlighet att ingripa redan i planeringsstadiet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.4",
      "sentiment": 0.2,
      "quote": "På kort sikt kan dock en utvidgning av brottet hedersförtryck stärka skyddet och underlätta lagföring.",
