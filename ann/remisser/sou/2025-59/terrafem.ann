    {
      "forarbete_id": "a10.9.3",
      "sentiment": 0.5,
      "quote": "Om erkännande vägras måste det finnas tydliga regler om vilka rättsverkningar som ändå ska gälla, så att kvinnors rättsställning inte försvagas, särskilt vid månggifte.",
      "quote_type": "grund"
