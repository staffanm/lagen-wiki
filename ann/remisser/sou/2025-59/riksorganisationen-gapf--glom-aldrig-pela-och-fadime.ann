    },
    {
      "forarbete_id": "a7.3",
      "sentiment": -0.2,
      "quote": "GAPF vill poängtera att det sker att beslut om barnäktenskap fattas av andra än barnets föräldrar och att beslutet kan ligga utanför föräldrarnas kontroll.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.3",
      "sentiment": 0.8,
      "quote": "GAPF framhåller att äktenskapet har långtgående konsekvenser inom hederskulturen då det inte är tillåtet för kvinnor att skilja sig och om de av olika orsaker tillåts skilja sig så ses de som ”använda” och mindre värda.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5.4",
      "sentiment": 0.8,
      "quote": "GAPF bedömer att utredningens förslag om att vilseledande till äktenskapsresa ska utvidgas till att även omfatta situationer där personer genom olaga tvång eller utnyttjande av utsatt belägenhet förmås resa till ett annat land för att utsättas för äktenskapstvång eller barnäktenskapsbrott innebär ett utökat skydd för vår målgrupp.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5.5",
      "sentiment": 0.5,
      "quote": "Att bestämmelsen ska gälla även om den som begår gärningen inte haft uppsåt men varit oaktsam beträffande omständigheten att den andra personen inte fyllt 18 år välkomnas utifrån aspekten om barnets bästa.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.6.3",
      "sentiment": 0.2,
      "quote": "Det är av principiell vikt att lagstiftningen finns på plats då den utgör ett viktigt signalvärde om att ingen form av hedersrelaterat våld och förtryck tillåts.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.7.4",
      "sentiment": -0.5,
      "quote": "Då möjligheten att lämna ett äktenskap är mycket begränsat för kvinnor utsatta för hedersrelaterat våld och förtryck menar GAPF att det skulle utgöra ett ytterligare skydd om tvånget att vara kvar i äktenskap sågs som ett eget brott.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8",
