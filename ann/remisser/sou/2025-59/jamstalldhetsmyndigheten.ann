    }
  },
  "overall": {
    "sentiment": 0.5,
    "quote": "Stärkt lagstiftning mot hedersrelaterat våld och förtryck förväntas få positiv effekt på alla jämställdhetspolitiska delmål och stärker arbetet med att nå målsättningarna i den nationella strategin för att förebygga och bekämpa mäns våld mot kvinnor.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a7.3",
      "sentiment": 1.0,
      "quote": "I linje med utredningen anser vi att det redan idag är möjligt att lagföra en bred krets av personer som på något sätt är aktiva vid förberedelse eller genomförande av ett barnäktenskap.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.3",
      "sentiment": 1.0,
      "quote": "En avsedd effekt med förslaget är att stärka skyddet exempelvis för personer med funktionsnedsättning, en grupp som riskerar att vara särskilt utsatta för tvångsäktenskap.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5.4",
      "sentiment": 1.0,
      "quote": "På så sätt blir bestämmelsen mer heltäckande samtidigt som brottslighetens allvar speglas genom en strängare straffskala än den som gäller för olaga tvång.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5.5",
      "sentiment": 1.0,
      "quote": "Att synliggöra att det handlar om brott mot barn är en viktig normativ åtgärd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.6.3",
      "sentiment": 0.5,
      "quote": "En kriminalisering av försök till äktenskapsresebrott och äktenskapsresebrott mot barn möjliggör att i större utsträckning förhindra att sådana resor genomförs.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.7.4",
      "sentiment": -0.5,
      "quote": "en sådan kriminalisering skulle ha ett viktigt signalvärde.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3.3",
      "sentiment": 0.5,
      "quote": "en höjning av minimistraff för äktenskapstvång till 1 år innebär en möjlighet att lämna uppgift om försök, förberedelse eller stämpling till äktenskapstvång utan hinder av sekretess (10 kap. 23 § offentlighets- och sekretesslagen, OSL).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.2",
      "sentiment": 0.5,
      "quote": "Minimistraffet borde åtminstone uppgå till 6 månader eftersom den sekretessbrytande bestämmelsen i 10 kap. 23 § OSL då blir tillämplig vid fullbordat brott.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.3",
      "sentiment": 0.5,
      "quote": "När det kommer till äktenskapsresebrott mot barn är detta ett viktigt komplement i de fall där ett utreseförbud inte har hunnit meddelas eller där en ansökan inte har gjorts och där ett barn kan komma att föras eller har förts utomlands i syfte att utsättas för barnäktenskap.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5.2",
      "sentiment": 1.0,
      "quote": "Vi delar utredningens bedömning att det är rimligt att straffskalan överensstämmer med straffskalan för grov kvinnofridskränkning, grov fridskränkning och grovt barnfridsbrott.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.15",
      "sentiment": 1.0,
      "quote": "Det är en välkommen möjlighet som kan antas få effekt på dessa svårutredda brott.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.9.3",
      "sentiment": 0.2,
      "quote": "Ett erkännandeförbud innebär ett tydligt ställningstagande mot barnäktenskap, tvångsäktenskap och månggifte och kan utgöra en skyddande faktor för kvinnor och barn som utsatts för dessa skadliga sedvänjor i ursprungslandet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.6",
      "sentiment": 1.0,
      "quote": "Trots detta förekommer även frivilliga fullmaktsäktenskap och det skulle vara en för långtgående åtgärd att ändra reglerna kring detta till att även omfatta situationer där båda partner vid äktenskapets ingående saknade koppling till Sverige.",
      "quote_type": "grund"
    }
  ]
}