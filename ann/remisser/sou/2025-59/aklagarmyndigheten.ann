  "segments": [
    {
      "forarbete_id": "a7.3",
      "sentiment": 1.0,
      "quote": "Tillsammans med den föreslagna kriminaliseringen av underlåtenhet att avslöja eller förhindra barnäktenskapsbrott som följer av annan utredning föreligger enligt Åklagarmyndighetens mening inget praktiskt behov av att utvidga straffansvaret för tillåtande av att ett barn ingår ett äktenskap eller en äktenskapsliknande förbindelse.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.3",
      "sentiment": 1.0,
      "quote": "Mest utsatta för denna risk är personer med intellektuella funktionsnedsättningar, som är särskilt skyddsvärda individer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5.4",
      "sentiment": 1.0,
      "quote": "Som utredningen konstaterar är situationen då en person företar en resa i syfte att ingå äktenskap på grund av tvång eller utnyttjande av utsatt belägenhet minst lika straffvärd som situationen då resan företas till följd av ett vilseledande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5.5",
      "sentiment": 1.0,
      "quote": "Som utredningen konstaterar har svenska myndigheter ofta svårt att ingripa när ett barn väl förts utomlands i syfte att giftas bort.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.6.3",
      "sentiment": 0.2,
      "quote": "En tidigarelagd kriminalisering är motiverad av de allvarliga konsekvenser som de fullbordade brotten kan få för de utsatta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.7.4",
      "sentiment": 1.0,
      "quote": "Det skulle innebära svårigheter att avgränsa vari det straffbara agerandet skulle bestå på ett sätt som är förenligt med legalitetsprincipens krav på förutsebarhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3.3",
      "sentiment": 1.0,
      "quote": "Åklagarmyndigheten instämmer i utredningens bedömning att brottets allvar inte återspeglas i dagens straffskala.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5.2",
      "sentiment": 1.0,
      "quote": "Åklagarmyndigheten ansluter sig helt till utredningens bedömning att straffskalan för hedersförtryck inte bör skärpas.",
