  "segments": [
    {
      "forarbete_id": "a5.1.5",
      "sentiment": 1.0,
      "quote": "I likhet med utredningen anser Skolverket att ersättningen i hög grad behöver avspegla elevernas individuella behov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.2.5",
      "sentiment": 1.0,
      "quote": "Med nuvarande reglering finns det en påtaglig risk för att det skapas snedvridande ekonomiska incitament om det införs ett nationellt strukturbidrag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.4.3",
      "sentiment": 1.0,
      "quote": "Skolverket bedömer att utredningens förslag kan bidra till att förbättra kvaliteten i den nationella kostnadsstatistiken men att det inte kommer räcka för att skapa en tillräckligt god informationsförsörjning på det ekonomiska området.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": 1.0,
      "quote": "Det skulle innebära en alltför stor och abrupt förändring för de kommuner som skulle behöva göra störst tillskott per elev för att nå normen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.1.2",
      "sentiment": 1.0,
      "quote": "Skolverket instämmer i utredningens bedömning att det inte bör tas fram en norm för fritidshemmet i nuläget på grund av brister i kostnadsstatistiken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2.2",
      "sentiment": 0.5,
      "quote": "För det första bedömer Skolverket att kunskapsgrunden för viktningens utformning är svag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.4.1",
      "sentiment": 1.0,
      "quote": "Myndigheten anser att innebörden av begreppet ”beakta” behöver förtydligas och konkretiseras ytterligare i den fortsatta beredningen, i syfte att tydliggöra innebörden för de kommuner som ska tillämpa bestämmelsen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.4.2",
      "sentiment": -0.5,
      "quote": "Eftersom beräkningen av normen är en uppgift som myndigheten ska ha tills vidare bör den inte skrivas in i regleringsbrevet som är ettårigt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.4.3",
      "sentiment": -1.0,
      "quote": "Skälen för detta är dels att Skolverket anser att vikterna i stadiedifferentieringen behöver beredas vidare, dels att förskoleklassen avskaffas till läsåret 2028/2029.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.5.1",
      "sentiment": 1.0,
      "quote": "Skolverket tillstyrker utredningens förslag om att kommunen ska göra avdrag från grundbeloppet till enskilda huvudmän för merkostnader för ansvaret att erbjuda utbildning.",
