  "segments": [
    {
      "forarbete_id": "sec7",
      "sentiment": 1.0,
      "quote": "Hudiksvalls kommun delar bedömningen att en bindande skolpengsnorm inte bör införas i dagsläget eftersom en sådan riskerar att få oönskade konsekvenser utifrån olika kommuners och skolenheters varierande utgångslägen och förutsättningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec8",
      "sentiment": 1.0,
      "quote": "Kommunen välkomnar förslaget till att istället årligen ta fram en vägledande norm för resursfördelning, som kan ligga till grund och utgöra referenspunkt för kommunens egna resursfördelningsmodeller.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10",
      "sentiment": 1.0,
      "quote": "Avdraget för från grundbeloppet till enskilda huvudmän samt möjligheten att frångå principen om lika villkor gentemot enskilda huvudmän innebär större möjligheter för kommunen att tillföra och rikta medel till de skolenheter som bedöms ha störst behov, samtidigt som fördelningen blir mer rättvis utifrån faktiska förhållanden och de särskilda krav som ställs på kommunal skolverksamhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec9",
      "sentiment": 1.0,
      "quote": "Kommunen instämmer i utredningens bedömning att det är rimligt att kommunen får ställa villkor på enskilda huvudmän om att medel ska användas till ett visst ändamål på samma sätt som villkor kan ställas på de egna kommunala skolorna, samt att medel ska kunna återkrävas om villkoren inte uppfylls.",
      "quote_type": "grund"
    }
