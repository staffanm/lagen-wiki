    },
    {
      "forarbete_id": "a9.2.2",
      "sentiment": 1.0,
      "quote": "Leksand ser positivt på en vägledande norm och att den beräknas utifrån nettokostnaden som grund baserats på kostnadsuppgifter som hämtas från kommunernas lämnade uppgifter till Räkenskapssammandraget.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.5.2",
      "sentiment": 1.0,
      "quote": "Leksands kommun ser positivt på förslaget om möjlighet att ställa krav på att den enskilde huvudmannen använder medel till ett visst ändamål på samma sätt som på den egna verksamheten samt möjlighet att kunna återkräva medlen om villkoren inte uppfylls.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.6.1",
      "sentiment": 0.0,
      "quote": "Då det tilldelade kommunbidraget inte är beräknat utifrån socioekonomisk fördelning så finns det från grunden en ojämlik fördelning.",
