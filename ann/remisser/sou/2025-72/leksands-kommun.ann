    },
    {
      "forarbete_id": "a5.4.3",
      "sentiment": 1.0,
      "quote": "det är av vikt att, som utredningen föreslår, ett vidareutvecklat stöd till huvudmännen ges när det gäller den nationella kostnadsstatistiken, inte minst vad gäller hur kostnader ska fördelas mellan olika verksamheter och mellan olika kostnadsslag",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9",
      "sentiment": 1.0,
      "quote": "Förslaget ger kommunen ett stöd till att bedöma hur mycket resurser som minst ska tilldelas och hur mycket som ska omfördelas på socioekonomiska grunder.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.1.2",
      "sentiment": 1.0,
      "quote": "Leksands kommun instämmer med utredningen kring komplexiteten och utmaningar med beräkning utifrån nettokostnaden.",
