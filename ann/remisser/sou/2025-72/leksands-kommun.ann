  "segments": [
    {
      "forarbete_id": "a5.1.5",
      "sentiment": 1.0,
      "quote": "det inte är lämpligt att ta fram en nationell beräkningsmodell för den anpassade grundskolan med en bindande norm som styr vilken ersättning varje huvudman minst ska få",
