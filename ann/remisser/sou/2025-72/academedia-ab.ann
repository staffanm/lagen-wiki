  "segments": [
    {
      "forarbete_id": "a5.1.5",
      "sentiment": 1.0,
      "quote": "AcadeMedia instämmer i bedömningen att en sådan nationell skolpengsnorm som utredningen föreslår inte lämpar sig för anpassad grundskola där ersättningen ofta differentieras efter behovskategori.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.2.5",
      "sentiment": 1.0,
      "quote": "Vi anser, likt utredaren, att en sådan översyn behövs för att stärka en nationellt likvärdig tillgång till sådant omfattande stöd som resursskolor erbjuder.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.4.3",
      "sentiment": 0.5,
      "quote": "AcadeMedia instämmer i bedömningen att den nationella kostnadsstatistiken uppvisar kvalitetsbrister och i vissa delar är missvisande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.5.4",
      "sentiment": 1.0,
      "quote": "AcadeMedia instämmer i bedömningen att det inte är motiverat att införa regler om fördröjd flytt av ersättningen vid skolbyten.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8",
      "sentiment": 1.0,
      "quote": "AcadeMedia instämmer i bedömningen att det inte är lämpligt att införa en bindande skolpengsnorm av sådant slag som skisseras i utredningen.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a9",
      "sentiment": -1.0,
      "quote": "En sådan vägledande norm kommer inte i tillräcklig grad att säkerställa en nationellt likvärdig finansiering.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.1.2",
      "sentiment": 1.0,
      "quote": "AcadeMedia instämmer i bedömningen att låg behörighetsgrad och kvalitetsbrister i kostnadsstatistiken innebär att en norm för fritidshemmet inte bör införas i nuläget.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2.2",
      "sentiment": -1.0,
      "quote": "Att utgå ifrån hemkommunens nettokostnad skulle innebära att de fristående grundskolornas strukturellt lägre ersättning läggs till grund för det modellberäknade värdet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10",
      "sentiment": -1.0,
      "quote": "Vad utredningen föreslår är ett schablonavdrag som inte tar hänsyn till variationen mellan kommuner och över tid.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.5.1",
      "sentiment": -1.0,
      "quote": "Vi ser en klar risk att fristående grundskolor med motsvarande kostnadsökningar lämnas utan nödvändigt resurstillskott.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.5.2",
      "sentiment": -0.2,
      "quote": "Svenskt skolväsende utgår inte från den typen av styrning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.5.3",
      "sentiment": -1.0,
      "quote": "I den mån enskilda huvudmän inte ersätts för hemkommunens utbudskostnader, bör heller inte mottagande kommun ersättas för dessa kostnader.",
