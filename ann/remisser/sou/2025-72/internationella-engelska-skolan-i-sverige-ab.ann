    {
      "forarbete_id": "a5.4.3",
      "sentiment": 1.0,
      "quote": "Pålitlig statistik saknas i dag på nationell nivå, och den behövs för att såväl debatt som beslut ska kunna bygga på fakta i stället för lösa antaganden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10",
      "sentiment": -1.0,
      "quote": "Givet detta utgångsläge, skulle ett avdrag på sex procent äventyra verksamheten i en stor del av friskoleväsendet.",
