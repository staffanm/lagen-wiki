    },
    {
      "forarbete_id": "a5.5.4",
      "sentiment": 1.0,
      "quote": "Genom att lämpa längre tidsintervaller i elevavläsningarna för kommunala skolor än fristående skolor, kompenseras den kommunala skolan för det intäktsbortfall som ett skolbyte kan innebära.",
      "quote_type": "grund"
