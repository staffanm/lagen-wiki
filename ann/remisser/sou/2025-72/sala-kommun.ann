  "segments": [
    {
      "forarbete_id": "sec7",
      "sentiment": 1.0,
      "quote": "alla kommuner har lokala förutsättningar, både strukturellt och geografiskt, vilket gör att en helt styrande norm kan göra det svårt för den enskilda kommunen att göra lokala prioriteringar och tillse att man följer andra lagstadgade åtaganden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec8",
      "sentiment": 0.5,
      "quote": "en vägledande norm bör införas successivt, gärna med stöd av ett antal pilotkommuner, som kan bidra med erfarenheter och lärdomar inför ett brett genomförande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec24",
      "sentiment": 0.2,
      "quote": "Vi ser samtidigt en risk för att vi behöver lägga resurser vi inte har idag på ökad administration, samt för att eventuellt bygga nya system för spårbarhet, uppföljning och dokumentation.",
