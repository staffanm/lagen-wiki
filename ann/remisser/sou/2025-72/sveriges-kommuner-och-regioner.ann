    },
    {
      "forarbete_id": "a5.4.3",
      "sentiment": 0.0,
      "quote": "I utredningens simuleringar framgår det tydligt att den nationellt insamlade statistiken ofta innehåller felaktiga uppgifter och har svårt att fånga olikheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.5.4",
      "sentiment": 1.0,
      "quote": "SKR menar likt utredningen att andelen skolbyten inte är omfattande och kostnaderna är trögrörliga, vilket inte medför någon större skillnad om fördröjning av ersättning införs.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": 1.0,
      "quote": "SKR menar, likt utredningen, att ett införande av en bindande skolpengsnorm skulle medföra ett stort ingripande i det kommunala självstyret.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.1.2",
      "sentiment": 1.0,
      "quote": "Fritidshem organiseras på olika vis hos olika huvudmän och redovisningen i Räkenskapssammandraget ser därmed mycket olika ut för olika kommuner.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2.2",
      "sentiment": -1.0,
      "quote": "SKR avstyrker förslaget med att införa en vägledande norm baserat på alla kostnadsslag, då nackdelarna med en vägledande norm är större än fördelarna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.4.1",
      "sentiment": -1.0,
      "quote": "En vägledande norm kommer även den att leda till ökad administrativ börda, det riskerar att leda till att resurser måste läggas på att utreda vad normen egentligen står för jämfört med resurserna till de egna skolorna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.4.2",
      "sentiment": -1.0,
      "quote": "SKR menar dock att fördelarna med att införa en vägledande norm inte leder till att syftet med utredningen, dvs. att en likvärdig skola uppnås på nationell nivå.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.4.3",
      "sentiment": -1.0,
      "quote": "Det är just nu många pågående reformer och utredningar som föreslås implementeras samtidigt, vilket behöver beaktas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.5.1",
      "sentiment": 0.5,
      "quote": "SKR välkomnar dessa förslag, de motverkar brister i nuvarande lagstiftning rörande bidrag på lika villkor och skapar mer likvärdiga villkor mellan kommunala och enskilda huvudmän.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.5.2",
      "sentiment": 1.0,
      "quote": "SKR välkomnar även detta förslag som medför mer lika villkor mellan kommunala och enskilda huvudmän och rättar till brister i nuvarande lagstiftning och motverkar välfärdsbrottslighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.5.4",
      "sentiment": -1.0,
      "quote": "Lägger man samman förslagen i denna utredningsbetänkande med många av de andra pågående reformerna blir implementeringen hos kommunerna mycket omfattande och belastar kommunernas kapacitet, ekonomiskt, administrativt och gällande personella resurser.",
      "quote_type": "grund"
