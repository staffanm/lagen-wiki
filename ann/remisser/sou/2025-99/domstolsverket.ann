    {
      "forarbete_id": "a10.3",
      "sentiment": -0.5,
      "quote": "I förlängningen kommer det, såvitt avser domstolarna, sannolikt medföra att ett stort antal mål uppkommer om både migration och försörjning rörande denna personkrets av anhöriga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.4.4",
      "sentiment": -0.2,
      "quote": "Domstolsverket konstaterar att respektive förslag föranleder ökade biträdeskostnader.",
