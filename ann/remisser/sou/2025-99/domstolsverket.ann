    {
      "forarbete_id": "a10.4",
      "sentiment": -0.2,
      "quote": "Med en förväntad kraftigt ökad mängd mål av olika slag på migrationsområdet bedömer Domstolsverket att kostnader för tolk och översättning sammantaget kommer att öka väsentligt.",
      "quote_type": "grund"
