  "segments": [
    {
      "forarbete_id": "a4.3.3",
      "sentiment": -0.5,
      "quote": "I utredningen saknar vi faktamässiga underlag för antaganden om personers ansträngningar att bli en del av det svenska samhället.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.3.3",
      "sentiment": -0.5,
      "quote": "Karlstads kommun anser att de bestämmelser som redan finns idag kring återkallelse av uppehållstillstånd om man inte befinner sig i landet bör användas, i enlighet med den granskning från Riksrevisionen som utredningen hänvisar till.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.4",
      "sentiment": -0.5,
      "quote": "Utifrån den kunskap och erfarenhet som finns inom kommunens egen socialtjänst befarar vi i stället att det växande utanförskapet och en framväxt av parallella samhällen och strukturer riskerar att växa sig starkare utifrån förslagen i betänkandet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.3.1",
      "sentiment": -0.5,
      "quote": "Vi befarar att konsekvenserna kan komma att påverka individers hälsa och välmående på ett sätt som inte motiverar att det statliga intresset ska ha företräde framför den enskildes.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.3.2",
      "sentiment": -0.5,
      "quote": "Utifrån vad som framgår i utredningen oroas Karlstads kommun över hur barnperspektiv, barnrättsperspektiv och barnets bästa kommer att tillvaratas och vi anser att barnkonventionen inte beaktats tillräckligt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.6",
      "sentiment": 0.2,
      "quote": "Kvinnor är överrepresenterade i grupper med svagare anknytning till arbetsmarknaden, bland annat på grund av huvudansvar för familj och barn, språksvårigheter eller diskriminering.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.3",
      "sentiment": -0.5,
      "quote": "Äldre har ofta begränsade möjligheter att etablera sig på arbetsmarknaden, vilket gör det svårt att uppfylla krav på försörjning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.8",
      "sentiment": -0.5,
      "quote": "Vi ser inte att intresset för intentionerna i förslaget väger så tungt att det anses motiverat att bekosta denna ordning med skattefinansierade medel.",
      "quote_type": "grund"
    }
