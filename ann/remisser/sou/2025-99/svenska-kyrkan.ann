  "segments": [
    {
      "forarbete_id": "a5",
      "sentiment": -1.0,
      "quote": "Svenska kyrkan anser att förslaget är oproportionerligt samt strider mot etablerade rättsprinciper och människovärdesprincipen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": -0.5,
      "quote": "Handläggningstiderna för medborgarskap är mycket långa, i många fall mer än två år, något som nyligen kritiserats av Riksrevisionen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": -0.5,
      "quote": "Det går därmed att ifrågasätta utredningens slutsats att förslaget är förenligt med Sveriges internationella konventionsåtaganden såsom Europakonventionen och barnkonventionen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.2",
      "sentiment": -0.5,
      "quote": "Mot denna bakgrund framstår det som synnerligen problematiskt att retroaktivt införa en lagstiftning som innebär att enskilda kommer utvisas i strid med tidigare utfästelser om permanent uppehållstillstånd, även om lagstiftningen inte direkt omfattas av 2 kap. 10 § regeringsformen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10",
      "sentiment": -0.5,
      "quote": "Svenska kyrkan anser att utredningens analys av konsekvenserna för enskilda, för barn och för integrationen är otillräcklig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.3.2",
      "sentiment": -1.0,
      "quote": "Förslaget innebär därmed en försämring av de rättigheter som barn tillerkänns i barnkonventionen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.7",
      "sentiment": -0.5,
      "quote": "Utredningens förslag riskerar att underminera tilliten till rättssystemet, till svenska myndigheter och till att myndighetsbeslut består.",
