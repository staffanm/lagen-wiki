  "segments": [
    {
      "forarbete_id": "a3",
      "sentiment": -0.5,
      "quote": "Länsstyrelsen anser att utredningens förslag om att införa en lag om återkallelse av permanenta uppehållstillstånd är förenat med betydande osäkerhet vad gäller frågan om det ens är rättsligt möjligt med ett återkallande av ett gynnande förvaltningsbeslut för den enskilde.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4",
      "sentiment": -0.2,
      "quote": "Utifrån denna statistik saknar Länsstyrelsen en analys kring hur återkallande av permanenta uppehållstillstånd kommer att påverka länets utanförskapsområden, förutom konstaterandet att ett antal mindre individer som begått brott kan komma att utvisas och därmed lämna området (och landet).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5",
      "sentiment": -0.5,
      "quote": "Utifrån detta konstaterande finner länsstyrelsen att de stora, och till viss del outredda, konsekvenser som utredningens förslag innebär inte är proportionerliga till den begränsade inverka som förslaget får utifrån att det framställda behovet likväl kommer att uppfyllas genom tidigare lagda förslag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6",
      "sentiment": -0.2,
      "quote": "Länsstyrelsen anser att andra, möjliga vägar, för att förmå personer med uppehållstillstånd att bli svenska medborgare borde ha utretts.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": -0.5,
      "quote": "Länsstyrelsen finner det problematiskt att lägre krav för förvärv av medborskapskap inte föreslås för vissa grupper, exempelvis kvotflyktingar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.3",
      "sentiment": 0.5,
      "quote": "Vi finner det positivt att återkallelse ska kunna underlåtas på grund av ansökan eller anmälan om svenskt medborgaskap och att det föreslås finnas en undantagsregel mot återkallelse när synnerliga skäl talar emot detta.",
