  "segments": [
    {
      "forarbete_id": "a4.2",
      "sentiment": -1.0,
      "quote": "Enligt Göteborgs Stad är en retroaktiv tillämpning av den föreslagna lagen inte förenlig med de grundläggande kraven på rättssäkerhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": -0.5,
      "quote": "Göteborgs Stad ifrågasätter om det är det egentliga syftet, med tanke på att de största grupperna som omfattas av förslagen utgörs av medborgare i länder där det redan med nu gällande lagstiftning är svårt att bli svenska medborgare eftersom de saknar godkända identitetshandlingar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec142",
      "sentiment": -1.0,
      "quote": "Göteborgs Stads bedömning är att förslagen riskerar att stå i strid med barnets bästa enligt barnkonventionen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec139",
      "sentiment": -0.8,
      "quote": "Att inte veta om eller hur länge man får stanna i landet bidrar till oro, psykisk ohälsa och en känsla av utanförskap.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec140",
      "sentiment": -0.5,
      "quote": "Göteborgs Stad bedömer att förslagen kan ha en negativ påverkan på berörda människors trygghet och tillit och bidra till ett polariserat samhälle.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.6",
      "sentiment": -0.5,
      "quote": "Utländska kvinnor saknar oftare egen försörjning, vilket antas medföra att en större andel kvinnor än män under längre tid kommer att leva i Sverige med tidsbegränsade uppehållstillstånd innan de kvalificerar sig för svenskt medborgarskap.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.4",
      "sentiment": -0.5,
      "quote": "Eftersom kommunerna ansvarar för välfärd för sin befolkning kan alla förändringar som påverkar människors livsvillkor och hälsa innebära ökade behov av kommunala insatser och därmed också generera en ökad kostnad för kommunerna.",
      "quote_type": "grund"
    }
  ]
