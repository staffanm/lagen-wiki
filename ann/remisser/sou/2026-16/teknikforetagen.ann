    },
    {
      "forarbete_id": "sec12",
      "sentiment": 0.8,
      "quote": "En närmare samverkan mellan olika aktörer, såväl inom staten som mellan staten och näringslivet, är en förutsättning för att stärka och främja försvarsexporten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec14",
      "sentiment": 0.8,
      "quote": "Det är viktigt att Business Sweden bygger ut sin kompetens och sitt nätverk inom försvars- och säkerhetsområdet.",
