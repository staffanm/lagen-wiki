    {
      "forarbete_id": "sec274",
      "sentiment": 0.5,
      "quote": "Statskontoret bedömer att utformningen av avgiftsbemyndigande i förordningen bör förtydligas så att det framgår vad som utgör uppdragsverksamhet som ska avgiftsfinansieras.",
      "quote_type": "grund"
