    {
      "forarbete_id": "a6.2",
      "sentiment": -0.5,
      "quote": "Statskontoret konstaterar att utredningen inte analyserar integritetsproblematiken, det vill säga den potentiella intressekonflikt som uppstår när FMV både ansvarar för upphandling och exportstöd gentemot samma företag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.5.2",
      "sentiment": 0.5,
      "quote": "För att arbetet ska få önskvärd effekt är det viktigt att myndigheterna kombinerar utbildningarna med återkommande och verksamhetsanpassade samtal om samma frågor, och tydliga rutiner inom organisationen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6",
      "sentiment": 1.0,
      "quote": "Statskontoret tillstyrker förslaget om att förtydliga att SEK:s och EKN:s uppgifter omfattar exportfinansiering vid statlig försvarsexport.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.6.2",
      "sentiment": 1.0,
      "quote": "Det är positivt att utredningen belyser vikten av antikorruptionsarbete i relation till det övergripande förslaget om finansieringslösningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.3",
      "sentiment": -0.5,
      "quote": "Det finns en risk för att den föreslagna förordningen inte får avsedd effekt om myndigheterna inte tillförs tillräckliga resurser.",
