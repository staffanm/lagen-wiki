    },
    {
      "forarbete_id": "a6.6.2",
      "sentiment": -0.8,
      "quote": "Förslaget utgör ett väsentligt ingrepp i den personliga integriteten som normalt enbart anses påkallat av starka ordnings- eller säkerhetsskäl.",
