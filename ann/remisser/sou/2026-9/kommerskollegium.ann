  "overall": {
    "sentiment": -0.4,
    "quote": "Även om förslagen i sig inte syftar till att begränsa den fria rörligheten, aktualiseras viktiga frågor om proportionalitet och hur administrativa krav kan leda till ytterligare hinder mot den fria rörligheten på EU:s inre marknad.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a5.4.3",
      "sentiment": -0.5,
      "quote": "Även om ett antal av dessa individer befinner sig i Sverige utan att ha uppehållsrätt, kan det ifrågasättas om det är en proportionerlig åtgärd att avkräva denna stora grupp registreringsskyldighet, inte minst när dessa personer många gånger redan finns registrerade i såväl folkbokföringen som i de register som reglerar uppehållsrätt (exempelvis vid ansökan om utfärdande om Skatteverkets identitetskort med kontroll av biometriskt data av EES-medborgare).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.4.2",
      "sentiment": 0.5,
      "quote": "Även om det nu föreslagna undantaget innebär en administrativ förenkling för vissa grupper- inklusive de nordiska medborgarna- utgör det i sig inte en begränsning av andra EESmedborgares rätt till fri rörlighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.6",
      "sentiment": 0.8,
      "quote": "Det är enligt vår mening bra- samtidigt är en förutsättning för att syftet med registret ska uppnås att det innehåller korrekta uppgifter (inte minst i förhållande till dataskyddsregler).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5",
      "sentiment": -0.2,
      "quote": "Kommerskollegium anser att det behöver utredas närmare hur det ska kunna undvikas att underrättelseskyldighet i praktiken inte leder till en systematisk kontroll av uppehållsrätten, i strid med rörlighetsdirektivet och bakomliggande primärrätt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.4.5",
      "sentiment": -0.5,
      "quote": "Enligt vår mening är detta en otydlig bestämmelse som öppnar upp för tolkningar av när kravet att registrera sig egentligen infaller, vilket bör beaktas inte minst i relation till de sanktioner som kan åläggas vid underlåtenhet att registrera sig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.8.4",
      "sentiment": 1.0,
      "quote": "Vi delar därför utredarens bedömning att såväl beslut om att inte registrera en EESmedborgares uppehållsrätt som beslut om att avregistrera en EES-medborgare begränsar den fria rörligheten, och tillstyrker att dessa beslut ska kunna överklagas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2.2",
      "sentiment": -0.5,
      "quote": "Mot den bakgrunden går det att ifrågasätta att beslutet om vite inte ska kunna överklagas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.8.8",
      "sentiment": 0.8,
      "quote": "Ett samordningsnummer, särskilt med styrkt identitet, kan underlätta kontakter med myndigheter, arbetsgivare och andra aktörer samt minska risken för identitetsförväxlingar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.9.1",
      "sentiment": -0.2,
      "quote": "I förhållande till frågan om dataskydd och utlämnande av handlingar ser vi risker med att uppgifter kan begäras och lämnas ut till allmänhet och andra myndigheter.",
      "quote_type": "grund"
    }
  ]
