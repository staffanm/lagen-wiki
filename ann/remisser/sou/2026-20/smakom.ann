  "segments": [
    {
      "forarbete_id": "a8.1.1",
      "sentiment": -1.0,
      "quote": "Att staten inför ekonomiska sanktioner mot kommuner som tvingas höja skatten för att upprätthålla välfärden undergräver det lokala demokratiska mandatet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec274",
      "sentiment": -0.5,
      "quote": "Vad som då ska ses som effektivt och hur detta ska mätas kommer oavsett jämförande mätvärden bli en ren bedömningsfråga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec277",
      "sentiment": -0.5,
      "quote": "Eftersom dessa ofta är kortsiktiga, sena, lågt finansierade eller kostnadsdrivande ser vi inte någon logik i att staten kräver kommunerna på en långsiktig skatteplanering samtidigt som man försvårar en sådan planering.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.2",
      "sentiment": -0.5,
      "quote": "Vi anser att kravet på en motivering blir tandlöst och därför är en onödig inskränkning på det kommunala självstyret.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec296",
      "sentiment": 0.8,
      "quote": "I de mindre kommunerna finns inte utrymmet att inordna tjänster vars enda uppgift är att göra bidragsansökningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec297",
      "sentiment": 0.2,
      "quote": "Risken är att både invånare och företag i kommuner med ett redan högt skattetryck blir ekonomiskt dubbelbestraffade om avgifterna för den kommunala servicen ska bli en väg för kommuner att kompensera sin ekonomiska situation.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec300",
      "sentiment": 1.0,
      "quote": "Detta är en självklarhet för att ge kommunerna bästa förutsättningar att klara välfärdsuppdraget.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec301",
      "sentiment": 1.0,
      "quote": "Idag är det allt för ofta som det saknas en fullständig konsekvensbedömning i flera utredningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec302",
      "sentiment": 0.8,
      "quote": "Medvetenheten om perspektivträngsel och förväntningar behöver definitivt stärkas hos regeringen och de statliga myndigheterna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec303",
      "sentiment": 0.8,
      "quote": "SmåKom anser att det absolut skulle vara enklare att prioritera och effektivisera kommunens verksamhet om det fanns en samlad information om kommunsektorns obligatoriska uppgifter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.1",
      "sentiment": 1.0,
      "quote": "SmåKom tillstyrker bedömningen att en utredning bör få i uppdrag att lämna förslag om ett system med ett garanterat statligt bidrag till kommunsektorn vid tillfälliga nedgångar i skatteunderlaget.",
      "quote_type": "standpunkt"
