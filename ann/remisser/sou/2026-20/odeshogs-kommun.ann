  },
  "segments": [
    {
      "forarbete_id": "a8.1.1",
      "sentiment": -1.0,
      "quote": "Den föreslagna skattebromsen blir i verkligheten en straffavgift för den som inte har något annat alternativ vilket kommer att öka skillnaden mellan mer och mindre välmående kommuner.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.1.1",
      "sentiment": -1.0,
      "quote": "För många mindre kommuner är möjligheten till skattesänkningar avlägset, om förslaget om skattesänkarpremie införs innebär det i praktiken att mindre kommuners ”straffavgifter” kommer att finansiera större kommuners skattesänkningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec274",
      "sentiment": -0.5,
      "quote": "Att ändra i Kommunallagen och ytterligare begränsa det kommunala självstyret anser Ödeshögs kommun inte är skäligt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec277",
      "sentiment": -0.5,
      "quote": "Eftersom dessa ofta är kortsiktiga, sena, lågt finansierade eller kostnadsdrivande ser vi inte någon logik i att staten kräver kommunerna på en långsiktig skatteplanering samtidigt som man försvårar en sådan planering.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.2",
      "sentiment": -0.5,
      "quote": "Vi anser att kravet på en motivering blir tandlöst och därför är en onödig inskränkning på det kommunala självstyret.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3.2",
      "sentiment": 1.0,
      "quote": "Ödeshögs kommun vittnar om att det är högst angeläget att ges långsiktiga planeringsförutsättningar, nivån på statsbidragen är en faktor av stor betydelse när det kommer till detta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3.2",
      "sentiment": 1.0,
      "quote": "Vi är fullt eniga med utredningen om detta, tydlighet och transparens är nödvändigt för att kunna planera verksamheten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec296",
      "sentiment": 1.0,
      "quote": "Det är ett tidskrävande arbete att ansöka om och återrapportera riktade statsbidrag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec297",
      "sentiment": 0.2,
      "quote": "Risken är att både invånare och företag i kommuner med ett redan högt skattetryck blir ekonomiskt dubbelbestraffade om avgifterna för den kommunala servicen ska bli en väg för kommuner att kompensera sin ekonomiska situation.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec300",
      "sentiment": 1.0,
      "quote": "Detta är en självklarhet för att ge kommunerna bästa förutsättningar att klara välfärdsuppdraget.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec301",
      "sentiment": 1.0,
      "quote": "Idag är det allt för ofta som det saknas en fullständig konsekvensbedömning i flera utredningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec302",
      "sentiment": 1.0,
      "quote": "Medvetenheten om perspektivträngsel och förväntningar behöver definitivt stärkas hos regeringen och de statliga myndigheterna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec303",
      "sentiment": 1.0,
      "quote": "Ödeshögs kommun anser att det absolut skulle vara enklare att prioritera och effektivisera kommunens verksamhet om det fanns en samlad information om kommunsektorns obligatoriska uppgifter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.1",
      "sentiment": 1.0,
      "quote": "Ödeshögs kommun tillstyrker bedömningen att en utredning bör få i uppdrag att lämna förslag om ett system med ett garanterat statligt bidrag till kommunsektorn vid tillfälliga nedgångar i skatteunderlaget.",
