  "segments": [
    {
      "forarbete_id": "a8.1.1",
      "sentiment": -0.5,
      "quote": "Att justera skattesatserna kortsiktigt för att parera kommunernas ekonomiska ställning från ett år till ett annat borde upplevas som störande ur ett invånarperspektiv.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3.3",
      "sentiment": 0.0,
      "quote": "Kungsörs kommuns skattesats har i hög grad påverkats av skattenivåerna i omgivande kommuner, vilket enligt utredningen ofta har betydelse för kommunernas val av skattesats.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.1",
      "sentiment": 0.5,
      "quote": "Verksamhetens effektivitet bör ges större tyngd i planering och uppföljning av kommunerna och även större tyngd i revisorernas granskning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.3",
      "sentiment": 0.2,
      "quote": "Det skulle även i övrigt vara till nytta med bättre analysverktyg för att stödja effektiviseringar, men det inte är någon enkel materia som ska utvärderas och kan bli väldigt komplext.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.2",
      "sentiment": -0.5,
      "quote": "Kommunstyrelsen ser inte nyttan med förslaget och kan inte se något fog för staten att överpröva de förtroendevaldas beslut om skattesats.",
      "quote_type": "grund"
    }
  ]
