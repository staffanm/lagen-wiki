  "segments": [
    {
      "forarbete_id": "a4.1",
      "sentiment": -1.0,
      "quote": "Vi anser att det är mer kostnadseffektivt att stärka Naturvårdsverket finansiellt samt tydliggöra Naturvårdsverkets roll inom viltförvaltning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.2",
      "sentiment": -1.0,
      "quote": "WWF anser att ett gediget beslutsunderlag måste utgå från en utvärdering av hur det samlade myndighetsansvaret och ansvarsfördelningen har fungerat hittills och vilka kvarstående brister som finns",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.3",
      "sentiment": -0.5,
      "quote": "vi ser en risk att det skulle splittra upp arbetet med artskydd och skapa ett mer ineffektivt artskyddsarbete generellt, även om det skulle kunna finnas fördelar för jaktbart vilt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.4",
      "sentiment": -1.0,
      "quote": "Att flytta artskyddet till en helt ny myndighet med viltförvaltning i fokus riskerar att fragmentera naturvårdsarbetet, försvaga skyddet för hotade arter, försvaga åtgärdssamordningen och skapa otydlighet i ansvarsfördelningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.5",
      "sentiment": -1.0,
      "quote": "Det är viktigt att arbetet sker holistiskt på en och samma myndighet.",
