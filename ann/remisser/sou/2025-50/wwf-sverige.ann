    },
    {
      "forarbete_id": "a4.8",
      "sentiment": 0.5,
      "quote": "WWF anser att det även bör läggas vikt vid att brukaren tar ansvar för att bedriva sin verksamhet på ett sätt som minimerar risken för skador.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.9",
      "sentiment": -1.0,
      "quote": "Att lyfta ut dessa arter till en myndighet med fokus på landlevande vilt riskerar att fragmentera förvaltningen och försvaga helhetsperspektivet för den marina miljön.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.10",
      "sentiment": -1.0,
      "quote": "Naturvårdsverket och Havs- och vattenmyndigheten har lång erfarenhet av att implementera dessa, dären ny myndighet skulle behöva bygga upp denna kompetens, vilket kan skapa rättsosäkerhet och fördröjningar.",
      "quote_type": "grund"
    },
    {
