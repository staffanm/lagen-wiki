  "segments": [
    {
      "forarbete_id": "sec17",
      "sentiment": 0.5,
      "quote": "Detta förtydligande är önskvärt förutsatt att det kan kopplas till tillräckliga medel för utförandet och konkreta krav på omfattning.",
