    },
    {
      "forarbete_id": "a5.11",
      "sentiment": -1.0,
      "quote": "Länsstyrelsens bedömning i övrigt är framför allt kopplat till att de omfattande vapenärendena i annat fall skulle bli den huvudsakliga arbetsuppgiften för en ny viltmyndighet, vilket inte gagnar myndighetens alla övriga uppdrag.",
      "quote_type": "grund"
