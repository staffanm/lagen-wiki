  "segments": [
    {
      "forarbete_id": "a4.14",
      "sentiment": 0.5,
      "quote": "Myndigheterna är därför väl lämpade att ta över uppgifterna gällande tillståndsprövning och besiktning av civila skjutbanor.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.18",
      "sentiment": 1.0,
      "quote": "Jakttillsynen i Sverige är som bäst bristfällig och en stärkt jakttillsyn är ett viktigt steg i arbetet att förebygga och beivra jaktbrott.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.5",
      "sentiment": -1.0,
      "quote": "En uppdelning av arbetet mellan flera myndigheter riskerar att leda till ineffektivitet, särskilt om ansvaret för vilda däggdjur och fåglar flyttas till en ny viltförvaltningsmyndighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.6",
      "sentiment": 0.5,
      "quote": "Det finns möjlighet att samla och effektivisera myndigheternas arbete genom att centralisera det.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8",
      "sentiment": 1.0,
      "quote": "Det är ändamålsenligt att flytta Polismyndighetens ansvar för statens vilt till länsstyrelserna även om Polismyndigheten fortsättningsvis bör ta emot anmälningar vid misstanke om brott.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen välkomnar ett förtydligande av myndigheternas uppdrag inom viltförvaltningen där ansvaret att väga samman flera viktiga aspekter tydligt kommer framgå.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.7.1",
      "sentiment": -0.2,
      "quote": "Om länsstyrelserna får i uppdrag att utföra prövning, tillsyn och besiktning, samt att upprätta och hålla register över de civila skjutbanorna kommer ytterligare resurser behövas och finansieringen för det säkras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.7.2",
      "sentiment": 0.5,
      "quote": "Länsstyrelsen delar utredningens bedömning att länsstyrelserna kommer behöva en större resursförstärkning för uppgiften än de 2,5 årsarbetskrafter som Polismyndigheten redovisar idag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.7.3",
      "sentiment": -0.5,
      "quote": "Det är svårt att i dagsläget avgöra exakt vilka konsekvenserna av förslaget är för länsstyrelserna och vilken finansiering som skulle behövas för att myndigheterna ska kunna uppfylla sina framtida skyldigheter.",
      "quote_type": "grund"
