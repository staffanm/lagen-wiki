  "segments": [
    {
      "forarbete_id": "sec17",
      "sentiment": 0.5,
      "quote": "Detta förtydligande är önskvärt förutsatt att det kan kopplas till avsatta medel för utförandet och konkreta krav på omfattning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4",
      "sentiment": 0.2,
      "quote": "Länsstyrelsen anser dock att det är ineffektivt att bygga upp en ny myndighet för att göra de uppgifter som det redan finns en organisation för.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.18.2",
      "sentiment": 0.5,
      "quote": "Kapacitet för att hantera sådan tillsyn bedöms ej rymmas inom nuvarande personal eller budgetutrymme.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5.2",
      "sentiment": 0.5,
      "quote": "Länsstyrelsen bedömer att det vore starkt motiverat att ge en ny viltförvaltningsmyndighet i uppdrag att ha samordningsansvar för dessa frågor, inte enbart samverkansuppdrag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.11",
      "sentiment": -1.0,
      "quote": "Länsstyrelsens bedömning i övrigt är framför allt kopplat till att de omfattande vapenärendena i annat fall skulle bli den huvudsakliga arbetsuppgiften för en ny viltmyndighet, vilket inte gagnar myndighetens alla övriga uppdrag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6",
      "sentiment": 0.5,
      "quote": "För att överföringen av dessa uppgifter till länsstyrelserna ska vara möjlig behövs utökad finansiering.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8",
      "sentiment": -0.5,
      "quote": "Skälet är att Länsstyrelsen i dagsläget saknar den organisatoriska struktur och kapacitet som krävs för att utföra uppdraget alla dagar i veckan.",
