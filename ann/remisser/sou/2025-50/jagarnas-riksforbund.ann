    },
    {
      "forarbete_id": "a4.3.2",
      "sentiment": 0.2,
      "quote": "vissa invasiva arter som i dagsläget hanteras på samma sätt som däggdjur och fåglar riskerar att med den definitionen falla mellan stolarna.",
