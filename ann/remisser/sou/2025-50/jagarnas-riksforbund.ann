    },
    {
      "forarbete_id": "a4.1",
      "sentiment": 1.0,
      "quote": "Därför behövs en ny myndighet som har ett främjandeuppdrag vid sidan av såväl bevarande- som skademinimerande uppdrag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec256",
      "sentiment": -1.0,
      "quote": "JRF anser att en ny myndighet för viltförvaltning och vapenärenden ska bildas och avstyrker därför utredarens alternativ I.",
