    },
    {
      "forarbete_id": "sec16",
      "sentiment": 1.0,
      "quote": "Det harmonierar i större utsträckning med annan lagstiftning och skapar en bättre förutsättning att hantera det av statens vilt som påträffas dött.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec17",
      "sentiment": 0.5,
      "quote": "Förutsättningarna över landet är olika och därför måste också besluten om viltförvaltningen anpassas för att jakten ska ges så bra möjligheter som möjligt i olika delar av landet.",
