    },
    {
      "forarbete_id": "a4.2",
      "sentiment": 1.0,
      "quote": "JRF delar i stora drag utredarens motivering varför en ny myndighet behövs och hur det kan förbättra förutsättningarna för jakten och viltförvaltningen i landet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.3",
      "sentiment": 1.0,
      "quote": "Viltet är en naturresurs som är annorlunda än de övriga resurserna, till exempel skog och jord.",
