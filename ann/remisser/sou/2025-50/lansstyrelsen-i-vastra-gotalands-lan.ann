    },
    {
      "forarbete_id": "a4.18.2",
      "sentiment": 0.5,
      "quote": "I dagsläget saknar Länsstyrelsen resurser för att kunna utföra tillsyn, då uppgiften kräver särskild kompetens och en närvaro i fält.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.5",
      "sentiment": -0.5,
      "quote": "Det finns en uppenbar risk att olika nationella myndigheter tolkar lagstiftningen på olika sätt och att vägledningen till tillsynsmyndigheterna därmed kan komma att skilja sig mellan artgrupper, vilket även skulle försvåra länsstyrelsernas interna samordning av tillsynen av invasiva främmande arter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.6",
      "sentiment": -0.5,
      "quote": "Om ansvaret delas upp försvinner helhetsbilden och vägledning kring tillsynen riskerar att skilja sig åt mellan arter på ett sätt som inte är motiverat ur artskyddssynpunkt.",
      "quote_type": "grund"
