  "segments": [
    {
      "forarbete_id": "a10.2",
      "sentiment": -0.2,
      "quote": "Tingsrätten anser att begreppet torvmark behöver definieras på ett sådant sätt att det klart framgår vad som utgör en torvmark, t.ex. med avseende på yta och mäktighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a17.2.4",
      "sentiment": -0.2,
      "quote": "Tingsrätten anser att formuleringen ”eller kompensera” skapar utrymme för feltolkning genom villfarelsen att alla steg i skadelindringshierarkin inte behöver följas utan att intrånget i stället kan kompenseras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.5",
      "sentiment": -0.2,
      "quote": "Tingsrätten saknar i det sammanhanget ett resonemang gällande avvägningen mellan miljökonsekvenserna av upphörd brytning och användning av alternativa produkter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a17.1.4",
      "sentiment": -1.0,
      "quote": "Urvalet av vilka områden som ska prioriteras i bevarandearbetet enligt 7 kap. miljöbalken bör ske på andra grunder än utgången i 12:6-samåd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.4.1",
      "sentiment": -0.2,
      "quote": "Tingsrätten anser att förhållningssättet behöver vara konsekvent för de olika typer av vattenverksamheter som listas i 19 § förordningen om vattenverksamheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.5",
      "sentiment": -1.0,
      "quote": "Tingsrätten anser att förslaget är vagt formulerat och svårt att tillämpa.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.4.2",
      "sentiment": -0.2,
      "quote": "Domstolen noterar dock att det inte finns något författningsförslag i denna del och saknar också en analys över hur förslaget förhåller sig till praxis (se t.ex. NJA 2012 s. 362).",
      "quote_type": "grund"
