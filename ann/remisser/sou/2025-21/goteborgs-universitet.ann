    },
    {
      "forarbete_id": "a12.5",
      "sentiment": -1.0,
      "quote": "Det behövs ett omedelbart stopp för all torvbrytning och därför är MMB’s förslag, att begränsa möjligheten att få nya och förlängda tillstånd från nästa år, helt otillräckligt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec256",
      "sentiment": -0.5,
      "quote": "För jordbruksmarker borde fokus vara på att återväta nu brukad organogen jordbruksmark som är djupt dränerad.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.4",
      "sentiment": 0.5,
      "quote": "Det är bra att MMB lyfter det orimliga att det krävs tillstånd för att restaurera våtmarker.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.6",
      "sentiment": 0.2,
      "quote": "Förslaget att bara ändra i texten för miljökvalitetsmålet blir då helt otillräckligt, eftersom miljökvalitetsmålen hittills inte visat sig vara ett starkt styrmedel med tvingande åtgärder som gör att vi uppnår målen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.7",
      "sentiment": 0.8,
      "quote": "Det är bra att MMB räknat med de mer uppdaterade och differentierade emissionsfaktorer för återvätning som vi tagit fram vid Göteborgs universitet och som är mer användbara än vad IPCC’s redovisade emissionsfaktorer från 2014 är.",
      "quote_type": "grund"
