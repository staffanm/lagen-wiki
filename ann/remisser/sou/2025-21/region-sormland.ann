  "segments": [
    {
      "forarbete_id": "sec424",
      "sentiment": 1.0,
      "quote": "Region Sörmland anser att ändringen av definitionen av gammal skog är bra och att det är viktigt att Sverige använder samma definition i båda regelverken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.1.4",
      "sentiment": 0.2,
      "quote": "Skydd av gammal skog måste ske i överenskommelse med markägaren och med full ersättning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.3.8",
      "sentiment": -0.5,
      "quote": "Sverige behöver se över sitt sätt att rapportera då Sverige i dagsläget skyddar mycket mer skog än det som framstår.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.1",
      "sentiment": 1.0,
      "quote": "Region Sörmland vill betona att det är bra att det finns förslag om frivillighet och anslag för återvätning.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a9.2.2",
      "sentiment": 0.2,
      "quote": "Det föreslås flera åtgärder för att öka kolinlagringen i jordbruksmark bland annat stöd för bioraffinaderier som kan öka marknaden för vall.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.6.2",
      "sentiment": -0.2,
      "quote": "Detta kan på sikt påverka möjligheterna att ersätta fossilt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": 1.0,
      "quote": "Region Sörmland vill framföra att det är bra med en satsning på utbildning och en utökad satsning på lokala åtgärdssamordnare för biologisk mångfald.",
      "quote_type": "standpunkt"
    }
  ]
}