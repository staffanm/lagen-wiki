  "overall": {
    "sentiment": 0.2,
    "quote": "Myndigheten anser dock att strategins avgränsning är för snäv genom att akvatiska miljöer inte beaktats i tillräcklig omfattning.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a6.1",
      "sentiment": 0.5,
      "quote": "Havs- och vattenmyndigheten tillstyrker att Naturvårdsverket, Skogsstyrelsen, Jordbruksverket och länsstyrelserna får uppdrag om en breddad och riktad informations- och rådgivningsinsats enligt förslaget i strategin, men föreslår att den samordnas med Havs- och vattenmyndigheten för att få det helhetsperspektiv som krävs för ett effektivt åtgärdsarbete.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": 0.5,
      "quote": "Myndigheten anser att stödfunktionen behöver ha nära samarbete med Havs- och vattenmyndighetens rådgivning för länsstyrelser och lokala åtgärdsaktörer i kommande kunskapsportal till stöd för aktiv restaurering.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2",
      "sentiment": 0.5,
      "quote": "Denna rådgivning och information behöver fokusera på vilka marker som är lämpliga att gödsla och hur gödslingen ska genomföras för att undvika negativ påverkan på vattenmiljöer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2",
      "sentiment": 0.5,
      "quote": "HaV anser att effekterna på vattenmiljöer också bör utvärderas innan ett stöd införs.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2",
      "sentiment": -0.5,
      "quote": "Myndigheten anser att det är olämpligt att påbörja en storskalig skogsgödsling redan 2026, eftersom en tydlig rådgivning om vilka marker som är lämpliga att gödsla och hur gödslingen ska genomföras måste formuleras innan gödslingen påbörjas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.3",
      "sentiment": -0.5,
      "quote": "Att inrätta ett nationellt råd för vattenresursförvaltning vore dock ett alternativ som kan få större genomslag på åtgärdsarbetet och därmed leda till en större effekt i miljön.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.4.1",
      "sentiment": -0.5,
      "quote": "Havs- och vattenmyndigheten anser därför att det bör införas en begränsning av vilken maximal yta för återvätning som kan anmälas istället för att tillståndsprövas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.4.2",
      "sentiment": -0.5,
      "quote": "Havs- och vattenmyndigheten anser inte att de rättsliga förutsättningarna för förslaget är tydliga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.1.1",
      "sentiment": 0.5,
      "quote": "Det behöver dock tydliggöras att även akvatiska miljöer omfattas av prioriteringarna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.1.3",
      "sentiment": 0.5,
      "quote": "Oskyddade naturmiljöer med höga naturvärden och områden med skötselbehov i riksintresseområdet bör dock även fortsättningsvis kunna prioriteras för formellt skydd och särskilt de områden som är i behov av skötsel.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.1.1",
      "sentiment": 0.5,
      "quote": "Om Sverige ska klara de mål som har ställts upp i EUs strategi för biologisk mångfald till 2030 är det dock nödvändigt att fler naturtyper än skog, skyddas formellt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.1.1",
      "sentiment": 0.5,
      "quote": "Här är det dock viktigt att se till helheten och att skogsekosystemen innehåller vattenmiljöer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.1.12",
      "sentiment": -0.2,
      "quote": "Myndigheten ser en risk att områden rapporteras som inte kommer att leva upp till de krav som ställs för att erkännas som OECM.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.2.1",
      "sentiment": -0.5,
      "quote": "Vissa naturreservat kan bedömas vara strikt skyddade men det gäller inte generellt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.2.1",
      "sentiment": -0.5,
      "quote": "Påverkan på vattenmiljöer i Natura 2000områden är fortfarande ofta för hög för att bedömas som minimal och utan mänsklig påverkan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a17.2.4",
      "sentiment": 0.8,
      "quote": "Havs- och vattenmyndigheten anser att de föreslagna ändringarna är ändamålsenliga för syftet att öka takten i arbetet med att åstadkomma ekologisk kompensation.",
      "quote_type": "grund"
    }
  ]
