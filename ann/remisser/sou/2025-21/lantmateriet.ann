    },
    {
      "forarbete_id": "a19",
      "sentiment": -0.2,
      "quote": "Lantmäteriet kan här bland annat se behovet av ytterligare utredningsåtgärder vid fastighetsbildning vilket i sin kan medföra längre handläggningstider och ökade kostnader för sakägare.",
      "quote_type": "grund"
