  "segments": [
    {
      "forarbete_id": "a5",
      "sentiment": 0.5,
      "quote": "För en helhetssyn avseende vad en fastighet berörs av med avseende på exempelvis naturvård och biologisk mångfald så behövs information från fastighetsregistret i kombination med information från andra myndigheter samt kännedom om avtal.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6",
      "sentiment": 0.2,
      "quote": "det kan vara av vikt att notera att även Lantmäteriet skulle kunna komplettera med viss ytterligare information på exempelvis sin hemsida – kopplat till myndighetens roll avseende exempelvis planer och bestämmelser i fastighetsregistret samt geodata i klimatanpassningsarbete.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10",
      "sentiment": 0.0,
      "quote": "Detta är frågor som skulle kunna komma att beröra specifikationer för informationsmängder i den nationella geodataplattformen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.4",
      "sentiment": 0.8,
      "quote": "Lantmäteriet instämmer i detta då reglerna idag är svårtillämpade och redovisningen bristfällig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13",
      "sentiment": 0.0,
      "quote": "En fråga som ytterligare bör belysas är hantering av område under kraftledningsgata, i relation till rätt till kraftledning samt fastighetsägarens rätt till mark under ledningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.1.4",
      "sentiment": -0.5,
      "quote": "Från ett fastighetsbildningsmässigt perspektiv kan nämnas att denna möjlighet troligen är minimal.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a15.1.4",
      "sentiment": 0.0,
      "quote": "En uppdatering av skötselplaner torde dock inte påverka Lantmäteriet då det inte är fråga om ett nytt ellet ändrat beslut.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a17",
      "sentiment": 0.0,
      "quote": "Här kan noteras pågående arbete med specifikation för översiktsplan för tillgängliggörande av informationsmängden via den nationella geodataplattformen.",
