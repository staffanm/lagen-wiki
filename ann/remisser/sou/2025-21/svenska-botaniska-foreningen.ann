    },
    {
      "forarbete_id": "a16.1.6",
      "sentiment": 0.5,
      "quote": "Föreningen vill återigen påpeka att befintliga marker som hävdas inte får försämras i konkurrens om ekonomiska resurser med nyrestaurerade myrar, hamlade träd och bränning av ljunghedar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.1.8",
      "sentiment": 1.0,
      "quote": "SBF ser att det är av stor betydelse för den biologiska mångfalden att vi frångår synsättet med ett ”antingen-eller-landskap” som präglas av skarpa övergångar mellan jordbruksoch skogsmark.",
      "quote_type": "grund"
