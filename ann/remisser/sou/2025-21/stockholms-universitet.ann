    {
      "forarbete_id": "a14",
      "sentiment": -0.5,
      "quote": "Utifrån utvecklingen under de senaste två årtiondena är det osannolikt att föreslagna åtgärder ska kunna leda till ett övertygande skydd för merparten av svensk naturskog inom några få år.",
      "quote_type": "grund"
