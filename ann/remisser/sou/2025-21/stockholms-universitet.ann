    {
      "forarbete_id": "a9",
      "sentiment": 0.2,
      "quote": "Universitetet beklagar att Miljömålsberedningen inte lämnar några förslag om effekterna av plöjningsfritt jordbruk, vilket är ett sätt att öka mångfalden och kolinlagringen i åkermarken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.5",
      "sentiment": 0.8,
      "quote": "Torv är att betrakta som rent fossilt bränsle, och dess användning till energi eller blomjord är inte hållbar.",
