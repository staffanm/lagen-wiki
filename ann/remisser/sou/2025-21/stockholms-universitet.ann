    {
      "forarbete_id": "a6",
      "sentiment": 0.5,
      "quote": "En lokal åtgärdssamordnare kan bistå i att få till en helhetsbild och därmed dirigera rådgivningen i en positiv riktning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2",
      "sentiment": -0.5,
      "quote": "Det finns många studier som pekar på risker för en minskad biodiversitet i samband med gödsling.",
