    {
      "forarbete_id": "a16",
      "sentiment": -0.2,
      "quote": "Ur ett mångfaldsperspektiv är det därför viktigare att bevara en gräsmark än att skapa nya – det kan ta decennier innan en restaurerad mark kommer upp i samma naturvärden, biologiska mångfald och ekosystemtjänster.",
      "quote_type": "grund"
