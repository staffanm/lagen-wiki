  "segments": [
    {
      "forarbete_id": "a6.2",
      "sentiment": 0.2,
      "quote": "Det är otydligt beskrivet, med tanke på bredden i uppgifterna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2",
      "sentiment": -0.2,
      "quote": "Det är viktigt att konsekvenserna för biologisk mångfald utreds innan en större satsning på gödsling av skogsmark inleds.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2.3",
      "sentiment": 0.5,
      "quote": "Samtidigt bör hänsyn tas till mellangrödors totala klimatpåverkan, bland annat att mellangrödor, framför allt icke-vinterhärdiga arter, kan leda till ökade lustgasemissioner.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2.2",
      "sentiment": -0.2,
      "quote": "Tidigare stöd togs bort eftersom stödet innehöll moment av dödvikt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2.1",
      "sentiment": -0.5,
      "quote": "Det finns ett antal vetenskapliga studier som motsäger detta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10",
      "sentiment": 0.2,
      "quote": "förutom minskad livsmedelsproduktion även biologisk mångfald kan påverkas negativt vid exploatering av mark och detta ska vägas in i planeringsprocesser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.5",
      "sentiment": 0.2,
      "quote": "alternativ till torv för denna användning, ser KSLA det som viktigt att utvecklingen av alternativ för plant- och jordbrukets produktion prioriteras under övergångstiden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13",
      "sentiment": 0.2,
      "quote": "en utvidgad användning av begreppet till exempel till artrika vägkanter, kräver att varje objekt har en tydlig positiv effekt för biologisk mångfald och en långsiktig garanti för bevarande och skötsel.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14",
      "sentiment": -0.2,
      "quote": "Eftersom valet av definition påverkar hur stora arealer som berörs, behövs en transparent process där alla aktörer ges möjlighet att delta och konsekvensanalyser genomförs av alternativa definitioner.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a15",
      "sentiment": -0.5,
      "quote": "ersättning enligt 31 kap 4 § Miljöbalken som föreslås av beredningen inte ger fullt skydd för äganderätten i enlighet med expropriationslagstiftningen",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a17",
      "sentiment": -0.2,
      "quote": "KSLA förordar att uppdraget ges till centrala myndigheter (Jordbruksverket, Skogsstyrelsen och Naturvårdsverket) för att utarbeta ett rättssäkert förslag till utformning i samverkan med berörda parter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a18",
      "sentiment": -0.5,
      "quote": "indirekta drivkrafter i samhället som är avgörande för förlusten av biologisk mångfald inte berörs specifikt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19",
