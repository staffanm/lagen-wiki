    {
      "forarbete_id": "a10.2",
      "sentiment": -0.2,
      "quote": "Begreppet verksamhetsutövare passar inte in i det sammanhanget då planläggning och bygglov många gånger inte förutsätter att någon verksamhet i miljöbalkens mening kommer att bedrivas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.5",
      "sentiment": -0.5,
      "quote": "Den nya paragrafen kan knappast hänvisa till förbudet avseende våtmarker som utgör värdefull natur- eller kulturmiljö när syftet är ett totalt förbud, och innebörden av den föreslagna paragrafen är alltför svår att förstå.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.4",
      "sentiment": -0.2,
      "quote": "Domstolen förespråkar att frågan behandlas i det fortsatta lagstiftningsarbetet och att det föreslagna tillägget inte placeras i 12 kap. 6",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.4",
      "sentiment": 0.2,
      "quote": "vill lyfta fram att tillståndet utgör ett skydd för den part som innehar tillståndet dvs. investerar i en våtmarksrestaurering.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.4.1",
      "sentiment": -0.2,
      "quote": "Enligt domstolens erfarenhet utgör majoriteten av de våtmarksanläggningar i jordbrukslandskapet som tillståndsprövats där det tidigare funnits en våtmark, av att dammvallar anläggs och alltså inte av återställning till tidigare skick.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.4.1",
      "sentiment": -0.2,
      "quote": "Det förefaller oklart i vilken situation som länsstyrelsen i egenskap av tillsynsmyndighet skulle acceptera en anmäld verksamhet som påverkar en markavvattningssamfällighet utan att förordna om tillståndsplikt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.4.2",
      "sentiment": -0.5,
      "quote": "Särregleringen skulle i detta läge ge företräde för återvätningen oaktat vilken skada en återvätning skulle ha på samfalligheten avseende hydrologisk påverkan och dess inverkan på frågan om en samfallighets fortsatta bestånd, kretsen av deltagare eller kostnadsfördelningen mellan dem.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.8",
      "sentiment": -0.2,
      "quote": "Domstolen ifrågasätter att återinförsel av stenar och grus för att fördröja vattnets väg i landskapet kan räknas som restaurering av våtmark såsom det anges i avsnitt 12.8.",
      "quote_type": "grund"
    }
