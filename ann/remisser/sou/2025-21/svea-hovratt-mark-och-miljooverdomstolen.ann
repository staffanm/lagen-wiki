  "segments": [
    {
      "forarbete_id": "a10.2",
      "sentiment": -0.2,
      "quote": "Praxis avseende 3 kap. 4 & miljöbalken ger dock ingen ledning i bedömningen om vad som ska anses utgöra torvmark och därmed vilken mark som ska omfattas av den nya paragrafen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.5",
      "sentiment": 0.5,
      "quote": "För att tydliggöra att det i princip råder ett förbud mot nya tillstånd till torvtäkt kan bestämmelsen utformas enligt följande:",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a17.2.4",
      "sentiment": -0.2,
      "quote": "Den föreslagna ändringen kan dock tolkas som att verksamhetsutövaren kan välja mellan att lämna uppgifter om kompensationsåtgärder eller uppgifter om åtgärder som planeras för att förebygga, hindra, motverka eller avhjälpa negativa miljöeffekter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a17.1.4",
      "sentiment": -0.8,
      "quote": "Det framstår som främmande att i denna bestämmelse ålägga tillsynsmyndigheten att aktivt verka för inrättande av ett områdesskydd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.4",
      "sentiment": -0.2,
      "quote": "Då verksamheterna, i vart fall teoretiskt sett, kan tänkas bli mycket stora frångår det förordningens generella systematik som, utifrån verksamhetens omfattning, på olika sätt begränsar vilka vattenverksamheter som enbart behöver anmälas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.3",
      "sentiment": -0.2,
      "quote": "Innan förordningen införs bör det därför övervägas om överklagandeförbudet är förenligt med EKMR.",
      "quote_type": "grund"
    }
  ]
}