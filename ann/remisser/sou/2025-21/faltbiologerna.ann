  "segments": [
    {
      "forarbete_id": "a14.1.1",
      "sentiment": -1.0,
      "quote": "Detta representerar en ytterst liten andel av den svenska skogen, och tar ingen hänsyn till processen av ekologisk succession eller till vikten av en blandning av ålder i träd i ett skogligt ekosystem.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2",
      "sentiment": -1.0,
      "quote": "Med tunnare och magrare matjord, som vi ser allt oftare i de skogar vars tillväxt bedöms vara problematisk, ökar takten som näringsämnena från gödslingen rinner ut i vattendrag, där de bidrar till ökad övergödning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec190",
      "sentiment": 1.0,
      "quote": "Mot bakgrund av detta är vi mycket positiva till att Miljömålsberedningen diskuterar möjligheter till askåterföring till skog för att öka tillväxt, som beräknas skulle ha högre effekt än gödsling samt bidra till att minska försurning, som är vanligt särskilt i talldominerade skogar eller plantager.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec265",
      "sentiment": 1.0,
      "quote": "Fältbiologerna är positiva till Miljömålsberedningens förslag om återvätning av organogena jordar, och – som en förening som arbetar aktivt med restaurering av akvatiska och våtmarksmiljöer – ser särskilt positivt på förslaget att restaureringsåtgärder ska kräva anmälningsplikt istället för tillståndsplikt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.1",
      "sentiment": 0.2,
      "quote": "Vi välkomnar satsningen på naturbete som är en ytterst viktig fråga men anser inte att beredningen lyfter vikten av konnektivitet av landskap tillräckligt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": 1.0,
      "quote": "Fältbiologerna är särskilt positiva till förslag om åtgärdssamordnare för biologisk mångfald, något som även kommer att gynna Sveriges arbete med naturrestaureringsförordningen.",
      "quote_type": "grund"
    }
  ]
}