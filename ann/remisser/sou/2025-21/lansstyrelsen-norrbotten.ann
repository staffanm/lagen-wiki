    },
    {
      "forarbete_id": "a8.2",
      "sentiment": 0.2,
      "quote": "tveksam till att det är ett tillräckligt effektivt instrument för ökat kolupptag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.2",
      "sentiment": -0.2,
      "quote": "Länsstyrelsen anser det är oklart vilken effekt förslaget i praktiken kan få.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.1.1",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen tillstyrker förslaget.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a12.1",
      "sentiment": 0.5,
      "quote": "anser att det inte lämpar sig ha strikta kategorier av syften såsom de tre anslagsposterna Miljömålsberedningen föreslår eftersom våtmarker är multifunktionella.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.1",
      "sentiment": 0.5,
      "quote": "I de flesta fall kommer inte en våtmark att gå från en naturtyp till en annan vid en återvätning eller restaurering men det bidrar så gott som alltid till en bättre bevarandestatus genom att man återställer de hydrologiska förhållandena",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.3",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen tillstyrker förslaget att Naturvårdsverket får i uppdrag att inrätta ett nationellt återvätningsråd och att länsstyrelsen, Jordbruksverket och Skogsstyrelsen får i uppdrag att bistå rådet.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a12.4.1",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen tillstyrker förslaget.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a12.4.2",
      "sentiment": 0.5,
      "quote": "Undantaget borde även inkludera utrivning av markavvattningsanläggning då syftet är att återställa livsmiljöer för skyddade arter, den biologiska mångfalden",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.5",
      "sentiment": 0.5,
      "quote": "Länsstyrelsen föreslår att man borde utreda om det går att återväta de torvtäkter som redan har efterbehandlats under tidigare år.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.6",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen tillstyrker förslaget.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a13.1.13",
      "sentiment": -1.0,
      "quote": "Länsstyrelsen delar inte utredningens bedömning att denna uppgift bör kunna hanteras inom ramen för länsstyrelsens befintliga uppgift.",
