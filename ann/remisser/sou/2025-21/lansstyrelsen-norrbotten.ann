    },
    {
      "forarbete_id": "a14.1.1",
      "sentiment": -1.0,
      "quote": "eftersom förslaget inte tar någon hänsyn till de naturskogar som är i behov av formellt skydd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.1.2",
      "sentiment": -1.0,
      "quote": "Länsstyrelserna har kontinuerligt kartlagt, fältbedömt och avgränsat skogar med höga naturvärden inom arbetet med formellt reservatsskydd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.1.3",
      "sentiment": -1.0,
      "quote": "Länsstyrelsen avstyrker förslaget eftersom Skogsstyrelsens har för lite tid och resurser för att hinna med detta arbete.",
