    },
    {
      "forarbete_id": "a12.5",
      "sentiment": -0.2,
      "quote": "Svebio anser att det är viktigt att säkerställa att tillräckligt med odlingstorv som används som substrat i exempelvis plantskolor och kommersiella trädgårdsodlingar kommer finnas tillgängligt så länge det inte finns andra likvärdiga alternativ som kan produceras i tillräcklig mängd i Sverige.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.1",
      "sentiment": -0.2,
      "quote": "Detta innebär att Sverige framställs i ett sämre ljus.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.1.1",
      "sentiment": -0.2,
      "quote": "Svebio anser att det är olämpligt att Miljömålsberedningen skiljer på ”naturskog” enligt EU:s biodiversitetsstrategi och ”gammal skog” som den definieras i förnybartdirektivet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a15.1",
      "sentiment": -0.2,
      "quote": "Detta förslag speglar en mycket restriktiv syn på vad som är skyddad natur och en syn som står i konflikt med uppdelningen i EU:s biodiversitetsstrategi mellan ”strikt” och ”icke strikt skydd”.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a17.2.3",
      "sentiment": -1.0,
      "quote": "Förslaget riskerar att skapa stor rättsosäkerhet då vad som är höga naturvärden handlar om subjektiva bedömningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a17.2.6",
      "sentiment": 1.0,
      "quote": "Det finns ett värde i samordning som kan bidra till att tydliggöra och förstärka synergier mellan naturvård och energiinfrastruktur, där olika aktörer tillsammans kan hitta lösningar som både gynnar biologisk mångfald och underlättar samhällsviktig drift.",
