    },
    {
      "forarbete_id": "a10.2",
      "sentiment": -0.5,
      "quote": "Nyanläggning alternativt underhåll av skogsbilvägar med passager över torvmark kan dock vara en förutsättning för att göra skogen tillgänglig för åtgärder inom skogsbruket.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.1.1",
      "sentiment": 0.2,
      "quote": "Det är inte realistiskt att minska utsläppen från dränerad organogen mark till 2030 i den omfattning som beredningen föreslår, se även avsnitt 12.2.1.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.1",
      "sentiment": 0.5,
      "quote": "Det är dock otydligt huruvida det nya anslaget ska disponeras av Skogsstyrelsen och/eller länsstyrelsen",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.3",
      "sentiment": 0.2,
      "quote": "Möjligen skulle dock inrättande av en riktad forskningsfond vara mer effektivt och bättre bidra till en gemensam bild av den samlade forskningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.1.2",
      "sentiment": 0.5,
      "quote": "Genom att skilja ut ersättningar som Skogsstyrelsen har rådighet över från intrångsersättningar som är mer händelsestyrda, skulle möjligheterna till ett mer strategiskt arbete med formellt skydd öka.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.1.9",
      "sentiment": -1.0,
      "quote": "Återvätningsavtal saknar förvaltningsmål för områdets naturvärden och skötselplan upprättas inte för de områden som återvätningsavtalen tecknas för, vilket är kriterium för att områden ska kunna rapporteras som ett OECM.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.1.10",
      "sentiment": 0.5,
      "quote": "Det är därför mest ändamålsenligt och effektivt att även insamling av markägares frivilliga avsättningar som kan rapporteras som OECM sker via Skogsstyrelsen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.1.11",
      "sentiment": 0.2,
      "quote": "Det är tveksamt om det finns incitament för markägare att rapportera dessa områden som OECM.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.1.12",
      "sentiment": 0.5,
      "quote": "Det är därför mest ändamålsenligt och effektivt att även insamling av markägares frivilliga avsättningar som kan rapporteras som OECM sker via Skogsstyrelsen.",
      "quote_type": "grund"
