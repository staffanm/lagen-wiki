  "overall": {
    "sentiment": -0.4,
    "quote": "Vidare är konsekvensanalyserna bristfälliga, både avseende kostnadsuppskattningar för staten men även förslagens effekter för virkesförsörjning, arbetstillfällen och levande landsbygd.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a6",
      "sentiment": 0.5,
      "quote": "Södra bedriver ett omfattande rådgivningsarbete till medlemmar kopplat till klimatanpassning, tillväxt, miljöhänsyn, naturvård och arthänsyn och samverkansmöjligheter finns med skogsägarföreningarna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7",
      "sentiment": -0.8,
      "quote": "Södra anser att förslagen visar på en alltför endimensionell syn på skogens klimatnytta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2",
      "sentiment": 1.0,
      "quote": "Gödsling är den enda åtgärden som vi har rådighet över som medför ökad tillväxt på kort sikt utan att medföra ett kolläckage.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2",
      "sentiment": -1.0,
      "quote": "Förutom att överhållning minskar möjligheterna i klimatomställningen genom betydande minskning av råvara till skogsindustrin så är det ett förslag som har mycket tveksam klimatnytta till en hög samhällskostnad.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2.4",
      "sentiment": -1.0,
      "quote": "För det andra har LULUCF-målen litet att göra med hållbara avverkningsnivåer utan är framför allt ett sätt att använda markanvändningssektorn för att buffra för fossila sektorers utsläpp.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.2",
      "sentiment": -0.5,
      "quote": "Det är inte rimligt att en enskild skogsägare vid anläggande av en skogsbilväg ska göra beräkningar på vilket effekt det får på kolupptag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.1",
      "sentiment": 1.0,
      "quote": "Det illustrerar ytterligare nyttan med träbyggnationer vilket kan leda till ökat byggande i trä.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.1.2",
      "sentiment": 1.0,
      "quote": "Förslaget ligger helt i linje med Skogsindustrins framtidslöfte om att skogsindustrins produkter till 2040 ska vara helt fossilfria och återvinningsbara.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.4.1",
      "sentiment": 1.0,
      "quote": "Det finns ett stort intresse hos markägare att öka skogslandskapet vattenhållande förmåga vilket inte ska motverkas med tung byråkrati.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.5",
      "sentiment": -0.2,
      "quote": "eftersom det än så länge inte finns några likvärdiga alternativ.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.2",
      "sentiment": -0.2,
      "quote": "I det sammanhanget anser Södra att exempelvis strandskyddsområden, våtmarker och myrar, ädellövskog, skogliga impediment, hela området ovan gränsen för fjällnära skog samt artskyddsförbud så länge de avgränsas geografiskt eftersom alla har ett legalt skydd som begränsar markanvändningen på ett sätt som främjar naturvärden, även om det inte är det primära syftet för skyddet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.1.1",
      "sentiment": -0.5,
      "quote": "Vidare är det rättsosäkert om samma begrepp får olika definitioner vid svensk uttolkning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.1.4",
      "sentiment": 1.0,
      "quote": "det är viktigt att säkerställa tillräckliga resurser för detta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.1.4",
      "sentiment": -1.0,
      "quote": "Denna lucka i Jordförvärvslagen gör att balansen i markägandet, både geografiskt och andelsmässigt, förändras till nackdel för familjeskogsbruket.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.1.2",
      "sentiment": 1.0,
      "quote": "Det ökar förutsägbarheten för den enskilda skogsägaren.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a15.1",
      "sentiment": 1.0,
      "quote": "Naturvårdsarbetet bör i första hand prioritera att bibehålla och öka kvaliteten i de områden som redan avsatts, innan ytterligare arealer avsätts och det finns en konsensus om att naturvårdande skötsel är kraftigt eftersatt i de formellt skyddade områdena.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.1",
      "sentiment": -0.5,
      "quote": "Det är lika angeläget med skötselinsatser för att bibehålla och förstärka naturvärden i redan skyddade skogar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.1.8",
      "sentiment": 1.0,
      "quote": "Södra tillstyrker förslaget om att återbeskogningsplikt avskaffas närmast jordbruksmark.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a17.2.3",
      "sentiment": -1.0,
      "quote": "Detta är en myndighetsuppgift, företrädesvis Skogsstyrelsens ansvar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a17.1.3",
      "sentiment": 0.5,
      "quote": "Det medför en högre flexibilitet och rättssäkerhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19",
      "sentiment": -1.0,
      "quote": "Enligt kommittédirektivet ska förslagen beakta andra angelägna behov som exempelvis försörjningstrygghet, landsbygdsutveckling och konkurrenskraft men om detta nämns i princip ingenting mer än att förslagen kan ha både en positiv och negativ påverkan på landsbygdsutveckling.",
      "quote_type": "grund"
    }
  ]
