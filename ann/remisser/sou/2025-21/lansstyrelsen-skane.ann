  "segments": [
    {
      "forarbete_id": "a6.1",
      "sentiment": 0.5,
      "quote": "Förslaget i avsnitt 6.1 kan därför endast tillstyrkas om tillräckliga resurser tilldelas för såväl den föreslagna informationssatsningen som för andra delar i myndigheternas arbete som har betydelse för att nå de mål som förslaget syftar till.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.2",
      "sentiment": 0.5,
      "quote": "Länsstyrelsen ser positivt på förslaget om åtgärdssamordnare för frivilligt lokalt åtgärdsarbete som bidrar till kolinlagring och biologisk mångfald (avsnitt 6.2), men anser att all åtgärdssamordning bör samlas inom samma stödform och förordning för att kunna dra nytta av synergieffekter när åtgärdssamordnare arbetar mot flera olika syften samtidigt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": -0.5,
      "quote": "Det kan tolkas som att ”vanliga arter” inte ingår i punkt 5 vilket är olyckligt då det är av stor vikt att även arter som är lite vanligare ska kunna gynnas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2",
      "sentiment": -0.5,
      "quote": "Förslaget om bidrag för att öka kvävegödslingen av skog (avsnitt 8.2.2) avstyrks, eftersom det bland annat skulle motverka miljökvalitetsmålet Ingen övergödning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2.1",
      "sentiment": 0.2,
      "quote": "Det föreslagna uppdraget till Upphandlingsmyndigheten om en informations- och rådgivningsinsats om upphandling av naturbeteskött, renkött och viltkött (9.2.1) kan med fördel breddas till en informations- och rådgivningsinsats om upphandling av mat med positiva effekter på kolinlagring, andra klimataspekter och biologisk mångfald.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.2",
      "sentiment": 0.2,
      "quote": "Det är bättre att en tydlig avgränsning görs från början i lag eller förordning, än att domstolar ska behöva tolka vaga lagformuleringar och etablera en praxis.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.1",
      "sentiment": -0.2,
      "quote": "Administrationen ökar om olika delar av en våtmark ska söka finansiering från olika stödformer.",
