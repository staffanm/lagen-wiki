    },
    {
      "forarbete_id": "a12.4.1",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen anser att förslaget om att lägga till restaurering av våtmark (utan arealbegränsning) till sådant som kan anmälas som vattenverksamhet är mycket bra.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.4.2",
      "sentiment": -1.0,
      "quote": "Länsstyrelsen avstyrker denna punkt med hänvisning till att statens rådighet inte bryter igenom tillståndens rättskraft.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.5",
      "sentiment": 1.0,
      "quote": "Samtidigt är klimatnyttan av att fasa ut torvbrytningen mycket stor.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.1.13",
      "sentiment": 0.5,
      "quote": "Förslaget i avsnitt 13.1.13 kan därför endast tillstyrkas om tillräckliga resurser tilldelas för såväl det föreslagna nya uppdraget som för andra delar i länsstyrelsernas arbete med biologisk mångfald.",
