  "segments": [
    {
      "forarbete_id": "sec13",
      "sentiment": 1.0,
      "quote": "Skogforsk anser att en konstruktiv väg framåt skulle vara att utveckla nya metoder för att identifiera dessa synergier, snarare än att fokusera på befintliga, välkända konflikter.",
      "quote_type": "grund"
