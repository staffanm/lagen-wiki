    {
      "forarbete_id": "a6.1",
      "sentiment": 0.5,
      "quote": "Rådgivningens effektivitet avgörs av hur väl den anpassas till olika skogsägares värderingar, drivkrafter och förutsättningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.8.4",
      "sentiment": 1.0,
      "quote": "Satsningar på en värdekedja för lövträ kan gynna svensk möbel- och inredningsindustri samt skapa förutsättningar för utveckling av andra långlivade produkter av lövträ.",
      "quote_type": "grund"
