    },
    {
      "forarbete_id": "a16.1.8",
      "sentiment": 1.0,
      "quote": "ett exempel på en förenkling med stor naturvårdspotential.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec186",
      "sentiment": -0.2,
      "quote": "viktigt att inte utföra detta i områden där gödslingen riskerar orsaka ett skifte från blåbär till lågörtsvegetation samt på ljung-lingonmarker som är viktiga för rennäringen.",
