  "segments": [
    {
      "forarbete_id": "a17.2.6",
      "sentiment": 1.0,
      "quote": "En gemensam vision och målsättning ger gemensam kraft och riktning, vilket i sig ökar takten i omställningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a17.2.4",
      "sentiment": 0.5,
      "quote": "För ökad förutsägbarhet och jämförbarhet förordar vi en fortsatt användning och vidareutveckling av CLIMB-metodiken som mätverktyg för att kvantifiera nuvärdet av biologisk mångfald inom ett avgränsat område och den framtida effekt olika insatser ger på densamma.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.1",
      "sentiment": -0.2,
      "quote": "Det gör det svårt att bedöma genomförbarheten.",
