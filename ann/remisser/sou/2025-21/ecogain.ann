    {
      "forarbete_id": "a17.2.3",
      "sentiment": 1.0,
      "quote": "Tillgång till data är en viktig del för att prioritera insatser där de gör bäst nytta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.1.2",
