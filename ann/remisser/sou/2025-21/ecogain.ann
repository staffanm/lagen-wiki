    },
    {
      "forarbete_id": "a13.1.10",
      "sentiment": 1.0,
      "quote": "De stora skogsbolagens frivilliga naturvårdsavsättningar utgör ett betydande och högkvalitativt bidrag till skyddet av skogsmiljöer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.1",
      "sentiment": -0.2,
      "quote": "Ecogain delar utredningens bedömning om att också skötsel av våtmarker är viktig och behöver finansieras",
