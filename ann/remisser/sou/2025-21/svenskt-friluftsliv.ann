  "segments": [
    {
      "forarbete_id": "a19.12.1",
      "sentiment": 1.0,
      "quote": "Svenskt Friluftsliv ser positivt på den ambitionen och menar att den föreslagna ökningen är en absolut nödvändighet för en positiv utveckling på området framöver.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.1.2",
      "sentiment": 1.0,
      "quote": "För många av friluftsrörelsens verksamheter och människors friluftsutövande är förekomsten av urskog, naturskog, gammal skog och äldre träd en mycket viktig ingrediens (Skogstyrelsen, Skogens rekreationsvärden 2023:08).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.1",
      "sentiment": 0.5,
      "quote": "Forskning visar att blandskog och förekomst av lövträd upplevs positivt av friluftsutövare/besökare, liksom av att skogliga miljöer varken är för tät eller för gles.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.12.2",
      "sentiment": 0.2,
      "quote": "Svenskt Friluftsliv vill lyfta fram att revideringar av skötselplaner också behöver fokusera på hållbara besök i naturen av individer, grupper och föreningar för att värna den biologiska mångfalden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1",
      "sentiment": 0.2,
      "quote": "Svenskt Friluftsliv har uppmärksammat ett stort behov av att friluftsrörelsen inkluderas i detta samverkansuppdrag vid behov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a17.2.5",
      "sentiment": 1.0,
      "quote": "Svenskt Friluftsliv är positiva till och tillstyrker förslaget då det även kan gynna det lokala och regionala friluftslivet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": 1.0,
      "quote": "Svenskt Friluftsliv tillstyrker förslaget om en utvidgning av aktörer som kan få ersättning med stöd av LONA, vilket naturligtvis ska omfatta friluftsrörelsens organisationer.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a9.1",
      "sentiment": 1.0,
      "quote": "Svenskt Friluftsliv tillstyrker förslagen om ett aktivt jordbruk som främjar kolinlagring och biologisk mångfald då sådana miljöer och odlingslandskap, inklusive ängs- och betesmarker, även kan vara positivt för friluftslivet och kulturmiljöer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a20.1.2",
      "sentiment": 1.0,
      "quote": "Svenskt Friluftsliv tillstyrker beredningens förslag om en ny skyddsform, biotopskyddsområde, för urskogar och naturskogar och som innebär ett förbud mot skogsbruk i kvarvarande urskogar och naturskogar i Sverige.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.2.5",
      "sentiment": 1.0,
      "quote": "Eftersom staten har rådighet över Sveaskogs mark, och Sveaskog är en mycket stor skogsägare, kan staten och Sveaskog bidra till att främja ett mer hållbart skogsbruk.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.5",
      "sentiment": 0.5,
      "quote": "Vi vill emellertid påpeka att det inte bara är naturturism, till exempel utländsk turism, som genererar lokal och regional utveckling och arbetstillfällen relaterat till skog och natur i Sverige.",
      "quote_type": "grund"
    }
  ]
