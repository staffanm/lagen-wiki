    {
      "forarbete_id": "a14.1.1",
      "sentiment": 1.0,
      "quote": "Norra Skog ser det dock som mycket positivt att man endast förordar skydd av de arealer som utgör gammal skog och urskog.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a15.1.1",
      "sentiment": 1.0,
      "quote": "Norra Skog anser att det är angeläget att säkerställa att skyddade områden inte förlorar, utan utvecklar, de naturvärden de syftar till att bevara.",
