    },
    {
      "forarbete_id": "a8.1",
      "sentiment": 0.5,
      "quote": "Norra Skog anser att ett sådant uppdrag ska inkludera rådgivning om skogens totala klimatnytta, det vill säga även möjligheterna att fasa ut fossila råvaror i enlighet med ISOstandarden 13391.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec186",
      "sentiment": 1.0,
      "quote": "Gödsling är ett av de effektivaste sätten att öka tillväxten i skogen och öka upptaget av koldioxid.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec196",
      "sentiment": -1.0,
      "quote": "Aktivt skogsbruk med hög tillväxt där produkter från skogen undanhåller fossila utsläpp är den skötselmetod som långsiktigt ger störst klimatnytta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.2",
      "sentiment": -0.5,
      "quote": "Förslaget innebär en tydlig inskränkning i äganderätten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.1.3",
      "sentiment": 0.2,
      "quote": "Norra Skog anser att förslaget till Skogsstyrelsen inte enbart ska fokusera på långlivade produkter, utan även den nytta som kortlivade produkter bidrar med för att fasa ut fossila resurser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.5",
      "sentiment": -1.0,
      "quote": "Förslaget leder till ökat importberoende och försämrad svensk beredskap.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.1",
      "sentiment": -0.5,
      "quote": "Detta är en feltolkning av IUCN:s vägledning som står helt i strid med vad andra länder betraktar som skyddad natur.",
