  "overall": {
    "sentiment": -0.2,
    "quote": "Länsstyrelsen anser att de föreslagna åtgärderna inte är tillräckliga för att uppfylla åtagandena.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a1.1",
      "sentiment": 0.2,
      "quote": "Förslaget innebär dock att myndigheternas (både Skogsstyrelsen och Länsstyrelsen) strategiska arbete kring formellt skydd blir ännu mer begränsat och mer händelsestyrt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.3",
      "sentiment": -0.5,
      "quote": "Borttaget stöd för klimatåtgärder och biologisk mångfald och den föreslagna nya torvförordningen kommer att innebära att stöd för återvätningsåtgärder för biologisk mångfald på mark som ej är torv försvinner.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.4",
      "sentiment": 0.5,
      "quote": "Länsstyrelsen tillstyrker förslaget om att underlätta för markavvattningssamfälligheter att ompröva/avveckla sina markavvattningsföretag.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a1.5",
      "sentiment": -1.0,
      "quote": "Det är otydligt vad denna ändring av förordningen innebär och har för reell betydelse.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1",
      "sentiment": 0.5,
      "quote": "Länsstyrelsen föreslår att uppföljningen rapporterar till det föreslagna återvätningsrådet och att återvätningsrådet kompletteras med fler myndigheter och forskningskompetens.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.2",
      "sentiment": -1.0,
      "quote": "Länsstyrelsen avstyrker förslaget om bidrag för att öka kvävegödslingen av skog, eftersom det skulle motverka miljökvalitetsmålet Ingen övergödning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2.1",
      "sentiment": 0.5,
      "quote": "Det föreslagna uppdraget kan med fördel breddas till en informations- och rådgivningsinsats om upphandling av mat med positiva effekter på kolinlagring, andra klimataspekter och biologisk mångfald.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.2.2",
      "sentiment": -0.2,
      "quote": "Det är viktigt att beakta avvägningen mellan vallproduktion och direkt livsmedelsproduktion i form av spannmålsodling.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10",
      "sentiment": 0.5,
      "quote": "Länsstyrelsen vill dock påpeka att det även behövs kompletteringar i lagstiftningen så att det är möjligt för olika aktörer att göra adekvata bedömningar av planers påverkan på miljön.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.2",
      "sentiment": 0.2,
      "quote": "Uttryck som ”…att tillgodose väsentliga samhällsintressen” och att ”…behov inte kan tillgodoses på ett från allmän synpunkt tillfredsställande sätt genom att annan mark tas i anspråk”, möjliggör för tolkningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.4.2",
      "sentiment": -1.0,
      "quote": "Länsstyrelsen anser att förslaget inte är tillräckligt rättssäkert.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.1",
      "sentiment": -0.2,
      "quote": "Länsstyrelsen anser att föreslagna åtgärder inte är tillräckliga för att uppfylla internationella åtaganden under konventionen om biologisk mångfald eller EU-krav om skydd och restaurering av biologisk mångfald.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.1.7",
      "sentiment": -0.2,
      "quote": "Områden med miljöersättning har endast ersättning fem år i taget, vilket är en mycket kort tidsrymd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.1.13",
      "sentiment": 0.5,
      "quote": "För områden som kräver mer skötsel anser Länsstyrelsen att det kommer att behövas någon form av ersättning för att få till en skötsel som bevarar eller höjer naturvärden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.1.1",
      "sentiment": -1.0,
      "quote": "Länsstyrelsen avstyrker förslaget då vi anser att förslaget behöver kompletteras med skydd av naturskog.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.1.2",
      "sentiment": 0.5,
      "quote": "Detta är något som inte kommer vara möjligt då Skogsstyrelsen i nuläget inte har kapacitet att fullt ut granska alla avverkningsanmälningar utan måste förlita sig på markägarens uppgifter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a15.1.2",
      "sentiment": 0.5,
      "quote": "Länsstyrelsen föreslår att resurserna används över en längre tidsperiod för att bidra till mer stabilitet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a15.1.4",
      "sentiment": 0.5,
      "quote": "Länsstyrelsen tillstyrker förslaget men vill påpeka att även föreskrifter och syfte ibland behöver uppdateras för att nödvändiga skötselåtgärder ska kunna vidtas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.1.3",
      "sentiment": 0.5,
      "quote": "Det bör finnas tillräckligt med medel för att kunna genomföra de åtgärder som föreslås i de framtagna programmen, vilket inte är fallet inom nuvarande system med åtgärdsprogramsarbetet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.1.6",
      "sentiment": 0.5,
      "quote": "Länsstyrelsen anser också att fördelningen av medel mellan länen måste ses över då vissa län fått en orimligt låg tilldelning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.1",
      "sentiment": 0.5,
      "quote": "Viktigt är att villkoren är gynnsamma och långsiktiga så att lantbrukaren efter 5 år inte lämnas med sitt anlagda landskapselement utan skötselersättning men med de regler som generellt biotopskydd medför.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a17.1",
      "sentiment": 0.2,
      "quote": "Länsstyrelsen instämmer i Miljömålsberedningens bedömning, men kan inte se att Miljömålsberedningen har lämnat förslag som i tillräcklig mån kommer att leda till att listade naturtyper varken förstörs aktivt eller genom utebliven skötsel.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a17.2.1",
      "sentiment": 0.5,
      "quote": "För att detta ska få en verklig effekt på biologisk mångfald krävs att kommunerna får ett tydligt ansvar att ta hänsyn till naturvård och biologisk mångfald i samtliga planer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a17.2.2",
      "sentiment": 0.2,
      "quote": "Länsstyrelsen anser att det är ett bra förslag att en nationell fröbank för inhemska växter upprättas, men vill påpeka att detta är en mycket dyr lösning för att bevara arter och ska ses som en sista utväg.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a17.2.3",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen instämmer i att system för inrapportering och sökning för områden med höga naturvärden bör tas fram.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a17.2.4",
      "sentiment": 0.2,
      "quote": "Forskningen visar dock att kompensation och nyanläggning av naturtyper är dyrt och ger mindre biologisk mångfald än bevarade naturtyper (Zedler & Ercher 2005; Moreno Mateos et al 2012).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.4",
      "sentiment": 0.5,
      "quote": "Det är i dagsläget inte brist på information, men informationsinsatserna behöver samordnas och arbetssätt för att nå vissa målgrupper behöver utvecklas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.4.1",
      "sentiment": 0.5,
      "quote": "Det föreslagna uppdraget till Upphandlingsmyndigheten om en informations- och rådgivningsinsats om upphandling av naturbeteskött, renkött och viltkött kan med fördel breddas till en informations- och rådgivningsinsats om upphandling av mat med positiva effekter på kolinlagring, andra klimataspekter och biologisk mångfald.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.9",
      "sentiment": -0.2,
      "quote": "I vilken mån restaurering av våtmarker kan ha betydelse för att återställa grundvattennivån i områden och förhindra minskad tillväxt saknas i miljömålsberedningens analys.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.9.4",
      "sentiment": -0.5,
      "quote": "Länsstyrelsen ser inte hur konsekvensanalysen är förenlig med gällande lagstiftning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.11.1",
      "sentiment": -0.5,
      "quote": "Även om osäkerhetsfaktorerna är många kommer en större del av den uppskattade arealen med stor sannolikhet behöva ersättas ekonomiskt, vilket skulle innebära en betydande kostnad för staten, något som inte nämns i nuvarande text.",
      "quote_type": "grund"
    }
  ]
}