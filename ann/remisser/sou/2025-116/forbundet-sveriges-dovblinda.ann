    {
      "forarbete_id": "sec55",
      "sentiment": 0.2,
      "quote": "Samtidigt konstaterar vi att betänkandet inte förtydligar vad tillgänglighet eller ansvar för minoritetsspråk innebär i praktiken för olika grupper av personer med funktionsnedsättning.",
      "quote_type": "grund"
