  "overall": {
    "sentiment": -0.2,
    "quote": "Mediemyndigheten bedömer att det finns skäl att avvakta EU-kommissionens översyn av Europaparlamentets och rådets direktiv 2010/13/EU av den 10 mars 2010 om samordning av vissa bestämmelser som fastställs i medlemsstaternas lagar och andra författningar om tillhandahållande av audiovisuella tjänster, ändrat genom direktiv 2018/1808/EU (AV-direktivet) innan regeringen går vidare med förslagen i betänkandet.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a11.3",
      "sentiment": 1.0,
      "quote": "Myndigheten instämmer i att en framhävandereglering är viktig för att säkerställa att innehåll av allmänt intresse även fortsättningsvis är lättillgängligt för användarna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.5",
      "sentiment": -0.5,
      "quote": "Några motsvarande bindande villkor avseende mediepluralism, yttrandefrihet och kulturell mångfald finns i dag inte för kommersiella aktörer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.4",
      "sentiment": 1.0,
      "quote": "Mediemyndigheten har inga invändningar mot att förslagen införs genom en ny lag.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a11.6.1",
      "sentiment": -0.2,
      "quote": "Mot bakgrund av den snabba teknik- och marknadsutvecklingen samt den stora variation som kan förekomma bland användargränssnitt riskerar detta att bli en både svår och resurskrävande uppgift.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.7",
      "sentiment": -0.2,
      "quote": "Mediemyndigheten ställer sig därför frågande till vad som avses med 7 § 2 och önskar att lagstiftaren förtydligar om myndigheten i föreskrifter ska meddela ytterligare undantag från 3 § första stycket eller närmare precisera 3 § tredje stycket.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13",
      "sentiment": -0.2,
      "quote": "Myndigheten bedömer dock att förslagen i sin nuvarande utformning medför ett omfattande föreskriftsarbete.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.2.5",
      "sentiment": -0.5,
      "quote": "Mediemyndigheten anser att det i betänkandet inte är tillräckligt utrett vilka aktörer, utöver svenska tvoperatörer, som i praktiken kan komma att träffas av de föreslagna reglerna.",
      "quote_type": "grund"
    }
  ]
