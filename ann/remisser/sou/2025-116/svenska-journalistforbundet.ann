    },
    {
      "forarbete_id": "sec13",
      "sentiment": -0.2,
      "quote": "Behovet av att framhäva visst innehåll måste dock vägas mot de negativa effekter förslaget medför för yttrandefriheten i form av myndighetsprövning av innehåll i medier.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec15",
      "sentiment": 1.0,
      "quote": "I övrigt har Journalistförbundet inget att erinra i den del som avser public service.",
