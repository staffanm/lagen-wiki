    },
    {
      "forarbete_id": "a7.3.2",
      "sentiment": 1.0,
      "quote": "Redan idag finns Mediernas beredskapsråd under ledning av MCF och det är naturligt att MCF:s ansvarsområde utökas i den av utredningen föreslagna riktningen.",
