  "segments": [
    {
      "forarbete_id": "a11.3",
      "sentiment": 1.0,
      "quote": "I samband med kris, höjd beredskap och krig är det väsentligt att alla tv-tittare och radiolyssnare enkelt ska kunna hitta och ta del av digitalt innehåll av allmänt intresse.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.6.2",
      "sentiment": 1.0,
      "quote": "Utredningen har landat i en rimlig avgränsning av skyldigheten genom att endast användargränssnitt som har som primär funktion att presentera radio- och tvprogram ska omfattas och således utesluter till exempel rena sökmotorer, videodelningsplattformar och sociala medier.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.4",
      "sentiment": 1.0,
      "quote": "För samhällets beredskap och säkerhet är det nödvändigt att invånarna nås av information vid kris och krig, bland annat som nyheter och VMA, där invånarna befinner sig, det vill säga även på vägarna och i områden där mobiloperatörerna har bristande internetuppkoppling.",
      "quote_type": "grund"
    }
  ]
