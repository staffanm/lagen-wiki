  "segments": [
    {
      "forarbete_id": "sec9",
      "sentiment": 1.0,
      "quote": "Tingsrätten tillstyrker förslaget om ett nytt påföljdssystem med villkorligt fängelse.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec103",
      "sentiment": -1.0,
      "quote": "Om omständigheterna i ett enskilt fall är så ömmande att förutsättningar för 28:3-fängelse är uppfyllda, vore det i sådant fall mer ändamålsenligt att bestämma påföljden till villkorligt fängelse med övervakning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec103",
      "sentiment": 0.2,
      "quote": "en sådan förändring skulle innebära en betydande förändring i lindrande riktning även för brott där det kan anses angeläget att ett kortare fängelsestraff som inte är villkorligt döms ut.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec11",
      "sentiment": 1.0,
      "quote": "Tingsrätten ställer sig positiv till förslaget om att samtycke från den tilltalade inte bör vara en förutsättning för att förena villkorligt fängelse med samhällstjänst.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec11",
      "sentiment": 1.0,
      "quote": "möjligheterna att döma till kontraktsvård påverkas av den tilltalades bosättningskommuns inställning till att finansiera en vårdvistelse och leder därmed till ojämlikheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec14",
      "sentiment": 0.5,
      "quote": "Tingsrätten har inte någon invändning mot den översyn som har gjorts och den skärpning av straffskalorna – särskilt vad gäller förmögenhets- och tillgreppsbrotten – som föreslås.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec14",
      "sentiment": -0.2,
      "quote": "Tingsrätten ställer sig frågande till detta, särskilt mot bakgrund av att ett av skälen för översynen av straffskalorna har varit att ta hänsyn till att den organiserade brottsligheten i dag utgör ett systemhotande och mycket allvarligt samhällsproblem",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec29",
      "sentiment": -0.2,
      "quote": "I likhet med vad utredningen anfört kan det emellertid på goda grunder ifrågasättas huruvida den föreslagna ändringen kommer att få den effekt som eftersträvas, nämligen att straffskalans övre del ska tillämpas i större utsträckning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec32",
      "sentiment": -1.0,
      "quote": "En sådan regel riskerar att medföra en stelbent och statisk tillämpning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec32",
      "sentiment": -0.2,
      "quote": "Den föreslagna metoden riskerar således att få ett alltför begränsat tillämpningsområde.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec35",
      "sentiment": -0.2,
      "quote": "Med hänsyn till detta finns en risk för att bestämmelsen inte kommer att kunna tillämpas i den utsträckning som avses och att den därmed inte får den effekt som är avsedd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec44",
      "sentiment": 1.0,
      "quote": "Tingsrätten instämmer i utredningens bedömning att häktningspresumtionen inte bör sänkas till brott med lägst ett års fängelse föreskrivet i straffskalan.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec45",
      "sentiment": -1.0,
      "quote": "Att avvika från den rådande systematiken och ange specifika brott för vilka en häktningspresumtion ska gälla, riskerar att göra bestämmelsen mindre överskådlig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec46",
      "sentiment": 1.0,
      "quote": "Den nuvarande utformningen av regeln innebär att presumtionen är tillämplig på grov misshandel men inte på försök till mord.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec48",
      "sentiment": -0.5,
      "quote": "Tingsrätten delar inte utredningens bedömning utan anser att domstolarna bör tillföras betydande ekonomiska resurser om förslagen genomförs.",
      "quote_type": "grund"
    }
  ]
}