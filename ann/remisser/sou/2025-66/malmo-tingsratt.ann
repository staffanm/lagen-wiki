  "segments": [
    {
      "forarbete_id": "sec9",
      "sentiment": 0.5,
      "quote": "Vid en närmare analys förefaller det föreslagna påföljdssystemet vara i många delar lika komplext och svåröverskådligt som dagens system.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec103",
      "sentiment": -0.5,
      "quote": "Tingsrätten anser att det finns en risk att systemet med villkorligt fängelse för vissa artbrott, trots möjligheten att välja en strängare tilläggssanktion vid straffvärden understigande sex månader, inte kommer att framstå som ett trovärdigt (i meningen tillräckligt ingripande) alternativ i allmänhetens ögon, exempelvis vid grovt rattfylleri, vissa typer av misshandel, mened och narkotikainnehav som inte är för eget bruk.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec104",
      "sentiment": 1.0,
      "quote": "Den tilltalades inställning bör i stället, som utredningen förordar, beaktas inom ramen för en lämplighetsbedömning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec92",
      "sentiment": -0.2,
      "quote": "Domstolen förlorar möjligheten att väga innehållet i tilläggssanktionen mot alternativen i form av ett (ovillkorligt) fängelsestraff eller ytterligare tilläggssanktioner.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec17",
      "sentiment": 1.0,
      "quote": "Tingsrätten har ingen erinran mot förslaget om att fängelseminimum höjs från 14 dagar till en månad.",
