    },
    {
      "forarbete_id": "sec98",
      "sentiment": -0.5,
      "quote": "Tingsrätten ställer sig tveksam till att det utdömda straffet generellt skulle vara en sådan central faktor när det kommer till att tillfredsställa brottsoffrets förväntningar på upprättelse.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec98",
      "sentiment": -0.2,
      "quote": "Tingsrätten anser att det redan vid dagens rättstillämpning finns utrymme för den typen av nyanserade bedömningar som efterfrågas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec100",
      "sentiment": 1.0,
      "quote": "En sådan lösning riskerar att leda till oönskade tröskeleffekter, som utredaren också framhållit.",
