    },
    {
      "forarbete_id": "sec17",
      "sentiment": 1.0,
      "quote": "Inte heller har tingsrätten någon erinran mot förslaget om att ta bort begränsningen att fängelse på viss tid inte får överstiga tio år när livstidsfängelse inte är föreskrivet för brottet.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec14",
      "sentiment": 0.5,
      "quote": "Därtill framstår det som ändamålsenligt med det helhetsgrepp som utredningen tagit.",
