  "overall": {
    "sentiment": 0.5,
    "quote": "Ekobrottsmyndigheten tillstyrker i huvudsak utredningens förslag, men anser att det behövs en ökad tydlighet i eventuell lagstiftning och dess förarbeten för hur den generella repressionsnivån ska höjas och fungera i praktiken.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "sec9",
      "sentiment": 1.0,
      "quote": "Den föreslagna ordningen skapar en ökad tydlighet för och innebörd av påföljdssystemet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec14",
      "sentiment": 1.0,
      "quote": "Det är angeläget att tillämpningen av straffskalorna beaktar den skada och kränkning som brottsoffer utsätts för samt den samhällsfara som brottsligheten innebär.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec28",
      "sentiment": -0.5,
      "quote": "Straffskalan för dessa brott bör anpassas till den generella repressionshöjning som föreslås i detta betänkande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec26",
      "sentiment": -0.5,
      "quote": "Det är lämpligt att straffskalorna är likalydande för den praktiska tillämningen vid utredning och lagföring av grov ekonomisk brottslighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec29",
      "sentiment": 0.2,
      "quote": "Det är viktigt att tydliggöra hur skyddsvärda intressen vid ekonomisk brottslighet ska beaktas vid bestämmandet av straffvärdet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec33",
      "sentiment": 1.0,
      "quote": "Utredningens förslag i övrigt, särskilt i kombination med tidigare beslutade straffskärpningar, medför en sådan generell höjning av repressionsnivån för enskilda brott att straffskalan för flerfaldig brottslighet behöver höjas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec32",
      "sentiment": 1.0,
      "quote": "Fördelen med utredningens förslag är dock att en mer träffsäker och nyanserad straffmätning kan åstadkommas i det enskilda fallet",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec35",
      "sentiment": 1.0,
      "quote": "Ekobrottsmyndigheten anser att det är angeläget att straffbestämmelsen tar sikte på alla brott som har koppling till kriminella nätverk och delar uppfattningen att sådan brottslighet ska ge möjlighet till att straffvärdet kan dubbleras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec42",
      "sentiment": 1.0,
      "quote": "Ekobrottsmyndigheten delar utredningens uppfattning att förslagen innebär en förenkling av regelverket och att de kvarvarande strafflindringsgrunderna kan antas inverka på påföljdsbestämningen på ett mer förutsägbart och ändamålsenligt vis.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec44",
      "sentiment": 1.0,
      "quote": "Ekobrottsmyndigheten ser, i likhet med utredningen, inte heller något behov av en sådan ändring och bedömer att en ändrad ordning skulle riskera att leda till ett ökat resursuttag och svårigheter att prioritera mellan ärenden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec45",
      "sentiment": -1.0,
      "quote": "Som angetts ovan återspeglas brottslighetens allvar i straffskalorna för respektive brott och de särskilda häktningsgrunderna utgör tillräckliga skäl för häktning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec46",
      "sentiment": 1.0,
      "quote": "Utredningens förslag framstår som väl avvägda och leder till en mer logisk och sammanhållen reglering på området utifrån syftet med presumtionsregeln.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec135",
      "sentiment": 1.0,
      "quote": "Det är därför angeläget att möjligheten till avgörande utan huvudförhandling införs även för påföljden villkorligt fängelse eftersom det annars skulle leda till en påtaglig ökning av antalet huvudförhandlingar, med ökad arbetsbelastning som följd för såväl åklagarväsendet som domstolsväsendet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.31",
      "sentiment": 1.0,
      "quote": "Det som föreslås är fullt naturliga förändringar och förtydliganden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec52",
      "sentiment": 1.0,
      "quote": "Om lagstiftningen å andra sidan inte ges retroaktiv verkan, kommer det under en period att finnas två delvis parallella system. Det senare alternativet bedömer Ekobrottsmyndigheten vara mindre lämpligt och tillstyrker därför förslaget.",
