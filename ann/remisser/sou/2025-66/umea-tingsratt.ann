  "segments": [
    {
      "forarbete_id": "sec223",
      "sentiment": -0.2,
      "quote": "I författningskommentaren till kap. § brottsbalken bör förtydligas hur lagstiftaren ser på förutsättningarna för villkorligt fängelse för brott som har höga artvärden, såsom allvarliga fall av grovt rattfylleri.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec29",
      "sentiment": -0.2,
      "quote": "Ordalydelsen i den föreslagna lagtexten avviker alltså något från hur den är tänkt att tillämpas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec30",
      "sentiment": -0.5,
      "quote": "Det kan knappast leva upp till kraven på ekvivalens och proportionalitet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec35",
      "sentiment": -0.5,
      "quote": "Att först bedöma straffvärdet och sedan höja det med upp till det dubbla framstår i sig som systemfrämmande även efter de reformer som föreslås.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec43",
      "sentiment": -0.5,
      "quote": "Det är en olämplig lagstiftningsteknik att för vissa brott göra avsteg från den generella gränsen på fängelse i minst ett år och sex månader.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec48",
      "sentiment": -0.2,
      "quote": "Detta – tillsammans med att längre straff döms ut – kan innebära fler överklaganden, vilket i sin tur innebär mer arbete för överrätterna med ökade kostnader som följd.",
      "quote_type": "grund"
