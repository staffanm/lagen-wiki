  "overall": {
    "sentiment": -0.4,
    "quote": "Mot bakgrund av utredningens alltför begränsade tid till sitt förfogande för en erforderlig och grundlig beredning av sina förslag, framstår de föreslagna förändringarna som särskilt problematiska.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "sec7",
      "sentiment": 0.5,
      "quote": "Advokatsamfundet ser därför fördelar med att påföljderna blir tydligare och mer lättillämpade.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec11",
      "sentiment": -1.0,
      "quote": "Mot bakgrund härav framstår det som ytterst osannolikt att Kriminalvården kommer ha möjlighet att på ett bra och effektivt sätt tillgodose vårdbehovet med tanke på hur situationen ser ut i dag (överbeläggning) och hur den kommer att se ut i framtiden (än mer överbeläggning).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec10",
      "sentiment": -0.5,
      "quote": "Detta bottnar bland annat i möjligheten att kunna behålla kontraktsvård som påföljd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec10",
      "sentiment": -1.0,
      "quote": "Kravet på synnerliga skäl riskerar att leda till en allt för restriktiv tillämpning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec11",
      "sentiment": -0.5,
      "quote": "Som utredningen poängterar innebär kravet på samtycke att man kan förvänta sig att samhällstjänsten också utförs enligt plan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec14",
      "sentiment": -1.0,
      "quote": "syftet enkom är att höja den generella repressionsnivån i samhället utan att något talar för att det kommer att ha någon inverkan på brottslighetens utveckling eller dess skadeverkningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec30",
      "sentiment": -1.0,
      "quote": "Det grundläggande problemet med en trekumulationsregel är att flera lindrigare brott bestraffas strängare än ett allvarligare brott på ett sätt som är omotiverat sett till brottslighetens inbördes allvar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec32",
      "sentiment": 0.8,
      "quote": "Den föreslagna lösningen kommer även bättre svara mot lagstiftarens önskemål om straffskärpning vid flerfaldig brottslighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec32",
      "sentiment": -0.5,
      "quote": "I annat fall finns risk att den relativa proportionaliteten mellan olika typer av brott mot person blir haltande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec34",
      "sentiment": -1.0,
      "quote": "Advokatsamfundet ser inte att det framkommit ett behov av att utöka straffskalan på nu föreslaget sätt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec35",
      "sentiment": -1.0,
      "quote": "Advokatsamfundets bedömning är sammanfattningsvis att behovet av förändringar på området är svagt med hänsyn till att domstolarna vid straffmätningen redan har att beakta 29 kap. 2 § 6 brottsbalken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec40",
      "sentiment": -1.0,
      "quote": "De billighetsskäl som finns i dag har emellertid mycket starka skäl för sig och återfinns i liknande former i våra nordiska grannländer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec42",
      "sentiment": -1.0,
      "quote": "Även om tillämpningsområdet för bestämmelsen är begränsat finns situationer då en sådan strafflindringsgrund har särskilt starka skäl för sig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec42",
      "sentiment": -1.0,
      "quote": "Även i detta fall finns goda skäl för strafflindring när annat påföljdsval än fängelse inte är möjligt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec42",
      "sentiment": -1.0,
      "quote": "Det finns en rad situationer då en tillämpning av bestämmelsen har starka skäl för sig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec42",
      "sentiment": -1.0,
      "quote": "Starka skäl motiverar strafflindringsgrunden kopplad till arbetsrättsliga följder.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec43",
      "sentiment": -0.5,
      "quote": "Häktning är ett straffprocessuellt tvångsmedel med långtgående konsekvenser för den enskilde och tillämpningsområdet bör därför inte utvidgas mer än vad som är absolut nödvändigt.",
      "quote_type": "grund"
    }
  ]
