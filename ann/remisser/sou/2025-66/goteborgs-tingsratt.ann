  "overall": {
    "sentiment": -0.4,
    "quote": "Med hänsyn till den i sammanhanget anmärkningsvärt korta utredningstiden får tingsrätten dock konstatera att den övergripande kvaliteten på förslagen och motiveringen till dem inte motsvarar den kvalitet som utmärkt tidigare straffrättsliga reformer.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "sec9",
      "sentiment": 0.5,
      "quote": "Tingsrätten kan samtidigt konstatera att det föreslagna systemet med villkorligt fängelse i praktiken kommer ha stora likheter med dagens påföljdssystem, om än omstrukturerat och benämnt på nytt sätt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec13",
      "sentiment": -0.5,
      "quote": "Komplexiteten i det regelsystemet (som nyligen ändrades just för att minska komplexiteten) kommer att öka avsevärt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec14",
      "sentiment": -0.5,
      "quote": "Det paradigmskifte som nu föreslås är enligt tingsrättens uppfattning ett exempel på en fråga som inte är tillräckligt grundad i en djupgående analys av de grundläggande straffpolitiska frågorna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec32",
      "sentiment": 0.5,
      "quote": "En särskild bestämmelse som reglerar hur straffvärdebedömningen ska göras får därför antas vara nödvändig för att åstadkomma en förändring.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec35",
      "sentiment": -0.2,
      "quote": "Enligt tingsrätten finns emellertid en risk för att första stycket i den föreslagna straffskärpningsbestämmelsen får ett väldigt brett tillämpningsområde.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec40",
      "sentiment": 0.0,
      "quote": "För tingsrätten framstår behovet av de föreslagna ändringarna som oklart.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec44",
      "sentiment": 1.0,
      "quote": "instämmer tingsrätten i betänkandets resonemang och bedömning.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec45",
      "sentiment": -1.0,
      "quote": "Några tydliga skäl för utvidgningen har enligt tingsrätten inte framförts.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec46",
      "sentiment": 0.5,
      "quote": "Föreslagen ändring framstår därför, även i avsaknad av något tydligt behov, som lämplig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec48",
      "sentiment": -0.5,
      "quote": "Vad gäller konsekvensanalysen ställer sig tingsrätten starkt frågande till utredningens bedömning att de föreslagna ändringarna, för domstolarnas del, endast kommer leda till kostnadsökningar som ryms inom befintliga anslag.",
      "quote_type": "grund"
    }
