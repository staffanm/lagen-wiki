  "segments": [
    {
      "forarbete_id": "sec9",
      "sentiment": 1.0,
      "quote": "Förslaget innebär att brottets allvar kommer till tydligare uttryck i påföljden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec103",
      "sentiment": -0.5,
      "quote": "Först att det finns flera brott som har högt artvärde och där det måste antas att allmänheten förväntar sig att samhällets reaktion på brottet är kraftig i form av fängelse.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec103",
      "sentiment": -0.2,
      "quote": "Tingsrätten ifrågasätter om inte det fortsatt bör stå särskilda skäl i lagtext för att förtydliga att samma omständigheter som tidigare ska beaktas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec104",
      "sentiment": -0.8,
      "quote": "Det finns en risk att bedömningarna om påföljdens innehåll varierar kraftigt från fall till fall, vilket leder till en orättvis och rättsosäker behandling.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec17",
      "sentiment": 1.0,
      "quote": "Bedömningen godtas därför.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec29",
      "sentiment": -0.2,
      "quote": "Tingsrätten anser att förslaget inte ger tydlig vägledning för hur straffmätningen ska ske, vilket innebär tillämpningsproblem för domstolarna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec30",
      "sentiment": -1.0,
      "quote": "Vidare framstår förslaget som mycket komplicerat, svårtillämpbart och oförutsägbart.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec35",
      "sentiment": -1.0,
      "quote": "I många fall skulle det alltså inte bli den straffhöjning som utredningen och kommittédirektiven vill åstadkomma.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec42",
      "sentiment": -1.0,
      "quote": "Utrymmet att beakta det även vid straffmätningen bör därför finnas kvar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec42",
      "sentiment": 0.5,
      "quote": "Det framstår därför som rimligt, och med nu angivna skäl förenligt med tankarna bakom påföljdssystemet, att strafflindringsgrunden med anledning av förlorat arbete tas bort.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec43",
      "sentiment": 1.0,
      "quote": "Förslaget framstår dock som naturligt utifrån att det inte finns särskilda straffskalor för de ofullständiga brottsformerna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec43",
      "sentiment": -1.0,
      "quote": "Behovet av en sådan utvidgning framstår således som ytterst begränsat.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec52",
      "sentiment": 1.0,
      "quote": "Tingsrätten har i huvudsak inga synpunkter på bedömningen av övergångsbestämmelserna.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec48",
      "sentiment": -0.5,
      "quote": "För tingsrätten är det uppenbart att förslagen kommer leda till kostnadsökningar för domstolarna.",
      "quote_type": "grund"
