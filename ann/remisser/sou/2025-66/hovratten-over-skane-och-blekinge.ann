  "overall": {
    "sentiment": -0.6,
    "quote": "Hovrätten anser att det finns en stor fara i att genomföra genomgripande reformer i den takt och omfattning som nu förefaller vara aktuellt.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "sec7",
      "sentiment": -1.0,
      "quote": "Sammantaget är det hovrättens bedömning att det vid en avvägning framstår som mycket tveksamt om de skäl som anförts för att införa ett system med villkorligt fängelse verkligen motiverar de genomgripande förändringar av dagens system som förslaget innebär.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec11",
      "sentiment": -0.5,
      "quote": "Den föreslagna ordningen synes föra med sig konsekvenser som komplicerar systemet i fråga om bl.a. förvandlingsstraff.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec11",
      "sentiment": -1.0,
      "quote": "Det framgår tydligt av utredningens egna resonemang att vårdvistelse under avtjänandet av ett fängelsestraff i många fall inte utgör ett fullgott alternativ till missbruksbehandling inom ramen för en frivårdspåföljd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec10",
      "sentiment": -1.0,
      "quote": "Rekvisitet \"tillräckligt ingripande\" ger på ett olämpligt sätt intryck av att det skulle vara upp till domarens personliga värdering att avgöra om ett fängelsestraff i visst fall ska vara villkorligt eller inte.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec10",
      "sentiment": -0.2,
      "quote": "Detta får till konsekvens att klandret och repressionsgraden i vissa fall påtagligt minskar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec11",
      "sentiment": -0.5,
      "quote": "Målsägandens uttalade eller antagna vilja utgör alltså inte något relevant skäl i valet mellan tilläggssanktioner av samma svårighetsgrad.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec11",
      "sentiment": -1.0,
      "quote": "Den kraftiga tröskeleffekt som med utredningens förslag uppkommer vid en strafflängd om sex månader är dock inte motiverad.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec12",
      "sentiment": -1.0,
      "quote": "Med utredningens förslag kommer den som döms till villkorligt fängelse med samhällstjänst och som, efter att han utfört till exempel 15 timmar, inte längre har förmåga att arbeta, drabbas av ett mer ingripande straff än den som från början döms till ovillkorligt fängelse.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec13",
      "sentiment": -0.2,
      "quote": "De nya reglerna kommer att kräva stora utbildningsinsatser och under lång tid riskera en stor osäkerhet i rättstillämpningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec14",
      "sentiment": 0.2,
      "quote": "Hovrätten konstaterar att de föreslagna förändringarna i vissa fall resulterar i mycket vida straffskalor (se t.ex. brotten mot frihet och frid), vilket kan ifrågasättas utifrån principerna om proportionalitet och ekvivalens.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec29",
      "sentiment": -1.0,
      "quote": "Enligt hovrättens uppfattning finns det således en klar risk för en oenhetlig rättstillämpning under en lång tid framöver om förslaget genomförs.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec30",
      "sentiment": -0.5,
      "quote": "Det bör tydligare framgå att den ska tillämpas endast i undantagsfall.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec32",
      "sentiment": -0.5,
      "quote": "Till skillnad från utredningen är det därför hovrättens uppfattning att det på goda grunder kan antas att de övriga skärpningar som utredningen föreslår är tillräckliga för att få till stånd ett ökat genomslag för tillkommande brott.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec35",
      "sentiment": 1.0,
      "quote": "Hovrätten ansluter sig till att brott som sker inom ramen för organiserad kriminell verksamhet är ett stort samhällsproblem och att sådan brottslighet ska anses särskilt straffvärd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec38",
      "sentiment": -0.2,
      "quote": "Hovrätten anser även, till skillnad från utredningen, att den nuvarande bestämmelsen i 29 kap. 2 a § brottsbalken inte har mött några tillämpningsproblem.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec40",
      "sentiment": -0.2,
      "quote": "Har lagföringen kraftigt försenats av skäl som inte har med den tilltalade att göra är det enligt hovrätten fullt rimligt att denne kompenseras antingen vid påföljdsvalet eller vid straffmätningen alldeles oavsett om det skett en påtaglig förbättring av dennes personliga situation eller inte.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec44",
      "sentiment": 1.0,
      "quote": "Hovrätten ställer sig bakom utredningens bedömning, och på de skäl som utredningen anfört, att presumtionen för häktning inte bör sänkas till brott för vilka det inte är föreskrivet lindrigare straff än fängelse i ett år.",
