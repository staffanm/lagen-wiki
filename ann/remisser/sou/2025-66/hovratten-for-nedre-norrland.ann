    },
    {
      "forarbete_id": "sec14",
      "sentiment": 0.0,
      "quote": "Hovrätten saknar i den här delen resonemang och en mer djupgående analys om varför vissa straffskalor ska höjas uppåt samt vad detta far för konsekvenser på systemet som helhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec66",
      "sentiment": -0.5,
      "quote": "Höjningen av straffskalan för detta oaktsamhetsbrott stämmer dåligt överens med utredningens bedömning att andra oaktsamhetsbrott inte ska få en höjd straffskala, t.ex. vad som anförs om grovt bokföringsbrott.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec98",
      "sentiment": -1.0,
      "quote": "Sammantaget anser hovrätten att det förslag som presenteras inte kan förväntas leda till några förändringar i bestämmandet av straffvärdet då en ny metod för att bestämma straffvärde saknas och om så ändå skulle ske så är konsekvenserna av ändringarna inte tillräckligt analyserade.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec32",
      "sentiment": -1.0,
      "quote": "Hovrätten kan dock inte tillstyrka varken det förslag som framgår av direktiven eller det förslag som utredningen har lämnat då båda dessa förslag kan förväntas innebära att flerfaldig grov brottslighet bestående av vitt skilda gärningar ofta kan antas leda till samma straff på grund av bestämmelsen om gemensam straffskala.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec35",
      "sentiment": -1.0,
      "quote": "Hovrätten är i och för sig inte kritisk mot att bestämmelsens särställning klargörs i lagtexten genom att ange att straffet ska ökas med upp till det dubbla, men det är svårt att se behovet av denna reform när den nyligen genomförda förändringen inte alls har analyserats.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec40",
      "sentiment": -0.2,
      "quote": "Att vissa billighetsskäl även fortsättningsvis ska få betydelse vid val av påföljd utan att detta anges i lagtext riskerar att leda till otydlighet vid tillämpningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec43",
      "sentiment": -0.2,
      "quote": "Precis som utredningen anmärker är de aktuella brottstyperna sådana som typiskt sett leder till häktning eftersom det i allmänhet finns starka särskilda häktningsskäl och en presumtionsregel anses därför vara helt överflödig.",
      "quote_type": "grund"
