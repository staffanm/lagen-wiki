    },
    {
      "forarbete_id": "a4.1.4",
      "sentiment": -0.5,
      "quote": "Det är länsstyrelsens uppfattning att det generellt sett finns en varierande kompetens i de avvägningar som kommunen måste göra enligt ordningslagen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.3.3",
      "sentiment": 1.0,
      "quote": "Båda prövningarna har polisiär relevans och de bör för helhetens och enkelhetens skull hanteras av samma instans.",
      "quote_type": "grund"
