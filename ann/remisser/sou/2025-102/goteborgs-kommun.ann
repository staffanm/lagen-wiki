  "overall": {
    "sentiment": 0.2,
    "quote": "Göteborgs Stad delar utredningens bedömning att det finns behov av att renodla Polismyndighetens verksamhet, och ser att det finns vissa uppgifter som skulle kunna föras över till kommunen.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a4.3.1",
      "sentiment": -0.5,
      "quote": "Göteborgs Stads anser att tillståndsärenden avseende sprängning, skjutning och användning av pyrotekniska varor har närmare koppling till polisiär verksamhet än kommunal verksamhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.3.4",
      "sentiment": -0.5,
      "quote": "Göteborgs Stad bedömer att detta är en försämring av klagorätten för den enskilde och att nödvändiga villkor bör regleras mellan tillståndssökanden och markägaren i ett nyttjanderättsavtal när det gäller privat ägd kvartersmark då kommunen sällan har intressen att bevaka på sådan offentlig plats.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec48",
      "sentiment": 0.2,
      "quote": "Det är önskvärt att det även för sådana platser kan krävas tillstånd enligt 3 kap. 1 § OL.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec61",
      "sentiment": -0.2,
      "quote": "Göteborgs Stad anser att de ekonomiska konsekvenserna för kommunerna behöver utredas ytterligare och att utredningen i det fortsatta arbetet bör beakta finansieringsprincipen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec60",
      "sentiment": -0.2,
      "quote": "Göteborgs Stad konstaterar att det inte är tydligt om och hur kommunens beslut om återkallelse av tillstånd, förelägganden, viten och rättelse på den felandes bekostnad med mera kan överklagas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.2",
      "sentiment": 1.0,
      "quote": "En överflyttning av dessa uppgifter till Transportstyrelsen bedöms kunna bidra till en mer effektiv och rättssäker hantering, genom att ärendena samlas hos en myndighet som redan har väletablerade processer inom fordons- och parkeringsområdet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8",
      "sentiment": -0.5,
      "quote": "Göteborgs Stad gör bedömningen att tiden för ikraftträdande är för knapp om kommunen ska kunna omhänderta ansvaret för föreslagna uppgifter på ett ändamålsenligt sätt.",
      "quote_type": "grund"
    }
  ]
