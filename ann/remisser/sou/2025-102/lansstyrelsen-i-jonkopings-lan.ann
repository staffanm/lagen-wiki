  "overall": {
    "sentiment": 0.5,
    "quote": "Länsstyrelsen i Jönköpings län har i huvudsak inga invändningar mot de förslag utredningen har lagt fram men anser att tillstånd till skjutning med eldvapen inom detaljplanelagt område istället skulle kunna flyttas till länsstyrelserna.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "sec53",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen har ingen erinran mot utredningens förslag att tillståndsprövningen avseende att använda offentlig plats flyttas till kommunen.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec49",
      "sentiment": 0.5,
      "quote": "Länsstyrelsen anser dock - för det fall tillståndsgivningen skulle flyttas över till kommunen – att frågan om att ge Myndigheten för civilt försvar rollen som tillsynsmyndighet över kommunernas tillståndsgivning, jfr 23 a § lagen (2010:1011) om brandfarliga och explosiva varor, samtidigt bör övervägas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec49",
      "sentiment": -0.5,
      "quote": "Utöver länsstyrelsens kompetens inom sakområdena viltvård, skyddsjakt och civil beredskap, finns det därmed en samordningsvinst om tillstånd till skjutning med eldvapen flyttas till länsstyrelserna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec54",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen har ingen erinran mot att tillstånd för den under 18 år att använda luft- eller fjädervapen flyttas till kommunen.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec50",
      "sentiment": 0.5,
      "quote": "Länsstyrelsen anser dock - för det fall tillståndsgivningen skulle flyttas över till kommunen – att frågan om att ge Myndigheten för civilt försvar rollen som tillsynsmyndighet över kommunernas tillståndsgivning, jfr 23 a § lagen (2010:1011) om brandfarliga och explosiva varor, samtidigt bör övervägas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec50",
      "sentiment": -0.5,
      "quote": "Båda prövningarna har polisiär relevans och de bör för helhetens och enkelhetens skull hanteras av samma instans.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.3.2",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen har inget att erinra mot att hanteringen av begäran om rättelser och bestridanden enligt lagen om felparkeringsavgift flyttas till Transportstyrelsen.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.3.2",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen instämmer i utredningens förslag att länsstyrelserna ska överta Polismyndighetens skyldigheter angående utredning och bedömning av behovet av inhägnad av övergivna gruvhål samt kostnaderna för sådan inhägnad.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.3.2",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen har ingen erinran mot att begränsa möjligheten för andra att anlita Polismyndigheten för stämningsmannadelgivning.",
