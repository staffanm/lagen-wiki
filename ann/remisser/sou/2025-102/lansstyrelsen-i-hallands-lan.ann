  "overall": {
    "sentiment": 0.2,
    "quote": "Länsstyrelsen i Hallands län anser att flera uppgifter som nu föreslås flyttas från Polismyndigheten med fördel i stället skulle kunna flyttas till länsstyrelserna.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a4.1.1",
      "sentiment": 1.0,
      "quote": "Kommunens prövningsrätt är mer vidsträckt än Polismyndighetens (jfr prop. 1992/92:210 s. 107).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.3",
      "sentiment": -0.5,
      "quote": "Det finns starka skäl till att den statliga kontrollen över ärendegrupperna bör finnas kvar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.1.2",
      "sentiment": -0.5,
      "quote": "En flytt till länsstyrelsen skulle även ge en mer enhetlig och regional syn på miljökonsekvenserna av sprängningar (se Naturvårdsverkets förslag i SOU 2002:70 s. 89).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.1.2",
      "sentiment": -0.5,
      "quote": "Utöver länsstyrelsens kompetens inom sakområdena viltvård, skyddsjakt och civil beredskap, finns det därmed en samordningsvinst om tillstånd till skjutning med eldvapen flyttas till länsstyrelsen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.1.2",
      "sentiment": -0.5,
      "quote": "Tillstånd för den under 18 år att använda luft- eller fjädervapen bör flyttas till länsstyrelsen av samma skäl som gäller för tillstånd till skjutning med eldvapen inom detaljplanelagt område.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.1.3",
      "sentiment": -0.5,
      "quote": "Länsstyrelsen har därför god kompetens i fråga om riskerna kring spridning av bränder och säkerhet i allmänhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.1.4",
      "sentiment": -0.5,
      "quote": "Det är länsstyrelsens uppfattning att det generellt sett finns en varierande kompetens i de avvägningar som kommunen måste göra enligt ordningslagen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.4",
      "sentiment": -0.5,
      "quote": "Båda prövningarna har polisiär relevans och de bör för helhetens och enkelhetens skull hanteras av samma instans.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.3.2",
      "sentiment": -0.5,
      "quote": "Länsstyrelsen har följaktligen en bred och upparbetad kompetens, administration och effektivitet i fråga om handläggning av förvaltningsärenden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.2",
      "sentiment": 1.0,
      "quote": "Länsstyrelserna instämmer i utredningens förslag att länsstyrelsen också ska överta Polismyndighetens skyldigheter angående utredning och bedömning av behovet av inhägnad av övergivna gruvhål samt kostnaderna för sådan inhägnad.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.3.2",
      "sentiment": -0.5,
      "quote": "Det finns en överhängande risk att bedömningen blir felaktig i brist på tillgång till Polismyndighetens uppgifter och kunskaper.",
      "quote_type": "grund"
    }
  ]
