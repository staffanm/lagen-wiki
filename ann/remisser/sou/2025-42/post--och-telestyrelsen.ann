  "overall": {
    "sentiment": 0.2,
    "quote": "Beslut om nya åtgärder kräver, enligt PTS, noggranna överväganden så att proportionaliteten mellan intrång i personlig integritet och behovet av säkerhetsskyddsåtgärder säkerställs.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a4.4.1",
      "sentiment": 1.0,
      "quote": "PTS har inget att erinra mot utredningens förslag att utvidga möjligheten till att ingripa under ett pågående förfarande, dvs. att tillämpningsområdet för 4 kap. 12 § SäkL utvidgas.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a4.4.2",
      "sentiment": 1.0,
      "quote": "När det gäller den anmälningsplikt som utredningen föreslår har PTS inget att erinra mot den heller.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec248",
      "sentiment": -0.5,
      "quote": "Mot bakgrund därav ifrågasätter PTS om det är rimligt att belägga underlåtenhet att anmäla dessa förfaranden med sanktionsavgift.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": -0.5,
      "quote": "Enligt PTS bedömning bör således möjligheten att tillgripa dessa åtgärder reserveras för Säkerhetspolisen och Försvarsmakten, i de fall situationen är så allvarlig att de övertar tillsynen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": -0.5,
      "quote": "Om tillsynsmyndigheterna i sin verktygslåda även skulle ha den här typen av åtgärdsmöjligheter kan det skapa osäkerhet hos verksamhetsutövarna, en ovilja att söka stöd hos tillsynsmyndigheterna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5",
      "sentiment": -0.2,
      "quote": "Skälet är att PTS ifrågasätter om Säkerhetspolisen, med dagens process för säkerhetsprövningar, har tillräcklig bakgrundsinformation om den kontrollerade för att kunna avgöra vilka utfall från flera av dessa utpekade register som i det enskilda fallet kan antas ha betydelse för prövningen",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5.7",
      "sentiment": 1.0,
      "quote": "Uppgifterna ur detta register ger även en entydig indikation på potentiella sårbarheter ur ett ekonomiskt perspektiv och kräver därför inte en bedömning i det enskilda fallet av Säkerhetspolisen av om uppgifterna kan antas ha betydelse för prövningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2.4",
      "sentiment": -0.2,
      "quote": "Enligt PTS bedömning är det tveksamt om ett samtycke som lämnats innan utvidgningen av kontrollen kan anses omfatta även de utökade slagningarna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.8",
      "sentiment": -1.0,
      "quote": "Med en anmälningsplikt av dessa säkerhetsprövningsbeslut är risken stor att de personer som registreras hos Säkerhetspolisen inte har möjlighet att jobba i någon säkerhetskänslig verksamhet, oavsett verksamhetens skyddsvärde.",
      "quote_type": "grund"
    }
  ]
}