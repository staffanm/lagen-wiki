    "inputs": {
      "artifact:remisser/sou/2025:42/telia-company-ab": "cf0056503a48cdecf7553c806a051cd3791a9e038c647907d3f3464b2ad2692c",
      "artifact:forarbete/sou/2025-42": "c7ac1805f8b9b2919bee30d4de29031548e4d91c94fd41165ac700185388b19b"
    }
  },
  "overall": {
    "sentiment": -0.4,
    "quote": "Regleringen måste emellertid vara ändamålsenlig, proportionerlig och förutsebar samt utformad så att den harmoniserar med civilrättsliga principer, förvaltningsrättsliga garantier och praktiska driftsförutsättningar i komplexa verksamheter.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "sec18",
      "sentiment": 0.5,
      "quote": "Telia delar utredningens bedömning att åtgärden är viktig sett till det säkerhetshot Sverige ställs inför i dag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec18",
      "sentiment": -0.5,
      "quote": "Även om bestämmelsens syfte är angeläget, är den typiska riskpåverkan vid en underlåten underrättelse inte av sådan art att den motiverar en ingripande ekonomisk sanktion mot verksamhetsutövaren eftersom det är en annan verksamhetsutövare som har ansvar för att genomföra säkerhetsprövningen av personal som deltar i deras verksamhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5",
      "sentiment": 1.0,
      "quote": "Telia tillstyrker förslaget att utvidga registerkontrollen enligt 3 kap. 13 § säkerhetsskyddslagen.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a4.4.2",
      "sentiment": -1.0,
      "quote": "En sådan plikt riskerar vidare att utvecklas till en omfattande administrativ masshantering utan att ge ett reellt mervärde för skyddet av Sveriges säkerhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec74",
      "sentiment": -1.0,
      "quote": "Att ytterligare utvidga denna befogenhet är varken nödvändigt eller proportionerligt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5",
      "sentiment": -0.5,
      "quote": "Telia ifrågasätter det föreslagna systemet med ex gratia-ersättning, eftersom det varken uppfyller kraven på rättssäkerhet eller förutsebarhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": -1.0,
      "quote": "Förslagen saknar ett tillräckligt behovsunderlag och framstår därför som oproportionerliga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec29",
      "sentiment": -1.0,
      "quote": "Den föreslagna ordningen riskerar att medföra omfattande och svårförutsebara konsekvenser för verksamhetsutövare inom området elektronisk kommunikation, särskilt i fråga om leveransplikt och kravet på att upprätthålla robusta och tillförlitliga nät och tjänster.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec30",
      "sentiment": -1.0,
      "quote": "Utredningen anger att beslut om tvångsåtgärder ska tillämpas restriktivt och enbart i mycket speciella undantagssituationer, vilket dock inte avspeglas i den föreslagna lydelsen av bestämmelsen, varför bestämmelsen inte kan tillstyrkas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": -1.0,
      "quote": "Risken uppstår då att en tillsynsmyndighet, inom ramen för föreslagna befogenheter, tar del av säkerhetsskyddsklassificerade uppgifter som rör en tredje part utan att inneha formell behörighet för detta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.3",
      "sentiment": -1.0,
      "quote": "Genom förslaget ges tillsynsmyndigheten befogenhet att fatta beslut som kan få mycket ingripande rättsliga och faktiska konsekvenser för verksamhetsutövare, aktörer och motparter, utan att det ställs krav på särskild sakkunskap eller kompetens hos den beslutande tjänstemannen i fråga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec137",
      "sentiment": -1.0,
      "quote": "En omprövning bör ske varannan vecka med beaktande av att beslutet kan medföra betydande rättsliga konsekvenser för verksamhetsutövare, motparter samt övriga berörda aktörer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec136",
      "sentiment": -0.5,
      "quote": "Telia anser emellertid att bestämmelsen bör kompletteras med en angiven tidsfrist, exempelvis att domstolen ska pröva en ansökan enligt 6 kap. 8 § säkerhetsskyddslagen inom en vecka, från att ansökan inkommit.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec135",
      "sentiment": -1.0,
      "quote": "Det är av vikt att den part som omfattas av beslutet underrättas om sådant beslut senast i samband med att verkställighet sker.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec35",
      "sentiment": -1.0,
      "quote": "Det föreligger inte skäl att tillämpa undantag för fara i dröjsmål om verkställighet inte har initierats inom en månad.",
      "quote_type": "grund"
    }
  ]
}