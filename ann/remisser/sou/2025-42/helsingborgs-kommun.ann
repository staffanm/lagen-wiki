  "segments": [
    {
      "forarbete_id": "sec74",
      "sentiment": 0.8,
      "quote": "Det stärker vårt långsiktiga säkerhetsskydd, då det ger bättre förutsättningar att identifiera och skydda verksamheter som tidigare inte omfattats av säkerhetsskydd – men som, i dagens förändrade omvärldsläge, kan bedömas vara säkerhetskänsliga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5",
      "sentiment": 0.8,
      "quote": "En mer heltäckande registerkontroll kan bidra till en mer rättvisande och nyanserad bild av en individs lämplighet för säkerhetskänsliga uppgifter, vilket i sin tur minskar risken för att allvarliga säkerhetshot förbises.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.7",
      "sentiment": -0.2,
      "quote": "De psykosociala effekterna för närstående, såsom makar eller sambor, bör beaktas då dessa kan komma att omfattas av kontrollen utan att själva vara direkt involverade i den säkerhetskänsliga verksamheten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.8",
      "sentiment": 0.8,
      "quote": "I och med att individer ofta säkerhetsprövas av flera olika aktörer för olika befattningar inom säkerhetskänslig verksamhet, är sådan information av direkt relevans för att säkerställa en samlad och korrekt bedömning vid framtida prövningar.",
      "quote_type": "grund"
