    },
    {
      "forarbete_id": "a6.4",
      "sentiment": -0.2,
      "quote": "Det kan uppstå situationer där dessa inte är möjliga att flytta eller försegla.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.2",
      "sentiment": 0.2,
      "quote": "Lagring av säkerhetsskyddsklassificerade uppgifter i molntjänster (utan fullgott säkerhetsskydd) är en allvarlig överträdelse som kan få svåra konsekvenser för Sveriges säkerhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.3",
      "sentiment": -0.5,
      "quote": "SSM bedömer att intresset av att värna Sveriges säkerhet, likt intressena i strålskyddslagen, väger tillräckligt tungt för att ha en motsvarande ordning för tvångsåtgärder enligt säkerhetsskyddslagen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4.4",
      "sentiment": -0.2,
      "quote": "Detta skulle vara en olycklig ordning då det för samhället handlar om högre skyddsvärden i den senare lagen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": 1.0,
      "quote": "En sådan klareringsmyndighet skulle ansvara för hela eller delar av en säkerhetsprövning för att göra denna likvärdig och rättssäker.",
