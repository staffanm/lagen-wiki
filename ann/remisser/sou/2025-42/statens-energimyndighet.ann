    },
    {
      "forarbete_id": "a4.4.2",
      "sentiment": 0.2,
      "quote": "Myndigheten bedömer dock att skyldigheten , att anmäla redan ingångna avtal före december 2021 kan medföra en betydande administrativ belastning för tillsynsmyndigheterna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec248",
      "sentiment": -0.2,
      "quote": "Vidare ifrågasätter myndigheten om anmälningsplikten är av sådan betydelse att sanktioner vid underlåtelse är motiverade.",
