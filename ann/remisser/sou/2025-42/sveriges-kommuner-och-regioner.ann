      "sentiment": 1.0,
      "quote": "SKR har inga invändningar mot utredningens förslag till bestämmelser om registerkontroll.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.8",
      "sentiment": 0.5,
      "quote": "SKR delar utredningens bedömning att det, med dagens system, finns behov av lagändringar som gör det möjligt att inom ramen för en säkerhetsprövning få del av relevanta uppgifter som framkommit vid tidigare säkerhetsprövningar.",
      "quote_type": "grund"
