  },
  "segments": [
    {
      "forarbete_id": "a4.4.1",
      "sentiment": 0.5,
      "quote": "det i dessa fall är ännu viktigare att tillämpningen av bestämmelsen utgår ifrån proportionalitetsprincipen då de negativa konsekvenserna av ett ingripande i äldre förfaranden kan bli mer långtgående för parterna i förfarandet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.4.2",
      "sentiment": -0.5,
      "quote": "detta i praktiken kommer att innebära en betydligt högre arbetsbelastning hos tillsynsmyndigheterna, vilka redan idag kan uppleva stora utmaningar i att finna tillräckliga resurser för att hantera och agera på olämpliga förfaranden som upptäcks utifrån nuvarande bestämmelser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.4.3",
      "sentiment": 0.2,
      "quote": "När det saknas säkerhetsskyddsavtal mellan en verksamhetsutövare och annan part bör tillsynsmyndigheten dock utgå ifrån att den andra aktören vare sig agerat felaktigt eller i övrigt omfattas av säkerhetsskyddslagstiftningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": -0.5,
      "quote": "Svenska kraftnät har därmed svårt att se att de eftersökta effekterna av interimistiska åtgärder inte går att uppnå med befintliga verktyg, eller att förslaget på något sätt skulle innebära ett påskyndande av nuvarande processer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": -0.8,
      "quote": "Att också införa nu föreslagna tvångsåtgärder skulle ytterligare öka det avstånd som i dag finns mellan tillsynsmyndigheten och verksamhetsutövaren vilket inte gagnar tillsynsuppdraget eller Sveriges säkerhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5",
      "sentiment": 0.5,
      "quote": "Svenska kraftnät anser att det är nödvändigt att samtliga registerkontroller söks om då det enligt vår uppfattning krävs nya samtycken för en så pass utökad registerslagning som utredningen nu föreslår.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.7",
      "sentiment": -0.2,
      "quote": "Om även närstående ska kontrolleras i säkerhetsklass 3 blir gränserna mellan de olika klasserna än mer otydliga (se svar i punkt 7.6 ovan) då man suddat ut gränserna mellan dessa.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.8",
      "sentiment": 0.2,
      "quote": "Vi delar utredningens uppfattning att den omständigheten att den prövade vid tidigare säkerhetsprövning har bedömts som opålitlig ur säkerhetssynpunkt måste som utgångspunkt anses vara av betydelse för säkerhetsprövningen",
      "quote_type": "grund"
    },
    {
