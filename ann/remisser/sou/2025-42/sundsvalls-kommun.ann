  "segments": [
    {
      "forarbete_id": "sec84",
      "sentiment": 1.0,
      "quote": "I det säkerhetspolitiska läge som nu råder så ter det sig orimligt att tillsynsmyndigheten inte ska kunna ingripa även i dessa fall.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.4.2",
      "sentiment": 0.2,
      "quote": "Sundsvalls kommun ställer sig dock frågande till om alla tillsynsmyndigheter kommer att kunna hantera den ökade belastningen av fler anmälningar, både för äldre förfaranden som redan är inledda, och för nya förfaranden som ska påbörjas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5",
      "sentiment": 0.0,
      "quote": "Sundsvalls kommun har inga synpunkter på att det inte införs en bestämmelse om ersättningsrätt i vissa särskilda undantagssituationer.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": 0.5,
      "quote": "Dock är det som utredningen anger, ett effektivt verktyg för att förhindra eventuell skada för Sveriges säkerhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.4",
      "sentiment": 1.0,
      "quote": "Sundsvalls kommun ställer sig även positiv till att det införs ett system med tvångsåtgärder som avser eftersökande och tillfälligt omhändertagande av handlingar eller annan egendom, eller försegling av lokal, förvaringsplats eller annat utrymme.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.5",
      "sentiment": 1.0,
      "quote": "Sundsvalls kommun ser positivt på förslaget att oavsett säkerhetsklass så kollas alla mot samma register, förutsatt att uppgifterna är relevanta för aktuell säkerhetsklass.",
      "quote_type": "grund"
    }
  ]
