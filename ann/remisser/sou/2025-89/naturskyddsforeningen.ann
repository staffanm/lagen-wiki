  "segments": [
    {
      "forarbete_id": "a9.3",
      "sentiment": -0.5,
      "quote": "den föreslagna syftesbestämmelsen är otillräcklig eftersom den utgår från att fiskets långsiktiga ekonomiska och sociala hållbarhet är det primära målet.",
