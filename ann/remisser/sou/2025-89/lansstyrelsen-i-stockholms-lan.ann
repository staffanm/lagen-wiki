    },
    {
      "forarbete_id": "sec54",
      "sentiment": -0.5,
      "quote": "I Stockholms län bedrivs fisket på de allmänna vattnen i havet i liten omfattning och utgör inget hot mot fiskbestånden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec56",
      "sentiment": 0.2,
      "quote": "Det kan annars lätt uppfattas som att bilaga 1 och bilaga 2 avser allt fiske som bedrivs med frifiskerätt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec1134",
      "sentiment": -1.0,
      "quote": "Länsstyrelsen avstyrker förslaget och anser att det även fortsatt ska heta fisketillsynspersoner och att den myndighet regeringen bestämmer även fortsättningsvis kan förordna fisketillsynspersoner i havet och i de fem största sjöarna (där staten har föreskriftsrätt).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec1419",
      "sentiment": 0.0,
      "quote": "Enligt Länsstyrelsens mening bör överträdelser mot en reglering som införts i syfte att skydda och bevara hotade fiskbestånd inte kunna bedömas som ringa fall.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec150",
      "sentiment": -0.2,
      "quote": "Fredningsområden och fredningstider bör istället regleras i Havs- och vattenmyndighetens föreskriftssamling.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec174",
      "sentiment": 0.2,
      "quote": "Vi menar därför att det ska tas större regional hänsyn om beståndssituationen tillåter och att Länsstyrelsen har kompetens att göra den bedömningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec194",
      "sentiment": -0.2,
      "quote": "Länsstyrelsen anser att förslaget till 7 kap. 1 § tas bort och att fiskeförbud på dessa arter i enlighet med alla andra fredade fiskarter regleras av Havs-och vattenmyndighetens föreskriftssamling.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec195",
      "sentiment": 0.2,
      "quote": "Gäddsax är ett fiskeredskap som spetsar fisken men trots detta råder oklarheter om redskapet är tillåtet eller inte och det vore därför bra med ett förtydligande att så inte är fallet.",
      "quote_type": "grund"
