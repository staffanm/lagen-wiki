  "overall": {
    "sentiment": 0.5,
    "quote": "Havs- och vattenmyndigheten (HaV) tillstyrker i huvudsak de förslag som lämnas i SOU 2025:89 men är i vissa fall av en annan uppfattning.",
    "quote_type": "standpunkt"
  },
  "segments": [
    {
      "forarbete_id": "a1.2",
      "sentiment": 0.0,
      "quote": "HaV har uppmärksammat att förslaget till fiskeförordning innehåller vad myndigheten uppfattar som fel hänvisning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3",
      "sentiment": 0.5,
      "quote": "Utformningen omfattar dock inte rekreationella värden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.4",
      "sentiment": 1.0,
      "quote": "Utredningens förslag överensstämmer med det förslag som HaV 2018 lämnade i ett regeringsuppdrag om utformning av rapporteringsskyldighet och fördelning av den tillgängliga fiskeresursen för andra fiskare än yrkesfiskare",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.6",
      "sentiment": -1.0,
      "quote": "Tvärtom anser HaV att de fiskevårdsskäl som utredningen lyfter fram pekar på ett behov av att reglera ett generellt fiskeförbud i nära anslutning till vattenbruksanläggningarna i stället för att pröva detta särskilt för varje anläggning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3.2",
      "sentiment": 0.5,
      "quote": "juridiska personers innehav av licenser har visat sig medföra utmaningar vad gäller möjligheter att begränsa och kontrollera inflytande över licenser, tillstånd och fiskemöjligheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.3.3",
      "sentiment": 0.5,
      "quote": "I utredningen preciseras dock inte vad som anses vara en väsentlig ändring.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.8",
      "sentiment": -1.0,
      "quote": "Med ett licenskrav ges möjlighet att bedöma om tillgången på fisk medger att fisket kan tillåtas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.10",
      "sentiment": 0.5,
      "quote": "bedömer HaV att det finns behov av att förtydliga att när en licensinnehavare genomför ett byte med utlandet så bör kontroll ske om bytet innebär ett överskridande av fiskelicensinnehavarens ägarkoncentration.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.11.1",
      "sentiment": 0.2,
      "quote": "HaV har behov av att kunna använda den data som REM-systemet genererar även vid andra misstänkta överträdelser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.14.4",
      "sentiment": 0.5,
      "quote": "HaV bedömer att det skulle finnas fördelar om även Transportstyrelsen får föreskriftsrätt inom sitt ansvarsområde fysisk kontroll av motorstyrka (förslag till 10 kap. 13 § fiskeförordningen).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.6",
      "sentiment": -0.5,
      "quote": "Enligt HaV:s uppfattning är det endast den som använder redskapet som ska anges på märket.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a15.2.1",
      "sentiment": 0.2,
      "quote": "HaV bedömer att myndigheten, utöver bemyndigandet att meddela föreskrifter om vägning av fiskeriprodukter även behöver ett uttryckligt bemyndigande att föreskriva om kameraövervakning av vägningsprocessen under förutsättning att detta krävs enligt EU-bestämmelser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.3",
      "sentiment": 0.2,
      "quote": "HaV konstaterar dock att gränsdragningen av HaV:s och länsstyrelsens ansvarsområden fortfarande inte framgår av lagen utan får klargöras vid samverkan mellan myndigheterna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.3.9",
      "sentiment": 1.0,
      "quote": "myndigheten bedömer att behovet av en effektiv, ändamålsenlig och tydlig ansvarsfördelning är brådskande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.3.10",
      "sentiment": -1.0,
      "quote": "En sådan begränsning som föreslås innebär till exempel att fiskevakter som påträffar redskap som tillhör yrkesfiskare inte har befogenhet att kontrollera vad det är för redskap som står ute.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.6.5",
      "sentiment": 0.2,
      "quote": "Kustbevakningen till HaV ska lämna sådana uppgifter som HaV behöver för att fullgöra sitt arbete inom fiskerikontrollen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a17",
      "sentiment": -1.0,
      "quote": "myndigheten anser att det inte är rättssäkert att sanktionsavgifter till höga belopp ska kunna tas ut utan domstolsprövning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a17.10",
      "sentiment": -1.0,
      "quote": "bedömer HaV att en sådan tillämpning väsentligt ökar risken för att möjliga överträdelser hinner preskriberas innan de hinner prövas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a17.10.3",
      "sentiment": -0.2,
      "quote": "HaV bedömer att det föreligger svårigheter att inom ramen för oskälighetsbedömningen åstadkomma en förutsebar tillämpning som säkerställer att lika fall behandlas lika.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a17.13.5",
      "sentiment": 0.2,
      "quote": "HaV bedömer att detta kan förenkla både överblickbarheten och förståelsen av de olika delarna i bestämmelsen.",
      "quote_type": "grund"
    }
  ]
