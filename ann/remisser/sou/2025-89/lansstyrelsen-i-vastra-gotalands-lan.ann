    },
    {
      "forarbete_id": "a9.6",
      "sentiment": -0.5,
      "quote": "Det skapar en stor otydlighet, i ett annars tydligt förslag, att införa regler som ska tillämpas på vattenbruk och vattenbruksprodukter, när lagens tillämpningsområde egentligen avgränsats till fritt levande fisk och marina biologiska resurser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.3.3",
      "sentiment": -0.5,
      "quote": "Det bör inte införas en dubbelprövning för fasta redskap.",
