    {
      "forarbete_id": "a11.11.1",
      "sentiment": 1.0,
      "quote": "Brister i rapportering av landningar har visat att det behövs.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.3.1",
      "sentiment": -0.2,
      "quote": "Länsstyrelsen föreslår att förbudet att saluföra och sälja fångster från fritidsfiske i havet bör utvidgas till att gälla all fisk som fångats vid fritidsfiske även i sötvatten.",
