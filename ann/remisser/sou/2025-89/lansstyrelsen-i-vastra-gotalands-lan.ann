    },
    {
      "forarbete_id": "a16.3.7",
      "sentiment": 1.0,
      "quote": "Det är positivt att länsstyrelsen föreslås få ett förtydligat ansvar för fiskerikontroll då det kan bidra till en totalt sett mer robust fiskerikontroll och ett förstärkt samarbete mellan länsstyrelsen och övriga involverade myndigheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.3.10",
      "sentiment": -1.0,
      "quote": "Förslaget får flera negativa konsekvenser om det antas.",
