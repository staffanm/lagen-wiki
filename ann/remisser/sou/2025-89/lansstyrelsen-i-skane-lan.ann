  "overall": {
    "sentiment": 0.2,
    "quote": "Tillstyrker i huvudsak förslaget om en moderniserad och sammanhållen fiskelagstiftning.",
    "quote_type": "standpunkt"
  },
  "segments": [
    {
      "forarbete_id": "a9.3",
      "sentiment": 1.0,
      "quote": "Detta borgar för att Sverige ska sätta fiskresursen i första rummet både nationellt och inom den gemensamma fiskeripolitiken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.6",
      "sentiment": -0.5,
      "quote": "Lydelsen ”Bestämmelserna om fiske ska också tillämpas i fråga om verksamheter som syftar till att fånga, döda eller skörda andra fritt levande marina biologiska resurser” är otydlig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.4",
      "sentiment": -1.0,
      "quote": "Det främsta är att man sannolikt inte kommer få någon betydelse ur ett förvaltningsperspektiv då Havs- och vattenmyndigheten redan idag kan reglera frifisket så det är i balans med vad en hållbar förvaltning kräver.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.6",
      "sentiment": 0.2,
      "quote": "Länsstyrelsen anser att detta tillsammans med dagens situation, med stoppat fiske på i stort sett alla fiskbestånd som varit grunden för tidigare yrkesfiske, kräver en omfattande översyn av reglerna för fiskelicenser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.10",
      "sentiment": 0.5,
      "quote": "Det är främst genom en politiskt stabil prioriterad kvotfördelning av fisk till konsumtion på bekostnad av foderändamål som en utveckling av fiskberedning kan öka i Sverige.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.4.1",
      "sentiment": 0.0,
      "quote": "Då detta inte har gjorts inom ramen för aktuell utredning önskar Länsstyrelsen att det utreds i särskild ordning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.3.7",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen välkomnar ett förtydligande av vårt ansvar för kontroll av fiske i hav och sötvattensområde.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a16.3.10",
      "sentiment": -1.0,
      "quote": "Förslaget innebär att Länsstyrelsen ska bedriva tillsyn på Skånes 40 mil långa kuststräcka vilket kräver resurser som långt överstiger nyttan av tillsynen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.4",
      "sentiment": 0.5,
      "quote": "Polismyndighetens insats är viktig, men i dagsläget är det mycket svårt att erhålla det stödet på grund av långa avstånd och en låg prioritering av fiskebrott.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.4.3",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen välkomnar att det ska vara möjligt att beslagta föremål även i andra situationer än då en person påträffas medan hen begår brott.",
