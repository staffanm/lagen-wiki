  "segments": [
    {
      "forarbete_id": "sec65",
      "sentiment": -1.0,
      "quote": "Motiveringen är att syftet med förslaget redan idag uppfylls med dagens lagstiftning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec31",
      "sentiment": -1.0,
      "quote": "Om förslaget godtas måste finansiella medel skjutas till och organisatoriska förändringar genomföras för att möta det betydligt större ansvar som i så fall skulle komma att vila på länsstyrelsens egen personal.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.3.7",
      "sentiment": -1.0,
      "quote": "Länsstyrelsen bör inte generellt anges som ansvarig för fiskekontroll i sötvattensområden, då det för enskilda vatten är en enskild angelägenhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec42",
      "sentiment": -0.2,
      "quote": "Avgränsningen mot kustvatten borde på något sätt definieras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec68",
      "sentiment": -0.2,
      "quote": "Länsstyrelsen föreslår att skälen till de geografiska avgränsningarna utreds vidare utifrån de förutsättningar som råder idag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec196",
      "sentiment": -0.5,
      "quote": "Problematiken ligger i att Länsstyrelsen enligt 7 kap 10 § inte kan föreskriva om undantag från bestämmelserna i 7 kap 8 § för egna undersökningar som behöver genomföras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec31",
      "sentiment": -0.5,
      "quote": "En förändring av detta till Fiskevakt kommer sannolikt att skapa onödig förvirring och inte heller på ett tydligt sätt spegla uppdragets syfte.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.9",
      "sentiment": 1.0,
      "quote": "Den bedömning som görs under 9.9, att förhållandet mellan fiskeoch miljölagstiftningen bör utredas närmare delas av Länsstyrelsen.",
      "quote_type": "standpunkt"
    }
  ]
