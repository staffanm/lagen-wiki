  "segments": [
    {
      "forarbete_id": "sec91",
      "sentiment": 0.5,
      "quote": "Bifångster av tumlare sker främst i garnfiske och majoriteten av de bifångster som sker rapporteras inte.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec101",
      "sentiment": 0.5,
      "quote": "För att uppfylla de syften som listas i punkt 1–3 i 5 § bör det dock krävas att inte endast fångst rapporteras och registreras, utan även redskapsanvändning för att möjliggöra bedömning av bifångstrisker.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a17.13.5",
      "sentiment": 0.2,
      "quote": "För att undvika rättslig osäkerhet bör det dock framgå tydligt om bifångade marina däggdjur klassas som marina biologiska resurser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec185",
      "sentiment": 0.0,
      "quote": "Redskap som ryssjor, mjärdar och fiskburar kan fånga utter och andra arter oavsiktligt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec190",
      "sentiment": 0.5,
      "quote": "Detta behövs för att kunna bedöma risken för bifångster i fritidsfisket.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec193",
      "sentiment": 1.0,
      "quote": "då de kan bidra till ökat skydd för marina däggdjur genom tydligare regler kring fiskevård och habitatpåverkan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec227",
      "sentiment": 1.0,
      "quote": "vilket kan stärka arbetet med att minska bifångster i skyddade områden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.5.1",
      "sentiment": 0.0,
      "quote": "För att spegla aktuell kunskap föreslås att referensen kompletteras med Havs- och vattenmyndigheten (2025).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.5.2",
      "sentiment": -0.2,
      "quote": "då underlaget ofta är begränsat.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.5.2",
      "sentiment": 0.0,
      "quote": "Efterlevnaden är avgörande för att säkerställa att alla parter vidtar nödvändiga åtgärder för att minska bifångster av skyddade arter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.3.6",
      "sentiment": 0.5,
      "quote": "då ljudskrämmor är idag ett av få verktyg för att minska bifångster av marina däggdjur med bibehållet nätfiske.",
      "quote_type": "grund"
