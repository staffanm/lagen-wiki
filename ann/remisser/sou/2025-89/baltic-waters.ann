    {
      "forarbete_id": "sec101",
      "sentiment": 0.5,
      "quote": "Fritidsfisket har betydelse för fiskbeståndens utveckling och Östersjöns ekosystem.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec115",
      "sentiment": 1.0,
      "quote": "BalticWaters vill understryka att en ändamålsenlig fiskerikontroll är avgörande för ett långsiktigt hå llbart fiske.",
