  "overall": {
    "sentiment": 0.2,
    "quote": "Idag återspeglas inte något tydligt beredskapsperspektiv i utredningen vilket är en brist.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "sec46",
      "sentiment": -0.5,
      "quote": "Det finns en risk att en så pass bred definition kan tolkas som att användandet av levande betesfisk skulle vara tillåtlig trots att det inte är förenligt med djurskyddslagstiftningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.4",
      "sentiment": -0.2,
      "quote": "Detta kan medföra att åtgärder väljs som annars av smittskyddsskäl ej hade införts eller utformats annorlunda.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.5",
      "sentiment": -0.5,
      "quote": "Förslaget i 7 kap. 14 § fiskelag och fiskeförordning innebär en utvidgning av dagens krav på tillstånd eftersom det inte framgår att det är när man flyttar fisk från naturliga vatten och sätter ut i naturliga vatten som detta ska regleras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.5",
      "sentiment": -1.0,
      "quote": "för att vi ska kunna uppfylla vårt uppdrag enligt vår instruktion måste vi ha bemyndigande att föreskriva och fatta beslut om förflyttning av vattenlevande djur av smittskyddsskäl.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec79",
      "sentiment": 0.2,
      "quote": "detta för att bland annat undvika problematik med att fastställa ägandeskap i de fall utrustning av någon anledning blir marint skräp.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.10",
      "sentiment": 0.2,
      "quote": "Inför nya förvaltningsperioder bör det befintliga systemet utvärderas utifrån hur väl resursen kommer svensk fiskenäring till godo, vilket inkluderar hela värdekedjan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.3",
      "sentiment": 0.5,
      "quote": "det är viktigt att förvaltningen av fiskresursen även görs på ett sätt som tryggar en hög grad av djur- och smittskydd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.4",
      "sentiment": 0.0,
      "quote": "det är av stor vikt att ett framtida uppdrag innehåller tydliga kriterier för fördelning och en väl underbyggd konsekvensutredning med fokus på hur livsmedelsförsörjningen och det yrkesmässiga fisket kan påverkas beroende på hur resursen fördelas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.13",
      "sentiment": -0.2,
      "quote": "I nuläget hanteras frågan genom att Jordbruksverket överlämnat förvaltningsuppgiften till Sjöräddningssällskapet eftersom myndigheten saknar den kompetens som krävs för att hantera frågan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a11.5",
      "sentiment": 0.2,
      "quote": "Prövningen bör ses över med jämnt tidsintervall för att säkerställa att kvoterna bidrar till svenska mervärden och stärker hela värdekedjans konkurrenskraft.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a12.4",
      "sentiment": 0.5,
      "quote": "mot bakgrund av att de skulle ge förbättrade kunskapsunderlag kring fisketryck som är relevant även för Jordbruksverkets arbete.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.6",
      "sentiment": 1.0,
      "quote": "det skulle innebära minskad administration.",
      "quote_type": "grund"
    }
  ]
}