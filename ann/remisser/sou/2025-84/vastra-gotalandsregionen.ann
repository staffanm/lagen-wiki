  "overall": {
    "sentiment": 0.5,
    "quote": "Västra Götalandsregionen (VGR) ställer sig i huvudsak positiv till utredningen som bedöms vara omfattande med utgångspunkt i barnkonventionen och barnens rättigheter samtidigt som barn och ungas synpunkter beaktats.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a2.1.2",
      "sentiment": -0.5,
      "quote": "Däremot motsäger sig regionen att man väljer gränsen 7 år för HVB-hem med motiveringen brist på familjehem.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a2.2.3",
      "sentiment": -0.2,
      "quote": "Däremot är VGR tveksamma till om kraven på yrkeskompetens för att möta barnens behov är tillräckligt tydliga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.1.6",
      "sentiment": 0.5,
      "quote": "VGR delar utredarnas problembeskrivning att möjligheter till boende minskat kraftigt vilket ökar behovet av institutionsvård som utifrån ett förebyggandeperspektiv inte skulle behövas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.2.6",
      "sentiment": 0.2,
      "quote": "VGR efterlyser analys av vilka insatser som erbjuds utöver läkemedel samt rekommenderar uppföljning av läkemedelskonsumtion och andra behandlingsmetoder.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.8.2",
      "sentiment": 1.0,
      "quote": "VGR är positiva till att utredningen genomfört en enkät till barn och unga och att de ungas synpunkter påverkat utredningen förslag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.9.2",
      "sentiment": 1.0,
      "quote": "VGR instämmer med att yngre flickor inte bör vårdas ihop med äldre pojkar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5",
      "sentiment": 1.0,
      "quote": "VGR ser positivt på att utredningen gjort en nordisk utblick och fått kunskap om att det föreligger en jämförelsevis låg grad av reglering av institutionsvård av barn och unga i Sverige.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1",
      "sentiment": 1.0,
      "quote": "VGR instämmer i utredningens bedömning att ”en omfattande reform av den privata och kommunala institutionsvården för barn och unga krävs i syfte att säkerställa förutsättningarna för en ändamålsenlig och meningsfull vård i en trygg och säker vårdmiljö som motverkar instabilitet i vårdkedjan och stärker arbetet med att förebygga brott och andra sociala problem” där barn- och ungas delaktighet är avgörande”.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.1.1",
      "sentiment": 1.0,
      "quote": "VGR är eniga med att institutionsvården behöver bedrivas och utvecklas som en professionell verksamhet inom de ramar som lagstiftaren och myndigheter anger.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": 1.0,
      "quote": "VGR ser det som angeläget att Socialstyrelsen får i uppdrag att under en period på tre år samordna de nationella insatserna för att stödja genomförandet av reformen, följa upp resultat och erfarenheter av reformen samt analysera och bedöma eventuella förändringsbehov och långsiktiga nationella åtaganden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1",
      "sentiment": 1.0,
      "quote": "VGR instämmer i behovet att staten anger hur vården i hem för barn och unga ska vara utformad genom bestämmelser om differentiering samt vårdens ramar och innehåll, samt att säkerställa att vården motsvarar barns och unga individuella vårdbehov och är ändamålsenlig, meningsfull, trygg och säker för dem.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.3",
      "sentiment": -0.5,
      "quote": "VGR instämmer i förslaget att ta fram tre kategorier men reserverar sig mot att barn från 7 år kan placeras i generella och specialiserade hem för barn och unga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.5",
      "sentiment": 1.0,
      "quote": "VGR ställer sig särskilt positivt till förslaget om specialiserade hem för barn och unga i syfte att skapa mer individanpassade lösningar för barn och unga med komplexa vårdbehov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.6",
      "sentiment": -0.2,
      "quote": "Det hade varit önskvärt med en mer utförlig beskrivning om vilka grunder sådana beslut ska fattas på och vilka utmaningar det kan innebära.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.3",
      "sentiment": 1.0,
      "quote": "VGR ställer sig positivt till förslaget att en enhet på ett generellt eller specialiserat hem för barn och unga högst får vårda 6 barn eller unga samtidigt.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": -0.5,
      "quote": "VGR bedömer att frågan om åldersgräns bör utredas ytterligare då nuvarande motiveras med att det finns brister i kunskap om från vilken ålder det kan anses mer lämpligt att vårdas på institution, hur stort antal barn som vårdas vid HVB i dag i åldersgruppen 7–12 år och bristen på familjehem.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5",
      "sentiment": -0.2,
      "quote": "VGR bedömer att kunskap och kompetens kring barnets rättigheter behöver tydliggöras gällande krav på personalens kompetens.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.6",
      "sentiment": 0.2,
      "quote": "VGR är positiva till förslagen i stort men bedömer att kunskap och kompetens kring barnets rättigheter behöver tydliggöras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8",
      "sentiment": 0.5,
      "quote": "VGR vill betona att barn och ungas rätt till utbildning är central för möjligheten att fullfölja sina studier och utveckla en god hälsa.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": 0.5,
      "quote": "VGR vill betona behovet av sammanhållen vård.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4",
      "sentiment": 1.0,
      "quote": "VGR är enig med utredningens bedömning att ”barn och unga i institutionsvård riskerar i dag att inte få tillgång till hälso- och sjukvård efter behov och att få hälso- och sjukvård som inte utförs på uppdrag av en huvudman som kan bedöma vårdens kvalitet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.1",
      "sentiment": 1.0,
      "quote": "VGR bekräftar utredningens påstående om att ”barn och unga i samhällsvård riskerar att ha mindre tillgång till vård och stöd för hälsan än andra barn och unga på grund av bristande samverkan mellan regioner och kommuner inför och under placeringen”.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.4",
      "sentiment": -0.2,
      "quote": "VGR efterlyser att utredningen förhåller sig till de utmaningar som det kan innebära, bland annat när man ska upprätta en individuell plan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5",
      "sentiment": 1.0,
      "quote": "VGR ser positivt på utredningens tyngdpunkt vid att barnets rättigheter ska vara vägledande i de befogenheter som föreslås råda vid Hem för barn och unga liksom att utredningen föreslår skrivelse i lag om att barnets bästa ska vara avgörande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.6",
      "sentiment": 0.2,
      "quote": "VGR saknar däremot ett tydliggörande om att det arbetet ska ske i löpande dialog med barn och unga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.8",
      "sentiment": 1.0,
      "quote": "VGR bedömer att skrivelsen om kroppsvisitation lyfter fram barnets rätt till delaktighet på ett bra sätt, där utredningen visar på olika sätt att stärka barnets delaktighet och egenmakt i en mycket utsatt situation.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.9",
      "sentiment": 0.2,
      "quote": "VGR ser dock att utredningen också hade kunnat lyfta att barnet vid detta samtal ska ges möjlighet att framföra önskemål om hur åtgärden kan utföras om det skulle behövas i framtiden samt att detta dokumenteras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.2.4",
