  "segments": [
    {
      "forarbete_id": "a6.2.2",
      "sentiment": 1.0,
      "quote": "Uppsala ser positivt på förslaget att framgent särskilja institutionsvården mellan vuxna samt barn och unga genom införandet av den nya placeringsformen hem för barn och unga (HBU) för personer upp till 20 år i tre olika kategorier: hem för barn och föräldrar, generella hem för barn och unga samt specialiserade hem för barn och unga.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.1.5",
      "sentiment": -0.5,
      "quote": "Uppsala ställer sig dock frågande till att de specialiserade hemmen endast får ha en inriktning eftersom utredningen lyfter att många barn och unga har en kombinerad problematik, vilket även Uppsalas egen erfarenhet vittnar om.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.3",
      "sentiment": 0.5,
      "quote": "Det ger bättre förutsättningar för att begränsa smittorisken avseende beteendeproblematik mellan olika klienter och åldersgrupper även om mindre enheter tenderar att bli kostnadsdrivande för utföraren.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
