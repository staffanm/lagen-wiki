      "artifact:remisser/sou/2025:84/inspektionen-for-vard-och-omsorg": "8ed25a577478ae1964178ec51dc48445d8c7722b44cac5400b73b7bf96b03014",
      "artifact:forarbete/sou/2025-84": "316cc38993c62773077c8f90dc994921ac81d26564be89872d71e339c7a69a0e"
    }
  },
  "overall": {
    "sentiment": 0.5,
    "quote": "Inspektionen för vård och omsorg (IVO) instämmer i utredningens bedömning att det krävs en omfattande reform av institutionsvården för barn och unga i syfte att säkerställa förutsättningarna för en ändamålsenlig och meningsfull vård i en trygg och säker vårdmiljö som motverkar instabilitet i vårdkedjan och stärker arbetet med att förebygga brott och andra sociala problem.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a7.1.4",
      "sentiment": 0.2,
      "quote": "IVO tillstyrker förslaget men vill uppmärksamma att det finns svårigheter för myndigheten att bedöma huruvida verksamheten bedrivs i enlighet med tillståndet vad gäller målgrupp.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.5",
      "sentiment": -0.5,
      "quote": "Enligt IVO:s erfarenhet motsvarar en sådan begränsning inte de behov som finns hos barn och unga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2",
      "sentiment": 0.2,
      "quote": "IVO tillstyrker förslaget men ser vissa risker om enheter med olika inriktning/åldersspann skulle vara belägna nära varandra.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.6.4",
      "sentiment": 0.2,
      "quote": "Det är dock angeläget att kravet på bemanning, så långt det är möjligt, tydliggörs i 5 a kap. 19 § förslaget till förordningen (2025:468) om ändring i socialtjänstförordningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.8",
      "sentiment": 0.5,
      "quote": "Det är viktigt att användningen av säkerhetslösningar och verksamhetsskydd är motiverad utifrån en proportionalitetsbedömning med bland annat en bibehållen respekt för barnet/den unges integritet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5.2",
      "sentiment": -0.5,
      "quote": "IVO menar dock att utredningens förslag inte är tillräckligt tydliga och avgränsade i alla delar vilket bedöms vara viktigt ur rättssäkerhetssynpunkt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5.3",
      "sentiment": -1.0,
      "quote": "Skälet är att de generella hemmen inte är avsedda att ta emot en målgrupp med sådana behov att befogenheter är motiverade.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.6.2",
      "sentiment": -1.0,
      "quote": "Administrationsbördan för verksamheten och för IVO, tillsammans med svårigheten att bedöma och agera utifrån uppgifterna, motsvarar inte den eventuella nyttan i form av skarpare riskbedömningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.7.4",
      "sentiment": 0.5,
      "quote": "IVO anser emellertid att 11 § i förslaget till lag (2026:000) med särskilda bestämmelser för vård vid hem för barn och unga behöver tydliggöras och/eller kompletteras med myndighetsföreskrifter på så sätt att det blir tydligt vilka kriterier som ska vara uppfyllda för att beslut om begränsningar i kommunikationstjänster ska kunna fattas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.8.1",
      "sentiment": 0.2,
      "quote": "IVO anser att förslaget till lagtext behöver förtydligas och preciseras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.8.2",
      "sentiment": 0.5,
      "quote": "För att säkra en god och kvalitativ vård avseende korrekta begränsningsåtgärder behöver 22 § förslaget till lagen (2026:000) med särskilda bestämmelser för vård vid hem för barn och unga kompletteras på så sätt att föreståndaren eller huvudmannen ska anmäla till IVO vem som har delegerats rätt att fatta beslut.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.9.2",
      "sentiment": 0.5,
      "quote": "IVO vill dock betona vikten av att barn/unga ges möjlighet att framföra sin uppfattning om åtgärden i samband med att föreståndaren beslutar om det, i likhet med vad som gäller vid socialnämndens beslutsfattande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.4.2",
      "sentiment": 0.2,
      "quote": "IVO anser dock att utformningen, i vissa delar, såsom den föreslås, kan leda till tillämpningsproblem och behöver därför förtydligas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.4.5",
      "sentiment": 0.5,
      "quote": "IVO önskar ett förtydligande av vad som avses med begreppet ”nyligen”.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.4.7",
      "sentiment": 0.5,
      "quote": "IVO vill dock understryka att det ur rättssäkerhetssynpunkt är olämpligt att en myndighet till någon aktör, offentlig såväl som privat, i förväg meddelar att ett beslut i viss riktning är att vänta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.4.8",
      "sentiment": -0.5,
      "quote": "Att löpande föra in och uppdatera dessa uppgifter i registret skulle dels inte tillföra något för tillsynen, dels riskera att bli en administrativ börda då uppgifterna snabbt blir inaktuella.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.5.1",
      "sentiment": -1.0,
      "quote": "Tvärtom bedömer IVO att resurser binds upp på ett icke resurseffektivt sätt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.5.2",
      "sentiment": -1.0,
      "quote": "En ordning där samtliga delar i en verksamhet vid varje enskilt tillfälle alltid ska inspekteras kommer att medföra betydligt längre handläggningstider och likaså en mindre ändamålsenlig tillsyn.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.5",
      "sentiment": 0.5,
      "quote": "En förlängning av perioden från tre till sex månader skulle leda till att ansökningarna spreds ut över längre tid.",
      "quote_type": "grund"
    }
  ]
}