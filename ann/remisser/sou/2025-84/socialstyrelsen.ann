      "artifact:forarbete/sou/2025-84": "316cc38993c62773077c8f90dc994921ac81d26564be89872d71e339c7a69a0e"
    }
  },
  "overall": {
    "sentiment": 0.2,
    "quote": "Socialstyrelsen har stor förståelse för de utmaningar som finns i HVBvården och instämmer i att det finns ett behov av att reformera institutionsvården för barn och unga.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a6.2.3",
      "sentiment": 0.0,
      "quote": "Socialstyrelsen anser att vissa ändringar bör göras i definitionen för att tydliggöra att syftet med vistelsen i hemmet är vård.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": 0.2,
      "quote": "Förslaget riskerar annars att urholka och begränsa myndighetens analysverksamhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.1",
      "sentiment": 0.0,
      "quote": "Socialstyrelsen instämmer i behovet av att kunskapsstöd tas fram men vill framhålla att utredningen har underskattat behovet av analysarbete för att ta fram kunskapsstöd med god kvalitet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.2",
      "sentiment": 1.0,
      "quote": "Detta mot bakgrund av att specialiserade hem är tänkta att ha andra inriktningar och förutsättningar än generella hem för barn och unga och kan då komma att kräva uppföljning m.m. utifrån andra parametrar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.3",
      "sentiment": -0.2,
      "quote": "ett för detaljstyrt analysuppdrag riskerar att missa andra viktiga frågeställningar som bättre hade kunnat svara på den centrala frågan för analysen eller som också hade behövts.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1",
      "sentiment": 1.0,
      "quote": "Socialstyrelsen delar bedömningen att staten behöver ange hur vården i hem för barn och unga ska vara utformad för att säkerställa att vården motsvarar barns och unga individuella vårdbehov, är ändamålsenlig, meningsfull samt bedrivs i en trygg och säker vårdmiljö.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.2",
      "sentiment": 0.2,
      "quote": "En risk med en uppdelning i generella och specialiserad hem är att kraven på verksamheten och personalens kompetens blir lägre för generella hem än på specialiserade hem, vilket kan leda till att de som vårdas där får en sämre vård.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.4",
      "sentiment": -0.5,
      "quote": "Socialstyrelsen anser inte att brister i omsorgen i sig är tillräcklig grund för placering på ett hem för barn och unga om barnet eller den unge inte har någon egen beteendeproblematik.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.5",
      "sentiment": 0.2,
      "quote": "Enligt myndigheten bör inriktningarna i första hand bygga på vilket socialt vårdbehov barnet eller den unge har och om behandlingen kräver särskild kunskap för att tillgodose barnets eller den unges behov utifrån den aktuella problematiken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2",
      "sentiment": 1.0,
      "quote": "Myndigheten instämmer i att det är viktigt att bibehålla en flexibilitet i hur vårdmiljön kan utformas för att tillgodose barns och ungas individuella vårdbehov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.3",
      "sentiment": 1.0,
      "quote": "Forskning stödjer att mindre enheter kan bidra till att skapa goda relationer, ett mer effektivt behandlingsarbete samt minska risken för negativa gruppdynamiker och smittoeffekter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.1",
      "sentiment": -1.0,
      "quote": "Enligt myndighetens bedömning riskerar förslaget om en lägsta ålder att öppna upp för att i större omfattning än idag placera yngre barn på institution.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.2",
      "sentiment": 0.5,
      "quote": "Socialstyrelsen är positiv till den föreslagna regleringen avseende åldersintervall, men anser att barnets eller den unges mognadsnivå kan ha betydelse för vad som är bäst för barnet även i andra situationer än ett hem med inriktning integrerad vård, exempelvis om barnet eller den unge har en intellektuell funktionsnedsättning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5.2",
      "sentiment": 0.2,
      "quote": "Myndigheten anser dock att uttrycket ”annan psykosocial problematik” ska tas bort.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.8",
      "sentiment": 1.0,
      "quote": "Socialstyrelsen tillstyrker förslaget.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a8.4",
      "sentiment": 1.0,
      "quote": "Socialstyrelsen ställer sig positiv till att myndigheten ska få i uppdrag att utreda behov av och förutsättningar för systematiska läkemedelsgenomgångar för placerade barn och unga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.4",
      "sentiment": 0.2,
      "quote": "Socialstyrelsen ser därför att förslaget till detaljreglering riskerar att medföra vissa negativa effekter, exempelvis att regionen prioriterar att upprätta individuella planer för den aktuella gruppen vilket i sin tur kan leda till undanträngningseffekter för andra som också har behov av en individuell plan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.5",
      "sentiment": -0.2,
      "quote": "Socialstyrelsen anser dock att förslaget är otydligt eftersom det inte tydligt framgår vem som är huvudman, hemregionen eller den regionen där barnet eller den unge är placerad.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.6",
      "sentiment": 0.5,
      "quote": "En risk med förslaget är att det kan leda till undanträngningseffekter i förhållande till andra grupper.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.7",
      "sentiment": 1.0,
      "quote": "Socialstyrelsen delar bedömningen att regeringen bör initiera ett utvecklingsarbete för att pröva mobila team och digitala lösningar för ökad tillgänglighet till regionens öppna hälso- och sjukvård även för barn och unga som vårdas i kommunala och privata hem för barn och unga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.6.1",
      "sentiment": 1.0,
      "quote": "Myndigheten instämmer i att ett förbyggande, långsiktigt och systematiskt arbete på alla nivåer är avgörande för en trygg och säker vårdmiljö och för att förebygga användandet av befogenheter och andra ingrepp i barns och ungas personliga integritet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.6.2",
      "sentiment": 1.0,
      "quote": "Myndigheten instämmer i vikten av att vården på hem för barn och unga är trygg och säker för de barn och unga som vistas där.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.7.1",
      "sentiment": 1.0,
      "quote": "Socialstyrelsen tillstyrker att socialnämnden, för den som vårdas med stöd av LVU vid ett hem för barn och unga, med undantag för hem för barn och föräldrar, ska kunna fatta beslut om - uppmaning till regelbunden provtagning för kontroll av nykterhet och drogfrihet, och - begränsning av användning av elektroniska kommunikationstjänster för ett barn eller en ung person som vårdas med stöd av LVU.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a9.7.3",
      "sentiment": 1.0,
      "quote": "Myndigheten instämmer i att ett formellt beslut bidrar till att stärka rättssäkerheten samt att det är svårt att hävda att ett samtycke till provtagning är frivilligt med tanke på den beroendeställning som barn och unga befinner sig i gentemot de som utövar vården.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.7.4",
      "sentiment": 0.2,
      "quote": "Myndigheten saknar dock ett resonemang eller analys om de risker som en sådan begränsning kan innebära för de andra som vårdas på hemmet, i synnerhet de som vårdas med stöd av SoL eftersom de inte kan bli föremål för ett sådant beslut.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.8.1",
      "sentiment": -0.5,
      "quote": "Myndigheten anser inte att de risker och nackdelar som förslaget kan medföra har beaktats i tillräcklig omfattning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.8.3",
      "sentiment": -0.2,
      "quote": "Däremot anser Socialstyrelsen inte att möjligheten att omhänderta otillåtna föremål ska kompletteras med befogenheter att eftersöka sådana föremål genom kroppsvisitation, eller rumsvisitation (särskilt avseende de som är placerade med stöd av SoL), då myndigheten anser att det är en alltför ingripande åtgärd i den personliga integriteten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.8.4",
      "sentiment": -1.0,
      "quote": "Myndigheten anser att den inskränkning som en kroppsvisitation innebär i barnens och de ungas privatliv inte står i proportion till åtgärdens syfte.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.8.5",
      "sentiment": -0.5,
      "quote": "Med beaktande av den inskränkning i den personliga integriteten som en rumsvisitation innebär anser myndigheten inte att det är rimligt att föreståndare, till skillnad vad som gäller för socialnämnden, även får fatta beslut om begränsningar av fri- och rättigheter för barn och unga som är placerade på frivillig grund.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.8.6",
      "sentiment": -1.0,
      "quote": "Enligt myndighetens uppfattning är det problematiskt att förslaget inte i tillräcklig grad resonerar kring hur provtagningar kan vara ett stöd i behandlingsarbetet mot ett missbruk eller begynnande missbruk.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a13.2",
      "sentiment": -1.0,
      "quote": "Socialstyrelsen bedömer att det kräver omfattande arbetsinsatser, bland annat genom det analysarbete som föregår framtagande av nya eller vidareutvecklade kunskapsstöd.",
      "quote_type": "grund"
    }
  ]
}