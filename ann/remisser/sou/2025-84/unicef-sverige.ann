    }
  },
  "overall": {
    "sentiment": 0.5,
    "quote": "UNICEF Sverige tillstyrker huvuddelen av förslagen men betonar vikten av att säkerställa barns faktiska delaktighet, återkoppling, oberoende klagomöjligheter och att bedömningar av barnets bästa tydligt dokumenteras och följs upp.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a6.2",
      "sentiment": 1.0,
      "quote": "Den nuvarande ordningen har under lång tid präglats av otydlighet kring ansvarsfördelning, bristande kvalitetssäkring och varierande praxis mellan kommuner och verksamheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": 0.5,
      "quote": "Vi anser att uppdragen bör inkludera ett tydligt barnrättsperspektiv, särskilt genom att det i framtagande av föreskrifter och allmänna råd ställs krav på bedömningar av barnets bästa enligt barnkonventionens artikel 3.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1",
      "sentiment": 0.5,
      "quote": "UNICEF Sverige är positiva till förslaget och menar att en differentiering kan skapa bättre möjligheter än idag för att vården blir mer individanpassad och att kompetensnivån kan stämmas av mot vårdbehovets allvar och komplexitet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.6",
      "sentiment": 0.2,
      "quote": "Barnets rätt att komma till tals enligt artikel 12 i barnkonventionen måste vara en integrerad del av processen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.3",
      "sentiment": 1.0,
      "quote": "Vi är positiva till utredningens förslag kring att det föreslås ett maxtak för antalet barn per enhet, och att man i framtagandet beaktat barn och ungas åsikter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": 1.0,
      "quote": "Vi är även positiva till det åldersintervall som föreslås, samt att det finns en undre åldersgräns på sju år för att ta emot barn i generella eller specialiserade hem för barn och unga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5",
      "sentiment": 1.0,
      "quote": "Ett tydligt ramverk är avgörande för att garantera en likvärdig kvalitet oavsett huvudman eller geografisk placering.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.6",
      "sentiment": 1.0,
      "quote": "personalens kompetens är direkt avgörande för vårdens kvalitet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.7",
      "sentiment": 0.5,
      "quote": "En förbättrad informationsöverföring mellan ansvariga aktörer samt en systematisk uppföljning av avvikelser är nödvändig för att brister i verksamheten ska kunna upptäckas och åtgärdas i tid.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.3",
      "sentiment": 1.0,
      "quote": "Vi är positiva till att utredningen genomgående genomsyras av ett tydligt rättighetsperspektiv som utgår ifrån barnets rätt till vård och hälsa.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4",
      "sentiment": 1.0,
      "quote": "Vi ser positivt på att tydligare reglera samverkan mellan socialnämnden i mottagande kommun och barnets hemregion för att planera vårdinsatser för barn i ett generellt eller specialiserar hem för barn och unga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5",
      "sentiment": 1.0,
      "quote": "Detta ser vi som en självklarhet utifrån principen om icke-diskriminering enligt artikel 2 i barnkonventionen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5",
      "sentiment": 0.5,
      "quote": "Vi tillstyrker den föreslagna skrivningen om att barnets bästa ska vara avgörande och att hänsyn ska tas till barnets åsikter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.7.3",
      "sentiment": 0.2,
      "quote": "Konsumtion av alkohol och droger är ett återkommande problem inom dagens HVB-vård för barn och unga och måste tas på största allvar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.7.4",
      "sentiment": 0.2,
      "quote": "Vi ser positivt på att utredningen lagt till rekvisit om att åtgärden ska vara nödvändig för att genomföra vården eller förhindra skada och det är främst utifrån detta skyddsperspektiv vi väljer att tillstyrka förslaget.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.8.4",
      "sentiment": -1.0,
      "quote": "UNICEF Sverige bedömer att den föreslagna regleringen innebär risk för slentrianmässiga eller godtyckliga tillämpningar som kan undergräva barns förtroende för personalen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.8.5",
      "sentiment": 0.5,
      "quote": "Vi anser att det utgör en mer proportionerlig och barnrättskompatibel åtgärd vid misstanke om otillåtna föremål, under förutsättning att barnets rätt till trygghet och integritet beaktas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.8.6",
      "sentiment": 0.5,
      "quote": "Åtgärden kan bidra till ökad säkerhet och tidig upptäckt av riskbruk, men kräver tydliga rutiner för dokumentation, proportionalitetsbedömning och uppföljning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.9.1",
      "sentiment": 0.5,
      "quote": "UNICEF Sverige tillstyrker förslagen och vill särskilt lyfta vikten av att den som ansvarar för samtalet försäkrar sig om informationen ges på ett sätt som anpassas efter det enskilda barnet eller den unge.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.9.3",
      "sentiment": 0.5,
      "quote": "UNICEF Sverige tillstyrker förslaget och menar att underrättelseskyldigheten är av stor vikt för att säkerställa informationsöverföring och instämmer i att skyldigheten inte bör omfatta IVO.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.9.5",
      "sentiment": 1.0,
      "quote": "UNICEF Sverige tillstyrker förslaget och vill särskilt kommentera vikten av barn och ungas reella tillgång till klagomålsmöjligheter, i linje med artikel 12 i barnkonventionen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.4.7",
      "sentiment": 0.5,
      "quote": "Det är av central betydelse att varje beslut bygger på en helhetsbedömning av alla barn som berörs i verksamheten, inte enbart de som direkt påverkas av identifierade brister.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.5",
      "sentiment": -0.5,
      "quote": "Att vid oanmäld inspektion utgå från att inte samtala med barn innebär en stor risk för att barns erfarenheter och synpunkter förbises.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14",
      "sentiment": -0.5,
      "quote": "UNICEF Sverige är kritiska till att finansieringen delvis föreslås hämtas från utgiftsområde 25 – Allmänna bidrag till kommuner.",
      "quote_type": "grund"
    }
  ]
}