  "segments": [
    {
      "forarbete_id": "a6.1",
      "sentiment": 1.0,
      "quote": "Maskrosbarn ser likt utredningen ett stort behov av en reformerad institutionsvård för att på bättre sätt möta de behov som finns hos de barn och unga som blir placerade på institution.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1",
      "sentiment": 0.5,
      "quote": "Det kan dock vara svårt att tydligt skilja på dessa två målgrupper, utifrån vår erfarenhet så har väldigt många av de barn som utvecklat egen beteendeproblematik i grunden också en dålig hemmiljö.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5",
      "sentiment": 1.0,
      "quote": "De unga vi möter vittnar om att de inte får den vård de är i behov av när de är placerade på HVB.",
