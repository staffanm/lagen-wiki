    }
  },
  "overall": {
    "sentiment": 0.5,
    "quote": "Göteborgs Stad är i huvudsak positivt till utredningens förslag och menar att de sammantaget innebär en ambitionshöjning som kan leda till en förbättrad samhällsvård för barn och unga, bättre förutsättningar efter avslutad vård, samt minska risken både för att barn och unga utsätts för och begår brott när de är i samhällsvård och efter att vården har upphört.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a7.1.4",
      "sentiment": -0.2,
      "quote": "Barn som placerats i generella hem på grund av \"brister i omsorgen\" bör inte vårdas tillsammans med barn som har en utvecklad beteendeproblematik.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.6.1",
      "sentiment": -0.2,
      "quote": "Göteborgs Stad menar att funktionshinderperspektivet inte är tillräckligt belyst i utredningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.6.3",
      "sentiment": 0.8,
      "quote": "Förslaget om krav på tillgång till psykolog vid hem för barn och unga är positivt och ett steg mot att möta de ökade vårdbehoven inom psykisk ohälsa.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.4",
      "sentiment": 0.8,
      "quote": "Ett sådant arbetssätt stärker samverkan mellan kommun och region.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.6",
      "sentiment": 0.8,
      "quote": "Göteborgs stad menar att ekonomiska incitament kan vara nödvändiga för att säkerställa att regionerna tar sitt ansvar och samverkar kring hälso- och sjukvårdsinsatser i institutionsvården.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.7.3",
      "sentiment": -0.5,
      "quote": "Enligt Göteborgs stad riskerar ett beslut om provtagning bli verkningslöst i de situationer som den som berörs inte vill medverka, utan i stället överklagar beslutet till domstol.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.8.4",
      "sentiment": 0.8,
      "quote": "Kroppsvisitation behövs således för att kunna upprätthålla säkerhet och trygghet i hemmet och skydda barn från att skadas av missbruk, kriminalitet och våld.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec102",
      "sentiment": -0.5,
      "quote": "Däremot ifrågasätts ordningen där föreståndaren ska värdera och göra sig av med omhändertagna föremål, eftersom det bedöms olämpligt och ligga utanför kommunens uppdrag i övrigt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.2",
      "sentiment": -0.5,
      "quote": "Göteborgs Stad vill dock framhålla att utredningen till viss del underskattat kostnaderna, både vad gäller ett ökat dygnspris och de utgifter som följer av övergångs- och omställningsperioden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.5",
      "sentiment": -0.5,
      "quote": "Ett stelbent system där varje hem bara får ha en inriktning riskerar att leda till fler omplaceringar, splittrade vårdkedjor, bristande kontinuitet och försämrad behandling.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.4.5",
      "sentiment": -0.2,
      "quote": "Lämplighetsprövningen inför tillstånd att bedriva HVB bör vara likvärdig oavsett huvudman: privat, idéburen eller kommunal.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.3",
      "sentiment": -0.2,
      "quote": "När det gäller antalet barn per enhet bör detta styras av vårdbehov och problemtyngd snarare än en fast siffra.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.6.1",
      "sentiment": 0.2,
      "quote": "Därför bör det införas krav på grundläggande utbildning i trauma, psykisk ohälsa och neuropsykiatriska tillstånd för all personal inom HVB och särskilda ungdomshem.",
      "quote_type": "grund"
    }
  ]
}