  "segments": [
    {
      "forarbete_id": "a6.1",
      "sentiment": 1.0,
      "quote": "SBU stödjer förslaget att införa en ny placeringsform, hem för barn och unga, med syftet att säkerställa förutsättningar för en meningsfull vård, en trygg vårdmiljö, stabilitet i vårdkedjan, stärka arbetet med att bland annat förebygga brott och andra sociala problem samt underlätta anpassning av vården till individuella behov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": 1.0,
      "quote": "SBU instämmer i utredningens bedömning om uppföljning av reformen, inte minst för framtida forskning och utveckling av placeringsformen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5",
      "sentiment": 0.5,
      "quote": "Vi vill särskilt understryka vikten av att dessa insatser utformas enligt vetenskap och beprövad erfarenhet, samt att det finns resurser och kompetens för att genomföra dem.",
