  "segments": [
    {
      "forarbete_id": "a7.1",
      "sentiment": 0.2,
      "quote": "SOS Barnbyar ser positivt på att differentiera vårdformerna och införa tydligare strukturer utifrån barnet eller den unges individuella behov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.4",
      "sentiment": -0.5,
      "quote": "Ett barn vars eget beteende inte utgör grunden för vårdbehovet bör i första hand placeras i ett familjehem, inte på institution.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.5",
      "sentiment": 0.2,
      "quote": "Således kan en mera ändamålsenlig och träffsäker vård vara ett specialiserat hem för integrerad vård, snarare än ett specialiserat hem med kriminalitet som inriktning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.3",
      "sentiment": 0.5,
      "quote": "SOS Barnbyar välkomnar en begränsning av antalet barn och unga vid en enhet på ett generellt eller specialiserat hem.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": -0.5,
      "quote": "Barn under sju år ska alltid placeras i familjehem.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5",
      "sentiment": 0.2,
      "quote": "SOS Barnbyar föreslår, för tydlighetens skull, att ”vänner” läggs till i uppräkningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.6",
      "sentiment": 0.5,
      "quote": "SOS Barnbyar ser positivt på att utredningen lägger vikt vid personlig lämplighet för en anställning vid ett hem för barn och unga samt att det ställs ett krav på minst en tvåårig eftergymnasial utbildning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8",
      "sentiment": 0.5,
      "quote": "SOS Barnbyar välkomnar därför utredningens förslag om införandet av mera detaljerade bestämmelser på området och ser således positivt på en ny bestämmelse i 10 kap socialtjänstlagen liksom den föreslagna nya bestämmelsen i 8 kap hälso- och sjukvårdslagen om upprättandet av en individuell plan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5",
      "sentiment": 0.2,
      "quote": "Dock anser vi att det behövs ett klargörande i vilket stöd barnet har rätt till och vilket ansvar som åläggs hemmet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9",
      "sentiment": 0.2,
      "quote": "SOS Barnbyar anser att utredningens förslag kopplat till befogenheter har balanserats med sådana tydliga rättssäkerhetsgarantier.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.8.4",
      "sentiment": -0.5,
      "quote": "Förslagsvis bör misstanken uppnå graden av ”skälig misstanke” för att en sådan åtgärd ska kunna äga rum.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec92",
      "sentiment": -1.0,
      "quote": "SOS Barnbyar är av uppfattningen att paragrafens lydelse snarare signalerar att fysiska ingripanden är en tillämpbar befogenhet trots att så inte är fallet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.4",
      "sentiment": 0.2,
      "quote": "Därmed bör tillståndsprövningen inför öppnandet av ett hem för barn och unga vara densamma oavsett om den drivs i privat eller kommunal regi.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.5",
      "sentiment": 0.5,
      "quote": "SOS Barnbyar välkomnar att utredningen vill stärka IVO:s tillsynsansvar som bl.a. innebär att inspektioner ska ske minst två gånger per år samt att det tydligt regleras vad som ska kontrolleras.",
      "quote_type": "grund"
