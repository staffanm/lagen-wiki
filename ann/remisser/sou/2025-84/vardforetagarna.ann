    },
    {
      "forarbete_id": "a9.7",
      "sentiment": 1.0,
      "quote": "Vårdföretagarna välkomnar utredningens förslag om tydlig fördelning av ansvar och mandat mellan socialnämnden respektive den enskilda verksamheten.",
