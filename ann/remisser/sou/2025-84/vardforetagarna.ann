    },
    {
      "forarbete_id": "a9.6.2",
      "sentiment": 1.0,
      "quote": "Vårdföretagarna tillstyrker förslaget om att barnet eller den unge skall erbjudas ett uppföljande samtal efter ett fysiskt ingripande.",
