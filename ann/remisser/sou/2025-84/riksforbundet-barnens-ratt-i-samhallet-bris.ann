    },
    {
      "forarbete_id": "a7.1",
      "sentiment": 0.5,
      "quote": "Bris ser därför positivt på utredningens förslag om ökat inslag av differentiering i vården, med syfte att säkerställa att barn får vård som är bättre anpassad till deras individuella förutsättningar och behov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.2",
      "sentiment": 0.2,
      "quote": "Det är viktigt att undvika att den generella kategorin blir alltför bred och riskerar att fungera som en ”slasktratt” för barn med olika och komplexa behov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.3",
      "sentiment": 1.0,
      "quote": "i linje med barns egna synpunkter i utredningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": 0.5,
      "quote": "forskning visar att institutionsvård sällan är fördelaktig för yngre barn.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.6",
      "sentiment": 0.5,
      "quote": "För att reformen ska leda till tryggare hem för barn är personalen avgörande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8-2",
      "sentiment": 1.0,
      "quote": "Barn som vårdas utanför det egna hemmet har betydligt fler hälsoproblem och större behov av hälso- och sjukvård än andra barn.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5.3",
      "sentiment": 0.5,
      "quote": "avsaknaden av tydliga ramar där personalens befogenheter är en del idag kan skapa otrygghet, både för barn och personal.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.6.2",
      "sentiment": -1.0,
      "quote": "I praktiken innebär det att man inför en underrättelseskyldighet för något som inte anses vara en befogenhet i lagen, vilket riskerar att skapa än större otydlighet för personalen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.7",
      "sentiment": 1.0,
      "quote": "avgörande att befogenheterna inte används för att bestraffa barn, utan endast när det är nödvändigt för att kunna ge bästa möjliga vård.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.8",
      "sentiment": 1.0,
      "quote": "Barn har själva uttryckt att otryggheten på institutioner ofta hänger samman med förekomsten av bland annat droger.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10",
      "sentiment": 1.0,
      "quote": "Tillsynen är en avgörande komponent för att säkerställa att institutionsvården håller hög och jämn kvalitet samt att barns rättigheter tillgodoses.",
