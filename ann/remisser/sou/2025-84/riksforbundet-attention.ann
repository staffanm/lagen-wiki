  "segments": [
    {
      "forarbete_id": "sec13",
      "sentiment": 0.8,
      "quote": "Vi bedömer att detta kan göra nödvändiga placeringar mer trygga, säkra och kunskapsbaserade.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.3",
      "sentiment": 0.8,
      "quote": "Utredningen påpekar också att den nuvarande ansvarsfördelningen mellan kommun och region inte fungerar tillfredsställande, vilket i vissa fall innebär att barn i institutionsvård nekas vård eller får vård utan att det finns ett tydligt medicinskt ansvar, vilket medför risker för bristande rättssäkerhet och vårdkvalitet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec22",
      "sentiment": 0.5,
      "quote": "Utredningen kommer fram till samma sak som vi gjorde i vårt Arvsfondsprojekt ”Ung dialog” det vill säga att kompetensen hos de anställda är för låg och att det leder till att barn och unga alldeles för ofta utsatts för våld, kränkningar och övergrepp i form av otillåtna tvångsåtgärder.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec24",
      "sentiment": -0.2,
      "quote": "Vi ser allvaret i dessa frågor men vill lyfta att det finns stora risker med att tillämpa inskränkningar för barn och unga med neuropsykiatriska funktionsnedsättningar (NPF).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec32",
      "sentiment": -0.5,
      "quote": "För många barn och unga med NPF är mobil och dator inte bara underhållning, utan centrala verktyg för kommunikation, struktur, tillgänglighet och känsla av social tillhörighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec34",
      "sentiment": -0.5,
      "quote": "Ofta finns en stark känslomässig anknytning till föremål som används för att skapa trygghet eller struktur i vardagen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3.1",
      "sentiment": 0.8,
      "quote": "Ett sådant ramverk bedömer vi vara avgörande för att skapa en mer enhetlig och rättssäker vård över hela landet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.2",
      "sentiment": 0.8,
      "quote": "Attention ser mycket positivt på att utredningen poängterar att förslaget ska ses som en ambitionshöjning för kvaliteten på vården vid hem för barn och unga och kommer att medföra ökade kostnader.",
      "quote_type": "grund"
    }
