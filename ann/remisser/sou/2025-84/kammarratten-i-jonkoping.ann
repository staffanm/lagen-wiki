  "overall": {
    "sentiment": -0.3,
    "quote": "Kammarrätten har, utifrån de aspekter domstolen har att beakta, följande synpunkter att lämna avseende betänkandet.",
    "quote_type": "standpunkt"
  },
  "segments": [
    {
      "forarbete_id": "sec668",
      "sentiment": -0.5,
      "quote": "Med hänsyn till den oklarhet som verksamheterna själva belyser i detta avseende, ser kammarrätten en risk med att handlingsutrymmet för fysiska ingripanden inte tydliggörs.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec111",
      "sentiment": -0.2,
      "quote": "I det sammanhanget vill kammarrätten särskilt betona vikten av att överväga att i den föreslagna lagen införa en bestämmelse med krav på motivering av beslut som fattas av föreståndaren (jfr 32 § förvaltningslagen).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec112",
      "sentiment": -0.2,
      "quote": "Det kan finnas praktiska skäl, såväl för den unge som för domstolarna, med att överväga en ordning där forumfrågan styrs av vilken som är placerande socialnämnd, även då det är föreståndaren som fattat beslutet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec112",
      "sentiment": -0.2,
      "quote": "Enligt kammarrättens mening finns det skäl att överväga om förvaltningsrätten vid prövning av överklagande av vissa beslut enligt den föreslagna lagen ska vara domför med en lagfaren domare ensam, på samma sätt som vid prövning av överklagande av vissa beslut enligt LVU som fattas av SiS (jfr 18 § LAFD).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec737",
      "sentiment": 1.0,
      "quote": "Kammarrätten tillstyrker förslaget om att nämndemän inte ska ingå i kammarrätten",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec112",
      "sentiment": -0.2,
      "quote": "Även med hänsyn till det bedömer kammarrätten att det finns skäl att överväga krav på skyndsam handläggning, just eftersom det är fråga om inskränkande åtgärder som dessutom riktas mot barn och unga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14",
      "sentiment": -0.5,
      "quote": "Kammarrätten bedömer att det behövs en närmare analys avseende förslagens ekonomiska följder för domstolarna.",
      "quote_type": "grund"
    }
  ]
