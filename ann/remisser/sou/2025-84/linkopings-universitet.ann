  "segments": [
    {
      "forarbete_id": "a6.2",
      "sentiment": 1.0,
      "quote": "Att särskilja de olika boendeformerna är särskilt positivt utifrån ett barnperspektiv.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1",
      "sentiment": 0.5,
      "quote": "Det finns också en fara att differentieringen kommer att skapa stuprör som barn och unga inte passar in i.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5",
      "sentiment": -0.2,
      "quote": "Utan tydlighet i respektive huvudmans ansvar riskerar barn med behov av både sociala insatser och psykiatriska insatser att få fel och missriktade insatser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": 0.5,
      "quote": "Utredningen nämner att det bör vara ett uttalat nationellt mål att minska institutionsplaceringar för gruppen 8-12 år vilket Barnafrid tillstyrker.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.6",
      "sentiment": 0.2,
      "quote": "Om gränsdragningen inte är tydligt kan det leda till att barn och unga inte får det stöd de behöver.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5.3",
      "sentiment": -0.2,
      "quote": "Detta för att förhindra att personal riskerar att göra för lite, eller för mycket.",
