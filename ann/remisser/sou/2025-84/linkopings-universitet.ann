    },
    {
      "forarbete_id": "a8.4",
      "sentiment": 0.5,
      "quote": "Det kommer behövas ett incitament för regionerna att prioritera en samlad hälso- och vårdbedömning av dessa barn och unga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.6",
      "sentiment": 1.0,
      "quote": "Barnafrid ser att förslaget kan skapa förutsättningar att förhindra att barn utsätts för våld eller annan kränkande behandling inom ramen för sin placering.",
