  "overall": {
    "sentiment": 0.5,
    "quote": "Rädda Barnen tror och hoppas att de förslagna reformerna ska bli första viktiga steg mot en tryggare och säkrare institutionsvård för barn, som ska ha ett större fokus på ändamålsenlig vård och behandling, än på förvaring.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a6.2.2",
      "sentiment": 1.0,
      "quote": "Rädda Barnen tillstyrker förslaget om en ny placeringsform – Hem för barn och unga, som syftar till att ge ett tydligare fokus på vård, och som enbart gäller barn och unga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": 0.5,
      "quote": "Detta då flera utredningar, rapporter och granskningar visar på stora brister och missförhållanden i hur SiS tillämpar särskilda befogenheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1",
      "sentiment": 0.2,
      "quote": "En stor del av de barn som vårdas utanför hemmet har komplexa vårdbehov och kan vara behov av flera typer av specialiserad vård samtidigt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.2",
      "sentiment": 0.5,
      "quote": "Rädda Barnen vill särskilt lyfta vikten av att samtliga kategorier av hem samt även specialiseringar måste göras tillgängliga över hela landet, för att säkerställa att det finns hem som kan tillgodose barns vårdbehov inom rimliga avstånd från barns hemkommuner.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.3",
      "sentiment": 1.0,
      "quote": "Rädda Barnen bedömer att det är viktigt att i lag reglera hur många barn som är maximalt för en och samma enhet för institutionsvård, och bedömer det som att sex barn per enhet är en väl avvägd begränsning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.1",
      "sentiment": 0.5,
      "quote": "Rädda Barnen tillstyrker förslaget och delar utredningens bedömning att institutionsvård sällan är det alternativ som bäst motsvarar yngre barns vårdbehov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.2",
      "sentiment": 1.0,
      "quote": "Rädda Barnen anser det vara en väl avvägd bedömning och som en viktig differentiering i vården mellan olika enheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5",
      "sentiment": 1.0,
      "quote": "För att säkerställa rättssäkerhet och proportionalitet till denna insats behöver placeringen fyllas med vård som kan matcha barnets vårdbehov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.6.1",
      "sentiment": 1.0,
      "quote": "Rädda Barnen delar bedömningen att personalens kompetens och lämplighet är avgörande för att vården för barn och unga ska lyckas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.6.4",
      "sentiment": 0.5,
      "quote": "Rädda Barnen tillstyrker utredningens förslag om reglering av personaltäthet, men hade önskat en ännu skarpare reglering för att undvika ensamarbete, som av många aktörer, exempelvis fackförbundet Vision, lyfts som en riskfaktor i hvb-vården.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.6.3",
      "sentiment": -0.2,
      "quote": "Rädda Barnen tillstyrker delvis förslaget, men bedömer skrivningen som alltför binär, där för stort fokus handlar om tillgången till en psykolog (som inte heller är specificerad hur omfattande den ska vara).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.4",
      "sentiment": 0.2,
      "quote": "Rädda Barnen hade önskat en reglering där det även regleras om uppföljande möte av planen inom exempelvis 3 månader efter upprättandet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.6.2",
      "sentiment": -0.5,
      "quote": "Rädda Baren anser här att en underrättelse- och dokumentationsskyldighet inte blir klargörande för personal kring handlingsutrymme, utan kan i stället skapa ytterligare oklarhet och risker att det tolkas som att det finns möjlighet att ingripa fysiskt som en särskild befogenhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.7",
      "sentiment": 0.5,
      "quote": "Rädda Barnen vill understryka att det är av högsta vikt att dessa befogenheter endast får användas om det går i linje med barnets vårdbehov, och inte som ett att bestraffa barn.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.8",
      "sentiment": 0.5,
      "quote": "Särskilt kroppsvisitation är en integritetskränkande åtgärd, och det är av största vikt att åtgärden används restriktivt och på ett sätt som skapar trygghet och förutsägbarhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.8.4",
      "sentiment": -0.2,
      "quote": "Rädda Barnen förstår resonemanget men vill lyfta en oro över att ett allt för stort ansvar läggs på det enskilda barnet, som ofta kan ha svårt att freda sig och kräva sin rätt i det utsatta läge som en kroppsvisitation innebär, och den maktobalans som det innebär att vårdas på institution.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10",
      "sentiment": 0.5,
      "quote": "För att den striktare regleringen om tillsyn ska ge effekt i kvaliteten på vården för barn och unga, måste även det tillförsäkras att IVO har förutsättningar att utföra sitt uppdrag.",
      "quote_type": "grund"
    }
  ]
