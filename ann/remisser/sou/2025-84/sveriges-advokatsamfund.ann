  "segments": [
    {
      "forarbete_id": "sec88",
      "sentiment": 1.0,
      "quote": "Det är positivt att bestämmelsen i 2 § klargör att vad som är bäst för barnet eller den unge, ska vara avgörande vid beslut eller åtgärder enligt lagen samt att det av andra meningen särskilt framgår att hänsyn ska tas till barnets eller den unges åsikter vid bedömningen av barnets eller den unges bästa.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec89",
      "sentiment": 0.5,
      "quote": "Med beaktande av att lagen innehåller särskilda befogenheter vid Hem för barn och unga, är det nödvändigt att bestämmelsen i 3 § klargör att åtgärder enligt lagen endast får användas om de står i rimlig proportion till sitt syfte.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec93",
      "sentiment": 0.2,
      "quote": "Detta skulle annars i realiteten kunna innebära en form av umgängesbegränsning, som begränsar barnets rätt till privat- och familjeliv i enlighet med vad som stadgas i EKMR.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec95",
      "sentiment": -0.2,
      "quote": "Det är dock oklart vad som avses med ”särskild anledning” och det föreligger därmed risk för godtycklighet i tillämpningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec96",
      "sentiment": -1.0,
      "quote": "Enligt Advokatsamfundet riskerar följderna av betänkandets förslag i denna del att bli oproportionerliga och det är inte rimligt att barn och unga som vårdas enligt LVU eller SoL riskerar att drabbas av inskränkningar som är att jämföra med de restriktioner som åläggs för häktade personer eller unga som vårdas på SiS särskilda ungdomshem.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec103",
      "sentiment": -1.0,
      "quote": "Enligt Advokatsamfundet är det tveksamt om ändamålet med dessa åtgärder står i proportion till det intrång det innebär för barnet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec104",
      "sentiment": -1.0,
      "quote": "Enligt Advokatsamfundet är det tveksamt om ändamålet med dessa åtgärder står i proportion till det intrång det innebär för barnet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec98",
      "sentiment": -0.5,
      "quote": "Den föreslagna ordningen innebär att man ger dessa privata aktörer mycket långtgående befogenheter som normalt sett anförtros åt företrädare för staten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec108",
      "sentiment": 0.5,
      "quote": "Det är av stor vikt att barnet vid informerande samtal får tydlig information om anledningen till beslutet, information om rätten att överklaga, liksom rätten till offentligt biträde.",
