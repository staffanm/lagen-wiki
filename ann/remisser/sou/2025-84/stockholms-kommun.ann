  "segments": [
    {
      "forarbete_id": "a6.2",
      "sentiment": 1.0,
      "quote": "Genom att uppdragen specificeras och placeringar styrs utifrån behov, risknivå, kön och ålder kan mer individanpassad, ändamålsenlig och effektiv vård säkerställas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5",
      "sentiment": 0.2,
      "quote": "Utredningen klargör vilka befogenheter som gäller för LVU-vård, men motsvarande frågor för barn som vårdas enligt SoL är inte tillräckligt belysta.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec668",
      "sentiment": 1.0,
      "quote": "En sådan reglering kan bidra till ökad trygghet och säkerhet, samtidigt som risker för överanvändning kan motverkas genom kompetenshöjande insatser och underrättelseskyldighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.6",
      "sentiment": 1.0,
      "quote": "Genom att stärka kompetensen kan vårdmiljön bli tryggare och risken för brister i omsorg, otrygghet och övergrepp minska.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4",
      "sentiment": 1.0,
      "quote": "Individuella vårdplaner, mobila team och förbättrad samverkan kan skapa bättre kontinuitet i vården och minska risken för att barns behov faller mellan olika huvudmän.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.5",
      "sentiment": 1.0,
      "quote": "Detta bedöms nödvändigt för att uppnå en mer enhetlig och rättssäker vård över hela landet samt för att motverka variationer i praxis och kvalitet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.1",
      "sentiment": 1.0,
      "quote": "Förskoleförvaltningen instämmer i detta, och menar att institutionsvård av så pass unga barn bör undvikas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec88",
      "sentiment": 0.5,
      "quote": "En vårdmiljö där barn upplever att de blir lyssnade på bidrar både till ökad tillit, stärkt behandlingseffekt och minskad risk för upplevelser av maktlöshet eller kränkning.",
