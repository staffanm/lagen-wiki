  "segments": [
    {
      "forarbete_id": "a6.2",
      "sentiment": 1.0,
      "quote": "Vi delar bilden av att det är viktigt att barn och unga får en egen särskild placeringsform då denna grupp är mest oskyddad och utsatt.",
