    },
    {
      "forarbete_id": "a6.3",
      "sentiment": 0.5,
      "quote": "Vi vill lyfta att det finns behov av en sammanhållen granskning från tillsynsmyndighet och upphandlande organisationer för att göra det både mer kvalitativt och mer effektivt än dagens system.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1",
      "sentiment": 0.2,
      "quote": "Dock ser vi utmaningar i genomförande eftersom det ofta råder en blandproblematik hos barn och unga som är i behov av denna typ av stöd och omsorg.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.5",
      "sentiment": 0.2,
      "quote": "konsekvenserna kan innebära stora svårigheter för socialtjänsten att hitta platser inom specialiserade hem för barn och unga, framför allt då man även kopplar på ett snävt åldersintervall samt en stram lämplighetsbedömning.",
