    },
    {
      "forarbete_id": "a9.10",
      "sentiment": -0.5,
      "quote": "Det är inte alltid för barnets bästa att umgänge och kontakt kommer till stånd i de fall föräldrar eller vårdnadshavare utsatt barnet eller den unga för våld.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10",
      "sentiment": -0.2,
      "quote": "En sådan begränsning är nödvändig för att säkerställa att föreståndaren har tillräcklig kompetens, närvaro och kontroll över den verksamhet som bedrivs.",
