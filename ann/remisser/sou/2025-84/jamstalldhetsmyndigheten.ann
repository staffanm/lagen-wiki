  "overall": {
    "sentiment": 0.5,
    "quote": "Jämställdhetsmyndigheten tillstyrker utredningens övergripande förslag att reformera institutionsvården för barn och unga. Vi anser samtidigt att arbetet ska genomföras med en fördjupad jämställdhetsanalys och ett starkt barnrättsperspektiv, samt att kunskapen om mäns våld mot kvinnor, våld i nära relationer, hedersrelaterat våld och förtryck, sexuella övergrepp och exploatering bör förtydligas och stärkas inom samtliga hem för barn och unga.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a6.2",
      "sentiment": 0.5,
      "quote": "Att den övergripande inriktningen på verksamhetens arbete med barn och unga ska regleras skapar bättre möjligheter för att säkerställa trygg, säker och kvalitativ vård för barn och unga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.3",
      "sentiment": 0.5,
      "quote": "Jämställdhetsmyndigheten anser emellertid att en sådan uppgift bör omfatta alla typer av hem för barn och unga, inte enbart specialiserade hem eftersom våldsutsatta barn och unga och de som har utsatts för grooming från kriminella gäng eller sexuell exploatering även kan placeras utanför specialiserade hem.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1",
      "sentiment": 0.2,
      "quote": "Det är en brist att utredningen framför allt fokuserar på eftervård för barn och unga som placeras på grund av brottsligt beteende eller risk för brottsligt beteende.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": 0.0,
      "quote": "vill understryka vikten av att barn under 13 år endast i undantagsfall och vid särskilda skäl bör placeras vid hem för barn och unga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.5",
      "sentiment": 0.2,
      "quote": "Vi anser emellertid att utredningen inte i tillräcklig utsträckning lyfter våldsutsatthet eller problematiserar kring kontakt med familj och närstående.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.6",
      "sentiment": 0.2,
      "quote": "anser att förslagen till stor del saknar krav på våldskompetens.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.7",
      "sentiment": 1.0,
      "quote": "Tidigare undersökningar visar att barn och unga som avviker från vård ofta utsätts för sexuell exploatering, våld och andra former av övergrepp.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.8",
      "sentiment": 0.5,
      "quote": "Det förekommer att förövare eller personer som utnyttjar barn och unga söker upp dem på dessa boenden, vilket ytterligare motiverar behovet av att kunna vidta skyddsåtgärder.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4",
      "sentiment": 1.0,
      "quote": "Då kan ett oberoende och neutralt möte möjliggöra att barn och unga i samhällsvård får tillgång till den vård och det stöd de behöver.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5.6",
      "sentiment": 1.0,
      "quote": "Fungerande skolgång är en av de viktigaste skyddsfaktorerna för barn och unga i samhällsvård.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5.2",
      "sentiment": 0.2,
      "quote": "Särskilda befogenheter i hem för barn och unga är förknippade med risker, särskilt för flickor och unga kvinnor.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.6.1",
      "sentiment": 1.0,
      "quote": "Utifrån den våldsutsatthet som rapporterats vid HVB från både andra placerade och personal är det av särskild vikt att trygghet och säkerhet i hemmen upprätthålls.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.6.2",
      "sentiment": 1.0,
      "quote": "Skyldigheten är viktig då den kan få normerande effekt i hemmen och stärker rättssäkerheten för barn och unga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.7",
      "sentiment": -0.2,
      "quote": "En möjlighet att inskränka barns och ungas, särskilt flickors och unga kvinnors, tillgång till elektronisk utrustning kan medföra att det blir svårare för familj, släkt, våldsutövare eller personer som har i syfte att exploatera den unge att kontakta eller kontrollera det placerade barnet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.8.4",
      "sentiment": -0.2,
      "quote": "Kroppsvisitation kan även förstärka eller skapa nya trauman för bland annat våldsutsatta barn och unga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.9.2",
      "sentiment": -0.5,
      "quote": "Mot bakgrund av den utsatthet som barn och unga i samhällsvård ofta upplevt är det viktigt att barn och unga får tydlig och begriplig information om beslut om inskränkande åtgärder inför beslut av föreståndare.",
