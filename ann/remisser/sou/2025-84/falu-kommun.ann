    },
    {
      "forarbete_id": "a7.2",
      "sentiment": -0.2,
      "quote": "Detta då det annars finns en risk för att regleringens intentioner kan kringgås med personal som rör sig mellan boendeenheter i direkt anslutning till varandra.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.2",
      "sentiment": -0.2,
      "quote": "Gällande åldersintervallen ser Falu kommun en viss risk att ett för snävt åldersintervall begränsar möjligheten att få en förutsägbar och sammanhållen vårdkedja för vissa barn.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.1",
      "sentiment": -0.5,
      "quote": "Falu kommun ser dock vissa risker med förslaget då det riskerar att medföra avsaknad av adekvata boendelösningar när små barn trots allt behöver placeras i ett hem och familjehem inte är en tillräcklig åtgärd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4",
      "sentiment": 0.5,
      "quote": "Falu kommun bedömer att utredningens förslag innehåller flera viktiga och avgörande delar för att förbättra vård och behandling för barn och unga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.5.6",
      "sentiment": 1.0,
      "quote": "Gällande utredningens förslag kring utbildning tillstyrker kommunen de föreslagna åtgärderna.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a9.7.4",
      "sentiment": 0.2,
      "quote": "Utöver de åtgärder som föreslås bedömer Falu kommun att det vore av vikt att socialnämnden kan besluta om användningsbegränsningar avseende elektroniska kommunikationstjänster - även i ärenden där placeringsbesluten är fattade med stöd av socialtjänstlagen.",
