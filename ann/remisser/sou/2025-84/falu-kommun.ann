  "segments": [
    {
      "forarbete_id": "a6.2.2",
      "sentiment": 1.0,
      "quote": "Falu kommun delar bedömningen av att det är positivt att det införs en egen insats för barn och unga genom att avveckla HVB-hem och istället inrätta Hem för barn och unga.",
