  "overall": {
    "sentiment": 0.5,
    "quote": "Umeå kommun ser övervägande positivt på förslagen och välkomnar en mer differentierad vård för barn och unga.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a6.2",
      "sentiment": 0.8,
      "quote": "Det är efterlängtat med en mer differentierad vård vid HVB och Umeå kommun anser att de föreslagna kategorierna för HBU är lämpliga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4",
      "sentiment": 0.5,
      "quote": "Att åldersintervallen snävas åt är något som barn och unga efterfrågat enligt utredningen och något vi tror kan bidra till att förbättra tryggheten för många.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.3",
      "sentiment": 0.5,
      "quote": "Vi tror dock att det kommer bidra till ökad kvalitet på vården och i längden även kunna bidra till färre avbrott i placeringar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.6",
      "sentiment": 0.5,
      "quote": "Att höja kompetenskraven för personal och kräva tillgång till psykolog på varje HBU ser vi också som positivt av samma anledningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.4",
      "sentiment": 0.5,
      "quote": "Det är viktigt att det blir tydligt vilka HBU som finns och vilka målgrupper de placerar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.6.3",
      "sentiment": 0.8,
      "quote": "Vi tror att den stora majoriteten av dem som vårdas på HVB har behov av psykolog till exempel för utredning, bedömning och/eller samtalsstöd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.8.3",
      "sentiment": 0.8,
      "quote": "personalen saknar möjlighet att i ett senare skede till exempel söka igenom en väska vid misstanke om innehav av narkotika eller vapen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.7.4",
      "sentiment": 0.2,
      "quote": "viktigt att i vissa fall kunna begränsa användandet av elektronisk kommunikation för att barn och unga inte ska kunna delta i kriminell verksamhet eller prostitution inifrån hemmet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.6.2",
      "sentiment": 0.8,
      "quote": "Även om plikten att informera socialtjänsten vid användande av tvångsåtgärder kan innebära ökad administration ser vi informationsplikt som en nödvändighet utifrån ett rättssäkerhetsperspektiv.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.2",
      "sentiment": 0.2,
      "quote": "Att den statliga finansieringen blir tillräcklig är dock grundläggande för att kommunerna och övriga aktörer ska kunna göra ambitionshöjningen till verklighet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.1.5",
      "sentiment": 0.5,
      "quote": "Hem för barn och unga med inriktning mot unga kriminella ska i första hand drivas i offentlig regi för att säkra verksamhetens vård från påverkan av gängkriminalitet och organiserad brottslighet.",
      "quote_type": "grund"
    }
