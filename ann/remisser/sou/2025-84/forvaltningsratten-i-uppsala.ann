    },
    {
      "forarbete_id": "sec919",
      "sentiment": 0.5,
      "quote": "Förvaltningsrätten anser dock att det i sådana beslut är av vikt att det tydligt motiveras varför beslutet varit så brådskande att ett beslut av socialnämnden inte har kunnat avvaktas.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec741",
      "sentiment": 0.0,
      "quote": "Förvaltningsrätten anser att frågan om vårdnadshavares talerätt bör analyseras vidare i det fortsatta lagstiftningsarbetet.",
