  "overall": {
    "sentiment": 0.5,
    "quote": "Vår sammanfattande bedömning är att utredningens betänkande lägger en viktig grund för en tryggare vård av barn och unga.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a7.1.2",
      "sentiment": 0.5,
      "quote": "Att barn och unga med vitt skilda vårdbehov idag kan placeras på samma HVB är ett problem.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.2",
      "sentiment": 1.0,
      "quote": "Fremia och Famna tillstyrker utredningens förslag om reglering i socialtjänstförordningen om att vårdmiljön vid hem för barn och unga ska utformas utifrån barnens vårdbehov och ålder.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a7.3",
      "sentiment": 0.5,
      "quote": "Vi delar uppfattningen att en reglering av antalet platser kan bidra till ökad trygghet och bättre förutsättningar för vård och behandling.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.4.2",
      "sentiment": 0.5,
      "quote": "Vi ser därför att ett snävare åldersintervall underlättar möjligheterna att möta målgruppens behov och skapa en trygghet bland barn och unga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.6.1",
      "sentiment": 0.2,
      "quote": "När det gäller föreståndarens kompetens delar vi den bild som i utredningen ges uttryck för av företrädare för verksamheter, att det kan vara svårt att hos IVO få en föreståndare godkänd och att IVO:s bedömningar upplevs som godtyckliga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.6.2",
      "sentiment": -0.5,
      "quote": "Vi bedömer det som en oproportionerlig åtgärd då det förefaller osannolikt att dessa uppgifter kommer ligga till grund för några omedelbara bedömningar hos IVO.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.9.4",
      "sentiment": 0.5,
      "quote": "Fremia och Famna tillstyrker förslaget, eftersom det handlar om åtgärder som griper in i den enskildes integritet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.4.1",
      "sentiment": 1.0,
      "quote": "Vi ser det som en förutsättning för att de skärpningar av regelverket som utredningen föreslår får genomslag i praktiken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.4.2",
      "sentiment": -1.0,
      "quote": "Vi bedömer att det skulle innebära en betydande ökning av administrativa bördor för seriösa aktörer att tidsbegränsa tillstånden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.4.3",
      "sentiment": 0.2,
      "quote": "Det är en arbetsgivarfråga som inte hör hemma i tillståndsgivningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.4.5",
      "sentiment": 1.0,
      "quote": "Det är viktigt för att förhindra att oseriösa aktörer inte tar över verksamhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.5.1",
      "sentiment": 1.0,
      "quote": "Frekvenstillsyn och att en del av dessa besök sker oanmälda är viktigt mot bakgrund av att barn och unga placerade i samhällets vård befinner sig i en särskilt utsatt situation.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.5.2",
      "sentiment": 0.2,
      "quote": "Däremot anser vi inte att antalet årsarbetskrafter är adekvat i tillståndsprövningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a14.2.5",
      "sentiment": -0.5,
      "quote": "Tvärtom ser vi en risk att mindre verksamheter får det svårt att klara ekonomin.",
      "quote_type": "grund"
