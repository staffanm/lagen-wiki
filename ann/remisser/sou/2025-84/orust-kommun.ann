  "segments": [
    {
      "forarbete_id": "a7.1.2",
      "sentiment": 1.0,
      "quote": "Förslaget om tre kategorier av hem: hem för barn och föräldrar, generella hem för barn och unga samt specialiserade hem erbjuder efterfrågad flexibilitet som kan bidra till att barn och unga får rätt stöd utifrån sina individuella behov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5.2",
      "sentiment": 1.0,
      "quote": "Ökad fokus på en individbaserad vård och utökade befogenheter för personal är positivt för att höja kvaliteten och säkerheten inom vården.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.2.2",
      "sentiment": -0.2,
      "quote": "Vi anser att utredningen bör stärka kravet på barnkonsekvensanalyser vid implementering av nya regler och beslut som påverkar barn, i enlighet med FN:s barnkonvention artikel 3 och rekommendationer från Barnombudsmannen och BRIS.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.6.1",
      "sentiment": -0.2,
      "quote": "Det behöver finnas tydliga krav på att personal och verksamheter besitter specialiserad kompetens och arbetar utifrån ett barnrättsperspektiv, särskilt när barn har utsatts för våld eller andra trauman.",
