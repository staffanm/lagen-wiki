      "artifact:forarbete/sou/2025-80": "0f5374337faed5136e8a5c3416e919fd4ee23de95d3d23f8c36dd3bd674b8d62"
    }
  },
  "overall": {
    "sentiment": 0.5,
    "quote": "Domstolen tillstyrker i huvudsak förslaget men anser att det behövs vissa förtydliganden för att underlätta lagtillämpningen.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a16.6",
      "sentiment": -0.5,
      "quote": "Det skulle strida mot principen om lantmäterimyndighetens utredningsplikt som en gång tillkom i syfte att skapa en förrättningsprocess som är effektivare än en domstolsprocess (prop. 1969:128).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a20.1",
      "sentiment": -0.2,
      "quote": "Med den av utredningen föreslagna lagregleringen blir den bristen prekär.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.5",
      "sentiment": -0.2,
      "quote": "Detta kommer inte enbart ge förenklingar och tidsvinster, utan även ett i förväg svårbedömt tillskott av aktörer och moment i processerna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.1",
      "sentiment": -0.2,
      "quote": "Som framgår av betänkandet kan koordinatbestämda gränser dock varken rubbas av naturen eller genom människlig påverkan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.5.3",
      "sentiment": 0.5,
      "quote": "Möjlighet att företa särskild koordinatbestämning inom ramen för en förrättning enligt ledningsrättslagen bör regleras i dessa bestämmelser.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.1",
      "sentiment": -0.2,
      "quote": "Denna föreslagna formulering för (liksom den hittills gällande formuleringen) felaktigt tankarna till en förändring av fastighetsindelningen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.2",
      "sentiment": -0.2,
      "quote": "En fastighetsgräns kan nämligen aldrig koordinatbestämmas med stöd av den föreslagna 27 b §.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.6.5",
      "sentiment": -0.2,
      "quote": "Utredningens avsikt att stävja otillbörlig marköverlåtelse genom överenskommelse om koordinatbestämning, bör regleras genom att det (förslagsvis i 14 b kap. 8 § 6 FBL) föreskrivs att överenskommelsen inte ska godkännas av lantmäterimyndigheten om den innehåller en klausul om ersättning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.3.2",
      "sentiment": 1.0,
      "quote": "Detta tillstyrks mycket bestämt pga. domstolens erfarenheter av mål de senaste åren.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.3.3",
      "sentiment": 1.0,
      "quote": "Tvångsmedel ska tillämpas restriktivt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a25-2",
      "sentiment": -0.2,
      "quote": "Denna hänvisning är felaktig.",
      "quote_type": "grund"
    }
  ]
}