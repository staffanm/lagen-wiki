  "segments": [
    {
      "forarbete_id": "a14.4",
      "sentiment": 0.5,
      "quote": "Det är viktigt att rättssäkerheten och egendomsskyddet upprätthålls och att det måste vara lantmäterimyndighetens ansvar att bedöma om gränsens rätta sträckning kan säkerställas med den noggrannheten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.5.1",
      "sentiment": 0.5,
      "quote": "Det behöver klart framgå vad som avses med rättsligt klar och entydig gräns.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.5.2",
      "sentiment": -0.5,
      "quote": "En gräns som inte är lagligen bestämd kan aldrig anses vara rättsligt entydig oavsett hur väl hävdad den bedöms vara.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.5.3",
      "sentiment": 0.5,
      "quote": "Vi anser dock att det finns en risk att fastighetsägare vars gränsmarkeringar försvinner vid ledningsarbeten själva behöver betala för en särskild gränsutmärkning om ledningshavaren bara ansöker om koordinatbestämning och inte tillhörande markering.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.5.4",
      "sentiment": -1.0,
      "quote": "Vi bedömer att det skulle innebära betydande rättsosäkerhet att frångå fastighetsbestämningsinstitutet genom att göra det möjligt att definiera en otydlig gräns genom koordinatbestämning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.5.5",
      "sentiment": -1.0,
      "quote": "En uppdelning av lantmäteriåtgärderna mellan olika lagstiftning och olika handläggningsregler skulle krångla till lantmäteriförfarandet, då det i vissa fall krävs flera olika åtgärder i ett och samma ärende.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a16.6",
      "sentiment": -1.0,
      "quote": "Vi ställer oss frågande till hur intressena för tredje man och det allmänna bevakas i detta förfarande och hur man tar hänsyn till att det kan förekomma skillnader i resurser i form av kunskap och ekonomi mellan parterna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a18.3",
      "sentiment": -0.5,
      "quote": "Örebro kommun tillstyrker inte förslaget vad gäller redovisning av koordinater i fastighetsregistrets textdel eftersom det är oklart hur och varför detta ska ske.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a19.2",
      "sentiment": -0.5,
      "quote": "Vinsten i tid och kostnader på kort sikt av att låta bli att markera fastighetsgränser på marken kommer i längden att vara negativt för samhället och dess invånare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a17.2",
      "sentiment": 1.0,
      "quote": "Örebro kommun tillstyrker förslaget.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a17.3",
      "sentiment": 0.5,
      "quote": "Örebro kommun tillstyrker förslaget men vill poängtera vikten av en tydlig friskrivning mot kravet på koordinatbestämning om det är så att det är uppenbart att det saknar nytta för detaljplaneprocessen.",
