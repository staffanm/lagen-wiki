  "segments": [
    {
      "forarbete_id": "a2.6.1",
      "sentiment": -0.2,
      "quote": "Detta är en central förutsättning för att stärka det statistiska underlaget, möjliggöra uppföljning och främja näringens långsiktiga utveckling.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.18.8",
      "sentiment": -0.2,
      "quote": "En sådan satsning kan utgöra ett viktigt verktyg i Jordbruksverkets arbete med att utveckla verksamheter på små gårdar, med eller utan häst.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.8.4",
      "sentiment": 0.2,
      "quote": "Riktade satsningar i samverkan med skolan och särskilda insatser för att nå pojkar kan ge positiva samhällseffekter såsom minskad risk för rekrytering till kriminella miljöer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.9",
      "sentiment": 0.2,
      "quote": "De grupper som ofta har störst behov av insatserna – personer med varaktiga funktionsnedsättningar, komplex problematik eller låg motivation för traditionell behandling – saknar ofta ekonomiska möjligheter att delta, då de lever på sjukeller aktivitetsersättning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.18.12",
      "sentiment": -0.2,
      "quote": "Vidare behövs en offentligt administrerad kvalitetssäkring av både utförare och verksamheter för att säkerställa likvärdig kvalitet, rättssäkerhet och långsiktig hållbarhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.3",
      "sentiment": -0.5,
      "quote": "Organisationen vill framhålla att samhällets behov av kompetens för hästunderstödda insatser inom socialtjänst, skola och vård inte har tagits med i beräkningarna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.6",
      "sentiment": -0.2,
      "quote": "Då förstärks även forskningsmiljön inom näringen eftersom utbildning i hästunderstödda insatser riktas mot högskoleutbildade professionella inom vård, omsorg och skola, samtliga professioner med möjligheter till forskarstudier.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.3",
      "sentiment": -0.2,
      "quote": "Detta bedöms främja inkludering och bidra till att nya målgrupper kan nås, vilket i sin tur stärker hästnäringens långsiktiga utveckling.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.8",
      "sentiment": 0.2,
      "quote": "Hästunderstödda insatser utgör en viktig brygga för barn och unga med funktionsnedsättningar eller psykisk ohälsa i övergången från sjukdom, isolering eller skolfrånvaro till en medborgare med fritidsintresse som deltar i samhällets utbud av fritidsaktiviteter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.8.2",
      "sentiment": 0.5,
      "quote": "Samverkan med befintliga ridskolor är viktig, men små enskilda verksamheter kommer även fortsättningsvis att behövas för de mest sårbara grupperna.",
