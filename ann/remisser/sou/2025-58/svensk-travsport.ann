  "segments": [
    {
      "forarbete_id": "a1",
      "sentiment": 1.0,
      "quote": "Utredningens inriktning är väl avvägd och ligger i linje med Svensk Travsports syn på hästnäringens och travsportens roll för landsbygdens utveckling, biologisk mångfald och folkhälsa.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a2.10.1",
      "sentiment": 1.0,
      "quote": "Förslagen om förbättrad statistik och digitalisering är mycket positiva och nödvändiga för att möjliggöra träffsäkra åtgärder och affärsutveckling – statistik och digitalisering är avgörande för ett modernt och konkurrenskraftigt hästföretagande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.19.2",
      "sentiment": 1.0,
      "quote": "Svensk Travsport ser därför positivt på förslag om att inkludera hästföretagare i investeringsstödet och kompensationsstödet och att stöd utformas så att även små företag och företag som genomför mindre investeringar kan beviljas stöd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.18.6",
      "sentiment": 1.0,
      "quote": "En stärkt affärsmässig kompetens är avgörande för att långsiktigt förbättra lönsamheten, öka konkurrenskraften och skapa förutsättningar för investeringar och utveckling i hela landet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.19.6",
      "sentiment": 1.0,
      "quote": "Den samlade administrativa belastningen utgör i dag ett av de enskilt största hindren för att starta och driva hästföretag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.19.7",
      "sentiment": 0.5,
      "quote": "Vi ser även en del risker med detta, främst kopplat till tävlingsverksamhet men även utifrån ett hästvälfärdsperspektiv.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.19.8",
      "sentiment": 1.0,
      "quote": "Digitalisering av hästpass och identifiering av hästar kan även förbättra spårbarhet, en fråga som är aktuell både i Sverige och inom EU.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.8.2",
      "sentiment": -0.5,
      "quote": "Svensk Travsport anser därför att utöver utredningens förslag så bör regeringen initiera en dialog med Skatteverket för att skapa mer rättvisa bedömningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec104",
      "sentiment": -1.0,
      "quote": "Svensk Travsport betonar också att höjningen av spelskatten från 18 till 22 procent utgör ett av de största enskilda hindren för hela hästnäringens utveckling.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4",
      "sentiment": 1.0,
      "quote": "Svensk Travsport betonar vikten av att de etablerade utbildningsmiljöerna – travskolor, travgymnasier, Hästsportens folkhögskola och Hippologprogrammet med flera – ges fortsatt och stärkt stöd, då dessa utgör centrala funktioner för branschens kompetensförsörjning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5",
      "sentiment": 1.0,
      "quote": "Vi delar i huvudsak utredarens analys av de hinder som i dag begränsar deltagandet i hästverksamheter och instämmer i att flera av dessa hinder är strukturella och kräver långsiktiga lösningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.4.1",
      "sentiment": 0.5,
      "quote": "Därför menar Svensk Travsport att det är av yttersta vikt att även travskolor inkluderas i det nyligen införda ”Fritidskortet” – för att på så sätt öka tillgängligheten och inkludera fler till en meningsfull fritid med hästrelaterade upplevelser.",
      "quote_type": "grund"
