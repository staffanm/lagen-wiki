  "overall": {
    "sentiment": 0.8,
    "quote": "Utbildningarna är utvecklade i nära samarbete med branschen och baserade på internationellt konkurrenskraftig forskning, vetenskap och beprövad erfarenhet.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a4.14.1",
      "sentiment": 1.0,
      "quote": "Västra Götalandsregionen ser likt utredningen inte att det skulle finnas några problematiska överlapp mellan t ex yrkeshögskoleutbildning och högskoleutbildning, eller mellan folkhögskola och utbildningar inom skolväsendet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.14.2",
      "sentiment": 1.0,
      "quote": "Hästvälfärd bör vara navet som alla utbildningar grundar sig på.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.14.3",
      "sentiment": 1.0,
      "quote": "Det behövs ett ökat utbud på eftergymnasial nivå för de som är yrkesverksamma.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.14.4",
      "sentiment": 1.0,
      "quote": "Det är av stor vikt att det blir möjlighet att starta nationella yrkesutbildningar även inom hästområdet och att det blir ett prioriterat område för Myndigheten för yrkeshögskola.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.14.6",
      "sentiment": 1.0,
      "quote": "Det är viktigt att man beviljar utbildningar på mer är tre år för att få långsiktighet i dessa kostnadstunga utbildningar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.14.7",
      "sentiment": 0.2,
      "quote": "VGR anser att en bättre benämning är ”utbildningar på eftergymnasial nivå”.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.14.8",
      "sentiment": 0.5,
      "quote": "Här skulle nationell yrkesutbildning vara ett bra komplement till yrkesvux då den utbildningsformen når de som är verksamma idag men inte har formell hästskötarutbildning, eller yrkesbytarna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.14.10",
      "sentiment": 1.0,
      "quote": "Ett statligt ansvar för en långsiktig finansiering för gemensamma utbildningsmiljöer ökar förutsättningar för kostnadseffektiva lösningar för fler aktörer, t ex för högskolan, yrkeshögskolan och andra utbildningsformer såsom yrkesutbildning på gymnasial nivå.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.14.11",
      "sentiment": 1.0,
      "quote": "Det är bra att bristen lyfts eftersom den är hämmande för utvecklingen.",
      "quote_type": "grund"
    }
  ]
}