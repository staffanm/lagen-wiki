  "overall": {
    "sentiment": -0.2,
    "quote": "Dock ser Länsstyrelsen att flera av de förslag och bedömningar som utredaren lägger fram riskerar att inte leda till de förbättringar som denne resonerar kring, utan tvärtom till negativa effekter.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a2.10.1",
      "sentiment": -0.5,
      "quote": "Länsstyrelsen avstyrker förslaget i den form det lagts fram av utredaren, avseende extra uppdrag till Jordbruksverket med särredovisningar då detta borde kunna inrymmas i redan befintliga uppdrag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.19.8",
      "sentiment": -1.0,
      "quote": "Beträffande digitala hästpass ser Länsstyrelsen en del svårlösta problem, t ex att alla veterinärer måste kunna få tillgång till vart och ett av de digitala passen, och att administration torde förflyttas från djurhållare till veterinär som i sin tur behöver ta ut sina ökade kostnader på djurhållaren.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.19.3",
      "sentiment": -1.0,
      "quote": "Länsstyrelsen anser att investeringsstöd i under kommande programperiod för jordbrukarstöd i den gemensamma jordbrukspolitiken ska koncentreras till livsmedelsproducerande företag och avstyrker förslaget om att inkludera hästföretagare bland dem som kan tilldelas investeringsstöd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.19.4",
      "sentiment": -1.0,
      "quote": "Om hästnäringen skulle kunna etablera ekonomibyggnader utan bygglov i attraktiva lägen så som strandnära områden eller på högproduktiv jordbruksmark, skulle negativa effekter i form av undanträngningseffekter av olika slag kunna uppstå.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.19.5",
      "sentiment": 1.0,
      "quote": "Att hästar vid försäljning till privatpersoner omfattas av konsumentköplagen är en alltför stor risk för företagaren, eftersom det kan vara mycket svårt att visa huruvida problem hos en hästindivid fanns eller inte fanns vid köptillfället så länge som sex månader senare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.19.6",
      "sentiment": 0.0,
      "quote": "Jordbruksverket, liksom länsstyrelserna och många andra myndigheter, har uppdrag i sina instruktioner och/eller regleringsbrev avseende att förenkla företagare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.19.7",
      "sentiment": -1.0,
      "quote": "Symptombild är inte ett tillräckligt instrument för en djurhållare att använda för att korrekt kunna sätta in en behandling utan att veterinär undersökt djuret, eftersom exempelvis infektioner, hosta, hälta, kolik och hudlidanden har så olika orsaker och behov av varierande behandling att det helt enkelt inte lämpar sig för ViLA.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.19.9",
      "sentiment": -0.2,
      "quote": "Att verka för ökad digitalisering är uppdrag som ges till många myndigheter och vid fördelning av medel för forskning finns redan idag detta med som en av många aspekter att ta hänsyn till.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.14.8",
      "sentiment": 1.0,
      "quote": "Egen hög kompetens och kompetent personal är en förutsättning för att kunna utveckla en verksamhet, och detta omfattar djurskötsel/djurutbildning, anläggningsskötsel och företagande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.8.8",
      "sentiment": -0.5,
      "quote": "Länsstyrelsen anser att de medel som fördelas via den gemensamma jordbrukspolitiken i den nya programperioden ska riktas till livsmedelsproducerande verksamheter och avstyrker den delen av förslaget.",
      "quote_type": "grund"
    }
  ]
