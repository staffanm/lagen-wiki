    },
    {
      "forarbete_id": "a3.19.6",
      "sentiment": -0.5,
      "quote": "Avsaknaden av en sådan analys gör det svårt att bedöma konsekvenserna för hästvälfärden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.19.5",
      "sentiment": 0.2,
      "quote": "Vi ser därför vikten av att en översyn av konsumentköplagen gällande försäljning av hästar, så som föreslås i betänkandet, görs även med detta i åtanke.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.19.7",
      "sentiment": -1.0,
      "quote": "Precis som framförts av veterinärer i inspel till utredningen, så vill vi påpeka att det är en komplicerad undersökning och att hästar anatomiskt skiljer sig från nötkreatur.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.19.7",
      "sentiment": 0.5,
      "quote": "I en sådan utredning ska veterinärmedicinsk kompetens och djurskyddskompetens finnas representerad.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.16.1",
      "sentiment": -1.0,
      "quote": "Hästar är flyktdjur med hög känslighet för stress och obehag och vi är mycket tveksamma till om forskare kommer att vilja ta sig an ett projekt gällande virtuella stängsel för hästar då man redan utifrån nuvarande kunskap om hästars beteende kan anta att det inte är ett system som kan fungera.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.14",
      "sentiment": -0.2,
      "quote": "För att säkerställa likvärdig kunskapsnivå och långsiktig efterlevnad bör djurvälfärd utgöra ett obligatoriskt och tydligt integrerat moment i relevanta utbildningar, snarare än en fråga som lämnas till frivilliga initiativ.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.8",
      "sentiment": 0.2,
      "quote": "Verksamheter som riktar sig till nya målgrupper ställer ofta höga krav på personalens kompetens, både vad gäller djurvälfärd och förmåga att identifiera stress, överbelastning och olämplig användning av häst.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec494",
      "sentiment": -0.5,
      "quote": "Vi anser visserligen inte att Jordbruksverket ska få uppdraget som föreslås, men ser även att det är anmärkningsvärt att utredaren menar att myndigheten ska rymma ett sådant uppdrag, inklusive återrapportering inom ramen för befintligt anslag.",
