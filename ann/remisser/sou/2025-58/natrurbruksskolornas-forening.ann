  "overall": {
    "sentiment": 0.8,
    "quote": "Utredningen ger en välgrundad och träffsäker bild av de behov och utmaningar som utbildningsanordnare möter, och förslagen ligger i linje med vad våra medlemsskolor ser i sin vardag.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a4.14.10",
      "sentiment": 1.0,
      "quote": "Även gymnasieskolorna påverkas av samma strukturella utmaningar: anläggningar kräver stora investeringar, det behövs tillgång till många hästar och hög kompetens hos personalen, och utbildningarna kräver lång planeringshorisont.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.14.8",
      "sentiment": 1.0,
      "quote": "Utredningen pekar rätt i att kompetensbrist råder inom flera nyckelområden: hästskötare; anläggnings- och fastighetsskötare; arbetsmiljö, företagsekonomi och entreprenörskap; digitalisering och ny teknik; samt hästvälfärd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.14.3",
      "sentiment": 1.0,
      "quote": "Flera utbildningsformer kan bidra; många naturbruksskolor erbjuder redan vuxenutbildning och utgör viktiga regionala aktörer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.13.3",
      "sentiment": 0.5,
      "quote": "Det saknas aktuell och naturbruksanpassad kurslitteratur i ekonomi och företagande, både inom Naturbruk lantbruk och inom Naturbruk hästhållning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.14.2",
      "sentiment": 0.5,
      "quote": "Vi vill betona att ambitionshöjningar måste följas av resurser för att kunna genomföras likvärdigt över landet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.14.9",
      "sentiment": 0.2,
      "quote": "En stärkt nationell samordning skulle skapa en mer sammanhängande utbildningskedja, minska glapp mellan utbildningsnivåer och ge tryggare dimensioneringsunderlag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a2.10.1",
      "sentiment": 1.0,
      "quote": "Skolornas möjlighet att dimensionera utbildningar påverkas av bristfälliga uppgifter om antal hästar, företag och kompetensbehov.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.10",
      "sentiment": 0.2,
      "quote": "NF vill endast betona vikten av att undvika dubbla prov för elever, och att ett eventuellt statligt yrkesprov bör harmoniseras med befintliga branschprov.",
