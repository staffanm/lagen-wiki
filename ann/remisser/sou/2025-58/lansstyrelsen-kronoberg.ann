  "segments": [
    {
      "forarbete_id": "a2.10",
      "sentiment": 0.8,
      "quote": "Att regeringen ger Jordbruksverket i uppdrag att ta fram nödvändiga system och lämpliga parametrar, bland annat antal hästar och anläggningar med häst samt produktions- och lönsamhetsmått för att kunna följa utvecklingen av hästföretagande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.19.3",
      "sentiment": -0.5,
      "quote": "Stödet syftar i första hand till att öka livsmedelsproduktionen och hästar föds sällan upp för att bli livsmedel.",
