    },
    {
      "forarbete_id": "a3.19.3",
      "sentiment": 0.5,
      "quote": "Detta för att stärka lönsamheten i livsmedelsproducerande företag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.19.2",
      "sentiment": -0.2,
      "quote": "Det kan vara svårt att fastslå kring vilken nivå djurtätheten ska beräknas för olika hästar i proportion till möjlig avbetning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.19.4",
      "sentiment": 0.0,
      "quote": "Länsstyrelsen anser att en ökad tydlighet är önskvärd för all typ av företagande, men tar i övrigt inte ställning i sakfrågan.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.19.5",
      "sentiment": 0.8,
      "quote": "Samtidigt ska företagare inte kunna sälja hästar med dolda fel om ångerrätten tas bort.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.19.6",
      "sentiment": 1.0,
      "quote": "Detta för att tydliggöra både för myndighet och företagare vilka regelverk som är aktuella.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.19.7",
      "sentiment": -1.0,
      "quote": "Länsstyrelsen bedömer att de föreslagna kompensatoriska åtgärderna, i form av införande av villkorad läkemedelsanvändning (ViLA) för häst samt utvidgade befogenheter för seminassistenter och husdjurstekniker att utföra ultraljudsundersökningar och dräktighetsdiagnostik, innebär betydande risker för djurvälfärd, smittskydd, arbetsmiljö och rättssäkerhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.19.8",
      "sentiment": 1.0,
      "quote": "Länsstyrelsen tillstyrker förslaget.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a3.19.9",
      "sentiment": 0.8,
      "quote": "Länsstyrelsen har inget att erinra mot utredningens bedömning att digitalisering i hästsektorn ges hög prioritet i forskningsutlysningar.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a3.18.17",
      "sentiment": -1.0,
      "quote": "Länsstyrelsen bedömer att tekniken i sin nuvarande form inte är förenlig med ett gott djurskydd för häst och att förslaget innebär betydande risker för djurvälfärd, säkerhet och tillsyn.",
