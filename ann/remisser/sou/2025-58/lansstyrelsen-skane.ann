    },
    {
      "forarbete_id": "a3.19.7",
      "sentiment": 0.8,
      "quote": "inkludera transport av hästar för veterinärvård i undantaget från kravet gällande TRACES, vid transporter inom Norden, eftersom det kan minska väntetid.",
