  "overall": {
    "sentiment": 0.0,
    "quote": "Länsstyrelsen Gävleborg menar att även om hästnäringen på många sätt är en viktig del i lantbruket, framför allt som kunder till grovfoderproducerande lantbrukare, så bör inte stödsystemet förändras till att ytterligare omfatta hästar.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a2.10.1",
      "sentiment": 0.5,
      "quote": "Vi föreslår samordning med Jordbruksverkets strukturundersökning för minskad administration.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.19.2",
      "sentiment": -0.5,
      "quote": "Länsstyrelsen ser därför en risk i att livsmedelsproduktionen kan påverkas negativt om hästnäringen ska ta del av samma stödbudget.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.19.2",
      "sentiment": -1.0,
      "quote": "Därtill riskerar stödet bli svårt att kontrollera och minskad förväntad budget för jordbrukspolitiken utgör ytterligare ett skäl till att vi är tveksamma.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.19.3",
      "sentiment": 0.5,
      "quote": "Här kan då kreditgarantier och/eller räntestöd vara lämpliga verktyg för att dela risken och påskynda viktiga och lönsamma investeringar i branschen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.19.4",
      "sentiment": -1.0,
      "quote": "Hästar används inte längre i jordbruket och föds primärt inte upp som livsmedel.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.19.6",
      "sentiment": 1.0,
      "quote": "Detta för att tydliggöra både för myndighet och företagare vilka regelverk som är aktuella.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.19.7",
      "sentiment": -1.0,
      "quote": "Vidare så är en sådan undersökning på häst förenlig med risker för tex tarmskador.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.19.7",
      "sentiment": -1.0,
      "quote": "De sjukdomar och tillhörande läkemedel som villkoras hos produktionsdjur (nöt, gris, får, get) är inte att jämföra med vanliga sjukdomstillstånd på häst.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.19.7",
      "sentiment": 0.5,
      "quote": "Detta kan innebära fördröjning och därmed ökad risk för djuret framför allt vid sjukdom.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a3.19.8",
      "sentiment": 0.2,
      "quote": "anser att det måste ske utan ökad administration för hästföretagare och djurhälsopersonal.",
      "quote_type": "grund"
