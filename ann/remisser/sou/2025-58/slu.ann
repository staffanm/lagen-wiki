    {
      "forarbete_id": "a3.19.8",
      "sentiment": -0.2,
      "quote": "SLU ser en risk för att dubbla system kommer innebära merarbete och risk för fel när båda formerna av pass måste hanteras och synkroniseras av ägare, veterinärer och stambokförande föreningar.",
      "quote_type": "grund"
