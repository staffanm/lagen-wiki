  "overall": {
    "sentiment": 0.2,
    "quote": "Tingsrätten tillstyrker förslagen och delar bedömningarna.",
    "quote_type": "standpunkt"
  },
  "segments": [
    {
      "forarbete_id": "sec10",
      "sentiment": 0.5,
      "quote": "Tingsrätten har dock svårt att se i vilka situationer som regeringen skulle fatta beslut om undantag från skyldigheten att ingå säkerhetsskyddsavtal (mellan vissa myndigheter) i enskilda fall.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec22",
      "sentiment": 0.2,
      "quote": "Tingsrätten anser inte att det framgår av betänkandet i vilka praktiska situationer det kan vara aktuellt för tillsynsmyndigheten att ansöka om kvarstad och andra tvångsåtgärder i samband med utkontraktering och vissa andra förfaranden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec25",
      "sentiment": 0.2,
      "quote": "Om två myndigheter har ett gemensamt ansvar bl.a. för utvärdering, utveckling och metodstöd, kan det dock behöva övervägas om ansvarsfördelningen mellan myndigheterna behöver tydliggöras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec32",
      "sentiment": -0.2,
      "quote": "Särskilt om ett sådant krav förenas med en risk för sanktioner, kan det diskuteras om det är proportionerligt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec33",
      "sentiment": 1.0,
      "quote": "Tingsrätten delar bedömningen att det är mer lämpligt med en möjlighet att besluta om sanktionsavgift än med straffansvar.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec36",
      "sentiment": -0.2,
      "quote": "Tingsrätten ställer sig till att börja med frågande till förslaget att en sanktionsavgift ska tas ut även i de fall då verksamhetsutövaren underlåtit att anmäla att en säkerhetskänslig verksamhet har upphört.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec34",
      "sentiment": -0.2,
      "quote": "Det bör också övervägas om en sanktionsavgift är det lämpligaste i alla de fall som det föreslås, eller om en möjlighet för tillsynsmyndigheten att i stället kunna ansöka om vitesföreläggande skulle vara mer lämpligt i något eller några av fallen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec485",
      "sentiment": 1.0,
      "quote": "Tingsrätten ställer sig bakom detta och uppfattar att det är ett undantag från förslaget att sanktionsavgifter ”alltid ska tas ut”.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec38",
      "sentiment": 1.0,
      "quote": "Tingsrätten tillstyrker utredningens förslag i fråga om hinder mot sanktionsavgift och förfarandet vid beslut om sanktionsavgift.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec40",
      "sentiment": 1.0,
      "quote": "Tingsrätten tillstyrker förslagen.",
      "quote_type": "standpunkt"
