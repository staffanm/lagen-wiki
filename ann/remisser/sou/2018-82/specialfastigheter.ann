  "segments": [
    {
      "forarbete_id": "sec5",
      "sentiment": 0.5,
      "quote": "Specialfastigheter ställer sig positiv till den föreslagna utvidgningen av kravet på ingående av säkerhetsskyddsavtal.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a5.4.7",
      "sentiment": -0.2,
      "quote": "Stor risk finns att det tolkas som ”utanför” koncernen eller verksamhetsutövarens sfär och att syftet med användningen av begreppet ”utomstående” därmed inte uppnås.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.4.2",
      "sentiment": -0.5,
      "quote": "Specialfastigheter anser att det i utredningen saknas förslag till reglering av fallet där båda parter i en avtalsrelation är verksamhetsutövare och det för båda – i någon utsträckning – föreligger en skyldighet att säkra sina skyddsvärden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.4.7",
      "sentiment": -0.2,
      "quote": "Enligt ordalydelsen omfattas sådan situation inte av 2 kap. 6 § säkerhetsskyddslagen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec14",
      "sentiment": 1.0,
      "quote": "Vi är positiva till att lagfästa lämplighetsprövningen (första kontrollstationen) och att inte enbart reglera denna i anvisningarna/vägledningen till SUA-processen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec16",
      "sentiment": -0.2,
      "quote": "Vi föreslår att de bestämmelser i det nya kapitlet 2a som avser tillsyn, d.v.s. främst bestämmelser som reglerar den tredje kontrollstationen och bestämmelsen om proportionalitetsprincipen bör flyttas till tillsynskapitlet, 4a kapitlet, och de bestämmelser som närmare reglerar verksamhetsutövarens process och analyser inför ett tecknande av ett säkerhetsskyddsavtal bör omedelbart ansluta till bestämmelserna om säkerhetsskyddsavtal, d.v.s. dessa bör placeras efter 2 kap 6 b §.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec52",
      "sentiment": -0.5,
      "quote": "Specialfastigheter konstaterar med oro att utredningens förslag om regler för överlåtelse av säkerhetskänslig verksamhet inte kommer att omfatta verksamhetsutövarnas lokalförsörjning, eftersom hyresvärden alltid kommer att inta leverantörsrollen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8",
      "sentiment": -0.5,
      "quote": "Specialfastigheter ser detta som problematiskt ur ett allmänt rättssäkerhetsperspektiv, i synnerhet med hänsyn till legalitets- och likabehandlingsprincipen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec33",
      "sentiment": 1.0,
      "quote": "Specialfastigheter anser att den i utredningen föreslagna parallellen till NIS- och dataskyddslagen är rimlig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec37",
      "sentiment": -0.2,
      "quote": "Med hänsyn till vilka skyddsvärden och möjliga skador för Sveriges säkerhet som står på spel förefaller dock avgiftens storlek obalanserad i förhållande till den maximala avgift som enligt dataskyddsförordningen kan utdömas.",
      "quote_type": "grund"
    }
  ]
}