  "segments": [
    {
      "forarbete_id": "a5.4.5",
      "sentiment": -0.2,
      "quote": "Inom ramen för ett framtida totalförsvar kommer vissa privata aktörer att samarbeta nära med myndigheter och även andra privata aktörer, med tanke på detta bör resonemanget inom 5.4.5 att andra än statliga myndigheter normalt bör omfattas av en skyldighet att ingå säkerhetsskyddsavtal ses över.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6",
      "sentiment": -0.5,
      "quote": "Att ställa ett brett krav mot näringslivet att inrätta en befattning som skall vara på ledningsgruppsnivå är ett kostsamt och krävande ingrepp.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec261",
      "sentiment": -0.5,
      "quote": "vi ser snarare en risk att myndigheter har för snäva perspektiv och saknar kompetensen för att fatta dessa beslut, regeringen har mycket bättre förutsättningar att ha ett mer holistiskt perspektiv, och därför bör regeringen snarare än tillsynsmyndigheter fatta dessa beslut.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.9",
      "sentiment": -0.2,
      "quote": "är det rimligt att privata aktörer som agerat korrekt utifrån en tidigare existerande hotbild, får en kostnadsersättning för de kostnader som uppstår om tillsynsmyndigheten ingriper.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.11.1",
      "sentiment": -0.2,
      "quote": "Myndigheter som ej bejakar detta i upphandling borde bli ersättningsskyldiga gentemot privata leverantörer för att täcka kostnader som orsakats av brister hos myndigheten i att informera entreprenören om alla relevanta säkerhetskrav.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.11.3",
      "sentiment": -0.2,
      "quote": "om nya kostnader uppstår på grund av en revideringen (t.ex. på grund av ändrad hotbild) skall uppdragsgivande myndighet vara skyldig att täcka dessa merkostnader.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.13",
      "sentiment": -0.5,
      "quote": "Att då dessutom lita på regeringen ska fatta tillfredställande ex gratia beslut – snarare än lagfästa garantier – innebär givetvis en stor osäkerhet för drabbade företag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.14",
      "sentiment": -0.5,
      "quote": "Ges inte fullgoda garantier till ersättning riskerar effekten bli att privata investeringar uteblir på kritiska områden – som direkt skulle motverka Sveriges säkerhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.15",
      "sentiment": -0.5,
      "quote": "Här tycker vi att staten gör det lätt för sig genom att lägga ett ansvar på enskilda näringsidkare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.15",
      "sentiment": -0.5,
      "quote": "Här tycker vi att staten gör det lätt för sig genom att lägga ett ansvar på enskilda näringsidkare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.17",
      "sentiment": -0.2,
      "quote": "Syftet borde väl vara hjälpa verksamheter uppnå rätt standard, snarare än att ”sätta dit” verksamheter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.8",
      "sentiment": -0.5,
      "quote": "Det är orimligt att privata företag skall riskera sanktionsavgifter om det ej uppfyller en kravbild de själva skall fastställa.",
