    },
    {
      "forarbete_id": "a9.10",
      "sentiment": -0.5,
      "quote": "SN ser istället att tillsynsmyndigheten har rätt att hos allmän förvaltningsdomstol ansöka om sanktionsavgift, jfr t.ex. Konkurrensverkets rätt att ansöka om upphandlingsskadeavgift, 21 kap. 1 §.",
      "quote_type": "grund"
    },
    {
