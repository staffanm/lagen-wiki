  "overall": {
    "sentiment": 0.5,
    "quote": "Sammanfattningsvis anser vi att utredningen innehåller många nödvändiga kompletteringar utifrån ett tillsynsperspektiv.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "sec5",
      "sentiment": 1.0,
      "quote": "För att den grundläggande principen inom säkerhetsskyddet ska fungera, d.v.s. att skyddet ska följa det skyddsvärda oavsett verksamhetsform, så bör skyldigheten att ingå säkerhetsskyddsavtal utvidgas i enlighet med utredningens förslag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8",
      "sentiment": -0.2,
      "quote": "Vår bedömning är att detta kan innebära en försenande omständighet för verksamhetsutövare om inte resurstilldelningen harmoniserar behovet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.10",
      "sentiment": -0.2,
      "quote": "Vi bedömer att Säkerhetspolisen och Försvarsmakten har bättre förutsättningar att uppfylla detta krav.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8",
      "sentiment": 1.0,
      "quote": "Förslagen i dess helhet är av nödvändighet för att tillsynen ska kunna bedrivas ändamålsenligt och effektivt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.6",
      "sentiment": 1.0,
      "quote": "Att Säkerhetspolisen och Försvarsmakten blir samordningsmyndigheter anser vi vara ett fundament för en väl fungerande tillsynsstruktur.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.10",
      "sentiment": 1.0,
      "quote": "De undersökningsbefogenheter som utredningen ger förslag till, som bland annat innebär tillgång till information och tillträde till lokaler, ser vi som nödvändigt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.14",
      "sentiment": 1.0,
      "quote": "Utan denna möjlighet kommer det bli svårt att upprätta tillsynsplaneringen så väl som förutsättningarna för att skapa en helhetsbild över respektive sektor.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.4.4",
      "sentiment": -0.5,
      "quote": "Det kan inte anses lämpligt att tillsynsmyndigheten inte får kännedom om sådana incidenter, eftersom sådan information kan vara av relevans för tillsynen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec413",
      "sentiment": -0.2,
      "quote": "Det är nämligen inte självklart att begreppet civil luftfart också omfattar flygledningstjänster och flygtrafiktjänster.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5",
      "sentiment": 0.2,
      "quote": "syftet med säkerhetsskyddslagstiftningen - att skydda verksamhet som har betydelse för Sveriges säkerhet - skiljer sig väsentligt från syftet med ovan nämnda lagstiftningar (vars ändamål är att skydda personuppgifter respektive upprätthålla tillgängligheten i samhällsviktiga tjänster).",
      "quote_type": "grund"
