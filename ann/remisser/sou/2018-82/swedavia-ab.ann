    {
      "forarbete_id": "sec177",
      "sentiment": -0.2,
      "quote": "Det saknas dock vägledning för enskilda som bedriver verksamhet och hur en företagskoncern ska se på sina dotterbolag och sambolag som också utgör leverantörer i olika avseenden, exempelvis av fastigheter, energi eller telekom, eller när ägarförhållanden och drift är delade i olika bolag.",
      "quote_type": "grund"
