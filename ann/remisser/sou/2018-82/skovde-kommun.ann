    {
      "forarbete_id": "sec5",
      "sentiment": 0.2,
      "quote": "Det framstår som ett risktagande att förutsätta att samtliga statliga förvaltningsmyndigheter har möjlighet att hålla samma höga nivå på sin säkerhetsorganisation som exempelvis de tre ovan angivna.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec11",
      "sentiment": 0.5,
      "quote": "Det föreslagna kontrollsystemet kan antas få betydande konsekvenser av ekonomisk-administrativ karaktär.",
