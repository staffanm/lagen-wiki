    {
      "forarbete_id": "sec33",
      "sentiment": -0.2,
      "quote": "Att lägga ett avgörande som kan vara av så känslig karaktär hos tillsynsmyndigheten – motparten i det enskilda ärendet – kan befaras leda till en rättstillämpning som upplevs som ojämn och nyckfull.",
      "quote_type": "grund"
