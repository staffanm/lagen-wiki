    },
    {
      "forarbete_id": "a7.8",
      "sentiment": 1.0,
      "quote": "Betänkandets förslag är i denna del väl avvägt, och kan inte anses gå längre än vad som är nödvändigt för att ge önskade effekter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec23",
      "sentiment": 0.2,
      "quote": "konstaterar att det föreslagna systemet med 13 olika tillsynsmyndigheter och två samordningsmyndigheter kan vara svårt att förena med kraven på effektivitet, likabehandling och rättssäkerhet.",
