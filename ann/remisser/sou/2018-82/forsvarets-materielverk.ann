  "overall": {
    "sentiment": 0.0,
    "quote": "FMV är sammantaget försiktigt positiva till en del av utredningens förslag. Samtidigt anser FMV att många av förslagen inte i tillräcklig utsträckning utretts, varför det i vissa fall är mycket svårt att överblicka dess konsekvenser.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a5.4",
      "sentiment": 0.5,
      "quote": "FMV instämmer i utredningens uppfattning om att kravet på att teckna säkerhetsskyddsavtal ska utgå från exponeringen av det skyddsvärda snarare än anledningen till exponeringen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.1",
      "sentiment": -1.0,
      "quote": "Om myndigheter inom försvats- och säkerhetsområdet ska kunna ställa som krav i sina säkerhetsskyddsavtal att leverantören får nyttja underleverantör endast om myndigheten tecknat säkerhetsskyddsavtal med densamme, så kommer det med utredningens förslag leda till att det tecknas två säkerhetsskyddsavtal för samma uppdrag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8",
      "sentiment": -1.0,
      "quote": "I yttrandet pekade FMV på risker med bl.a. ökade ledtider vid säkerhetsskyddade upphandlingar, en risk som nu är ett faktum då tillsynsmyndighetens svarstid i samrådsärenden normalt är flera månader.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.11",
      "sentiment": -1.0,
      "quote": "FMV delar till viss del utredningens slutsatser vad gäller dessa frågor men anser att en anmälningsplikt till tillsynsmyndigheten vid överlåtelse av säkerhetskänslig verksamhet är tillräcklig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7",
      "sentiment": 0.8,
      "quote": "Att tillsynsuppdraget i första hand läggs på myndigheter med etablerad sakkompetens ökar förutsättningarna för en lyckad tillsyn.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.5",
      "sentiment": -1.0,
      "quote": "Även om sanktioner i vissa fall kan ha en positiv och handlingsdirigerande verkan anser FMV att de negativa konsekvenserna väger över.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a10.1",
      "sentiment": -1.0,
      "quote": "Flera av de risker som redovisas i detta yttrande kommer att ta tid att utteda och analysera djupare innan det helt går att överblicka konsekvenserna av förslagen.",
      "quote_type": "grund"
