  "segments": [
    {
      "forarbete_id": "sec171",
      "sentiment": 1.0,
      "quote": "FOI tillstyrker på av utredningen anförda skäl att skyldigheten att ingå säkerhetsskyddsavtal bör utgå från exponeringen av säkerhetsskyddsklassificerade uppgifter eller i övrigt säkerhetskänslig verksamhet.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec174",
      "sentiment": -0.5,
      "quote": "är en brist att inte föreskriva att någon form av avtal krävs i den lägsta en informationssäkerhetsklassen då den omfattas av säkerhetsskyddskrav, som måste regleras hos utförare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec177",
      "sentiment": 1.0,
      "quote": "FOI delar utredningens bedömning att samverkan och samarbeten mellan statliga myndigheter undantas från kravet på säkerhetsskyddsavtal.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec178",
      "sentiment": -1.0,
      "quote": "FOI bedömer vidare att ett krav på upprättande av säkerhetsskyddsavtal mellan myndigheter kan skapa avtalsförhållanden som medför onödig och tidskrävande administration, utan att för den skull åstadkomma ett bättre säkerhetsskydd.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.4.5",
      "sentiment": 0.2,
      "quote": "Den föreslagna modellen ställer också stora krav på såväl verksamhetsutövare i flera led som tillsynsmyndighet/-er att dela information om hur kontraktskedjan ser ut och de krav på säkerhetsskydd som gäller för säkerhetsskyddsklassificerade uppgifter.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.4.6",
      "sentiment": -0.2,
      "quote": "FOI bedömning är att behovet av undantag kommer att vara omfattande bl.a. mellan myndigheterna inom försvars- och säkerhetsområdet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6",
      "sentiment": -0.5,
      "quote": "anser att förslaget i övriga delar är för långtgående och inskränker en myndighets möjligheter att utforma dess organisation, styrning, uppföljning och kontroll av ett säkerhetsskydd som är bäst anpassat för myndigheten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.8",
      "sentiment": -0.5,
      "quote": "myndigheten måste anmäla och söka samråd med tillsynsmyndigheten i stor omfattning även i mer rutinartade ärenden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7",
      "sentiment": 0.2,
      "quote": "FOI anser dock att den föreslagna regleringen är långtgående varför förslaget och konsekvenserna av det behöver ytterligare utredning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.7",
      "sentiment": -0.2,
      "quote": "Den föreslagna ordningen med två samordningsmyndigheter och ett antal sektorsspecifika tillsynsmyndigheter ställer stora krav på samverkan och samordning mellan dessa myndigheter, särskilt vad gäller myndigheter som utövar tillsyn över samma verksamhetsutövare.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a8.10",
      "sentiment": -0.5,
      "quote": "inom försvars- och säkerhetsskyddsområdet finns särskilt skyddsvärd verksamhet med höga sekretesskrav och att en reglering som innebär undersökningsbefogenheter måste utformas på sådant sätt att dessa verksamheter inte lider skada.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9",
      "sentiment": -0.2,
      "quote": "vilka åtgärder som utgör ett fullgott säkerhetsskydd till sin karaktär ofta är en ren bedömningsfråga kopplat till hotbild, sårbarhet och risk i det enskilda fallet.",
      "quote_type": "grund"
