    {
      "forarbete_id": "a3.4.4",
      "sentiment": -0.2,
      "quote": "En felaktig klassificering kan förutom att leda till merarbete dessutom leda till att vissa aktörer exkluderas vilket i sin tur kan påverka den gränsöverskridande handeln.",
      "quote_type": "grund"
