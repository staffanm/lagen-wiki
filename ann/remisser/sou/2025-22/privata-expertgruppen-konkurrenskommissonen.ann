  "segments": [
    {
      "forarbete_id": "a6.5",
      "sentiment": 0.5,
      "quote": "Som ovan redovisats föreligger det en grundläggande skillnad mellan privata och offentliga aktörers förutsättningar att bedriva näringsverksamhet.",
