  "overall": {
    "sentiment": -0.5,
    "quote": "Dock anser vi att de förslag som presenteras i detta betänkande saknar nyansering och är alltför långtgående.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a6.6.2",
      "sentiment": -1.0,
      "quote": "Förslaget om att förbjuda otillbörlig offentlig säljverksamhet är otydligt, rättsosäkert och svårtolkat.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.5",
      "sentiment": -1.0,
      "quote": "Det saknas skäl att införa en särskild redovisning, som dessutom skulle innebära en omfattande administration och ökade kostnader.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.6",
      "sentiment": -1.0,
      "quote": "För rättssäkerhetens skull måste dessa funktioner fortsatt hållas åtskilda.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.10",
      "sentiment": -1.0,
      "quote": "En sådan sanktionsmodell riskerar att skrämma kommunala aktörer från att bedriva legitim, samhällsnyttig verksamhet inom den kommunala kompetensen – vilket i sin tur kan leda till att marknadsmisslyckanden kvarstår, viktig infrastruktur uteblir och att beredskapen försämras.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.11",
      "sentiment": -1.0,
      "quote": "Förslaget om en marknadsstörningsavgift på upp till 20 miljoner kronor är orimligt högt och skulle slå hårt mot kommuner och kommunala bolag – särskilt i mindre och resurssvaga kommuner.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec432",
      "sentiment": -1.0,
      "quote": "Tidsgränsen är inte motiverad och framstår som oproportionerlig, särskilt eftersom den gäller även efter att den ifrågasatta verksamheten, och konkurrenspåverkan, har upphört.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.14",
      "sentiment": 0.5,
      "quote": "överklagan hanteras av den förvaltningsdomstol inom vars domkrets klaganden har sin hemvist, eftersom de bedöms vara bättre lämpade att pröva frågan om vad som är ”försvarbart från allmän synpunkt” i det specifika fallet.",
      "quote_type": "grund"
    }
  ]
