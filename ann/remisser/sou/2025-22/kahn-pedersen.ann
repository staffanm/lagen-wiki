  "segments": [
    {
      "forarbete_id": "a6.6.1",
      "sentiment": 1.0,
      "quote": "framstår det, enligt Kahn Pedersens mening, som ändamålsenligt att placera reglerna i en egen lag och särskilja reglerna från konkurrensrättens område.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.2",
      "sentiment": 0.2,
      "quote": "Det vore därför mycket olyckligt om den nya lagen om offentlig säljverksamhet skulle utformas eller tillämpas på ett sätt som skulle inskränka de möjligheter som de nämnda bestämmelserna i LOU ger.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.2",
      "sentiment": -0.5,
      "quote": "Kahn Pedersen tillstyrker i och för sig att fokus ska skiftas från det tidigare konkurrensrättsliga fokuset, men anser att det vore problematiskt om enskilda företag, hur stora eller små de än må vara, ska kunna förhindra offentliga aktörers verksamhet, oavsett hur stor eller liten som påverkan av den offentliga aktörens verksamhet eller förfarande är.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.2",
      "sentiment": -0.5,
      "quote": "det saknas problematisering kring EU-rättens företräde och risken för att reglerna om offentlig säljverksamhet förhindrar åtgärder som enligt är tillåtna EU-rätten, och därmed hindrar EU-rättens genomslag.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.2",
      "sentiment": -0.5,
      "quote": "En presumtionsregel i linje med utredningens förslag kommer med andra ord att leda till att kommunala aktörer inte kan försvara sig mot påståendet om att det ”verkar” konstlat att en viss verksamhet drivs utan vinstsyfte, eftersom det svårligen går att leda i bevis.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.3",
      "sentiment": 1.0,
      "quote": "Kahn Pedersen har inget att invända mot utredningens förslag att statliga aktörer bör behandlas på samma sätt som kommunala aktörer.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.6.4",
      "sentiment": -0.2,
      "quote": "Om en verksamhet växer till att inte längre vara av begränsad omfattning, kommer den per automatik att omfattas av den offentliga aktörens utvärderingsplikt, eftersom den inte längre är av begränsad omfattning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.6",
      "sentiment": -1.0,
      "quote": "framstår det för oss som oförenligt med regeringsformen att låta Konkurrensverket bli beslutsmyndighet på det sätt som utredningen föreslår.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.7",
      "sentiment": -0.5,
      "quote": "Rättssäkerhetsskäl talar i så fall för att Konkurrensverket inte ska ha rätt att tvinga någon att lämna sådana upplysningar eller infinna sig till förhör, utan föregående domstolsprövning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.7",
      "sentiment": 1.0,
      "quote": "Detta är en grundläggande rättssäkerhetsgaranti.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.8",
      "sentiment": -0.5,
      "quote": "Mot denna bakgrund framstår det varken som proportionerligt eller rättssäkert att förelägganden ska gälla omedelbart, särskilt inte förelägganden som innebär att en verksamhet förbjuds.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.8",
      "sentiment": -0.5,
      "quote": "Vid en avvägning mellan å ena sidan risken för felaktiga bedömningar som leder till irreversibla konsekvenser för både den offentliga aktören och enskilda individer såsom anställda eller kunder, och å andra sidan behovet av att otillåtna beteenden förhindras, anser Kahn Pedersen att rättssäkerhetsskäl väger tyngst.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.9",
      "sentiment": 1.0,
      "quote": "Kahn Pedersen tillstyrker utredningens förslag i denna del.",
