    },
    {
      "forarbete_id": "sec612",
      "sentiment": -0.5,
      "quote": "Högsta förvaltningsdomstolen har uttalat att utdömande av vite inte kan ske förrän ett vitesföreläggande vunnit laga kraft, även om vitesföreläggandet gäller omedelbart (se HFD 2024 ref. 4).",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec439",
      "sentiment": -0.5,
      "quote": "anser förvaltningsrätten att det finns tydliga risker för parallell praxisbildning på området.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.14",
      "sentiment": -0.5,
      "quote": "Det kan ifrågasättas om en sådan ordning är proportionerlig.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec439",
      "sentiment": -0.2,
      "quote": "Det saknas dock såväl överväganden som konsekvensbeskrivning av effekterna kring det.",
