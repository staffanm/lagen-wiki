  "segments": [
    {
      "forarbete_id": "sec439",
      "sentiment": -0.2,
      "quote": "Förvaltningsrätten vill påtala att med nuvarande förslag kommer samtliga beslut enligt den föreslagna lagen om offentlig säljverksamhet att handläggas vid samma förvaltningsrätt och kammarrätt",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec415",
      "sentiment": -0.2,
      "quote": "Förvaltningsrätten anser att det finns skäl att överväga om ytterligare reglering behövs när det gäller rättens sammansättning vid mål enligt 9 § tredje stycket i den föreslagna lagen, vilka ska prövas utan dröjsmål, och mål om interimistiska förelägganden enligt 11 § i den föreslagna lagen, vilka enligt 21 § samma lag ska handläggas skyndsamt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec410",
      "sentiment": -0.5,
      "quote": "Förvaltningsrätten noterar att det saknas överväganden i utredningen avseende om det behövs justeringar i offentlighets- och sekretesslagen (2009:400) med anledning av bestämmelsen i 9 § tredje stycket den föreslagna lagen",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec518",
      "sentiment": -0.5,
      "quote": "förefaller det i mål enligt den föreslagna lagen vara fråga om omfattande utredningar och komplexa frågeställningar, vilket talar för att kostnaden för att handlägga målen hos allmänna förvaltningsdomstolar kommer att vara högre än vad utredningen beräknat.",
      "quote_type": "grund"
    }
  ]
