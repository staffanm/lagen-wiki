  "overall": {
    "sentiment": 0.5,
    "quote": "Återvinningsindustrierna delar i allt väsentligt utredningens bedömningar och förslag, och anser att ytterligare skärpningar kan behövas för att uppnå avgörande förändringar på marknaden.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a6.6.1",
      "sentiment": 1.0,
      "quote": "Återvinningsindustrierna tillstyrker förslaget om att flytta bestämmelserna om offentlig säljverksamhet från konkurrenslagen till en separat lag, för att på detta sätt uppmärksamma skiftet i perspektiv samt tydliggöra att det finns särskilda regler att förhålla sig till, både för privata och offentliga aktörer.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.2",
      "sentiment": 1.0,
      "quote": "Det är bra med ett perspektivskifte från nuvarande komplicerade prövning, till en prövning som utgår från hur offentliga säljverksamheter påverkar privata aktörers möjlighet att bedriva sin verksamhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.4",
      "sentiment": 1.0,
      "quote": "Återvinningsindustrierna tillstyrker förslaget att förekommande offentliga säljverksamheter återkommande ska utvärderas i förhållande till gällande lagbestämmelser.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.6.5",
      "sentiment": -0.2,
      "quote": "Även sådana verksamheter bör redovisas för att skapa en samlad bild av säljverksamheternas utsträckning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.6",
      "sentiment": 1.0,
      "quote": "Verket har redan motsvarande beslutsbefogenheter inom övriga tillsynsområden och förslaget framstår därmed som logiskt och konsekvent.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.7",
      "sentiment": 1.0,
      "quote": "En grundläggande förutsättning för möjligheten att kunna utöva en effektiv tillsyn är att myndigheten ges tillräckliga befogenheter för relevant informationsinhämtning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.8",
      "sentiment": 1.0,
      "quote": "Även förslaget om interimistiska åtgärder tillstyrks, inte minst för att detta ger möjlighet att stoppa verksamhet innan mer allvarlig marknadsskada har hunnit uppkomma.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.9",
      "sentiment": 1.0,
      "quote": "Återvinningsindustrierna tillstyrker förslaget att Konkurrensverket, i stället för ingripande, ska tillåtas godta åtaganden från en offentlig aktör som överträder förbudet mot otillbörlig offentlig säljverksamhet.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.6.10",
      "sentiment": 1.0,
      "quote": "Detta är nödvändigt för att reglerna ska ha effekt att motverka regelöverträdelser i praktiken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.11",
      "sentiment": 0.2,
      "quote": "Det kan dock övervägas om den i vissa fall bör kunna vara högre för att vara effektiv och få en avskräckande effekt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.12",
      "sentiment": 1.0,
      "quote": "Liksom utredningen ser vi det som centralt för regelverkets effektivitet att lagakraftvunna men obetalda avgifter kan föras vidare till indrivning utan ytterligare domstolsavgörande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.13",
      "sentiment": 1.0,
      "quote": "Möjligheten till särskilt påtryckningsmedel genom vite är särskilt betydelsefull för att motverka lag- och/eller domstolstrots samt för att säkerställa att en överträdande offentlig aktör lojalt följer aktuella ålägganden eller åtaganden.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.14",
      "sentiment": -0.5,
      "quote": "Enskilda företag skulle härigenom ges en fortsatt möjlighet att på egen hand åstadkomma rättslig prövning av sådan offentlig säljverksamhet som de upplever som störande.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7.1",
      "sentiment": 1.0,
      "quote": "Detta är viktigt för att fler överträdelser ska kunna uppmärksammas.",
      "quote_type": "grund"
    }
  ]
