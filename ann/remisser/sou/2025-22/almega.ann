  "overall": {
    "sentiment": 0.2,
    "quote": "Vi välkomnar förslaget till ny reglering rörande konkurrensbegränsande offentlig säljverksamhet.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "a6.6.1",
      "sentiment": 1.0,
      "quote": "Det tydliggör att LOS-prövningen inte ska influeras av konkurrensrättsliga bedömningar avseende konkurrenseffekter på marknader, utan i stället sätta effekterna för enskilda företags verksamheter i fokus.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.2",
      "sentiment": -0.2,
      "quote": "Almega anser att begreppet ”otillbörligt sätt” är vagt utformat och ger utrymme för oklara bedömningar, vilket kommer att försvåra en effektiv tillämpning av regeln.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.3",
      "sentiment": 1.0,
      "quote": "Idag kan inte konkurrensbegränsande statlig säljverksamhet förbjudas, vilket är en inkonsekvent och ineffektiv ordning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.4",
      "sentiment": 0.5,
      "quote": "Detta bör kunna skapa en ökad medvetenhet om insikt hos de offentliga aktörerna om vilken säljverksamhet som bedrivs och hur verksamheten påverkar privata företags förutsättningar att bedriva verksamhet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.5",
      "sentiment": 1.0,
      "quote": "Detta skapar viktig transparens kring de säljverksamheter som bedrivs av stat, kommuner och regioner.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.6",
      "sentiment": 1.0,
      "quote": "Att verket idag behöver föra talan i domstol i dessa ärenden skapar en ineffektiv ordning.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.7",
      "sentiment": 1.0,
      "quote": "Det är rimligt att verket ges mandat att kunna inhämta tillräcklig information för att på ett effektivt sätt kunna bedöma ärenden inom ramen för sin tillsynsroll.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.8",
      "sentiment": 0.2,
      "quote": "Att tillämpa en princip om att välja minst betungande åtgärd i dessa situationer blir inte ändamålsenligt.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.9",
      "sentiment": 1.0,
      "quote": "Det sistnämnda är en förutsättning av avgörande betydelse från vår sida.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.10",
      "sentiment": 1.0,
      "quote": "möjligheten att utkräva sanktionsavgifter av offentliga aktörer som överträder förbudet i sig är viktigt för den allmänna efterlevnaden av regelverket.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.13",
      "sentiment": 1.0,
      "quote": "vitesmöjligheten är en av stor betydelse för att förelägganden och åtaganden ska efterlevas i praktiken.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.14",
      "sentiment": -1.0,
      "quote": "Detta innebär att drabbade företag inte kommer att ha möjlighet att själva föra talan i domstol om Konkurrensverket väljer att inte ingripa.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.7",
      "sentiment": 0.2,
      "quote": "Vi anser att sekretess som utgångspunkt alltid ska gälla om det inte står klart att anmälaren inte lider skada av att uppgiften röjs.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a4.6",
      "sentiment": -1.0,
      "quote": "Detta innebär i sig en problematisk oförutsebarhet och rättsosäkerhet för företagen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a7.3",
      "sentiment": 1.0,
      "quote": "Vi finner det rimligt att även offentliga aktörer ska kunna åläggas att betala sådan avgift om de exempelvis lämnar vilseledande uppgifter eller inte kommer in med uppgifter inom föreskriven tidsfrist.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.4.1",
      "sentiment": 0.2,
      "quote": "förordar att detta endast ska kunna åläggas företag som genom sin egen omsättning uppfyller omsättningströskeln.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5.4.3",
      "sentiment": 1.0,
      "quote": "Fristerna synes dock inte orimliga för att verket och domstolarna på ett tillfredsställande sätt ska kunna hantera alltmer komplexa koncentrationsprövningar.",
      "quote_type": "grund"
    }
  ]
