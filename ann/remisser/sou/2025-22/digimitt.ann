  "overall": {
    "sentiment": -0.5,
    "quote": "Slutsatsen är att konfliktläget mellan kommunallagens självkostnadsprincip och konkurrenslagenslagstiftningens krav på marknadsmässighet inte hanteras, och därför föreslås konkreta justeringar för att återställa rättssäkerhet, förutsebarhet och balans mellan offentliga och privata aktörer.",
    "quote_type": "grund"
  },
  "segments": [
    {
      "forarbete_id": "sec403",
      "sentiment": -0.5,
      "quote": "Att ge Konkurrensverket, en exekutiv förvaltningsmyndighet, rätt att tolka och besluta om överträdelser av KL 2 kap. 1 §, utan föregående domstolsprövning, riskerar att urholka rättssäkerheten och självstyret.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec409",
      "sentiment": -0.5,
      "quote": "Förslaget innebär att bevisbördan för att en verksamhet är förenlig med lagen läggs på den offentliga aktören vid en överklagan till domstol.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec365",
      "sentiment": -0.5,
      "quote": "Begreppet saknar definition i lag och är inte etablerat i rättspraxis.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec368",
      "sentiment": -0.2,
      "quote": "En reglering som hindrar eller fördyrar dessa affärsmässiga verksamheter riskerar därför samhällets krisberedskap.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec370",
      "sentiment": -0.5,
      "quote": "Kommunal säljverksamhet hamnar i ett grundläggande dilemma där kommunallagen (KL 2 kap. 6 §) tvingar till självkostnadsprissättning, medan den föreslagna lagen om offentlig säljverksamhet kräver marknadsmässiga priser för att undvika snedvridning av konkurrensen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec432",
      "sentiment": -0.5,
      "quote": "Det är oproportionerligt att en kommun riskerar att bli skyldig att betala höga sanktionsavgifter för en verksamhet som man bedrivit i god tro för upp till fem år sedan, utan att någon rättslig prövning eller vägledning ens funnits vid tidpunkten.",
      "quote_type": "grund"
    }
  ]
