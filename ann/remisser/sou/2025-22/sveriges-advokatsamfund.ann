  "segments": [
    {
      "forarbete_id": "a4.2.6",
      "sentiment": -1.0,
      "quote": "det helt enkelt inte finns underlag för att konstatera att det skulle föreligga ett så systematiskt tillsynsunderskott att det motiverar en så långtgående utsträckning av Konkurrensverkets befogenheter som nu föreslås.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a5",
      "sentiment": 1.0,
      "quote": "då de anses vara väl avvägda och rimliga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.1",
      "sentiment": 0.5,
      "quote": "Att fokus för bedömningen skiftas från konkurrenseffekter på en konkurrensrättsligt korrekt avgränsad marknad, till att utgå från den privata aktörens verksamhet och den marknad denne verkar på, bör innebära att reglerna blir mer ändamålsenliga.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.3",
      "sentiment": 1.0,
      "quote": "Det saknas enligt utredningens bedömning hållbara skäl för att statliga aktörer ska kunna bedriva säljverksamhet som på ett otillbörligt sätt påverkar möjligheterna för privata aktörer att bedriva verksamhet på marknader, utan att det kan motiveras av ett allmänt intresse.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.5",
      "sentiment": 1.0,
      "quote": "Advokatsamfundet tillstyrker förslaget om att införa krav på särredovisning.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.6.6",
      "sentiment": 1.0,
      "quote": "Advokatsamfundet tillstyrker utredningens förslag om att Konkurrensverket ska få beslutanderätt i fråga om tillämpningen av LOS.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "a6.6.10",
      "sentiment": 0.2,
      "quote": "kan det ha en avskräckande effekt mot offentlig verksamhet som snedvrider konkurrensen.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a6.6.14",
      "sentiment": -1.0,
      "quote": "Bedömningarna – även med en LOS utan marknadsdefinitioner – kommer trots allt att röra bedömningar av hur marknader fungerar, vilket förvaltningsdomstolar inte är bäst lämpade att göra.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec440",
      "sentiment": -1.0,
      "quote": "Här är det därför av vikt att enskilda företag har möjlighet att driva frågor som inte Konkurrensverket har resurser att prioritera; annars tappar de nya reglerna i legitimitet.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec37",
      "sentiment": 1.0,
      "quote": "Advokatsamfundet ställer sig bakom förslagen om införandet av nya tidsfrister för koncentrationsprövningen.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec77",
      "sentiment": -0.5,
      "quote": "Det framförs inte heller i promemorian några tungt vägande skäl för en ändring, eller exempel där rekvisitet har utgjort en uppenbar begränsning för möjligheten att förbjuda en företagskoncentration.",
      "quote_type": "grund"
    }
  ]
