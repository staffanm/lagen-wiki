  "segments": [
    {
      "forarbete_id": "sec86",
      "sentiment": 1.0,
      "quote": "Domstolen anser att de skäl för förslaget som framhålls i betänkandet i viss utsträckning även kan göras gällande i förhållande till beslut av den personuppgiftsansvarige enligt annan registerlagstiftning som medger att enskilda nekas att utöva sina rättigheter med hänvisning till sekretess, t.ex. brottsdatalagen (2018:1177) och lagen (2021:1171) om behandling av personuppgifter vid Försvarsmakten.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "sec861",
      "sentiment": 1.0,
      "quote": "Förvaltningsrätten tillstyrker även förslaget att Integritetsskyddsmyndighetens beslut om bl.a. förelägganden och förbud som i dag överklagas till förvaltningsrätten ska överklagas till Försvarsunderrättelsedomstolen.",
      "quote_type": "standpunkt"
    },
    {
      "forarbete_id": "sec593",
      "sentiment": -0.5,
      "quote": "I utredningen lämnas ingen motivering till varför det ska göras en skillnad mellan dessa regelverk i detta sammanhang.",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a1.4",
      "sentiment": -0.5,
      "quote": "noterar förvaltningsrätten att det saknas en motivering till varför uppgifter till skydd för enskildas personliga eller ekonomiska förhållanden inte ska kunna lämnas till den domstol som ska granska om sådana uppgifter ska kunna tas fram",
      "quote_type": "grund"
    },
    {
      "forarbete_id": "a9.9",
      "sentiment": -0.5,
      "quote": "Enligt förvaltningsrättens mening gör denna placering att det inte är tydligt att det rör sig om en undantagsbestämmelse.",
