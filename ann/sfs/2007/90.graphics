      ],
      "sort": "vagmarke",
      "code": "P1",
      "anchor": "p1 stopp tecknet anger stopp för den trafikant som kommer framifrån eller bakifrån. tecknet används i vägkorsning och gäller så länge polismannen vänder sig åt samma håll. för trafikanter som kommer från sidan betyder tecknet att vägen är fri och att det är tillåtet att köra. tecknet får ges i kombination med tecken p2, stopp. tecknet kan ges med en stoppspade.",
      "occurrence": 1
    }
  },
